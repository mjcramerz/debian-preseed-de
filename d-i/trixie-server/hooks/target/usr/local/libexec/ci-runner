#!/bin/sh
set -eu
umask 077

kind=${1:-}
action=${2:-}
case "$kind:$action" in
  github:run) config=/etc/system-config/ci-runners/github.env; expected_root=/pool/podman/users/github-runner/runner; release_root=/usr/local/libexec/ci-github-runner; runner_user=github-runner ;;
  gitlab:run) config=/etc/system-config/ci-runners/gitlab.env; expected_root=/pool/podman/users/gitlab-runner/runner; release_root=/usr/local/libexec/ci-gitlab-runner; runner_user=gitlab-runner ;;
  *) printf '%s\n' 'usage: ci-runner {github|gitlab} run' >&2; exit 2 ;;
esac
[ -r "$config" ] && [ ! -L "$config" ] || { printf '%s\n' 'runner configuration is unavailable' >&2; exit 1; }
. "$config"
[ "${RUNNER_ROOT:-}" = "$expected_root" ] || { printf '%s\n' 'runner configuration root does not match service policy' >&2; exit 1; }
[ "${RUNNER_RELEASE_ROOT:-}" = "$release_root" ] || { printf '%s\n' 'runner release root does not match service policy' >&2; exit 1; }
[ -x "$release_root" ] || { printf '%s\n' 'verified runner release is unavailable' >&2; exit 1; }
[ -d "$RUNNER_ROOT" ] && [ ! -L "$RUNNER_ROOT" ] || { printf '%s\n' 'runner state root is unavailable' >&2; exit 1; }

case "$kind" in
  github)
    [ -f "$RUNNER_ROOT/.runner" ] && [ ! -L "$RUNNER_ROOT/.runner" ] || {
      printf '%s\n' 'GitHub registration state is not ready; run the one-shot registration unit' >&2
      exit 1
    }
    [ -x "$release_root/run.sh" ] || { printf '%s\n' 'GitHub runner listener is unavailable' >&2; exit 1; }
    exec "$release_root/run.sh"
    ;;
  gitlab)
    [ -s "$RUNNER_CONFIG" ] && [ ! -L "$RUNNER_CONFIG" ] || {
      printf '%s\n' 'GitLab registration state is not ready; run the one-shot registration unit' >&2
      exit 1
    }
    exec "$release_root" run --config "$RUNNER_CONFIG" --working-directory "$RUNNER_WORK_DIR" --user "$runner_user"
    ;;
esac
