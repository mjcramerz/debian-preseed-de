#!/bin/sh
set -eu
umask 077

kind=${1:-}
case "$kind" in github|gitlab) ;; *) printf '%s\n' 'registration provider is invalid' >&2; exit 2 ;; esac
config_dir=/etc/system-config/ci-runners
state_dir=/var/lib/ci-runners/$kind
lock_dir=/run/lock/ci-runners
install -d -m 0750 "$lock_dir" "$state_dir"
lock="$lock_dir/$kind.register"
if ! mkdir "$lock" 2>/dev/null; then
  printf '%s\n' 'registration is already in progress' >&2
  exit 1
fi
cleanup_register() { rmdir "$lock" 2>/dev/null || true; }
trap cleanup_register EXIT HUP INT TERM

. "$config_dir/$kind.env"
credential=${CREDENTIALS_DIRECTORY:-}/registration
[ -f "$credential" ] && [ ! -L "$credential" ] || { printf '%s\n' 'registration credential is missing' >&2; exit 1; }
token=$(sed -n '1{s/\r$//;p;q;}' "$credential")
[ -n "$token" ] || { printf '%s\n' 'registration credential is empty' >&2; exit 1; }
case "$token" in *[![:print:]]*) printf '%s\n' 'registration credential is malformed' >&2; exit 1 ;; esac

fingerprint=$(printf '%s\n%s\n%s\n' "$RUNNER_URL" "$RUNNER_NAME" "$RUNNER_LABELS" | /usr/bin/sha256sum | awk '{print $1}')
if [ -f "$state_dir/fingerprint" ] && [ -s "$state_dir/fingerprint" ]; then
  expected=$(sed -n '1{s/\r$//;p;q;}' "$state_dir/fingerprint")
  if [ "$expected" = "$fingerprint" ]; then
    rm -f "$config_dir/.$kind.registration"
    unset token
    exit 0
  fi
  printf '%s\n' 'registration identity changed; explicit re-registration is required' >&2
  exit 1
fi

case "$kind" in
  github)
    [ -x "$RUNNER_RELEASE_ROOT/config.sh" ] || { printf '%s\n' 'GitHub registration helper is unavailable' >&2; exit 1; }
    runuser -u github-runner -- "$RUNNER_RELEASE_ROOT/config.sh" --unattended --replace --disableupdate \
      --url "$RUNNER_URL" --token "$token" --name "$RUNNER_NAME" \
      --labels "$RUNNER_LABELS" --work "$RUNNER_WORK_DIR" >/dev/null 2>&1 || {
      printf '%s\n' 'GitHub registration failed' >&2; exit 1;
    }
    [ -s "$RUNNER_ROOT/.runner" ] && [ ! -L "$RUNNER_ROOT/.runner" ] || {
      printf '%s\n' 'GitHub registration did not publish runner state' >&2; exit 1;
    }
    ;;
  gitlab)
    [ -x "$RUNNER_RELEASE_ROOT" ] || { printf '%s\n' 'GitLab registration helper is unavailable' >&2; exit 1; }
    registration_stage=/run/ci-runners/gitlab-registration
    [ -d "$registration_stage" ] && [ ! -L "$registration_stage" ] || {
      printf '%s\n' 'GitLab registration staging directory is unavailable' >&2; exit 1;
    }
    temporary=$(mktemp "$registration_stage/.registration.XXXXXX")
    chown gitlab-runner:gitlab-runner "$temporary"
    chmod 0600 "$temporary"
    cleanup_registration_file() {
      rm -f "$temporary"
      rmdir "$lock" 2>/dev/null || true
    }
    trap cleanup_registration_file EXIT HUP INT TERM
    runuser -u gitlab-runner -- "$RUNNER_RELEASE_ROOT" register --non-interactive \
      --config "$temporary" --url "$RUNNER_URL" --token "$token" --name "$RUNNER_NAME" \
      --executor "$RUNNER_EXECUTOR" --docker-host "$RUNNER_DOCKER_HOST" \
      --docker-image "$RUNNER_DOCKER_IMAGE" --docker-pull-policy "$RUNNER_DOCKER_PULL_POLICY" \
      --docker-volumes "$RUNNER_BUILDS_DIR:/builds" --docker-volumes "$RUNNER_CACHE_DIR:/cache" \
      --tag-list "$RUNNER_LABELS" --builds-dir "$RUNNER_BUILDS_DIR" \
      --cache-dir "$RUNNER_CACHE_DIR" >/dev/null 2>&1 || {
      printf '%s\n' 'GitLab registration failed' >&2; exit 1;
    }
    [ -s "$temporary" ] && [ ! -L "$temporary" ] || { printf '%s\n' 'GitLab registration did not publish configuration' >&2; exit 1; }
    mv -f "$temporary" "$RUNNER_CONFIG"
    chown gitlab-runner:gitlab-runner "$RUNNER_CONFIG"
    chmod 0600 "$RUNNER_CONFIG"
    trap - EXIT HUP INT TERM
    rmdir "$registration_stage" 2>/dev/null || true
    ;;
esac

printf '%s\n' "$fingerprint" >"$state_dir/fingerprint.tmp"
chmod 0640 "$state_dir/fingerprint.tmp"
mv -f "$state_dir/fingerprint.tmp" "$state_dir/fingerprint"
rm -f "$config_dir/.$kind.registration"
unset token
trap - EXIT HUP INT TERM
rmdir "$lock" 2>/dev/null || true
