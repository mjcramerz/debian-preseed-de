[connection]
id=managed-wifi
type=wifi
interface-name=@WIFI_INTERFACE@
autoconnect=false
permissions=

[wifi]
mode=infrastructure
ssid=@WIFI_ESSID@

[wifi-security]
key-mgmt=none

[ipv4]
method=manual
address1=@WIFI_CIDR@
route-metric=200
ignore-auto-dns=true
ignore-auto-routes=true

[ipv6]
method=auto
