# Podman registry TLS policy. The passphrase remains in the protected file;
# this file only publishes the paths and verification policy.
PODMAN_TLS_VERIFY=true
PODMAN_TLS_CERT_DIR=/etc/containers/certs.d
PODMAN_TLS_PASSPHRASE_FILE=/etc/system-config/ci-runners/podman/@KIND@/tls-passphrase
REGISTRY_AUTH_FILE=@HOME_ROOT@/data/containers/auth.json
