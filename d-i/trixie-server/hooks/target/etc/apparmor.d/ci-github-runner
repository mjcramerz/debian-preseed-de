#include <tunables/global>

profile ci-github-runner /usr/local/libexec/ci-runner {
  #include <abstractions/base>
  #include <abstractions/bash>
  /usr/local/libexec/ci-runner rix,
  /usr/local/libexec/ci-github-runner/config.sh rix,
  /usr/local/libexec/ci-github-runner/run.sh rix,
  /usr/local/libexec/ci-github-runner/bin/** rix,
  /usr/local/libexec/ci-github-runner/externals/** rix,
  /usr/bin/git rix,
  /usr/bin/tar rix,
  /usr/bin/curl rix,
  /etc/ssl/certs/** r,
  /etc/system-config/ci-runners/github.env r,
  /etc/system-config/ci-runners/github.toolchain.env r,
  /pool/build/runners/github/** rwk,
  /pool/cache/runners/github/** rwk,
  /pool/db/runners/github/** rwk,
  /pool/podman/users/github-runner/** rwk,
  /run/ci-runners/github/** rw,
  /var/lib/ci-runners/github/** rw,
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  deny /preseed.env r,
  deny /target/** rwx,
  deny /root/** rwx,
  deny /pool/** rwlx,
  /pool/build/runners/github/** rwk,
  /pool/cache/runners/github/** rwk,
  /pool/db/runners/github/** rwk,
  /pool/podman/users/github-runner/** rwk,
  deny /pool/build/runners/gitlab/** rwx,
  deny /pool/cache/runners/gitlab/** rwx,
  deny /pool/db/runners/gitlab/** rwx,
  deny /pool/podman/users/gitlab-runner/** rwx,
  deny /run/systemd/private rw,
  deny /run/dbus/** rw,
}
