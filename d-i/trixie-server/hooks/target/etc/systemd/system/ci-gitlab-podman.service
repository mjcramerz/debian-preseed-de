[Unit]
Description=GitLab runner rootless Podman API
Requires=ci-gitlab-podman.socket
After=ci-gitlab-podman.socket systemd-tmpfiles-setup.service
RequiresMountsFor=/pool/build/runners/gitlab /pool/cache/runners/gitlab /pool/db/runners/gitlab /pool/podman/users/gitlab-runner /pool/podman/runners/gitlab /run/ci-runners/gitlab

[Service]
Type=exec
User=gitlab-runner
Group=gitlab-runner
Environment=HOME=/pool/podman/users/gitlab-runner
Environment=XDG_RUNTIME_DIR=/run/ci-runners/gitlab
Environment=XDG_DATA_HOME=/pool/podman/users/gitlab-runner/data
Environment=XDG_CACHE_HOME=/pool/podman/users/gitlab-runner/cache
Environment=TMPDIR=/pool/podman/runners/gitlab/tmp
Environment=CONTAINERS_CONF=/etc/system-config/ci-runners/podman/gitlab/containers.conf
Environment=CONTAINERS_STORAGE_CONF=/etc/system-config/ci-runners/podman/gitlab/storage.conf
Environment=REGISTRIES_CONFIG_PATH=/etc/system-config/ci-runners/podman/gitlab/registries.conf
EnvironmentFile=-/etc/system-config/ci-runners/podman/gitlab/registry-tls.env
ExecStart=/usr/bin/podman system service --time=0 unix:///run/ci-runners/gitlab/podman.sock
Delegate=yes
KillMode=control-group
TimeoutStartSec=90s
TimeoutStopSec=30s
Restart=on-failure
RestartSec=3s
UMask=0077
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
ReadWritePaths=/run/ci-runners/gitlab /pool/build/runners/gitlab /pool/cache/runners/gitlab /pool/db/runners/gitlab /pool/podman/runners/gitlab /pool/podman/users/gitlab-runner
RestrictNamespaces=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CPUWeight=100
IOWeight=100
TasksMax=4096
MemoryHigh=70%
MemoryMax=85%

[Install]
WantedBy=multi-user.target
