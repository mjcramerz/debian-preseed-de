[Unit]
Description=GitHub Actions self-hosted runner
After=network-online.target
Wants=network-online.target
Requires=ci-github-podman.socket ci-github-register.service network-policy.service nftables.service apparmor.service
After=ci-github-podman.socket ci-github-register.service network-policy.service nftables.service apparmor.service
RequiresMountsFor=/pool/build/runners/github /pool/cache/runners/github /pool/db/runners/github /pool/podman/users/github-runner /var/lib/ci-runners/github
ConditionPathExists=/etc/system-config/ci-runners/github.env
ConditionPathExists=/usr/local/libexec/ci-runner
ConditionPathExists=/var/lib/ci-runners/github/fingerprint
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=exec
Slice=ci-github.slice
User=github-runner
Group=github-runner
EnvironmentFile=/etc/system-config/ci-runners/github.env
EnvironmentFile=-/etc/system-config/ci-runners/github.toolchain.env
Environment=HOME=/pool/podman/users/github-runner
Environment=XDG_RUNTIME_DIR=/run/ci-runners/github
Environment=XDG_DATA_HOME=/pool/podman/users/github-runner/data
Environment=XDG_CACHE_HOME=/pool/podman/users/github-runner/cache
Environment=TMPDIR=/pool/podman/runners/github/tmp
Environment=CONTAINER_HOST=unix:///run/ci-runners/github/podman.sock
ExecStart=/usr/local/libexec/ci-runner github run
Restart=on-failure
RestartSec=10s
TimeoutStartSec=120s
TimeoutStopSec=30s
KillMode=control-group
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
DevicePolicy=closed
CapabilityBoundingSet=
ProtectClock=yes
RestrictRealtime=yes
SystemCallArchitectures=native
AppArmorProfile=ci-github-runner
MemoryHigh=70%
MemoryMax=85%
TasksMax=4096
CPUWeight=100
IOWeight=100
LimitNOFILE=65536
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/pool/cache/runners/github
ReadWritePaths=/pool/build/runners/github
ReadWritePaths=/pool/podman/users/github-runner
ReadWritePaths=/pool/db/runners/github
InaccessiblePaths=/preseed.env /target /boot /root /etc/systemd/system /run/dbus /run/systemd/private
UMask=0077

[Install]
WantedBy=multi-user.target
