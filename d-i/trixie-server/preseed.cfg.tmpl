# Debian Trixie installer answers for the independent Debian 13 server
# profile. The server tree is intentionally separate from the Forky desktop
# generation and does not alter the existing desktop products.
d-i debconf/priority select critical
d-i debconf/priority seen true
d-i auto-install/classes string prod,server,standard,static,btrfs-srv-flex,addon/crowdsec,addon/codex

# Pass server_source=<HTTPS repository directory> on the installer command
# line. The include command fetches the source transport and complete payload,
# then emits local include files from /tmp/server-install. The source helper is
# pinned by the serializer; it is verified before it is sourced.
d-i preseed/include_command string /bin/sh -c 'set -eu; umask 077; source_base=; for arg in $(cat /proc/cmdline); do case "$arg" in server_source=https://*) source_base=${arg#server_source=};; server_source=*) source_base=${arg#server_source=};; esac; done; case "$source_base" in https://?*/*) ;; *) echo "fatal: server_source must be HTTPS" >&2; exit 1;; esac; source_rest=${source_base#https://}; case "$source_rest" in *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._~:/%+,-]*|*//*|*@*|*\?*|*#*) echo "fatal: unsafe server_source" >&2; exit 1;; esac; source_host=${source_rest%%/*}; case "$source_host" in github.com|raw.githubusercontent.com) ;; *) echo "fatal: server_source host is not approved" >&2; exit 1;; esac; source_tmp=$(mktemp /tmp/server-source.XXXXXX); manifest_tmp=$(mktemp /tmp/server-source-manifest.XXXXXX); trap "rm -f \"$source_tmp\" \"$manifest_tmp\"" EXIT HUP INT TERM; /usr/bin/wget --no-config -q --timeout=20 --tries=2 --max-redirect=0 --max-filesize=1048576 -O "$source_tmp" "${source_base%/}/scripts/common/source.sh"; /usr/bin/wget --no-config -q --timeout=20 --tries=2 --max-redirect=0 --max-filesize=10485760 -O "$manifest_tmp" "${source_base%/}/payload.manifest"; expected=$(awk -F "\\t" '\''$3 == "scripts/common/source.sh" { print $2; exit }'\'' "$manifest_tmp"); [ "$expected" = "@SOURCE_HELPER_SHA256@" ] || { echo "fatal: source helper identity is not pinned" >&2; exit 1; }; actual=$(/usr/bin/sha256sum "$source_tmp" | awk '\''{ print $1 }'\''); [ "$actual" = "$expected" ] || { echo "fatal: source helper digest mismatch" >&2; exit 1; }; . "$source_tmp"; server_source_prepare_payload "$source_base" /tmp/server-install; /bin/sh /tmp/server-install/scripts/preseed/bootstrap.sh /tmp/server-install; for relative in common.cfg fragments/apt.cfg fragments/network.cfg fragments/partman.cfg fragments/finish.cfg; do include_file=/tmp/server-install/$relative; [ -f "$include_file" ] && [ ! -L "$include_file" ] || { echo "fatal: payload include is missing: $relative" >&2; exit 1; }; printf "file://%s\\n" "$include_file"; done'
d-i preseed/early_command string /bin/sh -c '/bin/sh /tmp/server-install/scripts/preseed/account-answers.sh /tmp/server-install; /bin/sh /tmp/server-install/scripts/preseed/class-answers.sh /tmp/server-install'
d-i partman/early_command string /bin/sh /tmp/server-install/scripts/partman/choose-layout.sh
d-i preseed/late_command string /bin/sh /tmp/server-install/scripts/late/dispatch.sh /tmp/server-install
