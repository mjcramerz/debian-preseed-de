# Server repository policy. Paths are relative to d-i/srv.
REPOSITORY_ROLE="server"
REPOSITORY_NAME="debian-preseed-de-srv"
DEBIAN_RELEASE="trixie"
DEBIAN_APT_PREFERENCES="trixie,forky,experimental"
DEBIAN_DEFAULT_CLASSES="prod;server;standard;static;btrfs-srv-flex;crowdsec;codex"

DIR_HOSTS_PROFILES="hosts/profiles"
DIR_HOSTS_LOGGING="hosts/logging"
DIR_HOSTS_INSTALLER="hosts/installer"
DIR_SSH="ssh"
DIR_HOOKS_INSTALLER="hooks/installer"
DIR_HOOKS_TARGET="hooks/target"
DIR_SCRIPTS_COMMON="scripts/common"
DIR_SCRIPTS_EARLY="scripts/early"
DIR_SCRIPTS_FIRSTBOOT="scripts/firstboot"
DIR_SCRIPTS_LATE="scripts/late"
DIR_SCRIPTS_PARTMAN="scripts/partman"
DIR_SCRIPTS_PRESEED="scripts/preseed"
DIR_SCRIPTS_RUNTIME="scripts/runtime"

# zram is deliberately sourced from the desktop Forky tree embedded in the
# immutable Trixie payload. This is a source relationship, not a duplicate
# implementation: zram-stage.sh stages exactly the listed files from payload.
FORKY_ZRAM_SOURCE_ROOT="../forky"
FORKY_ZRAM_SOURCE_MANIFEST="zram-source.manifest"

# The installer accepts server_source=<HTTPS repository directory> on its
# kernel command line. The preseed fetches the publication products there.
SERVER_TARGET_ROOT="/target"
SERVER_STATE_DIR="/var/lib/system-state"
