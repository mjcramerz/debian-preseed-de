# Server logging is deliberately small and explicit. No desktop telemetry or
# user session paths are enabled on this profile.
OBSERVABILITY_ENABLED="true"
OBSERVABILITY_LEVEL="info"
OBSERVABILITY_JOURNAL_STORAGE="persistent"
OBSERVABILITY_JOURNAL_MAX_USE="1G"
OBSERVABILITY_JOURNAL_MAX_FILE_SIZE="128M"
OBSERVABILITY_RSYSLOG_ENABLED="true"
OBSERVABILITY_AUDITD_ENABLED="true"
OBSERVABILITY_CROWDSEC_ENABLED="true"
OBSERVABILITY_REDACT_SECRETS="true"
OBSERVABILITY_STATE_DIR="/var/lib/system-state/observability"
