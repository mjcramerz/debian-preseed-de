# Trixie server runtime policy and target paths.
NFTABLES_LOG_LEVEL="warning"
SYSTEMD_LOG_LEVEL="info"
SERVER_LOG_LEVEL="info"
SERVER_TARGET_ROOT="/target"
SERVER_STATE_DIR="/var/lib/system-state"
SERVER_CI_REGISTRATION_STATE_DIR="/var/lib/ci-runners"
SERVER_CI_ARTIFACT_ROOT="/usr/local/libexec"

# Server network-sharing target paths.
NETWORK_SHARING_ROOT_PATH="/data/sharing"
NETWORK_SHARING_HOME_BIND_PATH="Sharing"
NFS_SERVER_PATH="$NETWORK_SHARING_ROOT_PATH/nfs-server"
NFS_CLIENT_EXPORT_PATH="/"
NFS_CLIENT_MOUNT_PATH="$NETWORK_SHARING_ROOT_PATH/nfs-client"

# Server storage and CI target paths.
DIR_POOL_BUILD_RUNNERS="$DIR_POOL_BUILD/runners"
DIR_POOL_CACHE_RUNNERS="$DIR_POOL_CACHE/runners"
