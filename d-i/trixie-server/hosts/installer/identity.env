# shellcheck shell=sh
# Server machine identity and network resolver defaults. Non-secret identity
# answers come from installer command-line/debconf state; protected account
# values remain in the credential reader.

# System upstream DNS. DNS1 is required; DNS2 and DNS3 are optional fallbacks.
SYSTEM_NAMESERVERS_IPV4_DNS1="89.233.43.71"
SYSTEM_NAMESERVERS_IPV6_DNS1="2a01:3a0:53:53::"
SYSTEM_NAMESERVERS_HOSTNAME_DNS1="unicast.uncensoreddns.org"
SYSTEM_NAMESERVERS_IPV4_DNS2="91.239.100.100"
SYSTEM_NAMESERVERS_IPV6_DNS2="2001:67c:28a4::"
SYSTEM_NAMESERVERS_HOSTNAME_DNS2="anycast.uncensoreddns.org"
SYSTEM_NAMESERVERS_IPV4_DNS3=""
SYSTEM_NAMESERVERS_IPV6_DNS3=""
SYSTEM_NAMESERVERS_HOSTNAME_DNS3=""
SYSTEM_NAMESERVERS_PORT="853"
SYSTEM_DNS_UPSTREAM_TLS_CA_CUSTOM_ENABLE="false"
SYSTEM_NAMESERVERS_TLS_SAN_CUSTOM="dns.lan.icramer.com"
SYSTEM_DNS_CACHE_SIZE="10000"
SYSTEM_DNS_CACHE_MIN_TTL="60"
STATIC_INSTALLER_NAMESERVER="1.1.1.1"

# Server hostname/domain identity. The installer command line may override
# these values; no hostname or domain is read from /preseed.env.
SYSTEM_PREFIX="LPL"
SYSTEM_DOMAIN="lan.icramer.com"

# Server workloads use a small managed application-network identity. The
# address and resolver contracts remain the same shape as Forky.
APP_VETH_IPV4_CIDR="10.204.0.0/28"
APP_VETH_MAX_LEASES="8"
APP_VETH_HOST_INTERFACE_PREFIX="veth"
APP_VETH_HOST_INTERFACE_SUFFIX="-app"
APP_VETH_PEER_INTERFACE_SUFFIX="-peer"
APP_VETH_NAMESPACE_INTERFACE="eth0"
APP_VETH_DNS_ADDRESS="10.0.2.3"
APP_VETH_DNS_HOST_ADDRESS="127.0.0.1"
APP_VETH_DNS_HOST_PORT="53053"
APP_VETH_TLS_HOST_ADDRESS="127.0.0.1"
APP_VETH_TLS_HOST_PORT="53054"
APP_VETH_OVERRIDE=""
