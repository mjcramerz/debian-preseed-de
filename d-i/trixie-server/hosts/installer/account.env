# Non-secret account policy. Passwords and tokens are read only from the
# protected installer /preseed.env by scripts/common/credentials.sh.
ROOT_LOGIN="false"
ACCOUNT_DEFAULT_GROUPS="sudo adm systemd-journal"
PRIMARY_SHELL="/bin/bash"
SSH_PUBLIC_KEY_SOURCE="ssh/lan_ed25519.pub"
SSHD_CONFIG_SOURCE="ssh/sshd_config"
SSH_USER_CONFIG_SOURCE="ssh/config"
SSH_PUBLIC_KEY_MAX_BYTES="4096"
SSH_CONFIG_MAX_BYTES="65536"
GITHUB_RUNNER_USER="github-runner"
GITLAB_RUNNER_USER="gitlab-runner"
CODEX_USER="codex"
BUILDBUDDY_USER="buildbuddy"
