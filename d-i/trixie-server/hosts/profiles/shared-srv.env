# shellcheck shell=sh
# Shared policy for the Trixie server tree. Optional components are selected
# by class references; this file has no feature enable/disable booleans.

# Identity and release-neutral server defaults. The selected profile supplies
# filesystem, hostname, network address policy, and hardware layout.
SERVER_DOMAIN="lan.icramer.com"
SERVER_TIMEZONE="Europe/Stockholm"
SERVER_LOCALE="en_US.UTF-8"
SERVER_ALLOWED_SERVICES="ssh,dns-client,ntp-client"
SERVER_SSH_PORT="32020"
SERVER_SSH_CIDR_ALLOW="192.168.50.0/24"
SERVER_SECURITY_PROFILE="standard"
SERVER_COREDUMP_POLICY="disabled"
SERVER_UPGRADE_POLICY="unattended"
SERVER_SERIAL_CONSOLE_POLICY="enabled"

# NFS policy. The nfs-client and nfs-server classes own activation.
NFS_ACCOUNT_UID="1000"
NFS_ACCOUNT_GID="1000"
NFS_SHARED_GROUP="nfs-sharing"
NFS_SHARED_GID="2050"
NFS_CLIENT_VERSION="4.2"
NFS_SERVER_PORT="2049"
NFS_SERVER_EXPORT_CIDR="192.168.50.0/24"
NFS_SERVER_APT_DEPS="nfs-kernel-server nfs-common libnfsidmap1 keyutils nftables acl e2fsprogs"
NFS_CLIENT_APT_DEPS="nfs-common libnfsidmap1 keyutils nftables e2fsprogs"
NFS_SERVER_RW_OPTIONS="rw,sync,subtree_check,root_squash,secure,sec=sys,fsid=0"
NFS_SERVER_RO_OPTIONS="ro,sync,subtree_check,root_squash,secure,sec=sys,fsid=0"
NFS_SERVER_EXPORTS="${NFS_SERVER_PATH} 192.168.50.82/31(${NFS_SERVER_RW_OPTIONS}) 192.168.50.84/30(${NFS_SERVER_RW_OPTIONS}) 192.168.50.88/29(${NFS_SERVER_RW_OPTIONS}) 192.168.50.96/30(${NFS_SERVER_RW_OPTIONS}) 192.168.50.100/32(${NFS_SERVER_RW_OPTIONS}) 192.168.50.112/29(${NFS_SERVER_RO_OPTIONS}) 192.168.50.120/31(${NFS_SERVER_RO_OPTIONS}) 192.168.50.122/32(${NFS_SERVER_RO_OPTIONS}) 192.168.50.212/30(${NFS_SERVER_RW_OPTIONS}) 192.168.50.216/30(${NFS_SERVER_RW_OPTIONS}) 192.168.50.220/31(${NFS_SERVER_RW_OPTIONS}) 192.168.50.222/32(${NFS_SERVER_RW_OPTIONS})"
NFS_CLIENT_MOUNT_TIMEOUT="30"
NFS_MNT_CLIENT_TARGET_SHARE_OPTS="rw,hard,proto=tcp,port=${NFS_SERVER_PORT},resvport,sec=sys,vers=${NFS_CLIENT_VERSION},nosuid,nodev,noexec,_netdev,nofail,noauto,x-systemd.mount-timeout=${NFS_CLIENT_MOUNT_TIMEOUT}s,x-systemd.requires=nfs-client.target,x-systemd.requires=nftables.service,x-systemd.requires=network-sharing-identity.service"
NFS_INTERFACES="${MANAGED_NETWORK_ETHERNET_IFACE:-eth0} ${MANAGED_NETWORK_WIFI_IFACE:-wifi0}"
NFS_TCP_RMEM="4096 131072 16777216"
NFS_TCP_WMEM="4096 16384 16777216"
NFS_SOCKET_RMEM_MAX="16777216"
NFS_SOCKET_WMEM_MAX="16777216"

# FILEN shared policy copied from Forky. The Trixie profile controls which
# isolated account(s) are installed and configured.
FILEN_CLI_MINIMUM_BYTES="1048576"
FILEN_CLI_PRIV_REMOTE_PATH="/Desktop"
FILEN_CLI_OFFSEC_REMOTE_PATH="/Desktop"
FILEN_CLI_VERSION="0.0.36"
FILEN_CLI_ARCHITECTURE="amd64"
FILEN_CLI_URL="https://github.com/FilenCloudDienste/filen-cli/releases/download/v${FILEN_CLI_VERSION}/filen-cli-v${FILEN_CLI_VERSION}-linux-x64"
FILEN_CLI_SHA256="be690d94d3310187dc7b4fe46b3e49becfb327c29ac64d49cfe73252c7c3c04a"
FILEN_CLI_MAXIMUM_BYTES="411041792"

# Persistent storage roots. The selected layout reserves /pool.

# Installed policy paths are deliberately generic and do not identify the
# installer profile or Debian release.

# Runner roots. Each locked account owns separate build, cache, database,
# and rootless Podman storage on /pool.
CI_RUNNER_MEMORY_HIGH="70%"
CI_RUNNER_MEMORY_MAX="85%"
CI_RUNNER_TASKS_MAX="4096"
CI_RUNNER_CPU_WEIGHT="100"
CI_RUNNER_IO_WEIGHT="100"
CI_RUNNER_GITHUB_SUBUID="200000:65536"
CI_RUNNER_GITLAB_SUBUID="266536:65536"

# GitLab runner identity and filesystem contract. Registration metadata is
# supplied as validated installer answers; artifact identity is policy only.
GITLAB_RUNNER_SERVICE_NAME="ci-gitlab-runner.service"

# Named language cache layouts expanded by the CI cache stage.

# Bazel and optional local BuildBuddy policy.
BAZELISK_VERSION="1.29.0"
BAZELISK_URL="https://github.com/bazelbuild/bazelisk/releases/download/v1.29.0/bazelisk-linux-amd64"
BAZEL_SERVER_IDLE_SECONDS="900"
BAZEL_REPOSITORY_DOWNLOADER_RETRIES="3"
BUILDBUDDY_MODE="class-selected"
BUILDBUDDY_VERSION="2.323.0"
BUILDBUDDY_URL_AMD64="https://github.com/buildbuddy-io/buildbuddy/releases/download/v2.323.0/buildbuddy-linux-amd64"
BUILDBUDDY_URL_ARM64="https://github.com/buildbuddy-io/buildbuddy/releases/download/v2.323.0/buildbuddy-linux-arm64"
BUILDBUDDY_SHA256_AMD64="c177b8619fcb3dfead14d1ae8a843af815200654744b2741cccdc3fe34795171"
BUILDBUDDY_SHA256_ARM64="5004cbaa576fd4e85f2a6a826beb7eba24f332788680a46857afbf3694bef03c"
BUILDBUDDY_BYTES_MIN="1048576"
BUILDBUDDY_BYTES_MAX="120000000"
BUILDBUDDY_ARTIFACT_HOSTS="github.com release-assets.githubusercontent.com objects.githubusercontent.com"
BUILDBUDDY_LISTEN="127.0.0.1"
BUILDBUDDY_HTTP_PORT="8080"
BUILDBUDDY_GRPC_PORT="1985"
# Shared remote cache is disabled until a tenant-authenticated endpoint is
# configured. Jobs must not reach the host through a container gateway.
BUILDBUDDY_REMOTE_CACHE_HOST=""
BUILDBUDDY_REMOTE_CACHE_CONTAINER=""
CI_GITLAB_RUNNER_EXECUTOR="docker"
# GitLab's executor keyword is "docker" for its Docker-compatible API. The
# socket is the class-gated rootless Podman service; this is only the job image.
# Use the dated official Debian slim tag to keep the Trixie job base small and
# reproducible without installing Docker or running a Docker daemon.
CI_GITLAB_RUNNER_IMAGE="docker.io/library/debian@sha256:bfc36aecdece0387418759dba474aa856c026ca8087da3606b41b90ab0509c99"
CI_GITLAB_RUNNER_PULL_POLICY="if-not-present"
CI_GITLAB_ALLOWED_HOSTS="gitlab.com"
CI_GITLAB_APPROVED_REGISTRIES="docker.io/library"

# Provider artifact policy. Installer answers cannot select these identities.
CI_GITHUB_RUNNER_VERSION="2.338.2"
CI_GITHUB_RUNNER_FORMAT="tar.gz"
CI_GITHUB_RUNNER_URL_AMD64="https://github.com/actions/runner/releases/download/v2.338.2/actions-runner-linux-x64-2.338.2.tar.gz"
CI_GITHUB_RUNNER_URL_ARM64="https://github.com/actions/runner/releases/download/v2.338.2/actions-runner-linux-arm64-2.338.2.tar.gz"
CI_GITHUB_RUNNER_SHA256_AMD64="baebf204307bac6193480852732f0aba2ae97b6c5597c244f4d5558390147c40"
CI_GITHUB_RUNNER_SHA256_ARM64="670adb2f268fe21dcbb58b3db0e0aa9d5b3bddfe2c651481336e561ff86de945"
CI_GITHUB_RUNNER_BYTES_MIN="1048576"
CI_GITHUB_RUNNER_BYTES_MAX="250000000"
CI_GITHUB_RUNNER_TOP_LEVEL="bin,externals"
CI_GITHUB_RUNNER_ARTIFACT_HOSTS="github.com release-assets.githubusercontent.com objects.githubusercontent.com"
CI_GITLAB_RUNNER_VERSION="19.5.3"
CI_GITLAB_RUNNER_FORMAT="elf"
CI_GITLAB_RUNNER_URL_AMD64="https://gitlab-runner-downloads.s3.amazonaws.com/v19.5.3/binaries/gitlab-runner-linux-amd64"
CI_GITLAB_RUNNER_URL_ARM64="https://gitlab-runner-downloads.s3.amazonaws.com/v19.5.3/binaries/gitlab-runner-linux-arm64"
CI_GITLAB_RUNNER_SHA256_AMD64="cd586a217b0ba4d339b3f3d645b84f8f5e1cc711e73148c30a3eec0f8c78378b"
CI_GITLAB_RUNNER_SHA256_ARM64="a03646eb5166a6035303d7bd1b3f8f76f55461cc7f1233bf8203539c7d7e8697"
CI_GITLAB_RUNNER_BYTES_MIN="1048576"
CI_GITLAB_RUNNER_BYTES_MAX="120000000"
CI_GITLAB_RUNNER_ARTIFACT_HOSTS="gitlab-runner-downloads.s3.amazonaws.com"

# Toolchain names are data, not feature switches.
CI_C_COMPILER="gcc"
CI_CPP_COMPILER="g++"
CI_LLVM_COMPILER="clang"
CI_RUST_COMPILER="rustc"
CI_RUST_PACKAGE_MANAGER="cargo"
CI_RUST_COMPILER_WRAPPER="sccache"
CI_GO_COMPILER="go"
CI_PYTHON_INTERPRETER="python3"
CI_NODE_INTERPRETER="node"
CI_JAVA_RUNTIME="java"
CI_RUBY_INTERPRETER="ruby"
CI_PERL_INTERPRETER="perl"
CI_TERRAFORM_BINARY="terraform"
CI_ANSIBLE_BINARY="ansible"
CI_BAZEL_BINARY="bazel"

# Exact shared ZRAM policy copied from the Forky shared profile.
ZRAM_ALGORITHM_PARAMS=""
ZRAM_COMPRESSION_ALGORITHM="lz4"
ZRAM_TIER1_ENABLE="1"
ZRAM_TIER1_ALGORITHM="lzo-rle"
ZRAM_TIER1_PRIORITY="1"
ZRAM_TIER1_LEVEL="0"
ZRAM_TIER1_THRESHOLD_BYTES="2048"
ZRAM_TIER2_ENABLE="1"
ZRAM_TIER2_ALGORITHM="zstd"
ZRAM_TIER2_PRIORITY="2"
ZRAM_TIER2_LEVEL="3"
ZRAM_TIER2_THRESHOLD_BYTES="3000"
ZRAM_TIER3_ENABLE="1"
ZRAM_TIER3_ALGORITHM="zstd"
ZRAM_TIER3_PRIORITY="3"
ZRAM_TIER3_LEVEL="1"
ZRAM_TIER3_THRESHOLD_BYTES="3584"
ZRAM_SWAP_DEVICE="/dev/zram0"
ZRAM_SWAP_PRIORITY="300"
ZRAM_MAX_COMP_STREAMS="0"
ZRAM_COMPRESSED_WRITEBACK="1"
ZRAM_WRITEBACK_ENABLE="1"
ZRAM_WRITEBACK_BATCH_SIZE_ADAPTIVE="1"
ZRAM_WRITEBACK_LIMIT_ENABLE="1"
ZRAM_WRITEBACK_MIN_REMAINING_PAGES="1"
ZRAM_WRITEBACK_PASS_PAGES_MAX="4194304"
ZRAM_WRITEBACK_SPEC_MAX_BYTES="3900"
ZRAM_LOGICAL_BLOCK_SIZE_FALLBACK="4096"
ZRAM_IO_PSI_ENABLE="1"
ZRAM_DAEMON_ENABLE="1"
ZRAM_DAEMON_SECONDS_MAX="86400"
ZRAM_IDLE_WRITEBACK_ENABLE="1"
ZRAM_PRESSURE_ENABLE="1"
ZRAM_COLD_TIER_ENABLE="1"
ZRAM_COLD_TIER_RECOMPRESS_ENABLE="1"
ZRAM_COLD_TIER_WRITEBACK_ENABLE="1"
ZRAM_MAINTENANCE_PAGE_INDEXES=""

# Exact shared boot and GRUB policy copied from the Forky shared profile.
BOOTPROFILE_DEFAULT="balanced"
BOOTPROFILE_HARDENED="hardened"
BOOTPROFILE_PERFORMANCE="performance"
GRUB_SYSTEMD_MASK_FLAGS="systemd.mask=nvmf-autoconnect.service systemd.mask=ModemManager.service systemd.mask=dbus-org.freedesktop.ModemManager1.service"
GRUB_DEFAULT_ENTRY="installer-linux-dynamic"
GRUB_INITRAMFS_FLAGS="initramfs_options=mode=0755,huge=within_size"
GRUB_CGROUP_FLAGS="systemd.unified_cgroup_hierarchy=1"
GRUB_SECURITY_CORE_FLAGS="vsyscall=none apparmor=1 lsm=landlock,lockdown,yama,integrity,apparmor,bpf module.sig_enforce=1 pti=auto randomize_kstack_offset=on"
GRUB_MEMORY_CORE_FLAGS="page_alloc.shuffle=1 slab_nomerge=1 zswap.enabled=0 zswap.max_pool_percent=0 transparent_hugepage=madvise transparent_hugepage_shmem=within_size transparent_hugepage_tmpfs=within_size"
GRUB_HARDENING_FLAGS="noresume systemd.show_status=auto threadirqs random.trust_cpu=on"

# Exact signed SCX policy values from the Forky shared profile.
HARDWARE_CPU_SCHEDULER_SCX_ENABLE="true"
HARDWARE_CPU_SCHEDULER_SCX_MODE="on-demand"
HARDWARE_CPU_SCHEDULER_SCX_PACKAGE_URL="https://github.com/mjcramerz/scx/releases/download/scx-v1.1.4/scx_1.1.4-1_amd64.deb"
HARDWARE_CPU_SCHEDULER_SCX_LOADER_PACKAGE_URL="https://github.com/mjcramerz/scx-loader/releases/download/scx-loader-v1.1.3/scx-loader_1.1.3-1_amd64.deb"

# Shared policy variables carried from Forky.
HARDWARE_CPU_SCHEDULER_SCX_PACKAGE_SHA256="b853753f9accd22bb5b7ec4a42b5a422cf3f74290903f65d3c0338a0268d4ade"
HARDWARE_CPU_SCHEDULER_SCX_LOADER_PACKAGE_SHA256="c6717ddb8963b33f85f647fe86fcb36351e719ad2f35a1d71ead01d5b3adfacc"
SYSTEMD_CPUWEIGHT_HOME_USER_SESSION_SLICE_D="CPUWeight=200"
SYSTEMD_CPUWEIGHT_HOME_USER_APP_SLICE_D="CPUWeight=100"
SYSTEMD_CPUWEIGHT_HOME_USER_BACKGROUND_SLICE_D="CPUWeight=30"
SYSTEMD_IOWEIGHT_HOME_USER_SESSION_SLICE_D="IOWeight=200"
SYSTEMD_IOWEIGHT_HOME_USER_APP_SLICE_D="IOWeight=100"
SYSTEMD_IOWEIGHT_HOME_USER_BACKGROUND_SLICE_D="IOWeight=30"
SYSTEMD_CPUWEIGHT_USER_AUDIO_SERVICE_D="CPUWeight=200"
SYSTEMD_CPUWEIGHT_SYSTEM_MAINTENANCE_SLICE_D="CPUWeight=30"
SYSTEMD_IOWEIGHT_SYSTEM_MAINTENANCE_SLICE_D="IOWeight=30"
SYSTEMD_CPUWEIGHT_SYSTEM_BACKGROUND_SLICE_D="CPUWeight=50"
SYSTEMD_IOWEIGHT_SYSTEM_BACKGROUND_SLICE_D="IOWeight=50"
SYSTEMD_COREDUMP_STORAGE="external"
SYSTEMD_COREDUMP_PROCESS_SIZE_MAX="64M"
SYSTEMD_COREDUMP_EXTERNAL_SIZE_MAX="64M"
SYSTEMD_COREDUMP_MAX_USE="128M"
SYSTEMD_COREDUMP_KEEP_FREE="32M"
SYSTEMD_COREDUMP_POLL_LIMIT_INTERVAL_SEC="2"
SYSTEMD_COREDUMP_POLL_LIMIT_BURST="64"
