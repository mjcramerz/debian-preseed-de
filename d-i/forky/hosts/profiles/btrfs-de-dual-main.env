# IOCost: provisional KXG6AZNV512G values, NOT measured calibration.
# Replace per host using resctl-bench/iocost-params/iocost-tune; never benchmark here.
# The model prefix pins the 512GB family; firmware wildcard is intentional.
IOCOST_CALIBRATE_ENABLE="false"
IOCOST_DEVICE_MODEL_MATCH="KXG6AZNV512G*"
IOCOST_DEVICE_FWREV_MATCH="*"
IOCOST_TARGET_SOLUTION="isolated-bandwidth"
IOCOST_SOLUTIONS="isolation isolated-bandwidth bandwidth naive"
IOCOST_MODEL_RBPS="1000000000"
