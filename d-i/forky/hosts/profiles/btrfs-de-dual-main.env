# Systemd accounting and user resource classes. These do not change explicit
# unit policy for zram, Podman, user-1000.slice, or other existing workloads.
# Independent switches: accounting controls both manager defaults only;
# weight enablement controls all managed resource-policy IOWeight lines only.
# Neither disables controller delegation nor erases original workload policy.
SYSTEMD_DEFAULT_IOACCOUNTING_ENABLE="false"
SYSTEMD_IOWEIGHT_ENABLE="false"
SYSTEMD_IOWEIGHT_HOME_USER_SESSION_SLICE_D="IOWeight=200"
SYSTEMD_IOWEIGHT_HOME_USER_APP_SLICE_D="IOWeight=100"
SYSTEMD_IOWEIGHT_HOME_USER_BACKGROUND_SLICE_D="IOWeight=30"

# Per-service exception: compositor responsiveness within session.slice.
SYSTEMD_CPUWEIGHT_HOME_USER_LABWC_COMPOSITOR_SERVICE_D="300"
SYSTEMD_IOWEIGHT_HOME_USER_LABWC_COMPOSITOR_SERVICE_D="IOWeight=300"
# Audio CPU preference only; do not add disk weights or real-time privileges.
SYSTEMD_CPUWEIGHT_USER_AUDIO_SERVICE_D="200"

# Aggregate system classes beneath system.slice (not new root-level budgets).
SYSTEMD_CPUWEIGHT_SYSTEM_MAINTENANCE_SLICE_D="30"
SYSTEMD_IOWEIGHT_SYSTEM_MAINTENANCE_SLICE_D="IOWeight=30"
SYSTEMD_CPUWEIGHT_SYSTEM_BACKGROUND_SLICE_D="50"
SYSTEMD_IOWEIGHT_SYSTEM_BACKGROUND_SLICE_D="IOWeight=50"

# Bounded small-core retention for the existing coredump store. These are
# deployment defaults, not measured per-host budgets. Large desktop cores need
# a deliberate increase after checking available RAM/storage and tmpfs sizing.
SYSTEMD_COREDUMP_STORAGE="external"
SYSTEMD_COREDUMP_PROCESS_SIZE_MAX="64M"
SYSTEMD_COREDUMP_EXTERNAL_SIZE_MAX="64M"
SYSTEMD_COREDUMP_MAX_USE="128M"
SYSTEMD_COREDUMP_KEEP_FREE="32M"

# Concurrent dump workers and self-recovering socket polling throttle.
# Seconds are integers; no per-source UID limit or tight fatal trigger limit.
SYSTEMD_COREDUMP_POLL_LIMIT_INTERVAL_SEC="2"
SYSTEMD_COREDUMP_POLL_LIMIT_BURST="64"

# Preserve the original journal storage defaults; profile overrides are allowed.
SYSTEMD_JOURNAL_SYSTEM_MAX_USE="1G"
SYSTEMD_JOURNAL_SYSTEM_KEEP_FREE="256M"
SYSTEMD_JOURNAL_SYSTEM_MAX_FILE_SIZE="128M"
SYSTEMD_JOURNAL_SYSTEM_MAX_FILES="16"
SYSTEMD_JOURNAL_RUNTIME_MAX_USE="128M"
SYSTEMD_JOURNAL_RUNTIME_KEEP_FREE="64M"
SYSTEMD_JOURNAL_RUNTIME_MAX_FILE_SIZE="16M"
SYSTEMD_JOURNAL_RUNTIME_MAX_FILES="16"

# Orderly shutdown: broker-only stop grace in seconds (5..120).
# Not a hardware watchdog setting or a global user/service stop deadline.
DBUS_BROKER_TIMEOUT_STOP_SEC="30"

# Hardware tuning: opt-in installation, runtime automatic tuning off by default.
# Advertised hardware bounds are resolved on the installed host; keep means no write.
# See docs/hardware-tuning/README.md for safety gates, units and per-device overrides.
HARDWARE_TUNING_AUTOSTART_ENABLE="false"
HARDWARE_TUNING_POLL_SECONDS="5"
HARDWARE_TUNING_IDLE_AC="balanced"
HARDWARE_TUNING_IDLE_BATTERY="silent"

HARDWARE_INTEL_CPU_TUNING_ENABLE="true"
HARDWARE_INTEL_CPU_TUNING_ALLOW_OVERCLOCK="false"
HARDWARE_INTEL_CPU_TUNING_ALLOW_POWER_INCREASE="false"
HARDWARE_INTEL_CPU_TUNING_EXCLUSIVE_CLOCK_CONTROL="false"
HARDWARE_INTEL_CPU_TUNING_MAX_TEMPERATURE_C="85"
# INTEL_CPU performance profile.
HARDWARE_INTEL_CPU_TUNING_PERFORMANCE_CPU_GOVERNOR="adaptive"
HARDWARE_INTEL_CPU_TUNING_PERFORMANCE_CPU_EPP="performance"
HARDWARE_INTEL_CPU_TUNING_PERFORMANCE_CPU_EPB="0"
HARDWARE_INTEL_CPU_TUNING_PERFORMANCE_CPU_MIN_PERF_PCT="keep"
