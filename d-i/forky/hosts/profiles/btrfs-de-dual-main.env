# Bootprofile-specific sysctl overlay values rendered into profiles/*/50-*.conf.
# Keep these values numeric; late_command validates each key before rendering.

# Balanced profile.
# VM reclaim, zram-backed swap, and compaction.
SYSCTL_PROFILE_BALANCED_SWAPPINESS="45"
SYSCTL_PROFILE_BALANCED_PAGE_CLUSTER="0"
SYSCTL_PROFILE_BALANCED_VFS_CACHE_PRESSURE="50"
SYSCTL_PROFILE_BALANCED_WATERMARK_BOOST_FACTOR="0"
SYSCTL_PROFILE_BALANCED_WATERMARK_SCALE_FACTOR="125"
SYSCTL_PROFILE_BALANCED_COMPACTION_PROACTIVENESS="20"
SYSCTL_PROFILE_BALANCED_EXTFRAG_THRESHOLD="500"
SYSCTL_PROFILE_BALANCED_ZONE_RECLAIM_MODE="0"
# Dirty writeback budget for volatile caches and installer-managed storage.
SYSCTL_PROFILE_BALANCED_DIRTY_BACKGROUND_BYTES="67108864"
SYSCTL_PROFILE_BALANCED_DIRTY_BYTES="268435456"
SYSCTL_PROFILE_BALANCED_DIRTY_EXPIRE_CENTISECS="1200"
SYSCTL_PROFILE_BALANCED_DIRTY_WRITEBACK_CENTISECS="200"
SYSCTL_PROFILE_BALANCED_DIRTYTIME_EXPIRE_SECONDS="43200"
SYSCTL_PROFILE_BALANCED_STAT_INTERVAL="10"
# File descriptor, AIO, and inotify pressure limits.
SYSCTL_PROFILE_BALANCED_AIO_MAX_NR="1048576"
SYSCTL_PROFILE_BALANCED_INOTIFY_MAX_USER_INSTANCES="2048"
SYSCTL_PROFILE_BALANCED_INOTIFY_MAX_USER_WATCHES="1048576"
SYSCTL_PROFILE_BALANCED_INOTIFY_MAX_QUEUED_EVENTS="65536"
# Network accept queues and connection churn.
SYSCTL_PROFILE_BALANCED_SOMAXCONN="32768"
SYSCTL_PROFILE_BALANCED_NETDEV_MAX_BACKLOG="250000"
SYSCTL_PROFILE_BALANCED_TCP_MAX_SYN_BACKLOG="16384"
SYSCTL_PROFILE_BALANCED_TCP_FASTOPEN="3"
SYSCTL_PROFILE_BALANCED_TCP_KEEPALIVE_TIME="600"
SYSCTL_PROFILE_BALANCED_TCP_FIN_TIMEOUT="30"

# Hardened profile.
# VM reclaim, zram-backed swap, and compaction.
SYSCTL_PROFILE_HARDENED_SWAPPINESS="45"
SYSCTL_PROFILE_HARDENED_PAGE_CLUSTER="0"
SYSCTL_PROFILE_HARDENED_VFS_CACHE_PRESSURE="60"
SYSCTL_PROFILE_HARDENED_WATERMARK_BOOST_FACTOR="0"
SYSCTL_PROFILE_HARDENED_WATERMARK_SCALE_FACTOR="125"
SYSCTL_PROFILE_HARDENED_COMPACTION_PROACTIVENESS="20"
SYSCTL_PROFILE_HARDENED_EXTFRAG_THRESHOLD="700"
SYSCTL_PROFILE_HARDENED_ZONE_RECLAIM_MODE="0"
# Dirty writeback budget for volatile caches and installer-managed storage.
SYSCTL_PROFILE_HARDENED_DIRTY_BACKGROUND_BYTES="16777216"
SYSCTL_PROFILE_HARDENED_DIRTY_BYTES="67108864"
SYSCTL_PROFILE_HARDENED_DIRTY_EXPIRE_CENTISECS="800"
SYSCTL_PROFILE_HARDENED_DIRTY_WRITEBACK_CENTISECS="100"
SYSCTL_PROFILE_HARDENED_DIRTYTIME_EXPIRE_SECONDS="3600"
SYSCTL_PROFILE_HARDENED_STAT_INTERVAL="5"
# File descriptor, AIO, and inotify pressure limits.
SYSCTL_PROFILE_HARDENED_AIO_MAX_NR="1048576"
SYSCTL_PROFILE_HARDENED_INOTIFY_MAX_USER_INSTANCES="1024"
SYSCTL_PROFILE_HARDENED_INOTIFY_MAX_USER_WATCHES="524288"
SYSCTL_PROFILE_HARDENED_INOTIFY_MAX_QUEUED_EVENTS="32768"
# Network accept queues and connection churn.
SYSCTL_PROFILE_HARDENED_SOMAXCONN="16384"
SYSCTL_PROFILE_HARDENED_NETDEV_MAX_BACKLOG="125000"
SYSCTL_PROFILE_HARDENED_TCP_MAX_SYN_BACKLOG="8192"
SYSCTL_PROFILE_HARDENED_TCP_FASTOPEN="1"
SYSCTL_PROFILE_HARDENED_TCP_KEEPALIVE_TIME="300"
SYSCTL_PROFILE_HARDENED_TCP_FIN_TIMEOUT="20"

# Performance profile.
# VM reclaim, zram-backed swap, and compaction.
SYSCTL_PROFILE_PERFORMANCE_SWAPPINESS="25"
SYSCTL_PROFILE_PERFORMANCE_PAGE_CLUSTER="0"
SYSCTL_PROFILE_PERFORMANCE_VFS_CACHE_PRESSURE="50"
SYSCTL_PROFILE_PERFORMANCE_WATERMARK_BOOST_FACTOR="0"
SYSCTL_PROFILE_PERFORMANCE_WATERMARK_SCALE_FACTOR="125"
SYSCTL_PROFILE_PERFORMANCE_COMPACTION_PROACTIVENESS="10"
SYSCTL_PROFILE_PERFORMANCE_EXTFRAG_THRESHOLD="400"
SYSCTL_PROFILE_PERFORMANCE_ZONE_RECLAIM_MODE="0"
# Dirty writeback budget for volatile caches and installer-managed storage.
SYSCTL_PROFILE_PERFORMANCE_DIRTY_BACKGROUND_BYTES="134217728"
SYSCTL_PROFILE_PERFORMANCE_DIRTY_BYTES="536870912"
SYSCTL_PROFILE_PERFORMANCE_DIRTY_EXPIRE_CENTISECS="1500"
SYSCTL_PROFILE_PERFORMANCE_DIRTY_WRITEBACK_CENTISECS="300"
SYSCTL_PROFILE_PERFORMANCE_DIRTYTIME_EXPIRE_SECONDS="86400"
SYSCTL_PROFILE_PERFORMANCE_STAT_INTERVAL="15"
# File descriptor, AIO, and inotify pressure limits.
SYSCTL_PROFILE_PERFORMANCE_AIO_MAX_NR="2097152"
SYSCTL_PROFILE_PERFORMANCE_INOTIFY_MAX_USER_INSTANCES="4096"
SYSCTL_PROFILE_PERFORMANCE_INOTIFY_MAX_USER_WATCHES="2097152"
SYSCTL_PROFILE_PERFORMANCE_INOTIFY_MAX_QUEUED_EVENTS="131072"
# Network accept queues and connection churn.
SYSCTL_PROFILE_PERFORMANCE_SOMAXCONN="65535"
SYSCTL_PROFILE_PERFORMANCE_NETDEV_MAX_BACKLOG="500000"
SYSCTL_PROFILE_PERFORMANCE_TCP_MAX_SYN_BACKLOG="32768"
SYSCTL_PROFILE_PERFORMANCE_TCP_FASTOPEN="3"
SYSCTL_PROFILE_PERFORMANCE_TCP_KEEPALIVE_TIME="900"
SYSCTL_PROFILE_PERFORMANCE_TCP_FIN_TIMEOUT="20"

BOOTPROFILE_DEFAULT="balanced"
BOOTPROFILE_HARDENED="hardened"
BOOTPROFILE_PERFORMANCE="performance"
GRUB_DEFAULT_ENTRY="installer-linux-dynamic"
GRUB_INITRAMFS_FLAGS="initramfs_options=mode=0755,huge=within_size"
GRUB_SYSTEMD_MASK_FLAGS="systemd.mask=nvmf-autoconnect.service systemd.mask=ModemManager.service systemd.mask=dbus-org.freedesktop.ModemManager1.service"
GRUB_CGROUP_FLAGS="systemd.unified_cgroup_hierarchy=1"
GRUB_SECURITY_CORE_FLAGS="vsyscall=none apparmor=1 lsm=landlock,lockdown,yama,integrity,apparmor,bpf module.sig_enforce=1 pti=on randomize_kstack_offset=on"
GRUB_MEMORY_CORE_FLAGS="page_alloc.shuffle=1 slab_nomerge=1 zswap.enabled=0 zswap.max_pool_percent=0 transparent_hugepage=madvise transparent_hugepage_shmem=within_size transparent_hugepage_tmpfs=within_size"
GRUB_HARDENING_FLAGS="noresume systemd.show_status=auto threadirqs random.trust_cpu=on"
GRUB_PROFILE_DEFAULT_FLAGS="audit=1 audit_backlog_limit=18192 loglevel=3 mitigations=auto lockdown=integrity nmi_watchdog=0 psi=1 workqueue.power_efficient=0 preempt=full hardened_usercopy=1 init_on_alloc=1 init_on_free=0"
GRUB_PROFILE_HARDENED_FLAGS="audit=1 audit_backlog_limit=32768 loglevel=2 mitigations=auto,nosmt lockdown=confidentiality nmi_watchdog=1 psi=1 workqueue.power_efficient=0 preempt=voluntary hardened_usercopy=2 init_on_alloc=1 init_on_free=1"
GRUB_PROFILE_PERFORMANCE_FLAGS="audit=1 audit_backlog_limit=8192 loglevel=4 mitigations=auto lockdown=integrity nmi_watchdog=0 psi=1 workqueue.power_efficient=0 preempt=full hardened_usercopy=1 init_on_alloc=0 init_on_free=0"

# Profile-owned Labwc desktop and desktop-addon policy.
DESKTOP_APPARMOR_STATE="complain"
LABWC_DESKTOP_ENABLE="true"
LABWC_MANAGED_APP_DEFAULT_EXEC="/usr/local/bin/labwc-managed-app nvidia"
LABWC_ELECTRON_APP_DEFAULT_EXEC="/usr/local/bin/labwc-electron-app nvidia"
LABWC_WAYLAND_APP_DEFAULT_EXEC="/usr/local/bin/labwc-wayland-app nvidia"

# Managed database desktop releases. Keep this block byte-identical across
# every desktop profile; software.sh validates the exact URL, size, and digest.
SOFTWARE_QOREDB_VERSION="0.1.38"
SOFTWARE_QOREDB_URL="https://github.com/QoreDB/QoreDB/releases/download/v0.1.38/QoreDB_0.1.38_amd64.deb"
SOFTWARE_QOREDB_SHA256="59d6dc6c17009b90eba22dd2585969c9869518cb843ce4e50f29f6439824c6cb"
SOFTWARE_QOREDB_BYTES="37859594"
LABWC_DESKTOP_DEFAULT_TARGET="graphical.target"
LABWC_DESKTOP_SESSION_NAME="Labwc"
LABWC_DESKTOP_SESSION_COMMENT="Labwc Wayland session"
LABWC_DESKTOP_SESSION_COMMAND="/usr/local/bin/labwc-session"
LABWC_DESKTOP_DEFAULTS_FILE="/etc/default/labwc-desktop"
LABWC_WORKSPACE_COUNT="3"

LABWC_GREETER_VT="1"
LABWC_GREETER_USER_CANDIDATES="_greetd greeter greetd"
LABWC_GREETER_COMMAND="/usr/local/bin/labwc-greeter-session"
# Keep the compositor and GTK4 rendering paths on OpenGL/EGL for both Mesa and
# NVIDIA. The isolated Labwc greeter uses the same wlroots renderer policy.
LABWC_WLR_RENDERER="gles2"
LABWC_GSK_RENDERER="opengl"
LABWC_GDK_DISABLE="vulkan"
LABWC_WLR_NO_HARDWARE_CURSORS="1"
LABWC_WLR_SCENE_DISABLE_DIRECT_SCANOUT="1"
LABWC_GREETER_WLR_RENDERER="gles2"
LABWC_GREETER_GSK_RENDERER="opengl"
LABWC_GREETER_GDK_DISABLE="vulkan"
LABWC_GREETER_WLR_NO_HARDWARE_CURSORS="1"
LABWC_GREETER_INTERNAL_SCALE="1"
LABWC_GREETER_EXTERNAL_SCALE="1"
LABWC_GREETER_HOTPLUG_DEBOUNCE_SECONDS="0"
LABWC_GREETER_PANEL_MARGIN="22"
LABWC_GREETER_PANEL_MIN_WIDTH="520"
LABWC_GREETER_PANEL_PADDING_Y="20"
LABWC_GREETER_PANEL_PADDING_X="28"
LABWC_GREETER_CONTROL_MIN_HEIGHT="48"
LABWC_GREETER_ENTRY_MIN_WIDTH="420"
LABWC_GREETER_SHELL_MIN_WIDTH="420"
LABWC_GREETER_BUTTON_MIN_WIDTH="160"

# Managed wallpaper layout:
# - /usr/share/backgrounds/desktop for the active Labwc session background
# - /usr/share/backgrounds/login for greetd/gtkgreet and lock-screen surfaces
