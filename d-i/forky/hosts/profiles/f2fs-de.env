# shellcheck shell=sh
# shellcheck disable=SC2034
# Concrete F2FS desktop profile.

NFT_PROFILE="default"
NFT_SERVICES="none"
# Wi-Fi PSK Security
WIFI_PSK_SECURITY="sae"
MANAGED_NETWORK_ETHERNET_IFACE="managed-eth0"
MANAGED_NETWORK_WIFI_IFACE="managed-wifi0"
TAILSCALE_INTERFACE="tailscale0"
TAILSCALE_UDP_PORT="41641"
TAILSCALE_ACCEPT_DNS="false"
TAILSCALE_ACCEPT_ROUTES="false"
TAILSCALE_RUN_SSH_SERVER="true"
TAILSCALE_NETFILTER_MODE="off"
TAILSCALE_OPERATOR_USER=""
TAILSCALE_ACCEPT_RISK=""
TAILSCALE_ADVERTISE_TAGS=""
TAILSCALE_ADVERTISE_ROUTES=""
TAILSCALE_ADVERTISE_EXIT_NODE="false"
TAILSCALE_EXIT_NODE=""
TAILSCALE_EXIT_NODE_ALLOW_LAN_ACCESS="false"
TAILSCALE_SHIELDS_UP="false"
TAILSCALE_REPORT_POSTURE="false"
TAILSCALE_SNAT_SUBNET_ROUTES="true"
TAILSCALE_STATEFUL_FILTERING="false"
TAILSCALE_AUTH_KEY_REQUIRED="true"
TAILSCALE_FORCE_REAUTH="false"
TAILSCALE_TIMEOUT="2m"
SYNCTHING_TCP_PORT="35000"

TMPFS_VAR_LOG="true"
TMPFS_VAR_CACHE="true"
TMPFS_VAR_LIB_APT_LISTS="false"
TMPFS_DEV_SHM="true"
TMPFS_DATA_RUN="false"
TMPFS_SYSTEMD_COREDUMP="false"

SECURE_BOOT_STATE_MODE="luks"

PARTMAN_RECIPE_NAME="f2fs-layout-desktop"
F2FS_LAYOUT_VARIANT="desktop"

DEFAULT_EFI_SLOT="1"
DEFAULT_BOOT_SLOT="2"
