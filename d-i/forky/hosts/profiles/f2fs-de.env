LABWC_GREETER_ENTRY_MIN_WIDTH="420"
LABWC_GREETER_SHELL_MIN_WIDTH="420"
LABWC_GREETER_BUTTON_MIN_WIDTH="160"

# Managed wallpaper layout:
# - /usr/share/backgrounds/desktop for the active Labwc session background
# - /usr/share/backgrounds/login for greetd/gtkgreet and lock-screen surfaces
# - /usr/share/backgrounds/other for archived alternates that remain staged
LABWC_WALLPAPER_PATH="/usr/share/backgrounds/desktop/wallpaper-1920x1080.png"
LABWC_LOCK_BACKGROUND_PATH="/usr/share/backgrounds/login/lock-1920x1080.png"
LABWC_GREETER_BACKGROUND_PATH="/usr/share/backgrounds/login/welcome-1920x1080.png"

