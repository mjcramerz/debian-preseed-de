# shellcheck shell=sh
# shellcheck disable=SC2034
# Literal appearance inputs; no shell expansion or inline comments.
# Naming: COMPONENT[_VARIANT]_ELEMENT[_STATE]_PROPERTY.
# See README.md here for native formats, palette roles and sizing ownership.
# Validated against theme-schema.tsv before use. Sizes stay in host profiles.
# Change sources, then run: make build && make check && make test.

# BTOP
BTOP_THEME="Default"
BTOP_THEME_BACKGROUND_ENABLED="True"

# CHATGPT
CHATGPT_LAUNCHER_ICON_PATH="/usr/share/icons/hicolor/512x512/apps/chatgpt.png"

# COMPUTER MANAGEMENT
COMPUTER_MANAGEMENT_LAUNCHER_ICON_NAME="preferences-system"

# DISCORD
DISCORD_LAUNCHER_ICON_PATH="/usr/share/icons/hicolor/512x512/apps/discord.png"

# FEATHERPAD
FEATHERPAD_MENU_ICON_NAME="featherpad"

# GNOTE
GNOTE_COLOR_SCHEME="light"
GNOTE_MENU_ICON_NAME="org.gnome.Gnote"
GNOTE_TEXT_FONT_FAMILY="Noto Sans"

# HYPRPOLKITAGENT
HYPRPOLKITAGENT_LAUNCHER_ICON_NAME="dialog-password"

# KDIFF3
KDIFF3_MENU_ICON_NAME="kdiff3"

# KEEPASSXC
KEEPASSXC_PASSWORD_COLORING_ENABLED="false"

# KHAL
# METADATA colors go to calendar color files; DISPLAY goes to khal/config.
KHAL_PERSONAL_CALENDAR_DISPLAY_COLOR="#ecb860"
KHAL_PERSONAL_CALENDAR_METADATA_COLOR="#ecb860"
KHAL_TASKS_CALENDAR_METADATA_COLOR="#ec8a4c"

# LABWC | Compositor, menus and shared fonts
LABWC_NOTIFICATIONS_LAUNCHER_ICON_NAME="preferences-system-notifications-symbolic"
LABWC_TWEAKS_LAUNCHER_ICON_NAME="preferences-desktop"

# LEDGER LIVE
LEDGER_LIVE_LAUNCHER_ICON_PATH="/usr/share/icons/hicolor/512x512/apps/ledger-live-desktop.png"

# LIFEREA
LIFEREA_MENU_ICON_NAME="net.sourceforge.liferea"

# MPV
MPV_TEXT_FONT_FAMILY="Noto Sans"

# MULLVAD VPN
MULLVAD_VPN_AUTOSTART_LAUNCHER_ICON_NAME="mullvad-vpn"
MULLVAD_VPN_LAUNCHER_ICON_NAME="mullvad-vpn"

# NVIM
NVIM_TRUE_COLOR_ENABLED="true"

# POSTMAN
POSTMAN_LAUNCHER_ICON_PATH="/usr/share/icons/hicolor/512x512/apps/postman.png"

# QALCULATE
QALCULATE_MENU_ICON_NAME="qalculate-qt"

# RECOLL
# QUERY_TERM_TEXT_COLOR styles query matches; UI_COLOR_SCHEME is a native selector.
RECOLL_QUERY_TERM_TEXT_COLOR="#6dc4ed"
RECOLL_UI_COLOR_SCHEME="2"

# REMOTE DESKTOP MANAGEMENT
REMOTE_DESKTOP_MANAGEMENT_LAUNCHER_ICON_NAME="preferences-desktop-remote-desktop"

# SHOW DESKTOP
SHOW_DESKTOP_LAUNCHER_ICON_NAME="show-desktop"

# TASKWARRIOR
TASKWARRIOR_ACTIVE_STYLE="bold black on yellow"
TASKWARRIOR_ALTERNATE_STYLE="on color234"
TASKWARRIOR_BLOCKED_STYLE="color245"
TASKWARRIOR_BLOCKING_STYLE="magenta"
