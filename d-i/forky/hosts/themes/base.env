DOCK_BACKGROUND_METAL_2D_COLOR="#cc0c1017"
DOCK_BORDER_COLOR="#ecb860"
DOCK_BORDER_METAL_2D_COLOR="#ecb860"
DOCK_INACTIVE_INDICATOR_2D_COLOR="#94d2bd"
DOCK_INACTIVE_INDICATOR_COLOR="#94d2bd"
DOCK_INACTIVE_INDICATOR_METAL_2D_COLOR="#94d2bd"

# FOOT | ANSI palette
# ANSI names identify palette roles, not fixed hue values.
# Native regular0..7 = NORMAL; bright0..7 = BRIGHT. Values have no # prefix.
FOOT_DARK_ANSI_NORMAL_BLACK_COLOR="1c1f26"
FOOT_DARK_ANSI_NORMAL_RED_COLOR="ca5252"
FOOT_DARK_ANSI_NORMAL_GREEN_COLOR="7a9f64"
