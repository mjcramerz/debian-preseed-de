# Shared install-time logging policy. This is DATA, not a shell extension point.
# Only double-quoted literals and references to PREVIOUSLY declared LOG_* keys
# are permitted; scripts/common/logging-validate.awk validates before sourcing.
# No shell commands, escapes, globs, spaces, or caller/environment overrides.
# SYSTEMD_JOURNAL_* storage/retention policy remains in each host profile.
# Keep native filenames where upstream exposes only a log directory (CrowdSec).
# Group adm may read system diagnostics; ordinary users get no log-directory
# write access. ClamAV alone owns its native file directory for native rotation.
# Its root-owned journal/scanner destinations are deliberately OUTSIDE it.
# Native ClamAV rotates to one .old file; CrowdSec uses its own bounded rotation.
# Root rsyslog files use logrotate. Lynis/chkrootkit keep their native scan sets;
# rkhunter keeps current + .old. Never run two rotators against the same file.

LOG_ROOT="/var/log/managed"
LOG_APPS_DIR="${LOG_ROOT}/apps"
LOG_SECURITY_DIR="${LOG_ROOT}/security"
LOG_SYSTEM_DIR="${LOG_ROOT}/system"
LOG_INITRAMFS_DIR="${LOG_SYSTEM_DIR}/initramfs"
LOG_INITRAMFS_MAXSIZE_BYTES="1048576"
LOG_DESKTOP_DIR="${LOG_ROOT}/desktop"
LOG_MODELS_DIR="${LOG_ROOT}/models"
# Persistent boot exports and native power output, independent of volatile /var/log.
LOG_JOURNAL_DIR="/var/lib/journal"
LOG_BOOT_DIR="${LOG_JOURNAL_DIR}/boot"
LOG_POWER_DIR="${LOG_JOURNAL_DIR}/power"
LOG_POWER_ACTIONS_FILE="${LOG_POWER_DIR}/actions.log"
LOG_POWER_RETENTION_DAYS="7"
LOG_BOOT_COUNT="10"
LOG_BOOT_MAXSIZE_MIB="32"
LOG_BOOT_DELAY_SECONDS="60"
LOG_OWNER="root"
LOG_GROUP="adm"
LOG_FILE_MODE="0640"
LOG_DIRECTORY_MODE="0750"
LOG_TRAVERSE_DIRECTORY_MODE="0751"
LOG_ROTATE_COUNT="4"
LOG_ROTATE_MAXAGE_DAYS="7"
LOG_ROTATE_MAXSIZE_MIB="4"
LOG_SCANNER_MAXSIZE_MIB="20"
LOG_ROTATE_CHECK_MINUTES="15"
LOG_RSYSLOG_SPOOL_DIR="/var/spool/rsyslog"
LOG_RSYSLOG_CURSOR_NAME="imjournal.state"
LOG_RSYSLOG_CURSOR_INTERVAL="100"
LOG_RSYSLOG_QUEUE_MESSAGES="1000"
LOG_RSYSLOG_QUEUE_HIGH="800"
LOG_RSYSLOG_QUEUE_LOW="200"
LOG_RSYSLOG_QUEUE_DISK_MIB="64"
LOG_RSYSLOG_QUEUE_SEGMENT_MIB="8"
LOG_RSYSLOG_RESUME_SECONDS="10"
LOG_SCANNER_SOCKET="/run/rsyslog/security-scanners/scanner.sock"
LOG_CHATGPT_SOCKET="/run/rsyslog/openai/chatgpt.sock"
LOG_CLAMAV_MAXSIZE_MIB="4"
LOG_CLAMAV_OWNER="clamav"
# Keep native rotation files readable by the configured log-reader group.
LOG_CLAMAV_DIRECTORY_MODE="2750"
LOG_CROWDSEC_LEVEL="info"
LOG_AUDIT_MAXSIZE_MIB="8"
LOG_AUDIT_FILE_COUNT="4"
LOG_AUTH_DIR="${LOG_SECURITY_DIR}/auth"
LOG_AUTH_FILE="${LOG_AUTH_DIR}/auth.log"
