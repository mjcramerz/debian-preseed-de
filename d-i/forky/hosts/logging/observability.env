# Shared install-time logging policy. This is DATA, not a shell extension point.
# Only double-quoted literals and references to PREVIOUSLY declared LOG_* keys
# are permitted; scripts/common/logging-validate.awk validates before sourcing.
# No shell commands, escapes, globs, spaces, or caller/environment overrides.
# SYSTEMD_JOURNAL_* storage/retention policy remains in each host profile.
# Keep native filenames where upstream exposes only a log directory (CrowdSec).
# Group adm may read system diagnostics; ordinary users get no log-directory
# write access. ClamAV alone owns its native file directory for native rotation.
# Its root-owned journal/scanner destinations are deliberately OUTSIDE it.
# Native ClamAV rotates to one .old file; CrowdSec uses its own bounded rotation.
# Root rsyslog files rotate within omfile at 2 MiB. Lynis/chkrootkit keep their native scan sets;
# rkhunter keeps current + .old. Never run two rotators against the same file.

LOG_ROOT="/var/log/managed"
LOG_APPS_DIR="${LOG_ROOT}/apps"
LOG_SECURITY_DIR="${LOG_ROOT}/security"
LOG_SYSTEM_DIR="${LOG_ROOT}/system"
LOG_INITRAMFS_DIR="${LOG_SYSTEM_DIR}/initramfs"
LOG_INITRAMFS_MAXSIZE_BYTES="1048576"
LOG_DESKTOP_DIR="${LOG_ROOT}/desktop"
LOG_MODELS_DIR="${LOG_ROOT}/models"
# Persistent boot exports and native power output, independent of volatile /var/log.
LOG_JOURNAL_DIR="/var/lib/journal"
LOG_BOOT_DIR="${LOG_JOURNAL_DIR}/boot"
LOG_POWER_DIR="${LOG_JOURNAL_DIR}/power"
LOG_POWER_ACTIONS_FILE="${LOG_POWER_DIR}/actions.log"
LOG_POWER_RETENTION_DAYS="7"
LOG_BOOT_COUNT="10"
LOG_BOOT_MAXSIZE_MIB="32"
LOG_BOOT_DELAY_SECONDS="60"
LOG_OWNER="root"
LOG_GROUP="adm"
LOG_FILE_MODE="0640"
LOG_DIRECTORY_MODE="0750"
LOG_TRAVERSE_DIRECTORY_MODE="0751"
LOG_ROTATE_COUNT="4"
LOG_ROTATE_MAXAGE_DAYS="7"
LOG_ROTATE_MAXSIZE_MIB="2"
LOG_RSYSLOG_SPOOL_DIR="/var/spool/rsyslog"
LOG_RSYSLOG_QUEUE_MESSAGES="1000"
LOG_RSYSLOG_QUEUE_HIGH="800"
LOG_RSYSLOG_QUEUE_LOW="200"
LOG_RSYSLOG_QUEUE_DISK_MIB="64"
LOG_RSYSLOG_QUEUE_SEGMENT_MIB="8"
LOG_RSYSLOG_RESUME_SECONDS="10"
LOG_SCANNER_SOCKET="/run/rsyslog/security-scanners/scanner.sock"
LOG_CHATGPT_SOCKET="/run/rsyslog/openai/chatgpt.sock"
LOG_CLAMAV_MAXSIZE_MIB="2"
LOG_CLAMAV_OWNER="clamav"
# Keep native rotation files readable by the configured log-reader group.
LOG_CLAMAV_DIRECTORY_MODE="2750"
LOG_CROWDSEC_LEVEL="info"
LOG_AUDIT_MAXSIZE_MIB="2"
LOG_AUDIT_FILE_COUNT="4"
LOG_AUTH_DIR="${LOG_SECURITY_DIR}/auth"
LOG_AUTH_FILE="${LOG_AUTH_DIR}/auth.log"
LOG_APPARMOR_DIR="${LOG_SECURITY_DIR}/apparmor"
LOG_APPARMOR_FILE="${LOG_APPARMOR_DIR}/apparmor.log"
LOG_CHKROOTKIT_DIR="${LOG_SECURITY_DIR}/chkrootkit"
LOG_CHKROOTKIT_FILE="${LOG_CHKROOTKIT_DIR}/chkrootkit.log"
LOG_DEBSECAN_DIR="${LOG_SECURITY_DIR}/debsecan"
LOG_DEBSECAN_FILE="${LOG_DEBSECAN_DIR}/debsecan.log"
LOG_DEBSUMS_DIR="${LOG_SECURITY_DIR}/debsums"
LOG_DEBSUMS_FILE="${LOG_DEBSUMS_DIR}/debsums.log"
LOG_FAIL2BAN_DIR="${LOG_SECURITY_DIR}/fail2ban"
LOG_FAIL2BAN_FILE="${LOG_FAIL2BAN_DIR}/fail2ban.log"
LOG_LYNIS_DIR="${LOG_SECURITY_DIR}/lynis"
LOG_LYNIS_FILE="${LOG_LYNIS_DIR}/lynis.log"
LOG_RKHUNTER_DIR="${LOG_SECURITY_DIR}/rkhunter"
LOG_RKHUNTER_FILE="${LOG_RKHUNTER_DIR}/rkhunter.log"
LOG_SPECTRE_MELTDOWN_DIR="${LOG_SECURITY_DIR}/spectre-meltdown-checker"
LOG_SPECTRE_MELTDOWN_FILE="${LOG_SPECTRE_MELTDOWN_DIR}/spectre-meltdown-checker.log"
LOG_NFTABLES_DIR="${LOG_SECURITY_DIR}/nftables"
LOG_NFTABLES_FILE="${LOG_NFTABLES_DIR}/nftables.log"
LOG_CLAMAV_DIR="${LOG_SECURITY_DIR}/clamav"
LOG_CLAMAV_FILE="${LOG_CLAMAV_DIR}/clamav.log"
LOG_CLAMSCAN_DIR="${LOG_SECURITY_DIR}/clamscan"
LOG_CLAMSCAN_FILE="${LOG_CLAMSCAN_DIR}/clamscan.log"
LOG_CROWDSEC_DIR="${LOG_SECURITY_DIR}/crowdsec"
LOG_CROWDSEC_FILE="${LOG_CROWDSEC_DIR}/crowdsec.log"
LOG_APPARMOR_MODES_FILE="${LOG_APPARMOR_DIR}/modes.log"
LOG_FRESHCLAM_FILE="${LOG_CLAMAV_DIR}/freshclam.log"
LOG_CLAMAV_SCAN_FILE="${LOG_CLAMSCAN_FILE}"
LOG_CROWDSEC_API_FILE="${LOG_CROWDSEC_DIR}/crowdsec_api.log"
LOG_CROWDSEC_BOUNCER_FILE="${LOG_CROWDSEC_DIR}/crowdsec-firewall-bouncer.log"
LOG_RKHUNTER_SCAN_FILE="${LOG_RKHUNTER_DIR}/scan.log"
LOG_LYNIS_SCAN_FILE="${LOG_LYNIS_DIR}/scan.log"
LOG_LYNIS_REPORT_FILE="${LOG_LYNIS_DIR}/lynis-report.dat"
LOG_CHKROOTKIT_DAILY_FILE="${LOG_CHKROOTKIT_DIR}/daily.log"
LOG_CHKROOTKIT_RAW_FILE="${LOG_CHKROOTKIT_DIR}/daily.log.raw"
LOG_CHKROOTKIT_EXPECTED_FILE="${LOG_CHKROOTKIT_DIR}/log.expected"
LOG_KERNEL_FILE="${LOG_SYSTEM_DIR}/kernel.log"
LOG_AUDIT_DIR="${LOG_SECURITY_DIR}/audit"
LOG_AUDIT_FILE="${LOG_AUDIT_DIR}/auditd.log"
LOG_USB_DIR="${LOG_SYSTEM_DIR}/usb"
LOG_USB_FILE="${LOG_USB_DIR}/usb.log"
LOG_STORAGE_DIR="${LOG_SYSTEM_DIR}/storage"
LOG_STORAGE_FILE="${LOG_STORAGE_DIR}/storage.log"
LOG_ZRAM_DIR="${LOG_SYSTEM_DIR}/zram"
LOG_ZRAM_FILE="${LOG_ZRAM_DIR}/zram.log"
LOG_FWUPD_DIR="${LOG_SYSTEM_DIR}/fwupd"
LOG_TIMESHIFT_DIR="${LOG_SYSTEM_DIR}/timeshift"
LOG_TIMESHIFT_FILE="${LOG_TIMESHIFT_DIR}/timeshift.log"
LOG_DEBUGSYS_DIR="${LOG_SYSTEM_DIR}/debugsys"
LOG_SYSTEM_SERVICES_FILE="${LOG_SYSTEM_DIR}/system.log"
LOG_FWUPD_SCAN_FILE="${LOG_FWUPD_DIR}/security-scan.log"
LOG_APPLICATIONS_FILE="${LOG_APPS_DIR}/apps.log"
LOG_CHATGPT_DIR="${LOG_MODELS_DIR}/openai/chatgpt"
LOG_CHATGPT_FILE="${LOG_CHATGPT_DIR}/chatgpt.log"
LOG_WHISPER_DIR="${LOG_MODELS_DIR}/whisper"
LOG_WHISPER_FILE="${LOG_WHISPER_DIR}/whisper.log"
LOG_OPENAI_DIR="${LOG_MODELS_DIR}/openai"
LOG_CHATGPT_RUNTIME_DIR="${LOG_CHATGPT_DIR}/runtime"
LOG_CHATGPT_RUNTIME_LOGIN_FILE="${LOG_CHATGPT_RUNTIME_DIR}/codex-login.log"
LOG_CHATGPT_RUNTIME_TUI_FILE="${LOG_CHATGPT_RUNTIME_DIR}/codex-tui.log"
LOG_CODEX_RUNTIME_DIR="${LOG_OPENAI_DIR}/codex"
LOG_CODEX_LOGIN_FILE="${LOG_CODEX_RUNTIME_DIR}/codex-login.log"
LOG_CODEX_TUI_FILE="${LOG_CODEX_RUNTIME_DIR}/codex-tui.log"
LOG_RSYSLOG_MAIN_QUEUE_MESSAGES="2000"
LOG_RSYSLOG_MESSAGE_KIB="64"
LOG_SCANNER_RATE_INTERVAL="60"
LOG_SCANNER_RATE_BURST="4000"
LOG_RSYSLOG_MAX_OPEN_FILES="512"

# Native omfile threshold; it is not a hard cap (one record/batch can cross it).
LOG_RSYSLOG_ROTATE_BYTES="2097152"
# Per-PID throttling of notice/info/debug only; higher-priority events bypass it.
LOG_SYSLOG_RATE_INTERVAL="30"
LOG_SYSLOG_RATE_BURST="2000"
