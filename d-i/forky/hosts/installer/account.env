# shellcheck shell=sh
# shellcheck disable=SC2016,SC2034
# Shared human-account and SSH bootstrap policy.
# No reusable passwords or password hashes are distributed with this tree.
# Provision account/calendar credentials through your access-controlled deployment
# configuration before installing. Missing account credentials fail validation.
# Previously embedded credentials must be rotated; removal does not revoke them.

# Local root login is required. This is independent of SSH PermitRootLogin no.
# Resolve the root password from the first root_password command-line parameter,
# or PRESEED_ROOT_PASSWORD in the installer's /preseed.env when it is absent.
# No locked-account or shared password/hash fallback is permitted.
ROOT_LOGIN=true
ACCOUNT_USERNAME="mcramer"
ACCOUNT_FULLNAME="Matthew Cramer"
ACCOUNT_PASSWORD_CRYPTED="${ACCOUNT_PASSWORD_CRYPTED:-}"
ACCOUNT_DEFAULT_GROUPS="audio cdrom video sudo"
ACCOUNT_HOME="/home/${ACCOUNT_USERNAME}"
FRUUX_CALENDAR_USERNAME="${FRUUX_CALENDAR_USERNAME:-}"
FRUUX_CALENDAR_PASSWORD="${FRUUX_CALENDAR_PASSWORD:-}"

# User-facing home path contract. Storage families decide whether these paths
# are plain directories or dedicated mount/subvolume targets.
DIR_HOME_DESKTOP="${ACCOUNT_HOME}/Desktop"
DIR_HOME_DOCUMENTS="${ACCOUNT_HOME}/Documents"
DIR_HOME_DOWNLOADS="${ACCOUNT_HOME}/Downloads"
DIR_HOME_MUSIC="${ACCOUNT_HOME}/Music"
DIR_HOME_PUBLIC="${ACCOUNT_HOME}/Public"
DIR_HOME_PICTURES="${ACCOUNT_HOME}/Pictures"
DIR_HOME_TEMPLATES="${ACCOUNT_HOME}/Templates"
DIR_HOME_VIDEOS="${ACCOUNT_HOME}/Videos"
DIR_HOME_WORKSPACE="${ACCOUNT_HOME}/Workspace"
DIR_HOME_SYNCTHING="${ACCOUNT_HOME}/Syncthing"
DIR_HOME_LOCAL_STATE="${ACCOUNT_HOME}/.local/state"
DIR_HOME_SYNCTHING_STATE="${DIR_HOME_LOCAL_STATE}/syncthing"

# SSH bootstrap assets. The managed user SSH client config is staged for the
# desktop/server roles, while the server config and authorized_keys stay tied
# to the addon/ssh class.
SSH_PUBLIC_KEY_SOURCE="ssh/lan_ed25519.pub"
SSHD_CONFIG_SOURCE="ssh/sshd_config"
SSH_USER_CONFIG_SOURCE="ssh/config"
SSH_PUBLIC_KEY_MAX_BYTES="4096"
SSH_CONFIG_MAX_BYTES="65536"
SSH_AUTHORIZED_KEYS_TARGET="${ACCOUNT_HOME}/.ssh/authorized_keys"
SSH_USER_CONFIG_TARGET="${ACCOUNT_HOME}/.ssh/config"
