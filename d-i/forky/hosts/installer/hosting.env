# shellcheck shell=sh
# shellcheck disable=SC2016,SC2034
# Shared NFS policy. Loaded AFTER the selected profile, before account policy.
# These expansions use the selected host's paths, port and mount timeout.
# AUTH_SYS is for trusted LAN peers: identical numeric identities on each host.

NFS_ACCOUNT_UID="1000"
NFS_ACCOUNT_GID="1000"
NFS_SHARED_GROUP="nfs-sharing"
NFS_SHARED_GID="2050"
NFS_SERVER_APT_DEPS="nfs-kernel-server nfs-common libnfsidmap1 keyutils nftables acl e2fsprogs"
NFS_CLIENT_APT_DEPS="nfs-common libnfsidmap1 keyutils nftables e2fsprogs"
NFS_CLIENT_VERSION="4.2"
NFS_SERVER_RW_OPTIONS="rw,sync,subtree_check,root_squash,secure,sec=sys,fsid=0"
NFS_SERVER_RO_OPTIONS="ro,sync,subtree_check,root_squash,secure,sec=sys,fsid=0"
NFS_SERVER_EXPORTS="${NFS_SERVER_PATH} 192.168.50.82/31(${NFS_SERVER_RW_OPTIONS}) 192.168.50.84/30(${NFS_SERVER_RW_OPTIONS}) 192.168.50.88/29(${NFS_SERVER_RW_OPTIONS}) 192.168.50.96/30(${NFS_SERVER_RW_OPTIONS}) 192.168.50.100/32(${NFS_SERVER_RW_OPTIONS}) 192.168.50.112/29(${NFS_SERVER_RO_OPTIONS}) 192.168.50.120/31(${NFS_SERVER_RO_OPTIONS}) 192.168.50.122/32(${NFS_SERVER_RO_OPTIONS}) 192.168.50.212/30(${NFS_SERVER_RW_OPTIONS}) 192.168.50.216/30(${NFS_SERVER_RW_OPTIONS}) 192.168.50.220/31(${NFS_SERVER_RW_OPTIONS}) 192.168.50.222/32(${NFS_SERVER_RW_OPTIONS})"

# Required safety and lifecycle flags are validated before any target mutation.
# NFS_CLIENT_READ_ONLY also enforces ro on the remote mount and its home bind.
NFS_MNT_SERVER_BIND_HOME_OPTS="bind,nosuid,nodev,noexec,nofail,x-systemd.requires-mounts-for=${NFS_SERVER_PATH}"
NFS_MNT_CLIENT_BIND_HOME_OPTS="bind,nosuid,nodev,noexec,nofail,x-systemd.requires-mounts-for=${NFS_CLIENT_PATH},_netdev,x-systemd.automount,x-systemd.mount-timeout=${NFS_CLIENT_MOUNT_TIMEOUT}s"
NFS_MNT_CLIENT_TARGET_SHARE_OPTS="rw,hard,proto=tcp,port=${NFS_SERVER_PORT},resvport,sec=sys,vers=${NFS_CLIENT_VERSION},nosuid,nodev,noexec,_netdev,nofail,x-systemd.automount,x-systemd.mount-timeout=${NFS_CLIENT_MOUNT_TIMEOUT}s,x-systemd.requires=nfs-client.target,x-systemd.requires=nftables.service,x-systemd.requires=network-sharing-identity.service"
