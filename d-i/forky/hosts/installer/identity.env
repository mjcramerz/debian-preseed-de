# shellcheck shell=sh
# shellcheck disable=SC2034
# Shared machine identity defaults for every installer profile.

# The installer generates SYSTEM_HOSTNAME once per run as
# ${SYSTEM_PREFIX}-### and persists it in runtime.env for later stages.

# System upstream DNS. DNS1 is required; DNS2 is an optional fallback.
# Each enabled resolver needs a TLS hostname and at least one IP address.
# An empty address disables that resolver's IPv4 or IPv6 transport only.
# Leave all three DNS2 values empty to use DNS1 alone.
# SYSTEM_NAMESERVERS_PORT applies to every authenticated upstream.
SYSTEM_NAMESERVERS_IPV4_DNS1="89.233.43.71"
SYSTEM_NAMESERVERS_IPV6_DNS1="2a01:3a0:53:53::"
SYSTEM_NAMESERVERS_HOSTNAME_DNS1="unicast.uncensoreddns.org"
SYSTEM_NAMESERVERS_IPV4_DNS2="91.239.100.100"
SYSTEM_NAMESERVERS_IPV6_DNS2="2001:67c:28a4::"
SYSTEM_NAMESERVERS_HOSTNAME_DNS2="anycast.uncensoreddns.org"
SYSTEM_NAMESERVERS_PORT="853"

# Local application DNS cache. The minimum deliberately extends shorter TTLs;
# upstream TTLs above this minimum remain unchanged. Dnsmasq limits it to 1 hour.
SYSTEM_DNS_CACHE_SIZE="10000"
SYSTEM_DNS_CACHE_MIN_TTL="60"

# Debian Installer uses ordinary DNS before the target TLS resolver is installed.
STATIC_INSTALLER_NAMESERVER="1.1.1.1"

# Hostname & Domain
SYSTEM_PREFIX="LPL"
SYSTEM_DOMAIN="lan.icramer.com"
