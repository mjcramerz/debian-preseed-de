# shellcheck shell=sh
# shellcheck disable=SC2034
# Shared machine identity defaults for every installer profile.

# The installer generates SYSTEM_HOSTNAME once per run as
# ${SYSTEM_PREFIX}-### and persists it in runtime.env for later stages.

# System upstream DNS. DNS1 is required; DNS2 and DNS3 are optional fallbacks.
# Each enabled resolver needs a TLS hostname and at least one IP address.
# An empty address disables that resolver's IPv4 or IPv6 transport only.
# Leave all three values of an optional resolver empty to disable it.
# SYSTEM_NAMESERVERS_PORT applies to every authenticated upstream.
SYSTEM_NAMESERVERS_IPV4_DNS1="89.233.43.71"
SYSTEM_NAMESERVERS_IPV6_DNS1="2a01:3a0:53:53::"
SYSTEM_NAMESERVERS_HOSTNAME_DNS1="unicast.uncensoreddns.org"
SYSTEM_NAMESERVERS_IPV4_DNS2="91.239.100.100"
SYSTEM_NAMESERVERS_IPV6_DNS2="2001:67c:28a4::"
SYSTEM_NAMESERVERS_HOSTNAME_DNS2="anycast.uncensoreddns.org"
SYSTEM_NAMESERVERS_IPV4_DNS3=""
SYSTEM_NAMESERVERS_IPV6_DNS3=""
SYSTEM_NAMESERVERS_HOSTNAME_DNS3=""
SYSTEM_NAMESERVERS_PORT="853"

# false: Debian's public CA bundle; verify each resolver's configured hostname
# against its live certificate SAN during installation. No certificate TOFU.
# true: use the X.509 CA supplied beside /preseed.env in the installer root.
# PRESEED_DNS_UPSTREAM_TLS_CA_NAME_CUSTOM in /preseed.env is its basename,
# including extension. It is copied only into Stubby's dedicated trust store.
SYSTEM_DNS_UPSTREAM_TLS_CA_CUSTOM_ENABLE="false"
# Used for every enabled resolver only when custom CA mode is true.
SYSTEM_NAMESERVERS_TLS_SAN_CUSTOM="dns.lan.icramer.com"

# Local application DNS cache. The minimum deliberately extends shorter TTLs;
# upstream TTLs above this minimum remain unchanged. Dnsmasq limits it to 1 hour.
SYSTEM_DNS_CACHE_SIZE="10000"
SYSTEM_DNS_CACHE_MIN_TTL="60"

# Debian Installer uses ordinary DNS before the target TLS resolver is installed.
STATIC_INSTALLER_NAMESERVER="1.1.1.1"

# Hostname & Domain
SYSTEM_PREFIX="LPL"
SYSTEM_DOMAIN="lan.icramer.com"

# Fixed application IPv4 /30 links. The identity map assigns two slots to
# ordinary applications and one slot to applications with peer forwarding or
# route pinning. APP_VETH_OVERRIDE may restrict the generated policy per host.
APP_VETH_IPV4_CIDR="10.203.0.0/23"
APP_VETH_MAX_LEASES="128"
APP_VETH_HOST_INTERFACE_PREFIX="veth"
APP_VETH_HOST_INTERFACE_SUFFIX="-app"
APP_VETH_PEER_INTERFACE_SUFFIX="-peer"
APP_VETH_NAMESPACE_INTERFACE="eth0"
APP_VETH_DNS_ADDRESS="10.0.2.3"
APP_VETH_DNS_HOST_ADDRESS="127.0.0.1"
APP_VETH_DNS_HOST_PORT="53053"
APP_VETH_TLS_HOST_ADDRESS="127.0.0.1"
APP_VETH_TLS_HOST_PORT="53054"
APP_VETH_OVERRIDE=""
