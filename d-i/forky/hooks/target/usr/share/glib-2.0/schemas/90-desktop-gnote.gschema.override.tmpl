[org.gnome.gnote]
color-scheme='__THEME_GNOTE_COLOR_SCHEME__'
enable-auto-links=true
enable-bulleted-lists=true
enable-custom-font=false
enable-spellchecking=true
enable-url-links=true
enable-wikiwords=false
custom-font-face='__THEME_GNOTE_TEXT_FONT_FAMILY__ __INSTALLER_LABWC_GTK_FONT_SIZE__'
editor-tab-width=4
menu-note-count=14
note-rename-behavior=2
search-window-height=640
search-window-width=900
use-client-side-decorations='disabled'

[org.gnome.gnote.export-html]
export-linked=true
export-linked-all=false
last-directory='__INSTALLER_DIR_HOME_DOCUMENTS__'

[org.gnome.gnote.insert-timestamp]
format='%Y-%m-%d %H:%M'

[org.gnome.gnote.note-directory-watcher]
check-interval=5

[org.gnome.gnote.sync]
autosync-timeout=-1
sync-conflict-behavior=0
