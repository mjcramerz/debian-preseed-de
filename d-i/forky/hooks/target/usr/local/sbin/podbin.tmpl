      -f -u "${PODBIN_CONTAINER_NAME}.service"
  else
    user_podman "$user" "$PODBIN_USER_UID" "$PODBIN_USER_HOME" logs \
      --follow "$PODBIN_CONTAINER_NAME"
  fi
}

inspect_container_action() {
  user=$1
  requested_container=${2:-}
  ensure_existing_user_ready "$user"
  container=$(select_container "$user" "$requested_container")
  load_metadata "$user" "$container"
  user_podman "$user" "$PODBIN_USER_UID" "$PODBIN_USER_HOME" inspect "$PODBIN_CONTAINER_NAME"
}

delete_container() {
  user=$1
  requested_container=${2:-}
  ensure_existing_user_ready "$user"
  container=$(select_container "$user" "$requested_container")
  load_metadata "$user" "$container"
  confirm_exact "Delete container ${container} for ${user} and its managed data." "DELETE ${user}/${container}"
  if [ "$PODBIN_BACKEND" = quadlet ]; then
    user_systemctl "$user" "$PODBIN_USER_UID" "$PODBIN_USER_HOME" \
      disable --now "${PODBIN_CONTAINER_NAME}.service" >/dev/null 2>&1 || true
  fi
  if ! user_podman "$user" "$PODBIN_USER_UID" "$PODBIN_USER_HOME" \
    rm --force --volumes "$PODBIN_CONTAINER_NAME" >/dev/null 2>&1; then
    [ "$PODBIN_BACKEND" = quadlet ] ||
      fatal "failed to remove imported container: $PODBIN_CONTAINER_NAME"
    warn "container removal reported an error; continuing metadata cleanup: $PODBIN_CONTAINER_NAME"
  fi
  if [ "$PODBIN_BACKEND" = quadlet ]; then
    unit_dir=$(user_systemd_dir "$PODBIN_USER_UID")
    require_managed_child_path "unit path" "$unit_dir" "$PODBIN_UNIT_PATH"
    rm -f "$PODBIN_UNIT_PATH"
    require_managed_child_path "container data directory" "$(user_config_root "$user")" "$PODBIN_DATA_DIR"
    rm -rf -- "$PODBIN_DATA_DIR"
  fi
  rm -f "$(metadata_path "$user" "$container")"
  if [ "$PODBIN_BACKEND" = quadlet ]; then
    user_systemctl "$user" "$PODBIN_USER_UID" "$PODBIN_USER_HOME" daemon-reload
  fi
  printf 'podbin container deleted: user=%s container=%s\n' "$user" "$container"
}

connect_container() {
  user=$1
  requested_container=${2:-}
  ensure_existing_user_ready "$user"
  container=$(select_container "$user" "$requested_container")
  start_container "$user" "$container"
  load_metadata "$user" "$container"
  [ "$PODBIN_BACKEND" = quadlet ] ||
    fatal "imported container has no managed SSH endpoint: $container"
  connect_host=$PODBIN_BIND_IP
  [ "$connect_host" != 0.0.0.0 ] || connect_host=127.0.0.1
  key_path="${PODBIN_KEY_DIR}/${PODBIN_KEY_NAME}"
  [ -f "$key_path" ] || fatal "podbin SSH key is missing: $key_path"
  ensure_known_hosts_file
  exec /usr/bin/ssh \
    -i "$key_path" \
    -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=accept-new \
    -o GlobalKnownHostsFile=/dev/null \
    -o UserKnownHostsFile="$PODBIN_KNOWN_HOSTS_FILE" \
    -p "$PODBIN_HOST_PORT" \
    "${PODBIN_CONTAINER_SSH_USER}@${connect_host}"
}

open_container() {
  user=$1
  requested_container=${2:-}
  ensure_existing_user_ready "$user"
  container=$(select_container "$user" "$requested_container")
  start_container "$user" "$container"
  load_metadata "$user" "$container"
  if [ "$PODBIN_BACKEND" = quadlet ]; then
    user_podman "$user" "$PODBIN_USER_UID" "$PODBIN_USER_HOME" \
      exec --user "${PODBIN_RUNTIME_USER_UID}:${PODBIN_RUNTIME_USER_GID}" \
      -it "$PODBIN_CONTAINER_NAME" "$PODBIN_CONTAINER_SHELL"
  else
    user_podman "$user" "$PODBIN_USER_UID" "$PODBIN_USER_HOME" \
      exec -it "$PODBIN_CONTAINER_NAME" /bin/sh
  fi
}

prune_all() {
  user=$1
  ensure_existing_user_ready "$user"
  user_podman "$user" "$PODBIN_USER_UID" "$PODBIN_USER_HOME" \
    system prune --all --volumes --build --force
  printf 'podbin unused resources pruned: user=%s\n' "$user"
}

user_podman_action() {
  user=$1
  shift
  [ "$#" -gt 0 ] || fatal "Podman arguments are required"
  ensure_existing_user_ready "$user"
  user_podman "$user" "$PODBIN_USER_UID" "$PODBIN_USER_HOME" "$@"
}

user_systemctl_action() {
  user=$1
  shift
  [ "$#" -gt 0 ] || fatal "systemctl --user arguments are required"
  ensure_existing_user_ready "$user"
  user_systemctl "$user" "$PODBIN_USER_UID" "$PODBIN_USER_HOME" "$@"
}

user_journalctl_action() {
  user=$1
  shift
  [ "$#" -gt 0 ] || fatal "journalctl --user arguments are required"
  ensure_existing_user_ready "$user"
  user_journalctl "$user" "$PODBIN_USER_UID" "$PODBIN_USER_HOME" "$@"
}

user_shell_action() {
  user=$1
  ensure_existing_user_ready "$user"
  user_shell "$user" "$PODBIN_USER_UID" "$PODBIN_USER_HOME" -l
}

remove_account_entry() (
  account_file=$1
  account_name=$2
  [ -e "$account_file" ] || return 0
  [ ! -L "$account_file" ] || fatal "account database must not be a symlink: $account_file"
  account_tmp=$(mktemp "${PODBIN_WORK_DIR}/account-entry.XXXXXX") ||
    fatal "failed to allocate account database update"
  trap 'rm -f "$account_tmp"' EXIT HUP INT TERM
  awk -F: -v account="$account_name" '$1 != account { print }' "$account_file" >"$account_tmp"
  install -m 0644 -o root -g root "$account_tmp" "$account_file"
)

remove_managed_tree() {
  remove_label=$1
  remove_base=$2
  remove_path=$3
  require_managed_child_path "$remove_label" "$remove_base" "$remove_path"
  [ "$remove_path" != "$remove_base" ] || fatal "refusing to remove managed base path: $remove_base"
  [ -e "$remove_path" ] || [ -L "$remove_path" ] || return 0
  rm -rf -- "$remove_path"
}

remove_user_quadlet_link() {
  remove_uid=$1
  expected_target=$2
  quadlet_link="/etc/containers/systemd/users/${remove_uid}"
  if [ -L "$quadlet_link" ]; then
    [ "$(readlink "$quadlet_link")" = "$expected_target" ] ||
      fatal "refusing unexpected Podman Quadlet link: $quadlet_link"
    rm -f "$quadlet_link"
  elif [ -e "$quadlet_link" ]; then
    fatal "refusing non-symlink Podman Quadlet path: $quadlet_link"
  fi
}

wipe_all() {
  user=$1
  load_managed_user "$user"
  [ "$PODBIN_USER_IMPORTED" -eq 0 ] ||
    fatal "refusing to wipe an imported user automatically; export or remove its containers first"
  require_command userdel
  require_command groupdel
  require_command loginctl
  require_command systemctl

  wipe_uid=$PODBIN_USER_UID
  wipe_gid=$PODBIN_USER_GID
  wipe_group=$PODBIN_USER_GROUP
  wipe_home=$PODBIN_USER_HOME
  wipe_config_root=$(user_config_root "$user")
  wipe_state_root=$(user_state_root "$user")
  wipe_meta_root=$(user_meta_root "$user")
  wipe_systemd_dir=$(user_systemd_dir "$wipe_uid")

  confirm_exact "Wipe every Podman resource and delete managed user ${user}." "WIPE ${user}"
  ensure_persistent_storage_paths "$user" "$wipe_group"
  if start_user_manager "$user" "$wipe_uid" "$wipe_home"; then
    ensure_user_runtime_paths "$user" "$wipe_uid" "$wipe_group"
    for wipe_unit_path in "$wipe_systemd_dir"/*.container; do
      [ -f "$wipe_unit_path" ] || continue
      wipe_unit_name=${wipe_unit_path##*/}
      wipe_unit_name=${wipe_unit_name%.container}.service
      user_systemctl "$user" "$wipe_uid" "$wipe_home" disable --now "$wipe_unit_name" >/dev/null 2>&1 ||
        warn "failed to disable managed container unit before wipe: $wipe_unit_name"
    done
    user_systemctl "$user" "$wipe_uid" "$wipe_home" stop podman.socket podman.service >/dev/null 2>&1 || true
    if [ -r "${wipe_config_root}/containers/storage.conf" ] &&
       [ -r "${wipe_config_root}/containers/containers.conf" ]; then
      user_podman "$user" "$wipe_uid" "$wipe_home" system reset --force >/dev/null 2>&1 ||
        warn "Podman system reset failed for $user; removing the validated managed storage tree directly"
    else
      warn "managed Podman config is incomplete for $user; skipping system reset and removing validated managed trees directly"
    fi
  else
    warn "user manager did not become ready for $user; removing the validated managed storage tree directly"
  fi

  loginctl disable-linger "$user" >/dev/null 2>&1 || true
  loginctl terminate-user "$user" >/dev/null 2>&1 || true
  systemctl stop "user@${wipe_uid}.service" >/dev/null 2>&1 || true
  remove_user_quadlet_link "$wipe_uid" "$wipe_systemd_dir"
  userdel -- "$user"
  if getent group "$wipe_group" >/dev/null 2>&1; then
    groupdel -- "$wipe_group"
  fi
  remove_account_entry /etc/subuid "$user"
  remove_account_entry /etc/subgid "$user"

  remove_managed_tree "Podbin user home" "$PODBIN_USER_HOME_BASE" "$wipe_home"
  remove_managed_tree "Podbin user config" "$PODBIN_USER_CONFIG_BASE" "$wipe_config_root"
  remove_managed_tree "Podbin user state" "$PODBIN_STATE_BASE" "$wipe_state_root"
  remove_managed_tree "Podbin user metadata" "$PODBIN_ADMIN_META_BASE" "$wipe_meta_root"
  remove_managed_tree "Podbin user systemd directory" "$PODBIN_SYSTEMD_USER_BASE" "$wipe_systemd_dir"
  printf 'podbin user wiped: user=%s uid=%s gid=%s\n' "$user" "$wipe_uid" "$wipe_gid"
}

[ "$#" -ge 1 ] || {
  usage >&2
  exit 2
}

# Privileged actions must not inherit or inspect the invoking user's working
# directory. Every managed Podbin path is validated as absolute below.
cd /

action=$1
shift
require_root
require_abs_path PODBIN_USER_HOME_BASE "$PODBIN_USER_HOME_BASE"
require_abs_path PODBIN_CONFIG_BASE "$PODBIN_CONFIG_BASE"
require_abs_path PODBIN_USER_CONFIG_BASE "$PODBIN_USER_CONFIG_BASE"
require_abs_path PODBIN_SYSTEMD_USER_BASE "$PODBIN_SYSTEMD_USER_BASE"
require_abs_path PODBIN_ADMIN_META_BASE "$PODBIN_ADMIN_META_BASE"
require_abs_path PODBIN_TEMPLATE_DIR "$PODBIN_TEMPLATE_DIR"
require_abs_path PODBIN_STATE_BASE "$PODBIN_STATE_BASE"
require_abs_path PODBIN_KEY_DIR "$PODBIN_KEY_DIR"
require_abs_path PODBIN_WORK_DIR "$PODBIN_WORK_DIR"
[ "$PODBIN_WORK_DIR" = /run/podbin ] || fatal "PODBIN_WORK_DIR must remain /run/podbin"
[ "$PODBIN_KEY_DIR" = "/data/pki/ssh/podbin" ] || fatal "PODBIN_KEY_DIR must remain /data/pki/ssh/podbin so Podbin cannot access the shared desktop SSH key pool"
case "$action" in
  --ensure-keypair|--list-users|--user-env|--wipe-all|--import-user|--import-containers|--diagnose-user) ;;
  *)
    require_command stat
    PODBIN_STORAGE_DRIVER=$(resolve_native_storage_driver "$PODBIN_STORAGE_DRIVER" "$PODBIN_STATE_BASE")
    export PODBIN_STORAGE_DRIVER
    ;;
esac
require_abs_path PODBIN_RUNTIME_USER_HOME "$PODBIN_RUNTIME_USER_HOME"
require_abs_path PODBIN_RUNTIME_USER_SHELL "$PODBIN_RUNTIME_USER_SHELL"
require_abs_path PODBIN_RUNTIME_AUTH_KEYS_DIR "$PODBIN_RUNTIME_AUTH_KEYS_DIR"
require_abs_path PODBIN_RUNTIME_WORKDIR "$PODBIN_RUNTIME_WORKDIR"
require_abs_path PODBIN_KNOWN_HOSTS_FILE "$PODBIN_KNOWN_HOSTS_FILE"
require_high_port PODBIN_HIGH_PORT_MIN "$PODBIN_HIGH_PORT_MIN"
require_high_port PODBIN_PORT_SCAN_START "$PODBIN_PORT_SCAN_START"
require_high_port PODBIN_PORT_SCAN_END "$PODBIN_PORT_SCAN_END"
[ "$PODBIN_PORT_SCAN_START" -le "$PODBIN_PORT_SCAN_END" ] || fatal "PODBIN_PORT_SCAN_START must be <= PODBIN_PORT_SCAN_END"
require_high_port PODBIN_DEFAULT_CONTAINER_SSH_PORT "$PODBIN_DEFAULT_CONTAINER_SSH_PORT"
require_uint PODBIN_RUNTIME_USER_UID "$PODBIN_RUNTIME_USER_UID"
require_uint PODBIN_RUNTIME_USER_GID "$PODBIN_RUNTIME_USER_GID"
validate_image_ref "$PODBIN_DEFAULT_IMAGE"
validate_bind_ip "$PODBIN_DEFAULT_BIND_IP"
validate_container_ssh_user "$PODBIN_DEFAULT_CONTAINER_SSH_USER"
validate_shell_path "$PODBIN_DEFAULT_CONTAINER_SHELL"
validate_account_name "$PODBIN_SERVICE_USER"
validate_account_name "$PODBIN_RUNTIME_USER_NAME"
case "$PODBIN_STORAGE_DRIVER" in
  auto|btrfs|overlay) ;;
  *) fatal "PODBIN_STORAGE_DRIVER did not resolve to an approved native driver: $PODBIN_STORAGE_DRIVER" ;;
esac
[ "$PODBIN_RUNTIME_USER_NAME" != root ] || fatal "PODBIN_RUNTIME_USER_NAME must not be root"
[ "$PODBIN_RUNTIME_USER_NAME" != "$PODBIN_SERVICE_USER" ] || fatal "PODBIN_RUNTIME_USER_NAME must not reuse the reserved Podman service account"
[ "$PODBIN_RUNTIME_AUTH_KEYS_DIR" = "${PODBIN_RUNTIME_USER_HOME}/.ssh" ] || fatal "PODBIN_RUNTIME_AUTH_KEYS_DIR must remain ${PODBIN_RUNTIME_USER_HOME}/.ssh"
[ "$PODBIN_DEFAULT_CONTAINER_SSH_USER" = "$PODBIN_RUNTIME_USER_NAME" ] || fatal "PODBIN_DEFAULT_CONTAINER_SSH_USER must match PODBIN_RUNTIME_USER_NAME"
[ "$PODBIN_DEFAULT_CONTAINER_SSH_USER" != root ] || fatal "PODBIN_DEFAULT_CONTAINER_SSH_USER must not be root"
[ "$PODBIN_DEFAULT_CONTAINER_SHELL" = "$PODBIN_RUNTIME_USER_SHELL" ] || fatal "PODBIN_DEFAULT_CONTAINER_SHELL must match PODBIN_RUNTIME_USER_SHELL"
case "$action" in
  --create-user|--create-container|--import-user|--import-containers)
    [ -d "$PODBIN_TEMPLATE_DIR" ] || fatal "podbin template directory is missing: $PODBIN_TEMPLATE_DIR"
    ;;
esac
require_command install
require_command mktemp
safe_install_dir 0700 root root "$PODBIN_WORK_DIR"

case "$action" in
  --list-users)
    [ "$#" -eq 0 ] || {
      usage >&2
      exit 2
    }
    list_users
    ;;
  --ensure-keypair)
    [ "$#" -le 1 ] || {
      usage >&2
      exit 2
    }
    if [ "$#" -eq 1 ] && [ "$1" != "_" ]; then
      fatal "--ensure-keypair does not accept a username"
    fi
    ensure_keypair
    ;;
  --create-user)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    create_user "$1"
    ;;
  --import-user)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    import_user "$1"
    ;;
  --diagnose-user)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    diagnose_user "$1"
    ;;
  --user-env)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    user_env_action "$1"
    ;;
  --create-container)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    create_container "$@"
    ;;
  --import-containers)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    import_existing_containers "$1" "${2:-}"
    ;;
  --list-containers)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    list_containers "$1"
    ;;
  --container-status)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    container_status_action "$1" "${2:-}"
    ;;
  --delete-container)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    delete_container "$1" "${2:-}"
    ;;
  --start-container)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    start_container_action "$1" "${2:-}"
    ;;
  --stop-container)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    stop_container_action "$1" "${2:-}"
    ;;
  --restart-container)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    restart_container_action "$1" "${2:-}"
    ;;
  --enable-container)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    enable_container_action "$1" "${2:-}"
    ;;
  --disable-container)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    disable_container_action "$1" "${2:-}"
    ;;
  --logs-container)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    container_logs_action "$1" "${2:-}"
    ;;
  --follow-logs)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    follow_container_logs_action "$1" "${2:-}"
    ;;
  --inspect-container)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    inspect_container_action "$1" "${2:-}"
    ;;
  --connect-container)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    connect_container "$1" "${2:-}"
    ;;
  --open-container)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
      usage >&2
      exit 2
    }
    open_container "$1" "${2:-}"
    ;;
  --list-images)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    list_images "$1"
    ;;
  --list-volumes)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    list_volumes "$1"
    ;;
  --list-networks)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    list_networks "$1"
    ;;
  --list-pods)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    list_pods "$1"
    ;;
  --prune-all)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    prune_all "$1"
    ;;
  --user-podman)
    [ "$#" -ge 2 ] || {
      usage >&2
      exit 2
    }
    user_podman_action "$@"
    ;;
  --user-systemctl)
    [ "$#" -ge 2 ] || {
      usage >&2
      exit 2
    }
    user_systemctl_action "$@"
    ;;
  --user-journalctl)
    [ "$#" -ge 2 ] || {
      usage >&2
      exit 2
    }
    user_journalctl_action "$@"
    ;;
  --user-shell)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    user_shell_action "$1"
    ;;
  --wipe-all)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    wipe_all "$1"
    ;;
  --service-env)
    [ "$#" -eq 0 ] || {
      usage >&2
      exit 2
    }
    service_env
    ;;
  --service-podman)
    service_podman "$@"
    ;;
  --service-systemctl)
    service_systemctl "$@"
    ;;
  --service-journalctl)
    service_journalctl "$@"
    ;;
  --service-shell)
    [ "$#" -eq 0 ] || {
      usage >&2
      exit 2
    }
    service_shell
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
