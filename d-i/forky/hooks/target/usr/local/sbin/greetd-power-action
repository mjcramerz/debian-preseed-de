#!/bin/sh
set -eu

action=${1:-}
bus_name=org.freedesktop.login1

case "$action" in
  poweroff)
    object_path=/org/freedesktop/login1
    interface_name=org.freedesktop.login1.Manager
    method=PowerOff
    signature=b
    set -- true
    ;;
  reboot)
    object_path=/org/freedesktop/login1
    interface_name=org.freedesktop.login1.Manager
    method=Reboot
    signature=b
    set -- true
    ;;
  *)
    printf 'usage: greetd-power-action {poweroff|reboot}\n' >&2
    exit 64
    ;;
esac

exec /usr/bin/busctl --system call \
  "$bus_name" \
  "$object_path" \
  "$interface_name" \
  "$method" \
  "$signature" \
  "$@"
