#!/usr/bin/python3 -IB
"""Session-only idle policy; no shell evaluation or persistent system edits."""
from __future__ import annotations

import fcntl
import json
import os
from pathlib import Path
import re
import secrets
import shlex
import signal
import stat
import subprocess
import sys
import time
import uuid

CONFIG = Path('/etc/labwc/desktop.conf')
STATE = 'labwc-idle.json'
LOCK = 'labwc-idle.lock'
LOCK_SECONDS = 'LABWC_IDLE_LOCK_SECONDS'
DPMS_SECONDS = 'LABWC_IDLE_DPMS_SECONDS'
SUSPEND_SECONDS = 'LABWC_IDLE_SUSPEND_SECONDS'
ENABLED = 'LABWC_ENABLE_SWAYIDLE'
STATE_KEYS = {LOCK_SECONDS, DPMS_SECONDS, 'saved_lock', 'saved_dpms'}


class Error(Exception):
    pass


def validate_timeouts(lock: int, dpms: int, suspend: int = 0) -> None:
    if any(type(v) is not int or not 0 <= v <= 86400 for v in (lock, dpms, suspend)):
        raise Error('idle timeouts must be integers between 0 and 86400')
    if lock and dpms and dpms <= lock:
        raise Error('enabled DPMS timeout must exceed the lock timeout')
    if suspend and suspend <= max(lock, dpms):
        raise Error('suspend timeout must exceed each enabled lock/DPMS timeout')


def read_policy() -> dict:
    fd = os.open(CONFIG, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    with os.fdopen(fd, 'r', encoding='utf-8') as stream:
        meta = os.fstat(stream.fileno())
        if not stat.S_ISREG(meta.st_mode) or meta.st_uid != 0 or meta.st_mode & 0o022:
            raise Error('idle policy must be a root-owned, non-writable regular file')
        text = stream.read(65537)
    if len(text) > 65536:
        raise Error('idle policy is too large')
    values = {}
    for line in text.splitlines():
        name, sep, value = line.partition('=')
        if not sep or name not in {ENABLED, LOCK_SECONDS, DPMS_SECONDS, SUSPEND_SECONDS}:
            continue
        words = shlex.split(value, comments=False)
        if name in values or len(words) != 1:
            raise Error('duplicate or malformed idle setting: ' + name)
        values[name] = words[0]
    if set(values) != {ENABLED, LOCK_SECONDS, DPMS_SECONDS, SUSPEND_SECONDS}:
        raise Error('idle policy is incomplete')
    if values[ENABLED] not in {'true', 'yes', '1', 'on', 'false', 'no', '0', 'off'}:
        raise Error('invalid LABWC_ENABLE_SWAYIDLE')
    values[ENABLED] = values[ENABLED] in {'true', 'yes', '1', 'on'}
    for name in (LOCK_SECONDS, DPMS_SECONDS, SUSPEND_SECONDS):
        # Match the installer's decimal integer validation, including leading
        # zeroes, while keeping conversion bounded and independent of octal.
        number = values[name].lstrip('0') or '0'
        if not re.fullmatch(r'[0-9]+', values[name]) or len(number) > 5:
            raise Error('invalid idle setting: ' + name)
        values[name] = int(number, 10)
    validate_timeouts(values[LOCK_SECONDS], values[DPMS_SECONDS], values[SUSPEND_SECONDS])
    return values


def runtime_fd() -> int:
    uid = os.getuid()
    path = f'/run/user/{uid}'
    if uid == 0 or os.geteuid() != uid or os.environ.get('XDG_RUNTIME_DIR') != path:
        raise Error('a desktop user runtime directory is required')
    if os.environ.get('LABWC_SESSION_OWNER') != 'desktop' or os.environ.get('XDG_SESSION_TYPE') != 'wayland':
        raise Error('the managed Labwc Wayland session is required')
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        meta = os.fstat(fd)
        if meta.st_uid != uid or stat.S_IMODE(meta.st_mode) != 0o700:
            raise Error('runtime directory must be private and owned by this user')
        display = os.environ.get('WAYLAND_DISPLAY', '')
        if not re.fullmatch(r'[A-Za-z0-9_-]{1,128}', display):
            raise Error('invalid Wayland display')
        socket_meta = os.stat(display, dir_fd=fd, follow_symlinks=False)
        if not stat.S_ISSOCK(socket_meta.st_mode) or socket_meta.st_uid != uid:
            raise Error('the owned Wayland socket is unavailable')
        return fd
    except BaseException:
        os.close(fd)
        raise


def checked_file(directory: int, name: str, flags: int) -> int:
    fd = os.open(name, flags | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, 0o600, dir_fd=directory)
    meta = os.fstat(fd)
    if (not stat.S_ISREG(meta.st_mode) or meta.st_uid != os.getuid()
            or stat.S_IMODE(meta.st_mode) != 0o600 or meta.st_nlink != 1):
        os.close(fd)
        raise Error('unsafe idle runtime file: ' + name)
    return fd


def unique_object(pairs: list[tuple]) -> dict:
    values = dict(pairs)
    if len(values) != len(pairs):
        raise Error('duplicate idle state key')
    return values


def read_state(directory: int) -> dict | None:
    try:
        fd = checked_file(directory, STATE, os.O_RDONLY)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, 'r', encoding='utf-8') as stream:
        text = stream.read(4097)
    if len(text) > 4096:
        raise Error('idle runtime state is too large')
    state = json.loads(text, object_pairs_hook=unique_object)
    if not isinstance(state, dict) or set(state) != STATE_KEYS:
        raise Error('invalid idle runtime state')
    validate_timeouts(state[LOCK_SECONDS], state[DPMS_SECONDS])
    validate_timeouts(state['saved_lock'], state['saved_dpms'])
    return state


def write_state(directory: int, state: dict | None) -> None:
    if state is None:
        try:
            os.unlink(STATE, dir_fd=directory)
        except FileNotFoundError:
            pass
        return
    temporary = '.labwc-idle.' + secrets.token_hex(12)
    fd = checked_file(directory, temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
            json.dump(state, stream, sort_keys=True)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, STATE, src_dir_fd=directory, dst_dir_fd=directory)
    finally:
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass


def daemon_argv(policy: dict, state: dict | None) -> list[str]:
    lock = policy[LOCK_SECONDS] if state is None else state[LOCK_SECONDS]
    dpms = policy[DPMS_SECONDS] if state is None else state[DPMS_SECONDS]
    suspend = policy[SUSPEND_SECONDS]
    validate_timeouts(lock, dpms, suspend)
    # A user swayidle config would ADD events to these arguments. Use an empty
    # config explicitly so a disabled policy cannot retain hidden idle timers.
    argv = ['/usr/bin/swayidle', '-C', '/dev/null', '-w']
    if lock:
        argv += ['timeout', str(lock), '/usr/local/bin/labwc-lock']
    if dpms:
        argv += ['timeout', str(dpms), '/usr/local/libexec/labwc-output-watch --dpms-off',
                 'resume', '/usr/local/libexec/labwc-output-watch --dpms-on']
    # Pausing both timers also suppresses the idle suspend path, which locks.
    # Explicit sleep/logind locking stays available in the same live daemon.
    if suspend and (lock or dpms):
        argv += ['timeout', str(suspend), '/usr/local/bin/labwc-lock && /usr/bin/systemctl suspend']
    return argv + ['before-sleep', '/usr/local/bin/labwc-lock',
                   'after-resume', '/usr/local/libexec/labwc-output-watch --dpms-on',
                   'lock', '/usr/local/bin/labwc-lock']


def command(argv: list[str], timeout: int = 25) -> None:
    subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                   check=True, timeout=timeout, close_fds=True)


def notify(summary: str, body: str, critical: bool = False) -> None:
    command(['/usr/local/libexec/labwc-notification-send', '--app-name', 'Labwc Idle',
             '--category', 'desktop.idle', '--urgency', 'critical' if critical else 'normal',
             '--expire-time', '6000', summary, body], timeout=15)


def toggle(directory: int, policy: dict) -> None:
    if not policy[ENABLED]:
        raise Error('swayidle is disabled in the installed desktop policy')
    command(['/usr/bin/systemctl', '--user', '--quiet', 'is-active', 'labwc-session.target'])
    fd = checked_file(directory, LOCK, os.O_RDWR | os.O_CREAT)
    try:
        deadline = time.monotonic() + 10
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise Error('timed out waiting for another idle toggle')
                time.sleep(0.05)
        previous = read_state(directory)
        lock = policy[LOCK_SECONDS] if previous is None else previous[LOCK_SECONDS]
        dpms = policy[DPMS_SECONDS] if previous is None else previous[DPMS_SECONDS]
        if lock or dpms:
            state = {LOCK_SECONDS: 0, DPMS_SECONDS: 0, 'saved_lock': lock, 'saved_dpms': dpms}
            summary = 'Automatic lock and DPMS disabled'
            body = f'Saved delays: lock {lock}s, DPMS {dpms}s. Ctrl+Win+L restores them.'
        else:
            lock = 1844 if previous is None else previous['saved_lock']
            dpms = 3800 if previous is None else previous['saved_dpms']
            if not (lock or dpms):
                lock, dpms = 1844, 3800
            state = {LOCK_SECONDS: lock, DPMS_SECONDS: dpms, 'saved_lock': lock, 'saved_dpms': dpms}
            summary = 'Automatic lock and DPMS restored'
            body = f'Lock: {lock}s; DPMS: {dpms}s. Ctrl+Win+L pauses them.'
        daemon_argv(policy, state)  # Reject an invalid restored suspend order before mutation.
        try:
            write_state(directory, state)
            command(['/usr/bin/systemctl', '--user', 'reset-failed', 'swayidle.service'])
            command(['/usr/bin/systemctl', '--user', 'restart', 'swayidle.service'])
            command(['/usr/bin/systemctl', '--user', '--quiet', 'is-active', 'swayidle.service'])
            command(['/usr/local/libexec/labwc-output-watch', '--dpms-on'], timeout=35)
            notify(summary, body)
        except (Error, OSError, subprocess.SubprocessError) as exc:
            write_state(directory, previous)
            try:
                command(['/usr/bin/systemctl', '--user', 'reset-failed', 'swayidle.service'])
                command(['/usr/bin/systemctl', '--user', 'restart', 'swayidle.service'])
            except (OSError, subprocess.SubprocessError) as rollback:
                raise Error('idle toggle failed; saved state restored but swayidle recovery failed') from rollback
            raise Error('idle toggle failed; previous policy restored') from exc
    finally:
        os.close(fd)


def main(argv: list[str]) -> int:
    if argv not in ([], ['--run']):
        raise Error('usage: labwc-idle-toggle [--run]')
    if not argv:
        redirect_toggle()
    if not argv:
        def interrupted(signum, frame):
            raise Error('idle toggle interrupted')
        for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
            signal.signal(signum, interrupted)
    policy = read_policy()
    if argv == ['--run'] and not policy[ENABLED]:
        return 0
    directory = runtime_fd()
    try:
        if argv == ['--run']:
            command_argv = daemon_argv(policy, read_state(directory))
        else:
            toggle(directory, policy)
            return 0
    finally:
        os.close(directory)
    os.execv(command_argv[0], command_argv)
    return 1


def redirect_toggle() -> None:
    """Read root policy from the user manager's host namespace, not Labwc's."""
    directory = runtime_fd()
    try:
        bus = os.stat('bus', dir_fd=directory, follow_symlinks=False)
        if not stat.S_ISSOCK(bus.st_mode) or bus.st_uid != os.getuid():
            raise Error('the owned desktop session bus is unavailable')
    finally:
        os.close(directory)
    marker = os.environ.get('LABWC_IDLE_SESSION_UNIT', '')
    if marker not in {'', '1'}:
        raise Error('invalid idle user-service marker')
    with Path('/proc/self/cgroup').open(encoding='ascii') as stream:
        membership = stream.read(65537)
    if len(membership) > 65536:
        raise Error('oversized idle cgroup membership')
    in_service = any(re.fullmatch(
        r'0::/[^\n]*/labwc-idle-toggle-[0-9a-f]{32}[.]service', line,
    ) for line in membership.splitlines())
    if marker:
        if not in_service:
            raise Error('idle user-service marker is outside its managed cgroup')
        return
    runtime = f'/run/user/{os.getuid()}'
    environment = {
        'PATH': '/usr/local/bin:/usr/bin:/bin', 'XDG_RUNTIME_DIR': runtime,
        'DBUS_SESSION_BUS_ADDRESS': f'unix:path={runtime}/bus',
        'LABWC_SESSION_OWNER': 'desktop', 'XDG_SESSION_TYPE': 'wayland',
        'WAYLAND_DISPLAY': os.environ['WAYLAND_DISPLAY'],
    }
    command_argv = [
        '/usr/bin/systemd-run', '--user', '--quiet', '--wait', '--collect',
        '--service-type=exec', '--expand-environment=no', '--slice=app.slice',
        '--unit=labwc-idle-toggle-' + uuid.uuid4().hex + '.service',
        '--property=Requisite=labwc-session.target', '--property=After=labwc-session.target',
        '--property=PartOf=labwc-session.target', '--property=PrivateUsers=no',
        '--property=KillMode=control-group',
        '--property=TimeoutStopSec=10s', '--property=RuntimeMaxSec=180s',
        '--property=StandardInput=null', '--property=StandardOutput=journal',
        '--property=StandardError=journal', '--setenv=LABWC_IDLE_SESSION_UNIT=1',
        *('--setenv=' + name for name in sorted(environment)),
        '--', '/usr/local/bin/labwc-idle-toggle',
    ]
    # Lowercase AppArmor ux retains these validated bus variables. AT_SECURE
    # would remove them and reconnect to the wrong activation context.
    os.execve(command_argv[0], command_argv, environment)


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except (Error, OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f'labwc-idle-toggle: {exc}', file=sys.stderr)
        if sys.argv[1:] != ['--run']:
            try:
                notify('Idle toggle failed', str(exc), critical=True)
            except (OSError, subprocess.SubprocessError):
                pass
        sys.exit(1)
