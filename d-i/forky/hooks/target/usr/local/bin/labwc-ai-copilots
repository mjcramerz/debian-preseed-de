#!/bin/sh
set -eu

: "${HOME:?HOME must be set}"

TERMINAL_LAUNCHER=/usr/local/bin/labwc-ai-copilots
MAX_TEXT_INPUT_CHARS=16384

fatal() {
  printf 'fatal: %s\n' "$*" >&2
  exit 1
}

require_terminal_tty() {
  [ -r /dev/tty ] && [ -w /dev/tty ] ||
    fatal "AI & Copilots terminal input is unavailable"
}

choose_fzf_input() {
  prompt=$1
  header_lines=$2

  if terminal_selection=$(
    fzf \
      --height=100% \
      --layout=reverse \
      --border \
      --cycle \
      --no-multi \
      --no-sort \
      --header-lines="$header_lines" \
      --prompt="${prompt}> "
  ); then
    printf '%s\n' "$terminal_selection"
    return 0
  else
    selector_status=$?
  fi

  case "$selector_status" in
    1|130)
      return 0
      ;;
    *)
      fatal "unable to open the ${prompt} terminal selector (status ${selector_status})"
      ;;
  esac
}

choose_menu_input() {
  choose_fzf_input "$1" 0
}

choose_table_input() {
  choose_fzf_input "$1" "${2:-2}"
}

choose_catalog() {
  prompt=$1
  catalog_name=$2

  {
    catalog "$catalog_name"
    case "$catalog_name" in
      root) printf '%s\n' Exit ;;
      *) printf '%s\n' "← Back" ;;
    esac
  } |
    choose_menu_input "$prompt"
}

choose_text() {
  prompt=$1
  suggestion=$2

  require_terminal_tty
  printf '\n%s\n' "$prompt" >/dev/tty
  [ -z "$suggestion" ] ||
    printf 'Suggestion: %s\n' "$suggestion" >/dev/tty
  printf '> ' >/dev/tty
  if IFS= read -r text_value </dev/tty; then
    :
  else
    printf '\n' >/dev/tty
    return 0
  fi

  if [ "${#text_value}" -gt "$MAX_TEXT_INPUT_CHARS" ]; then
    printf 'Input exceeds the %s-character limit.\n' \
      "$MAX_TEXT_INPUT_CHARS" >/dev/tty
    return 0
  fi
  printf '%s\n' "$text_value"
}

show_message() {
  prompt=$1
  message=$2

  require_terminal_tty
  printf '\n%s\n%s\n\nPress Enter to continue...' \
    "$prompt" "$message" >/dev/tty
  IFS= read -r _message_ack </dev/tty || true
  printf '\n' >/dev/tty
}

run_action() {
  command -v labwc-ai-copilots-action >/dev/null 2>&1 ||
    fatal "labwc-ai-copilots-action is not installed"

  if labwc-ai-copilots-action --run "$@"; then
    return 0
  else
    action_status=$?
  fi

  printf 'warning: AI & Copilots action returned status %s: %s\n' \
    "$action_status" "$1" >&2
  return 0
}

choose_project() {
  {
    printf '%s\n' "$HOME"
    for project_root in "$HOME/Workspace" "$HOME/Projects" "$HOME/src"; do
      [ -d "$project_root" ] || continue
      find "$project_root" \
        -xdev -mindepth 1 -maxdepth 2 -type d \
        -not -path '*/.git/*' \
        -print 2>/dev/null
    done
  } |
    LC_ALL=C sort -u |
    sed -n '1,200p' |
    choose_menu_input "Codex project"
}

choose_installed_model() {
  model_family=$1
  model_prompt=$2
  empty_message=$3
  model_names=$(
    labwc-ai-copilots-action --list-model-names "$model_family" 2>/dev/null ||
      true
  )
  if [ -z "$model_names" ]; then
    show_message "$model_prompt" "$empty_message"
    return 0
  fi

  selected_name=$(
    printf '%s\n' "$model_names" |
      choose_menu_input "$model_prompt"
  )
  [ -n "$selected_name" ] || return 0
  selected_path=$(
    labwc-ai-copilots-action \
      --resolve-model-name \
      "$model_family" \
      "$selected_name" \
      2>/dev/null ||
      true
  )
  [ -n "$selected_path" ] || return 0
  printf '%s\n' "$selected_path"
}

choose_model() {
  choose_installed_model \
    llama \
    "Llama model" \
    "No validated GGUF models are installed"
}

choose_favorite_model() {
  choose_installed_model \
    llama-favorite \
    "Favorite model" \
    "No validated favorite GGUF models are recorded"
}

choose_whisper_model() {
  choose_installed_model \
    whisper \
    "Whisper model" \
    "No validated Whisper models are installed"
}

choose_audio_file() {
  {
    for audio_root in \
      "$HOME/Downloads" \
      "$HOME/Music" \
      "$HOME/Music/Whisper/audio"
    do
      [ -d "$audio_root" ] || continue
      find "$audio_root" \
        -xdev -mindepth 1 -maxdepth 3 -type f \
        \( \
          -iname '*.flac' -o -iname '*.m4a' -o -iname '*.mp3' -o \
          -iname '*.ogg' -o -iname '*.opus' -o -iname '*.wav' \
        \) \
        -size -2147483649c \
        -print 2>/dev/null
    done
  } |
    LC_ALL=C sort -u |
    sed -n '1,200p' |
    choose_menu_input "Audio file"
}

download_custom_llama_model() {
  model_url=$(choose_text "GGUF HTTPS URL" "Enter HTTPS model URL")
  [ -n "$model_url" ] || return 0
  model_filename=$(choose_text "GGUF file name" "model-name.Q4_K_M.gguf")
  [ -n "$model_filename" ] || return 0
  model_sha256=$(choose_text "Expected SHA-256" "Enter 64 lowercase hex characters")
  [ -n "$model_sha256" ] || return 0
  model_bytes=$(choose_text "Expected byte count" "1000000000")
  [ -n "$model_bytes" ] || return 0

  run_action \
    llama-download-model \
    "$model_url" \
    "$model_filename" \
    "$model_sha256" \
    "$model_bytes"
}

download_custom_whisper_model() {
  model_url=$(choose_text "Whisper model HTTPS URL" "Enter Hugging Face HTTPS model URL")
  [ -n "$model_url" ] || return 0
  model_filename=$(choose_text "Whisper model file name" "ggml-small.en-q8_0.bin")
  [ -n "$model_filename" ] || return 0
  model_sha256=$(choose_text "Expected SHA-256" "Enter 64 lowercase hex characters")
  [ -n "$model_sha256" ] || return 0
  model_bytes=$(choose_text "Expected byte count" "500000000")
  [ -n "$model_bytes" ] || return 0

  run_action \
    whisper-download-model \
    "$model_url" \
    "$model_filename" \
    "$model_sha256" \
    "$model_bytes"
}

choose_download_model() {
  model_family=$1
  model_prompt=$2
  catalog_rows=$(
    labwc-ai-copilots-action \
      --list-download-models \
      "$model_family" \
      2>/dev/null ||
      true
  )
  selected_row=$(
    table_header_lines=2
    [ -n "$catalog_rows" ] || table_header_lines=0
    {
      [ -z "$catalog_rows" ] || printf '%s\n' "$catalog_rows"
      printf '%s\n' "★ Custom Hugging Face URL…"
    } |
      choose_table_input "$model_prompt" "$table_header_lines"
  )
  [ -n "$selected_row" ] || return 0
  if [ "$selected_row" = "★ Custom Hugging Face URL…" ]; then
    printf '%s\n' '__custom_url__'
    return 0
  fi

  selected_id=$(
    labwc-ai-copilots-action \
      --resolve-download-model \
      "$model_family" \
      "$selected_row" \
      2>/dev/null ||
      true
  )
  [ -n "$selected_id" ] || return 0
  printf '%s\n' "$selected_id"
}

download_llama_model() {
  selected_model=$(choose_download_model llama "Download Llama model")
  case "$selected_model" in
    __custom_url__) download_custom_llama_model ;;
    '') return 0 ;;
    *) run_action llama-download-catalog-model "$selected_model" ;;
  esac
}

download_whisper_model() {
  selected_model=$(choose_download_model whisper "Download Whisper model")
  case "$selected_model" in
    __custom_url__) download_custom_whisper_model ;;
    '') return 0 ;;
    *) run_action whisper-download-catalog-model "$selected_model" ;;
  esac
}

run_model_info() {
  model_field=$1
  selected_model=$(choose_model)
  [ -n "$selected_model" ] || return 0
  run_action llama-model-info "$model_field" "$selected_model"
}

