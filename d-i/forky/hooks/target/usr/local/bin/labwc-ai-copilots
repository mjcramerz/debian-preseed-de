whisper_menu() {
  while :; do
    action=$(choose_catalog Whisper whisper-root)
    case "$action" in
      "★ Push-to-Talk") run_action whisper-control toggle ;;
      "★ Toggle Dictation") run_action whisper-dictation toggle ;;
      "★ Transcribe File…") whisper_transcribe_file ;;
      "★ Transcribe Last Recording") run_action whisper-transcribe-last ;;
      "★ Change Model…")
        model=$(choose_whisper_model)
        [ -n "$model" ] && run_action whisper-set-active-model "$model"
        ;;
      "★ Download New Model…") download_whisper_model ;;
      "★ Live Captions") run_action whisper-dictation toggle ;;
      "★ Voice Note") run_action whisper-control toggle ;;
      "⮞ Recording") whisper_recording_menu ;;
      "⮞ Transcription") whisper_transcription_menu ;;
      "⮞ Languages") whisper_languages_menu ;;
      "⮞ Output") whisper_output_menu ;;
      "⮞ Post-Processing") whisper_post_processing_menu ;;
      "⮞ Models") whisper_models_menu ;;
      "⮞ History") whisper_history_menu ;;
      "⮞ Audio Devices") whisper_audio_devices_menu ;;
      "⮞ Diagnostics") whisper_diagnostics_menu ;;
      "← Back"|'') return 0 ;;
    esac
  done
}

case "${1:-}" in
  --catalog)
    [ "$#" -eq 2 ] || fatal "usage: labwc-ai-copilots --catalog <name>"
    catalog "$2"
    exit 0
    ;;
  --terminal)
    [ "$#" -eq 1 ] ||
      fatal "usage: labwc-ai-copilots --terminal"
    ;;
  '')
    [ "$#" -eq 0 ] ||
      fatal "usage: labwc-ai-copilots [--terminal|--catalog <name>]"
    [ "$(id -u)" -ne 0 ] ||
      fatal "labwc-ai-copilots must run as the logged-in desktop user"
    command -v labwc-terminal >/dev/null 2>&1 ||
      fatal "labwc-terminal is not installed"
    exec labwc-terminal -e "$TERMINAL_LAUNCHER" --terminal
    ;;
  *)
    fatal "usage: labwc-ai-copilots [--terminal|--catalog <name>]"
    ;;
esac

command -v fzf >/dev/null 2>&1 ||
  fatal "fzf is not installed"
command -v labwc-ai-copilots-action >/dev/null 2>&1 ||
  fatal "labwc-ai-copilots-action is not installed"

[ "$(id -u)" -ne 0 ] ||
  fatal "labwc-ai-copilots must run as the logged-in desktop user"

while :; do
  category=$(choose_catalog "AI & Copilots" root)
  case "$category" in
    "⮞ Codex") codex_menu ;;
    "⮞ Llama") llama_menu ;;
    "⮞ Whisper") whisper_menu ;;
    Exit|'') exit 0 ;;
  esac
done
