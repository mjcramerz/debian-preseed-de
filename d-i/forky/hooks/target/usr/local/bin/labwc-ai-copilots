        [ -n "$value" ] && run_action llama-set-runtime context "$value"
        ;;
      "Set Thread Count…")
        value=$(choose_text "Llama thread count" "4")
        [ -n "$value" ] && run_action llama-set-runtime threads "$value"
        ;;
      "Set Batch Size…")
        value=$(choose_text "Llama batch size" "256")
        [ -n "$value" ] && run_action llama-set-runtime batch "$value"
        ;;
      "Set GPU Layers…")
        value=$(choose_text "Llama GPU layers" "0")
        [ -n "$value" ] && run_action llama-set-runtime gpu-layers "$value"
        ;;
      "Show Performance Settings") run_action llama-diagnostic performance ;;
      "← Back"|'') return 0 ;;
    esac
  done
}

