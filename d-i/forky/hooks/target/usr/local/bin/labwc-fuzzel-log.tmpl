#!/usr/bin/perl
use strict;
use warnings;

use Fcntl qw(F_GETFL F_SETFL O_NONBLOCK);
use Socket qw(AF_UNIX SOCK_DGRAM sockaddr_un);

sub usage {
    die "usage: labwc-fuzzel-log <menu|action> <event> [key=value ...]\n";
}

sub normalize_value {
    my ($value) = @_;
    defined($value) && !ref($value) or die "log value is invalid\n";

    $value =~ s/[\r\n]+/ /g;
    $value =~ s/[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]/?/g;
    $value =~ s/[[:space:]]+/_/g;
    $value =~ s/[^A-Za-z0-9._:+@\/&()=-]/?/g;
    return substr($value, 0, 160);
}

sub deliver {
    my ($path, $packet) = @_;
    socket(my $transport, AF_UNIX, SOCK_DGRAM, 0) or return;
    my $flags = fcntl($transport, F_GETFL, 0);
    defined($flags) or return;
    fcntl($transport, F_SETFL, $flags | O_NONBLOCK) or return;
    my $sent = send($transport, $packet, 0, sockaddr_un($path));
    return defined($sent) && $sent == length($packet);
}

@ARGV >= 2 && @ARGV <= 10 or usage();
my ($kind, $event, @fields) = @ARGV;
$kind =~ /\A(?:menu|action)\z/ or usage();
$event =~ /\A[a-z][a-z0-9-]{0,63}\z/ or usage();

my @normalized;
for my $field (@fields) {
    $field =~ /\A([a-z][a-z0-9-]{0,31})=(.*)\z/s
        or die "log field is invalid\n";
    push @normalized, "$1=" . normalize_value($2);
}

my $message = join q{ }, "event=$event", @normalized;
my $priority = $event =~ /failed/ ? 11 : 14; # LOG_USER with ERR or INFO.
my @months = qw(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec);
my @time = localtime();
my $packet = sprintf(
    '<%d>%s %2d %02d:%02d:%02d labwc-fuzzel-%s[%d]: %s',
    $priority, $months[$time[4]], $time[3], @time[2, 1, 0], $kind, $$, $message,
);
# Both transports are nonblocking: an unavailable collector must not delay a
# menu or action. Retain the existing journal fallback for collector outages.
deliver('__INSTALLER_LOG_APPS_SOCKET__', $packet) || deliver('/dev/log', $packet);

exit 0;
