#!/usr/bin/python3 -IB
"""Bounded Bluetooth status and action adapter for the managed desktop."""
from __future__ import annotations

import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import time

BLUETOOTHCTL = "/usr/bin/bluetoothctl"
NOTIFY_SEND = "/usr/bin/notify-send"
TERMINAL = "/usr/local/bin/labwc-terminal"
PICKER = "/usr/local/bin/labwc-fuzzel"
SCAN_SECONDS = 6
MAX_DEVICE_CHOICES = 128
DEVICE_ADDRESS = re.compile(r"^[0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){5}$")

ERROR_ICON = "__THEME_MAKO_BLUETOOTH_ERROR_ICON_NAME__"
UNAVAILABLE_GLYPH = "__THEME_WAYBAR_BUTTON_BLUETOOTH_UNAVAILABLE_ICON_GLYPH__"
CONNECTED_GLYPH = "__THEME_WAYBAR_BUTTON_BLUETOOTH_CONNECTED_ICON_GLYPH__"
ENABLED_GLYPH = "__THEME_WAYBAR_BUTTON_BLUETOOTH_ENABLED_ICON_GLYPH__"
DISABLED_GLYPH = "__THEME_WAYBAR_BUTTON_BLUETOOTH_DISABLED_ICON_GLYPH__"


class BluetoothError(RuntimeError):
    pass


def fatal(message: str, status: int = 1) -> int:
    print(f"fatal: {message}", file=sys.stderr)
    return status


def require_desktop() -> None:
    if os.environ.get("LABWC_SESSION_OWNER") != "desktop":
        raise BluetoothError("labwc-bluetooth must run in the managed desktop session")
    uid = os.getuid()
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", ""))
    if uid == 0 or runtime != Path("/run/user") / str(uid):
        raise BluetoothError("labwc-bluetooth requires a non-root desktop runtime directory")
    try:
        metadata = runtime.stat(follow_symlinks=False)
    except OSError as error:
        raise BluetoothError("labwc-bluetooth requires a usable desktop runtime directory") from error
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != uid
        or stat.S_IMODE(metadata.st_mode) != 0o700
        or metadata.st_nlink != 1
    ):
        raise BluetoothError("labwc-bluetooth runtime directory has unsafe metadata")


def run(
    argv: list[str], *, input_text: str | None = None, timeout: float = 10.0,
    capture: bool = False, terminal: bool = False,
) -> subprocess.CompletedProcess[str]:
    environment = dict(os.environ)
    environment.update(TERM="xterm-256color" if terminal else "dumb", NO_COLOR="1")
    return subprocess.run(
        argv,
        input=input_text,
        text=True,
        env=environment,
        stdin=subprocess.PIPE if input_text is not None else subprocess.DEVNULL,
        stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
        stderr=subprocess.PIPE if capture else subprocess.DEVNULL,
        timeout=timeout,
        check=False,
        close_fds=True,
    )


def notify(urgency: str, icon: str, category: str, summary: str, body: str) -> None:
    if not os.access(NOTIFY_SEND, os.X_OK) or not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        return
    try:
        run([NOTIFY_SEND, "-a", "Bluetooth", "-u", urgency, "-i", icon,
             "-c", category, summary, body], timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        pass


def picker(rows: list[str], prompt: str) -> str | None:
    environment = dict(os.environ, LABWC_MENU_ACTION_WAIT="1")
    result = subprocess.run(
        [PICKER, "menu", "--dmenu", "--prompt", prompt],
        input="".join(f"{row}\n" for row in rows),
        text=True,
        env=environment,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=120,
        check=False,
        close_fds=True,
    )
    if result.returncode == 1:
        return None
    if result.returncode == 3:
        raise SystemExit(3)
    if result.returncode != 0:
        raise BluetoothError(f"menu picker failed (status {result.returncode})")
    selected = result.stdout.rstrip("\n")
    return selected if selected in rows else None


def controller_status() -> str:
    try:
        result = run([BLUETOOTHCTL, "--timeout", "5"], input_text="show\nquit\n",
                     timeout=7, capture=True)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return result.stdout


def controller_command(command: str, value: str) -> bool:
    try:
        return run([BLUETOOTHCTL, "--timeout", "10", command, value], timeout=12).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def validate_address(address: str) -> str:
    if not DEVICE_ADDRESS.fullmatch(address):
        raise BluetoothError(f"invalid Bluetooth device address: {address}")
    return address.upper()


def device_command(command: str, address: str) -> bool:
    try:
        return run([BLUETOOTHCTL, "--timeout", "20", command, validate_address(address)], timeout=22).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def device_records(device_filter: str) -> list[str]:
    commands = {
        "all": ["devices"], "paired": ["devices", "Paired"],
        "trusted": ["devices", "Trusted"], "connected": ["devices", "Connected"],
    }
    if device_filter not in commands:
        raise BluetoothError(f"unsupported Bluetooth device filter: {device_filter}")
    try:
        result = run([BLUETOOTHCTL, "--timeout", "5", *commands[device_filter]],
                     timeout=7, capture=True)
    except (OSError, subprocess.TimeoutExpired):
        return []
    records: list[str] = []
    for line in result.stdout.splitlines():
        match = re.match(r"^Device\s+([^\s]+)(?:\s+(.*))?$", line)
        if not match:
            continue
        try:
            address = validate_address(match.group(1))
        except BluetoothError:
            continue
        label = "".join(char if char.isprintable() else " " for char in (match.group(2) or "")).strip()
        label = label[:120] if label else "Unnamed device"
        records.append(f"{address}  {label}")
        if len(records) >= MAX_DEVICE_CHOICES:
            break
    return records


def set_power(state: str) -> int:
    if state not in {"on", "off"}:
        raise BluetoothError(f"unsupported Bluetooth power state: {state}")
    if controller_command("power", state):
        summary = "Bluetooth turned on" if state == "on" else "Bluetooth turned off"
        body = "The Bluetooth controller is now powered on." if state == "on" else "The Bluetooth controller is now powered off."
        notify("normal", "bluetooth", "device.changed", summary, body)
        return 0
    notify("critical", ERROR_ICON, "device.error", "Bluetooth power change failed",
           f"The controller could not be powered {state}.")
    return 1


def controller_powered(status: str | None = None) -> bool:
    return bool(re.search(r"^\s*Powered:\s+yes$", status if status is not None else controller_status(), re.MULTILINE))


def ensure_powered() -> bool:
    return controller_powered() or set_power("on") == 0


def scan_devices() -> int:
    if not ensure_powered():
        return 1
    notify("normal", "bluetooth", "device.added", "Bluetooth scan started",
           f"Scanning for nearby devices for {SCAN_SECONDS} seconds.")
    process: subprocess.Popen[str] | None = None
    try:
        environment = dict(os.environ, TERM="dumb", NO_COLOR="1")
        process = subprocess.Popen(
            [BLUETOOTHCTL, "--timeout", str(SCAN_SECONDS + 5)],
            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            text=True, env=environment, close_fds=True,
        )
        if process.stdin is None:
            raise OSError("Bluetooth scan input is unavailable")
        process.stdin.write("scan on\n")
        process.stdin.flush()
        time.sleep(SCAN_SECONDS)
        process.stdin.write("scan off\nquit\n")
        process.stdin.close()
        process.wait(timeout=7)
        result = process
    except (OSError, subprocess.TimeoutExpired):
        if process is not None and process.poll() is None:
            process.kill()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                # Do not let a broken bluetoothctl child hold the menu open.
                process = None
        result = None
    if result is not None and result.returncode == 0:
        notify("normal", "bluetooth", "device.added", "Bluetooth scan completed",
               "Nearby devices are now available in the Bluetooth action menu.")
        return 0
    try:
        run([BLUETOOTHCTL, "--timeout", "5", "scan", "off"], timeout=7)
    except (OSError, subprocess.TimeoutExpired):
        pass
    notify("critical", ERROR_ICON, "device.error", "Bluetooth scan failed",
           "The nearby-device scan did not complete successfully.")
    return 1


def set_visibility(visibility: str) -> int:
    if visibility == "discoverable":
        if not ensure_powered() or not controller_command("pairable", "on") or not controller_command("discoverable", "on"):
            pass
        else:
            notify("normal", "bluetooth", "device.added", "Bluetooth is discoverable",
                   "Nearby devices can now find and pair with this computer.")
            return 0
    elif visibility == "hidden" and controller_command("discoverable", "off"):
        notify("normal", "bluetooth", "device.changed", "Bluetooth discovery disabled",
               "This computer is no longer advertising itself to nearby devices.")
        return 0
    elif visibility not in {"discoverable", "hidden"}:
        raise BluetoothError(f"unsupported Bluetooth visibility: {visibility}")
    notify("critical", ERROR_ICON, "device.error", "Bluetooth visibility change failed",
           "The controller visibility could not be updated.")
    return 1


def open_console(label: str) -> int:
    if not os.access(TERMINAL, os.X_OK):
        raise BluetoothError("labwc-terminal is not installed")
    notify("normal", "bluetooth", "device.added", f"Bluetooth {label} controls opened",
           "Use bluetoothctl in the interactive console to complete the selected action.")
    os.execv(TERMINAL, [TERMINAL, "-e", BLUETOOTHCTL, "--agent", "KeyboardDisplay"])
    return 0


def pair_in_terminal(address: str) -> int:
    address = validate_address(address)
    print(f"Pairing Bluetooth device {address}\n")
    try:
        paired = run([BLUETOOTHCTL, "--agent", "KeyboardDisplay", "--timeout", "90", "pair", address],
                     timeout=95, terminal=True).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        paired = False
    if not paired:
        notify("critical", ERROR_ICON, "device.error", "Bluetooth pairing failed",
               f"Pairing did not complete for {address}.")
        return 1
    trusted = device_command("trust", address)
    connected = device_command("connect", address)
    notify("normal", "bluetooth", "device.added", "Bluetooth device paired",
           f"Paired {address}. Trust: {'trusted' if trusted else 'failed'}. Connection: {'connected' if connected else 'failed'}.")
    time.sleep(2)
    return 0 if trusted and connected else 1


def show_info(address: str) -> int:
    address = validate_address(address)
    try:
        run([BLUETOOTHCTL, "--timeout", "15", "info", address], timeout=17, terminal=True)
    except (OSError, subprocess.TimeoutExpired):
        pass
    print("\nPress Enter to close this terminal.", end="", flush=True)
    try:
        sys.stdin.readline()
    except OSError:
        pass
    return 0


def status() -> int:
    if not Path("/run/dbus/system_bus_socket").is_socket():
        print(json.dumps({"text": UNAVAILABLE_GLYPH, "tooltip": "Bluetooth system D-Bus is unavailable", "class": "unavailable"}))
        return 0
    output = controller_status()
    if "Controller " not in output:
        print(json.dumps({"text": UNAVAILABLE_GLYPH, "tooltip": "No Bluetooth controller detected", "class": "unavailable"}))
    elif controller_powered(output):
        connected = bool(device_records("connected"))
        glyph = CONNECTED_GLYPH if connected else ENABLED_GLYPH
        tooltip = "Bluetooth is on with a connected device\nLeft-click: Bluetooth actions\nRight-click: power toggle" if connected else "Bluetooth is on\nLeft-click: Bluetooth actions\nRight-click: power toggle"
        print(json.dumps({"text": glyph, "tooltip": tooltip, "class": "connected" if connected else "enabled"}))
    else:
        print(json.dumps({"text": DISABLED_GLYPH, "tooltip": "Bluetooth is off\nLeft-click: Bluetooth actions\nRight-click: power toggle", "class": "disabled"}))
    return 0


def menu() -> int:
    labels = ["Open interactive console", "Scan for devices…", "Pair device", "Connect device", "Disconnect device", "Manage device", "Adapter settings"]
    selected = picker(labels, "Bluetooth")
    if selected is None:
        return 0
    action = dict(zip(labels, ("open", "scan", "pair-menu", "connect", "disconnect", "manage", "adapter")))[selected]
    return dispatch([action])


def dispatch(argv: list[str]) -> int:
    action = argv[0] if argv else "status"
    if action == "status":
        return status()
    if action in {"open", "console"}:
        return open_console("interactive")
    if action in {"pair-menu", "connect", "disconnect", "manage", "adapter"}:
        return open_console({"pair-menu": "pairing", "connect": "connect", "disconnect": "disconnect", "manage": "manage", "adapter": "adapter"}[action])
    if action == "menu":
        return menu()
    if action == "scan":
        return scan_devices()
    if action == "power-toggle":
        return set_power("off" if controller_powered() else "on")
    if action in {"pair", "info"}:
        if len(argv) != 2:
            raise BluetoothError(f"{action} requires one Bluetooth device address")
        return pair_in_terminal(argv[1]) if action == "pair" else show_info(argv[1])
    raise BluetoothError(f"unsupported labwc-bluetooth action: {action}")


def main(argv: list[str]) -> int:
    require_desktop()
    if not os.access(BLUETOOTHCTL, os.X_OK):
        raise BluetoothError("bluetoothctl is not installed")
    return dispatch(argv)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except (BluetoothError, OSError, subprocess.TimeoutExpired) as error:
        raise SystemExit(fatal(str(error)))
