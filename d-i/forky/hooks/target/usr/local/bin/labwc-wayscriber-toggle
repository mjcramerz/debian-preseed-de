#!/bin/sh
set -eu

fatal() {
  printf 'fatal: %s\n' "$*" >&2
  exit 1
}

[ "${LABWC_SESSION_OWNER:-}" = desktop ] ||
  fatal "Wayscriber toggle requires the managed Labwc desktop session"
[ "${XDG_SESSION_TYPE:-}" = wayland ] ||
  fatal "Wayscriber toggle requires a Wayland session"

runtime_root=${XDG_RUNTIME_DIR:-}
case "$runtime_root" in
  /|*..*|*//*|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._/-]*)
    fatal "XDG_RUNTIME_DIR is unavailable or invalid"
    ;;
  /*) ;;
  *) fatal "XDG_RUNTIME_DIR is unavailable or invalid" ;;
esac
runtime_uid=${runtime_root#/run/user/}
case "$runtime_uid" in
  ''|0*|*[!0-9]*) fatal "XDG_RUNTIME_DIR is not a private desktop runtime directory" ;;
esac
[ "$(/usr/bin/stat -Lc '%u %a' -- "$runtime_root" 2>/dev/null || true)" = "$runtime_uid 700" ] ||
  fatal "XDG_RUNTIME_DIR has unsafe ownership or mode"
wayland_display=${WAYLAND_DISPLAY:-}
case "$wayland_display" in
  ''|*/*|*..*|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*) fatal "WAYLAND_DISPLAY is unavailable or invalid" ;;
esac
wayland_socket="$runtime_root/$wayland_display"
socket_metadata=$(/usr/bin/stat -Lc '%F %u %a %h' -- "$wayland_socket" 2>/dev/null || true)
case "$socket_metadata" in
  "socket $runtime_uid 600 1"|"socket $runtime_uid 660 1"|"socket $runtime_uid 700 1") ;;
  *) fatal "the active Wayland socket has unsafe ownership or mode" ;;
esac
[ -S "$wayland_socket" ] ||
  fatal "the active Wayland socket is unavailable"
[ -x /usr/bin/wayscriber ] ||
  fatal "the Wayscriber package executable is unavailable"

bounded() {
  /usr/bin/timeout --signal=TERM --kill-after=2s 5s "$@"
}

service=wayscriber.service
if ! bounded /usr/bin/systemctl --user --quiet is-active "$service"; then
  bounded /usr/bin/systemctl --user reset-failed "$service" >/dev/null 2>&1 || true
  bounded /usr/bin/systemctl --user start "$service" ||
    fatal "unable to start the Wayscriber daemon"
fi

attempt=1
while [ "$attempt" -le 20 ]; do
  if bounded /usr/bin/systemctl --user --quiet is-active "$service" &&
     bounded /usr/bin/wayscriber --daemon-toggle; then
    exit 0
  fi

  if ! bounded /usr/bin/systemctl --user --quiet is-active "$service"; then
    bounded /usr/bin/systemctl --user reset-failed "$service" >/dev/null 2>&1 || true
    bounded /usr/bin/systemctl --user start "$service" >/dev/null 2>&1 || true
  fi
  /usr/bin/sleep 0.1
  attempt=$((attempt + 1))
done

fatal "Wayscriber daemon did not accept the toggle request"
