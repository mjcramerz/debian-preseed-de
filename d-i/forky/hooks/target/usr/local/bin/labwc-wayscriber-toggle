#!/usr/bin/python3 -IB
"""Send one bounded toggle request to the session-owned Wayscriber daemon.

The daemon remains owned by the user systemd service. This entry point only
validates the caller and Wayland runtime, waits for the daemon's readiness
record, and sends one request. An uncertain native result is never retried:
the daemon may have accepted the toggle even when its reply was lost.
"""
from __future__ import annotations

import errno
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import time

SYSTEMCTL = "/usr/bin/systemctl"
WAYSCRIBER = "/usr/bin/wayscriber"
RUNTIME_BASE = Path("/run/user")
SERVICE = "wayscriber.service"
START_TIMEOUT = 5.0
READY_TIMEOUT = 5.0
REQUEST_RESPONSE_WINDOW = 8.0
CLEANUP_TIMEOUT = 2.0
REQUEST_TIMEOUT = REQUEST_RESPONSE_WINDOW + CLEANUP_TIMEOUT
WAYLAND_NAME = re.compile(r"^[A-Za-z0-9_.-]+$")


def fail(message: str, status: int = 1) -> int:
    print(f"fatal: {message}", file=sys.stderr)
    return status


def terminate_process(process: subprocess.Popen[bytes]) -> None:
    """Stop one child process group within the separate cleanup budget."""
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + CLEANUP_TIMEOUT
    try:
        process.wait(timeout=CLEANUP_TIMEOUT)
        return
    except subprocess.TimeoutExpired:
        pass
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        return
    remaining = max(0.0, deadline - time.monotonic())
    if remaining:
        try:
            process.wait(timeout=remaining)
        except subprocess.TimeoutExpired:
            pass


def run_bounded(argv: list[str], timeout: float) -> int:
    process = subprocess.Popen(
        argv,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )
    try:
        process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        terminate_process(process)
        return 124
    return int(process.returncode or 0)


def runtime_identity(uid: int, runtime: Path) -> bool:
    if runtime != RUNTIME_BASE / str(uid) or runtime.is_symlink():
        return False
    try:
        metadata = runtime.stat(follow_symlinks=False)
    except OSError:
        return False
    return (
        stat.S_ISDIR(metadata.st_mode)
        and metadata.st_uid == uid
        and stat.S_IMODE(metadata.st_mode) == 0o700
        and metadata.st_nlink == 1
    )


def socket_identity(path: Path, uid: int) -> bool:
    try:
        metadata = path.lstat()
    except OSError:
        return False
    return (
        stat.S_ISSOCK(metadata.st_mode)
        and metadata.st_uid == uid
        and metadata.st_nlink == 1
    )


def readiness_published(path: Path, uid: int) -> bool:
    try:
        metadata = path.lstat()
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != uid
            or metadata.st_nlink != 1
            or metadata.st_size <= 0
            or metadata.st_size > 128
        ):
            return False
        with path.open("rb") as stream:
            return bool(stream.read(129))
    except (OSError, UnicodeError):
        return False


def wait_for_readiness(path: Path, uid: int) -> bool:
    deadline = time.monotonic() + READY_TIMEOUT
    while time.monotonic() < deadline:
        if readiness_published(path, uid):
            return True
        time.sleep(0.1)
    return readiness_published(path, uid)


def main(argv: list[str]) -> int:
    if os.environ.get("LABWC_SESSION_OWNER") != "desktop":
        return fail("Wayscriber toggle requires the managed Labwc desktop session")
    if os.environ.get("XDG_SESSION_TYPE") != "wayland":
        return fail("Wayscriber toggle requires a Wayland session")
    if argv:
        return fail("usage: labwc-wayscriber-toggle")

    uid = os.getuid()
    if uid == 0:
        return fail("Wayscriber must run as the desktop user")
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", ""))
    if runtime != RUNTIME_BASE / str(uid) or not runtime_identity(uid, runtime):
        return fail("XDG_RUNTIME_DIR has unsafe ownership or mode")

    display = os.environ.get("WAYLAND_DISPLAY", "")
    if not display or not WAYLAND_NAME.fullmatch(display):
        return fail("WAYLAND_DISPLAY is unavailable or invalid")
    if not socket_identity(runtime / display, uid):
        return fail("the active Wayland socket has unsafe identity")
    if not os.access(WAYSCRIBER, os.X_OK):
        return fail("the Wayscriber package executable is unavailable")

    try:
        if run_bounded([SYSTEMCTL, "--user", "start", SERVICE], START_TIMEOUT) != 0:
            return fail("unable to start the Wayscriber daemon")
    except OSError:
        return fail("unable to start the Wayscriber daemon")

    readiness = runtime / "wayscriber" / "wayscriber.pid"
    if not wait_for_readiness(readiness, uid):
        return fail("Wayscriber control readiness was not published before the deadline")

    try:
        result = run_bounded([WAYSCRIBER, "--daemon-toggle"], REQUEST_TIMEOUT)
    except OSError:
        result = 127
    if result == 0:
        return 0
    print(
        "outcome-unknown: Wayscriber toggle completion was not confirmed; no retry was sent",
        file=sys.stderr,
    )
    return 75


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
    except OSError as error:
        if error.errno in (errno.EACCES, errno.EPERM):
            print("fatal: Wayscriber runtime access was denied", file=sys.stderr)
            raise SystemExit(1)
        print("fatal: Wayscriber runtime is unavailable", file=sys.stderr)
        raise SystemExit(1)
