#!/bin/sh
set -eu

pending_file=/usr/local/lib/crypto/tpm2-enroll.pending
[ -r "$pending_file" ] || exit 0
pending_user=$(cat "$pending_file")
[ -n "$pending_user" ] || exit 0
[ "$(id -un)" = "$pending_user" ] || exit 0
[ -x /usr/local/sbin/tpm2-enroll.sh ] || exit 0
command -v labwc-terminal >/dev/null 2>&1 || exit 0
command -v sudo >/dev/null 2>&1 || exit 0

exec labwc-terminal -e sudo /usr/local/sbin/tpm2-enroll.sh
