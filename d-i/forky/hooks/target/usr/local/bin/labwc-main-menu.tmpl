def category_for(categories: str | None) -> str:
    tokens = set((categories or '').split(';'))
    label, main, specific = CATEGORY_RULES[0]
    if tokens & (main | specific):
        return label
    for token_set_index in (2, 1):
        for rule in CATEGORY_RULES[1:]:
            if tokens & rule[token_set_index]:
                return rule[0]
    return 'Other'


def prepare_environment() -> None:
    # Never let an injected GI/module path substitute launcher implementation.
    # -I separately disables Python's environment/site-current-directory imports.
    for key in ('GIO_LAUNCH_DESKTOP', 'GIO_EXTRA_MODULES', 'GIO_MODULE_DIR', 'GI_TYPELIB_PATH'):
        os.environ.pop(key, None)
    # Relative XDG paths are invalid; GLib must not search the current directory.
    home = os.environ.get('XDG_DATA_HOME', '')
    if not home or not os.path.isabs(home):
        account_home = Path.home()
        if not account_home.is_absolute():
            account_home = Path(pwd.getpwuid(os.getuid()).pw_dir)
        os.environ['XDG_DATA_HOME'] = str(account_home / '.local/share')
    roots = os.environ.get('XDG_DATA_DIRS', '')
    if not roots:
        roots = '/usr/local/share:/usr/share'
    absolute = [part for part in roots.split(':') if os.path.isabs(part)]
    # An explicitly invalid list must not turn into an empty GLib value, which
    # would re-enable its defaults. This fixed non-directory searches nothing.
    os.environ['XDG_DATA_DIRS'] = ':'.join(dict.fromkeys(absolute)) or '/dev/null'
    os.environ.setdefault('XDG_CURRENT_DESKTOP', 'labwc:wlroots')


def tomat_overlay_active() -> bool:
    runtime_name = os.environ.get('XDG_RUNTIME_DIR', '')
    if not re.fullmatch(r'/run/user/[0-9]+', runtime_name):
        return False
    runtime = Path(runtime_name)
    try:
        runtime_info = runtime.lstat()
        if (not stat.S_ISDIR(runtime_info.st_mode) or runtime_info.st_uid != os.getuid()
                or stat.S_IMODE(runtime_info.st_mode) != 0o700):
            return False
        directory = runtime / 'labwc-tomat'
        directory_info = directory.lstat()
        if (not stat.S_ISDIR(directory_info.st_mode) or directory_info.st_uid != os.getuid()
                or stat.S_IMODE(directory_info.st_mode) != 0o700):
            return False
        marker = directory / TOMAT_OVERLAY_MARKER_NAME
        descriptor = os.open(marker, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        with os.fdopen(descriptor, 'rb') as stream:
            info = os.fstat(stream.fileno())
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                    or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600):
                return False
            value = stream.read(64)
        return bool(re.fullmatch(rb'[0-9a-f]{12}\n', value))
    except (FileNotFoundError, OSError, UnicodeError):
        return False


def gio_api():
    prepare_environment()
    try:
        locale.setlocale(locale.LC_ALL, '')
    except locale.Error:
        locale.setlocale(locale.LC_ALL, 'C.UTF-8')
    import gi
    gi.require_version('Gio', '2.0')
    gi.require_version('GioUnix', '2.0')
    from gi.repository import Gio, GioUnix
    return Gio, GioUnix.DesktopAppInfo


def visible(app) -> bool:
    # get_all/new have already applied desktop ID precedence, including Hidden
    # tombstones and unavailable TryExec. Never retry a lower-precedence file.
    return bool(app and app.get_string('Type') == 'Application'
                and not app.get_is_hidden() and app.should_show())


# Curated desktop identities override conflicting vendor categories (for
# example RetroArch's Emulator secondary category is not a System app here).
CATEGORY_OVERRIDES = {
    'qoredb.desktop': 'Development',
    'QoreDB.desktop': 'Development',
    'com.qoredb.qoredb.desktop': 'Development',
    'qalculate-qt.desktop': 'Office & Productivity',
    'qalculate-gtk.desktop': 'Office & Productivity',
    'retroarch.desktop': 'Games',
    'org.libretro.RetroArch.desktop': 'Games',
    'com.libretro.RetroArch.desktop': 'Games',
}
# The fixed Desktop Settings action already represents this executable.
# Filter desktop IDs, never arbitrary localized display names.
TWEAKS_DESKTOP_IDS = frozenset({'labwc-tweaks.desktop', 'labwc-tweaks-gtk.desktop'})


def read_desktop_text(source: Path, limit: int = MAX_DESKTOP_BYTES) -> str:
    with source.open(encoding='utf-8') as stream:
        text = stream.read(limit + 1)
    if len(text.encode('utf-8')) > limit:
        raise ValueError('desktop entry exceeds the size limit')
    return text


def desktop_keyfile(text: str):
    from gi.repository import GLib
    keyfile = GLib.KeyFile()
    try:
        keyfile.load_from_data(text, len(text.encode('utf-8')), GLib.KeyFileFlags.KEEP_TRANSLATIONS)
    except GLib.Error as exc:
        raise ValueError(f'invalid desktop entry: {exc}') from exc
    return keyfile


def action_is_launchable(keyfile, action_id: str) -> bool:
    from gi.repository import GLib
    group = 'Desktop Action ' + action_id
    try:
        if group not in keyfile.get_groups()[0]:
            return False
        keys = keyfile.get_keys(group)[0]
        return all(key in keys and bool((keyfile.get_string(group, key) or '').strip()) for key in ('Name', 'Exec'))
    except GLib.Error:
        return False


def enumerate_apps() -> list[dict[str, str]]:
    Gio, DesktopAppInfo = gio_api()
    apps = {}
    for app in Gio.AppInfo.get_all():
        if not isinstance(app, DesktopAppInfo) or not visible(app):
            continue
        desktop_id = app.get_id()
        if desktop_id and desktop_id not in TWEAKS_DESKTOP_IDS:
            entry = {'id': desktop_id, 'action': '',
                     'name': app.get_display_name() or desktop_id,
                     'category': CATEGORY_OVERRIDES.get(desktop_id, category_for(app.get_categories())),
                     'icon': safe_icon(app.get_string('Icon')),
                     'executable': app.get_executable() or '',
                     'filename': app.get_filename() or ''}
            action_ids = list(dict.fromkeys(app.list_actions()))
            # The existing catalog bound covers default launches and actions.
            if len(apps) + 1 + len(action_ids) > MAX_APPS:
                raise ValueError('application catalog exceeds the managed bounds')
            if action_ids:
                keyfile = desktop_keyfile(read_desktop_text(Path(entry['filename'])))
                action_ids = [action_id for action_id in action_ids if action_is_launchable(keyfile, action_id)]
            for action_id in ('', *action_ids):
                choice = dict(entry, action=action_id)
                if action_id:
                    action_name = app.get_action_name(action_id) or action_id
                    choice['name'] += ' — ' + action_name
                if any(len(value.encode('utf-8')) > 4096 for value in choice.values()):
                    raise ValueError('application catalog exceeds the managed bounds')
                apps[desktop_id, action_id] = choice
    return sorted(apps.values(), key=lambda app: (app['name'].casefold(), app['id'], app['action']))


def desktop_policy() -> dict:
    owner = Path('/usr').stat().st_uid
    hook = Path('/usr/local/libexec/labwc-wrap-desktop-files')
    for path in (hook, *hook.parents):
        meta = path.lstat()
        expected = stat.S_ISREG if path == hook else stat.S_ISDIR
        if not expected(meta.st_mode) or meta.st_uid != owner or meta.st_mode & 0o022:
            raise RuntimeError('unsafe desktop policy helper')
    return runpy.run_path(str(hook))


def launch_debug_session(desktop_id: str, mode: str, executable: str) -> None:
    """Start the filtered terminal and bounded collector for one app launch."""
    if mode not in DEBUG_MODES:
        raise ValueError('unsupported application debug mode')
    if mode == 'xwayland' and not any(executable in paths for paths in XWAYLAND_EXECUTABLES.values()):
        raise RuntimeError('Xwayland diagnostics are restricted to the managed Zoom and Discord entries')
    session = secrets.token_hex(12)
    # Correlation reaches the outer private compatibility output supervisor;
    # its Cage/Xwayland environment remains owned by the existing runtime.
    for name in DEBUG_CONTEXT_NAMES:
        os.environ.pop(name, None)
    os.environ.update({
        'LABWC_DEBUG_PROFILE': mode,
        'LABWC_DEBUG_SESSION': session,
        'LABWC_DEBUG_DESKTOP_ID': desktop_id,
        'LABWC_DEBUG_EXECUTABLE': executable,
    })
    # Prepare the request and baseline before the selected Exec is launched.
    subprocess.run([
        '/usr/local/libexec/labwc-debug-session', 'start', session, mode, desktop_id, executable,
    ], stdin=subprocess.DEVNULL, close_fds=True, timeout=10, check=True)
    print(f'desktop debug session mode={mode} application={desktop_id} correlation=labwc-debug-{session}',
          flush=True)


def launch_desktop(desktop_id: str, action_id: str | None = None,
                   debug_mode: str | None = None) -> None:
    Gio, DesktopAppInfo = gio_api()
    app = DesktopAppInfo.new(desktop_id)
    if action_id is not None and (not visible(app) or action_id not in app.list_actions()):
        raise RuntimeError(f'desktop action is no longer available: {desktop_id!r}: {action_id!r}')
    if visible(app):
        # Normalize the effective entry, not a lower-priority vendor copy.
        # Reuse the dpkg hook's exact wrapper/terminal/compatibility policy;
        # GIO still owns argument, URI and field-code expansion.
        try:
            source = Path(app.get_filename())
            owner = Path('/usr').stat().st_uid
            policy = desktop_policy()
            defaults = policy['load_defaults'](owner_uid=owner)
            prefix = policy['launch_prefix'](source, app.get_executable() or '',
                                              app.get_string('Exec') or '', defaults)
            text = read_desktop_text(source, policy['MAX_BYTES'])
            text = policy['rewrite_desktop'](text, prefix)
            keyfile = desktop_keyfile(text)
            # An in-memory DesktopAppInfo has no filename for %k. Preserve its
            # original identity; leave %% and every other field code to GIO.
            quoted_source = '"' + ''.join('\\' + c if c in '\\"`$' else
                                          '%%' if c == '%' else c for c in str(source)) + '"'
            for group in keyfile.get_groups()[0]:
                if group == 'Desktop Entry' or group.startswith('Desktop Action '):
                    if 'Exec' in keyfile.get_keys(group)[0]:
                        value = keyfile.get_string(group, 'Exec')
                        value = re.sub(r'%%|%k', lambda m: '%%' if m[0] == '%%' else quoted_source, value)
                        keyfile.set_string(group, 'Exec', value)
            if debug_mode is not None:
                # D-Bus activation delegates to an existing service which does
                # not inherit this per-launch environment. Use the normalized
                # managed Exec for diagnostic launches only.
                keyfile.set_boolean('Desktop Entry', 'DBusActivatable', False)
            normalized = DesktopAppInfo.new_from_keyfile(keyfile)
            if normalized is None:
                raise RuntimeError('normalized desktop entry is invalid')
            if debug_mode is not None:
                selected_group = 'Desktop Action ' + action_id if action_id else 'Desktop Entry'
                selected_exec = keyfile.get_string(selected_group, 'Exec')
                words = shlex.split(selected_exec)
                executable_label = words[0] if words else (app.get_executable() or '')
                compatibility = policy['compatibility_exec'](selected_exec)
                if compatibility is not None:
                    executable_label = shlex.split(compatibility)[0]
                    if debug_mode != 'xwayland':
                        raise RuntimeError('Zoom/Discord use the private Xwayland diagnostic entry')
                launch_debug_session(desktop_id, debug_mode, executable_label)
            if action_id is None:
                normalized.launch([], Gio.AppLaunchContext())
            else:
                # Recheck after normalization; never fall back to the default
                # launch when a selected action was removed or became invalid.
                if (not visible(normalized) or action_id not in normalized.list_actions()
                        or not action_is_launchable(keyfile, action_id)):
                    raise RuntimeError(f'desktop action is unavailable: {action_id!r}')
                normalized.launch_action(action_id, Gio.AppLaunchContext())
        except Exception as exc:
            raise RuntimeError(f'cannot launch {desktop_id!r}: {exc}') from exc


def display_text(text: str) -> str:
    # Fuzzel dmenu is line-oriented; controls must not create extra menu entries.
    # Escape backslashes too, making these substitutions unambiguous. Preserve
    # spaces, punctuation, Unicode/emoji and ordinary XML/shell metacharacters.
    result = []
    for char in text:
        if char == '\\':
            result.append('\\\\')
        elif unicodedata.category(char) in {'Cc', 'Cs'} or char in '\u2028\u2029\u202a\u202b\u202c\u202d\u202e\u2066\u2067\u2068\u2069':
            result.append(f'\\u{ord(char):04x}')
        else:
            result.append(char)
    return ''.join(result)


def app_choices(apps: list[dict[str, str]], category: str | None) -> dict[str, tuple[str, str]]:
    selected = sorted((app for app in apps if category is None or app['category'] == category),
                      key=lambda app: (app['name'].casefold(), app['id'], app.get('action', '')))
    counts = Counter(display_text(app['name']) for app in selected)
    choices = {}
    for app in selected:
        label = display_text(app['name'])
        if counts[label] > 1 or label == BACK:
            label += ' [' + display_text(app['id']) + ']'
        base, number = label, 2
        while label in choices or label == BACK:
            label = f'{base} ({number})'
            number += 1
        choices[label] = (app['id'], app.get('action', ''))
    return choices


