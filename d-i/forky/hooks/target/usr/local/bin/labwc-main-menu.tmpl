def safe_icon(value: str | None) -> str:
    # Native dmenu metadata is NUL + "icon" + US + value. Never let a desktop
    # entry inject another row/metadata field. Icon names and absolute paths
    # (including spaces and Unicode) remain data for Fuzzel's own resolver.
    if not value or len(value) > 4096 or any(
            unicodedata.category(c) in {'Cc', 'Cs'} or c in '\u2028\u2029'
            for c in value):
        return DEFAULT_ICON
    if '/' in value and not os.path.isabs(value):
        return DEFAULT_ICON
    return value


def choose(choices: dict, prompt: str, icons: dict[str, str] | None = None) -> str | None:
    if any(not isinstance(label, str) or any(unicodedata.category(c) in {'Cc', 'Cs'}
           or c in '\u2028\u2029' for c in label) for label in choices):
        raise ValueError('menu labels must not contain protocol controls')
    env = dict(os.environ, LABWC_FUZZEL_MANAGED_ICONS='0')
    # The shell wrapper passes this already-encoded protocol through untouched.
    # Fuzzel returns the label without metadata. The dispatch mapping is still
    # closed: user-provided names/icons never become commands or shell code.
    supplied = icons if icons is not None else (
        MENU_ICONS if prompt in ('Main Menu', 'Desktop Settings') else {})
    rows = ''.join(label + '\0icon\x1f' + safe_icon(supplied.get(label, MENU_ICONS.get(BACK)
                   if label == BACK else DEFAULT_ICON)) + '\n' for label in choices)
    if len(choices) > MAX_APPS + 1 or len(rows.encode('utf-8')) > MAX_MENU_BYTES:
        raise ValueError('application picker input exceeds the managed bounds')
    result = subprocess.run([FUZZEL, 'menu', '--dmenu', '--prompt', prompt + ': '],
                            input=rows, text=True, encoding='utf-8', stdout=subprocess.PIPE, env=env, check=False)
    if result.returncode == 3:
        raise SystemExit(3)  # Dismiss the complete menu workflow.
    if result.returncode == 1:
        return None  # Win+Backspace: return to the parent menu.
    if result.returncode != 0:
        raise RuntimeError(f'Fuzzel failed (status {result.returncode})')
    selected = result.stdout.removesuffix('\n')
    return selected if selected in choices else None


def run_action(argv: tuple[str, ...]) -> None:
    result = subprocess.run(argv, check=False)
    if result.returncode == 3:
        raise SystemExit(3)
    if result.returncode:
        raise subprocess.CalledProcessError(result.returncode, argv)


def launcher_marker(active: bool) -> None:
    """Publish a private lifecycle marker for Waybar's event-driven state."""
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', ''))
    if not runtime.is_absolute():
        return
    try:
        runtime_info = runtime.lstat()
        if (not stat.S_ISDIR(runtime_info.st_mode) or runtime_info.st_uid != os.getuid()
                or stat.S_IMODE(runtime_info.st_mode) != 0o700):
            return
        marker = runtime / MENU_MARKER_NAME
        if active:
            descriptor = os.open(marker, os.O_WRONLY | os.O_CREAT
                                 | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
            with os.fdopen(descriptor, 'wb') as stream:
                info = os.fstat(stream.fileno())
                if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                        or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600):
                    return
                stream.truncate(0)
                stream.write((str(os.getpid()) + '\n').encode('ascii'))
                stream.flush()
        else:
            descriptor = os.open(marker, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
            with os.fdopen(descriptor, 'rb') as stream:
                info = os.fstat(stream.fileno())
                if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                        or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600):
                    return
                value = stream.read(32)
            if value == (str(os.getpid()) + '\n').encode('ascii'):
                marker.unlink()
    except (FileNotFoundError, OSError, ValueError):
        return


def signal_launcher_state(active: bool) -> None:
    """Refresh the launcher module after publishing its lifecycle marker."""
    launcher_marker(active)
    subprocess.run(
        ['/usr/bin/systemctl', '--user', '--quiet', 'kill', '--kill-whom=main',
         '--signal=RTMIN+8', 'waybar.service'],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, check=False, timeout=5,
    )


def run_menu(initial: str | None = None, debug_mode: str | None = None) -> None:
    try:
        signal_launcher_state(True)
        _run_menu(initial, debug_mode)
    finally:
        signal_launcher_state(False)


def _run_menu(initial: str | None = None, debug_mode: str | None = None) -> None:
    top = dict.fromkeys(('Search Applications', *DISPLAY_CATEGORIES, 'Terminal',
                         'Files', 'Computer Management', 'Desktop Settings', 'Lock', 'Logout', 'Power'))
    while True:
        selected = initial if initial is not None else choose(top, 'Main Menu')
        initial = None
        if selected is None:
            return
        if selected in ACTIONS and selected != 'Search Applications':
            run_action(ACTIONS[selected])
            if selected in ('Computer Management', 'Power'):
                continue
            return
        if selected == 'Desktop Settings':
            choices = dict(SETTINGS_ACTIONS)
            icons = MENU_ICONS
        else:
            # Fresh process, same user and XDG/session/output environment.
            result = subprocess.run([SELF, '--list'], check=True, text=True,
                                    stdout=subprocess.PIPE, timeout=10)
            apps = json.loads(result.stdout)
            if debug_mode is not None:
                compat_executables = {'zoom', 'discord', 'Discord'} | set().union(*XWAYLAND_EXECUTABLES.values())
                if debug_mode == 'xwayland':
                    # Only the two existing compatibility entrypoints belong
                    # in this picker. Selected Exec is checked again at launch.
                    apps = [app for app in apps if app.get('executable') in compat_executables
                            and not app.get('action')]
                else:
                    apps = [app for app in apps if app.get('executable') not in compat_executables]
            choices = app_choices(apps, None if selected == 'Search Applications' else selected)
            by_id = {app['id']: safe_icon(app.get('icon')) for app in apps}
            icons = {label: by_id[desktop_id] for label, (desktop_id, _action_id) in choices.items()}
        choices[BACK] = None
        item = choose(choices, DEBUG_MODES[debug_mode] if debug_mode else selected, icons)
        if item is None or item == BACK:
            continue
        if selected == 'Desktop Settings':
            run_action(choices[item])
        else:
            desktop_id, action_id = choices[item]
            command = [SELF, '--launch=' + desktop_id]
            if action_id:
                command.append('--action=' + action_id)
            if debug_mode is not None:
                command.append('--debug=' + debug_mode)
            subprocess.run(command, check=True)
        return


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group()
    group.add_argument('--list', action='store_true', help='list visible apps as JSON (diagnostic)')
    group.add_argument('--launch', metavar='DESKTOP_ID', help='launch an effective visible desktop ID')
    group.add_argument('--search', action='store_true', help='search all applications with navigation back to the main menu')
    parser.add_argument('--action', metavar='ACTION_ID', help='launch an advertised action of the selected desktop ID')
    parser.add_argument('--debug', choices=tuple(DEBUG_MODES), help='launch the selected application with a complete managed diagnostic bundle')
    options = parser.parse_args(argv)
    if options.action is not None and options.launch is None:
        parser.error('--action requires --launch')
    if options.debug is not None and options.launch is None and options.action is not None:
        parser.error('--debug with --action requires --launch')
    if os.geteuid() == 0:
        raise RuntimeError('the application menu must run as the desktop user, not root')
    if tomat_overlay_active():
        return 0
    prepare_environment()
    if options.list:
        print(json.dumps(enumerate_apps(), ensure_ascii=False))
    elif options.launch is not None:
        launch_desktop(options.launch, options.action, options.debug)
    elif options.search or options.debug is not None:
        run_menu('Search Applications', options.debug)
    else:
        run_menu(debug_mode=options.debug)
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError, ImportError, subprocess.SubprocessError) as exc:
        print(f'labwc main menu: {exc}', file=sys.stderr)
        raise SystemExit(1)
