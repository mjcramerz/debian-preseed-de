#!/bin/sh
# Terminal entry point for the installed, profile-controlled NFS client.
set -eu
if [ "$#" -eq 1 ] && [ "$1" = --help ]; then
  printf '%s\n' 'Usage: nfsmnt' \
    'Check the configured NFS server, mount its fstab share, then its configured home bind.' \
    'Run as the desktop user; systemd uses the existing administrator authentication policy.'
  exit 0
fi
if [ "$#" -ne 0 ]; then
  printf '%s\n' 'Usage: nfsmnt [--help]' >&2
  exit 2
fi
exec /usr/local/bin/labwc-network-sharing --connect
