def write_config(
    profile_home: pathlib.Path, paths: dict[str, pathlib.Path], binding: tuple[str, str],
    port: int = DEFAULT_PORT,
) -> pathlib.Path:
    config_dir = profile_home / ".config" / "qBittorrent"
    ensure_directory(profile_home / ".config", 0o700)
    ensure_directory(config_dir, 0o700)
    config_path = config_dir / "qBittorrent.conf"

    parser = configparser.ConfigParser(
        interpolation=None,
        strict=False,
        delimiters=("=",),
        empty_lines_in_values=False,
    )
    parser.optionxform = str
    exists = os.path.lexists(config_path)
    if exists:
        try:
            descriptor = os.open(config_path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
            with os.fdopen(descriptor, "rb") as handle:
                metadata = os.fstat(handle.fileno())
                if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
                        or metadata.st_nlink != 1):
                    fail(f"qBittorrent config must be a singly linked regular file owned by the user: {config_path}")
                if metadata.st_size > MAX_CONFIG_BYTES:
                    fail(f"qBittorrent config exceeds {MAX_CONFIG_BYTES} bytes")
                data = handle.read(MAX_CONFIG_BYTES + 1)
                if len(data) > MAX_CONFIG_BYTES:
                    fail(f"qBittorrent config exceeds {MAX_CONFIG_BYTES} bytes")
                parser.read_string(data.decode("utf-8"), source=str(config_path))
                if stat.S_IMODE(metadata.st_mode) != 0o600:
                    os.fchmod(handle.fileno(), 0o600)
        except (OSError, UnicodeError, configparser.Error) as exc:
            # Parser errors may contain credential-bearing configuration lines.
            fail(f"cannot read qBittorrent config {config_path} ({type(exc).__name__})")

    changed = False
    for section, settings in managed_settings(paths, binding, port).items():
        if not parser.has_section(section):
            parser.add_section(section)
        for key, value in settings.items():
            if parser.get(section, key, fallback=None) != value:
                parser[section][key] = value
                changed = True
    if exists and not changed:
        return config_path

    temporary_path = config_path.with_name(f".{config_path.name}.{os.getpid()}.tmp")
    try:
        descriptor = os.open(
            temporary_path,
            os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            parser.write(handle, space_around_delimiters=False)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_path, config_path)
        os.chmod(config_path, 0o600)
    except OSError as exc:
        try:
            temporary_path.unlink()
        except OSError:
            pass
        fail(f"failed to write managed qBittorrent config {config_path}: {exc}")
    return config_path


def local_torrent_path(raw_argument: str) -> pathlib.Path | None:
    if raw_argument.startswith("file:"):
        try:
            parsed = urllib.parse.urlsplit(raw_argument)
            decoded_path = urllib.parse.unquote(
                parsed.path,
                encoding="utf-8",
                errors="strict",
            )
        except (UnicodeError, ValueError) as exc:
            fail(f"invalid local torrent file URI: {exc}")
        if parsed.scheme != "file" or parsed.netloc not in {"", "localhost"}:
            fail("local torrent file URI must use file:// with no remote host")
        if parsed.query or parsed.fragment:
            fail("local torrent file URI must not contain a query or fragment")
        return validate_absolute_path("local torrent file", decoded_path)
    if raw_argument.startswith("/"):
        return validate_absolute_path("local torrent file", raw_argument)
    return None


def stage_torrent_file(
    source_path: pathlib.Path,
    imports_path: pathlib.Path,
) -> str:
    if source_path.suffix.lower() != ".torrent":
        fail(f"local qBittorrent input must end in .torrent: {source_path}")
    try:
        source_metadata = source_path.lstat()
    except OSError as exc:
        fail(f"local torrent file is unavailable: {source_path}: {exc}")
    if stat.S_ISLNK(source_metadata.st_mode) or not stat.S_ISREG(source_metadata.st_mode):
        fail(f"local torrent file must be a regular file, not a symlink: {source_path}")
    if source_metadata.st_size <= 0:
        fail(f"local torrent file is empty: {source_path}")
    if source_metadata.st_size > MAX_TORRENT_FILE_BYTES:
        fail(
            "local torrent file exceeds "
            f"{MAX_TORRENT_FILE_BYTES} bytes: {source_path}"
        )

    temporary_path = imports_path / f".import.{os.getpid()}.{source_metadata.st_ino}.tmp"
    digest = hashlib.sha256()
    try:
        source_descriptor = os.open(
            source_path,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
        )
        destination_descriptor = os.open(
            temporary_path,
            os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
        with os.fdopen(source_descriptor, "rb") as source_handle, os.fdopen(
            destination_descriptor,
            "wb",
        ) as destination_handle:
            opened_metadata = os.fstat(source_handle.fileno())
            if (
                not stat.S_ISREG(opened_metadata.st_mode)
                or opened_metadata.st_dev != source_metadata.st_dev
                or opened_metadata.st_ino != source_metadata.st_ino
                or opened_metadata.st_size != source_metadata.st_size
            ):
                fail(f"local torrent file changed while opening: {source_path}")
            copied_bytes = 0
            while True:
                chunk = source_handle.read(1024 * 1024)
                if not chunk:
                    break
                copied_bytes += len(chunk)
                if copied_bytes > MAX_TORRENT_FILE_BYTES:
                    fail(
                        "local torrent file exceeds "
                        f"{MAX_TORRENT_FILE_BYTES} bytes while reading: {source_path}"
                    )
                digest.update(chunk)
                destination_handle.write(chunk)
            if copied_bytes != source_metadata.st_size:
                fail(f"local torrent file changed while reading: {source_path}")
            destination_handle.flush()
            os.fsync(destination_handle.fileno())

        destination_path = imports_path / f"{digest.hexdigest()}.torrent"
        if os.path.lexists(destination_path):
            destination_metadata = destination_path.lstat()
            if stat.S_ISLNK(destination_metadata.st_mode) or not stat.S_ISREG(
                destination_metadata.st_mode
            ):
                fail(
                    "managed qBittorrent import destination must be a regular file: "
                    f"{destination_path}"
                )
        os.replace(temporary_path, destination_path)
        os.chmod(destination_path, 0o600)
        return str(pathlib.Path("/home/user/imports") / destination_path.name)
    except OSError as exc:
        fail(f"failed to stage local torrent file {source_path}: {exc}")
    finally:
        try:
            temporary_path.unlink()
        except OSError:
            pass


def prepare_launch_arguments(
    paths: dict[str, pathlib.Path],
    raw_arguments: list[str],
) -> list[str]:
    if len(raw_arguments) > MAX_LAUNCH_ARGUMENTS:
        fail(f"qBittorrent accepts at most {MAX_LAUNCH_ARGUMENTS} launch arguments")

    prepared: list[str] = []
    for raw_argument in raw_arguments:
        if (
            not raw_argument
            or len(raw_argument.encode("utf-8", errors="surrogateescape"))
            > MAX_LAUNCH_ARGUMENT_BYTES
            or any(character in raw_argument for character in ("\0", "\n", "\r"))
        ):
            fail("qBittorrent launch argument is empty, oversized, or contains controls")

        local_path = local_torrent_path(raw_argument)
        if local_path is not None:
            prepared.append(stage_torrent_file(local_path, paths["imports"]))
            continue

        try:
            parsed = urllib.parse.urlsplit(raw_argument)
        except ValueError as exc:
            fail(f"invalid qBittorrent launch URI: {exc}")
        if parsed.scheme == "magnet" and raw_argument.startswith("magnet:?"):
            prepared.append(raw_argument)
            continue
        if parsed.scheme in {"http", "https"} and parsed.netloc:
            prepared.append(raw_argument)
            continue
        fail(f"unsupported qBittorrent launch argument: {raw_argument}")
    return prepared


def forward_to_existing(profile_home: pathlib.Path, arguments: list[str]) -> bool:
    """Use qBittorrent's bounded QtLocalPeer IPC before claiming peer ports."""
    ipc = profile_home / ".config/qBittorrent/ipc-socket"
    try:
        metadata = ipc.lstat()
    except FileNotFoundError:
        return False
    if not stat.S_ISSOCK(metadata.st_mode) or metadata.st_uid != os.getuid():
        fail("unsafe existing qBittorrent IPC socket")
    if any("|" in value for value in arguments):
        fail("qBittorrent IPC arguments must not contain its parameter separator")
    message = "|".join(arguments).encode("utf-8")
    if len(message) > 65535:
        fail("qBittorrent IPC request exceeds the application limit")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as channel:
            channel.settimeout(5)
            try:
                channel.connect(str(ipc))
            except OSError as exc:
                if exc.errno in {errno.ENOENT, errno.ECONNREFUSED}:
                    return False  # qBittorrent itself recovers its stale endpoint.
                raise
            channel.sendall(struct.pack("!I", len(message)) + message)
            acknowledgement = bytearray()
            while len(acknowledgement) < 3:
                chunk = channel.recv(3 - len(acknowledgement))
                if not chunk:
                    break
                acknowledgement.extend(chunk)
            if acknowledgement != b"ack":
                fail("existing qBittorrent did not acknowledge the launch request")
    except OSError as exc:
        fail(f"cannot send the launch request to existing qBittorrent: {exc}")
    return True


def acquire_launch_lock(profile_home: pathlib.Path, arguments: list[str]) -> int | None:
    """Serialize first starts; concurrent requests can still reach live IPC."""
    if forward_to_existing(profile_home, arguments):
        return None
    descriptor = os.open(profile_home / ".launcher.lock",
        os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, 0o600)
    try:
        metadata = os.fstat(descriptor)
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
                or stat.S_IMODE(metadata.st_mode) != 0o600 or metadata.st_nlink != 1):
            fail("unsafe qBittorrent launcher lock")
        deadline = time.monotonic() + 30
        while True:
            if forward_to_existing(profile_home, arguments):
                os.close(descriptor)
                return None
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return descriptor
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    fail("qBittorrent startup is still in progress; retry after it is ready")
                time.sleep(0.1)
    except BaseException:
        os.close(descriptor)
        raise


def optional_ro_bind(command: list[str], source: str) -> None:
    if os.path.exists(source):
        command.extend(["--ro-bind", source, source])


def add_gpu_device_binds(command: list[str], acceleration_mode: str) -> None:
    if acceleration_mode not in {"launch", "intel", "nvidia"}:
        fail(f"unsupported qBittorrent accelerator mode: {acceleration_mode}")

    render_devices = sorted(
        path
        for path in pathlib.Path("/dev/dri").glob("renderD[0-9]*")
        if re.fullmatch(r"renderD(?:0|[1-9][0-9]{0,5})", path.name)
    )
    if render_devices:
        command.extend(["--dir", "/dev/dri"])
    device_paths = [
        *render_devices,
        pathlib.Path("/dev/kfd"),
        pathlib.Path("/dev/accel"),
    ]
    if acceleration_mode == "nvidia":
        device_paths.extend(
            (
                pathlib.Path("/dev/nvidia-caps"),
                pathlib.Path("/dev/nvidiactl"),
                pathlib.Path("/dev/nvidia-uvm"),
                pathlib.Path("/dev/nvidia-uvm-tools"),
            )
        )
        device_paths.extend(sorted(pathlib.Path("/dev").glob("nvidia[0-9]*")))
    for device_path in device_paths[:64]:
        try:
            metadata = device_path.lstat()
        except FileNotFoundError:
            continue
        except OSError as exc:
            fail(f"cannot inspect qBittorrent accelerator device {device_path}: {exc}")
        if stat.S_ISLNK(metadata.st_mode) or not (
            stat.S_ISDIR(metadata.st_mode) or stat.S_ISCHR(metadata.st_mode)
        ):
            fail(
                "qBittorrent accelerator path must be a directory or character "
                f"device: {device_path}"
            )
        if metadata.st_uid != 0:
            fail(f"qBittorrent accelerator path must remain root-owned: {device_path}")
        command.extend(["--dev-bind", str(device_path), str(device_path)])


def validate_no_host_audio_device_binds(command: list[str]) -> None:
    bind_options = {
        "--bind",
        "--bind-try",
        "--dev-bind",
        "--dev-bind-try",
        "--ro-bind",
        "--ro-bind-try",
    }
    for index, argument in enumerate(command):
        if argument not in bind_options:
            continue
        if index + 2 >= len(command):
            fail("malformed qBittorrent bubblewrap bind")
        for raw_path in command[index + 1 : index + 3]:
            normalized_path = os.path.normpath(raw_path)
            if normalized_path == "/dev/snd" or normalized_path.startswith("/dev/snd/"):
                fail(f"qBittorrent bubblewrap forbids direct ALSA device access: {raw_path}")


def validate_no_host_display_control_binds(command: list[str]) -> None:
    bind_options = {
        "--bind",
        "--bind-try",
        "--dev-bind",
        "--dev-bind-try",
        "--ro-bind",
        "--ro-bind-try",
    }
    for index, argument in enumerate(command):
        if argument not in bind_options:
            continue
        if index + 2 >= len(command):
            fail("malformed qBittorrent bubblewrap bind")
        for raw_path in command[index + 1 : index + 3]:
            normalized_path = os.path.normpath(raw_path)
            if (
                normalized_path == "/dev/dri"
                or (
                    normalized_path.startswith("/dev/dri/")
                    and re.fullmatch(
                        r"/dev/dri/renderD(?:0|[1-9][0-9]{0,5})",
                        normalized_path,
                    )
                    is None
                )
                or normalized_path == "/dev/nvidia-modeset"
            ):
                fail(
                    "qBittorrent bubblewrap forbids host display-control "
                    f"device access: {raw_path}"
                )


def require_socket(path: pathlib.Path, label: str) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        fail(f"{label} is unavailable: {path}: {exc}")
    if not stat.S_ISSOCK(metadata.st_mode):
        fail(f"{label} is not a socket: {path}")
    if metadata.st_uid != os.getuid() or metadata.st_nlink != 1:
        fail(f"{label} must belong to the invoking user and have one link: {path}")


def session_bus_path(raw_address: str) -> pathlib.Path | None:
    address = raw_address.strip()
    if not address:
        return None
    if len(address) > 4096 or any(character in address for character in ("\0", "\n", "\r", ";")):
        fail("DBUS_SESSION_BUS_ADDRESS is invalid")
    match = DBUS_ADDRESS_PATTERN.fullmatch(address)
    if match is None:
        fail("DBUS_SESSION_BUS_ADDRESS must use one local unix:path transport")
    path = validate_absolute_path("DBUS session bus path", match.group(1))
    require_socket(path, "DBUS session bus")
    return path


def build_command(
    account: pwd.struct_passwd,
    root: pathlib.Path,
    profile_home: pathlib.Path,
    acceleration_mode: str,
    extra_args: list[str],
    resolver_path: pathlib.Path,
) -> list[str]:
    bwrap = shutil.which("bwrap")
    executable = shutil.which("qbittorrent")
    if bwrap is None:
        fail("bubblewrap is not installed")
    if executable is None:
        fail("qBittorrent is not installed")

    host_runtime = validate_absolute_path(
        "XDG_RUNTIME_DIR",
        os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"),
    )
    wayland_display = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
    if not re.fullmatch(r"[A-Za-z0-9._-]+", wayland_display):
        fail(f"WAYLAND_DISPLAY contains unsupported characters: {wayland_display}")
    host_wayland = host_runtime / wayland_display
    require_socket(host_wayland, "Wayland display")

    sandbox_runtime = pathlib.Path(f"/run/user/{os.getuid()}")
    sandbox_home = pathlib.Path("/home/user")
    command = [
        bwrap,
        "--unshare-all",
        "--cap-drop",
        "ALL",
        "--new-session",
        "--die-with-parent",
        "--clearenv",
        "--uid",
        str(os.getuid()),
        "--gid",
        str(os.getgid()),
        "--hostname",
        f"qbittorrent-{os.getuid()}",
        "--proc",
        "/proc",
        "--dev",
        "/dev",
        "--ro-bind",
        "/sys",
        "/sys",
        "--dir",
        "/home",
        "--bind",
        str(profile_home),
        str(sandbox_home),
        "--dir",
        "/run",
        "--dir",
        "/run/user",
        "--dir",
        str(sandbox_runtime),
        "--dir",
        "/run/media",
        "--dir",
        f"/run/media/{account.pw_name}",
        "--bind",
        str(root),
        str(root),
        "--dir",
        "/etc",
        "--dir",
        "/var",
        "--dir",
        "/var/lib",
        "--dir",
        "/var/lib/dbus",
        "--tmpfs",
        "/tmp",
        "--chmod",
        "01777",
        "/tmp",
        "--tmpfs",
        "/var/tmp",
        "--chmod",
        "01777",
        "/var/tmp",
        "--tmpfs",
        "/dev/shm",
        "--chmod",
        "01777",
        "/dev/shm",
        "--bind",
        str(host_wayland),
        str(sandbox_runtime / wayland_display),
        "--chdir",
        str(sandbox_home),
    ]

    for source in ("/usr", "/bin", "/lib"):
        command.extend(["--ro-bind", source, source])
    for source in ("/sbin", "/lib64", "/lib32", "/opt"):
        optional_ro_bind(command, source)
    add_gpu_device_binds(command, acceleration_mode)
    for source in (
        "/etc/alternatives",
        "/etc/ca-certificates",
        "/etc/fonts",
        "/etc/group",
        "/etc/hosts",
        "/etc/ld.so.cache",
        "/etc/ld.so.conf",
        "/etc/ld.so.conf.d",
        "/etc/localtime",
        "/etc/machine-id",
        "/etc/mime.types",
        "/etc/nsswitch.conf",
        "/etc/passwd",
        "/etc/pki",
        "/etc/ssl",
        "/etc/timezone",
        "/etc/xdg",
        "/var/lib/dbus/machine-id",
    ):
        optional_ro_bind(command, source)
    command.extend(["--ro-bind", str(resolver_path), "/etc/resolv.conf"])

    environment = {
        "PATH": "/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin",
        "USER": account.pw_name,
        "LOGNAME": account.pw_name,
        "HOME": str(sandbox_home),
        "LANG": os.environ.get("LANG", "C.UTF-8"),
        "LC_ALL": os.environ.get("LC_ALL", ""),
        "XDG_RUNTIME_DIR": str(sandbox_runtime),
        "XDG_CONFIG_HOME": str(sandbox_home / ".config"),
        "XDG_CACHE_HOME": str(sandbox_home / ".cache"),
        "XDG_DATA_HOME": str(sandbox_home / ".local/share"),
        "XDG_STATE_HOME": str(sandbox_home / ".local/state"),
        "WAYLAND_DISPLAY": wayland_display,
        "XDG_SESSION_TYPE": "wayland",
        "XDG_CURRENT_DESKTOP": "labwc:wlroots",
        "QT_QPA_PLATFORM": "wayland",
        "QT_QPA_PLATFORMTHEME": os.environ.get("QT_QPA_PLATFORMTHEME", "qt6ct"),
        "QT_STYLE_OVERRIDE": "Fusion",
        "QSG_RHI_BACKEND": "opengl",
        "TMPDIR": "/tmp",
    }
    if acceleration_mode == "intel":
        environment.update(
            {
                "LIBVA_DRIVER_NAME": "iHD",
            }
        )
    elif acceleration_mode == "nvidia":
        environment.update(
            {
                "GBM_BACKEND": "nvidia-drm",
                "LIBVA_DRIVER_NAME": "nvidia",
                "NVD_BACKEND": "direct",
                "__GLX_VENDOR_LIBRARY_NAME": "nvidia",
                "__NV_PRIME_RENDER_OFFLOAD": "1",
            }
        )
    bus_path = session_bus_path(os.environ.get("DBUS_SESSION_BUS_ADDRESS", ""))
    if bus_path is not None:
        sandbox_bus = sandbox_runtime / "bus"
        command.extend(["--bind", str(bus_path), str(sandbox_bus)])
        environment["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={sandbox_bus}"

    for key, value in environment.items():
        if value:
            command.extend(["--setenv", key, value])
    command.append(executable)
    command.extend(extra_args)
    validate_no_host_audio_device_binds(command)
    validate_no_host_display_control_binds(command)
    return command


def redirect_to_user_service() -> None:
    marker = os.environ.get("LABWC_QBITTORRENT_SESSION_UNIT", "")
    if marker not in {"", "1"}:
        fail("invalid qBittorrent user-service marker")
    uid = os.getuid()
    runtime = pathlib.Path(f"/run/user/{uid}")
    if uid == 0 or os.environ.get("XDG_RUNTIME_DIR") != str(runtime):
        fail("qBittorrent requires the invoking user's desktop runtime")
    metadata = runtime.lstat()
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != uid or stat.S_IMODE(metadata.st_mode) != 0o700:
        fail("unsafe qBittorrent desktop runtime")
    if (runtime / "labwc-session-closing").exists():
        fail("the desktop is closing; qBittorrent was not started")
    wayland_display = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
    if not re.fullmatch(r"[A-Za-z0-9._-]+", wayland_display):
        fail("invalid Wayland display name")
    require_socket(runtime / wayland_display, "Wayland display")
    bus_path = session_bus_path(os.environ.get("DBUS_SESSION_BUS_ADDRESS", ""))
    if bus_path != runtime / "bus":
        fail("qBittorrent requires the desktop user's own session bus")
    # The application launchers can already own a session-bound transient service. Starting
    # another user unit from it needlessly depends on an inherited bus address
    # and can fail after the first launch has succeeded. Keep its isolation and
    # cgroup lifetime instead of recursively handing off to systemd-run.
    try:
        with pathlib.Path("/proc/self/cgroup").open(encoding="ascii") as stream:
            membership = stream.read(65537)
    except (OSError, UnicodeError) as exc:
        fail(f"cannot verify qBittorrent service ownership: {exc}")
    if len(membership) > 65536:
        fail("oversized qBittorrent cgroup membership")
    in_service = any(re.fullmatch(
        r"0::/[^\n]*/labwc-(?:(?:native-)?qbittorrent|wayland-(?:labwc-)?qbittorrent)-[0-9a-f]{32}[.]service",
        line,
    ) for line in membership.splitlines())
    if marker and not in_service:
        fail("qBittorrent user-service marker is outside its managed cgroup")
    if in_service:
        return
    account = pwd.getpwuid(uid)
    environment = {
        "PATH": "/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin",
        "LANG": os.environ.get("LANG", "C.UTF-8"),
        "HOME": account.pw_dir, "USER": account.pw_name, "LOGNAME": account.pw_name,
        "XDG_RUNTIME_DIR": str(runtime), "WAYLAND_DISPLAY": wayland_display,
        "DBUS_SESSION_BUS_ADDRESS": f"unix:path={bus_path}",
        "XDG_SESSION_TYPE": "wayland", "XDG_CURRENT_DESKTOP": "labwc:wlroots",
    }
    # No loader, shell, Python, or ambient service-loop variables cross the
    # lowercase AppArmor handoff to the host user manager.
    argv = ["/usr/bin/systemd-run", "--user", "--quiet", "--collect",
            "--service-type=exec", "--expand-environment=no", "--slice=app.slice",
            "--unit=labwc-qbittorrent-" + uuid.uuid4().hex + ".service",
            "--property=Requisite=labwc-session.target", "--property=After=labwc-session.target",
            "--property=PartOf=labwc-session.target", "--property=ExitType=main",
            f"--property=ConditionPathExists=!/run/user/{uid}/labwc-session-closing",
            # qBittorrent owns a StatusNotifierItem when its tray integration
            # is enabled.  SIGTERM can tear down the bubblewrap cgroup before
            # Qt unregisters that item, leaving Waybar with a stale
            # /StatusNotifierItem path and a cancelled relayout.  SIGINT is
            # qBittorrent's graceful close signal; the cgroup boundary still
            # guarantees cleanup if the application does not exit in time.
            "--property=KillSignal=SIGINT", "--property=KillMode=control-group",
            "--property=TimeoutStopSec=20s",
            "--property=SendSIGKILL=yes", "--property=Restart=no", "--property=UMask=0077",
            "--property=StandardInput=null", "--property=StandardOutput=journal",
            "--property=StandardError=journal", "--property=SyslogIdentifier=labwc-qbittorrent",
            "--setenv=LABWC_SESSION_APP=1",
            "--setenv=LABWC_QBITTORRENT_SESSION_UNIT=1",
            *("--setenv=" + name for name in sorted(environment)),
            "--", "/usr/local/bin/labwc-qbittorrent", *sys.argv[1:]]
    os.execve(argv[0], argv, environment)


def network_runtime():
    """Reuse the installed supervisor after verifying its trusted import chain."""
    package_root = pathlib.Path("/usr/local/lib/python3.14/dist-packages")
    package = package_root / "labwc_managed_app"
    for directory in (*reversed(package_root.parents[:-1]), package_root, package):
        metadata = directory.lstat()
        if (not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != 0
                or metadata.st_mode & 0o022):
            fail(f"unsafe qBittorrent network runtime directory: {directory}")
    for name in ("__init__.py", "integrity.py"):
        metadata = (package / name).lstat()
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
                or stat.S_IMODE(metadata.st_mode) != 0o644 or metadata.st_nlink != 1):
            fail(f"unsafe qBittorrent network runtime module: {name}")
    sys.dont_write_bytecode = True
    sys.path.insert(0, str(package_root))
    from labwc_managed_app.integrity import validate_package
    validate_package("native", owner=(0, 0))
    from labwc_managed_app import network_namespace
    return network_namespace


def main() -> int:
    redirect_to_user_service()
    defaults = load_defaults(DEFAULTS_PATH)
    account, configured_root = configured_account(defaults)
    port = configured_peer_port(defaults)
    root = select_storage_root(account, configured_root)
    paths = prepare_storage(root)
    acceleration_mode, raw_launch_arguments = select_acceleration_mode(defaults, sys.argv[1:])
    launch_arguments = prepare_launch_arguments(paths, raw_launch_arguments)
    launch_lock = acquire_launch_lock(paths["profile_home"], launch_arguments)
    if launch_lock is None:
        return 0
    try:
        return run_new_instance(account, root, paths, acceleration_mode, launch_arguments, port)
    finally:
        os.close(launch_lock)


def run_new_instance(
    account: pwd.struct_passwd, root: pathlib.Path, paths: dict[str, pathlib.Path],
    acceleration_mode: str, launch_arguments: list[str], port: int,
) -> int:
    runtime = network_runtime()
    from labwc_managed_app.network_client import configured_network_policy
    try:
        network_policy = configured_network_policy("qbittorrent")
    except (OSError, ValueError, RuntimeError) as exc:
        fail(f"managed qBittorrent network policy failed: {exc}")
    online = network_policy is not None and network_policy["network"]
    if online:
        if network_policy["peer_port"] is None:
            fail("online qBittorrent requires a TCP/UDP peer_port in the managed network policy")
        port = network_policy["peer_port"]
    # Raising on termination lets the supervisor reap both children and
    # close every setup/exit FD before our private runtime directory is removed.
    def interrupted(signum, frame):
        for watched in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
            signal.signal(watched, signal.SIG_IGN)
        raise SystemExit(128 + signum)
    for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        signal.signal(signum, interrupted)
    with tempfile.TemporaryDirectory(
        prefix="labwc-qbittorrent-sandbox-", dir=f"/run/user/{os.getuid()}",
    ) as temporary:
        resolver = pathlib.Path(temporary) / "resolv.conf"
        resolver_configuration = getattr(runtime, "veth_resolv_conf", None)
        resolver.write_text(
            (resolver_configuration() if resolver_configuration is not None else (
                f"nameserver {runtime.VETH_DNS_ADDRESS}\noptions timeout:2 attempts:3\n"
            )) if online else "# Networking is disabled.\n",
            encoding="ascii",
        )
        resolver.chmod(0o600)
        command = build_command(
            account, root, paths["profile_home"], acceleration_mode,
            launch_arguments, resolver,
        )
        payload_count = 1 + len(launch_arguments)
        def configured(lease):
            if lease.peer_port != port:
                fail("qBittorrent peer port differs from the managed network service configuration")
            write_config(paths["profile_home"], paths, (lease.interface, lease.address), port)
        if not online:
            write_config(paths["profile_home"], paths, ("lo", "127.0.0.1"), port)
        return runtime.run_veth_sandbox(
            command[:-payload_count], command[-payload_count:], temporary, (),
            app="qbittorrent",
            on_network_ready=configured if online else None, network=online,
        )


if __name__ == "__main__":
    raise SystemExit(main())
