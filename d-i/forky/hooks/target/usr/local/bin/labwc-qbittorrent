#!/usr/bin/python3 -I
import configparser
import errno
import fcntl
import hashlib
import ipaddress
import json
import os
import pathlib
import pwd
import re
import shlex
import shutil
import stat
import subprocess
import signal
import socket
import struct
import sys
import tempfile
import time
import urllib.parse
import uuid


DEFAULTS_PATH = pathlib.Path("/etc/labwc/desktop.conf")
MAX_DEFAULTS_BYTES = 65536
MAX_LAUNCH_ARGUMENTS = 64
MAX_LAUNCH_ARGUMENT_BYTES = 8192
MAX_TORRENT_FILE_BYTES = 16 * 1024 * 1024
DEFAULT_PORT = 50309
PASTA_BINARY = "/usr/bin/pasta"
NETWORK_SETUP_SECONDS = 15
PRIVATE_PEER_INTERFACE = "tap0"
PRIVATE_PEER_ADDRESS = "10.0.2.100"
SYSTEMD_RESOLVERS = pathlib.Path("/run/systemd/resolve/resolv.conf")
USERNAME_PATTERN = re.compile(r"^[a-z_][a-z0-9_-]*$")
DBUS_ADDRESS_PATTERN = re.compile(r"unix:path=([^,]+)(?:,[^=]+=[^,]+)*")
DEFAULT_KEYS = {
    "LABWC_INTEL_ACCELERATION_AVAILABLE",
    "LABWC_NVIDIA_ACCELERATION_AVAILABLE",
    "LABWC_QBITTORRENT_PORT",
    "LABWC_QBITTORRENT_ROOT",
    "LABWC_QBITTORRENT_USER",
}
ACCELERATION_OPTION_PREFIX = "--acceleration="


def fail(message: str) -> None:
    print(f"fatal: {message}", file=sys.stderr)
    raise SystemExit(1)


def validate_absolute_path(label: str, value: str) -> pathlib.Path:
    if not value or not value.startswith("/"):
        fail(f"{label} must be an absolute path: {value or 'unset'}")
    if any(character in value for character in ("\0", "\n", "\r")):
        fail(f"{label} contains unsupported control characters")
    path = pathlib.Path(value)
    if ".." in path.parts:
        fail(f"{label} must not contain parent traversal: {value}")
    return path


def load_defaults(path: pathlib.Path) -> dict[str, str]:
    try:
        metadata = path.lstat()
    except OSError as exc:
        fail(f"managed desktop defaults are unavailable: {path}: {exc}")
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        fail(f"managed desktop defaults must be a regular file: {path}")
    if metadata.st_uid != 0 or metadata.st_mode & 0o022:
        fail(f"managed desktop defaults must be root-owned and not writable by group or others: {path}")
    if metadata.st_size > MAX_DEFAULTS_BYTES:
        fail(f"managed desktop defaults exceed {MAX_DEFAULTS_BYTES} bytes: {path}")

    values: dict[str, str] = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        fail(f"failed to read managed desktop defaults: {path}: {exc}")
    for line_number, raw_line in enumerate(lines, start=1):
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, raw_value = line.split("=", 1)
        key = key.strip()
        if key not in DEFAULT_KEYS:
            continue
        try:
            parsed = shlex.split(raw_value, comments=False, posix=True)
        except ValueError as exc:
            fail(f"invalid {key} assignment on line {line_number}: {exc}")
        if len(parsed) != 1:
            fail(f"invalid {key} assignment on line {line_number}")
        values[key] = parsed[0]
    return values


def select_acceleration_mode(
    defaults: dict[str, str],
    raw_arguments: list[str],
) -> tuple[str, list[str]]:
    mode = "launch"
    launch_arguments: list[str] = []

    for raw_argument in raw_arguments:
        if not raw_argument.startswith(ACCELERATION_OPTION_PREFIX):
            launch_arguments.append(raw_argument)
            continue
        if mode != "launch":
            fail("qBittorrent accepts at most one managed acceleration selector")
        mode = raw_argument[len(ACCELERATION_OPTION_PREFIX) :]
        if mode not in {"intel", "nvidia"}:
            fail(f"unsupported qBittorrent managed acceleration mode: {mode or 'unset'}")

    if mode in {"intel", "nvidia"}:
        key = f"LABWC_{mode.upper()}_ACCELERATION_AVAILABLE"
        available = defaults.get(key, "")
        if available not in {"true", "false"}:
            fail(f"{key} must be true or false in managed desktop defaults")
        if available != "true":
            fail(f"{mode} acceleration is unavailable on this target")
    return mode, launch_arguments


def configured_account(defaults: dict[str, str]) -> tuple[pwd.struct_passwd, pathlib.Path]:
    if os.geteuid() == 0:
        fail("qBittorrent must run as the configured desktop user, never root")
    try:
        account = pwd.getpwuid(os.getuid())
    except KeyError:
        fail(f"current uid has no passwd entry: {os.getuid()}")

    configured_user = defaults.get("LABWC_QBITTORRENT_USER", "")
    if not USERNAME_PATTERN.fullmatch(configured_user):
        fail(f"LABWC_QBITTORRENT_USER is invalid: {configured_user or 'unset'}")
    if configured_user != account.pw_name:
        fail(f"qBittorrent is restricted to {configured_user}, not {account.pw_name}")

    configured_peer_port(defaults)

    expected_root = pathlib.Path(f"/run/media/{configured_user}/bittorrent")
    configured_root = validate_absolute_path(
        "LABWC_QBITTORRENT_ROOT",
        defaults.get("LABWC_QBITTORRENT_ROOT", ""),
    )
    if configured_root != expected_root:
        fail(f"LABWC_QBITTORRENT_ROOT must be {expected_root}: {configured_root}")
    return account, configured_root


def configured_peer_port(defaults: dict[str, str]) -> int:
    value = defaults.get("LABWC_QBITTORRENT_PORT", "")
    if not re.fullmatch(r"[1-9][0-9]{3,4}", value) or not 1024 <= int(value) <= 65535:
        fail("LABWC_QBITTORRENT_PORT must be a decimal port in 1024..65535")
    return int(value)


def select_storage_root(
    account: pwd.struct_passwd, configured_root: pathlib.Path,
) -> pathlib.Path:
    require_real_directory(configured_root, "qBittorrent storage volume")
    if configured_root.resolve() != configured_root:
        fail(f"qBittorrent storage volume must not resolve through symlinks: {configured_root}")
    # /run/media is transient. Require the configured volume before creating
    # any profile or download directory; never redirect storage into the home.
    try:
        if configured_root.stat().st_dev == pathlib.Path("/run").stat().st_dev:
            fail(f"qBittorrent storage volume is not mounted: {configured_root}")
    except OSError as exc:
        fail(f"cannot verify qBittorrent storage volume: {exc}")
    return configured_root


def require_real_directory(path: pathlib.Path, label: str) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        fail(f"{label} is unavailable: {path}: {exc}")
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        fail(f"{label} must be a real directory, not a symlink: {path}")


def ensure_directory(path: pathlib.Path, mode: int) -> None:
    if os.path.lexists(path):
        require_real_directory(path, "managed qBittorrent directory")
    else:
        try:
            path.mkdir(mode=mode)
        except OSError as exc:
            fail(f"failed to create managed qBittorrent directory {path}: {exc}")
    try:
        os.chmod(path, mode)
    except OSError as exc:
        fail(f"failed to set managed qBittorrent directory mode on {path}: {exc}")


def prepare_storage(root: pathlib.Path) -> dict[str, pathlib.Path]:
    require_real_directory(root, "qBittorrent storage root")
    if root.resolve() != root:
        fail(f"qBittorrent storage root must not resolve through symlinks: {root}")
    if not os.access(root, os.R_OK | os.W_OK | os.X_OK):
        fail(f"qBittorrent storage root is not accessible for reading and writing: {root}")

    paths = {
        "active": root / "active",
        "completed": root / "completed",
        "torrents_active": root / "torrents-active",
        "torrents_completed": root / "torrents-completed",
        "profile_home": root / ".qbittorrent-profile",
        "imports": root / ".qbittorrent-profile" / "imports",
    }
    for name, path in paths.items():
        ensure_directory(path, 0o700 if name in {"profile_home", "imports"} else 0o750)
    return paths


def route_binding(destination: str) -> tuple[str, str]:
    """Read the kernel's IPv4 route without transmitting a packet."""
    try:
        result = subprocess.run(
            ["/usr/sbin/ip", "-j", "-4", "route", "get", destination],
            stdin=subprocess.DEVNULL, capture_output=True, timeout=5,
            env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"},
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise ValueError("route lookup failed") from exc
    if result.returncode:
        raise ValueError("route is unavailable")
    if len(result.stdout) > 16384:
        raise ValueError("route response is oversized")
    try:
        routes = json.loads(result.stdout)
        if not isinstance(routes, list) or len(routes) != 1 or not isinstance(routes[0], dict):
            raise ValueError("expected one route")
        route = routes[0]
        interface = route.get("dev", "")
        source = route.get("prefsrc", route.get("src", ""))
        if not isinstance(interface, str) or not re.fullmatch(r"[A-Za-z0-9_.-]{1,15}", interface):
            raise ValueError("invalid route interface")
        if not isinstance(source, str):
            raise ValueError("invalid route source type")
        address = ipaddress.IPv4Address(source)
        if (address.is_loopback or address.is_link_local
                or address.is_unspecified or address.is_multicast or address.is_reserved):
            raise ValueError("unusable route source address")
        return interface, str(address)
    except (ValueError, TypeError) as exc:
        raise ValueError("invalid route response") from exc


def network_binding() -> tuple[str, str]:
    """Select one Internet route for the private peer listener and egress."""
    # The managed peer firewall and selected DNS upstreams require IPv4.
    # Never start a download-only sandbox with unusable peer listeners.
    try:
        interface, source = route_binding("1.1.1.1")
    except ValueError as exc:
        fail(f"qBittorrent private peer forwarding requires an active IPv4 Internet route: {exc}")
    if interface == "lo" or interface.startswith("tailscale"):
        fail("qBittorrent Internet route uses loopback or Tailscale; activate a LAN or VPN Internet route")
    return interface, source


def routed_dns_servers(binding: tuple[str, str], source: pathlib.Path = SYSTEMD_RESOLVERS) -> list[str]:
    """Use only upstream DNS servers reachable by the selected Internet route.

    Use upstream addresses directly, without mapping the host resolver stub
    or routing DNS through a different interface from the peer connections.
    """
    try:
        resolver_owners = {0, pwd.getpwnam("systemd-resolve").pw_uid}
    except KeyError:
        fail("systemd-resolve account is unavailable")
    try:
        for directory in (pathlib.Path("/run"), pathlib.Path("/run/systemd"), source.parent):
            metadata = directory.lstat()
            owners = resolver_owners if directory == source.parent else {0}
            if (not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid not in owners
                    or metadata.st_mode & 0o022):
                fail(f"unsafe qBittorrent resolver directory: {directory}")
        descriptor = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
        with os.fdopen(descriptor, "rb") as handle:
            metadata = os.fstat(handle.fileno())
            if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid not in resolver_owners
                    or metadata.st_mode & 0o022 or metadata.st_nlink != 1
                    or not 0 < metadata.st_size <= 16_384):
                fail("unsafe systemd-resolved upstream DNS configuration")
            content = handle.read(16_385)
    except OSError as exc:
        fail(f"systemd-resolved upstream DNS configuration is unavailable: {exc}")
    if len(content) > 16_384:
        fail("systemd-resolved upstream DNS configuration is oversized")
    return select_routed_dns_servers(content, binding)


def select_routed_dns_servers(content: bytes, binding: tuple[str, str]) -> list[str]:
    """Reject stub, Tailscale and off-route upstreams before creating a sandbox."""
    try:
        lines = content.decode("ascii").splitlines()
    except UnicodeError:
        fail("invalid systemd-resolved upstream DNS configuration")
    selected: list[str] = []
    for line in lines:
        fields = line.split()
        if len(fields) != 2 or fields[0] != "nameserver":
            continue
        try:
            address = ipaddress.IPv4Address(fields[1])
        except ipaddress.AddressValueError:
            continue
        if (address.is_loopback or address.is_link_local or address.is_unspecified
                or address.is_multicast or address.is_reserved):
            continue
        candidate = str(address)
        if candidate in selected:
            continue
        try:
            if route_binding(candidate) != binding:
                continue
        except ValueError:
            continue
        selected.append(candidate)
        if len(selected) == 3:
            break
    if not selected:
        fail("no IPv4 DNS server follows the selected qBittorrent Internet route")
    return selected


