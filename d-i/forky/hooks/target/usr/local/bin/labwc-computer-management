#!/usr/bin/python3 -I
"""Computer Management: six task-oriented groups, existing action boundaries.

The no-argument entry point opens one managed terminal, like AI & Copilots.
All child dmenu pickers opt into the terminal-only fzf data adapter; their
existing allowlisted dispatch, confirmations and privileged helpers remain.
"""
import json
import os
import subprocess
import sys
from pathlib import Path

SELF = '/usr/local/bin/labwc-computer-management'
PICKER = '/usr/local/bin/labwc-fuzzel'
TERMINAL = '/usr/local/bin/labwc-terminal'
LOG = '/usr/local/bin/labwc-fuzzel-log'

# Labels are presentation. Only these fixed argv vectors can be launched.
MENUS = {
    'System & Recovery': {
        'Maintenance & Health': ('labwc-maintenance-menu', 'system'),
        'Recovery & Repair': ('labwc-maintenance-menu', 'recovery'),
    },
    'Network & Remote': {
        'Connection Profiles': ('labwc-network-control-menu', 'connections'),
        'VPN Connections': ('labwc-network-control-menu', 'vpn'),
        'WireGuard Connections': ('labwc-network-control-menu', 'wireguard'),
        'DNS Configuration': ('labwc-network-control-menu', 'dns'),
        'Network Discovery': ('labwc-network-scan-menu',),
        'Remote Desktop': ('labwc-remote-desktop',),
    },
    'Security & Accounts': {
        'Protection & Firewall': ('labwc-maintenance-menu', 'security'),
        'Users & Groups': ('labwc-users-groups-menu',),
    },
    'Devices & Desktop': {
        'Displays & Layout': ('labwc-display-configuration',),
        'Refresh Display Layout': ('/usr/local/libexec/labwc-output-watch', '--refresh'),
        'Power Profile': ('labwc-power-settings',),
        'Keyboard Layout': ('labwc-keyboard-layout',),
        'Audio Control': ('labwc-wayland-app', 'auto', '--', '/usr/bin/pavucontrol'),
        'Restart Dock': ('/usr/bin/systemctl', '--user', '--no-block', 'restart', 'crystal-dock.service'),
        'Android Devices': ('labwc-adb-menu',),
        'Bluetooth Devices': ('labwc-bluetooth', 'menu'),
        'Brightness': ('labwc-brightness-control',),
    },
    'Containers & AI': {
        'Containers': ('labwc-podman-menu',),
        'AI & Copilots': ('labwc-ai-copilots', '--terminal'),
    },
    'Files & Documents': {
        'Documents & Media': ('labwc-digital-assets',),
        'Drives & Backups': ('labwc-external-drives',),
    },
}


def choose(labels: list[str], prompt: str) -> str | None:
    result = subprocess.run([PICKER, 'menu', '--dmenu', '--prompt', prompt],
                            input=''.join(label + '\n' for label in labels), text=True,
                            stdout=subprocess.PIPE, check=False,
                            env={**os.environ, 'LABWC_MENU_INPUT_MODE': 'choice'})
    if result.returncode == 1:
        return None
    if result.returncode:
        raise RuntimeError(f'management picker failed ({result.returncode})')
    selected = result.stdout.removesuffix('\n')
    return selected if selected in labels else None


def run_action(arguments: tuple[str, ...]) -> int:
    executable = arguments[0]
    if not executable.startswith('/'):
        executable = '/usr/local/bin/' + executable
    command = (executable, *arguments[1:])
    try:
        status = subprocess.run(command, check=False).returncode
    except OSError as error:
        print(f'Computer Management: {Path(executable).name}: {error}', file=sys.stderr)
        status = 127
    if Path(LOG).is_file():
        subprocess.run([LOG, 'action', 'completed', 'source=computer-management',
                        'action=' + Path(executable).name, 'status=' + str(status)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    return status


def run_menu() -> int:
    while True:
        group = choose([*MENUS, 'Exit'], 'Computer Management')
        if group is None or group == 'Exit':
            return 0
        entries = MENUS[group]
        while True:
            selected = choose([*entries, 'Back'], 'Computer Management / ' + group)
            if selected is None or selected == 'Back':
                break
            run_action(entries[selected])


def main(argv: list[str]) -> int:
    if argv == ['--catalog']:
        print(json.dumps(MENUS, ensure_ascii=False, indent=2))
        return 0
    if os.geteuid() == 0:
        raise ValueError('Computer Management must run as the desktop user')
    if not argv:
        os.execv(TERMINAL, [TERMINAL, '-e', SELF, '--terminal'])
    if argv != ['--terminal']:
        raise ValueError('usage: labwc-computer-management [--terminal|--catalog]')
    with open('/dev/tty', 'r+'):
        pass
    # Set this only after entering the managed terminal. No global session
    # export: application menus remain Fuzzel and GUI actions remain isolated.
    os.environ.update(LABWC_MENU_BACKEND='fzf', LABWC_MENU_ACTION_WAIT='1',
                      LABWC_FUZZEL_LOG_SCOPE='computer-management')
    # Direct AI & Copilots fzf invocations receive the same safe defaults.
    for key in list(os.environ):
        if key.startswith('FZF_'):
            del os.environ[key]
    return run_menu()


if __name__ == '__main__':
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(0)
    except (OSError, ValueError, RuntimeError) as error:
        print('Computer Management: ' + str(error), file=sys.stderr)
        raise SystemExit(2)
