#!/bin/sh
set -eu

PROG=${0##*/}
CR=$(printf '\r')
LF=$(printf '\n')

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
usage() { printf 'usage: %s --menu\n       %s -i <private-key> --remote-ip <ip-or-host> --port <ssh-port> [--user <remote-user>] <remote-path> [local-path]\n' "$PROG" "$PROG" >&2; }
require_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }
require_value() { [ "$#" -ge 2 ] && [ -n "$2" ] || die "$1 requires a value"; }
read_value() { printf '%s: ' "$1"; IFS= read -r REPLY || exit 0; [ -n "$REPLY" ] || die "$1 must not be empty"; }
validate_host() { case $1 in ''|*[!A-Za-z0-9:.%-]*) die 'host must contain only letters, digits, dots, dashes, percent signs, and colons';; esac; }
validate_port() {
  case $1 in ''|*[!0-9]*) die 'port must be numeric';; esac
  [ "${#1}" -le 5 ] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ] 2>/dev/null || die 'port must be in range 1..65535'
}
validate_user() { case $1 in ''|[!a-z_]*|*[!a-z0-9_-]*) die "remote user is invalid: ${1:-unset}";; esac; }
validate_remote_path() {
  remote_value=$1
  [ -n "$remote_value" ] || die 'remote path must not be empty'
  [ "${#remote_value}" -le 4096 ] || die 'remote path exceeds the length limit'
  case $remote_value in -*) die 'remote path must not start with -';; *[![:print:]]*) die 'remote path contains control characters';; esac
}
validate_identity() {
  identity=$1
  [ -n "$identity" ] || die 'private-key identity must not be empty'
  case "$identity" in
    -*) die 'private-key identity must not start with -';;
    *"$CR"*|*"$LF"*) die 'private-key identity contains control characters';;
  esac
  [ -f "$identity" ] || die "private-key identity is not a regular file: $identity"
  [ ! -L "$identity" ] || die 'private-key identity must not be a symlink'
  identity_stat=$(/usr/bin/stat -Lc '%u %a %h' -- "$identity") || die 'unable to inspect private-key identity'
  set -- $identity_stat
  [ "$#" -eq 3 ] || die 'unable to inspect private-key identity'
  [ "$1" = "$(/usr/bin/id -u)" ] || die 'private-key identity must be owned by the current user'
  case $2 in 400|600) ;; *) die 'private-key identity must have mode 0400 or 0600';; esac
  [ "$3" = 1 ] || die 'private-key identity must not have hard links'
}

remote_user=$(/usr/bin/id -un)
local_path=.
remote_host=
port=
identity_file=

if [ "${1:-}" = --menu ]; then
  [ "$#" -eq 1 ] || die '--menu takes no additional arguments'
  [ -t 0 ] && [ -t 1 ] || die '--menu requires an interactive terminal'
  read_value 'Private key path'; identity_file=$REPLY
  read_value 'Remote host or IP'; remote_host=$REPLY
  read_value 'SSH port'; port=$REPLY
  printf 'Remote user [%s]: ' "$remote_user"
  IFS= read -r entered_user || exit 0
  [ -n "$entered_user" ] && remote_user=$entered_user
  read_value 'Remote path'; remote_path=$REPLY
  printf 'Local path [.]: '
  IFS= read -r local_path || exit 0
  [ -n "$local_path" ] || local_path=.
  set -- --identity "$identity_file" --remote-ip "$remote_host" --port "$port" \
    --user "$remote_user" -- "$remote_path" "$local_path"
fi

while [ "$#" -gt 0 ]; do
  case $1 in
    -i|--identity) require_value "$@"; identity_file=$2; shift 2;;
    --remote-ip) require_value "$@"; remote_host=$2; shift 2;;
    --port) require_value "$@"; port=$2; shift 2;;
    --user) require_value "$@"; remote_user=$2; shift 2;;
    --help|-h) usage; exit 0;;
    --) shift; break;;
    -*) usage; die "unsupported option: $1";;
    *) break;;
  esac
done
remote_path=${1:-}
[ -n "$remote_path" ] || { usage; exit 2; }
shift
[ "$#" -le 1 ] || { usage; exit 2; }
[ "$#" -eq 0 ] || local_path=$1
[ -n "$remote_host" ] || die '--remote-ip is required'
[ -n "$port" ] || die '--port is required'
/usr/bin/test -n "$identity_file" || die '-i <private-key> is required'
validate_host "$remote_host"
validate_port "$port"
validate_user "$remote_user"
validate_remote_path "$remote_path"
validate_identity "$identity_file"
[ -n "$local_path" ] && [ "${#local_path}" -le 4096 ] || die 'local path is empty or too long'
case $local_path in *[![:print:]]*) die 'local path contains control characters';; esac
# A slash before any colon makes scp treat this operand as a local pathname.
case $local_path in /*|./*|../*) ;; *) local_path=./$local_path;; esac
scp_host=$remote_host
case $scp_host in *:*) scp_host=[$scp_host];; esac
require_cmd scp
printf '%s: retrieving %s@%s:%s to %s\n' "$PROG" "$remote_user" "$remote_host" "$remote_path" "$local_path" >&2
/usr/bin/scp -r -i "$identity_file" -P "$port" -- "${remote_user}@${scp_host}:${remote_path}" "$local_path"
printf '%s: retrieve completed: %s@%s:%s -> %s\n' "$PROG" "$remote_user" "$remote_host" "$remote_path" "$local_path" >&2
