#!/bin/sh
set -eu
[ "$#" -eq 0 ] || { printf '%s\n' 'usage: labwc-window-switcher' >&2; exit 2; }
[ "$(id -u)" -ne 0 ] || {
  printf '%s\n' 'labwc-window-switcher must run as the desktop user' >&2
  exit 1
}
# The native F13 press binding starts cycling with no held modifiers.
# Never synthesize Alt: releasing it would immediately accept a window.
exec /usr/bin/wtype -k F13
