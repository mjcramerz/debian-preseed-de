#!/bin/sh
set -eu
[ "$#" -eq 0 ] || { printf '%s\n' 'usage: labwc-window-switcher' >&2; exit 2; }
[ "$(id -u)" -ne 0 ] || {
  printf '%s\n' 'labwc-window-switcher must run as the desktop user' >&2
  exit 1
}
# F13 invokes NextWindow in the unmodified Debian compositor. Labwc owns the
# thumbnail OSD and its input lifecycle; this one-shot launcher holds no modifier
# and does not implement a separate window list or input helper daemon.
exec /usr/bin/wtype -k F13
