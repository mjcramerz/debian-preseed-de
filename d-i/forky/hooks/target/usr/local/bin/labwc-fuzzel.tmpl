class Error(ValueError):
    """A fixed diagnostic safe for the launcher log."""


class Interrupted(Exception):
    def __init__(self, signum: int):
        self.signum = signum


@dataclass
class Options:
    mode: str
    config_mode: str
    power_confirmation: bool
    managed_icons: bool
    root_menu: bool
    scope: str
    palette: str
    prompt: str
    nul_delimited: bool
    output: str
    argv: list[str]

    @property
    def picker(self) -> bool:
        return self.mode != 'launcher'

    @property
    def log_kind(self) -> str:
        return 'menu' if self.mode == 'menu' else 'action'


def log_event(kind: str, event: str, scope: str, *fields: str) -> None:
    if not os.access(LOGGER, os.X_OK):
        return
    try:
        subprocess.run([LOGGER, kind, event, 'source=' + scope, *fields],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=2, check=False)
    except (OSError, subprocess.TimeoutExpired):
        pass


def installed_settings() -> dict[str, str]:
    """Read only relevant literal shell assignments, without sourcing them."""
    settings = dict(os.environ)
    try:
        fd = os.open(DESKTOP_CONFIG, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except FileNotFoundError:
        return settings
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o644
                or info.st_size > 262144):
            raise Error('installed desktop configuration has unsafe metadata'
                        f' (uid={info.st_uid} gid={info.st_gid} mode={stat.S_IMODE(info.st_mode):04o}'
                        f' nlink={info.st_nlink} bytes={info.st_size})')
        data = stream.read(262145)
    if len(data) > 262144:
        raise Error('installed desktop configuration exceeds its byte budget')
    seen = set()
    for line in data.decode('utf-8').splitlines():
        key, separator, raw = line.partition('=')
        if not (key.startswith('FUZZEL_') or key == 'LABWC_OUTPUT_INTERNAL_PREFIXES'):
            continue
        if not separator or not re.fullmatch(r'[A-Z][A-Z0-9_]*', key) or key in seen:
            raise Error('invalid installed Fuzzel setting')
        values = shlex.split(raw, comments=True, posix=True)
        if len(values) != 1 or any(c in values[0] for c in ('\x00', '\r', '\n')):
            raise Error('installed Fuzzel settings must be literal single values')
        settings[key] = values[0]
        seen.add(key)
    return settings


