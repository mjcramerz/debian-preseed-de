# Protocol validation, row disambiguation, and visible-to-raw recovery.
def input_rows(data: bytes, *, managed: bool, nul_delimited: bool) -> list[bytes]:
    if len(data) > MAX_INPUT:
        raise Error('Fuzzel input exceeds its byte budget')
    separator = b'\0' if nul_delimited else b'\n'
    rows = data.split(separator) if data else []
    if rows and rows[-1] == b'' and data.endswith(separator):
        rows.pop()
    if len(rows) > MAX_ROWS or any(len(row) > MAX_ROW for row in rows):
        raise Error('Fuzzel input exceeds its row budget')
    if managed and any(any(control in row for control in (b'\0', b'\x1f', b'\r')) for row in rows):
        raise Error('managed Fuzzel input contains protocol controls')
    return rows


def back_choice(label: str) -> bool:
    return label in {'Back', '← Back', 'Exit', 'Close', 'Cancel'} or bool(
        re.fullmatch(r'[0-9]+[ \t\v\f]+Close', label))


def managed_rows(rows: list[bytes], options: Options) -> tuple[bytes, dict[bytes, bytes]]:
    mapping: dict[bytes, bytes] = {}
    display = []
    have_back = False
    for number, raw in enumerate(rows, 1):
        label = raw.decode('utf-8')
        have_back = have_back or back_choice(label)
        shown = re.sub(r'^(?:⮞||★)[ \t\v\f]+', '', label)
        if shown == '← Back' or not options.root_menu and (
                label in {'Exit', 'Close', 'Cancel'} or re.fullmatch(r'[0-9]+[ \t\v\f]+Close', label)):
            shown = 'Back'
        unique = shown
        serial = 1
        while unique.encode('utf-8') in mapping:
            unique = f'{shown} [{number}:{serial}]'
            serial += 1
        visible = unique.encode('utf-8')
        mapping[visible] = raw
        display.append(visible + b'\0icon\x1f' + icon_for(shown, options.prompt).encode('utf-8') + b'\n')
    if not options.root_menu and not have_back:
        unique = b'Back'
        serial = 1
        while unique in mapping:
            unique = f'Back [{len(rows) + 1}:{serial}]'.encode('utf-8')
            serial += 1
        mapping[unique] = b''
        display.append(unique + b'\0icon\x1fgo-previous\n')
    return b''.join(display), mapping


def picker_status(status: int, diagnostics: bytes) -> int:
    # Keep startup/backend failures distinct from silent native focus loss.
    # Never echo diagnostics: they may contain a secret prompt or hostile data.
    for line in diagnostics.splitlines():
        if line.strip() and not re.match(rb'^\s*(?:warn|info|dbg):', line):
            return MENU_FAILURE_STATUS
    shell_status = 128 - status if status < 0 else status
    if shell_status in {1, 2, 130}:
        return MENU_DISMISSED_STATUS
    return 1 if shell_status == 10 else shell_status


def selected_row(data: bytes, *, nul_delimited: bool, managed: bool = False) -> bytes:
    separator = b'\0' if nul_delimited else b'\n'
    if data.endswith(separator):
        data = data[:-1]
    if managed and not nul_delimited and b'\0' in data:
        visible, metadata = data.split(b'\0', 1)
        if b'\x1f' not in metadata or b'\0' in metadata:
            raise Error('Fuzzel returned malformed icon metadata')
        data = visible
    if separator in data or b'\r' in data or (not nul_delimited and b'\0' in data):
        raise Error('Fuzzel returned more than one selection or protocol controls')
    return data


@contextmanager
def runtime_lock(settings: dict[str, str]):
    root = Path(settings.get('XDG_RUNTIME_DIR', ''))
    if not root.is_absolute():
        raise Error('XDG_RUNTIME_DIR must name an absolute Fuzzel runtime directory')
    info = root.lstat()
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
            or stat.S_IMODE(info.st_mode) != 0o700):
        raise Error('Fuzzel runtime directory is not private to the current user')
    descriptor = os.open(root / 'labwc-fuzzel.lock',
                         os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    with os.fdopen(descriptor, 'ab') as lock:
        info = os.fstat(lock.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600):
            raise Error('unsafe Fuzzel launcher lock')
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            yield None
        else:
            yield root


class PidFile:
    """Publish the native PID while holding the shared launcher lock."""
    def __init__(self, root: Path):
        self.path = root / 'labwc-fuzzel.pid'
        self.identity = None
        self.started = False
        self.stopped = False

    def publish(self, pid: int) -> None:
        self.started = True
        descriptor = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        with os.fdopen(descriptor, 'wb') as stream:
            info = os.fstat(stream.fileno())
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                    or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600):
                raise Error('unsafe Fuzzel PID file')
            self.identity = info.st_dev, info.st_ino
            stream.truncate(0)
            stream.write((str(pid) + '\n').encode('ascii'))
            stream.flush()

    def mark_stopped(self) -> None:
        self.stopped = True

    def remove(self) -> None:
        if self.identity is None or not self.stopped:
            return
        try:
            info = self.path.lstat()
            if self.identity == (info.st_dev, info.st_ino):
                self.path.unlink()
        except FileNotFoundError:
            pass


def invoke(options: Options, argv: list[str], root: Path) -> int:
    pidfile = PidFile(root)
    log_event(options.log_kind, 'opened', options.scope, 'mode=' + options.mode, 'status=0')
    try:
        if not options.picker:
            process = subprocess.Popen([FUZZEL, *argv], close_fds=True)
            try:
                pidfile.publish(process.pid)
                status = process.wait()
                status = 128 - status if status < 0 else status
                pidfile.mark_stopped()
                pidfile.remove()
            finally:
                stop_process(process)
                pidfile.mark_stopped()
        else:
            data = sys.stdin.buffer.read(MAX_INPUT + 1)
            managed = options.managed_icons and not options.nul_delimited
            rows = input_rows(data, managed=managed, nul_delimited=options.nul_delimited)
            mapping = {}
            if managed:
                data, mapping = managed_rows(rows, options)
            temporary = Path(tempfile.mkdtemp(prefix='labwc-fuzzel-menu.', dir=root))
            input_path = temporary / 'input'
            try:
                # A regular private input file avoids a stdin/stdout pipe deadlock.
                # Output and diagnostics stay in bounded memory, never on disk.
                input_path.write_bytes(data)
                with input_path.open('rb') as stream:
                    raw_status, selection, diagnostics = capture(
                        [FUZZEL, *argv, '--log-level=warning', '--log-colorize=never'],
                        stream, output_limit=MAX_SELECTION, on_start=pidfile.publish,
                        on_stopped=pidfile.mark_stopped)
            finally:
                if not pidfile.started or pidfile.stopped:
                    input_path.unlink(missing_ok=True)
                    temporary.rmdir()
                else:
                    print('fatal: Fuzzel outcome-unknown; retained runtime evidence: ' + str(temporary),
                          file=sys.stderr)
            pidfile.remove()
            status = picker_status(raw_status, diagnostics)
            if status == 0:
                chosen = selected_row(selection, nul_delimited=options.nul_delimited,
                                      managed=managed)
                if managed and chosen in mapping and mapping[chosen] == b'':
                    # The synthetic Back row has no raw action. Preserve the
                    # public Back contract instead of turning it into an empty
                    # successful selection.
                    status = 1
                elif managed and chosen:
                    if chosen in mapping:
                        chosen = mapping[chosen]
                        # Legacy section markers are presentation only in logs.
                        logged = re.sub(r'^(?:⮞|) ', '', chosen.decode('utf-8'))
                        log_event('menu', 'selected', options.scope, 'kind=listed', 'selection=' + logged)
                    else:
                        log_event('menu', 'selected', options.scope, 'kind=custom-input', 'selection=redacted')
                    sys.stdout.buffer.write(chosen + b'\n')
                elif not managed:
                    # Preserve the native terminator (including --dmenu0).
                    sys.stdout.buffer.write(selection)
        log_event(options.log_kind, 'completed', options.scope, 'mode=' + options.mode, 'status=' + str(status))
        return status
    finally:
        pidfile.remove()


def signal_received(signum, _frame) -> None:
    raise Interrupted(signum)


def cli() -> int:
    options = None
    scope = os.environ.get('LABWC_FUZZEL_LOG_SCOPE', 'desktop')
    if scope not in {'desktop', 'computer-management', 'android-debug-bridge'}:
        scope = 'desktop'
    try:
        os.umask(0o077)
        for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
            signal.signal(signum, signal_received)
        settings = installed_settings()
        options = parse_options(sys.argv[1:], settings)
        scope = options.scope
        if not os.access(FUZZEL, os.X_OK):
            raise Error('fuzzel is not installed')
        argv = profile_arguments(options, settings)
        with runtime_lock(settings) as root:
            if root is None:
                log_event('action', 'already-open', scope, 'mode=' + options.mode)
                return MENU_DISMISSED_STATUS if options.picker else 0
            return invoke(options, argv, root)
    except Interrupted as interrupted:
        return (MENU_DISMISSED_STATUS if options is not None and options.picker
                and interrupted.signum == signal.SIGINT else 128 + interrupted.signum)
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        detail = str(error) if isinstance(error, Error) else 'Fuzzel operation failed (' + type(error).__name__ + ')'
        log_event('action', 'launcher-failed', scope, 'detail=' + detail, 'status=2')
        print('fatal: ' + detail, file=sys.stderr)
        return MENU_FAILURE_STATUS


if __name__ == '__main__':
    raise SystemExit(cli())
