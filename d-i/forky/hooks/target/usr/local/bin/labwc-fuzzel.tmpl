def output_name(value: str) -> str:
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,127}', value):
        raise Error('Fuzzel output name is invalid or exceeds 128 characters')
    return value


def parse_options(args: list[str], settings: dict[str, str]) -> Options:
    if len(args) > 256 or sum(len(arg.encode('utf-8')) + 1 for arg in args) > 65536:
        raise Error('Fuzzel arguments exceed their budget')
    mode = args[0] if args and args[0] in {
        'launcher', 'action', 'menu', 'computer-management', 'power-confirm'} else 'launcher'
    if args and args[0] == mode:
        args = args[1:]
    config_mode = 'menu' if mode in {'action', 'power-confirm'} else mode
    power_confirmation = mode == 'power-confirm'
    if mode in {'power-confirm', 'computer-management'}:
        mode = 'menu'
    flags = [settings.get(name, '0') for name in ('LABWC_FUZZEL_MANAGED_ICONS', 'LABWC_FUZZEL_ROOT_MENU')]
    if any(flag not in {'0', '1'} for flag in flags):
        raise Error('Fuzzel managed-icons and root-menu flags must be 0 or 1')
    scope = settings.get('LABWC_FUZZEL_LOG_SCOPE', 'desktop')
    palette = settings.get('LABWC_FUZZEL_PALETTE', 'desktop')
    if scope not in {'desktop', 'computer-management', 'android-debug-bridge'}:
        raise Error('LABWC_FUZZEL_LOG_SCOPE is invalid')
    if palette not in {'desktop', 'computer-management'}:
        raise Error('invalid Fuzzel palette context')
    argv: list[str] = []
    chosen_output = ''
    have_output = False
    prompt = ''
    nul_delimited = False
    have_dmenu = False
    index = 0
    while index < len(args):
        arg = args[index]
        index += 1
        key, separator, value = arg.partition('=')
        if arg in {'--output', '-o'} or key == '--output' or arg.startswith('-o') and not arg.startswith('--'):
            if have_output:
                raise Error('Fuzzel output may be specified only once')
            have_output = True
            if arg in {'--output', '-o'}:
                if index == len(args):
                    raise Error('Fuzzel output option requires a value')
                value = args[index]
                index += 1
            elif arg.startswith('-o'):
                value = arg[2:]
            chosen_output = output_name(value)
            continue
        if key in PROFILE_OPTIONS or any(
                len(option) == 2 and arg.startswith(option) for option in PROFILE_OPTIONS):
            raise Error('Fuzzel configuration and geometry are selected by the installed profile')
        if arg in {'--dmenu', '-d', '--dmenu0'}:
            mode = 'menu' if mode == 'launcher' else mode
            nul_delimited = nul_delimited or arg == '--dmenu0'
            have_dmenu = True
        elif arg in VALUE_OPTIONS:
            if index == len(args):
                raise Error('Fuzzel option requires a value')
            value = args[index]
            index += 1
            if arg in {'--prompt', '--prompt-only', '-p'}:
                prompt = value
            argv.extend((arg, value))
            continue
        elif separator and (key in VALUE_OPTIONS and key.startswith('--') or key in {
                '--password', '--filter-desktop', '--log-colorize'}):
            if key in {'--prompt', '--prompt-only'}:
                prompt = value
        elif arg.startswith('-p') and not arg.startswith('--') and len(arg) > 2:
            prompt = arg[2:]
        elif arg not in FLAG_OPTIONS:
            raise Error('unsupported Fuzzel argument')
        argv.append(arg)
    if mode != 'launcher' and not have_dmenu:
        argv.append('--dmenu')
    return Options(mode, config_mode, power_confirmation, flags[0] == '1', flags[1] == '1',
                   scope, palette, prompt, nul_delimited, chosen_output, argv)


def stop_process(process: subprocess.Popen) -> None:
    """Bound cleanup separately from the interactive user wait."""
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            process.kill()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired as error:
                raise Error('Fuzzel outcome-unknown: termination unconfirmed; runtime evidence retained') from error


def capture(argv: list[str], input_stream: BinaryIO | int, *, output_limit: int,
            deadline: float | None = None, on_start=None, on_stopped=None) -> tuple[int, bytes, bytes]:
    """Drain both pipes concurrently; never let a child fill memory or disk."""
    output = bytearray()
    diagnostics = bytearray()
    process = subprocess.Popen(argv, stdin=input_stream, stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE, close_fds=True)
    try:
        if on_start is not None:
            on_start(process.pid)
        with selectors.DefaultSelector() as reader:
            for stream, target, limit in ((process.stdout, output, output_limit),
                                           (process.stderr, diagnostics, MAX_DIAGNOSTICS)):
                os.set_blocking(stream.fileno(), False)
                reader.register(stream, selectors.EVENT_READ, (target, limit))
            exited_at = None
            while reader.get_map():
                now = time.monotonic()
                if deadline is not None and now >= deadline:
                    raise Error('Fuzzel output resolver exceeded its deadline')
                if process.poll() is not None:
                    if exited_at is None:
                        exited_at = now
                    elif now - exited_at >= 2:
                        raise Error('Fuzzel output channel did not close after exit')
                for entry, _ in reader.select(timeout=0.1):
                    block = os.read(entry.fd, 16384)
                    if not block:
                        reader.unregister(entry.fileobj)
                        continue
                    target, limit = entry.data
                    if len(target) + len(block) > limit:
                        raise Error('Fuzzel output or diagnostics exceed their byte budget')
                    target.extend(block)
            # A child may close both pipes before exiting. Continue respecting
            # the resolver deadline; a native menu remains intentionally interactive.
            while process.poll() is None:
                if deadline is not None and time.monotonic() >= deadline:
                    raise Error('Fuzzel output resolver exceeded its deadline')
                try:
                    process.wait(timeout=0.1)
                except subprocess.TimeoutExpired:
                    pass
        return process.returncode, bytes(output), bytes(diagnostics)
    finally:
        try:
            stop_process(process)
            if on_stopped is not None:
                on_stopped()
        finally:
            process.stdout.close()
            process.stderr.close()


def profile_arguments(options: Options, settings: dict[str, str]) -> list[str]:
    prefixes = settings.get('LABWC_OUTPUT_INTERNAL_PREFIXES', '')
    if not re.fullmatch(r'[A-Za-z0-9._ -]+', prefixes):
        raise Error('invalid installed internal output classification policy')
    prefixes = prefixes.split()
    if not prefixes or any(len(prefix) > 32 for prefix in prefixes):
        raise Error('internal output prefix policy is blank or exceeds its budget')
    for prefix in prefixes:
        output_name(prefix)
    chosen_output = options.output or settings.get('WAYBAR_OUTPUT_NAME', '')
    if chosen_output:
        output_name(chosen_output)
    elif settings.get('WAYLAND_DISPLAY'):
        if settings.get('LABWC_FUZZEL_OUTPUT_CLASS', '') not in {'', 'INTERNAL', 'EXTERNAL'}:
            raise Error('invalid Fuzzel output class')
        if not os.access(OUTPUT_RESOLVER, os.X_OK):
            raise Error('installed menu output resolver is missing')
        status, result, _ = capture([OUTPUT_RESOLVER, '--menu-output'], subprocess.DEVNULL,
                                   output_limit=129, deadline=time.monotonic() + 5)
        if status:
            raise Error('unable to resolve an enabled menu output')
        chosen_output = output_name(result.decode('utf-8').rstrip('\n'))
    output_class = 'DEFAULT'
    if chosen_output:
        output_class = 'EXTERNAL'
        if any(chosen_output.startswith(prefix + '-') or
               re.match(re.escape(prefix) + r'[0-9]', chosen_output) for prefix in prefixes):
            output_class = 'INTERNAL'
    elif settings.get('LABWC_FUZZEL_OUTPUT_CLASS'):
        output_class = settings['LABWC_FUZZEL_OUTPUT_CLASS']
        if output_class not in {'INTERNAL', 'EXTERNAL'}:
            raise Error('invalid Fuzzel output class')
    geometry_mode = 'MENU' if options.picker else 'LAUNCHER'
    config_mode = options.config_mode
    if options.picker:
        if config_mode == 'launcher':
            config_mode = 'menu'
        if options.palette == 'computer-management':
            config_mode = 'computer-management'
    config_name = {'launcher': 'fuzzel.ini', 'menu': 'menu.ini',
                   'computer-management': 'computer-management.ini'}[config_mode]
    config_root = settings.get('XDG_CONFIG_HOME') or str(Path(settings['HOME']) / '.config')
    config_path = Path(config_root) / 'fuzzel' / config_name
    if not config_path.is_file() or not os.access(config_path, os.R_OK):
        raise Error('missing Fuzzel configuration: ' + config_name)
    selected = {}
    for key, minimum, maximum in (
            ('FONT_SIZE', 8, 32), ('HORIZONTAL_PADDING', 0, 64), ('VERTICAL_PADDING', 0, 64),
            ('INNER_PADDING', 0, 64), ('LINE_HEIGHT', 8, 64), ('BORDER_WIDTH', 0, 32),
            ('BORDER_RADIUS', 0, 128), ('WIDTH', 20, 200), ('LINES', 4, 40)):
        name = ('FUZZEL_' + geometry_mode + '_' + output_class + '_' + key
                if key in {'WIDTH', 'LINES'} else 'FUZZEL_' + output_class + '_' + key)
        value = settings.get(name, '')
        if not re.fullmatch(r'(?:0|[1-9][0-9]{0,2})', value) or not minimum <= int(value) <= maximum:
            raise Error(name + ' is outside its canonical integer range')
        selected[key] = value
    if options.power_confirmation:
        selected.update(WIDTH='60', LINES='4')
    font = ','.join(family + ':size=' + selected['FONT_SIZE'] for family in FONT_FAMILIES)
    argv = ['--config=' + str(config_path), '--font=' + font]
    for flag, key in (('width', 'WIDTH'), ('lines', 'LINES'), ('horizontal-pad', 'HORIZONTAL_PADDING'),
                      ('vertical-pad', 'VERTICAL_PADDING'), ('inner-pad', 'INNER_PADDING'),
                      ('line-height', 'LINE_HEIGHT'), ('border-width', 'BORDER_WIDTH'),
                      ('border-radius', 'BORDER_RADIUS')):
        argv.append('--' + flag + '=' + selected[key])
    argv.extend(options.argv)
    if chosen_output:
        argv.append('--output=' + chosen_output)
    return argv


