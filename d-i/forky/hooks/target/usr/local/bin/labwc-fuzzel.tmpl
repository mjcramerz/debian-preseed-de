{
  label = $0
  icon_label = label
  # Legacy section markers are presentation only, never an app icon.
  sub(/^(⮞||★)[[:space:]]+/, "", icon_label)
  shown = icon_label
  if (root_menu != "1" &&
      (label == "Exit" || label == "Close" || label == "Cancel" ||
       label ~ /^[0-9]+[[:space:]]+Close$/)) shown = "← Back"
  # Distinct raw rows may have identical text after removing legacy markers.
  # Keep every presented choice unambiguous without changing its raw action.
  unique = shown
  serial = 1
  while (unique in presented) unique = shown " [" NR ":" serial++ "]"
  presented[unique] = 1
  printf "%s%cicon%c%s\n", unique, 0, 31, icon_for(shown)
}
' "$raw_choices" >"$display_choices"

if [ "$managed_root_menu" != 1 ] &&
   ! awk '
     $0 == "Back" ||
     $0 == "← Back" ||
     $0 == "Exit" ||
     $0 == "Close" ||
     $0 == "Cancel" ||
     $0 ~ /^[0-9]+[[:space:]]+Close$/ {
       found = 1
     }
     END { exit found ? 0 : 1 }
   ' "$raw_choices"; then
  printf '\n' >>"$raw_choices"
  printf '← Back\000icon\037go-previous\n' >>"$display_choices"
fi

log_fuzzel_lifecycle menu opened 0
if run_fuzzel "$@" <"$display_choices" >"$selection_file"; then
  fuzzel_status=0
else
  fuzzel_status=$?
fi
log_fuzzel_lifecycle menu completed "$fuzzel_status"
[ "$fuzzel_status" -eq 0 ] || exit "$fuzzel_status"

# A picker result must contain at most one row. Never truncate extra rows
# into an apparently valid privileged-action selection.
if ! awk 'END { exit NR > 1 ? 1 : 0 }' "$selection_file"; then
  fatal 'Fuzzel returned more than one selection'
fi
sed -n '1p' "$selection_file" >"$first_selection"
selection=$(cat "$first_selection")
[ -n "$selection" ] || exit 0

matched_line=$(
  awk '
    NR == FNR {
      selected = $0
      next
    }
    {
      # Fuzzel returns only the text, not the icon metadata after the NUL.
      shown = $0
      sub(/\000.*/, "", shown)
      if (shown == selected) { print FNR; exit }
    }
  ' "$first_selection" "$display_choices"
)

if [ -n "$matched_line" ]; then
  raw_selection=$(sed -n "${matched_line}p" "$raw_choices")
  log_managed_menu_selection listed "$raw_selection"
  printf '%s\n' "$raw_selection"
else
  # Do not write arbitrary free-form Fuzzel input to the system log.
  log_managed_menu_selection custom-input redacted
  printf '%s\n' "$selection"
fi
