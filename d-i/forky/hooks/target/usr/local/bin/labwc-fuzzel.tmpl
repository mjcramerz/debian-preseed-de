#!/bin/sh
set -eu

MENU_FAILURE_STATUS=2

# Management child pickers reuse their existing data protocol in a controlling
# terminal. Application search and ordinary graphical menus never opt in.
if [ "${LABWC_MENU_BACKEND:-fuzzel}" = fzf ]; then
  case "${1:-}" in
    computer-management)
      shift
      exec /usr/local/bin/labwc-fzf-menu menu "$@"
      ;;
    menu|--dmenu|--dmenu0)
      exec /usr/local/bin/labwc-fzf-menu "$@"
      ;;
  esac
fi

fatal() {
  fatal_message=$*
  fatal_log_scope=${managed_log_scope:-${LABWC_FUZZEL_LOG_SCOPE:-desktop}}
  if [ -x /usr/local/bin/labwc-fuzzel-log ]; then
    /usr/local/bin/labwc-fuzzel-log \
      action \
      launcher-failed \
      "source=${fatal_log_scope}" \
      "detail=${fatal_message}" \
      "status=${MENU_FAILURE_STATUS}" || true
  fi
  printf 'fatal: %s\n' "$*" >&2
  exit "$MENU_FAILURE_STATUS"
}

if [ -r /etc/labwc/desktop.conf ]; then
  # shellcheck disable=SC1091
  . /etc/labwc/desktop.conf
fi

[ -x /usr/bin/fuzzel ] || {
  fatal 'fuzzel is not installed'
}
[ -x /usr/bin/flock ] || {
  fatal '/usr/bin/flock is required to serialize Fuzzel launchers'
}

config_root=${XDG_CONFIG_HOME:-${HOME}/.config}
fuzzel_config_dir="${config_root}/fuzzel"
mode=launcher
config_mode=launcher
managed_icons=${LABWC_FUZZEL_MANAGED_ICONS:-0}
managed_root_menu=${LABWC_FUZZEL_ROOT_MENU:-0}
managed_log_scope=${LABWC_FUZZEL_LOG_SCOPE:-desktop}
managed_palette=${LABWC_FUZZEL_PALETTE:-desktop}
internal_output_prefixes=${LABWC_OUTPUT_INTERNAL_PREFIXES:?missing installed output classification policy}

require_uint_range() {
  setting_name=$1 setting_value=$2 minimum=$3 maximum=$4
  case "$setting_value" in
    ''|*[!0-9]*|0[0-9]*) fatal "$setting_name must be a canonical decimal integer" ;;
  esac
  [ "${#setting_value}" -le 3 ] || fatal "$setting_name exceeds its numeric budget"
  if [ "$setting_value" -lt "$minimum" ] || [ "$setting_value" -gt "$maximum" ]; then
    fatal "$setting_name must be an integer from $minimum to $maximum"
  fi
}

validate_output_name() {
  [ "${#1}" -le 128 ] || fatal 'Fuzzel output name exceeds 128 characters'
  case "$1" in
    ''|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*|[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789]*)
      fatal 'Fuzzel output name contains unsupported characters' ;;
  esac
}

fuzzel_output_is_internal() {
  for internal_prefix in $internal_output_prefixes; do
    case "$1" in
      "${internal_prefix}"-*|"${internal_prefix}"[0-9]*) return 0 ;;
    esac
  done
  return 1
}

# The same installed policy is used by output detection and native Waybar.
# Validate before word splitting; malformed policy must not expand local globs.
case "$internal_output_prefixes" in
  ''|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._\ -]*)
    fatal 'invalid installed internal output classification policy' ;;
esac
prefix_count=0
for internal_prefix in $internal_output_prefixes; do
  prefix_count=$((prefix_count + 1))
  validate_output_name "$internal_prefix"
  [ "${#internal_prefix}" -le 32 ] || fatal 'internal output prefix exceeds 32 characters'
done
[ "$prefix_count" -gt 0 ] || fatal "internal output prefix policy must not be blank"
case "$managed_icons:$managed_root_menu" in
  0:0|0:1|1:0|1:1) ;;
  *) fatal 'Fuzzel managed-icons and root-menu flags must be 0 or 1' ;;
esac
case "$managed_log_scope" in
  desktop|computer-management|android-debug-bridge) ;;
  *) fatal 'LABWC_FUZZEL_LOG_SCOPE is invalid' ;;
esac
case "$managed_palette" in
  desktop|computer-management) ;;
  *) fatal "invalid Fuzzel palette context" ;;
esac
case "${1:-}" in
  launcher|menu|computer-management) config_mode=$1; shift ;;
esac
[ "$config_mode" = launcher ] || mode=menu

# Rotate positional parameters, preserving argument boundaries without eval,
# a shell command string, temporary argv files, or interpreting option values
# as options. Output belongs to this wrapper; all other native options below
# retain their order. Geometry/configuration are exclusively profile-owned.
have_output=false
fuzzel_output=
managed_prompt=
nul_delimited=false
remaining=$#
while [ "$remaining" -gt 0 ]; do
  arg=$1; shift; remaining=$((remaining - 1))
  case "$arg" in
    --output|-o|--output=*|-o?*)
      [ "$have_output" = false ] || fatal 'Fuzzel output may be specified only once'
      have_output=true
      case "$arg" in
        --output|-o)
          [ "$remaining" -gt 0 ] || fatal 'Fuzzel output option requires a value'
          fuzzel_output=$1; shift; remaining=$((remaining - 1)) ;;
        --output=*) fuzzel_output=${arg#--output=} ;;
        -o?*) fuzzel_output=${arg#-o} ;;
      esac
      validate_output_name "$fuzzel_output"
      continue ;;
    --config|--config=*|-c|-c?*|--font|--font=*|-f|-f?*|--dpi-aware|--dpi-aware=*|-D|-D?*|\
    --width|--width=*|-w|-w?*|--lines|--lines=*|-l|-l?*|\
    --horizontal-pad|--horizontal-pad=*|-x|-x?*|--vertical-pad|--vertical-pad=*|-y|-y?*|\
    --inner-pad|--inner-pad=*|-P|-P?*|--line-height|--line-height=*|\
    --border-width|--border-width=*|-B|-B?*|--border-radius|--border-radius=*|-r|-r?*)
      fatal 'Fuzzel configuration and geometry are selected by the installed profile' ;;
    --dmenu|-d) mode=menu ;;
    --dmenu0) mode=menu; nul_delimited=true ;;
    --prompt|--prompt-only|-p|--cache|--placeholder|--search|--icon-theme|--fields|-F|\
    --terminal|-T|--anchor|-a|--x-margin|--y-margin|--select|--select-index|--tabs|\
    --background|-b|--text-color|-t|--prompt-color|--placeholder-color|--input-color|\
    --match-color|-m|--selection-color|-s|--selection-text-color|-S|--selection-match-color|-M|\
    --counter-color|--border-color|-C|--match-mode|--fuzzy-min-length|\
    --fuzzy-max-length-discrepancy|--fuzzy-max-distance|--letter-spacing|--layer|\
    --keyboard-focus|--launch-prefix|--render-workers|--match-workers|--delayed-filter-ms|\
    --delayed-filter-limit|--with-nth|--accept-nth|--log-level)
      [ "$remaining" -gt 0 ] || fatal "Fuzzel option requires a value: $arg"
      arg_value=$1; shift; remaining=$((remaining - 1))
      case "$arg" in --prompt|--prompt-only|-p) managed_prompt=$arg_value ;; esac
      set -- "$@" "$arg" "$arg_value"
      continue ;;
    --prompt=*|--prompt-only=*) managed_prompt=${arg#*=} ;;
    -p?*) managed_prompt=${arg#-p} ;;
    --cache=*|--placeholder=*|--search=*|--icon-theme=*|--fields=*|--terminal=*|--anchor=*|\
    --x-margin=*|--y-margin=*|--select=*|--select-index=*|--tabs=*|--background=*|\
    --text-color=*|--prompt-color=*|--placeholder-color=*|--input-color=*|--match-color=*|\
    --selection-color=*|--selection-text-color=*|--selection-match-color=*|--counter-color=*|\
    --border-color=*|--match-mode=*|--fuzzy-min-length=*|--fuzzy-max-length-discrepancy=*|\
    --fuzzy-max-distance=*|--letter-spacing=*|--layer=*|--keyboard-focus=*|--launch-prefix=*|\
    --render-workers=*|--match-workers=*|--delayed-filter-ms=*|--delayed-filter-limit=*|\
    --with-nth=*|--accept-nth=*|--log-level=*|--password|--password=*|\
    --filter-desktop|--filter-desktop=*|--log-colorize|--log-colorize=*|\
    --check-config|--use-bold|-i|-I|--no-icons|--hide-before-typing|--show-actions|\
    --no-sort|--counter|--no-exit-on-keyboard-focus-loss|--list-executables-in-path|\
    --index|-R|--no-run-if-empty|--log-no-syslog|-v|--version|-h|--help) ;;
    *) fatal "unsupported Fuzzel argument" ;;
  esac
  set -- "$@" "$arg"
done

if [ "$have_output" = false ] && [ -n "${WAYBAR_OUTPUT_NAME:-}" ]; then
  fuzzel_output=$WAYBAR_OUTPUT_NAME
  validate_output_name "$fuzzel_output"
fi
# Unknown means unknown: no invented connector, and no external-class fallback.
output_class=DEFAULT
if [ -n "$fuzzel_output" ]; then
  output_class=EXTERNAL
  if fuzzel_output_is_internal "$fuzzel_output"; then output_class=INTERNAL; fi
  set -- "$@" "--output=${fuzzel_output}"
fi

if [ "$mode" = menu ]; then
  [ "$config_mode" != launcher ] || config_mode=menu
  # Child pickers inherit palette separately from their logging scope.
  # Management reuses MENU geometry, never another family of dimensions.
  if [ "$managed_palette" = computer-management ]; then config_mode=computer-management; fi
  geometry_mode=MENU
else
  geometry_mode=LAUNCHER
fi
case "$config_mode" in
  launcher) config_name=fuzzel.ini ;;
  menu) config_name=menu.ini ;;
  computer-management) config_name=computer-management.ini ;;
esac
[ -r "${fuzzel_config_dir}/${config_name}" ] || fatal "missing Fuzzel configuration: $config_name"

# Only these fixed keys and the closed class/mode enums are used in variable
# indirection. Values are never evaluated as shell input. Point-valued line
# height, like :size fonts, remains DPI aware (unlike a fixed px height).
for geometry_spec in FONT_SIZE:8:32 HORIZONTAL_PADDING:0:64 VERTICAL_PADDING:0:64 \
    INNER_PADDING:0:64 LINE_HEIGHT:8:64 BORDER_WIDTH:0:32 BORDER_RADIUS:0:128 \
    WIDTH:20:200 LINES:4:40; do
  geometry_key=${geometry_spec%%:*}
  geometry_bounds=${geometry_spec#*:}
  case "$geometry_key" in
    WIDTH|LINES) geometry_name="FUZZEL_${geometry_mode}_${output_class}_${geometry_key}" ;;
    *) geometry_name="FUZZEL_${output_class}_${geometry_key}" ;;
  esac
  eval "geometry_value=\${${geometry_name}-}"
  require_uint_range "$geometry_name" "$geometry_value" "${geometry_bounds%%:*}" "${geometry_bounds#*:}"
  # Assignment expansion does not re-evaluate the expanded value as shell code.
  eval "selected_${geometry_key}=\$geometry_value"
done
fuzzel_font="__THEME_FUZZEL_MENU_TEXT_FONT_FAMILY__:size=${selected_FONT_SIZE},__THEME_FUZZEL_MENU_EMOJI_FONT_FAMILY__:size=${selected_FONT_SIZE},__THEME_FUZZEL_MENU_ICON_FONT_FAMILY__:size=${selected_FONT_SIZE},__THEME_FUZZEL_MENU_NERD_FONT_FAMILY__:size=${selected_FONT_SIZE}"
set -- "--config=${fuzzel_config_dir}/${config_name}" "--font=${fuzzel_font}" \
  "--width=${selected_WIDTH}" "--lines=${selected_LINES}" \
  "--horizontal-pad=${selected_HORIZONTAL_PADDING}" "--vertical-pad=${selected_VERTICAL_PADDING}" \
  "--inner-pad=${selected_INNER_PADDING}" "--line-height=${selected_LINE_HEIGHT}" \
  "--border-width=${selected_BORDER_WIDTH}" "--border-radius=${selected_BORDER_RADIUS}" "$@"

runtime_root=${XDG_RUNTIME_DIR:-}
case "$runtime_root" in
  /*) ;;
  *)
    fatal 'XDG_RUNTIME_DIR must name an absolute Fuzzel runtime directory'
    ;;
esac
[ -d "$runtime_root" ] && [ -w "$runtime_root" ] || {
  fatal "Fuzzel runtime directory is unavailable: $runtime_root"
}

lock_path="${runtime_root%/}/labwc-fuzzel.lock"
pid_path="${runtime_root%/}/labwc-fuzzel.pid"
exec 8>"$lock_path"
if ! /usr/bin/flock -w 5 8; then
  fatal 'unable to acquire the Fuzzel launcher lock within five seconds'
fi

fuzzel_pid=
managed_dir=
raw_choices=
display_choices=
selection_file=
first_selection=

cleanup() {
  if [ -n "$fuzzel_pid" ]; then
    kill -TERM "$fuzzel_pid" >/dev/null 2>&1 || true
    wait "$fuzzel_pid" 2>/dev/null || true
    fuzzel_pid=
  fi
  rm -f -- "$pid_path"
  if [ -n "$managed_dir" ]; then
    rm -f -- "$raw_choices" "$display_choices" "$selection_file" "$first_selection"
    rmdir -- "$managed_dir" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

run_fuzzel() {
  exec 7<&0
  /usr/bin/fuzzel "$@" <&7 >&1 2>&2 7<&- 8>&- &
  fuzzel_pid=$!
  exec 7<&-
  printf '%s\n' "$fuzzel_pid" >"$pid_path"
  if wait "$fuzzel_pid"; then
    fuzzel_status=0
  else
    fuzzel_status=$?
  fi
  fuzzel_pid=
  rm -f -- "$pid_path"
  # Fuzzel uses 2 for dmenu cancellation and 1 for an error.
  # Keep the picker API (0 selection, 1 cancel, 2 failure) stable;
  # never conflate a configuration/Wayland error with a cancelled selection.
  if [ "$mode" = menu ]; then
    case "$fuzzel_status" in
      2) fuzzel_status=1 ;;
      1) fuzzel_status=$MENU_FAILURE_STATUS ;;
    esac
  fi
  return "$fuzzel_status"
}

log_managed_menu_selection() {
  selection_kind=$1
  selection_value=$2

  [ -x /usr/local/bin/labwc-fuzzel-log ] || return 0
  case "$selection_value" in
    '⮞ '*) selection_value=${selection_value#'⮞ '} ;;
    ' '*) selection_value=${selection_value#' '} ;;
  esac
  if ! /usr/local/bin/labwc-fuzzel-log \
      menu \
      selected \
      "source=$managed_log_scope" \
      "kind=$selection_kind" \
      "selection=$selection_value" \
      >/dev/null
  then
    :
  fi
}

log_fuzzel_lifecycle() {
  lifecycle_kind=$1
  lifecycle_event=$2
  lifecycle_status=$3

  [ -x /usr/local/bin/labwc-fuzzel-log ] || return 0
  /usr/local/bin/labwc-fuzzel-log \
    "$lifecycle_kind" \
    "$lifecycle_event" \
    "source=$managed_log_scope" \
    "mode=$mode" \
    "status=$lifecycle_status" \
    >/dev/null || true
}

if [ "$mode" != menu ] ||
   [ "$managed_icons" != 1 ] ||
   [ "$nul_delimited" = true ]; then
  case "$mode" in
    menu) lifecycle_kind=menu ;;
    *) lifecycle_kind=action ;;
  esac
  log_fuzzel_lifecycle "$lifecycle_kind" opened 0
  if run_fuzzel "$@"; then
    fuzzel_status=0
  else
    fuzzel_status=$?
  fi
  log_fuzzel_lifecycle "$lifecycle_kind" completed "$fuzzel_status"
  exit "$fuzzel_status"
fi

umask 077
managed_dir=$(mktemp -d "${runtime_root%/}/labwc-fuzzel-menu.XXXXXX") || {
  fatal 'unable to create managed Fuzzel runtime directory'
}
raw_choices="${managed_dir}/raw"
display_choices="${managed_dir}/display"
selection_file="${managed_dir}/selection"
first_selection="${managed_dir}/selection.first"

if ! LC_ALL=C awk '
  {
    input_bytes += length($0) + 1
    if (index($0, sprintf("%c", 0)) || index($0, sprintf("%c", 31)) || index($0, "\r")) exit 1
    if (NR > 1024 || length($0) > 4096 || input_bytes > 1048576) {
      exit 1
    }
    print
  }
' >"$raw_choices"; then
  fatal 'managed Fuzzel input exceeds bounds or contains protocol controls'
fi

awk -v root_menu="$managed_root_menu" -v menu_prompt="$managed_prompt" '
function icon_for(label) {
  if (label == "System & Recovery") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_CATEGORY_SYSTEM_RECOVERY_ICON_NAME__"
  if (label == "Network & Remote") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_CATEGORY_NETWORK_REMOTE_ICON_NAME__"
  if (label == "Security & Accounts") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_CATEGORY_SECURITY_ACCOUNTS_ICON_NAME__"
  if (label == "Devices & Desktop") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_CATEGORY_DEVICES_DESKTOP_ICON_NAME__"
  if (label == "Containers & AI") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_CATEGORY_CONTAINERS_AI_ICON_NAME__"
  if (label == "Files & Documents") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_CATEGORY_FILES_DOCUMENTS_ICON_NAME__"
  if (label == "Maintenance & Health") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_MAINTENANCE_HEALTH_ICON_NAME__"
  if (label == "Recovery & Repair") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_RECOVERY_REPAIR_ICON_NAME__"
  if (label == "Protection & Firewall") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_PROTECTION_FIREWALL_ICON_NAME__"
  if (label == "Users & Groups") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_USERS_GROUPS_ICON_NAME__"
  if (label == "Connection Profiles") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_CONNECTION_PROFILES_ICON_NAME__"
  if (label == "VPN Connections") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_VPN_CONNECTIONS_ICON_NAME__"
  if (label == "WireGuard Connections") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_WIREGUARD_CONNECTIONS_ICON_NAME__"
  if (label == "DNS Configuration") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_DNS_CONFIGURATION_ICON_NAME__"
  if (label == "Network Discovery") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_NETWORK_DISCOVERY_ICON_NAME__"
  if (label == "Remote Desktop") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_REMOTE_DESKTOP_ICON_NAME__"
  if (label == "Displays & Layout") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_DISPLAYS_LAYOUT_ICON_NAME__"
  if (label == "Refresh Display Layout") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_REFRESH_DISPLAY_LAYOUT_ICON_NAME__"
  if (label == "Power Profile") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_POWER_PROFILE_ICON_NAME__"
  if (label == "Hardware Tuning") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_HARDWARE_TUNING_ICON_NAME__"
  if (label == "Set Single Tuning Profile") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_SET_SINGLE_TUNING_PROFILE_ICON_NAME__"
  if (label == "Generate Hardware Tuning Report") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_GENERATE_HARDWARE_TUNING_REPORT_ICON_NAME__"
  if (label == "Start Automatic Tuning") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_START_AUTOMATIC_TUNING_ICON_NAME__"
  if (label == "Stop Automatic Tuning") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_STOP_AUTOMATIC_TUNING_ICON_NAME__"
  if (label == "Enable Autostart Tuning at Boot") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_ENABLE_AUTOSTART_TUNING_AT_BOOT_ICON_NAME__"
  if (label == "Disable Autostart Tuning at Boot") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_DISABLE_AUTOSTART_TUNING_AT_BOOT_ICON_NAME__"
  if (label == "Reset Hardware Tuning" || label == "Reset Profiles [All]") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_RESET_HARDWARE_TUNING_ICON_NAME__"
  if (label ~ /^Set Performance Profile \[(Intel|Nvidia)\]$/) return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_FALLBACK_UTILITIES_SYSTEM_MONITOR_ICON_NAME__"
  if (label ~ /^Set High Profile \[(Intel|Nvidia)\]$/) return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_FALLBACK_GO_UP_ICON_NAME__"
  if (label ~ /^Set Balanced Profile \[(Intel|Nvidia)\]$/) return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_FALLBACK_PREFERENCES_SYSTEM_POWER_MANAGEMENT_ICON_NAME__"
  if (label ~ /^Set Silent Profile \[(Intel|Nvidia)\]$/) return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_FALLBACK_BATTERY_ICON_NAME__"
  if (label == "Cancel - leave power policy unchanged") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_CANCEL_POWER_POLICY_ICON_NAME__"
  if (label == "Confirm: stop, disable and mask PPD; start tuning now and at boot" ||
      label == "Confirm: stop PPD and block its restart until tuning is stopped") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_CONFIRM_POWER_POLICY_ICON_NAME__"
  if (label == "Keyboard Layout") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_KEYBOARD_LAYOUT_ICON_NAME__"
  if (label == "Audio Control") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_AUDIO_CONTROL_ICON_NAME__"
  if (label == "Restart Dock") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_RESTART_DOCK_ICON_NAME__"
  if (label == "Android Devices") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_ANDROID_DEVICES_ICON_NAME__"
  if (label == "Bluetooth Devices") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_BLUETOOTH_DEVICES_ICON_NAME__"
  if (label == "Brightness") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_BRIGHTNESS_ICON_NAME__"
  if (label == "Containers") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_CONTAINERS_ICON_NAME__"
  if (label == "AI & Copilots") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_AI_COPILOTS_ICON_NAME__"
  if (label == "Documents & Media") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_DOCUMENTS_MEDIA_ICON_NAME__"
  if (label == "Drives & Backups") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_DRIVES_BACKUPS_ICON_NAME__"
  if (label == "Overview & Health") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_OVERVIEW_HEALTH_ICON_NAME__"
  if (label == "Services & Logs") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_SERVICES_LOGS_ICON_NAME__"
  if (label == "Packages & Firmware") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_PACKAGES_FIRMWARE_ICON_NAME__"
  if (label == "Storage & Filesystems") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_STORAGE_FILESYSTEMS_ICON_NAME__"
  if (label == "Audio & Desktop") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_AUDIO_DESKTOP_ICON_NAME__"
  if (label == "Network & DNS") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_NETWORK_DNS_ICON_NAME__"
  if (label == "Desktop & Services") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_DESKTOP_SERVICES_ICON_NAME__"
  if (label == "Packages & Boot") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_PACKAGES_BOOT_ICON_NAME__"
  if (label == "Snapshots & Storage") return "__THEME_FUZZEL_COMPUTER_MANAGEMENT_MENU_ACTION_SNAPSHOTS_STORAGE_ICON_NAME__"
