    (r'Network|DNS|Resolver|Connection|VPN|WireGuard|Nmap|Capture', ('__THEME_FZF_MANAGEMENT_TOPIC_NETWORK_ICON_GLYPH__', '__THEME_FZF_MANAGEMENT_TOPIC_NETWORK_ICON_COLOR__')),
