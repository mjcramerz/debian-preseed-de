    (r'Package|Upgrade|Initramfs|GRUB|Firmware', ('__THEME_FZF_MANAGEMENT_TOPIC_PACKAGE_ICON_GLYPH__', '__THEME_FZF_MANAGEMENT_TOPIC_PACKAGE_ICON_COLOR__')),
