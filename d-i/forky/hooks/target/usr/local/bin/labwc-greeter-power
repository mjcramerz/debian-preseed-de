#!/usr/bin/python3 -I

import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")

from gi.repository import GLib, Gtk, GtkLayerShell


ACTION_HELPER = "/usr/local/sbin/greetd-power-action"
CSS_PATH = "/etc/greetd/gtkgreet-power.css"


class GreeterPower:
    def __init__(self):
        self.pending_action = None
        self.buttons = {}
        self.action_process = None
        self.confirmation_timeout = None

        self.window = Gtk.Window()
        self.window.set_name("greeter-power")
        self.window.set_decorated(False)
        self.window.set_resizable(False)
        self.window.set_accept_focus(False)

        GtkLayerShell.init_for_window(self.window)
        GtkLayerShell.set_layer(self.window, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self.window, GtkLayerShell.Edge.RIGHT, True)
        GtkLayerShell.set_anchor(self.window, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_margin(self.window, GtkLayerShell.Edge.RIGHT, 32)
        GtkLayerShell.set_margin(self.window, GtkLayerShell.Edge.BOTTOM, 32)

        panel = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        panel.set_name("greeter-power-box")
        self.window.add(panel)

        panel.pack_start(
            self.create_button("reboot", "Reboot"),
            False,
            False,
            0,
        )
        panel.pack_start(
            self.create_button("poweroff", "Shutdown"),
            False,
            False,
            0,
        )

        self.load_css()
        self.window.connect("destroy", Gtk.main_quit)
        self.window.show_all()

    def create_button(self, action, label):
        button = Gtk.Button.new_with_label(label)
        button.get_style_context().add_class("greeter-power-button")
        button.get_style_context().add_class(
            "reboot" if action == "reboot" else "shutdown"
        )
        button.connect("clicked", self.request_action, action)
        self.buttons[action] = (button, label)
        return button

    def load_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_path(CSS_PATH)
        screen = self.window.get_screen()
        Gtk.StyleContext.add_provider_for_screen(
            screen,
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    def cancel_confirmation_timeout(self):
        if self.confirmation_timeout is not None:
            GLib.source_remove(self.confirmation_timeout)
            self.confirmation_timeout = None

    def reset_pending(self, expected_action=None):
        if expected_action is not None and self.pending_action != expected_action:
            return GLib.SOURCE_REMOVE

        if self.action_process is not None:
            return GLib.SOURCE_REMOVE
        self.cancel_confirmation_timeout()
        self.pending_action = None
        for button, label in self.buttons.values():
            button.set_label(label)
            button.set_sensitive(True)
            button.set_tooltip_text(None)
            button.get_style_context().remove_class("confirm")
        return GLib.SOURCE_REMOVE

    def show_failure(self, action, detail):
        self.reset_pending()
        button = self.buttons[action][0]
        button.set_label("Reboot failed" if action == "reboot" else "Shutdown failed")
        button.set_tooltip_text("The power request failed. Ask an administrator to check the greeter power log.")
        print(f"event=greeter_power_request action={action} status=failed {detail}",
              file=sys.stderr, flush=True)

    def request_action(self, button, action):
        if self.action_process is not None:
            return
        if self.pending_action != action:
            self.reset_pending()
            self.pending_action = action
            button.set_label(
                "Confirm reboot" if action == "reboot" else "Confirm shutdown"
            )
            button.get_style_context().add_class("confirm")
            self.confirmation_timeout = GLib.timeout_add_seconds(5, self.reset_pending, action)
            return

        # A stale confirmation timer must not clear a later failure message.
        self.cancel_confirmation_timeout()
        for current_button, _ in self.buttons.values():
            current_button.set_sensitive(False)
        button.set_label("Reboot queued" if action == "reboot" else "Shutdown queued")
        try:
            self.action_process = subprocess.Popen(
                [ACTION_HELPER, action],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                # Inherit greetd's journal stream so authorization/start errors
                # remain diagnosable without buffering privileged output.
                stderr=None,
                close_fds=True,
                start_new_session=True,
            )
        except OSError as error:
            self.show_failure(action, f"stage=spawn errno={error.errno}")
            return
        GLib.timeout_add(250, self.check_action)

    def check_action(self):
        result = self.action_process.poll()
        if result is None:
            return GLib.SOURCE_CONTINUE
        action = self.pending_action
        self.action_process = None
        # The fixed greeter frontend uses systemctl --wait: process exit means
        # the unit ended, not merely that it acknowledged a pending request.
        # Restore the buttons on errors AND administrator cancellation.
        if result:
            self.show_failure(action, f"stage=helper exit_status={result}")
        else:
            self.reset_pending()
        return GLib.SOURCE_REMOVE



if not os.path.isfile(ACTION_HELPER) or not os.access(ACTION_HELPER, os.X_OK):
    raise SystemExit("greetd power action helper is unavailable")

GreeterPower()
Gtk.main()
