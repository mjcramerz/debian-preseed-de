#!/bin/sh
set -eu

umask 077

fatal() {
  printf 'codex-standalone-install: fatal: %s\n' "$*" >&2
  exit 1
}

validate_absolute_path() {
  validation_label=$1
  validation_value=$2

  case "$validation_value" in
    /*) ;;
    *) fatal "$validation_label must be absolute: ${validation_value:-unset}" ;;
  esac
  case "$validation_value" in
    /|*//*|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._/@+-]*)
      fatal "$validation_label contains unsupported path syntax: $validation_value"
      ;;
  esac
  case "/${validation_value#/}/" in
    */./*|*/../*)
      fatal "$validation_label contains a traversal component: $validation_value"
      ;;
  esac
}

require_private_directory() {
  private_label=$1
  private_path=$2

  [ -d "$private_path" ] && [ ! -L "$private_path" ] ||
    fatal "$private_label is missing or indirect: $private_path"
  private_real=$(/usr/bin/readlink -f -- "$private_path") ||
    fatal "$private_label cannot be resolved: $private_path"
  [ "$private_real" = "$private_path" ] ||
    fatal "$private_label traverses a symlink: $private_path"
  private_owner=$(/usr/bin/stat -c '%u' -- "$private_path") ||
    fatal "$private_label owner cannot be read"
  private_mode=$(/usr/bin/stat -c '%a' -- "$private_path") ||
    fatal "$private_label mode cannot be read"
  [ "$private_owner" = "$installer_uid" ] && [ "$private_mode" = 700 ] ||
    fatal "$private_label must be account-owned with mode 0700: $private_path"
}

managed_binary_path() {
  managed_packages_root=$1
  for managed_candidate in \
    "$managed_packages_root/standalone/current/bin/codex" \
    "$managed_packages_root/standalone/current/codex"
  do
    if [ -f "$managed_candidate" ] && [ -x "$managed_candidate" ]; then
      printf '%s\n' "$managed_candidate"
      return 0
    fi
  done
  return 1
}

verify_managed_install() {
  verify_packages_root=$1
  verify_expected_version=$2

  [ -d "$verify_packages_root" ] && [ ! -L "$verify_packages_root" ] ||
    fatal "managed package root is missing or indirect: $verify_packages_root"
  verify_owner=$(/usr/bin/stat -c '%u' -- "$verify_packages_root") ||
    fatal "managed package root owner cannot be read"
  verify_mode=$(/usr/bin/stat -c '%a' -- "$verify_packages_root") ||
    fatal "managed package root mode cannot be read"
  [ "$verify_owner" = "$installer_uid" ] && [ "$verify_mode" = 700 ] ||
    fatal "managed package root must be account-owned with mode 0700"

  verify_binary=$(managed_binary_path "$verify_packages_root") ||
    fatal "managed standalone Codex binary is missing below $verify_packages_root"
  verify_real_binary=$(/usr/bin/readlink -f -- "$verify_binary") ||
    fatal "cannot resolve managed standalone Codex binary: $verify_binary"
  case "$verify_real_binary" in
    "$verify_packages_root"/standalone/releases/*/codex|\
    "$verify_packages_root"/standalone/releases/*/bin/codex) ;;
    *)
      fatal "managed standalone Codex binary resolves outside the package root: $verify_real_binary"
      ;;
  esac
  verify_version_output=$("$verify_binary" --version 2>/dev/null) ||
    fatal "managed standalone Codex version check failed"
  verify_actual_version=${verify_version_output##* }
  [ "$verify_actual_version" = "$verify_expected_version" ] ||
    fatal "managed standalone Codex version mismatch: expected $verify_expected_version, found ${verify_actual_version:-unknown}"
}

[ "$#" -eq 5 ] ||
  fatal 'usage: codex-standalone-install VERSION INSTALLER_URL MAXIMUM_BYTES CODEX_HOME PACKAGES_ROOT'

codex_version=$1
installer_url=$2
maximum_bytes=$3
expected_codex_home=$4
packages_root=$5
installer_uid=$(/usr/bin/id -u) || fatal 'cannot resolve the installer account identifier'

[ "$installer_uid" -ne 0 ] || fatal 'the standalone installer must run as the desktop account'
if ! printf '%s\n' "$codex_version" |
  /usr/bin/grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([+-][A-Za-z0-9.-]+)?$'
then
  fatal "Codex version is malformed: $codex_version"
fi
[ "$installer_url" = 'https://chatgpt.com/codex/install.sh' ] ||
  fatal "installer URL is not approved: $installer_url"
case "$maximum_bytes" in
  ''|*[!0123456789]*) fatal "installer byte limit is malformed: $maximum_bytes" ;;
esac
[ "$maximum_bytes" -gt 0 ] || fatal 'installer byte limit must be greater than zero'
[ "$maximum_bytes" -le 1048576 ] || fatal 'installer byte limit exceeds 1 MiB'
validate_absolute_path 'HOME' "${HOME:-}"
validate_absolute_path 'XDG_RUNTIME_DIR' "${XDG_RUNTIME_DIR:-}"
validate_absolute_path 'expected CODEX_HOME' "$expected_codex_home"
validate_absolute_path 'managed package root' "$packages_root"
# Provisioned by codex-installer-session.py inside the in-target mount view.
# Deliberately do not assume /run/user/<uid> exists during installation.
require_private_directory 'installer runtime directory' "$XDG_RUNTIME_DIR"
installer_runtime=$XDG_RUNTIME_DIR

codex_root=${expected_codex_home%/usr/home}
[ "$codex_root" != "$expected_codex_home" ] &&
  [ "$packages_root" = "$codex_root/packages" ] ||
  fatal 'CODEX_HOME and package root do not share the approved layout'

profile_path=${HOME}/.profile.d/71-devops-de.sh
[ -f "$profile_path" ] && [ ! -L "$profile_path" ] ||
  fatal "managed DevOps profile is missing or indirect: $profile_path"
profile_uid=$(/usr/bin/stat -c '%u' -- "$profile_path")
profile_mode=$(/usr/bin/stat -c '%a' -- "$profile_path")
[ "$profile_uid" = "$installer_uid" ] ||
  fatal 'managed DevOps profile is not account-owned'
case "$profile_mode" in
  [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) ;;
  *) fatal 'managed DevOps profile mode is malformed' ;;
esac
profile_mode_value=$((0$profile_mode))
[ $((profile_mode_value & 0022)) -eq 0 ] ||
  fatal 'managed DevOps profile is writable by group or other users'

# shellcheck disable=SC1090
. "$profile_path"
command -v devops_de_apply_environment >/dev/null 2>&1 ||
  fatal 'managed DevOps environment function is unavailable'
devops_de_apply_environment || fatal 'managed DevOps environment activation failed'
# A sourced login profile must not redirect installer scratch into a session
# directory that is unavailable during d-i or belongs to another process.
XDG_RUNTIME_DIR=$installer_runtime
TMPDIR=$installer_runtime
export XDG_RUNTIME_DIR TMPDIR
require_private_directory 'installer runtime directory' "$installer_runtime"
[ "${CODEX_HOME:-}" = "$expected_codex_home" ] ||
  fatal "managed DevOps profile exported an unexpected CODEX_HOME: ${CODEX_HOME:-unset}"

source_packages=${CODEX_HOME}/packages
install_packages=$source_packages
prelinked=0
if [ -L "$source_packages" ]; then
  [ "$(/usr/bin/readlink -- "$source_packages")" = "$packages_root" ] ||
    fatal "CODEX_HOME package link has an unexpected target: $source_packages"
  if managed_binary_path "$packages_root" >/dev/null 2>&1; then
    verify_managed_install "$packages_root" "$codex_version"
    exit 0
  fi
  require_private_directory 'managed package root' "$packages_root"
  [ -z "$(/usr/bin/find "$packages_root" -mindepth 1 -maxdepth 1 -print -quit)" ] ||
    fatal "managed package root is not empty before official installation"
  install_packages=$packages_root
  prelinked=1
else
  if [ -e "$packages_root" ] || [ -L "$packages_root" ]; then
    fatal "managed package root exists without the required CODEX_HOME link: $packages_root"
  fi
  if [ -e "$source_packages" ]; then
    [ -d "$source_packages" ] && [ ! -L "$source_packages" ] ||
      fatal "CODEX_HOME package path is not a direct directory: $source_packages"
    [ -z "$(/usr/bin/find "$source_packages" -mindepth 1 -maxdepth 1 -print -quit)" ] ||
      fatal "CODEX_HOME package path is not empty before official installation"
  fi
fi

installer_script=
installer_home=
installer_link=
relocated=0
cleanup() {
  cleanup_status=$?
  trap - 0 HUP INT TERM
  if [ -n "$installer_script" ] && [ -f "$installer_script" ] && [ ! -L "$installer_script" ]; then
    /bin/rm -f -- "$installer_script" || cleanup_status=1
  fi
  if [ -n "$installer_home" ] && [ -d "$installer_home" ] && [ ! -L "$installer_home" ]; then
    case "$installer_home" in
      "$XDG_RUNTIME_DIR"/codex-installer-home.*)
        /bin/rm -rf -- "$installer_home" || cleanup_status=1
        ;;
      *) cleanup_status=1 ;;
    esac
  fi
  if [ -n "$installer_link" ] && [ -L "$installer_link" ]; then
    /bin/rm -f -- "$installer_link" || cleanup_status=1
  fi
  if [ "$cleanup_status" -ne 0 ] && [ "$relocated" -eq 1 ] &&
     [ -d "$packages_root" ] && [ ! -e "$source_packages" ]; then
    /bin/mv -- "$packages_root" "$source_packages" || true
  fi
  exit "$cleanup_status"
}
trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

installer_script=$(/usr/bin/mktemp "${XDG_RUNTIME_DIR}/codex-install.XXXXXXXX") ||
  fatal 'cannot allocate the official installer download file'
installer_home=$(/usr/bin/mktemp -d "${XDG_RUNTIME_DIR}/codex-installer-home.XXXXXXXX") ||
  fatal 'cannot allocate the isolated installer home'
/bin/chmod 0600 -- "$installer_script"
/bin/chmod 0700 -- "$installer_home"

/usr/bin/curl \
  --fail \
  --silent \
  --show-error \
  --location \
  --proto '=https' \
  --proto-redir '=https' \
  --tlsv1.2 \
  --retry 3 \
  --retry-delay 2 \
  --connect-timeout 15 \
  --max-time 300 \
  --max-filesize "$maximum_bytes" \
  --output "$installer_script" \
  "$installer_url" || fatal 'failed to download the official Codex installer'
installer_bytes=$(/usr/bin/wc -c <"$installer_script" | /usr/bin/tr -d '[:space:]')
case "$installer_bytes" in
  ''|*[!0123456789]*|0) fatal 'official installer download is empty' ;;
esac
[ "$installer_bytes" -le "$maximum_bytes" ] ||
  fatal 'official installer exceeds the configured byte limit'

installer_bin=${install_packages}/.installer-bin
PATH="${installer_bin}:${PATH}"
export PATH
HOME="$installer_home" \
CODEX_HOME="$CODEX_HOME" \
CODEX_INSTALL_DIR="$installer_bin" \
CODEX_NON_INTERACTIVE=1 \
CODEX_RELEASE="$codex_version" \
CODEX_INSTALLER_USE_RELEASES_OPENAI_COM=true \
  /bin/sh "$installer_script" --release "$codex_version"

[ -d "$install_packages" ] && [ ! -L "$install_packages" ] ||
  fatal 'official installer did not create a direct managed package directory'
/bin/rm -rf -- "$installer_bin"
/bin/chmod 0700 -- "$install_packages"
verify_managed_install "$install_packages" "$codex_version"

if [ "$prelinked" -eq 1 ]; then
  verify_managed_install "$packages_root" "$codex_version"
  exit 0
fi

installer_link=${CODEX_HOME}/.packages-link.$$
[ ! -e "$installer_link" ] && [ ! -L "$installer_link" ] ||
  fatal 'temporary package link path already exists'
/bin/ln -s -- "$packages_root" "$installer_link"
/bin/mv -- "$source_packages" "$packages_root"
relocated=1
/bin/mv -- "$installer_link" "$source_packages"
installer_link=
/bin/chmod 0700 -- "$packages_root"
verify_managed_install "$packages_root" "$codex_version"
relocated=0
