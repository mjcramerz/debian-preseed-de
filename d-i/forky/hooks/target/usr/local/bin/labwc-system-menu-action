def main(argv: list[str]) -> int:
    if len(argv) != 1 or (argv[0] not in COMMANDS and argv[0] != 'display_wlsunset_toggle'):
        raise MenuError('unsupported system menu action')
    env = desktop_environment()
    if argv[0] == 'display_wlsunset_toggle':
        active = subprocess.run(['/usr/bin/systemctl', '--user', 'is-active', '--quiet',
                                 'labwc-wlsunset.service'], env=env, check=False,
                                stdin=subprocess.DEVNULL, timeout=15).returncode == 0
        command = ('/usr/local/bin/labwc-wlsunset', 'stop' if active else 'start')
        result = subprocess.run(command, env=env, cwd=env['HOME'], stdin=subprocess.DEVNULL,
                                check=False, timeout=60)
        if result.returncode == 0:
            notify_success(argv[0], env)
        return result.returncode
    # Interactive delegates keep the transient service as their lifecycle
    # owner. Replacing the dispatcher avoids an arbitrary timeout closing a
    # reminder editor or a picker while the user is still using it.
    if argv[0] not in {'audio_mute', 'audio_mic_mute', 'notifications_dnd_on',
                       'notifications_dnd_off', 'display_night_light_enable',
                       'display_night_light_disable'}:
        os.chdir(env['HOME'])
        os.execvpe(COMMANDS[argv[0]][0], COMMANDS[argv[0]], env)
    process = subprocess.run(COMMANDS[argv[0]], env=env, cwd=env['HOME'],
                             stdin=subprocess.DEVNULL, check=False, timeout=30)
    if process.returncode == 0:
        notify_success(argv[0], env)
    return process.returncode


if __name__ == '__main__':
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (MenuError, OSError, subprocess.SubprocessError) as error:
        print('labwc-system-menu-action: ' + str(error), file=sys.stderr)
        raise SystemExit(1)
