#!/usr/bin/python3 -IB
"""Run one reviewed Waybar system-menu action inside its transient service."""
from __future__ import annotations

import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import sys

WAYLAND_APP = '/usr/local/bin/labwc-wayland-app'
TERMINAL = '/usr/local/bin/labwc-terminal'
NOTIFY_SEND = '/usr/bin/notify-send'
TIMEOUT = '/usr/bin/timeout'


class MenuError(Exception):
    pass


def desktop_environment() -> dict[str, str]:
    uid = os.getuid()
    if uid == 0 or os.geteuid() != uid or os.environ.get('LABWC_SESSION_OWNER') != 'desktop':
        raise MenuError('system menu requires the ordinary desktop account')
    home = Path(pwd.getpwuid(uid).pw_dir)
    runtime = Path('/run/user') / str(uid)
    info = runtime.lstat()
    bus = runtime / 'bus'
    bus_info = bus.lstat()
    display = os.environ.get('WAYLAND_DISPLAY', '')
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != uid or (info.st_mode & 0o077)
            or not stat_is_socket(bus_info.st_mode) or bus_info.st_uid != uid
            or bus_info.st_nlink != 1 or not re.fullmatch(r'wayland-[0-9]+', display)):
        raise MenuError('owned desktop runtime is unavailable')
    return {
        'PATH': '/usr/local/bin:/usr/bin:/bin',
        'HOME': str(home),
        'LANG': 'C.UTF-8',
        'LC_ALL': 'C.UTF-8',
        'XDG_RUNTIME_DIR': str(runtime),
        'DBUS_SESSION_BUS_ADDRESS': f'unix:path={runtime}/bus',
        'XDG_CONFIG_HOME': str(home / '.config'),
        'XDG_DATA_HOME': str(home / '.local/share'),
        'WAYLAND_DISPLAY': display,
        'XDG_SESSION_TYPE': 'wayland',
        'GDK_BACKEND': 'wayland',
        'LABWC_SESSION_OWNER': 'desktop',
        'NO_AT_BRIDGE': '1',
        'GTK_A11Y': 'none',
    }


def stat_is_socket(mode: int) -> bool:
    return (mode & 0o170000) == 0o140000


def wayland(*argv: str) -> tuple[str, ...]:
    return (WAYLAND_APP, 'auto', '--', *argv)


def terminal(*argv: str) -> tuple[str, ...]:
    return (TERMINAL, *argv)


def notify(env: dict[str, str], summary: str, body: str) -> None:
    """Best-effort low urgency feedback; never change the action result."""
    if not os.access(NOTIFY_SEND, os.X_OK) or not os.access(TIMEOUT, os.X_OK):
        return
    if not env.get('DBUS_SESSION_BUS_ADDRESS'):
        return
    try:
        subprocess.run(
            [TIMEOUT, '--kill-after=1s', '3s', NOTIFY_SEND,
             '--app-name=Labwc desktop', '--urgency=low',
             '--category=desktop.toggle', '--', summary, body],
            env=env, cwd=env['HOME'], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            check=False, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def dnd_state(env: dict[str, str]) -> bool | None:
    try:
        result = subprocess.run(
            ['/usr/bin/makoctl', 'mode'], env=env, cwd=env['HOME'],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, text=True, encoding='utf-8',
            errors='replace', check=False, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    return 'do-not-disturb' in result.stdout.splitlines()


def audio_muted(env: dict[str, str], target: str) -> bool | None:
    try:
        result = subprocess.run(
            ['/usr/bin/wpctl', 'get-volume', target], env=env, cwd=env['HOME'],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, text=True, encoding='utf-8',
            errors='replace', check=False, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return '[MUTED]' in result.stdout.split()


def wlsunset_state(env: dict[str, str]) -> bool | None:
    try:
        result = subprocess.run(
            ['/usr/bin/systemctl', '--user', 'is-active', '--quiet',
             'labwc-wlsunset.service'], env=env, cwd=env['HOME'],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, check=False, timeout=15,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return result.returncode == 0


def notify_success(action: str, env: dict[str, str]) -> None:
    """Report only actions whose state is known here and not in their owner."""
    if action == 'audio_mute':
        state = audio_muted(env, '@DEFAULT_AUDIO_SINK@')
        body = ('Audio output is now muted.' if state else
                'Audio output is now unmuted.' if state is False else
                'Audio output mute changed; the current state could not be read.')
        notify(env, 'Audio output mute changed', body)
    elif action == 'audio_mic_mute':
        state = audio_muted(env, '@DEFAULT_AUDIO_SOURCE@')
        body = ('Microphone is now muted.' if state else
                'Microphone is now unmuted.' if state is False else
                'Microphone mute changed; the current state could not be read.')
        notify(env, 'Microphone mute changed', body)
    elif action in {'notifications_dnd', 'notifications_dnd_on', 'notifications_dnd_off'}:
        state = dnd_state(env)
        body = ('Do not disturb is enabled.' if state else
                'Do not disturb is disabled.' if state is False else
                'Do not disturb changed; the current state could not be read.')
        notify(env, 'Notification mode changed', body)
    elif action in {'display_night_light_enable', 'display_night_light_disable',
                    'display_wlsunset_toggle'}:
        state = wlsunset_state(env)
        if action == 'display_night_light_enable':
            body = ('Night Light is enabled.' if state else
                    'Night Light enable request completed; the service is not active yet.'
                    if state is False else
                    'Night Light enable request completed; the service state could not be read.')
        elif action == 'display_night_light_disable':
            body = ('Night Light is disabled.' if state is False else
                    'Night Light disable request completed; the service state could not be confirmed.')
        else:
            body = ('Night Light is enabled.' if state else
                    'Night Light is disabled.' if state is False else
                    'Night Light toggle completed; the service state could not be read.')
        notify(env, 'Night Light state changed', body)


