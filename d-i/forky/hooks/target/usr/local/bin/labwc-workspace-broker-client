#!/usr/bin/perl -T
use strict;
use warnings;
use lib '/usr/local/lib/labwc-workspace-broker/perl5';
use Labwc::WorkspaceBroker::Client ();
$ENV{PATH} = '/usr/local/bin:/usr/bin:/bin';
delete @ENV{qw(IFS CDPATH ENV BASH_ENV PERL5LIB PERLLIB PERL5OPT PYTHONPATH PYTHONHOME)};
my $result = eval { Labwc::WorkspaceBroker::Client::run(@ARGV) };
if ($@) { warn "workspace broker client: $@"; exit 1; }
exit($result // 0);
