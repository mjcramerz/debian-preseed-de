#!/usr/bin/python3 -IB
"""Wayland screenshot and recording lifecycle controller.

The compositor, PipeWire, wf-recorder, satty, and the user systemd manager
remain authoritative. This process validates their operands and coordinates
bounded actions; it does not open display or audio devices itself.
"""
from __future__ import annotations

import json
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import tempfile
import time

import labwc_desktop_runtime as desktop_runtime

APP_NAME = "Screen Capture"
RECORDING_UNIT = "labwc-screen-recording.service"
NOTIFY_SEND = "/usr/bin/notify-send"
PICKER = "/usr/local/bin/labwc-fuzzel"
SYSTEMCTL = "/usr/bin/systemctl"
SYSTEMD_RUN = "/usr/bin/systemd-run"
GRIM = "/usr/bin/grim"
SLURP = "/usr/bin/slurp"
SATTY = "/usr/local/bin/satty"
WLR_RANDR = "/usr/bin/wlr-randr"
WF_RECORDER = "/usr/bin/wf-recorder"
FFPROBE = "/usr/bin/ffprobe"
ERROR_ICON = "__THEME_MAKO_SCREEN_CAPTURE_ERROR_ICON_NAME__"
RECORDING_LOG = "__INSTALLER_LOG_APPLICATIONS_FILE__"

GEOMETRY = re.compile(r"^-?[0-9]+,-?[0-9]+ [1-9][0-9]*x[1-9][0-9]*$")
SAFE_NAME = re.compile(r"^[A-Za-z0-9._-]+$")

HOME: Path
RUNTIME: Path
STATE_DIR: Path
SCREENSHOT_DIR: Path
RECORDING_DIR: Path
SATTY_CONFIG: Path
PIPEWIRE_REMOTE_NAME: str
DESKTOP_UID: int


class CaptureError(RuntimeError):
    pass


def fatal(message: str, status: int = 1) -> int:
    print(f"fatal: {message}", file=sys.stderr)
    return status


def run(argv: list[str], *, input_text: str | None = None, capture: bool = False,
        timeout: float | None = None, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    return desktop_runtime.run(argv, input_text=input_text, capture=capture, timeout=timeout,
                               env=dict(os.environ, **(env or {})))


def picker(rows: list[str], prompt: str) -> str | None:
    result = run(
        [PICKER, "menu", "--dmenu", "--prompt", prompt],
        input_text="".join(f"{row}\n" for row in rows),
        capture=True,
        timeout=120,
        env={"LABWC_MENU_ACTION_WAIT": "1"},
    )
    if result.returncode == 1:
        return None
    if result.returncode == 3:
        raise SystemExit(3)
    if result.returncode:
        raise CaptureError(f"menu picker failed (status {result.returncode})")
    selected = result.stdout.rstrip("\n")
    return selected if selected in rows else None


def notify(urgency: str, icon: str, category: str, summary: str, body: str) -> None:
    if not os.access(NOTIFY_SEND, os.X_OK) or not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        return
    try:
        run([NOTIFY_SEND, "-a", APP_NAME, "-u", urgency, "-i", icon,
             "-c", category, summary, body], timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        pass


def require_command(path: str, label: str | None = None) -> None:
    if not os.access(path, os.X_OK):
        notify("critical", ERROR_ICON, "x-labwc.screen-capture", "Screen capture unavailable",
               f"{label or path} is not installed.")
        raise CaptureError(f"required command is unavailable: {label or path}")


def safe_path(label: str, value: str) -> Path:
    if not value.startswith("/") or value == "/" or ".." in value or "//" in value:
        raise CaptureError(f"{label} contains unsupported path syntax")
    if not re.fullmatch(r"/[A-Za-z0-9._/@%:+,=-]+", value):
        raise CaptureError(f"{label} contains unsupported path syntax")
    return Path(value)


def ensure_desktop_user() -> None:
    global DESKTOP_UID, HOME, RUNTIME
    if os.environ.get("LABWC_SESSION_OWNER") != "desktop":
        raise CaptureError("labwc-capture must run in the managed desktop session")
    DESKTOP_UID = os.getuid()
    if DESKTOP_UID == 0:
        raise CaptureError("labwc-capture requires a non-root desktop runtime directory")
    RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", ""))
    if RUNTIME != Path("/run/user") / str(DESKTOP_UID):
        raise CaptureError("labwc-capture requires the current desktop runtime directory")
    HOME = safe_path("HOME", os.environ.get("HOME", ""))


def initialize_paths() -> None:
    global STATE_DIR, SCREENSHOT_DIR, RECORDING_DIR, SATTY_CONFIG, PIPEWIRE_REMOTE_NAME
    try:
        metadata = RUNTIME.stat(follow_symlinks=False)
    except OSError as error:
        raise CaptureError("XDG_RUNTIME_DIR is unavailable or unsafe") from error
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != DESKTOP_UID or stat.S_IMODE(metadata.st_mode) != 0o700:
        raise CaptureError("XDG_RUNTIME_DIR is unavailable or unsafe")
    state_home = safe_path("XDG_STATE_HOME", os.environ.get("XDG_STATE_HOME", str(HOME / ".local/state")))
    config_home = safe_path("XDG_CONFIG_HOME", os.environ.get("XDG_CONFIG_HOME", str(HOME / ".config")))
    PIPEWIRE_REMOTE_NAME = os.environ.get("PIPEWIRE_REMOTE", "pipewire-0")
    if not SAFE_NAME.fullmatch(PIPEWIRE_REMOTE_NAME):
        raise CaptureError("PIPEWIRE_REMOTE contains unsupported syntax")
    STATE_DIR = RUNTIME / "labwc-capture"
    SCREENSHOT_DIR = HOME / "Pictures/Screenshots"
    RECORDING_DIR = HOME / "Videos/Recordings"
    SATTY_CONFIG = config_home / "satty/config.toml"
    for directory in (STATE_DIR, SCREENSHOT_DIR, RECORDING_DIR):
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        metadata = directory.stat(follow_symlinks=False)
        if (not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != DESKTOP_UID
                or stat.S_IMODE(metadata.st_mode) != 0o700):
            raise CaptureError(f"capture directory has unsafe metadata: {directory}")
    # Keep state-home validation part of the contract even though state is in
    # the runtime directory; the configured path is passed to the worker.
    safe_path("XDG_STATE_HOME", str(state_home))


def require_wayland() -> None:
    display = os.environ.get("WAYLAND_DISPLAY", "")
    if not display or not SAFE_NAME.fullmatch(display):
        raise CaptureError("WAYLAND_DISPLAY must name the active Wayland socket")
    socket_path = RUNTIME / display
    try:
        metadata = socket_path.lstat()
    except OSError as error:
        notify("critical", ERROR_ICON, "x-labwc.screen-capture", "Screen capture unavailable",
               "The active Wayland socket could not be found.")
        raise CaptureError("active Wayland socket is unavailable") from error
    if not stat.S_ISSOCK(metadata.st_mode) or metadata.st_uid != DESKTOP_UID or metadata.st_nlink != 1 or stat.S_IMODE(metadata.st_mode) not in {0o600, 0o660, 0o700}:
        raise CaptureError("active Wayland socket has unsafe ownership or mode")


def recording_active() -> bool:
    try:
        return run([SYSTEMCTL, "--user", "--quiet", "is-active", RECORDING_UNIT], timeout=5).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def print_status() -> None:
    if recording_active():
        value = {"text": "__THEME_WAYBAR_BUTTON_SCREENSHOT_RECORDING_ICON_GLYPH__", "tooltip": "Screen recording is active\nLeft-click: select an area and annotate\nMiddle-click: stop and save recording\nRight-click: capture and recording actions", "class": "recording"}
    else:
        value = {"text": "__THEME_WAYBAR_BUTTON_SCREENSHOT_IDLE_ICON_GLYPH__", "tooltip": "Left-click: select an area and annotate\nMiddle-click: stop an active recording\nRight-click: screenshots and recordings", "class": "idle"}
    print(json.dumps(value, ensure_ascii=False))


def next_output_path(directory: Path, prefix: str, extension: str) -> Path:
    timestamp = time.strftime("%Y-%m-%d_%H-%M-%S")
    for counter in range(1000):
        suffix = "" if counter == 0 else f"_{counter}"
        candidate = directory / f"{prefix}_{timestamp}{suffix}.{extension}"
        try:
            descriptor = os.open(candidate, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_CLOEXEC, 0o600)
        except FileExistsError:
            continue
        os.close(descriptor)
        return candidate
    raise CaptureError("unable to allocate a unique output filename")


def select_geometry() -> str | None:
    require_command(SLURP, "slurp")
    try:
        result = run([SLURP], capture=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    geometry = result.stdout.rstrip("\n")
    if result.returncode or not geometry:
        return None
    if len(geometry) > 128 or not GEOMETRY.fullmatch(geometry):
        notify("critical", ERROR_ICON, "x-labwc.screen-capture", "Selection rejected", "The selected geometry was invalid.")
        return None
    return geometry


def capture_full() -> int:
    require_wayland()
    require_command(GRIM, "grim")
    path = next_output_path(SCREENSHOT_DIR, "Screenshot", "png")
    try:
        result = run([GRIM, str(path)], timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        result = None
    if result is not None and result.returncode == 0:
        notify("normal", "camera-photo", "x-labwc.screen-capture", "Screenshot saved", str(path))
        return 0
    path.unlink(missing_ok=True)
    notify("critical", ERROR_ICON, "x-labwc.screen-capture", "Screenshot failed", "The full-screen capture could not be created.")
    return 1


def satty_config_ok() -> bool:
    try:
        metadata = SATTY_CONFIG.lstat()
    except OSError:
        return False
    return (stat.S_ISREG(metadata.st_mode) and metadata.st_uid == DESKTOP_UID and metadata.st_nlink == 1
            and stat.S_IMODE(metadata.st_mode) in {0o400, 0o600})


def annotate_capture(scope: str) -> int:
    require_wayland()
    require_command(GRIM, "grim")
    require_command(SATTY, "satty")
    if not satty_config_ok():
        notify("critical", ERROR_ICON, "x-labwc.screen-capture", "Satty configuration rejected", f"{SATTY_CONFIG} has unsafe ownership or mode.")
        return 1
    output = next_output_path(SCREENSHOT_DIR, "Screenshot", "png")
    source_fd, source_name = tempfile.mkstemp(prefix="satty-source.", suffix=".png", dir=STATE_DIR)
    os.close(source_fd)
    source = Path(source_name)
    try:
        geometry = None
        if scope == "box":
            geometry = select_geometry()
            if not geometry:
                return 0
        elif scope != "full":
            raise CaptureError(f"unsupported annotation scope: {scope}")
        command = [GRIM]
        if geometry:
            command += ["-g", geometry]
        command.append(str(source))
        try:
            result = run(command, timeout=120)
        except (OSError, subprocess.TimeoutExpired):
            result = None
        if result is None or result.returncode:
            notify("critical", ERROR_ICON, "x-labwc.screen-capture", "Screenshot failed", "The annotation source could not be captured.")
            return 1
        try:
            result = run([SATTY, "--config", str(SATTY_CONFIG), "--filename", str(source), "--output-filename", str(output)], timeout=900)
        except (OSError, subprocess.TimeoutExpired):
            result = None
        if result is not None and result.returncode == 0:
            if output.is_file() and output.stat().st_size > 0:
                notify("normal", "camera-photo", "x-labwc.screen-capture", "Annotated screenshot saved", str(output))
            else:
                notify("normal", "camera-photo", "x-labwc.screen-capture", "Annotation closed", "No annotated screenshot was saved.")
            return 0
        notify("critical", ERROR_ICON, "x-labwc.screen-capture", "Satty failed", "The annotation tool exited with an error.")
        return 1
    finally:
        source.unlink(missing_ok=True)
        if not output.is_file() or output.stat().st_size == 0:
            output.unlink(missing_ok=True)


def select_recording_format() -> str | None:
    selected = picker(["Local - mkv", "Share - mp4", "Website - webm"], "Recording format")
    return {"Local - mkv": "mkv", "Share - mp4": "mp4", "Website - webm": "webm"}.get(selected)


def select_recording_output() -> str | None:
    require_command(WLR_RANDR, "wlr-randr")
    try:
        result = run([WLR_RANDR], capture=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return None
    outputs = sorted({line.split()[0] for line in result.stdout.splitlines() if line and not line[0].isspace() and SAFE_NAME.fullmatch(line.split()[0])})
    if not outputs:
        notify("critical", ERROR_ICON, "x-labwc.screen-recording", "Recording output unavailable", "No active Wayland output could be detected.")
        return None
    return outputs[0] if len(outputs) == 1 else picker(outputs, "Recording output")


def require_pipewire_audio() -> None:
    socket_path = RUNTIME / PIPEWIRE_REMOTE_NAME
    try:
        metadata = socket_path.lstat()
    except OSError as error:
        raise CaptureError(f"PipeWire socket is unavailable: {socket_path}") from error
    if not stat.S_ISSOCK(metadata.st_mode) or metadata.st_uid != DESKTOP_UID or metadata.st_nlink != 1:
        raise CaptureError(f"PipeWire socket is unavailable: {socket_path}")


def start_recording(scope: str) -> int:
    require_wayland()
    require_command(SYSTEMD_RUN, "systemd-run")
    require_command(WF_RECORDER, "wf-recorder")
    require_pipewire_audio()
    if recording_active():
        notify("normal", "media-record", "x-labwc.screen-recording", "Recording already active", "Stop the current recording before starting another.")
        return 0
    recording_format = select_recording_format()
    if not recording_format:
        return 0
    output = "-"
    geometry = "-"
    if scope == "box":
        geometry = select_geometry()
        if not geometry:
            return 0
    elif scope == "full":
        output = select_recording_output()
        if not output:
            return 0
    else:
        raise CaptureError(f"unsupported recording scope: {scope}")
    path = next_output_path(RECORDING_DIR, "Recording", recording_format)
    try:
        run_args = [SYSTEMD_RUN, "--user", "--quiet", "--collect", f"--unit={RECORDING_UNIT}", "--property=Type=exec", "--property=PartOf=labwc-session.target", "--property=Requisite=labwc-session.target", "--property=After=labwc-session.target", f"--property=ConditionPathExists=!{RUNTIME}/labwc-session-closing", "--property=ExitType=cgroup", "--property=KillMode=control-group", "--property=KillSignal=SIGINT", "--property=TimeoutStopSec=20s", "--property=UMask=0077", "--property=StandardInput=null", "--property=StandardOutput=null", "--property=StandardError=null", "--property=SyslogIdentifier=labwc-screen-recording", f"--setenv=HOME={HOME}", f"--setenv=PATH={os.environ.get('PATH', '/usr/local/bin:/usr/bin:/bin')}", f"--setenv=LABWC_SESSION_OWNER={os.environ.get('LABWC_SESSION_OWNER', '')}", f"--setenv=WAYLAND_DISPLAY={os.environ.get('WAYLAND_DISPLAY', '')}", f"--setenv=XDG_CONFIG_HOME={os.environ.get('XDG_CONFIG_HOME', HOME / '.config')}", f"--setenv=XDG_RUNTIME_DIR={RUNTIME}", f"--setenv=XDG_STATE_HOME={os.environ.get('XDG_STATE_HOME', HOME / '.local/state')}", f"--setenv=DBUS_SESSION_BUS_ADDRESS={os.environ.get('DBUS_SESSION_BUS_ADDRESS', '')}", f"--setenv=PIPEWIRE_REMOTE={PIPEWIRE_REMOTE_NAME}", "/usr/local/libexec/rsyslog-app-run", "labwc-screen-recording", "--", "/usr/local/bin/labwc-capture", "record-worker", scope, recording_format, str(path), output, geometry]
        try:
            created = run(run_args, timeout=15)
        except (OSError, subprocess.TimeoutExpired):
            created = None
        if created is None or created.returncode:
            path.unlink(missing_ok=True)
            notify("critical", ERROR_ICON, "x-labwc.screen-recording", "Recording failed to start", "The transient user recording service could not be created.")
            return 1
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            if recording_active():
                notify("normal", "media-record", "x-labwc.screen-recording", "Screen recording started", "Audio is enabled. Stop the recording from the screenshot menu.")
                return 0
            time.sleep(1)
        notify("critical", ERROR_ICON, "x-labwc.screen-recording", "Recording failed to start", f"wf-recorder did not remain active. Details were written to {RECORDING_LOG}.")
        return 1
    except BaseException:
        path.unlink(missing_ok=True)
        raise


def stop_recording() -> int:
    if not recording_active():
        notify("normal", "media-record", "x-labwc.screen-recording", "No active recording", "There is no screen recording to stop.")
        return 0
    notify("normal", "media-record", "x-labwc.screen-recording", "Stopping screen recording", "The recording is being finalized.")
    try:
        result = run([SYSTEMCTL, "--user", "stop", RECORDING_UNIT], timeout=25)
    except (OSError, subprocess.TimeoutExpired):
        result = None
    if result is None or result.returncode:
        notify("critical", ERROR_ICON, "x-labwc.screen-recording", "Recording stop failed", "The recording service could not be stopped cleanly.")
        return 1
    return 0


def recording_worker(scope: str, fmt: str, path_text: str, output: str, geometry: str) -> int:
    require_wayland()
    require_command(WF_RECORDER, "wf-recorder")
    require_pipewire_audio()
    path = safe_path("recording output", path_text)
    if scope not in {"full", "box"}:
        raise CaptureError("unsupported recording worker scope")
    codecs = {"mkv": ("matroska", "libx264", "aac"), "mp4": ("mp4", "libx264", "aac"), "webm": ("webm", "libvpx-vp9", "libopus")}
    if fmt not in codecs or path.parent != RECORDING_DIR or not re.fullmatch(r"Recording_[A-Za-z0-9_-]+\." + re.escape(fmt), path.name):
        raise CaptureError("recording output does not match the selected format")
    muxer, video_codec, audio_codec = codecs[fmt]
    if scope == "full":
        if output == "-" or not SAFE_NAME.fullmatch(output) or geometry != "-":
            raise CaptureError("full-screen recording operands are invalid")
    elif output != "-" or not GEOMETRY.fullmatch(geometry):
        raise CaptureError("box recording operands are invalid")
    command = [WF_RECORDER, "--audio", "--audio-backend=pipewire", "--muxer", muxer, "--codec", video_codec, "--audio-codec", audio_codec, "--file", str(path)]
    command += ["--geometry", geometry] if scope == "box" else ["--output", output]
    process = subprocess.Popen(command, stdin=subprocess.DEVNULL, close_fds=True)
    stopping = False
    previous_handlers: dict[int, object] = {}
    def forward(signum: int, _frame: object) -> None:
        nonlocal stopping
        stopping = True
        try:
            process.send_signal(signal.SIGINT)
        except OSError:
            pass
    for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        previous_handlers[signum] = signal.signal(signum, forward)
    try:
        status = process.wait()
    finally:
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)
    duration_text = ""
    if status == 0 and path.is_file() and path.stat().st_size > 0:
        try:
            probe = run([FFPROBE, "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=codec_type:format=duration", "-of", "default=noprint_wrappers=1", str(path)], capture=True, timeout=15)
            duration_text = probe.stdout
        except (OSError, subprocess.TimeoutExpired):
            duration_text = ""
    valid = status == 0 and bool(re.search(r"^codec_type=video$", duration_text, re.MULTILINE)) and bool(re.search(r"^duration=[0-9]+(?:\.[0-9]+)?$", duration_text, re.MULTILINE))
    if valid:
        notify("normal", "video-x-generic", "x-labwc.screen-recording", "Screen recording saved", str(path))
        return 0
    if not path.is_file() or path.stat().st_size == 0:
        path.unlink(missing_ok=True)
    worker_status = status or 1
    notify("critical", ERROR_ICON, "x-labwc.screen-recording", "Screen recording failed", f"wf-recorder exited with status {status}. Details were written to {RECORDING_LOG}.")
    return worker_status


def main(argv: list[str]) -> int:
    ensure_desktop_user()
    action = argv[0] if argv else "status"
    if action == "status":
        print_status()
        return 0
    initialize_paths()
    if action in {"primary", "screenshot-box"}:
        return annotate_capture("box")
    if action == "annotate-full":
        return annotate_capture("full")
    if action == "screenshot-full":
        return capture_full()
    if action in {"record-full", "record-box"}:
        return start_recording("full" if action == "record-full" else "box")
    if action == "stop":
        return stop_recording()
    if action == "record-worker":
        if len(argv) != 6:
            return fatal("record-worker requires scope, format, path, output, and geometry", 2)
        return recording_worker(*argv[1:])
    return fatal("usage: labwc-capture [status|primary|annotate-full|screenshot-full|screenshot-box|record-full|record-box|stop]", 2)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except (CaptureError, OSError, subprocess.TimeoutExpired) as error:
        raise SystemExit(fatal(str(error)))
