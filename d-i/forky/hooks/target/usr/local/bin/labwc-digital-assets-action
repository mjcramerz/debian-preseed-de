#!/bin/sh
set -eu

# This POSIX bootstrap deliberately sanitizes the interpreter environment
# before Perl compiles any repository module. In particular, env -i prevents
# PERL5OPT and PERL5LIB from changing the Digital Assets module load path.
: "${HOME:?HOME must be set}"

[ "$(/usr/bin/id -u)" -ne 0 ] || {
  printf '%s\n' 'labwc-digital-assets-action: must run as the logged-in desktop user' >&2
  exit 1
}

terminal_type=${TERM:-dumb}
case "$terminal_type" in
  ''|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._+-]*)
    terminal_type=dumb
    ;;
esac

exec /usr/bin/env -i \
  HOME="$HOME" \
  XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
  WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
  XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}" \
  DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
  TERM="$terminal_type" \
  PATH=/usr/local/bin:/usr/bin:/bin \
  /usr/bin/perl \
    -I/usr/local/lib/perl5/site_perl/digital-assets \
    -MDigitalAssets::CLI \
    -e 'exit DigitalAssets::CLI->new()->run(@ARGV)' \
    -- "$@"
