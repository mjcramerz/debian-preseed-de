def endpoint_security() -> None:
    handlers = {"⮞ Security Auditing": security_auditing, "⮞ Malware & Rootkit Scanning": malware_menu, "⮞ Vulnerability & Integrity": integrity_menu, "⮞ AppArmor": apparmor_menu}
    while True:
        action = choose([*handlers, "⮞ Firewall Security"], "Endpoint Security")
        if action in (None, "← Back"): return
        if action == "⮞ Firewall Security": call_helper(FIREWALL, [], "firewall menu", propagate_close=True)
        elif action in handlers: handlers[action]()


