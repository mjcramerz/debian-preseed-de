def apparmor_executable() -> str | None:
    value = picker([], "Absolute executable path", text_input=True)
    if not value or value in {"Type or paste an absolute executable path", "← Back"}:
        return None
    if not value.startswith("/"):
        print(f"warning: AppArmor executable path must be absolute: {value}", file=sys.stderr)
        return None
    return value


def confirmed_apparmor(tool: str, prompt: str, *args: str) -> int:
    if confirm(prompt, "Continue with AppArmor profile tool"):
        return security_action(tool, *args, "confirmed-apparmor-profile-tool")
    return 0


def security_auditing() -> None:
    labels = ["Audit Security Posture (lynis)", "Service Security Analysis", "Inspect Specific Service", "Check Firmware Security", "Check CPU Mitigations"]
    mapping = {"Audit Security Posture (lynis)": ("audit-security-posture",), "Service Security Analysis": ("analyze-services",), "Check Firmware Security": ("check-firmware-security",), "Check CPU Mitigations": ("check-cpu-mitigations",)}
    while True:
        action = choose(labels, "Endpoint Security — Security Auditing")
        if action in (None, "← Back"): return
        if action == "Inspect Specific Service":
            service = choose_service()
            if service: security_action("inspect-service", service)
        elif action in mapping: security_action(*mapping[action])


def malware_menu() -> None:
    labels = ["Run Rootkit Scan (rkhunter)", "Run Rootkit Scan (chkrootkit)", "Show ClamAV Signature Status", "Scan File with ClamAV", "Scan Folder Recursively with ClamAV", "Update ClamAV Signatures"]
    mapping = {"Run Rootkit Scan (rkhunter)": ("scan-rootkits-rkhunter",), "Run Rootkit Scan (chkrootkit)": ("scan-rootkits-chkrootkit",), "Show ClamAV Signature Status": ("show-clamav-signature-status",), "Update ClamAV Signatures": ("update-clamav-signatures",)}
    while True:
        action = choose(labels, "Endpoint Security — Malware & Rootkits")
        if action in (None, "← Back"): return
        if action in mapping: security_action(*mapping[action])
        elif action == "Scan File with ClamAV":
            path = find_paths("ClamAV file path", files=True)
            if path: security_action("scan-file-clamav", path)
        elif action == "Scan Folder Recursively with ClamAV":
            path = find_paths("ClamAV folder path", files=False)
            if path: security_action("scan-folder-clamav", path)


def integrity_menu() -> None:
    labels = ["Check Known Vulnerabilities", "Check Package Integrity", "Retrieve File Hashsums (SHA-256/SHA-512)", "Create Folder Tree SHA-256 Manifest", "Verify File Against SHA-256"]
    while True:
        action = choose(labels, "Endpoint Security — Vulnerability & Integrity")
        if action in (None, "← Back"): return
        if action == "Check Known Vulnerabilities": security_action("check-known-vulnerabilities")
        elif action == "Check Package Integrity": security_action("check-package-integrity")
        elif action == "Retrieve File Hashsums (SHA-256/SHA-512)":
            path = find_paths("File path for SHA-256 and SHA-512", files=True)
            if path: security_action("retrieve-file-hashes", path)
        elif action == "Create Folder Tree SHA-256 Manifest":
            path = find_paths("Folder path for SHA-256 manifest", files=False)
            if path: security_action("create-folder-hash-manifest", path)
        elif action == "Verify File Against SHA-256":
            path = find_paths("File path to verify", files=True)
            digest = picker([], "Expected SHA-256 (64 hexadecimal characters)", text_input=True) if path else None
            if path and digest: security_action("verify-file-sha256", path, digest)


def apparmor_drafts() -> None:
    while True:
        action = choose(["Easyprof Draft", "Autodep Base Draft", "Logprof Draft Update", "Genprof Interactive Draft", "List Drafts", "Validate Drafts", "Activate Selected Draft"], "AppArmor — Profile Drafts")
        if action in (None, "← Back"): return
        if action in {"Easyprof Draft", "Autodep Base Draft", "Genprof Interactive Draft"}:
            executable = apparmor_executable()
            if executable:
                tool = {"Easyprof Draft": "aa-easyprof", "Autodep Base Draft": "aa-autodep", "Genprof Interactive Draft": "aa-genprof"}[action]
                confirmed_apparmor(tool, f"Generate an {action.lower()} for {executable}", executable)
        elif action == "Logprof Draft Update":
            confirmed_apparmor("aa-logprof", "Generate draft updates from __INSTALLER_LOG_APPARMOR_FILE__")
        elif action == "List Drafts": security_action("apparmor-list-drafts")
        elif action == "Validate Drafts": security_action("apparmor-validate-drafts")
        elif action == "Activate Selected Draft":
            if not os.access(SECURITY, os.X_OK): raise MaintenanceError("labwc-security-action is not installed")
            try: result = run([SECURITY, "--list-apparmor-draft-candidates"], capture=True, timeout=15)
            except (OSError, subprocess.TimeoutExpired): continue
            selected = picker(result.stdout.splitlines()[:400], "Select AppArmor draft")
            if not selected: continue
            if selected.startswith("easyprof/"): origin, name = "easyprof", selected.removeprefix("easyprof/")
            elif selected.startswith("drafts/"): origin, name = "drafts", selected.removeprefix("drafts/")
            else:
                print(f"warning: invalid AppArmor draft selection: {selected}", file=sys.stderr); continue
            if confirm(f"Validate and activate {selected}; existing profiles are backed up first", "Continue with AppArmor draft activation"):
                security_action("apparmor-activate-draft", origin, name, "confirmed-apparmor-draft-activation")


def apparmor_modes() -> None:
    while True:
        action = choose(["Show App Modes", "Generate New Rules", "Enforce All", "Complain All", "Unload AppArmor Profile", "Load AppArmor Profile", "Set App Mode", "Set App Audit Logging", "Reload Modes & Clear Audit"], "AppArmor — App Modes")
        if action in (None, "← Back"): return
        if action == "Show App Modes": security_action("apparmor-application-modes")
        elif action == "Generate New Rules" and confirm("Generate validated local AppArmor rules from managed DENIED events", "Continue with AppArmor rule generation"): security_action("generate-apparmor-rules", "confirmed-apparmor-rule-generation")
        elif action in {"Enforce All", "Complain All"}:
            mode = "enforce" if action == "Enforce All" else "complain"
            if confirm(f"Set every managed application and wrapper AppArmor profile to {mode}", "Continue with all-profile AppArmor mode change"): security_action("set-apparmor-desktop-state", mode, "confirmed-apparmor-desktop-state-change")
        elif action in {"Unload AppArmor Profile", "Load AppArmor Profile"}:
            state = "unload" if action.startswith("Unload") else "load"
            try: result = run([SECURITY, "--list-apparmor-profile-candidates"], capture=True, timeout=15)
            except (OSError, subprocess.TimeoutExpired): continue
            selected = picker(result.stdout.splitlines()[:400], f"Select AppArmor profile to {state}")
            if selected and confirm(f"{state.title()} {selected} and its children", "Continue with AppArmor profile change"):
                security_action("set-apparmor-profile-state", state, selected, "confirmed-apparmor-profile-state-change")
        elif action == "Set App Mode":
            app = security_app(); mode_label = picker(["Enforce", "Complain"], "AppArmor profile mode") if app else None
            if app and mode_label and confirm(f"Set {app} application profiles to {mode_label.lower()}; required launch profiles remain loaded", "Continue with AppArmor mode change"):
                security_action("set-apparmor-application-mode", app, mode_label.lower(), "confirmed-apparmor-mode-change")
        elif action == "Set App Audit Logging":
            app = security_app(); audit = picker(["Enable Audit Mode", "Disable Audit Mode"], "AppArmor audit mode") if app else None
            if app and audit and confirm(f"Set {app} AppArmor audit mode", "Continue with AppArmor audit change"):
                security_action("set-apparmor-application-audit", app, "enable" if audit.startswith("Enable") else "disable", "confirmed-apparmor-audit-change")
        elif action == "Reload Modes & Clear Audit" and confirm("Reload modes and clear temporary audit flags", "Continue with AppArmor reload"):
            security_action("reload-apparmor-modes", "confirmed-apparmor-reload")


