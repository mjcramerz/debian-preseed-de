def main(argv: list[str]) -> int:
    if not os.access(PICKER, os.X_OK): raise MaintenanceError("labwc-fuzzel is not installed")
    if not os.access(SYSTEMCTL, os.X_OK): raise MaintenanceError("systemctl is not installed")
    if not os.access(IP, os.X_OK): raise MaintenanceError("ip is not installed")
    if os.getuid() == 0: raise MaintenanceError("labwc-maintenance-menu must run as the logged-in desktop user")
    os.environ["LABWC_MENU_ACTION_WAIT"] = "1"
    if len(argv) > 1 or (argv and argv[0] not in {"security", "system", "recovery"}):
        raise MaintenanceError(f"unsupported maintenance category: {argv[0] if argv else ''}")
    requested = argv[0] if argv else None
    handlers = {"security": endpoint_security, "system": system_menu, "recovery": recovery_menu}
    if requested:
        handlers[requested]()
        return 0
    while True:
        category = picker(["⮞ Endpoint Security", "⮞ System", "⮞ Troubleshooting", "← Back"], "Maintenance")
        if category in (None, "← Back"): return 0
        {"⮞ Endpoint Security": endpoint_security, "⮞ System": system_menu, "⮞ Troubleshooting": recovery_menu}[category]()


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except (MaintenanceError, OSError, subprocess.TimeoutExpired) as error:
        raise SystemExit(fatal(str(error)))
