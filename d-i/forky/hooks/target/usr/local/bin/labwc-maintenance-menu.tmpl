#!/usr/bin/python3 -IB
"""Managed maintenance, recovery, and endpoint-security menu.

This program owns navigation only. System, recovery, security, firewall, and
external-drive mutations remain delegated to their existing fixed helpers.
"""
from __future__ import annotations

import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import time

import labwc_desktop_runtime as desktop_runtime

PICKER = "/usr/local/bin/labwc-fuzzel"
SYSTEM = "/usr/local/bin/labwc-system-action"
RECOVERY = "/usr/local/bin/labwc-recovery-action"
SECURITY = "/usr/local/bin/labwc-security-action"
FIREWALL = "/usr/local/bin/labwc-firewall-menu"
EXTERNAL = "/usr/local/bin/labwc-external-drives"
SYSTEMCTL = "/usr/bin/systemctl"
IP = "/usr/bin/ip"


class MaintenanceError(RuntimeError):
    pass


def fatal(message: str, status: int = 1) -> int:
    print(f"fatal: {message}", file=sys.stderr)
    return status


def run(argv: list[str], *, input_text: str | None = None, capture: bool = False,
        timeout: float = 900, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    return desktop_runtime.run(argv, input_text=input_text, capture=capture, timeout=timeout,
                               env=dict(os.environ, **(env or {})))


def picker(rows: list[str], prompt: str, *, text_input: bool = False) -> str | None:
    result = run([PICKER, "menu", "--dmenu", "--prompt", prompt],
                 input_text="\n" if text_input else "".join(f"{row}\n" for row in rows),
                 capture=True, timeout=120,
                 env={"LABWC_MENU_ACTION_WAIT": "1", **({"LABWC_MENU_INPUT_MODE": "text"} if text_input else {})})
    if result.returncode == 1:
        return None
    if result.returncode == 3:
        raise SystemExit(3)
    if result.returncode:
        raise MaintenanceError(f"menu picker failed (status {result.returncode})")
    selected = result.stdout.rstrip("\n")
    return selected if text_input else (selected if selected in rows else None)


def choose(rows: list[str], prompt: str) -> str | None:
    return picker(rows + ["← Back"], prompt)


def confirm(prompt: str, continuation: str) -> bool:
    return picker(["Cancel", continuation], prompt) == continuation


def call_helper(path: str, args: list[str], label: str, *, propagate_close: bool = False) -> int:
    if not os.access(path, os.X_OK):
        raise MaintenanceError(f"{label} is not installed")
    try:
        result = run([path, *args])
    except (OSError, subprocess.TimeoutExpired):
        print(f"warning: {label} was unavailable: {args[0] if args else 'unknown'}", file=sys.stderr)
        return 0
    if result.returncode:
        if propagate_close and result.returncode == 3:
            raise SystemExit(3)
        print(f"warning: {label} returned status {result.returncode}: {args[0] if args else 'unknown'}", file=sys.stderr)
    return 0


def system_action(*args: str) -> int:
    return call_helper(SYSTEM, list(args), "system action")


def recovery_action(*args: str) -> int:
    return call_helper(RECOVERY, list(args), "recovery action")


def security_action(*args: str) -> int:
    return call_helper(SECURITY, list(args), "security action")


def confirmed_system(action: str, prompt: str, *extra: str) -> int:
    if confirm(prompt, "Continue with authorized system action"):
        return system_action(action, *extra, "confirmed-system-action")
    return 0


def confirmed_recovery(action: str, prompt: str) -> int:
    if confirm(prompt, "Continue with authorized recovery action"):
        return recovery_action(action, "confirmed-recovery-action")
    return 0


def choose_nvme() -> str | None:
    devices: list[str] = []
    try:
        entries = sorted(Path("/sys/class/nvme").glob("nvme*"))
    except OSError:
        entries = []
    for entry in entries:
        device = Path("/dev") / entry.name
        if re.fullmatch(r"/dev/nvme[0-9]+", str(device)) and device.exists():
            devices.append(str(device))
    return picker(sorted(set(devices)), "NVMe controller") if devices else None


def choose_service() -> str | None:
    services = {"greetd.service", "ssh.service", "systemd-logind.service"}
    try:
        result = run([SYSTEMCTL, "list-unit-files", "--type=service", "--no-legend", "--no-pager"], capture=True, timeout=15)
        services.update(line.split()[0] for line in result.stdout.splitlines() if line.split() and re.fullmatch(r"[A-Za-z0-9_.@-]+\.service", line.split()[0]))
    except (OSError, subprocess.TimeoutExpired):
        pass
    selected = picker(sorted(services), "Inspect service", text_input=True)
    return selected if selected and re.fullmatch(r"[A-Za-z0-9_.@-]+\.service", selected) else None


def find_paths(prompt: str, *, files: bool, max_depth: int = 3) -> str | None:
    home = Path.home()
    try:
        home_metadata = home.lstat()
    except OSError as error:
        raise MaintenanceError("the desktop home directory is unavailable") from error
    if (not stat.S_ISDIR(home_metadata.st_mode) or home_metadata.st_uid != os.getuid()
            or home_metadata.st_mode & 0o022):
        raise MaintenanceError("the desktop home directory has unsafe metadata")
    roots = [home / name for name in ("Downloads", "Documents", "Desktop")] + ([home] if files else [home, Path("/mnt"), Path("/media")])
    found: set[str] = set()
    scanned = 0
    directories = 0
    deadline = time.monotonic() + 3
    for root in roots:
        try:
            root_stat = root.stat(follow_symlinks=False)
            shared_root = root in {Path("/mnt"), Path("/media")}
            if not stat.S_ISDIR(root_stat.st_mode) or (
                    root_stat.st_uid != os.getuid() and (not shared_root or root_stat.st_mode & 0o022)):
                continue
        except OSError:
            continue
        stack: list[tuple[Path, int]] = [(root, 0)]
        while stack and len(found) < 400 and scanned < 8000 and directories < 256 and time.monotonic() < deadline:
            directory, depth = stack.pop()
            try:
                with os.scandir(directory) as iterator:
                    directories += 1
                    entries = iterator
                    for entry in entries:
                        scanned += 1
                        if scanned >= 8000 or time.monotonic() >= deadline:
                            break
                        try:
                            if entry.is_dir(follow_symlinks=False) and depth < max_depth:
                                child = entry.stat(follow_symlinks=False)
                                if child.st_dev == root_stat.st_dev and directories + len(stack) < 256:
                                    stack.append((Path(entry.path), depth + 1))
                            elif files and entry.is_file(follow_symlinks=False):
                                found.add(entry.path)
                            elif not files and entry.is_dir(follow_symlinks=False):
                                found.add(entry.path)
                        except OSError:
                            continue
            except OSError:
                continue
    return picker(sorted(found)[:400], prompt, text_input=True)


