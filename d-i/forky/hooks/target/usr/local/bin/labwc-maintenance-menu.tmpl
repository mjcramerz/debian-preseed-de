def system_menu() -> None:
    while True:
        group = choose(list(SYSTEM_GROUPS), "Maintenance")
        if group in (None, "← Back"): return
        while True:
            action = choose(SYSTEM_GROUPS[group], f"Maintenance / {group}")
            if action in (None, "← Back"): break
            if action == "Manage External Drives": call_helper(EXTERNAL, [], "external drive manager", propagate_close=True)
            elif action == "Inspect Service and Logs":
                service = choose_service()
                if service: system_action("inspect-service", service)
            elif action == "Apply Firmware Updates": confirmed_system("apply-firmware-updates", "Apply available firmware updates")
            elif action == "Run Unattended Upgrades Now": confirmed_system("run-unattended-upgrades", "Run unattended upgrades now")
            elif action == "Restart PipeWire": confirmed_system("restart-pipewire", "Restart PipeWire services")
            elif action == "Restart WirePlumber": confirmed_system("restart-wireplumber", "Restart WirePlumber")
            elif action == "Rotate and Vacuum Journals by Time":
                value = choose_journal_time()
                if value: confirmed_system("journal-vacuum-time", f"Rotate journals and retain {value}", value)
            elif action == "Rotate and Vacuum Journals by Size":
                value = choose_journal_size()
                if value: confirmed_system("journal-vacuum-size", f"Rotate journals and cap usage at {value}", value)
            elif action in {"Show NVMe SMART Health", "Show NVMe Firmware Slots", "Show NVMe Identify Data", "Show NVMe SMART via smartctl"}:
                device = choose_nvme()
                if device:
                    system_action({"Show NVMe SMART Health": "nvme-smart-health", "Show NVMe Firmware Slots": "nvme-firmware-slots", "Show NVMe Identify Data": "nvme-identify-data", "Show NVMe SMART via smartctl": "nvme-smartctl"}[action], device)
            elif action in SYSTEM_ACTIONS: system_action(SYSTEM_ACTIONS[action])


