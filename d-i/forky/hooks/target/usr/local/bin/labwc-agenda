#!/bin/sh
# Fixed service ownership and native GApplication single-instance activation.
set -eu
[ "$#" -eq 0 ] || { printf '%s\n' 'labwc-agenda: no arguments supported' >&2; exit 2; }
/usr/local/libexec/labwc-session-check session-ready || exit 1
/usr/bin/systemctl --user start labwc-agenda.service || exit 1
export GDK_BACKEND=wayland
export GSETTINGS_SCHEMA_DIR=/usr/local/share/agenda/schemas
export XDG_DATA_HOME="$HOME/.local/share"
exec /usr/local/bin/com.github.dahenson.agenda
