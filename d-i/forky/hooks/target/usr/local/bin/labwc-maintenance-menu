#!/bin/sh
set -eu

fatal() {
  printf 'fatal: %s\n' "$*" >&2
  exit 1
}

choose_lines() {
  prompt=$1
  shift

  printf '%s\n' "$@" |
    labwc-fuzzel menu \
      --dmenu \
      --prompt "$prompt" 2>/dev/null ||
    true
}

run_security_action() {
  command -v labwc-security-action >/dev/null 2>&1 ||
    fatal "labwc-security-action is not installed"

  if labwc-security-action "$@"; then
    return 0
  else
    action_status=$?
  fi

  printf 'warning: security action returned status %s: %s\n' \
    "$action_status" "$1" >&2
  return 0
}

choose_apparmor_draft() {
  command -v labwc-security-action >/dev/null 2>&1 ||
    fatal "labwc-security-action is not installed"

  draft_candidates=$(
    labwc-security-action --list-apparmor-draft-candidates
  ) || return 0
  [ -n "$draft_candidates" ] || {
    printf '%s\n' 'warning: no generated AppArmor drafts are available' >&2
    return 0
  }

  printf '%s\n' "$draft_candidates" |
    labwc-fuzzel menu \
      --dmenu \
      --prompt "Select AppArmor draft" 2>/dev/null ||
    true
}

run_firewall_menu() (
  command -v labwc-firewall-menu >/dev/null 2>&1 ||
    fatal "labwc-firewall-menu is not installed"

  LABWC_FUZZEL_MENU_WIDTH_OVERRIDE=${LABWC_FUZZEL_FIREWALL_SECURITY_WIDTH:-${LABWC_FUZZEL_MENU_WIDTH_OVERRIDE:-}}
  LABWC_FUZZEL_MENU_LINES_OVERRIDE=${LABWC_FUZZEL_FIREWALL_SECURITY_LINES:-${LABWC_FUZZEL_MENU_LINES_OVERRIDE:-}}
  LABWC_FUZZEL_MENU_FONT_SIZE_OVERRIDE=${LABWC_FUZZEL_FIREWALL_SECURITY_FONT_SIZE:-${LABWC_FUZZEL_MENU_FONT_SIZE_OVERRIDE:-}}
  export \
    LABWC_FUZZEL_MENU_WIDTH_OVERRIDE \
    LABWC_FUZZEL_MENU_LINES_OVERRIDE \
    LABWC_FUZZEL_MENU_FONT_SIZE_OVERRIDE

  if labwc-firewall-menu; then
    return 0
  else
    action_status=$?
  fi

  printf 'warning: firewall menu returned status %s\n' \
    "$action_status" >&2
  return 0
)

run_system_action() {
  command -v labwc-system-action >/dev/null 2>&1 ||
    fatal "labwc-system-action is not installed"

  if labwc-system-action "$@"; then
    return 0
  else
    action_status=$?
  fi

  printf 'warning: system action returned status %s: %s\n' \
    "$action_status" "$1" >&2
  return 0
}

run_external_drive_manager() {
  command -v labwc-external-drives >/dev/null 2>&1 ||
    fatal "labwc-external-drives is not installed"

  if labwc-external-drives; then
    return 0
  else
    action_status=$?
  fi

  printf 'warning: external drive manager returned status %s\n' \
    "$action_status" >&2
  return 0
}

run_recovery_action() {
  command -v labwc-recovery-action >/dev/null 2>&1 ||
    fatal "labwc-recovery-action is not installed"

  if labwc-recovery-action "$@"; then
    return 0
  else
    action_status=$?
  fi

  printf 'warning: recovery action returned status %s: %s\n' \
    "$action_status" "$1" >&2
  return 0
}

run_confirmed_system_action() {
  system_action=$1
  confirmation_prompt=$2
  shift 2

  confirmation=$(
    choose_lines \
      "$confirmation_prompt" \
      'Cancel' \
      'Continue with authorized system action'
  )
  [ "$confirmation" = 'Continue with authorized system action' ] ||
    return 0
  run_system_action "$system_action" "$@" confirmed-system-action
}

run_confirmed_recovery_action() {
  recovery_action=$1
  confirmation_prompt=$2

  confirmation=$(
    choose_lines \
      "$confirmation_prompt" \
      'Cancel' \
      'Continue with authorized recovery action'
  )
  [ "$confirmation" = 'Continue with authorized recovery action' ] ||
    return 0
  run_recovery_action "$recovery_action" confirmed-recovery-action
}

choose_nvme_controller() {
  {
    for nvme_sysfs in /sys/class/nvme/nvme*; do
      [ -e "$nvme_sysfs" ] || continue
      nvme_device="/dev/${nvme_sysfs##*/}"
      [ -e "$nvme_device" ] && printf '%s\n' "$nvme_device"
    done
  } |
    awk '!seen[$0]++' |
    sort |
    labwc-fuzzel menu --dmenu --prompt "NVMe controller" 2>/dev/null ||
    true
}

choose_journal_vacuum_time() {
  retention=$(
    choose_lines \
      "Journal retention" \
      '3 days' \
      '7 days' \
      '14 days' \
      '30 days'
  )
  case "$retention" in
    '3 days') printf '%s\n' 3d ;;
    '7 days') printf '%s\n' 7d ;;
    '14 days') printf '%s\n' 14d ;;
    '30 days') printf '%s\n' 30d ;;
  esac
}

choose_journal_vacuum_size() {
  retention=$(
    choose_lines \
      "Maximum journal size" \
      '256 MiB' \
      '512 MiB' \
      '1 GiB' \
      '2 GiB'
  )
  case "$retention" in
    '256 MiB') printf '%s\n' 256M ;;
    '512 MiB') printf '%s\n' 512M ;;
    '1 GiB') printf '%s\n' 1G ;;
    '2 GiB') printf '%s\n' 2G ;;
  esac
}

choose_service() {
  {
    printf '%s\n' greetd.service ssh.service systemd-logind.service
    systemctl list-unit-files --type=service --no-legend --no-pager 2>/dev/null |
      awk 'NF > 0 { print $1 }'
  } |
    awk '!seen[$0]++' |
    sort |
    labwc-fuzzel menu --dmenu --prompt "Inspect service" 2>/dev/null ||
    true
}

choose_security_folder() {
  selection_prompt=$1
  {
    for candidate in \
      "$HOME" \
      "$HOME/Downloads" \
      "$HOME/Documents" \
      "$HOME/Desktop" \
      "/run/media/$(id -un)" \
      /mnt \
      /media
    do
      [ -d "$candidate" ] && printf '%s\n' "$candidate"
    done
    for candidate_root in \
      "$HOME/Downloads" \
      "$HOME/Documents" \
      "$HOME/Desktop"
    do
      [ -d "$candidate_root" ] || continue
      find "$candidate_root" \
        -xdev \
        -mindepth 1 \
        -maxdepth 2 \
        -type d \
        -print 2>/dev/null
    done
  } |
    awk '!seen[$0]++' |
    sed -n '1,400p' |
    labwc-fuzzel menu --dmenu --prompt "$selection_prompt" 2>/dev/null ||
    true
}

choose_security_file() {
  selection_prompt=$1
  {
    for candidate_dir in \
      "$HOME/Downloads" \
      "$HOME/Documents" \
      "$HOME/Desktop" \
      "$HOME"
    do
      [ -d "$candidate_dir" ] || continue
      find "$candidate_dir" \
        -xdev \
        -mindepth 1 \
        -maxdepth 3 \
        -type f \
        -print 2>/dev/null
    done
  } |
    awk '!seen[$0]++' |
    sed -n '1,400p' |
    labwc-fuzzel menu --dmenu --prompt "$selection_prompt" 2>/dev/null ||
    true
}

security_auditing_menu() {
  while :; do
    action=$(
      choose_lines \
        "Endpoint Security — Security Auditing" \
        'Audit Security Posture (lynis)' \
        'Service Security Analysis' \
        'Inspect Specific Service' \
        'Check Firmware Security' \
        'Check CPU Mitigations' \
        '← Back'
    )

    case "$action" in
      'Audit Security Posture (lynis)')
        run_security_action audit-security-posture
        ;;
      'Service Security Analysis')
        run_security_action analyze-services
        ;;
      'Inspect Specific Service')
        service=$(choose_service)
        [ -n "$service" ] && run_security_action inspect-service "$service"
        ;;
      'Check Firmware Security')
        run_security_action check-firmware-security
        ;;
      'Check CPU Mitigations')
        run_security_action check-cpu-mitigations
        ;;
      '← Back'|'')
        return 0
        ;;
    esac
  done
}

malware_scanning_menu() {
  while :; do
    action=$(
      choose_lines \
        "Endpoint Security — Malware & Rootkits" \
        'Run Rootkit Scan (rkhunter)' \
        'Run Rootkit Scan (chkrootkit)' \
        'Show ClamAV Signature Status' \
        'Scan File with ClamAV' \
        'Scan Folder Recursively with ClamAV' \
        'Update ClamAV Signatures' \
        '← Back'
    )

    case "$action" in
      'Run Rootkit Scan (rkhunter)')
        run_security_action scan-rootkits-rkhunter
        ;;
      'Run Rootkit Scan (chkrootkit)')
        run_security_action scan-rootkits-chkrootkit
        ;;
      'Show ClamAV Signature Status')
        run_security_action show-clamav-signature-status
        ;;
      'Scan File with ClamAV')
        scan_file=$(choose_security_file "ClamAV file path")
        [ -n "$scan_file" ] &&
          run_security_action scan-file-clamav "$scan_file"
        ;;
      'Scan Folder Recursively with ClamAV')
        scan_folder=$(choose_security_folder "ClamAV folder path")
        [ -n "$scan_folder" ] &&
          run_security_action scan-folder-clamav "$scan_folder"
        ;;
      'Update ClamAV Signatures')
        run_security_action update-clamav-signatures
        ;;
      '← Back'|'')
        return 0
        ;;
    esac
  done
}

vulnerability_integrity_menu() {
  while :; do
    action=$(
      choose_lines \
        "Endpoint Security — Vulnerability & Integrity" \
        'Check Known Vulnerabilities' \
        'Check Package Integrity' \
        'Retrieve File Hashsums (SHA-256/SHA-512)' \
        'Create Folder Tree SHA-256 Manifest' \
        'Verify File Against SHA-256' \
        '← Back'
    )

    case "$action" in
      'Check Known Vulnerabilities')
        run_security_action check-known-vulnerabilities
        ;;
      'Check Package Integrity')
        run_security_action check-package-integrity
        ;;
      'Retrieve File Hashsums (SHA-256/SHA-512)')
        hash_file=$(choose_security_file "File path for SHA-256 and SHA-512")
        [ -n "$hash_file" ] &&
          run_security_action retrieve-file-hashes "$hash_file"
        ;;
      'Create Folder Tree SHA-256 Manifest')
        hash_folder=$(choose_security_folder "Folder path for SHA-256 manifest")
        [ -n "$hash_folder" ] &&
          run_security_action create-folder-hash-manifest "$hash_folder"
        ;;
      'Verify File Against SHA-256')
        verify_file=$(choose_security_file "File path to verify")
        if [ -n "$verify_file" ]; then
          expected_sha256=$(
            choose_lines \
              "Expected SHA-256 (64 hexadecimal characters)" \
              'Paste or type the expected SHA-256 digest'
          )
          [ -n "$expected_sha256" ] &&
            run_security_action verify-file-sha256 "$verify_file" "$expected_sha256"
        fi
        ;;
      '← Back'|'')
        return 0
        ;;
    esac
  done
}

