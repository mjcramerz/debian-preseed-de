#!/bin/sh
set -eu

if [ -r /etc/labwc/desktop.conf ]; then
  # shellcheck disable=SC1091
  . /etc/labwc/desktop.conf
fi

layout_list=${LABWC_KEYBOARD_LAYOUTS:-us se}
default_layout=${LABWC_KEYBOARD_DEFAULT_LAYOUT:-us}
state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/labwc"
state_file="${state_dir}/keyboard-layout"
env_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/labwc/environment.d"
env_file="${env_dir}/20-keyboard-layout.env"

normalize_layout() {
  case "$1" in
    us) printf '%s\n' us ;;
    se|sv) printf '%s\n' se ;;
    *) return 1 ;;
  esac
}

layout_is_allowed() {
  wanted=$(normalize_layout "$1" 2>/dev/null || true)
  [ -n "$wanted" ] || return 1

  for candidate in $layout_list; do
    candidate=$(normalize_layout "$candidate" 2>/dev/null || true)
    [ -n "$candidate" ] || continue
    [ "$candidate" = "$wanted" ] && return 0
  done
  return 1
}

current_layout() {
  layout=
  if [ -r "$state_file" ]; then
    IFS= read -r layout <"$state_file" || layout=
  fi
  layout=$(normalize_layout "${layout:-$default_layout}" 2>/dev/null || true)
  if [ -n "$layout" ] && layout_is_allowed "$layout"; then
    printf '%s\n' "$layout"
    return 0
  fi

  layout=$(normalize_layout "$default_layout" 2>/dev/null || true)
  [ -n "$layout" ] && layout_is_allowed "$layout" || layout=us
  printf '%s\n' "$layout"
}

next_layout() {
  current=$1
  previous=
  first=

  for candidate in $layout_list; do
    candidate=$(normalize_layout "$candidate" 2>/dev/null || true)
    [ -n "$candidate" ] || continue
    [ -n "$first" ] || first=$candidate
    if [ "$previous" = "$current" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
    previous=$candidate
  done

  printf '%s\n' "${first:-us}"
}

write_layout_state() {
  layout=$1
  umask 077
  install -d -m 0700 "$state_dir" "$env_dir"
  state_tmp="${state_file}.$$"
  env_tmp="${env_file}.$$"
  trap 'rm -f "$state_tmp" "$env_tmp"' EXIT HUP INT TERM
  printf '%s\n' "$layout" >"$state_tmp"
  {
    printf '# Generated by labwc-keyboard-layout.\n'
    printf 'XKB_DEFAULT_LAYOUT=%s\n' "$layout"
  } >"$env_tmp"
  mv "$state_tmp" "$state_file"
  mv "$env_tmp" "$env_file"
  trap - EXIT HUP INT TERM
}

reconfigure_labwc() {
  [ -n "${WAYLAND_DISPLAY:-}" ] || return 0
  command -v labwc >/dev/null 2>&1 || return 1
  labwc --reconfigure 9>&- >/dev/null 2>&1
}

lock_layout() {
  umask 077
  install -d -m 0700 "$state_dir"
  lock_file="${state_dir}/keyboard-layout-waybar.lock"
  [ ! -L "$lock_file" ] || return 1
  exec 9>"$lock_file"
  # Queue close-spaced clicks rather than silently losing the second toggle.
  # Bound the wait so a stuck helper does not accumulate processes indefinitely.
  flock -w 5 9 || {
    printf 'keyboard layout: timed out waiting for the layout lock\n' >&2
    return 1
  }
}

complete_layout_change() {
  previous_layout=$(current_layout)
  write_layout_state "$1"
  if ! reconfigure_labwc; then
    # Do not advertise a layout that the compositor could not be asked to load.
    write_layout_state "$previous_layout"
    printf 'keyboard layout: compositor reconfiguration failed\n' >&2
    return 1
  fi
  print_status_json
  # Children must not retain the lock; refresh reads the committed state and
  # must not hold up the next queued click while contacting the user manager.
  exec 9>&-
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    /usr/local/bin/labwc-system-action refresh-waybar-custom-module >/dev/null ||
      printf 'keyboard layout: layout changed, but Waybar refresh failed\n' >&2
  fi
}

toggle_layout() {
  lock_layout
  complete_layout_change "$(next_layout "$(current_layout)")"
}

waybar_toggle() {
  lock_layout
  # Let the pointer callback unwind, without the old 150 ms dead window.
  sleep 0.03 9>&-
  complete_layout_change "$(next_layout "$(current_layout)")"
}

layout_label() {
  case "$1" in
    se) printf '%s\n' SE ;;
    *) printf '%s\n' US ;;
  esac
}

layout_flag() {
  case "$1" in
    se) printf '%s\n' '__THEME_WAYBAR_BUTTON_KEYBOARD_SWEDISH_ICON_GLYPH__' ;;
    *) printf '%s\n' '__THEME_WAYBAR_BUTTON_KEYBOARD_US_ENGLISH_ICON_GLYPH__' ;;
  esac
}

print_status_json() {
  layout=$(current_layout)
  label=$(layout_label "$layout")
  flag=$(layout_flag "$layout")
  printf '{"text":"%s","tooltip":"Keyboard layout: %s","class":"%s"}\n' "$flag" "$label" "$layout"
}

case "${1:-status}" in
  status|json)
    print_status_json
    ;;
  current)
    current_layout
    ;;
  toggle)
    toggle_layout
    ;;
  waybar-toggle)
    waybar_toggle
    ;;
  set)
    layout=$(normalize_layout "${2:-}" 2>/dev/null || true)
    [ -n "$layout" ] && layout_is_allowed "$layout" || {
      printf 'fatal: unsupported keyboard layout: %s\n' "${2:-unset}" >&2
      exit 1
    }
    lock_layout
    complete_layout_change "$layout"
    ;;
  *)
    printf 'usage: labwc-keyboard-layout [status|current|toggle|waybar-toggle|set <us|se>]\n' >&2
    exit 2
    ;;
esac
