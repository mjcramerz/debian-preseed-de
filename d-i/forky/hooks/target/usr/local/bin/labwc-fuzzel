#!/bin/sh
set -eu

MENU_FAILURE_STATUS=2

# Management child pickers reuse their existing data protocol in a controlling
# terminal. Application search and ordinary graphical menus never opt in.
if [ "${LABWC_MENU_BACKEND:-fuzzel}" = fzf ]; then
  case "${1:-}" in
    menu|--dmenu|--dmenu0)
      exec /usr/local/bin/labwc-fzf-menu "$@"
      ;;
  esac
fi

fatal() {
  fatal_message=$*
  fatal_log_scope=${managed_log_scope:-${LABWC_FUZZEL_LOG_SCOPE:-desktop}}
  if [ -x /usr/local/bin/labwc-fuzzel-log ]; then
    /usr/local/bin/labwc-fuzzel-log \
      action \
      launcher-failed \
      "source=${fatal_log_scope}" \
      "detail=${fatal_message}" \
      "status=${MENU_FAILURE_STATUS}" || true
  fi
  printf 'fatal: %s\n' "$*" >&2
  exit "$MENU_FAILURE_STATUS"
}

if [ -r /etc/default/labwc-desktop ]; then
  # shellcheck disable=SC1091
  . /etc/default/labwc-desktop
fi

command -v fuzzel >/dev/null 2>&1 || {
  fatal 'fuzzel is not installed'
}
[ -x /usr/bin/flock ] || {
  fatal '/usr/bin/flock is required to serialize Fuzzel launchers'
}

config_root=${XDG_CONFIG_HOME:-${HOME}/.config}
fuzzel_config_dir="${config_root}/fuzzel"
mode=launcher
main_menu=false
managed_icons=${LABWC_FUZZEL_MANAGED_ICONS:-0}
managed_root_menu=${LABWC_FUZZEL_ROOT_MENU:-0}
managed_log_scope=${LABWC_FUZZEL_LOG_SCOPE:-desktop}
menu_width_override=${LABWC_FUZZEL_MENU_WIDTH_OVERRIDE:-}
menu_lines_override=${LABWC_FUZZEL_MENU_LINES_OVERRIDE:-}
menu_font_size_override=${LABWC_FUZZEL_MENU_FONT_SIZE_OVERRIDE:-}
internal_output_prefixes=${LABWC_OUTPUT_INTERNAL_PREFIXES:-eDP LVDS DSI}
internal_menu_width=${LABWC_FUZZEL_INTERNAL_MENU_WIDTH:-18}
internal_menu_lines=${LABWC_FUZZEL_INTERNAL_MENU_LINES:-8}
internal_menu_max_lines=32
internal_font_size=${LABWC_FUZZEL_INTERNAL_FONT_SIZE:-9}

require_uint_range() {
  setting_name=$1
  setting_value=$2
  minimum=$3
  maximum=$4

  case "$setting_value" in
    ''|*[!0-9]*)
      fatal "$setting_name must be an integer from $minimum to $maximum"
      ;;
  esac
  if [ "$setting_value" -lt "$minimum" ] ||
     [ "$setting_value" -gt "$maximum" ]; then
    fatal "$setting_name must be an integer from $minimum to $maximum"
  fi
}

validate_output_name() {
  output_name=$1
  [ "${#output_name}" -le 128 ] || fatal 'Fuzzel output name exceeds 128 characters'
  case "$output_name" in
    ''|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*)
      fatal 'Fuzzel output name contains unsupported characters'
      ;;
  esac
}

fuzzel_output_is_internal() {
  candidate_output=$1
  [ -n "$internal_output_prefixes" ] ||
    fatal 'LABWC_OUTPUT_INTERNAL_PREFIXES must not be empty'
  for internal_prefix in $internal_output_prefixes; do
    validate_output_name "$internal_prefix"
    case "$candidate_output" in
      "${internal_prefix}"-*|"${internal_prefix}"[0-9]*) return 0 ;;
    esac
  done
  return 1
}

case "$managed_icons" in
  0|1) ;;
  *)
    fatal 'LABWC_FUZZEL_MANAGED_ICONS must be 0 or 1'
    ;;
esac
case "$managed_root_menu" in
  0|1) ;;
  *)
    fatal 'LABWC_FUZZEL_ROOT_MENU must be 0 or 1'
    ;;
esac
case "$managed_log_scope" in
  desktop|computer-management|android-debug-bridge) ;;
  *) fatal 'LABWC_FUZZEL_LOG_SCOPE is invalid' ;;
esac

case "${1:-}" in
  main-menu)
    mode=menu
    main_menu=true
    shift
    ;;
  launcher|menu)
    mode=$1
    shift
    ;;
esac

nul_delimited=false
for arg in "$@"; do
  case "$arg" in
    --dmenu)
      mode=menu
      ;;
    --dmenu0)
      mode=menu
      nul_delimited=true
      ;;
  esac
done

# Native icon enablement belongs to the rendered configurations. Keep the
# CLI compatible with Debian Fuzzel 1.12 (no --override option) and leave
# the configured icon-theme intact, including for caller-encoded rows.
have_config=false
have_output=false
managed_prompt=
expect_prompt_value=false
expect_output_value=false
fuzzel_output=
for arg in "$@"; do
  if [ "$expect_prompt_value" = true ]; then
    managed_prompt=$arg
    expect_prompt_value=false
    continue
  fi
  if [ "$expect_output_value" = true ]; then
    fuzzel_output=$arg
    expect_output_value=false
    continue
  fi
  case "$arg" in
    --config|-c|--config=*) have_config=true ;;
    --output|-o)
      have_output=true
      expect_output_value=true
      ;;
    --output=*)
      have_output=true
      fuzzel_output=${arg#--output=}
      ;;
    -o?*)
      have_output=true
      fuzzel_output=${arg#-o}
      ;;
    --prompt) expect_prompt_value=true ;;
    --prompt=*) managed_prompt=${arg#--prompt=} ;;
  esac
done
[ "$expect_output_value" != true ] || fatal 'Fuzzel output option requires a value'

if [ "$have_output" != true ] && [ -n "${WAYBAR_OUTPUT_NAME:-}" ]; then
  fuzzel_output=$WAYBAR_OUTPUT_NAME
  validate_output_name "$fuzzel_output"
  set -- "--output=${fuzzel_output}" "$@"
elif [ -n "$fuzzel_output" ]; then
  validate_output_name "$fuzzel_output"
fi

internal_output=false
if [ -n "$fuzzel_output" ] && fuzzel_output_is_internal "$fuzzel_output"; then
  internal_output=true
fi

case "$mode:$internal_output" in
  launcher:true) config_name=fuzzel-internal.ini ;;
  launcher:false) config_name=fuzzel.ini ;;
  menu:true) config_name=menu-internal.ini ;;
  menu:false) config_name=menu.ini ;;
  *) fatal 'invalid Fuzzel mode or output class' ;;
esac

# Main/category menus share the launcher's geometry, never the compact
# management-menu clamp. Their fonts/padding come from the same base files.
if [ "$main_menu" = true ]; then
  if [ "$internal_output" = true ]; then
    config_name=main-menu-internal.ini
    internal_menu_max_lines=40
    internal_menu_width=${LABWC_FUZZEL_INTERNAL_MAIN_MENU_WIDTH:-${LABWC_FUZZEL_INTERNAL_WIDTH:-28}}
    internal_menu_lines=${LABWC_FUZZEL_INTERNAL_MAIN_MENU_LINES:-${LABWC_FUZZEL_INTERNAL_LINES:-10}}
  else
    config_name=main-menu.ini
  fi
fi

if [ "$have_config" != true ] && [ -r "${fuzzel_config_dir}/${config_name}" ]; then
  set -- "--config=${fuzzel_config_dir}/${config_name}" "$@"
fi

if [ "$mode" = menu ]; then
  if [ -n "$menu_width_override" ]; then
    require_uint_range LABWC_FUZZEL_MENU_WIDTH_OVERRIDE "$menu_width_override" 16 200
  fi
  if [ -n "$menu_lines_override" ]; then
    require_uint_range LABWC_FUZZEL_MENU_LINES_OVERRIDE "$menu_lines_override" 1 32
  fi
  if [ -n "$menu_font_size_override" ]; then
    require_uint_range LABWC_FUZZEL_MENU_FONT_SIZE_OVERRIDE "$menu_font_size_override" 8 32
  fi
  if [ "$internal_output" = true ]; then
    require_uint_range LABWC_FUZZEL_INTERNAL_MENU_WIDTH "$internal_menu_width" 16 200
    require_uint_range LABWC_FUZZEL_INTERNAL_MENU_LINES "$internal_menu_lines" 1 "$internal_menu_max_lines"
    require_uint_range LABWC_FUZZEL_INTERNAL_FONT_SIZE "$internal_font_size" 8 32
    if [ -n "$menu_width_override" ] &&
       [ "$menu_width_override" -gt "$internal_menu_width" ]; then
      menu_width_override=$internal_menu_width
    fi
    if [ -n "$menu_lines_override" ] &&
       [ "$menu_lines_override" -gt "$internal_menu_lines" ]; then
      menu_lines_override=$internal_menu_lines
    fi
    if [ -n "$menu_font_size_override" ] &&
       [ "$menu_font_size_override" -gt "$internal_font_size" ]; then
      menu_font_size_override=$internal_font_size
    fi
  fi
  if [ -n "$menu_width_override" ]; then
    set -- "$@" "--width=${menu_width_override}"
  fi
  if [ -n "$menu_lines_override" ]; then
    set -- "$@" "--lines=${menu_lines_override}"
  fi
  if [ -n "$menu_font_size_override" ]; then
    menu_font="Noto Sans:size=${menu_font_size_override},Noto Color Emoji:size=${menu_font_size_override},Font Awesome 6 Free:size=${menu_font_size_override},Symbols Nerd Font Mono:size=${menu_font_size_override}"
    set -- "$@" "--font=${menu_font}"
  fi
fi

runtime_root=${XDG_RUNTIME_DIR:-}
case "$runtime_root" in
  /*) ;;
  *)
    fatal 'XDG_RUNTIME_DIR must name an absolute Fuzzel runtime directory'
    ;;
esac
[ -d "$runtime_root" ] && [ -w "$runtime_root" ] || {
  fatal "Fuzzel runtime directory is unavailable: $runtime_root"
}

lock_path="${runtime_root%/}/labwc-fuzzel.lock"
pid_path="${runtime_root%/}/labwc-fuzzel.pid"
exec 8>"$lock_path"
if ! /usr/bin/flock -w 5 8; then
  fatal 'unable to acquire the Fuzzel launcher lock within five seconds'
fi

fuzzel_pid=
managed_dir=
raw_choices=
display_choices=
selection_file=
first_selection=

cleanup() {
  if [ -n "$fuzzel_pid" ]; then
    kill -TERM "$fuzzel_pid" >/dev/null 2>&1 || true
    wait "$fuzzel_pid" 2>/dev/null || true
    fuzzel_pid=
  fi
  rm -f -- "$pid_path"
  if [ -n "$managed_dir" ]; then
    rm -f -- "$raw_choices" "$display_choices" "$selection_file" "$first_selection"
    rmdir -- "$managed_dir" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

run_fuzzel() {
  exec 7<&0
  fuzzel "$@" <&7 >&1 2>&2 8>&- &
  fuzzel_pid=$!
  exec 7<&-
  printf '%s\n' "$fuzzel_pid" >"$pid_path"
  if wait "$fuzzel_pid"; then
    fuzzel_status=0
  else
    fuzzel_status=$?
  fi
  fuzzel_pid=
  rm -f -- "$pid_path"
  # Fuzzel uses 2 for dmenu cancellation and 1 for an error.
  # Keep the managed-picker API (0 selection, 1 cancel, 2 failure) stable;
  # never conflate a configuration/Wayland error with a cancelled selection.
  if [ "$mode" = menu ]; then
    case "$fuzzel_status" in
      2) fuzzel_status=1 ;;
      1) fuzzel_status=$MENU_FAILURE_STATUS ;;
    esac
  fi
  return "$fuzzel_status"
}

log_managed_menu_selection() {
  selection_kind=$1
  selection_value=$2

  [ -x /usr/local/bin/labwc-fuzzel-log ] || return 0
  case "$selection_value" in
    '⮞ '*) selection_value=${selection_value#'⮞ '} ;;
    ' '*) selection_value=${selection_value#' '} ;;
  esac
  if ! /usr/local/bin/labwc-fuzzel-log \
      menu \
      selected \
      "source=$managed_log_scope" \
      "kind=$selection_kind" \
      "selection=$selection_value" \
      >/dev/null
  then
    :
  fi
}

log_fuzzel_lifecycle() {
  lifecycle_kind=$1
  lifecycle_event=$2
  lifecycle_status=$3

  [ -x /usr/local/bin/labwc-fuzzel-log ] || return 0
  /usr/local/bin/labwc-fuzzel-log \
    "$lifecycle_kind" \
    "$lifecycle_event" \
    "source=$managed_log_scope" \
    "mode=$mode" \
    "status=$lifecycle_status" \
    >/dev/null || true
}

if [ "$mode" != menu ] ||
   [ "$managed_icons" != 1 ] ||
   [ "$nul_delimited" = true ]; then
  case "$mode" in
    menu) lifecycle_kind=menu ;;
    *) lifecycle_kind=action ;;
  esac
  log_fuzzel_lifecycle "$lifecycle_kind" opened 0
  if run_fuzzel "$@"; then
    fuzzel_status=0
  else
    fuzzel_status=$?
  fi
  log_fuzzel_lifecycle "$lifecycle_kind" completed "$fuzzel_status"
  exit "$fuzzel_status"
fi

umask 077
managed_dir=$(mktemp -d "${runtime_root%/}/labwc-fuzzel-menu.XXXXXX") || {
  fatal 'unable to create managed Fuzzel runtime directory'
}
raw_choices="${managed_dir}/raw"
display_choices="${managed_dir}/display"
selection_file="${managed_dir}/selection"
first_selection="${managed_dir}/selection.first"

if ! LC_ALL=C awk '
  {
    input_bytes += length($0) + 1
    if (index($0, sprintf("%c", 0)) || index($0, sprintf("%c", 31)) || index($0, "\r")) exit 1
    if (NR > 1024 || length($0) > 4096 || input_bytes > 1048576) {
      exit 1
    }
    print
  }
' >"$raw_choices"; then
  fatal 'managed Fuzzel input exceeds bounds or contains protocol controls'
fi

awk -v root_menu="$managed_root_menu" -v menu_prompt="$managed_prompt" '
function icon_for(label) {
  if (label == "System & Recovery") return "computer"
  if (label == "Network & Remote") return "network-workgroup"
  if (label == "Security & Accounts") return "security-high"
  if (label == "Devices & Desktop") return "preferences-desktop-display"
  if (label == "Containers & AI") return "applications-development"
  if (label == "Files & Documents") return "folder-documents"
  if (label == "Maintenance & Health") return "utilities-system-monitor"
  if (label == "Recovery & Repair") return "document-revert"
  if (label == "Protection & Firewall") return "security-high"
  if (label == "Users & Groups") return "system-users"
  if (label == "Connection Profiles") return "network-wired"
  if (label == "VPN Connections") return "network-vpn"
  if (label == "WireGuard Connections") return "network-vpn"
  if (label == "DNS Configuration") return "network-server"
  if (label == "Network Discovery") return "network-workgroup"
  if (label == "Remote Desktop") return "preferences-desktop-remote-desktop"
  if (label == "Displays & Layout") return "preferences-desktop-display"
  if (label == "Refresh Display Layout") return "view-refresh"
  if (label == "Power Profile") return "preferences-system-power-management"
  if (label == "Hardware Tuning") return "preferences-system"
  if (label == "Set Single Tuning Profile") return "preferences-system"
  if (label == "Generate Hardware Tuning Report") return "text-x-generic"
  if (label == "Start Automatic Tuning") return "media-playback-start"
  if (label == "Stop Automatic Tuning") return "media-playback-stop"
  if (label == "Enable Autostart Tuning at Boot") return "system-run"
  if (label == "Disable Autostart Tuning at Boot") return "process-stop"
  if (label == "Reset Hardware Tuning" || label == "Reset Profiles [All]") return "edit-undo"
  if (label ~ /^Set Performance Profile \[(Intel|Nvidia)\]$/) return "utilities-system-monitor"
  if (label ~ /^Set High Profile \[(Intel|Nvidia)\]$/) return "go-up"
  if (label ~ /^Set Balanced Profile \[(Intel|Nvidia)\]$/) return "preferences-system-power-management"
  if (label ~ /^Set Silent Profile \[(Intel|Nvidia)\]$/) return "battery"
  if (label == "Cancel - leave power policy unchanged") return "dialog-cancel"
  if (label == "Confirm: stop, disable and mask PPD; start tuning now and at boot" ||
      label == "Confirm: stop PPD and block its restart until tuning is stopped") return "dialog-warning"
  if (label == "Keyboard Layout") return "input-keyboard"
  if (label == "Audio Control") return "multimedia-volume-control"
  if (label == "Restart Dock") return "view-refresh"
  if (label == "Android Devices") return "phone"
  if (label == "Bluetooth Devices") return "bluetooth"
  if (label == "Brightness") return "display-brightness"
  if (label == "Containers") return "package-x-generic"
  if (label == "AI & Copilots") return "applications-development"
  if (label == "Documents & Media") return "folder-documents"
  if (label == "Drives & Backups") return "drive-harddisk"
  if (label == "Overview & Health") return "utilities-system-monitor"
  if (label == "Services & Logs") return "text-x-log"
  if (label == "Packages & Firmware") return "package-x-generic"
  if (label == "Storage & Filesystems") return "drive-harddisk"
  if (label == "Audio & Desktop") return "multimedia-volume-control"
  if (label == "Network & DNS") return "network-server"
  if (label == "Desktop & Services") return "preferences-desktop"
  if (label == "Packages & Boot") return "package-x-generic"
  if (label == "Snapshots & Storage") return "drive-harddisk"
  if (label == "Memory & Cleanup") return "edit-clear"
  if (label == "Back") return "go-previous"
  if (label == "← Back") return "go-previous"
  if (label == "Cancel") return "dialog-cancel"
  if (label == "Exit") return "system-log-out"

  if (label == "New Coding Session" ||
      label == "Resume Last Session" ||
      label == "Implement Task…" ||
      label == "Ask Llama…" ||
      label == "New Chat" ||
      label == "Resume Last Chat" ||
      label == "Change Model…" ||
      label == "Download New Model…" ||
      label == "Push-to-Talk" ||
      label == "Toggle Dictation" ||
      label == "Transcribe File…" ||
      label == "Transcribe Last Recording" ||
      label == "Live Captions" ||
      label == "Voice Note") return "applications-development"
  if (label == "Open Podbin Guide" || label == "Show FreeRDP Help") return "help-browser"
  if (label == "AppArmor Status") return "security-high"
  if (label == "Kernel Enablement" ||
      label == "Validate Drafts" ||
      label == "Activate Selected Draft") return "emblem-default"
  if (label == "Features ABI") return "applications-development"
  if (label == "Complain Events (24h)") return "document-open-recent"
  if (label == "Denied Events (24h)") return "dialog-warning"
  if (label == "Easyprof Draft" ||
      label == "Autodep Base Draft" ||
      label == "Logprof Draft Update" ||
      label == "Genprof Interactive Draft") return "text-x-generic"
  if (label == "List Drafts") return "view-list-details"
  if (label == "Show App Modes" || label == "Set App Mode") return "preferences-system"
  if (label == "Generate New Rules") return "document-edit"
  if (label == "Enforce All") return "system-lock-screen"
  if (label == "Complain All") return "dialog-warning"
  if (label == "Disable All" || label == "Disabled Profiles") return "process-stop"
  if (label == "Set App Audit Logging") return "preferences-system"
  if (label == "Preview Unknown Cleanup") return "system-search"
  if (label == "List Managed Users") return "system-users"
  if (label == "Show User Environment" || label == "Show Service Environment") return "preferences-system"
  if (label == "List Service Networks") return "network-workgroup"
  if (label == "Show Service Statistics") return "utilities-system-monitor"
  if (label == "Show Recent Service Logs") return "text-x-generic"
  if (label == "Aggressive Journal Vacuum") return "edit-delete"
  if (label ~ /^No (DOCX|PDF|Image|Markdown) files detected in Downloads, Documents, or Desktop$/) return "dialog-warning"
  if (label == "Finish selection") return "emblem-default"
  if (menu_prompt == "Digital Assets") {
    if (label == "DOCX Actions" ||
        label == "PDF Actions" ||
        label == "Image Actions") return "go-next"
  }
  if (menu_prompt == "DOCX Actions") {
    if (label == "Convert DOCX to PDF") return "application-pdf"
    if (label == "Convert DOCX to Markdown") return "text-markdown"
    if (label == "Convert DOCX to Plain Text") return "text-x-generic"
    if (label == "Convert DOCX to HTML") return "applications-development"
  }
  if (menu_prompt == "PDF Actions") {
    if (label == "Convert PDF to PNG" ||
        label == "Convert PDF to JPEG" ||
        label == "Extract Images from PDF") return "image-x-generic"
    if (label == "Convert PDF to DOCX") return "x-office-document"
    if (label == "Convert PDF to Plain Text") return "text-x-generic"
    if (label == "Convert Markdown to PDF") return "text-markdown"
    if (label == "Merge Multiple PDF'\''s") return "view-grid"
    if (label == "Split PDF (Burst to Pages)") return "edit-cut"
    if (label == "Extract Specific Pages") return "help-contents"
    if (label == "Remove Specific Pages") return "edit-delete"
    if (label == "Rotate Pages") return "object-rotate-right"
    if (label == "Edit PDF Content") return "document-edit"
    if (label == "Edit PDF Bookmarks" ||
        label == "Extract TOC / Bookmarks") return "bookmark-new"
    if (label == "Edit Hyperlinks and Typos") return "insert-link"
    if (label == "Clean / Repair Corrupted PDF") return "edit-undo"
    if (label == "Inspect PDF Structure") return "system-search"
    if (label == "Encrypt / Password Protect") return "system-lock-screen"
    if (label == "Decrypt / Remove Password") return "changes-allow"
    if (label == "Linearize (Optimize size for Web)") return "preferences-system"
    if (label == "Add Page Numbers") return "format-list-ordered"
    if (label == "Add Text Watermark") return "color-management"
  }
  if (menu_prompt == "Image Actions") {
    if (label == "Convert Any Image to PNG" ||
        label == "Convert Any Image to JPEG" ||
        label == "Convert Image to WebP") return "image-x-generic"
    if (label == "Resize Image") return "zoom-in"
    if (label == "Crop Image") return "transform-crop"
    if (label == "Rotate Image") return "object-rotate-right"
    if (label == "Flip (Horizontal)") return "object-flip-horizontal"
    if (label == "Flip (Vertical)") return "object-flip-vertical"
    if (label == "Convert to Grayscale") return "display-brightness"
    if (label == "Compress / Optimize PNG" ||
        label == "Compress / Optimize JPEG") return "preferences-system"
    if (label == "Create GIF from Images") return "video-x-generic"
    if (label == "Read Image Metadata") return "system-search"
    if (label == "Edit Image Metadata") return "document-edit"
  }
  if (menu_prompt == "DOCX Actions" ||
      menu_prompt == "PDF Actions" ||
      menu_prompt == "Image Actions") {
    if (label == "Read Metadata") return "system-search"
    if (label == "Edit Metadata") return "document-edit"
    if (label == "Remove All Metadata") return "edit-delete"
    if (menu_prompt == "DOCX Actions") return "x-office-document"
    if (menu_prompt == "PDF Actions") return "application-pdf"
    if (menu_prompt == "Image Actions") return "image-x-generic"
  }
  if (label ~ /(Wi-Fi|WiFi|Wireless|WLAN|Radio)/) return "network-wireless"
  if (label ~ /(WireGuard)/) return "security-high"
  if (label ~ /(VPN)/) return "network-vpn"
  if (label ~ /(DNS)/) return "network-wired"
  if (label ~ /(Resolver)/) return "system-search"
  if (label ~ /(WAN)/) return "applications-internet"
  if (label ~ /(LAN|Network)/) return "network-workgroup"
  if (label ~ /(Packet)/) return "package-x-generic"
  if (label ~ /(Port|Connection)/) return "network-connect"
  if (menu_prompt == "System") {
    if (label == "Show System Overview") return "computer"
    if (label == "Show Failed Services") return "dialog-warning"
    if (label == "Show Recent System Errors") return "dialog-error"
    if (label == "Show Kernel Warnings") return "dialog-warning"
    if (label == "Show Memory and Swap") return "utilities-system-monitor"
    if (label == "Check Package Health") return "package-x-generic"
    if (label == "List Pending Upgrades") return "go-down"
    if (label == "Inspect Service and Logs") return "text-x-generic"
    if (label == "Show Upgradeable Packages" || label == "Show Upgradable Packages") return "go-down"
    if (label == "Run Unattended Upgrades Now") return "view-refresh"
    if (label == "Show Failed System Units") return "dialog-warning"
    if (label == "Show Failed User Units") return "system-users"
    if (label == "Show Timers") return "preferences-system-time"
    if (label == "Test Mako Notification" || label == "Test Mako Notifications") return "preferences-desktop-notification"
  }
  if (menu_prompt == "ADB Server") {
    if (label == "Show Server Status") return "network-server"
    if (label == "Reconnect USB Devices") return "drive-removable-media-usb"
    if (label == "Reconnect Offline Devices") return "view-refresh"
    if (label == "Wait for Any Device (60s)") return "preferences-system-time"
    if (label == "List Devices with Details") return "phone"
    if (label == "Show Host Features") return "computer"
  }
  if (label ~ /(Delete|Wipe|Prune|Drop|Factory Reset|Remove|Unpair)/) return "edit-delete"
  if (label ~ /(Restart|Refresh|Reset|Rebuild|Rotate|Flush|Reload)/) return "object-rotate-right"
  if (label ~ /(Stop|Disable|Disconnect|Unmount|Hide)/) return "media-playback-stop"
  if (label ~ /(Start|Enable|Connect|Mount|Pair|Trust|Increase|Continue)/) return "media-playback-start"
  if (label ~ /(Create|Save|Backup|Snapshot|Manifest)/) return "document-save"
  if (label ~ /(Download|Pull|Retrieve)/) return "go-down"
  if (label ~ /(Upload|Push|Send)/) return "go-up"
  if (label ~ /(File|Folder|Directory|Path)/) return "folder"
  if (label ~ /(Open|Console|Shell|Terminal|Interactive)/) return "utilities-terminal"
  if (label ~ /(User|Group|Sudo|Account)/) return "system-users"
  if (label ~ /(Container|Podman|Image|Volume|Pod|Resource)/) return "package-x-generic"
  if (label ~ /(Remote Desktop|Display|Screen|Monitor)/) return "computer"
  if (label ~ /(Security|Rootkit|ClamAV|Hash|Vulnerab|Firewall)/) return "system-lock-screen"
  if (label ~ /(Phone|Android|ADB|Fastboot|Firmware)/) return "phone"
  if (label ~ /(Recovery|Repair|Timeshift|GRUB|Initramfs)/) return "edit-undo"
  if (label ~ /(Drive|Disk|Storage|Btrfs|NVMe|Filesystem)/) return "drive-harddisk"
  if (label ~ /(Bluetooth)/) return "bluetooth"
  if (label ~ /(Brightness|Power|Battery|Performance|Balanced)/) return "preferences-system-power-management"
  if (label ~ /(Audio|PipeWire|WirePlumber)/) return "multimedia-volume-control"
  if (label ~ /(Keyboard)/) return "input-keyboard"
  if (label ~ /(Audit|Inspect|Check|Show|List|Status|Info|Diagnose|Scan)/) return "system-search"
  if (label ~ /(Settings|Configuration|System|Service|Unit|Timer)/) return "preferences-system"
  if (label ~ /(Exit|Close)/) return "system-shutdown"
  return "go-next"
}
{
  label = $0
  icon_label = label
  # Legacy section markers are presentation only, never an app icon.
  sub(/^(⮞||★)[[:space:]]+/, "", icon_label)
  shown = icon_label
  if (root_menu != "1" &&
      (label == "Exit" || label == "Close" || label == "Cancel" ||
       label ~ /^[0-9]+[[:space:]]+Close$/)) shown = "← Back"
  # Distinct raw rows may have identical text after removing legacy markers.
  # Keep every presented choice unambiguous without changing its raw action.
  unique = shown
  serial = 1
  while (unique in presented) unique = shown " [" NR ":" serial++ "]"
  presented[unique] = 1
  printf "%s%cicon%c%s\n", unique, 0, 31, icon_for(shown)
}
' "$raw_choices" >"$display_choices"

if [ "$managed_root_menu" != 1 ] &&
   ! awk '
     $0 == "Back" ||
     $0 == "← Back" ||
     $0 == "Exit" ||
     $0 == "Close" ||
     $0 == "Cancel" ||
     $0 ~ /^[0-9]+[[:space:]]+Close$/ {
       found = 1
     }
     END { exit found ? 0 : 1 }
   ' "$raw_choices"; then
  printf '\n' >>"$raw_choices"
  printf '← Back\000icon\037go-previous\n' >>"$display_choices"
fi

log_fuzzel_lifecycle menu opened 0
if run_fuzzel "$@" <"$display_choices" >"$selection_file"; then
  fuzzel_status=0
else
  fuzzel_status=$?
fi
log_fuzzel_lifecycle menu completed "$fuzzel_status"
[ "$fuzzel_status" -eq 0 ] || exit "$fuzzel_status"

# A picker result must contain at most one row. Never truncate extra rows
# into an apparently valid privileged-action selection.
if ! awk 'END { exit NR > 1 ? 1 : 0 }' "$selection_file"; then
  fatal 'Fuzzel returned more than one selection'
fi
sed -n '1p' "$selection_file" >"$first_selection"
selection=$(cat "$first_selection")
[ -n "$selection" ] || exit 0

matched_line=$(
  awk '
    NR == FNR {
      selected = $0
      next
    }
    {
      # Fuzzel returns only the text, not the icon metadata after the NUL.
      shown = $0
      sub(/\000.*/, "", shown)
      if (shown == selected) { print FNR; exit }
    }
  ' "$first_selection" "$display_choices"
)

if [ -n "$matched_line" ]; then
  raw_selection=$(sed -n "${matched_line}p" "$raw_choices")
  log_managed_menu_selection listed "$raw_selection"
  printf '%s\n' "$raw_selection"
else
  # Do not write arbitrary free-form Fuzzel input to the system log.
  log_managed_menu_selection custom-input redacted
  printf '%s\n' "$selection"
fi
