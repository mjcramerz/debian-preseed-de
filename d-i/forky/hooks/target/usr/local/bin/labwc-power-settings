#!/bin/sh
set -eu

# No arguments retain the existing CPU power-profile menu. Explicit actions
# use the same authenticated, session-safe path as the Waybar power menu.
if [ "$#" -ne 0 ]; then
  [ "$#" -eq 1 ] || exit 64
  case "$1" in
    lock) exec /usr/local/bin/labwc-lock ;;
    logout) exec /usr/local/bin/labwc-logout ;;
    suspend|reboot|poweroff) exec /usr/local/bin/labwc-admin-action "$1" ;;
    *) printf 'usage: labwc-power-settings [lock|logout|suspend|reboot|poweroff]\n' >&2; exit 64 ;;
  esac
fi

command -v labwc-fuzzel >/dev/null 2>&1 || {
  printf 'fatal: labwc-fuzzel is not installed\n' >&2
  exit 1
}

command -v powerprofilesctl >/dev/null 2>&1 || {
  printf 'fatal: powerprofilesctl is not installed\n' >&2
  exit 1
}

current_profile=$(powerprofilesctl get 2>/dev/null || true)
profile_list=$(powerprofilesctl list 2>/dev/null || true)
choices=

for profile in performance balanced power-saver; do
  case "$profile_list" in
    *"$profile:"*)
      label=$profile
      [ "$profile" = "$current_profile" ] && label="${label} (current)"
      choices="${choices}${choices:+
}${label}"
      ;;
  esac
done

[ -n "$choices" ] || {
  printf 'fatal: no power profiles are available\n' >&2
  exit 1
}

selection=$(
  printf '%s\n' "$choices" |
    labwc-fuzzel menu --dmenu --prompt "CPU power profile (${current_profile:-unknown})" 2>/dev/null ||
    true
)

[ -n "$selection" ] || exit 0

case "$selection" in
  performance*) selected_profile=performance ;;
  balanced*) selected_profile=balanced ;;
  power-saver*) selected_profile=power-saver ;;
  *)
    printf 'fatal: unsupported power profile selection: %s\n' "$selection" >&2
    exit 1
    ;;
esac

[ "$selected_profile" = "$current_profile" ] && exit 0

exec powerprofilesctl set "$selected_profile"
