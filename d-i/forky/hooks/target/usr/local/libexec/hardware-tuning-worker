#!/usr/bin/python3 -I
"""Root worker entrypoint; only root-owned modules are imported."""
import ctypes
import json
import os
from pathlib import Path
import signal
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, "/usr/local/lib/hardware_tuning")
from common import TuningError
from engine import main

def interrupted(signum, _frame):
    raise TuningError("worker interrupted by signal " + str(signum))

if __name__ == "__main__":
    try:
        # Enter the hardware AppArmor domain before prohibiting later privilege
        # gains; this worker never executes any other program.
        recovery = sys.argv[1:] == ["recover-all"] or (len(sys.argv) == 3 and sys.argv[2] == "reset")
        if not recovery:
            label = Path("/proc/self/attr/current").read_text(encoding="ascii").strip()
            if label != "managed-hardware-tuning-worker (enforce)":
                raise TuningError("an enforced hardware worker AppArmor profile is required")
        libc = ctypes.CDLL(None, use_errno=True)
        if libc.prctl(38, 1, 0, 0, 0) != 0:
            raise OSError(ctypes.get_errno(), "PR_SET_NO_NEW_PRIVS failed")
        for sig in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, interrupted)
        raise SystemExit(main(sys.argv[1:]))
    except Exception as exc:
        print(json.dumps({"ok": False, "error": str(exc)}))
        raise SystemExit(1)
