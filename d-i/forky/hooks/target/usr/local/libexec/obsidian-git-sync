#!/bin/sh
set -eu
umask 077
[ "$#" -eq 0 ] || exit 64
# The desktop session unlock is explicit. Never decrypt a passphrase from a
# timer or push using an unrelated identity from the user's agent.
# shellcheck disable=SC1091
. /usr/local/libexec/ssh-checks
if ! managed_ssh_context || ! managed_ssh_socket ||
   ! /usr/bin/ssh-add -T "$public" >/dev/null 2>&1; then
  printf '%s\n' 'obsidian-git-sync: unlock the managed identity with git-ssh unlock; retrying next hour' >&2
  exit 0
fi
exec /usr/bin/python3 -I /usr/local/libexec/obsidian-git-sync.py
