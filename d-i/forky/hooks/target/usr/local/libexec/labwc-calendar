#!/bin/sh
# A fixed user service owns Calix, its bootstrap and all sync workers.
set -eu
[ "$#" -eq 0 ] || { printf '%s\n' 'labwc-calendar: no arguments supported' >&2; exit 2; }
/usr/local/libexec/labwc-session-check session-ready || exit 1
if ! /usr/bin/systemctl --user start labwc-calix.service; then
  printf '%s\n' 'labwc-calendar: Calix startup failed; check the user keyring and service log' >&2
  exit 1
fi
# Native GApplication forwards activation to the service's existing instance.
export GDK_BACKEND=wayland
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
exec /opt/calix/calix
