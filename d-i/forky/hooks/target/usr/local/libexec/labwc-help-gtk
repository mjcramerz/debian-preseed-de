#!/usr/bin/python3 -IB
"""Load the root-owned Help package without user Python paths or bytecode writes."""
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, '/usr/local/lib/python3.14/dist-packages')
from labwc_help.app import main

if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, ImportError) as error:
        print('Help could not start. Check the installed GTK4/libadwaita dependencies and managed Help assets.', file=sys.stderr)
        raise SystemExit(1)
