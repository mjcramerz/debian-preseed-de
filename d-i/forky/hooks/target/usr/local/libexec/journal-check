#!/usr/bin/python3 -IB
"""Check the effective native journald policy without changing it or journal data.

The installer and rsyslog ExecStartPre use the same check. systemd-analyze
resolves native main-file, drop-in, same-basename and /dev/null mask precedence;
we validate the resulting settings rather than assuming a filename wins.
"""
from __future__ import annotations

from pathlib import Path
import os
import stat
import subprocess
import sys

MANAGED = Path('/etc/systemd/journald.conf.d/10-storage.conf')
FORWARDING = Path('/run/systemd/journald.conf.d/90-rsyslog-forwarding.conf')
FORWARDING_BYTES = b'[Journal]\nForwardToSyslog=yes\n'
CRITICAL = ('Storage', 'ForwardToSyslog', 'ReadKMsg', 'Seal',
            'MaxLevelStore', 'MaxLevelSyslog', 'RateLimitIntervalSec', 'RateLimitBurst')


class PolicyError(ValueError):
    pass


def journal_settings(text: str, *, unique: bool = False) -> dict[str, str]:
    section = ''
    values: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        # cat-config emits a path header before each independently parsed file.
        # A drop-in without [Journal] must not inherit the previous file's section.
        if line.startswith('# /') and line.endswith('.conf'):
            section = ''
            continue
        if not line or line.startswith(('#', ';')):
            continue
        if line.startswith('['):
            section = line
            continue
        if section != '[Journal]' or '=' not in line:
            continue
        key, value = (part.strip() for part in line.split('=', 1))
        if key not in CRITICAL:
            continue
        if unique and key in values:
            raise PolicyError(f'duplicate managed journal directive: {key}')
        # The managed values are deliberately simple scalars. Refuse multiline
        # continuations/unknown values instead of guessing at their semantics.
        values[key] = value
    return values


def forwarding_enabled() -> bool:
    """Recognize only the exact root-owned override published by the owner unit."""
    try:
        fd = os.open(FORWARDING, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except FileNotFoundError:
        return False
    with os.fdopen(fd, 'rb') as stream:
        metadata = os.fstat(stream.fileno())
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
                or metadata.st_gid != 0 or metadata.st_nlink != 1
                or stat.S_IMODE(metadata.st_mode) != 0o644
                or stream.read(len(FORWARDING_BYTES) + 1) != FORWARDING_BYTES):
            raise PolicyError('unsafe managed forwarding override')
        for parent in FORWARDING.parents:
            metadata = parent.lstat()
            if (not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != 0
                    or metadata.st_mode & 0o022):
                raise PolicyError('unsafe managed forwarding directory')
    return True


def check(managed_text: str, effective_text: str, *, forwarding: bool = False) -> None:
    managed = journal_settings(managed_text, unique=True)
    if managed.get('Storage') not in ('persistent', 'volatile'):
        raise PolicyError('managed Storage must be persistent or volatile')
    if managed.get('ForwardToSyslog') != 'no' or managed.get('ReadKMsg') != 'no':
        raise PolicyError('managed imuxsock/imklog input policy is incomplete')
    if managed.get('Seal') not in ('yes', 'no'):
        raise PolicyError('managed Seal must be explicitly yes or no')
    if (managed.get('MaxLevelStore') != 'debug'
            or managed.get('MaxLevelSyslog') != 'info'
            or managed.get('RateLimitIntervalSec') != '30s'
            or managed.get('RateLimitBurst') != '10000'):
        raise PolicyError('managed journal must retain system diagnostics with bounded burst protection')
    if managed['Storage'] == 'volatile' and managed['Seal'] != 'no':
        raise PolicyError('volatile journals must not claim forward-secure sealing')
    effective = journal_settings(effective_text)
    expected = dict(managed, ForwardToSyslog='yes' if forwarding else 'no')
    for key in CRITICAL:
        if effective.get(key) != expected[key]:
            raise PolicyError(f'effective {key}={effective.get(key)!r} conflicts with '
                              f'managed {key}={expected[key]}; review native journal drop-ins')


def main() -> int:
    if sys.argv[1:] not in ([], ['--require-forwarding']):
        raise PolicyError('usage: journal-check [--require-forwarding]')
    metadata = MANAGED.lstat()
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1
            or metadata.st_uid != 0 or metadata.st_mode & 0o022):
        raise PolicyError('unsafe managed journal policy file')
    result = subprocess.run(
        ['/usr/bin/systemd-analyze', 'cat-config', 'systemd/journald.conf'],
        env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C',
             'SYSTEMD_COLORS': '0', 'SYSTEMD_PAGER': 'cat'},
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, timeout=15, check=False,
    )
    if result.returncode:
        raise PolicyError('systemd-analyze could not resolve journald configuration: '
                          + result.stderr.strip()[:1024])
    forwarding = forwarding_enabled()
    if sys.argv[1:] and not forwarding:
        raise PolicyError('ready rsyslog has no managed forwarding override')
    check(MANAGED.read_text(encoding='utf-8'), result.stdout, forwarding=forwarding)
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, UnicodeError, subprocess.SubprocessError, PolicyError) as exc:
        print(f'journal-check: {exc}', file=sys.stderr)
        raise SystemExit(1)
