#!/usr/bin/python3 -I
"""Wait for the private Codex app-server backend socket."""

from __future__ import annotations

import errno
import os
import socket
import struct
import stat
import sys
import time


BACKEND_SOCKET = "/data/codex/sockets/app-server-backend.sock"
READY_TIMEOUT_SECONDS = 60.0
POLL_INTERVAL_SECONDS = 0.05


def fail(message: str) -> int:
    print(f"codex-app-server-wait-ready: {message}", file=sys.stderr)
    return 1


def main(arguments: list[str]) -> int:
    if arguments:
        return fail("this managed helper accepts no arguments")

    deadline = time.monotonic() + READY_TIMEOUT_SECONDS
    account_uid = os.getuid()
    while time.monotonic() < deadline:
        try:
            metadata = os.lstat(BACKEND_SOCKET)
        except FileNotFoundError:
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        except OSError as exc:
            return fail(f"cannot inspect the backend socket: {exc}")

        if not stat.S_ISSOCK(metadata.st_mode):
            return fail("the backend endpoint is not a Unix socket")
        if metadata.st_uid != account_uid:
            return fail("the backend socket is not owned by the service account")
        if stat.S_IMODE(metadata.st_mode) & 0o077:
            return fail("the backend socket grants group or other access")
        # A filesystem socket can exist before listen(), or remain after a
        # failed backend. Only a successful connection means proxy readiness.
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                probe.settimeout(min(1.0, max(0.001, deadline - time.monotonic())))
                probe.connect(BACKEND_SOCKET)
                pid, peer_uid, _peer_gid = struct.unpack(
                    "3i", probe.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                          struct.calcsize("3i")))
                if pid <= 0 or peer_uid != account_uid:
                    return fail("the listening peer is not the service account")
                current = os.lstat(BACKEND_SOCKET)
                if ((current.st_dev, current.st_ino) != (metadata.st_dev, metadata.st_ino)
                        or current.st_uid != account_uid
                        or stat.S_IMODE(current.st_mode) & 0o077):
                    return fail("the backend endpoint changed during readiness probing")
            return 0
        except (FileNotFoundError, ConnectionRefusedError, socket.timeout):
            pass
        except OSError as exc:
            if exc.errno not in {errno.EAGAIN, errno.EINTR}:
                return fail(f"cannot connect to the backend socket: {exc}")
        time.sleep(POLL_INTERVAL_SECONDS)

    return fail(f"the backend socket did not become ready within {READY_TIMEOUT_SECONDS:g} seconds")


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
