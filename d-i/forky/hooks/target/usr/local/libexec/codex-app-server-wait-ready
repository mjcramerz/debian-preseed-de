#!/usr/bin/python3 -I
"""Wait for the private Codex app-server backend socket."""

from __future__ import annotations

import errno
import hashlib
import os
import socket
import struct
import stat
import sys
import time


BACKEND_SOCKET = "/data/codex/sockets/app-server-backend.sock"
READY_TIMEOUT_SECONDS = 60.0
POLL_INTERVAL_SECONDS = 0.05


def endpoint_snapshot(account_uid: int):
    """Accept a direct socket or Codex's exact protected rendezvous alias."""
    parent = os.path.dirname(BACKEND_SOCKET)
    parent_stat = os.lstat(parent)
    if (not stat.S_ISDIR(parent_stat.st_mode) or parent_stat.st_uid != account_uid
            or stat.S_IMODE(parent_stat.st_mode) & 0o077):
        raise ValueError('the backend socket directory is not private to the service account')
    entry = os.lstat(BACKEND_SOCKET)
    target = BACKEND_SOCKET
    if stat.S_ISLNK(entry.st_mode):
        if entry.st_uid != account_uid:
            raise ValueError('the backend alias is not owned by the service account')
        # Recent Codex uses SHA-256(canonical advertised path) under this
        # fixed 0700 per-UID directory. Never follow an arbitrary symlink.
        directory = os.path.join(os.path.realpath('/tmp'), f'codex-daemon-{account_uid}')
        advertised = os.path.join(os.path.realpath(parent), os.path.basename(BACKEND_SOCKET))
        expected = os.path.join(directory, hashlib.sha256(os.fsencode(advertised)).hexdigest())
        if os.readlink(BACKEND_SOCKET) != expected:
            raise ValueError('the backend alias does not name its protected Codex socket')
        private = os.lstat(directory)
        if (not stat.S_ISDIR(private.st_mode) or private.st_uid != account_uid
                or stat.S_IMODE(private.st_mode) != 0o700):
            raise ValueError('the protected Codex socket directory is unsafe')
        target = expected
    metadata = os.lstat(target)
    if not stat.S_ISSOCK(metadata.st_mode):
        raise ValueError('the backend endpoint is not a Unix socket')
    if metadata.st_uid != account_uid or stat.S_IMODE(metadata.st_mode) & 0o077:
        raise ValueError('the backend socket is not private to the service account')
    return target, (entry.st_dev, entry.st_ino, metadata.st_dev, metadata.st_ino)


def fail(message: str) -> int:
    print(f"codex-app-server-wait-ready: {message}", file=sys.stderr)
    return 1


def main(arguments: list[str]) -> int:
    if arguments:
        return fail("this managed helper accepts no arguments")

    deadline = time.monotonic() + READY_TIMEOUT_SECONDS
    account_uid = os.getuid()
    while time.monotonic() < deadline:
        try:
            target, identity = endpoint_snapshot(account_uid)
        except FileNotFoundError:
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        except OSError as exc:
            return fail(f"cannot inspect the backend socket: {exc}")
        except ValueError as exc:
            return fail(str(exc))
        # A filesystem socket can exist before listen(), or remain after a
        # failed backend. Only a successful connection means proxy readiness.
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                probe.settimeout(min(1.0, max(0.001, deadline - time.monotonic())))
                probe.connect(target)
                pid, peer_uid, _peer_gid = struct.unpack(
                    "3i", probe.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                          struct.calcsize("3i")))
                if pid <= 0 or peer_uid != account_uid:
                    return fail("the listening peer is not the service account")
                if endpoint_snapshot(account_uid) != (target, identity):
                    return fail("the backend endpoint changed during readiness probing")
            return 0
        except (FileNotFoundError, ConnectionRefusedError, socket.timeout):
            pass
        except OSError as exc:
            if exc.errno not in {errno.EAGAIN, errno.EINTR}:
                return fail(f"cannot connect to the backend socket: {exc}")
        except ValueError as exc:
            return fail(str(exc))
        time.sleep(POLL_INTERVAL_SECONDS)

    return fail(f"the backend socket did not become ready within {READY_TIMEOUT_SECONDS:g} seconds")


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
