#!/usr/bin/python3 -IB
"""Own the transient journald forwarding switch for the rsyslog lifecycle.

Called only by rsyslog-journal-forwarding.service. No journal restart, sleep,
replay, persistent policy rewrite or change to authenticated rsyslog inputs.
"""
from __future__ import annotations

import os
from pathlib import Path
import stat
import subprocess
import sys
import tempfile

DIRECTORY = Path('/run/systemd/journald.conf.d')
POLICY = DIRECTORY / '90-rsyslog-forwarding.conf'
CONTENT = b'[Journal]\nForwardToSyslog=yes\n'
ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C',
       'SYSTEMD_COLORS': '0', 'SYSTEMD_PAGER': 'cat'}


class ForwardingError(ValueError):
    pass


def directory(*, create: bool) -> None:
    for parent in reversed((DIRECTORY, *DIRECTORY.parents)):
        if parent == DIRECTORY and create:
            try:
                parent.mkdir(mode=0o755)
            except FileExistsError:
                pass
        metadata = parent.lstat()
        if (not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != 0
                or metadata.st_mode & 0o022):
            raise ForwardingError('unsafe forwarding policy directory')


def existing_policy() -> bool:
    try:
        fd = os.open(POLICY, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except FileNotFoundError:
        return False
    with os.fdopen(fd, 'rb') as stream:
        metadata = os.fstat(stream.fileno())
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
                or metadata.st_gid != 0 or metadata.st_nlink != 1
                or stat.S_IMODE(metadata.st_mode) != 0o644
                or stream.read(len(CONTENT) + 1) != CONTENT):
            raise ForwardingError('foreign or unsafe forwarding policy; left intact')
    return True


def command(args: list[str]) -> None:
    # Commands have fixed arguments and no unbounded captured output. Their
    # diagnostics go to this unit's journal; each wait has its own hard limit.
    result = subprocess.run(args, env=ENV, stdin=subprocess.DEVNULL,
                            stdout=subprocess.DEVNULL, timeout=10, check=False)
    if result.returncode:
        raise ForwardingError('forwarding command failed: ' + args[0])


def apply() -> None:
    command(['/usr/local/libexec/journal-check'])
    # A normal reload job would wait behind our ordered stop job. Ignore job
    # dependencies only for this reload of an already-running journald; never
    # start/restart it. Type=notify-reload acknowledges completion in systemd 262.
    command(['/usr/bin/systemctl', '--no-ask-password', '--job-mode=ignore-dependencies',
             'reload', 'systemd-journald.service'])


def disable() -> None:
    try:
        directory(create=False)
    except FileNotFoundError:
        # Still reload: a preceding interrupted enable may have removed the
        # file before journald acknowledged the off configuration.
        pass
    else:
        if existing_policy():
            POLICY.unlink()
    try:
        apply()
    except (OSError, subprocess.SubprocessError, ForwardingError) as exc:
        raise ForwardingError(f'disable failed ({exc}); forwarding outcome unknown') from exc


def enable() -> None:
    directory(create=True)
    existing_policy()  # Refuse a foreign path instead of replacing it.
    fd, temporary = tempfile.mkstemp(prefix='.rsyslog-forwarding-', dir=DIRECTORY)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(CONTENT)
            os.fchmod(stream.fileno(), 0o644)
        os.replace(temporary, POLICY)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    try:
        apply()
    except subprocess.TimeoutExpired as exc:
        # A timed-out client does not prove the manager's reload job stopped.
        # Keep the override as evidence; do not retry that uncertain enable.
        # The unit's separate stop path owns deactivation.
        raise ForwardingError('enable timed out; forwarding outcome unknown; override retained') from exc
    except (OSError, subprocess.SubprocessError, ForwardingError) as exc:
        try:
            disable()
        except (OSError, subprocess.SubprocessError, ForwardingError) as recovery:
            raise ForwardingError(f'enable failed; forwarding outcome unknown after failed disable ({recovery})') from recovery
        raise ForwardingError(f'enable failed ({exc}); forwarding disabled') from exc


def main() -> int:
    if os.geteuid() != 0 or sys.argv[1:] not in (['on'], ['off']):
        raise ForwardingError('expected root and exactly on or off')
    if sys.argv[1] == 'on':
        enable()
    else:
        disable()
    print('journal-forwarding: state=' + sys.argv[1])
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, subprocess.SubprocessError, ForwardingError) as exc:
        print(f'journal-forwarding: {exc}', file=sys.stderr)
        raise SystemExit(1)
