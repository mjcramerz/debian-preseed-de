#!/usr/bin/python3
"""Repack Bitwarden so native-messaging proxies are copied without hard links."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import stat
import struct
import subprocess
import sys
import tempfile
from pathlib import Path


MAX_DEB_BYTES = 314_572_800
MAX_ASAR_BYTES = 268_435_456
MAX_ASAR_HEADER_BYTES = 67_108_864
MAX_MAIN_JS_BYTES = 67_108_864
EXPECTED_PACKAGE = "bitwarden"
EXPECTED_ARCHITECTURE = "amd64"
ASAR_RELATIVE_PATH = Path("opt/Bitwarden/resources/app.asar")
REQUIRED_PACKAGE_PATHS = (
    Path("opt/Bitwarden/bitwarden"),
    Path("opt/Bitwarden/chrome-sandbox"),
    Path("opt/Bitwarden/desktop_proxy"),
    Path("opt/Bitwarden/libffmpeg.so"),
    ASAR_RELATIVE_PATH,
    Path("usr/share/applications/bitwarden.desktop"),
)
HARD_LINK_LOG = b"[Native messaging] Hard-linked "
COPY_LOG = b"[Native messaging] Copied "
HARD_LINK_FAILURE = b"[Native messaging] Failed to hard-link "
PATCHED_COPY_LOG = b"[Native messaging] Copied file "
PATCHED_COPY_FAILURE = b"[Native messaging] Failed to copy file "


class PackageError(RuntimeError):
    """Raised when the vendor package does not match the managed contract."""


def fail(message: str) -> None:
    raise PackageError(message)


def require_absolute_path(label: str, value: str) -> Path:
    path = Path(value)
    if not path.is_absolute() or "\x00" in value:
        fail(f"{label} must be an absolute path")
    return path


def require_private_directory(path: Path) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        fail(f"work directory is unavailable: {exc}")
    if not stat.S_ISDIR(metadata.st_mode) or path.is_symlink():
        fail("work directory must be a real directory")
    if metadata.st_uid != os.geteuid() or metadata.st_mode & 0o077:
        fail("work directory must be owned by the caller with mode 0700")


def require_direct_child(label: str, path: Path, parent: Path) -> None:
    if path.parent != parent or path.name in {"", ".", ".."}:
        fail(f"{label} must be a direct child of the work directory")


def require_regular_owned_file(label: str, path: Path, maximum: int) -> os.stat_result:
    try:
        metadata = path.lstat()
    except OSError as exc:
        fail(f"{label} is unavailable: {exc}")
    if not stat.S_ISREG(metadata.st_mode) or path.is_symlink():
        fail(f"{label} must be a regular file")
    if metadata.st_uid != os.geteuid() or metadata.st_mode & 0o022:
        fail(f"{label} has unsafe ownership or mode")
    if metadata.st_size <= 0 or metadata.st_size > maximum:
        fail(f"{label} has an invalid size")
    return metadata


def run(command: list[str], *, capture: bool = False) -> str:
    environment = {
        "HOME": "/root" if os.geteuid() == 0 else str(Path.home()),
        "LC_ALL": "C.UTF-8",
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    }
    try:
        completed = subprocess.run(
            command,
            check=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=environment,
            text=True,
            timeout=300,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        fail(f"command failed: {command[0]}: {exc}")
    return completed.stdout if capture else ""


def package_field(path: Path, field: str) -> str:
    value = run(["/usr/bin/dpkg-deb", "-f", str(path), field], capture=True).strip()
    if not value or "\n" in value or "\r" in value or "\x00" in value:
        fail(f"Bitwarden package has an invalid {field} field")
    return value


def package_identity(path: Path) -> tuple[str, str, str]:
    package = package_field(path, "Package")
    version = package_field(path, "Version")
    architecture = package_field(path, "Architecture")
    if package != EXPECTED_PACKAGE:
        fail("downloaded package is not Bitwarden")
    if architecture != EXPECTED_ARCHITECTURE:
        fail("Bitwarden package architecture is not amd64")
    run(["/usr/bin/dpkg", "--validate-version", version])
    return package, version, architecture


def require_extracted_payload(root: Path) -> None:
    for relative_path in REQUIRED_PACKAGE_PATHS:
        path = root / relative_path
        try:
            metadata = path.lstat()
        except OSError as exc:
            fail(f"Bitwarden package is missing {relative_path}: {exc}")
        if not stat.S_ISREG(metadata.st_mode) or path.is_symlink():
            fail(f"Bitwarden package path is not a regular file: {relative_path}")
        if metadata.st_uid != os.geteuid() or metadata.st_mode & 0o022:
            fail(f"Bitwarden package path has unsafe ownership or mode: {relative_path}")


def parse_asar_main(fd: int, archive_size: int) -> tuple[int, int]:
    prefix = os.pread(fd, 8, 0)
    if len(prefix) != 8:
        fail("Bitwarden app.asar header is truncated")
    outer_payload_size, header_pickle_size = struct.unpack("<II", prefix)
    if outer_payload_size != 4:
        fail("Bitwarden app.asar outer pickle is invalid")
    if (
        header_pickle_size < 8
        or header_pickle_size > MAX_ASAR_HEADER_BYTES
        or header_pickle_size % 4
        or 8 + header_pickle_size > archive_size
    ):
        fail("Bitwarden app.asar header size is invalid")

    header_pickle = os.pread(fd, header_pickle_size, 8)
    if len(header_pickle) != header_pickle_size:
        fail("Bitwarden app.asar header pickle is truncated")
    payload_size, json_size = struct.unpack("<II", header_pickle[:8])
    if payload_size != header_pickle_size - 4:
        fail("Bitwarden app.asar header pickle payload is invalid")
    if json_size <= 0 or json_size > payload_size - 4:
        fail("Bitwarden app.asar JSON size is invalid")
    padding = header_pickle[8 + json_size :]
    if len(padding) > 3 or any(padding):
        fail("Bitwarden app.asar header padding is invalid")
    try:
        header = json.loads(header_pickle[8 : 8 + json_size].decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        fail(f"Bitwarden app.asar header JSON is invalid: {exc}")
    if not isinstance(header, dict) or not isinstance(header.get("files"), dict):
        fail("Bitwarden app.asar file table is invalid")
    main = header["files"].get("main.js")
    if not isinstance(main, dict) or "files" in main or "link" in main or main.get("unpacked"):
        fail("Bitwarden app.asar does not contain the expected packed main.js")
    size = main.get("size")
    offset_value = main.get("offset")
    if (
        not isinstance(size, int)
        or isinstance(size, bool)
        or size <= 0
        or size > MAX_MAIN_JS_BYTES
        or not isinstance(offset_value, str)
        or re.fullmatch(r"0|[1-9][0-9]*", offset_value) is None
    ):
        fail("Bitwarden app.asar main.js metadata is invalid")
    offset = int(offset_value)
    content_offset = 8 + header_pickle_size + offset
    if content_offset < 8 + header_pickle_size or content_offset + size > archive_size:
        fail("Bitwarden app.asar main.js extent is invalid")
    return content_offset, size


def read_asar_main(path: Path, *, writable: bool) -> tuple[int, bytes]:
    metadata = require_regular_owned_file("Bitwarden app.asar", path, MAX_ASAR_BYTES)
    flags = (os.O_RDWR if writable else os.O_RDONLY) | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags)
    except OSError as exc:
        fail(f"Bitwarden app.asar cannot be opened safely: {exc}")
    try:
        content_offset, size = parse_asar_main(fd, metadata.st_size)
        main = os.pread(fd, size, content_offset)
        if len(main) != size:
            fail("Bitwarden app.asar main.js is truncated")

        return content_offset, main
    finally:
        os.close(fd)


def link_or_copy_region(main: bytes, failure_marker: bytes) -> tuple[int, int, int]:
    warning_offset = main.find(failure_marker)
    if warning_offset < 0:
        fail("Bitwarden main.js native-messaging failure marker was not found")
    method_offset = main.rfind(b"linkOrCopy(", max(0, warning_offset - 32768), warning_offset)
    if method_offset < 0:
        fail("Bitwarden main.js linkOrCopy method was not found")
    return method_offset, warning_offset, main.find(b".link(", method_offset, warning_offset)


def verify_patched_asar(path: Path) -> None:
    _, main = read_asar_main(path, writable=False)
    method_offset, warning_offset, link_call_offset = link_or_copy_region(
        main,
        PATCHED_COPY_FAILURE,
    )
    if (
        main.count(HARD_LINK_LOG)
        or main.count(HARD_LINK_FAILURE)
        or main.count(PATCHED_COPY_LOG) != 3
        or main.count(PATCHED_COPY_FAILURE) != 1
        or link_call_offset >= 0
        or main.count(b".cp  (", method_offset, warning_offset) != 1
    ):
        fail("Bitwarden app.asar does not enforce direct native-messaging copies")


def patch_asar(path: Path) -> None:
    content_offset, main = read_asar_main(path, writable=True)

    if main.count(HARD_LINK_LOG) != 3:
        fail("Bitwarden main.js hard-link success contract changed")
    if main.count(COPY_LOG) != 1:
        fail("Bitwarden main.js copy success contract changed")
    if main.count(HARD_LINK_FAILURE) != 1:
        fail("Bitwarden main.js hard-link failure contract changed")
    method_offset, warning_offset, link_call_offset = link_or_copy_region(
        main,
        HARD_LINK_FAILURE,
    )
    if link_call_offset < 0 or main.find(b".link(", link_call_offset + 1, warning_offset) >= 0:
        fail("Bitwarden main.js linkOrCopy call contract changed")

    patched = bytearray(main)
    patched[link_call_offset + 1 : link_call_offset + 5] = b"cp  "
    patched = patched.replace(HARD_LINK_LOG, PATCHED_COPY_LOG)
    patched = patched.replace(HARD_LINK_FAILURE, PATCHED_COPY_FAILURE)
    if len(patched) != len(main):
        fail("Bitwarden main.js patch changed the ASAR payload size")
    if (
        patched.count(HARD_LINK_LOG)
        or patched.count(HARD_LINK_FAILURE)
        or patched.count(PATCHED_COPY_LOG) != 3
        or patched.count(PATCHED_COPY_FAILURE) != 1
        or patched.find(b".link(", method_offset, warning_offset) >= 0
        or patched.find(b".cp  (", method_offset, warning_offset) < 0
    ):
        fail("Bitwarden main.js patch did not reach the required state")

    flags = os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags)
    except OSError as exc:
        fail(f"Bitwarden app.asar cannot be reopened safely: {exc}")
    try:
        written = os.pwrite(fd, patched, content_offset)
        if written != len(patched):
            fail("Bitwarden app.asar main.js patch was incomplete")
        os.fsync(fd)
    finally:
        os.close(fd)
    verify_patched_asar(path)


def md5_file(path: Path) -> str:
    digest = hashlib.md5(usedforsecurity=False)
    try:
        with path.open("rb") as handle:
            while chunk := handle.read(1024 * 1024):
                digest.update(chunk)
    except OSError as exc:
        fail(f"Bitwarden app.asar cannot be hashed: {exc}")
    return digest.hexdigest()


def update_md5sums(root: Path) -> None:
    md5sums = root / "DEBIAN/md5sums"
    require_regular_owned_file("Bitwarden package md5sums", md5sums, 16_777_216)
    try:
        raw = md5sums.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        fail(f"Bitwarden package md5sums cannot be read: {exc}")
    target = ASAR_RELATIVE_PATH.as_posix()
    rewritten: list[str] = []
    matches = 0
    for line in raw.splitlines():
        match = re.fullmatch(r"([0-9a-f]{32})  ([^\x00\r\n]+)", line)
        if match is None:
            fail("Bitwarden package md5sums has an invalid record")
        if match.group(2) == target:
            matches += 1
            digest = md5_file(root / ASAR_RELATIVE_PATH)
            line = f"{digest}  {target}"
        rewritten.append(line)
    if matches != 1:
        fail("Bitwarden package md5sums does not identify app.asar exactly once")
    temporary = md5sums.with_name("md5sums.managed-new")
    if temporary.exists() or temporary.is_symlink():
        fail("Bitwarden package md5sums temporary path already exists")
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
            handle.write("\n".join(rewritten) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, md5sums)
    except OSError as exc:
        try:
            temporary.unlink()
        except OSError:
            pass
        fail(f"Bitwarden package md5sums cannot be updated: {exc}")


def transform(source: Path, destination: Path, work_directory: Path) -> None:
    require_private_directory(work_directory)
    require_direct_child("source package", source, work_directory)
    require_direct_child("destination package", destination, work_directory)
    if source == destination:
        fail("source and destination packages must differ")
    require_regular_owned_file("source package", source, MAX_DEB_BYTES)
    if destination.exists() or destination.is_symlink():
        fail("destination package already exists")
    source_identity = package_identity(source)

    scratch = Path(tempfile.mkdtemp(prefix=".bitwarden-package.", dir=work_directory))
    try:
        os.chmod(scratch, 0o700)
        extracted = scratch / "root"
        run(["/usr/bin/dpkg-deb", "--raw-extract", str(source), str(extracted)])
        require_extracted_payload(extracted)
        patch_asar(extracted / ASAR_RELATIVE_PATH)
        update_md5sums(extracted)
        run(
            [
                "/usr/bin/dpkg-deb",
                "--root-owner-group",
                "--build",
                str(extracted),
                str(destination),
            ]
        )
        os.chmod(destination, 0o600)
        require_regular_owned_file("repacked package", destination, MAX_DEB_BYTES)
        if package_identity(destination) != source_identity:
            fail("Bitwarden repack changed the Debian package identity")
    except Exception:
        try:
            destination.unlink()
        except OSError:
            pass
        raise
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def main() -> int:
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    transform_parser = subparsers.add_parser("transform")
    transform_parser.add_argument("--source", required=True)
    transform_parser.add_argument("--destination", required=True)
    transform_parser.add_argument("--work-directory", required=True)
    verify_parser = subparsers.add_parser("verify")
    verify_parser.add_argument("--asar", required=True)
    options = parser.parse_args()
    try:
        if options.command == "transform":
            source = require_absolute_path("source package", options.source)
            destination = require_absolute_path("destination package", options.destination)
            work_directory = require_absolute_path("work directory", options.work_directory)
            transform(source, destination, work_directory)
        else:
            asar = require_absolute_path("Bitwarden app.asar", options.asar)
            verify_patched_asar(asar)
    except (OSError, PackageError) as exc:
        print(f"managed-bitwarden-package: fatal: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
