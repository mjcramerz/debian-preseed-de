#!/usr/bin/python3 -I
"""Session-scoped Tomat control. No shell, daemonization, PID killing or root use.

Waybar execs `watch`; systemd owns the independent foreground daemon. All command
and preset dispatch is closed. The stock Tomat system/user units are masked by
installation. Config settings are atomic and restart only our transient unit;
RuntimeDirectoryPreserve=restart keeps the upstream timer state across restart.
"""
from __future__ import annotations

import contextlib
import fcntl
import json
import math
import os
from pathlib import Path
import pwd
import re
import secrets
import socket
import stat
import struct
import subprocess
import sys
import time
import tomllib

UNIT = "labwc-tomat.service"
TARGET = "labwc-session.target"
DESCRIPTION = "Managed Tomat session daemon"
TOMAT = "/usr/bin/tomat"
SYSTEMCTL = "/usr/bin/systemctl"
MAX_CONFIG = 65_536
PRESETS = {"default": (), "25": ("25", "5"), "50": ("50", "10"), "90": ("90", "15")}
PROPERTIES = (
    f"Description={DESCRIPTION}", f"Requisite={TARGET}", f"After={TARGET}",
    f"PartOf={TARGET}", "Slice=app.slice", "ExitType=cgroup", "KillMode=control-group",
    "Restart=on-failure", "RestartSec=3s", "StartLimitIntervalSec=60s", "StartLimitBurst=3",
    "TimeoutStartSec=10s", "TimeoutStopSec=5s", "UMask=0077", "LimitCORE=0",
    "RuntimeDirectory=labwc-tomat", "RuntimeDirectoryMode=0700",
    "RuntimeDirectoryPreserve=restart", "NoNewPrivileges=yes",
    "RestrictAddressFamilies=AF_UNIX", "RestrictNamespaces=yes",
    "RestrictSUIDSGID=yes", "RestrictRealtime=yes", "LockPersonality=yes",
    "MemoryDenyWriteExecute=yes", "SystemCallArchitectures=native",
    "TasksMax=64", "MemoryHigh=128M", "MemoryMax=256M", "CPUWeight=50",
    "StandardOutput=journal", "StandardError=journal", "SyslogIdentifier=labwc-tomat",
    "UnsetEnvironment=DISPLAY XAUTHORITY LD_PRELOAD LD_LIBRARY_PATH PYTHONPATH PYTHONHOME",
)


class Error(RuntimeError):
    pass


def check_directory(path: Path, uid: int, *, private: bool = False) -> None:
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid or info.st_mode & 0o022:
        raise Error(f"unsafe directory ownership/type/mode: {path}")
    if private and info.st_mode & 0o077:
        raise Error(f"runtime directory must be private: {path}")


def validate_config(text: str) -> dict:
    """Fail visibly rather than letting Tomat silently fall back on parse error."""
    if len(text.encode("utf-8")) > MAX_CONFIG:
        raise Error("Tomat configuration is too large")
    data = tomllib.loads(text)
    allowed = {
        "timer": {"work", "break", "long_break", "sessions", "auto_advance"},
        "sound": {"mode", "volume", "enabled", "system_beep", "use_embedded",
                  "work_to_break", "break_to_work", "work_to_long_break"},
        "notification": {"enabled", "timeout", "icon", "urgency", "work_message",
                         "break_message", "long_break_message"},
        "display": {"text_format", "text_format_idle", "icons"},
        "hooks": {"on_break_start", "on_long_break_start"},
    }
    if set(data) - set(allowed):
        raise Error("unsupported top-level Tomat configuration key")
    for name, keys in allowed.items():
        table = data.get(name, {})
        if not isinstance(table, dict) or set(table) - keys:
            raise Error(f"[{name}] must contain only supported TOML keys")

    def strings(table: dict, keys: tuple[str, ...]) -> None:
        for key in keys:
            if key in table and (not isinstance(table[key], str) or len(table[key]) > 8192
                                 or "\x00" in table[key]):
                raise Error(f"{key} must be a bounded string without NUL")
    timer = data.get("timer", {})
    # Match upstream's public duration/session constraints, excluding bool/NaN.
    for key, default in (("work", 45.0), ("break", 5.0), ("long_break", 15.0)):
        value = timer.get(key, default)
        if type(value) not in (int, float) or not math.isfinite(value) or not 0 < value <= 600:
            raise Error(f"timer.{key} must be a finite duration in (0, 600] minutes")
    sessions = timer.get("sessions", 3)
    if type(sessions) is not int or not 1 <= sessions <= 100:
        raise Error("timer.sessions must be an integer in [1, 100]")
    if timer.get("auto_advance", "to-break") not in ("all", "none", "to-break", "to-work"):
        raise Error("unsupported timer.auto_advance")
    sound = data.get("sound", {})
    if sound.get("mode", "embedded") not in ("none", "embedded", "system-beep"):
        raise Error("unsupported sound.mode")
    for key in ("enabled", "system_beep", "use_embedded"):
        if key in sound and type(sound[key]) is not bool:
            raise Error(f"sound.{key} must be boolean")
    strings(sound, ("work_to_break", "break_to_work", "work_to_long_break"))
    volume = sound.get("volume", 0.3)
    if type(volume) not in (int, float) or not math.isfinite(volume) or not 0 <= volume <= 1:
        raise Error("sound.volume must be between zero and one")
    notification = data.get("notification", {})
    if type(notification.get("enabled", True)) is not bool:
        raise Error("notification.enabled must be boolean")
    timeout = notification.get("timeout", 8000)
    if type(timeout) is not int or not 0 <= timeout <= 2_147_483_647:
        raise Error("notification.timeout must be a non-negative signed 32-bit integer")
    strings(notification, ("icon", "work_message", "break_message", "long_break_message"))
    if notification.get("urgency", "normal") not in ("low", "normal", "critical"):
        raise Error("unsupported notification.urgency")
    display = data.get("display", {})
    strings(display, ("text_format", "text_format_idle"))
    icons = display.get("icons", {})
    icon_keys = ("work", "break", "long_break", "play", "pause", "stop")
    if not isinstance(icons, dict) or set(icons) - set(icon_keys):
        raise Error("display.icons must contain supported icon names")
    strings(icons, icon_keys)
    # Keep managed hooks bounded and non-shell. New arbitrary commands belong
    # in an explicitly reviewed policy, not in this daemon's authority.
    for event, hook in data.get("hooks", {}).items():
        expected = {"on_break_start": ["break"], "on_long_break_start": ["long-break"]}
        if (event not in expected or not isinstance(hook, dict)
                or set(hook) != {"cmd", "args", "timeout", "capture_output"}
                or hook.get("cmd") != "/usr/local/libexec/labwc-tomat-hook"
                or hook.get("args") != expected[event]
                or type(hook.get("timeout")) is not int or not 1 <= hook["timeout"] <= 5
                or hook.get("capture_output") is not True):
            raise Error(f"unapproved or unbounded Tomat hook: {event}")
    return data


def change_setting(text: str, setting: str) -> tuple[str, str]:
    data = validate_config(text)
    if setting == "notifications":
        section, key = "notification", "enabled"
        value = "false" if data.get(section, {}).get(key, True) else "true"
        description = "Notifications " + ("enabled" if value == "true" else "disabled")
    elif setting == "sounds":
        section, key = "sound", "mode"
        value = '"embedded"' if data.get(section, {}).get(key, "embedded") == "none" else '"none"'
        description = "Sounds " + ("disabled" if value == '"none"' else "enabled")
    else:
        raise Error("unsupported setting")
    # Retain unrelated keys and comments; refuse ambiguous quoted/inline table
    # styles rather than rewriting the user's entire configuration.
    lines = text.splitlines(keepends=True)
    section_start = section_end = None
    in_section = False
    found = False
    for index, line in enumerate(lines):
        table = re.fullmatch(r"\s*\[\s*([a-zA-Z0-9_.-]+)\s*\]\s*(?:#.*)?", line.rstrip("\r\n"))
        if table:
            if in_section:
                section_end = index
                in_section = False
            if table[1] == section:
                section_start = index
                in_section = True
        if in_section:
            match = re.fullmatch(r"(\s*" + key + r"\s*=\s*)(true|false|\"[^\"]*\"|'[^']*')(\s*(?:#.*)?)", line.rstrip("\r\n"))
            if match:
                lines[index] = match[1] + value + match[3] + "\n"
                found = True
    if not found:
        if key in data.get(section, {}):
            raise Error(f"edit {section}.{key} manually: the menu requires a simple table/key assignment")
        if section_start is None:
            if section in data:
                raise Error(f"edit [{section}] manually: inline/quoted table layout is not rewritten")
            lines.append(f"\n[{section}]\n{key} = {value}\n")
        else:
            index = section_end if section_end is not None else len(lines)
            if index and not lines[index - 1].endswith(("\n", "\r")):
                lines[index - 1] += "\n"
            lines.insert(index, f"{key} = {value}\n")
    result = "".join(lines)
    validate_config(result)
    return result, description


class Context:
    def __init__(self) -> None:
        self.uid = os.getuid()
        if self.uid == 0 or os.geteuid() != self.uid:
            raise Error("Tomat must run as the logged-in, unprivileged desktop user")
        self.home = Path(pwd.getpwuid(self.uid).pw_dir)
        if not self.home.is_absolute():
            raise Error("account home is not absolute")
        self.runtime = Path(f"/run/user/{self.uid}")
        if os.environ.get("XDG_RUNTIME_DIR", str(self.runtime)) != str(self.runtime):
            raise Error("XDG_RUNTIME_DIR does not match the current account")
        check_directory(self.runtime, self.uid, private=True)
        for path in (self.home, self.home / ".config", self.home / ".config/tomat"):
            check_directory(path, self.uid)
        self.directory = self.home / ".config/tomat"
        self.config = self.directory / "config.toml"
        self.env = {
            "HOME": str(self.home), "USER": pwd.getpwuid(self.uid).pw_name,
            "LOGNAME": pwd.getpwuid(self.uid).pw_name,
            "PATH": "/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8",
            "XDG_RUNTIME_DIR": str(self.runtime), "XDG_CONFIG_HOME": str(self.home / ".config"),
            "XDG_CACHE_HOME": str(self.home / ".cache"),
            "DBUS_SESSION_BUS_ADDRESS": f"unix:path={self.runtime}/bus",
            "TOMAT_RUNTIME_DIR": str(self.runtime / "labwc-tomat"),
            "TOMAT_CONFIG": str(self.config), "TOKIO_WORKER_THREADS": "2",
        }

    def run(self, argv: list[str], *, timeout: float = 10, check: bool = True) -> subprocess.CompletedProcess:
        result = subprocess.run(argv, env=self.env, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                text=True, timeout=timeout, check=False)
        if len(result.stdout) + len(result.stderr) > MAX_CONFIG:
            raise Error("command returned excessive output")
        if check and result.returncode:
            detail = result.stderr.strip()[:1024] or result.stdout.strip()[:1024]
            raise Error(f"{Path(argv[0]).name} failed: {detail}")
        return result

    @contextlib.contextmanager
    def locked(self):
        # Outside RuntimeDirectory: systemd may remove the latter on final stop.
        # O_NONBLOCK refuses a malicious FIFO without waiting for another end.
        fd = os.open(self.runtime / "labwc-tomat-control.lock",
                     os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, 0o600)
        try:
            info = os.fstat(fd)
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != self.uid
                    or info.st_mode & 0o077 or info.st_nlink != 1):
                raise Error("unsafe Tomat controller lock")
            deadline = time.monotonic() + 12
            while True:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        raise Error("another Tomat control operation is still in progress")
                    time.sleep(0.05)
            yield
        finally:
            os.close(fd)

    @contextlib.contextmanager
    def config_file(self):
        directory_fd = os.open(self.directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            fd = os.open("config.toml", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                         dir_fd=directory_fd)
            with os.fdopen(fd, "rb") as stream:
                info = os.fstat(stream.fileno())
                if (not stat.S_ISREG(info.st_mode) or info.st_uid != self.uid
                        or info.st_mode & 0o022 or info.st_size > MAX_CONFIG or info.st_nlink != 1):
                    raise Error("unsafe Tomat config type, owner, permissions or size")
                blob = stream.read(MAX_CONFIG + 1)
            text = blob.decode("utf-8")
            validate_config(text)
            yield directory_fd, info, text
        finally:
            os.close(directory_fd)

    def show(self) -> dict[str, str]:
        fields = "LoadState,ActiveState,Transient,Description,MainPID"
        result = self.run([SYSTEMCTL, "--user", "show", f"--property={fields}", UNIT], check=False)
        values = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
        if not values.get("LoadState"):
            raise Error("cannot query the desktop user manager")
        return values

    @staticmethod
    def owned(values: dict[str, str]) -> None:
        if values.get("Transient") != "yes" or values.get("Description") != DESCRIPTION:
            raise Error(f"refusing to control an unrelated/static unit named {UNIT}")

    def session_ready(self) -> None:
        self.run([SYSTEMCTL, "--user", "is-active", "--quiet", TARGET])
        result = self.run([SYSTEMCTL, "--user", "is-active", "--quiet", "tomat.service"], check=False)
        if result.returncode == 0:
            raise Error("the unscoped tomat.service is already active; refusing a competing daemon")

    def ready(self, pid: int) -> None:
        directory = self.runtime / "labwc-tomat"
        check_directory(directory, self.uid, private=True)
        path = directory / "tomat.sock"
        info = path.lstat()
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != self.uid:
            raise Error("unsafe Tomat socket")
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(1)
            client.connect(str(path))
            peer_pid, peer_uid, _ = struct.unpack("3i", client.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
            if peer_uid != self.uid or peer_pid != pid or pid <= 0:
                raise Error("Tomat socket does not belong to the managed daemon")
            client.sendall(b'{"command":"status","args":null}\n')
            data = bytearray()
            while b"\n" not in data:
                part = client.recv(4096)
                if not part or len(data) + len(part) > MAX_CONFIG:
                    raise Error("invalid or oversized Tomat readiness response")
                data.extend(part)
            response = json.loads(data.split(b"\n", 1)[0])
            if not isinstance(response, dict) or response.get("success") is not True:
                raise Error("Tomat daemon did not become ready")

    def wait_ready(self) -> None:
        deadline = time.monotonic() + 8
        last_error = "not yet listening"
        while time.monotonic() < deadline:
            values = self.show()
            self.owned(values)
            if values.get("ActiveState") == "failed":
                raise Error(f"{UNIT} failed; inspect journalctl --user -u {UNIT}")
            try:
                self.ready(int(values.get("MainPID", "0")))
                self.session_ready()
                return
            except (OSError, ValueError, Error) as exc:
                last_error = str(exc)
                time.sleep(0.1)
        raise Error(f"Tomat readiness timed out: {last_error}")

    def ensure(self) -> None:
        self.session_ready()
        with self.config_file():
            pass
        values = self.show()
        if values["LoadState"] == "not-found":
            command = ["/usr/bin/systemd-run", "--user", "--quiet", f"--unit={UNIT}",
                       "--service-type=exec", "--expand-environment=no"]
            command += ["--property=" + prop for prop in PROPERTIES]
            command += ["--setenv=" + key + "=" + value for key, value in self.env.items()]
            # Deliberately NO --collect: failed units retain their start limit.
            # Successful final stop still collects this transient unit normally.
            command += ["--", TOMAT, "daemon", "run"]
            self.run(command)
        else:
            self.owned(values)
            if values.get("ActiveState") == "failed":
                raise Error(f"{UNIT} is failed; repair it before systemctl --user reset-failed {UNIT}")
            if values.get("ActiveState") == "inactive":
                self.run([SYSTEMCTL, "--user", "start", UNIT])
        self.wait_ready()

    def setting(self, name: str) -> None:
        with self.config_file() as (directory_fd, old_stat, text):
            replacement, message = change_setting(text, name)
            temporary = ".config.toml." + secrets.token_hex(12)
            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                         0o600, dir_fd=directory_fd)
            try:
                with os.fdopen(fd, "wb") as stream:
                    stream.write(replacement.encode("utf-8"))
                    stream.flush()
                    os.fsync(stream.fileno())
                current = os.stat("config.toml", dir_fd=directory_fd, follow_symlinks=False)
                if ((current.st_dev, current.st_ino, current.st_mtime_ns, current.st_size)
                        != (old_stat.st_dev, old_stat.st_ino, old_stat.st_mtime_ns, old_stat.st_size)):
                    raise Error("config changed concurrently; no settings were overwritten")
                os.replace(temporary, "config.toml", src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
                os.fsync(directory_fd)
            finally:
                with contextlib.suppress(FileNotFoundError):
                    os.unlink(temporary, dir_fd=directory_fd)
        # Upstream reads notification/sound/hooks at daemon startup, not SIGHUP.
        self.owned(self.show())
        self.run([SYSTEMCTL, "--user", "restart", UNIT])
        self.wait_ready()
        print(message)


def main(argv: list[str]) -> int:
    if not argv or argv[0] not in {"watch", "ensure", "start", "toggle", "skip", "stop", "settings", "config"}:
        raise Error("usage: labwc-tomat watch|ensure|start [default|25|50|90]|toggle|skip|stop|settings notifications|sounds|config")
    action = argv[0]
    if action == "start":
        if len(argv) > 2 or (len(argv) == 2 and argv[1] not in PRESETS):
            raise Error("invalid Tomat start preset")
    elif action == "settings":
        if len(argv) != 2 or argv[1] not in {"notifications", "sounds"}:
            raise Error("invalid Tomat settings action")
    elif len(argv) != 1:
        raise Error("unexpected Tomat arguments")
    context = Context()
    if action == "config":
        # Opening a broken file for repair must not require successful TOML parse
        # or daemon startup. The editor is native Wayland, never Xwayland.
        context.session_ready()
        environment = dict(context.env, GDK_BACKEND="wayland", QT_QPA_PLATFORM="wayland")
        display = os.environ.get("WAYLAND_DISPLAY", "")
        if not re.fullmatch(r"wayland-[0-9]+", display):
            raise Error("no managed Wayland display is available")
        environment["WAYLAND_DISPLAY"] = display
        environment["XDG_SESSION_TYPE"] = "wayland"
        os.execve("/usr/bin/featherpad", ["/usr/bin/featherpad", str(context.config)], environment)
    with context.locked():
        context.ensure()
        if action == "settings":
            context.setting(argv[1])
            return 0
    if action == "ensure":
        return 0
    if action == "watch":
        command = [TOMAT, "watch", "--interval", "1", "--output", "waybar"]
    elif action == "start":
        values = PRESETS[argv[1] if len(argv) == 2 else "default"]
        command = [TOMAT, "--quiet", "start"]
        if values:
            command += ["--work", values[0], "--break", values[1]]
    else:
        command = [TOMAT, "--quiet", action]
    # CLI controls connect only; they never invoke `daemon start` or stop PIDs.
    os.execve(TOMAT, command, context.env)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (Error, OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f"labwc-tomat: {exc}", file=sys.stderr)
        if sys.argv[1:2] == ["watch"]:
            print(json.dumps({"text": "\U0001f345 !", "class": "error", "tooltip": str(exc)[:1024]}), flush=True)
        raise SystemExit(1)
