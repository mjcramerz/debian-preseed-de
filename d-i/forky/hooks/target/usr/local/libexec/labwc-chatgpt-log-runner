#!/usr/bin/perl
use strict;
use warnings;

use Errno qw(EAGAIN EINTR EWOULDBLOCK);
use Fcntl qw(F_GETFL F_SETFL O_NONBLOCK);
use IO::Select;
use IPC::Open3 qw(open3);
use POSIX qw(WNOHANG);
use Socket qw(AF_UNIX SOCK_DGRAM sockaddr_un);
use Symbol qw(gensym);

use constant {
    CHILD_EXECUTABLE        => '/usr/local/bin/labwc-managed-app',
    LOG_PRIORITY_ERROR      => 11,
    LOG_PRIORITY_INFO       => 14,
    LOG_PRIORITY_WARNING    => 12,
    MAXIMUM_ARGUMENTS       => 128,
    MAXIMUM_ARGUMENT_BYTES  => 16_384,
    MAXIMUM_LINE_BYTES      => 1_800,
    READ_CHUNK_BYTES        => 8_192,
    SEND_RETRY_DELAY_SECS   => 0.02,
    SEND_RETRY_LIMIT        => 5,
    SESSION_EXECUTABLE      => '/usr/bin/setsid',
    SOCKET_PATH             => '/run/rsyslog/managed-openai/chatgpt.sock',
    SYSLOG_TAG              => 'managed-openai-chatgpt',
    TERMINATION_GRACE_SECS  => 5,
};

open STDOUT, '>', '/dev/null' or exit 70;
open STDERR, '>', '/dev/null' or exit 70;

my $log_socket;

sub _exit_status {
    my ($status) = @_;

    return 255 if !defined($status) || $status == -1;
    return 128 + ($status & 127) if $status & 127;
    return $status >> 8;
}

sub _sanitize_bytes {
    my ($value) = @_;

    $value = q{} if !defined $value;
    $value =~ s/([^\x20-\x7e])/sprintf('\x%02X', ord($1))/ge;
    return $value;
}

sub _syslog_timestamp {
    my @months = qw(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec);
    my @time = localtime();

    return sprintf(
        '%s %2d %02d:%02d:%02d',
        $months[$time[4]],
        $time[3],
        $time[2],
        $time[1],
        $time[0],
    );
}

sub _connect_log_socket {
    -S SOCKET_PATH
        or die "managed ChatGPT log socket is unavailable\n";
    socket($log_socket, AF_UNIX, SOCK_DGRAM, 0)
        or die "cannot create the managed ChatGPT log socket\n";
    connect($log_socket, sockaddr_un(SOCKET_PATH))
        or die "cannot connect to the managed ChatGPT log socket\n";

    my $flags = fcntl($log_socket, F_GETFL, 0);
    defined($flags)
        or die "cannot inspect the managed ChatGPT log socket\n";
    fcntl($log_socket, F_SETFL, $flags | O_NONBLOCK)
        or die "cannot make the managed ChatGPT log socket nonblocking\n";
    return;
}

sub _send_syslog {
    my ($priority, $message) = @_;

    defined($log_socket)
        or die "managed ChatGPT log socket is not connected\n";
    my $packet = sprintf(
        '<%d>%s %s[%d]: %s' . "\n\0",
        $priority,
        _syslog_timestamp(),
        SYSLOG_TAG,
        $$,
        $message,
    );
    for my $attempt (1 .. SEND_RETRY_LIMIT) {
        my $sent = send($log_socket, $packet, 0);
        if (defined $sent) {
            $sent == length($packet)
                or die "managed ChatGPT log datagram was truncated\n";
            return;
        }
        next if $! == EINTR;
        if ($! == EAGAIN || $! == EWOULDBLOCK) {
            select undef, undef, undef, SEND_RETRY_DELAY_SECS;
            next;
        }
        die "cannot send managed ChatGPT log datagram\n";
    }
    die "managed ChatGPT log socket remained unavailable\n";
}

sub _write_syslog_line {
    my ($stream, $line) = @_;

    $line = _sanitize_bytes($line);
    $line = '(empty line)' if $line eq q{};

    my $prefix = "stream=$stream message=";
    my $continuation = ' continued=true';
    my $available = MAXIMUM_LINE_BYTES - length($prefix);
    my $chunk_bytes = $available - length($continuation);
    $chunk_bytes > 0 or die "managed ChatGPT log line limit is too small\n";

    while (length($line) > $available) {
        my $chunk = substr($line, 0, $chunk_bytes, q{});
        _send_syslog(
            LOG_PRIORITY_INFO,
            "${prefix}${chunk}${continuation}",
        );
    }
    _send_syslog(LOG_PRIORITY_INFO, "${prefix}${line}");
    return;
}

sub _flush_complete_lines {
    my ($stream, $buffer_ref, $flush_all) = @_;

    while ($$buffer_ref =~ s/\A([^\n]*)\n//) {
        my $line = $1;
        $line =~ s/\r\z//;
        _write_syslog_line($stream, $line);
    }
    if ($flush_all && $$buffer_ref ne q{}) {
        my $line = $$buffer_ref;
        $line =~ s/\r\z//;
        _write_syslog_line($stream, $line);
        $$buffer_ref = q{};
    }
    while (length($$buffer_ref) > MAXIMUM_LINE_BYTES) {
        my $chunk = substr(
            $$buffer_ref,
            0,
            MAXIMUM_LINE_BYTES,
            q{},
        );
        _write_syslog_line($stream, $chunk);
    }
    return;
}

sub _wait_child {
    my ($pid) = @_;

    while (1) {
        my $waited = waitpid($pid, 0);
        return $? if $waited == $pid;
        next if $waited == -1 && $! == EINTR;
        die "cannot wait for managed ChatGPT child\n";
    }
}

sub _terminate_child {
    my ($pid) = @_;

    kill 'TERM', $pid;
    my $deadline = time() + TERMINATION_GRACE_SECS;
    while (time() < $deadline) {
        my $waited = waitpid($pid, WNOHANG);
        return if $waited == $pid || $waited == -1;
        select undef, undef, undef, 0.1;
    }
    kill 'KILL', $pid;
    eval { _wait_child($pid); 1 };
    return;
}

sub _validate_arguments {
    my (@arguments) = @_;

    @arguments >= 1 or die "managed ChatGPT launch mode is missing\n";
    @arguments <= MAXIMUM_ARGUMENTS + 1
        or die "managed ChatGPT argument count exceeds the limit\n";

    my $mode = shift @arguments;
    $mode =~ /\A(?:auto|launch|intel|nvidia)\z/
        or die "managed ChatGPT launch mode is invalid\n";
    for my $argument (@arguments) {
        defined($argument) or die "managed ChatGPT argument is undefined\n";
        length($argument) <= MAXIMUM_ARGUMENT_BYTES
            or die "managed ChatGPT argument exceeds the size limit\n";
    }
    return ($mode, @arguments);
}

my $status;
my $logger_ready = 0;
my $child_pid;
my $error = q{};

eval {
    my ($mode, @extra_arguments) = _validate_arguments(@ARGV);
    _connect_log_socket();
    $logger_ready = 1;
    _send_syslog(LOG_PRIORITY_INFO, "event=started mode=$mode");

    my ($stdin, $stdout);
    my $stderr = gensym();
    $child_pid = open3(
        $stdin,
        $stdout,
        $stderr,
        SESSION_EXECUTABLE,
        CHILD_EXECUTABLE,
        $mode,
        'chatgpt',
        @extra_arguments,
    );
    close $stdin or die "cannot close managed ChatGPT child input\n";
    undef $stdin;

    my $selector = IO::Select->new($stdout, $stderr);
    my %stream_for = (
        fileno($stdout) => 'stdout',
        fileno($stderr) => 'stderr',
    );
    my %buffer_for = (
        stdout => q{},
        stderr => q{},
    );
    my $termination_deadline;
    local $SIG{PIPE} = 'IGNORE';
    local $SIG{HUP} = sub {
        kill 'HUP', $child_pid if defined $child_pid;
        $termination_deadline //= time() + TERMINATION_GRACE_SECS;
    };
    local $SIG{INT} = sub {
        kill 'INT', $child_pid if defined $child_pid;
        $termination_deadline //= time() + TERMINATION_GRACE_SECS;
    };
    local $SIG{TERM} = sub {
        kill 'TERM', $child_pid if defined $child_pid;
        $termination_deadline //= time() + TERMINATION_GRACE_SECS;
    };

    while ($selector->count()) {
        if (
            defined($termination_deadline)
            && time() >= $termination_deadline
            && defined($child_pid)
        ) {
            kill 'KILL', $child_pid;
            undef $termination_deadline;
        }
        for my $handle ($selector->can_read(1)) {
            my $file_descriptor = fileno($handle);
            defined($file_descriptor)
                or die "managed ChatGPT output descriptor is unavailable\n";
            my $stream = $stream_for{$file_descriptor};
            defined($stream)
                or die "managed ChatGPT output stream is unknown\n";

            my $chunk = q{};
            my $bytes = sysread($handle, $chunk, READ_CHUNK_BYTES);
            if (!defined $bytes) {
                next if $! == EINTR;
                die "cannot read managed ChatGPT output\n";
            }
            if ($bytes == 0) {
                $selector->remove($handle);
                close $handle
                    or die "cannot close managed ChatGPT output\n";
                $stdout = undef if $stream eq 'stdout';
                $stderr = undef if $stream eq 'stderr';
                _flush_complete_lines(
                    $stream,
                    \$buffer_for{$stream},
                    1,
                );
                next;
            }
            $buffer_for{$stream} .= $chunk;
            _flush_complete_lines(
                $stream,
                \$buffer_for{$stream},
                0,
            );
        }
    }

    my $raw_status = _wait_child($child_pid);
    undef $child_pid;
    $status = _exit_status($raw_status);
    _send_syslog(
        $status == 0
            ? LOG_PRIORITY_INFO
            : LOG_PRIORITY_WARNING,
        "event=completed status=$status",
    );
    1;
} or $error = $@ || "managed ChatGPT execution failed\n";

if (defined $child_pid) {
    _terminate_child($child_pid);
    undef $child_pid;
}
if ($error ne q{} && $logger_ready) {
    eval {
        _send_syslog(LOG_PRIORITY_ERROR, 'event=failed');
        1;
    };
}
eval {
    close $log_socket if defined $log_socket;
    1;
};

exit 70 if $error ne q{};
exit(defined($status) ? $status : 70);
