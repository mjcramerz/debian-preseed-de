#!/usr/bin/perl
use strict;
use warnings;

use FindBin qw($Bin);
use File::Spec ();
use lib
    File::Spec->catdir(
        $Bin, '..', 'lib', 'perl5', 'site_perl', 'timeshift'
    ),
    '/usr/local/lib/perl5/site_perl/timeshift';

use TimeshiftManaged::CLI;

exit TimeshiftManaged::CLI->new(
    program => 'grub-btrfs-refresh',
)->run(@ARGV);
