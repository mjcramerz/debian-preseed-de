#!/bin/sh
# Only the confined Zoom/Discord compositor may execute this helper.
set -eu
unset LD_PRELOAD LD_AUDIT LD_DEBUG QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH
unset QT_QPA_PLATFORMTHEME QML_IMPORT_PATH QML2_IMPORT_PATH
unset WLR_BACKENDS WLR_RENDERER WLR_WL_OUTPUTS WLR_NO_HARDWARE_CURSORS WLR_XWAYLAND
unset LABWC_COMPAT_RUN_ID LABWC_COMPAT_CLIPBOARD LABWC_MANAGED_OUTER_WAYLAND_DISPLAY
LD_LIBRARY_PATH=/opt/xwayland/usr/lib/x86_64-linux-gnu
export LD_LIBRARY_PATH
exec /opt/xwayland/usr/bin/Xwayland "$@"
