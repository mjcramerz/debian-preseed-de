#!/usr/bin/perl -T
use strict;
use warnings;
use lib '/usr/local/lib/perl5/site_perl/filen';
use lib '/usr/local/lib/perl5/site_perl/runtime';
use FilenSync::Daemon;

@ARGV == 1 && $ARGV[0] =~ /\A(private|offsec)\z/
    or die "filen_sync outcome=invalid-configuration cause=account\n";
my $account = $1;
umask 0007;
my $status = eval { FilenSync::Daemon->new(account => $account)->run };
if ($@) {
    # Never print exception strings: third-party output may contain secrets
    # or filenames. The daemon emits bounded, structured failure categories.
    print STDERR "filen_sync account=$account outcome=failed cause=runtime\n";
    exit 1;
}
exit $status;
