#!/usr/bin/perl
use strict;
use warnings;

use FindBin qw($RealBin);
use File::Spec ();

use lib
    File::Spec->catdir(
        $RealBin, '..', 'lib', 'perl5', 'site_perl', 'zram-writeback'
    ),
    '/usr/local/lib/perl5/site_perl/zram-writeback';

$ENV{PATH} = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin';

use Zram::CLI;

exit Zram::CLI::run(@ARGV);
