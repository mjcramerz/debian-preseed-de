#!/usr/bin/perl -T
use strict;
use warnings;
use lib '/usr/local/lib/labwc-workspace-broker/perl5';
use Labwc::WorkspaceBroker::Broker ();
$ENV{PATH} = '/usr/local/bin:/usr/bin:/bin';
delete @ENV{qw(IFS CDPATH ENV BASH_ENV PERL5LIB PERLLIB PERL5OPT PYTHONPATH PYTHONHOME)};
my $ok = eval { Labwc::WorkspaceBroker::Broker::run(); 1 };
if (!$ok) { warn "workspace broker: $@"; exit 1; }
exit 0;
