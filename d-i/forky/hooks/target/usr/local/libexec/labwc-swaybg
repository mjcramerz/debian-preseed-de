#!/bin/sh
set -eu

if [ -r /etc/default/labwc-desktop ]; then
  # shellcheck disable=SC1091
  . /etc/default/labwc-desktop
fi

case "${LABWC_ENABLE_SWAYBG:-true}" in
  true|yes|1|on) ;;
  *) exit 0 ;;
esac

wallpaper_path=${LABWC_WALLPAPER_PATH:-/usr/share/backgrounds/desktop/wallpaper-1920x1080.png}
# One supervisor owns the background for the whole graphical session. Changes
# arrive through the validated state file; selections never restart the unit.
exec /usr/local/libexec/labwc-wallpaper-control supervise "$wallpaper_path"
