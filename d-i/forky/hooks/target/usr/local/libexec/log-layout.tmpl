OLD_AUTH = '/var/log/managed/auth/auth.log'
NEW_AUTH = '__INSTALLER_LOG_AUTH_FILE__'


class LayoutError(ValueError):
    pass


def directory_fd(root: Path, relative: str) -> int:
    """Open every component without following symlinks or writable parents."""
    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        for part in Path(relative).parts:
            if part in ('', '.', '..', '/'):
                raise LayoutError('invalid managed directory component')
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW |
                            os.O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = child
            info = os.fstat(fd)
            if info.st_uid != 0 or info.st_mode & 0o022:
                raise LayoutError(f'unsafe managed directory: /{relative}')
        return fd
    except BaseException:
        os.close(fd)
        raise


def check_layout(root: Path = Path('/'), preflight: bool = False) -> None:
    group = grp.getgrnam('__INSTALLER_LOG_GROUP__').gr_gid
    for absolute, mode in CATEGORIES.items():
        try:
            fd = directory_fd(root, absolute.lstrip('/'))
        except FileNotFoundError:
            if preflight:
                continue
            raise
        try:
            info = os.fstat(fd)
            if not preflight and (stat.S_IMODE(info.st_mode) != mode or info.st_gid != group):
                raise LayoutError(f'incorrect category permissions: {absolute}')
        finally:
            os.close(fd)
    for absolute in PROTECTED_FILES:
        path = Path(absolute)
        try:
            fd = directory_fd(root, str(path.parent).lstrip('/'))
        except FileNotFoundError:
            if preflight:
                continue
            raise
        try:
            try:
                info = os.stat(path.name, dir_fd=fd, follow_symlinks=False)
            except FileNotFoundError:
                if preflight:
                    continue
                raise
            if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or
                    info.st_uid != 0 or info.st_gid != group or
                    stat.S_IMODE(info.st_mode) != int('__INSTALLER_LOG_FILE_MODE__', 8)):
                raise LayoutError(f'unsafe protected log: {absolute}')
        finally:
            os.close(fd)
    try:
        fd = directory_fd(root, '__INSTALLER_LOG_RSYSLOG_SPOOL_DIR__'.lstrip('/'))
    except FileNotFoundError:
        if preflight:
            return
        raise
    try:
        if stat.S_IMODE(os.fstat(fd).st_mode) != 0o700:
            raise LayoutError('rsyslog cursor/queue directory must be private (0700)')
    finally:
        os.close(fd)


def migrate_auth_link(root: Path = Path('/')) -> None:
    fd = directory_fd(root, 'var/log')
    temp = f'.auth-link-{secrets.token_hex(12)}'
    created = False
    try:
        try:
            info = os.stat('auth.log', dir_fd=fd, follow_symlinks=False)
        except FileNotFoundError:
            return  # tmpfiles owns creation on new installations.
        if not stat.S_ISLNK(info.st_mode):
            return  # Preserve existing real logs and administrator configuration.
        if info.st_uid != 0 or os.readlink('auth.log', dir_fd=fd) != OLD_AUTH:
            return
        os.symlink(NEW_AUTH, temp, dir_fd=fd)
        created = True
        os.replace(temp, 'auth.log', src_dir_fd=fd, dst_dir_fd=fd)
        created = False
    finally:
        if created:
            os.unlink(temp, dir_fd=fd)
        os.close(fd)


def main() -> int:
    if sys.argv[1:] not in ([], ['--preflight']):
        raise LayoutError('usage: log-layout [--preflight]')
    preflight = len(sys.argv) == 2
    check_layout(preflight=preflight)
    if not preflight:
        migrate_auth_link()
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, KeyError, LayoutError) as exc:
        print(f'log-layout: {exc}', file=sys.stderr)
        raise SystemExit(1)
