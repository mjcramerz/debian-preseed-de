#!/usr/bin/python3 -IB
"""Run the fixed native dock, coalescing exact known upstream diagnostic floods.

Preserve the first occurrence, other diagnostics and the real exit status.
Output drains for a bounded interval after the child exits. This is a
journal-volume workaround, not a patch of the dock binary.
"""
import os
import selectors
import signal
import subprocess
import sys
import time

MESSAGES = {
    'crystal-dock': {b'LayerShellQt.Window.screenConfiguration is deprecated use screen and wantsToBeOnActiveScreen instead'},
}
SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGUSR1, signal.SIGUSR2)
OUTPUT_BUFFER_LIMIT = 262144


class OutputBuffer:
    """Batch writes without letting a full journal stall process supervision."""

    def __init__(self, stream):
        self.fd = stream.fileno()
        self.blocking = os.get_blocking(self.fd)
        self.pending = bytearray()
        os.set_blocking(self.fd, False)

    def write(self, data: bytes) -> None:
        self.pending.extend(data)

    def flush(self) -> None:
        # Coalescer queues complete lines; poll drives actual output writes.
        pass

    def drain(self) -> None:
        try:
            written = os.write(self.fd, self.pending)
        except BlockingIOError:
            return
        if not written:
            raise OSError('panel output made no progress')
        del self.pending[:written]

    def restore(self) -> None:
        os.set_blocking(self.fd, self.blocking)


class Coalescer:
    def __init__(self, messages: set[bytes], interval: float = 60.0):
        self.messages = messages
        self.interval = interval
        self.last = time.monotonic()
        self.seen = set()
        self.repeats = {}

    def line(self, stream, data: bytes) -> None:
        text = data.rstrip(b'\r\n')
        canonical = text
        key = (stream, canonical)
        if canonical in self.messages:
            if key in self.seen:
                self.repeats[key] = self.repeats.get(key, 0) + 1
                return
            self.seen.add(key)
        stream.write(data)
        stream.flush()

    def flush(self, final: bool = False) -> None:
        now = time.monotonic()
        if not final and now - self.last < self.interval:
            return
        for (stream, text), count in self.repeats.items():
            stream.write(b'[labwc-panel-run] repeated ' + str(count).encode() + b' times: ' + text + b'\n')
            stream.flush()
        self.repeats.clear()
        self.last = now


def supervise(command: list[str], messages: set[bytes], *, signals=SIGNALS) -> int:
    """Supervise the dock, preserving its exit status and bounded teardown.

    Output backpressure pauses child reads within a bounded queue. After exit,
    inherited writers and blocked output share the existing two-second drain
    budget. Waybar is directly supervised by systemd and never enters this adapter.
    """
    child = None
    pending = set()
    stop_at = None

    def forward(number, _frame):
        nonlocal stop_at
        if number in (signal.SIGINT, signal.SIGTERM):
            stop_at = stop_at or time.monotonic()
        if child is None:
            pending.add(number)
        else:
            child.send_signal(number)

    previous = {number: signal.signal(number, forward) for number in signals}
    coalescer = Coalescer(messages)
    buffers = {}
    outputs = []
    exited_at = None
    try:
        # poll accepts regular-file output as well as pipes/journal sockets.
        with selectors.PollSelector() as selector:
            for stream in (sys.stdout.buffer, sys.stderr.buffer):
                outputs.append(OutputBuffer(stream))
            child = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                     stderr=subprocess.PIPE, close_fds=True, bufsize=0)
            sources = dict(zip((child.stdout, child.stderr), outputs))
            for source in sources:
                os.set_blocking(source.fileno(), False)
                buffers[source] = bytearray()
            for number in pending:
                child.send_signal(number)
            pending.clear()
            while True:
                coalescer.flush()
                now = time.monotonic()
                status = child.poll()
                if status is None and stop_at is not None and now - stop_at >= 5:
                    child.kill()
                if status is not None:
                    exited_at = exited_at or now
                    if not sources:
                        coalescer.flush(final=True)
                        if not any(output.pending for output in outputs):
                            break
                    if now - exited_at >= 2:
                        for source, destination in sources.items():
                            if buffers[source]:
                                coalescer.line(destination, bytes(buffers[source]))
                        coalescer.flush(final=True)
                        for output in outputs:
                            if output.pending:
                                output.drain()
                        break
                for source, destination in sources.items():
                    reading = source in selector.get_map()
                    can_read = len(destination.pending) + len(buffers[source]) < OUTPUT_BUFFER_LIMIT
                    if can_read and not reading:
                        selector.register(source, selectors.EVENT_READ, destination)
                    elif reading and not can_read:
                        selector.unregister(source)
                for output in outputs:
                    writing = output.fd in selector.get_map()
                    if output.pending and not writing:
                        selector.register(output.fd, selectors.EVENT_WRITE, output)
                    elif writing and not output.pending:
                        selector.unregister(output.fd)
                for key, _ in selector.select(timeout=0.25):
                    if isinstance(key.fileobj, int):
                        key.data.drain()
                        continue
                    source, destination = key.fileobj, key.data
                    try:
                        capacity = OUTPUT_BUFFER_LIMIT - len(destination.pending) - len(buffers[source])
                        data = os.read(source.fileno(), min(65536, capacity))
                    except BlockingIOError:
                        continue
                    if not data:
                        if buffers[source]:
                            coalescer.line(destination, bytes(buffers[source]))
                        selector.unregister(source)
                        del sources[source]
                        source.close()
                        continue
                    buffer = buffers[source]
                    buffer.extend(data)
                    lines = buffer.split(b'\n')
                    buffer[:] = lines.pop()
                    for line in lines:
                        coalescer.line(destination, bytes(line) + b'\n')
                    if len(buffer) > 8192:
                        coalescer.line(destination, bytes(buffer))
                        buffer.clear()
        status = child.wait()
        return status
    finally:
        try:
            if child is not None:
                try:
                    if child.poll() is None:
                        child.terminate()
                    try:
                        child.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        child.kill()
                        child.wait()
                finally:
                    for stream in (child.stdout, child.stderr):
                        if stream is not None:
                            stream.close()
        finally:
            try:
                # stdout/stderr may share an open-file description; reverse
                # setup order restores its original blocking state as well.
                for output in reversed(outputs):
                    output.restore()
            finally:
                for number, handler in previous.items():
                    signal.signal(number, handler)


def main(args: list[str]) -> int:
    if os.getuid() == 0 or len(args) != 1 or args[0] not in MESSAGES:
        return 2
    panel = args[0]
    command = ['/usr/bin/' + panel]
    return supervise(command, MESSAGES[panel])


if __name__ == '__main__':
    try:
        status = main(sys.argv[1:])
        if status < 0:
            # Let systemd distinguish a normal stop signal from an ordinary
            # exit(143). Fatal signals still remain failures, not successes.
            number = -status
            if number not in (signal.SIGKILL, signal.SIGSTOP):
                signal.signal(number, signal.SIG_DFL)
            signal.pthread_sigmask(signal.SIG_UNBLOCK, {number})
            os.kill(os.getpid(), number)
            raise SystemExit(128 + number)  # only reachable if delivery failed
        raise SystemExit(status)
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f'labwc-panel-run: {exc}', file=sys.stderr)
        raise SystemExit(1)
