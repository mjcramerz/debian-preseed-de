#!/usr/bin/python3 -I
"""Validate the packaged Qt agent, then exec it in the existing user service.

--check is read-only and needs no display; installation/firstboot use it too.
This is a compatibility gate, not a replacement authentication implementation.
The signed APT policy selects the package; no binaries are fetched or patched.
"""
from __future__ import annotations

import os
from pathlib import Path
import re
import stat
import subprocess
import sys

BINARY = Path('/usr/libexec/hyprpolkitagent')
QUERY = '/usr/bin/dpkg-query'
QUERY_ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'}
EX_CONFIG = 78


def package_query(*arguments: str) -> str:
    result = subprocess.run([QUERY, *arguments], env=QUERY_ENV, check=True,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, timeout=5)
    return result.stdout


def check_metadata(record: str) -> str:
    fields = record.splitlines()
    if len(fields) != 3 or fields[0] != 'installed':
        raise ValueError('hyprpolkitagent is not fully installed')
    version, depends = fields[1:]
    if not re.fullmatch(r'0\.1\.3-[0-9][0-9A-Za-z.+~]*', version):
        raise ValueError('hyprpolkitagent requires the reviewed Debian 0.1.3 Qt series; '
                         'the hyprtoolkit build is not compatible with this Labwc policy')
    packages = {item.strip().split()[0].split(':')[0]
                for item in re.split(r'[,|]', depends) if item.strip()}
    if any(p.startswith(('libhyprtoolkit', 'hyprtoolkit', 'libaquamarine')) for p in packages):
        raise ValueError('hyprtoolkit-linked agent rejected: Qt settings do not fix its protocol bind')
    if not {'libpolkit-qt6-1-1', 'libqt6quickcontrols2-6'} <= packages:
        raise ValueError('hyprpolkitagent Qt/PolicyKit dependencies are not the reviewed implementation')
    return version


def check_binary() -> None:
    # No PATH lookup, local shadow binary, symlink or writable package parent.
    for path in (*reversed(BINARY.parents), BINARY):
        info = path.lstat()
        kind_ok = stat.S_ISREG(info.st_mode) if path == BINARY else stat.S_ISDIR(info.st_mode)
        if not kind_ok or info.st_uid != 0 or info.st_mode & 0o7022:
            raise ValueError(f'unsafe packaged hyprpolkitagent path: {path}')
        if path == BINARY and not info.st_mode & stat.S_IXUSR:
            raise ValueError('packaged hyprpolkitagent is not executable')
    owner = package_query('-S', str(BINARY)).strip()
    if not re.fullmatch(r'hyprpolkitagent(?::[a-z0-9][a-z0-9-]*)?: ' + re.escape(str(BINARY)), owner):
        raise ValueError('hyprpolkitagent executable is diverted or not owned by its Debian package')


def check() -> str:
    version = check_metadata(package_query('-W', '-f=${db:Status-Status}\n${Version}\n${Depends}\n',
                                           'hyprpolkitagent'))
    check_binary()
    return version


def launch_environment() -> dict[str, str]:
    env = dict(os.environ)
    if (env.get('LABWC_SESSION_OWNER') != 'desktop' or
            env.get('XDG_SESSION_TYPE') != 'wayland' or not env.get('WAYLAND_DISPLAY')):
        raise ValueError('hyprpolkitagent requires the managed desktop Wayland session')
    for key in ('DISPLAY', 'XAUTHORITY', 'QSG_RHI_BACKEND', 'QMLSCENE_DEVICE'):
        env.pop(key, None)
    env.update(QT_QPA_PLATFORM='wayland', QT_QUICK_BACKEND='software', QT_NO_XDG_DESKTOP_PORTAL='1')
    return env


def main(argv: list[str]) -> int:
    if argv not in (['--check'], ['--exec']):
        print('usage: labwc-hyprpolkit-agent --check|--exec', file=sys.stderr)
        return EX_CONFIG
    try:
        version = check()
        if argv == ['--check']:
            print(f'hyprpolkitagent {version}: packaged Qt implementation verified')
            return 0
        # Replace this process: the vendor agent remains systemd's main PID.
        os.execve(str(BINARY), [str(BINARY)], launch_environment())
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'hyprpolkitagent compatibility check failed: {error}', file=sys.stderr)
        return EX_CONFIG
    return EX_CONFIG


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
