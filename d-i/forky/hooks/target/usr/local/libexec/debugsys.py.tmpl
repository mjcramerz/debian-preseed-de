def terminal_choice(title: str, labels: list[str], *, plain: bool = False) -> int | None:
    """Arrow-key picker with a numbered fallback; restores the tty on all exits."""
    if not plain and os.environ.get('TERM', '') not in ('', 'dumb') and sys.stdout.isatty():
        import importlib
        try:
            curses = importlib.import_module('curses')
        except ImportError:
            return terminal_choice(title, labels, plain=True)
        try:
            def draw(window):
                position = 0
                window.keypad(True)
                try:
                    curses.curs_set(0)
                except curses.error:
                    pass
                if hasattr(curses, 'set_escdelay'):
                    curses.set_escdelay(40)
                while True:
                    height, width = window.getmaxyx()
                    window.erase()
                    def line(y, value, attribute=0):
                        if 0 <= y < height and width > 1:
                            try:
                                window.addnstr(y, 0, value, width-1, attribute)
                            except curses.error:
                                pass  # Includes a resize during repaint.
                    line(0, 'DEBUGSYS | '+title, curses.A_BOLD)
                    line(1, 'Up/Down: move   Enter/Right: select   Esc/Left/Q: back')
                    visible = max(1, height-5)
                    start = max(0, min(position-visible+1, len(labels)-visible))
                    for row, index in enumerate(range(start, min(len(labels), start+visible)), 3):
                        line(row, ('> ' if index == position else '  ')+labels[index],
                             curses.A_REVERSE if index == position else 0)
                    line(height-1, f'{position+1}/{len(labels)} | No action runs until selected')
                    window.refresh()
                    key = window.getch()
                    if key in (27, ord('q'), ord('Q'), curses.KEY_LEFT):
                        return None
                    if key in (10, 13, curses.KEY_ENTER, curses.KEY_RIGHT):
                        return position
                    if key in (curses.KEY_UP, ord('k')):
                        position = (position-1) % len(labels)
                    elif key in (curses.KEY_DOWN, ord('j')):
                        position = (position+1) % len(labels)
                    elif key == curses.KEY_HOME:
                        position = 0
                    elif key == curses.KEY_END:
                        position = len(labels)-1
                    elif key == curses.KEY_PPAGE:
                        position = max(0, position-visible)
                    elif key == curses.KEY_NPAGE:
                        position = min(len(labels)-1, position+visible)
            return curses.wrapper(draw)
        except curses.error:
            # A serial console/minimal TERM still has a complete usable menu.
            pass
    while True:
        print('\nDEBUGSYS | '+title)
        for index, label in enumerate(labels, 1):
            print(f' {index:2d}. {label}')
        print('  0. Back / Exit')
        value = input('Selection: ').strip()
        if value in ('0', 'q', 'Q', ''):
            return None
        if len(value) <= 3 and value.isascii() and value.isdigit() and 1 <= int(value) <= len(labels):
            return int(value)-1
        print('Choose one of the displayed numbers.')


def menu(user_name: str | None = None, plain: bool = False):
    user = desktop_account(user_name)
    context = user.pw_name if user else 'no unique desktop user; use --user NAME'
    screen = None
    while True:
        try:
            if screen is None:
                labels = ['Comprehensive diagnostic report (all areas)', *SCREENS,
                          'Capture status and saved reports', 'Exit']
                selected = terminal_choice('Main menu | user: '+context, labels, plain=plain)
                if selected is None or selected == len(labels)-1:
                    return
                label = labels[selected]
                if label in SCREENS:
                    screen = label
                    continue
                action = tuple(CATEGORIES) if selected == 0 else 'status'
            else:
                entries = SCREENS[screen]
                selected = terminal_choice(screen, [label for label, _ in entries]+['Back'], plain=plain)
                if selected is None or selected == len(entries):
                    screen = None
                    continue
                action = entries[selected][1]
            if action == 'status':
                status()
            else:
                if action in ('arm', 'remove'):
                    confirm(action == 'arm', False)
                with lock():
                    if isinstance(action, tuple):
                        collect(list(action), user_name=user.pw_name if user else None)
                    else:
                        change_hooks(action == 'arm')
            input('Press Enter to return to the menu: ')
        except (DebugError, OSError) as exc:
            print(f'debugsys: {exc}', file=sys.stderr)
            try:
                input('Press Enter to return to the menu: ')
            except (EOFError, KeyboardInterrupt):
                return
        except (EOFError, KeyboardInterrupt):
            print('\nLeaving debugsys. Completed and partial reports are retained.')
            return

def main() -> int:
    # Internal child readers have fixed schemas and must NEVER read as root.
    if len(sys.argv) == 3 and sys.argv[1] == 'user-evidence':
        return user_evidence(sys.argv[2])
    if len(sys.argv) == 4 and sys.argv[1] == 'user-log' and re.fullmatch('[0-9]', sys.argv[3]):
        return user_log(sys.argv[2], int(sys.argv[3]))
    if os.geteuid() != 0:
        raise DebugError('use /usr/local/bin/debugsys; collection must enter sudo -i')
    os.umask(0o077)
    import resource
    resource.setrlimit(resource.RLIMIT_CORE,(0,0))
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--user', dest='desktop_user', help='explicit non-root desktop account')
    parser.add_argument('--plain-menu', action='store_true', help='numbered menu instead of terminal arrows')
    sub=parser.add_subparsers(dest='action')
    report=sub.add_parser('report',help='read-only report; no boot changes')
    report.add_argument('--user', dest='report_user', help='explicit non-root desktop account')
    report.add_argument('--categories',nargs='+',choices=CATEGORIES,default=list(CATEGORIES))
    for action in ('boot-enable','boot-disable'):
        sub.add_parser(action).add_argument('--yes',action='store_true',help='explicitly authorize the initramfs rebuild')
    sub.add_parser('boot-finalize',help=argparse.SUPPRESS)
    sub.add_parser('status')
    args=parser.parse_args()
    user_name = getattr(args, 'report_user', None) or args.desktop_user
    if user_name is not None:
        desktop_account(user_name)
    if args.action is None:
        if not sys.stdin.isatty():
            parser.error('interactive menu requires a terminal; use report or status')
        menu(user_name, args.plain_menu); return 0
    if args.action == 'status':
        status(); return 0
    with lock():
        if args.action == 'report':
            collect(list(dict.fromkeys(args.categories)), user_name=user_name)
        elif args.action.startswith('boot-') and args.action != 'boot-finalize':
            enabled=args.action == 'boot-enable'
            confirm(enabled,args.yes); change_hooks(enabled)
        elif args.action == 'boot-finalize':
            if not (STATE/'armed').is_file() or not Path('/run/initramfs/debugsys').is_dir():
                return 0
            boot_id=Path('/proc/sys/kernel/random/boot_id').read_text().strip()
            if not re.fullmatch('[0-9a-f-]{36}',boot_id):
                raise DebugError('invalid kernel boot ID')
            marker=STATE/'last-captured-boot'
            if marker.exists() and marker.read_text().strip()==boot_id:
                return 0
            collect(['boot','system'],'early-boot',budget=180)
            atomic_write(marker,(boot_id+'\n').encode())
    return 0

if __name__ == '__main__':
    for sig in (signal.SIGTERM,signal.SIGHUP):
        signal.signal(sig,lambda signum,frame: sys.exit(128+signum))
    try:
        raise SystemExit(main())
    except (DebugError,OSError) as error:
        print(f'debugsys: {error}',file=sys.stderr)
        raise SystemExit(1)
    except KeyboardInterrupt:
        print('debugsys: interrupted; completed and partial evidence retained',file=sys.stderr)
        raise SystemExit(130)
