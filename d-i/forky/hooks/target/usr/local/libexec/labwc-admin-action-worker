#!/usr/bin/python3 -I
"""Authorized PID-1-owned power worker; user documents never run as root."""
from __future__ import annotations
import fcntl
import os
from pathlib import Path
import pwd
import re
import signal
import socket
import stat
import subprocess
import sys
import time
import uuid

ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C.UTF-8"}


class Error(Exception):
    pass


def run(argv: list[str], *, timeout: int = 25, accepted: tuple[int, ...] = (0,)) -> str:
    # Each local transport gets its own process group. On a timeout, reap the
    # whole transport rather than leaving a stdio bridge holding our pipes open.
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, text=True, env=ENV,
                            start_new_session=True)
    try:
        output, error = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        try:
            proc.communicate(timeout=2)
        except subprocess.TimeoutExpired:
            proc.stdout.close()
            proc.stderr.close()
            proc.wait(timeout=2)
        raise Error(f"{Path(argv[0]).name} timed out after {timeout}s") from None
    if proc.returncode not in accepted:
        raise Error(f"{Path(argv[0]).name} exited {proc.returncode}: {error.strip()[:1000]}")
    return output


def ready() -> None:
    # Type=notify makes the pkexec frontend observe startup/authorization errors
    # before any application is closed. Only this main process may acknowledge.
    address = os.environ.get("NOTIFY_SOCKET", "")
    if not address or address[0] not in "/@":
        raise Error("power worker requires its systemd notification socket")
    if address.startswith("@"):
        address = "\0" + address[1:]
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as notifier:
        notifier.settimeout(2)
        notifier.connect(address)
        notifier.sendall(b"READY=1\nSTATUS=Authorized desktop power request accepted")


class Worker:
    def __init__(self, uid: int, user: str, action: str):
        self.uid, self.user, self.action = uid, user, action
        self.machine = user + "@.host"
        self.committed = False

    def userctl(self, *args: str, **kwargs) -> str:
        return run(["/usr/bin/systemctl", "--user", "--machine=" + self.machine,
                    "--no-ask-password", *args], **kwargs)

    def helper(self, action: str) -> None:
        if action not in {"prepare", "cancel", "locked", "error"}:
            raise Error("invalid desktop state operation")
        # This is a USER unit, not a PID-1 service with User=. Its manager owns
        # the desktop environment and executes the helper without root rights.
        self.userctl("start", "labwc-session-state@" + action + ".service",
                     timeout=160 if action == "prepare" else 15)

    def protect_other_sessions(self) -> None:
        if self.action == "logout":
            return
        listing = run(["/usr/bin/loginctl", "list-sessions", "--no-legend", "--no-pager"])
        for line in listing.splitlines():
            fields = line.split()
            if len(fields) < 2 or not fields[1].isdigit() or not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", fields[0]):
                raise Error("unexpected login session listing")
            if int(fields[1]) == self.uid:
                continue
            session_class = run(["/usr/bin/loginctl", "show-session", fields[0], "--property=Class", "--value"]).strip()
            if session_class in {"user", "user-early", "user-light"}:
                raise Error("another interactive account is logged in; ask that user to save and log out first")

    def lock(self) -> None:
        # Type=forking waits for labwc-lock's swaylock -f readiness handshake.
        # Unlike an exec oneshot, its daemon stays in a live independent unit.
        run(["/usr/bin/systemd-run", "--user", "--machine=" + self.machine,
             "--quiet", "--collect", "--service-type=forking", "--expand-environment=no",
             "--unit=labwc-power-lock-" + uuid.uuid4().hex + ".service",
             "--property=Requisite=labwc-session.target", "--property=After=labwc-session.target",
             "--property=PartOf=labwc-session.target", "--property=TimeoutStartSec=20s",
             "--property=TimeoutStopSec=5s", "--", "/usr/local/bin/labwc-lock"], timeout=25)
        self.helper("locked")

    def best_effort(self, description: str, callback) -> None:
        try:
            callback()
        except (Error, OSError, subprocess.SubprocessError) as exc:
            print(f"power cleanup ({description}): {exc}", file=sys.stderr, flush=True)

    def remaining(self) -> bool:
        # Query the manager, not /proc of other AppArmor domains. PID 1/logind
        # already own every managed user unit and login-session cgroup.
        state = run(["/usr/bin/systemctl", "show", f"user-{self.uid}.slice",
                     "--property=ActiveState", "--value"], timeout=5).strip()
        if state not in {"active", "activating", "deactivating", "inactive", "failed"}:
            raise Error("cannot determine the invoking user's slice state")
        return state not in {"inactive", "failed"}

    def wait_for_exit(self, seconds: float) -> bool:
        deadline = time.monotonic() + seconds
        while True:
            try:
                if not self.remaining():
                    return True
            except (Error, OSError, subprocess.SubprocessError) as exc:
                print(f"power cleanup (slice state): {exc}", file=sys.stderr, flush=True)
                return False
            if time.monotonic() >= deadline:
                return False
            time.sleep(0.2)

    def terminate_user(self) -> None:
        # Once committed, one failed stop must not strand a half-closed desktop.
        # Queue stops first (disabling restart), then use PID 1's cgroup-wide
        # TERM/KILL paths. No process-name matching and no caller-owned worker.
        self.best_effort("desktop units", lambda: self.userctl(
            "--no-block", "stop", "labwc-session.target", "labwc-compositor.service", timeout=10))
        self.best_effort("login sessions", lambda: run(
            ["/usr/bin/loginctl", "terminate-user", str(self.uid)], timeout=10))
        self.best_effort("user manager and slice", lambda: run(
            ["/usr/bin/systemctl", "--no-block", "stop", f"user@{self.uid}.service",
             f"user-{self.uid}.slice"], timeout=10))
        if self.wait_for_exit(1):
            return
        for sig, grace in (("TERM", 3), ("KILL", 3)):
            self.best_effort(sig + " user cgroups", lambda: run(
                ["/usr/bin/systemctl", "kill", "--kill-whom=all", "--signal=" + sig,
                 f"user-{self.uid}.slice"], timeout=5))
            if self.wait_for_exit(grace):
                return
        # Uninterruptible tasks and stale stop jobs must not veto reboot after
        # the desktop has already gone. Single-force shutdown lets PID 1 finish
        # global process cleanup, including tasks outside this user's slice.
        if self.action == "logout":
            raise Error("user slice did not stop; inspect the power-worker journal")
        print("power cleanup: user slice still stopping; proceeding to PID 1 shutdown",
              file=sys.stderr, flush=True)

    def final_power_action(self) -> None:
        self.best_effort("sync", lambda: run(["/usr/bin/sync"], timeout=10))
        for attempt in range(2):
            try:
                # Exactly ONE --force per request. Never use a raw reboot
                # syscall, SysRq, --no-sync, or the unsafe double-force variant.
                run(["/usr/bin/systemctl", "--no-ask-password", "--force", self.action], timeout=20)
                return
            except (Error, OSError, subprocess.SubprocessError) as exc:
                if attempt:
                    raise Error(f"session teardown completed but {self.action} failed: {exc}") from exc
                print(f"power request: retrying {self.action}: {exc}", file=sys.stderr, flush=True)
                time.sleep(0.25)

    def execute(self) -> None:
        self.userctl("--quiet", "is-active", "labwc-session.target")
        self.protect_other_sessions()
        if self.action == "suspend":
            self.lock()
            ready()
            # Retain systemd-sleep and GPU hooks; do not stop user applications.
            run(["/usr/bin/systemctl", "--force", "suspend"], timeout=60)
            return
        ready()
        self.helper("prepare")
        # A second account may have logged in while a save dialog was open.
        self.protect_other_sessions()
        self.committed = True
        try:
            self.terminate_user()
        finally:
            if self.action != "logout":
                self.final_power_action()


def main(argv: list[str]) -> int:
    if os.geteuid() != 0 or len(argv) != 1:
        raise Error("usage (system service only): labwc-admin-action-worker UID-suspend|reboot|poweroff|logout")
    match = re.fullmatch(r"([1-9][0-9]{0,9})-(suspend|reboot|poweroff|logout)", argv[0])
    if not match:
        raise Error("invalid power-worker instance")
    uid, action = int(match[1]), match[2]
    account = pwd.getpwuid(uid)
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", account.pw_name):
        raise Error("unsafe invoking account identifier")
    os.umask(0o077)
    directory = Path("/run/labwc-power")
    st = directory.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or stat.S_IMODE(st.st_mode) != 0o700:
        raise Error("unsafe system power lock directory")
    fd = os.open(directory / "action.lock", os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1 or stat.S_IMODE(st.st_mode) != 0o600:
            raise Error("unsafe system power lock")
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        worker = Worker(uid, account.pw_name, action)
        try:
            worker.execute()
        except BaseException:
            if not worker.committed:
                for operation in ("cancel", "error"):
                    try:
                        worker.helper(operation)
                    except (Error, OSError, subprocess.SubprocessError):
                        pass
            # Never resurrect a user manager or claim a save-dialog cancellation
            # after destructive teardown. PID 1's journal retains the real error.
            raise
    finally:
        os.close(fd)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (Error, OSError, KeyError, ValueError, subprocess.SubprocessError) as exc:
        print(f"labwc-admin-action-worker: {exc}", file=sys.stderr)
        sys.exit(1)
