#!/usr/bin/python3 -I
"""Translate Waybar's clock tooltip showing event into one fixed popup unit.

No input injection, accessibility actions, global pointer polling or shell text.
Only Waybar enables its GTK3 ATK bridge; other apps keep session policy.
"""
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

import gi
gi.require_version('Atspi', '2.0')
from gi.repository import Atspi, GLib

last_open = 0.0


def showing(event, *_):
    global last_open
    if not event.detail1 or time.monotonic() - last_open < 1:
        return
    try:
        source = event.source
        if source.get_role() != Atspi.Role.TOOL_TIP or source.get_name() != 'Calendar':
            return
        pid = source.get_process_id()
        process = Path('/proc') / str(pid)
        if process.stat().st_uid != os.getuid() or os.readlink(process / 'exe') != '/usr/bin/waybar':
            return
        last_open = time.monotonic()
        result = subprocess.run(['/usr/bin/systemctl', '--user', '--no-block', 'start', 'labwc-waycal.service'],
                                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                timeout=3, check=False, close_fds=True)
        if result.returncode:
            print('labwc-waycal-hover: popup request failed', file=sys.stderr)
    except (GLib.Error, OSError, subprocess.TimeoutExpired):
        print('labwc-waycal-hover: tooltip unavailable', file=sys.stderr)


def main():
    if len(sys.argv) != 1 or os.getuid() == 0:
        return 2
    Atspi.set_timeout(500, 1000)
    if Atspi.init() not in (0, 1):
        print('labwc-waycal-hover: accessibility bus unavailable', file=sys.stderr)
        return 1
    listener = Atspi.EventListener.new(showing, None)
    if not listener.register('object:state-changed:showing'):
        print('labwc-waycal-hover: cannot subscribe to tooltip events', file=sys.stderr)
        return 1
    loop = GLib.MainLoop()
    for sig in (signal.SIGINT, signal.SIGTERM):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, lambda: (loop.quit(), False)[1])
    try:
        loop.run()
    finally:
        listener.deregister('object:state-changed:showing')
        Atspi.exit()
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
