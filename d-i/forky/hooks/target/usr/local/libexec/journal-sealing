#!/usr/bin/python3 -I
"""Provision disk-backed journal FSS; never persist its verification seed.

--setup is idempotent, but never replaces an existing sealing generation.
The verification seed is sensitive. It exists only in a root-private /run file
until explicitly exported off-host and acknowledged by its SHA-256.
"""
from __future__ import annotations
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import stat
import subprocess
import sys
import tempfile

STATE = Path('/var/lib/journal-sealing')
RUNTIME = Path('/run/journal-sealing')
KEY = RUNTIME / 'verification-key'
RECORD = STATE / 'status.json'
JOURNAL = Path('/var/log/journal')
ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C',
       'SYSTEMD_COLORS': '0', 'SYSTEMD_PAGER': 'cat'}
KEY_PATTERN = re.compile(rb'[0-9a-f]{6}(?:-[0-9a-f]{6})+(?:-[0-9a-f]{2,4})?/[0-9a-f]+-[0-9a-f]+\n\Z')


def command(args: list[str]) -> str:
    result = subprocess.run(args, env=ENV, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            timeout=60, check=False)
    if result.returncode or len(result.stdout) > 65536:
        raise ValueError('journal provisioning command failed: ' + args[0])
    return result.stdout.decode('utf-8', errors='strict').strip()


def directory(path: Path, *, private: bool = False, create: bool = False) -> None:
    for parent in reversed((path, *path.parents)):
        if parent == path and create:
            try:
                parent.mkdir(mode=0o700)
            except FileExistsError:
                pass
        info = parent.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022
                or (private and parent == path and stat.S_IMODE(info.st_mode) != 0o700)):
            raise ValueError('unsafe journal provisioning directory')


def private_bytes(path: Path, limit: int = 65536) -> bytes:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1
                or stat.S_IMODE(info.st_mode) not in (0o400, 0o600) or info.st_size > limit):
            raise ValueError('unsafe journal provisioning file')
        result = stream.read(limit + 1)
        if len(result) > limit:
            raise ValueError('oversized journal provisioning file')
        return result


def sync_directory(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def write_record(data: dict) -> None:
    if RECORD.exists() or RECORD.is_symlink():
        private_bytes(RECORD)
    fd, temporary = tempfile.mkstemp(prefix='.status-', dir=STATE)
    try:
        with os.fdopen(fd, 'w', encoding='ascii') as stream:
            json.dump(data, stream, sort_keys=True)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, RECORD)
        sync_directory(STATE)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def verification_key() -> bytes:
    value = private_bytes(KEY, 512)
    if not KEY_PATTERN.fullmatch(value):
        raise ValueError('verification-key output is incomplete; do not rotate sealing keys automatically')
    return value


def read_record(machine: str) -> dict:
    record = json.loads(private_bytes(RECORD))
    if (not isinstance(record, dict) or record.get('version') != 1
            or record.get('machine_id') != machine
            or not isinstance(record.get('exported'), bool)
            or not isinstance(record.get('rotated'), bool)
            or not re.fullmatch('[0-9a-f]{64}', str(record.get('verification_sha256', '')))):
        raise ValueError('invalid journal sealing evidence')
    return record


def enabled_policy() -> bool:
    command(['/usr/local/libexec/journal-check'])
    checker = runpy.run_path('/usr/local/libexec/journal-check')
    policy = checker['journal_settings'](checker['MANAGED'].read_text(), unique=True)
    if policy['Seal'] == 'no':
        return False
    if policy['Storage'] != 'persistent':
        raise ValueError('sealing requires persistent journal storage')
    directory(JOURNAL)
    fs = command(['/usr/bin/findmnt', '--noheadings', '--output', 'FSTYPE', '--target', str(JOURNAL)])
    if fs in ('tmpfs', 'ramfs', 'overlay') or not fs or '\n' in fs:
        raise ValueError('sealing requires explicitly disk-backed journals, not RAM/overlay')
    return True


def setup(machine: str, fss: Path) -> dict:
    if not fss.exists() and not fss.is_symlink():
        if RECORD.exists() or RECORD.is_symlink():
            raise ValueError('sealing state disappeared; refusing to replace the generation')
        if KEY.exists() or KEY.is_symlink():
            if private_bytes(KEY, 512):
                raise ValueError('unmatched verification seed; administrator recovery required')
            KEY.unlink()  # Empty output from an interrupted pre-key generation only.
        fd = os.open(KEY, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, 'wb') as stream:
            result = subprocess.run(['/usr/bin/journalctl', '--setup-keys', '--interval=15min',
                                     '--quiet', '--no-pager'], env=ENV, stdin=subprocess.DEVNULL,
                                    stdout=stream, stderr=subprocess.PIPE, timeout=120, check=False)
            stream.flush()
            os.fsync(stream.fileno())
        if result.returncode:
            raise ValueError('journalctl key setup failed; generation left intact for recovery')
    private_bytes(fss, 1_048_576)
    if RECORD.exists() or RECORD.is_symlink():
        record = read_record(machine)
    else:
        # Recover a completed setup interrupted before publishing the record.
        seed = verification_key()
        record = {'version': 1, 'machine_id': machine, 'exported': False, 'rotated': False,
                  'verification_sha256': hashlib.sha256(seed).hexdigest()}
        write_record(record)
    if not record['exported']:
        if hashlib.sha256(verification_key()).hexdigest() != record['verification_sha256']:
            raise ValueError('verification seed does not match this generation')
    elif KEY.exists() or KEY.is_symlink():
        raise ValueError('acknowledged verification seed must not remain on this host')
    if not record['rotated']:
        command(['/usr/bin/journalctl', '--rotate', '--no-pager'])
        record['rotated'] = True
        write_record(record)
    return record


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        raise ValueError('root is required')
    argv = argv or ['--setup']
    action = argv[0]
    allowed = ('--setup', '--status', '--show-verification-key', '--acknowledge-export', '--release-check')
    if action not in allowed or len(argv) != (2 if action == '--acknowledge-export' else 1):
        raise ValueError('invalid journal-sealing arguments')
    os.umask(0o077)
    if not enabled_policy():
        if action in ('--show-verification-key', '--acknowledge-export'):
            raise ValueError('sealing is disabled for this logging policy')
        print('journal sealing: disabled (RAM/volatile policy; no FSS assurance claimed)')
        return 0
    if command(['/usr/bin/findmnt', '--noheadings', '--output', 'FSTYPE', '--target', '/run']) not in ('tmpfs', 'ramfs'):
        raise ValueError('/run must be RAM-backed for verification-key handling')
    directory(STATE, private=True, create=True)
    directory(RUNTIME, private=True, create=True)
    machine = Path('/etc/machine-id').read_text(encoding='ascii').strip()
    if not re.fullmatch('[0-9a-f]{32}', machine) or int(machine, 16) == 0:
        raise ValueError('final machine-id is required')
    directory(JOURNAL / machine)
    fss = JOURNAL / machine / 'fss'
    lock = os.open(STATE / 'lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    with os.fdopen(lock, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1
                or stat.S_IMODE(info.st_mode) != 0o600):
            raise ValueError('unsafe journal sealing lock')
        fcntl.flock(stream, fcntl.LOCK_EX)
        if action == '--setup':
            record = setup(machine, fss)
        else:
            private_bytes(fss, 1_048_576)
            record = read_record(machine)
        if action == '--show-verification-key':
            seed = verification_key()
            if hashlib.sha256(seed).hexdigest() != record['verification_sha256'] or record['exported']:
                raise ValueError('verification key is unavailable for this generation')
            sys.stdout.buffer.write(seed)
            return 0
        if action == '--acknowledge-export':
            if argv[1] != record['verification_sha256'] or not record['rotated']:
                raise ValueError('export fingerprint mismatch or journal rotation incomplete')
            # The operator attests an independently retained off-host copy. A
            # crash after unlink is recoverable by repeating the same attestation.
            if KEY.exists() or KEY.is_symlink():
                if hashlib.sha256(verification_key()).hexdigest() != argv[1]:
                    raise ValueError('verification-key generation mismatch')
                KEY.unlink()
                sync_directory(RUNTIME)
            record['exported'] = True
            write_record(record)
        if action == '--release-check' and (not record['exported'] or not record['rotated'] or KEY.exists() or KEY.is_symlink()):
            raise ValueError('FSS release gate: export, acknowledge and remove the verification seed first')
        print(json.dumps(record, sort_keys=True))
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print('journal-sealing: ' + str(error), file=sys.stderr)
        raise SystemExit(1)
