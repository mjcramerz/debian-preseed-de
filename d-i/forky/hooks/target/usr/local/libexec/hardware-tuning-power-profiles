#!/usr/bin/python3 -IB
"""Unprivileged desktop Power Profiles API entrypoint."""
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, "/usr/local/lib/hardware_tuning")
from power_profiles import main

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print("power_profiles outcome=failed reason=" + str(exc)[:512], file=sys.stderr)
        raise SystemExit(1)
