#!/usr/bin/python3 -IB
"""Persist the managed static Wi-Fi connection and open its native nmtui UI."""
import configparser
import fcntl
import io
import ipaddress
import os
from pathlib import Path
import re
import shlex
import stat
import subprocess
import sys
import tempfile

POLICY = Path('/etc/network/host.conf')
PREPARED = Path('/etc/network/wifi.nmconnection')
PROFILE = Path('/etc/NetworkManager/system-connections/wifi.nmconnection')
FIRSTBOOT_DONE = Path('/var/lib/network-wifi/firstboot.complete')
PROFILE_UUID = '3f1b70be-cc3f-4e77-9e31-66f7a5e16994'
ENVIRONMENT = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C.UTF-8'}


class ConfigurationError(ValueError):
    """A safe diagnostic that never includes configuration contents or secrets."""


def owned_parents(path):
    for parent in path.parents:
        info = parent.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise ConfigurationError('unsafe managed configuration parent')


def read_owned(path, modes=(0o600,)):
    owned_parents(path)
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    with os.fdopen(descriptor, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1
                or stat.S_IMODE(info.st_mode) not in modes):
            raise ConfigurationError('managed configuration must be a private root-owned regular file')
        data = stream.read(65537)
    if len(data) > 65536:
        raise ConfigurationError('managed configuration exceeds its size limit')
    return data.decode('utf-8')


def parse_policy(text):
    values = {}
    for line in text.split('\n'):
        if not line or line.startswith('#'):
            continue
        key, separator, raw = line.partition('=')
        if not separator or not re.fullmatch(r'MANAGED_NETWORK_[A-Z0-9_]+', key) or key in values:
            raise ConfigurationError('invalid or duplicate network policy assignment')
        parts = shlex.split(raw, comments=False)
        if len(parts) != 1:
            raise ConfigurationError('invalid network policy value')
        values[key] = parts[0]
    return values


def keyfile(text):
    result = configparser.ConfigParser(interpolation=None, strict=True, delimiters=('=',))
    result.optionxform = str
    result.read_string(text)
    if result.defaults():
        raise ConfigurationError('managed keyfile must not have inherited defaults')
    return result


def publish(path, text):
    owned_parents(path)
    descriptor, temporary = tempfile.mkstemp(prefix='.wifi-', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'w', encoding='utf-8') as stream:
            os.fchmod(stream.fileno(), 0o600)
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def run(argv, check=True, timeout=35):
    result = subprocess.run(argv, env=ENVIRONMENT, stdin=subprocess.DEVNULL,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=timeout)
    if check and result.returncode:
        raise ConfigurationError('Wi-Fi adapter command failed: ' + Path(argv[0]).name + ' (status ' + str(result.returncode) + ')')
    return result.returncode


def wifi_policy(interface):
    if not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', interface) or interface in {'.', '..'}:
        raise ConfigurationError('invalid managed Wi-Fi interface name')
    policy = parse_policy(read_owned(POLICY))
    if (policy.get('MANAGED_NETWORK_MODE') != 'static'
            or 'wifi' not in policy.get('MANAGED_NETWORK_LINK_TYPES', '').split()
            or policy.get('MANAGED_NETWORK_WIFI_IFACE') != interface):
        raise ConfigurationError('selected Wi-Fi adapter is not owned by the static network policy')
    wifi = ipaddress.IPv4Interface(policy['MANAGED_NETWORK_WIFI_IPV4_CIDR'])
    if policy.get('MANAGED_NETWORK_WIFI_CIDR'):
        if wifi.ip not in ipaddress.IPv4Network(policy['MANAGED_NETWORK_WIFI_CIDR'], strict=False):
            raise ConfigurationError('Ethernet IPv4 +1 is outside PRESEED_WIFI_CIDR')
    ethernet_cidr = policy.get('MANAGED_NETWORK_ETHERNET_IPV4_CIDR')
    if ethernet_cidr:
        ethernet = ipaddress.IPv4Interface(ethernet_cidr)
        if wifi.network != ethernet.network or int(wifi.ip) != int(ethernet.ip) + 1:
            raise ConfigurationError('Wi-Fi must be Ethernet IPv4 +1 in the same subnet')
    if policy.get('MANAGED_NETWORK_IPV6_ENABLED') == 'true':
        wifi6 = ipaddress.IPv6Interface(policy['MANAGED_NETWORK_WIFI_IPV6_CIDR'])
        ethernet6_cidr = policy.get('MANAGED_NETWORK_ETHERNET_IPV6_CIDR')
        if ethernet6_cidr:
            ethernet6 = ipaddress.IPv6Interface(ethernet6_cidr)
            if wifi6.network != ethernet6.network or int(wifi6.ip) != int(ethernet6.ip) + 1:
                raise ConfigurationError('Wi-Fi must be Ethernet IPv6 +1 in the same subnet')
    return policy


def profile_path():
    return PROFILE if PROFILE.exists() or PROFILE.is_symlink() else PREPARED


def validate_profile(policy, path=None, *, persistent=True):
    profile = keyfile(read_owned(path or profile_path()))
    expected = {('connection', 'uuid'): PROFILE_UUID,
                ('connection', 'type'): 'wifi',
                ('connection', 'interface-name'): policy['MANAGED_NETWORK_WIFI_IFACE'],
                ('wifi', 'mode'): 'infrastructure',
                ('ipv4', 'forwarding'): '1',
                ('wifi', 'mac-address'): policy['MANAGED_NETWORK_WIFI_MAC']}
    if persistent:
        expected[('connection', 'autoconnect')] = 'true'
        expected[('connection', 'permissions')] = ''
    for family in (4, 6):
        group = 'ipv' + str(family)
        enabled = family == 4 or policy.get('MANAGED_NETWORK_IPV6_ENABLED') == 'true'
        expected[(group, 'method')] = 'manual' if enabled else 'disabled'
        expected[(group, 'route-metric')] = '200'
        expected[(group, 'ignore-auto-dns')] = 'true'
        expected[(group, 'ignore-auto-routes')] = 'true'
        if enabled:
            expected[(group, 'address1')] = policy['MANAGED_NETWORK_WIFI_IPV' + str(family) + '_CIDR']
            expected[(group, 'gateway')] = policy['MANAGED_NETWORK_IPV' + str(family) + '_GATEWAY']
            dns = policy['MANAGED_NETWORK_IPV' + str(family) + '_DNS'].split()
            expected[(group, 'dns')] = ';'.join(dns) + ';' if policy['MANAGED_NETWORK_DNS_MODE'] == 'link' else ''
    for (group, name), value in expected.items():
        # NM may omit properties whose value equals its documented default.
        default = 'true' if (group, name) == ('connection', 'autoconnect') else ('' if value == '' else None)
        if profile.get(group, name, fallback=default) != value:
            raise ConfigurationError('managed Wi-Fi profile has incorrect ' + group + '.' + name)
    return profile


def publish_profile(policy):
    validate_profile(policy, PREPARED)
    PROFILE.parent.mkdir(mode=0o700, exist_ok=True)
    publish(PROFILE, read_owned(PREPARED))
    run(['/usr/bin/nmcli', '--wait', '30', 'connection', 'load', str(PROFILE)])


def firstboot():
    policy = parse_policy(read_owned(POLICY))
    if 'wifi' not in policy.get('MANAGED_NETWORK_LINK_TYPES', '').split():
        return
    policy = wifi_policy(policy['MANAGED_NETWORK_WIFI_IFACE'])
    validate_profile(policy, PREPARED)
    if PROFILE.exists() or PROFILE.is_symlink():
        validate_profile(policy)
        outcome = 'preserved-existing-profile'
    elif not policy.get('MANAGED_NETWORK_WIFI_ESSID'):
        outcome = 'skipped-missing-ssid'
    else:
        # Saving a known connection does not require its SSID or adapter to be
        # present now. NM activates it when available, respecting its persisted
        # radio preference. Do not reset that state or override rfkill at boot.
        publish_profile(policy)
        outcome = 'prepared-persistent-ssid'
    FIRSTBOOT_DONE.parent.mkdir(mode=0o700, exist_ok=True)
    publish(FIRSTBOOT_DONE, outcome + '\n')
    print('Wi-Fi firstboot:', outcome, '; saved connections reconnect automatically.')


def configure(interface, ui_args=()):
    policy = wifi_policy(interface)
    validate_profile(policy, persistent=False)
    if profile_path() == PREPARED:
        # An explicit later request may prepare the saved profile after firstboot
        # had no SSID. The saved profile uses NM's ordinary autoconnect policy.
        publish_profile(policy)
    print('Wi-Fi uses', policy['MANAGED_NETWORK_WIFI_IPV4_CIDR'], 'and the Ethernet gateway and resolver policy.')
    print('In nmtui, edit Wi-Fi for a new SSID; keep Manual IP settings and save its password for automatic reconnect.')
    run(['/usr/sbin/rfkill', 'unblock', 'wlan'])
    run(['/usr/bin/nmcli', '--wait', '30', 'radio', 'wifi', 'on'])
    environment = dict(ENVIRONMENT, TERM=os.environ.get('TERM', 'xterm-256color'))
    # The native terminal UI owns selection and secret prompting. Never create
    # an implicit DHCP profile with `nmcli device connect` or run ifup on Wi-Fi.
    result = subprocess.run(['/usr/bin/nmtui', *ui_args], env=environment, timeout=900)
    if result.returncode:
        raise ConfigurationError('nmtui exited with status ' + str(result.returncode))
    profile = validate_profile(policy, persistent=False)
    # Agent-only/not-saved passwords cannot authenticate before login. Native
    # nmtui's initial profile uses system-owned secrets; report an explicit
    # contrary selection instead of claiming persistent reconnect is ready.
    for section, names in (('wifi-security', ('psk-flags', 'wep-key-flags')),
                           ('802-1x', ('password-flags', 'private-key-password-flags',
                                       'phase2-private-key-password-flags', 'pin-flags'))):
        for name in names:
            if profile.get(section, name, fallback='0') != '0':
                raise ConfigurationError('save the Wi-Fi password in nmtui for automatic reconnect before login')
    # Native nmtui stores secrets in this private system keyfile. Empty
    # permissions permit activation before login; no secret enters argv.
    run(['/usr/bin/nmcli', '--wait', '30', 'connection', 'modify', 'uuid', PROFILE_UUID,
         'connection.autoconnect', 'yes', 'connection.permissions', ''])
    validate_profile(policy)


def main():
    boot = sys.argv[1:] == ['--firstboot']
    native = sys.argv[1:2] == ['--nmtui']
    if native:
        if (os.geteuid() != 0 or not sys.stdin.isatty() or len(sys.argv) > 4
                or any(len(arg) > 128 or any(ord(c) < 32 or ord(c) == 127 for c in arg) for arg in sys.argv[2:])):
            raise ConfigurationError('nmtui requires an interactive authorized terminal')
        if sys.argv[2:] and sys.argv[2] not in {'edit', 'connect', 'hostname', '--help', '--version'}:
            raise ConfigurationError('unsupported nmtui command')
    if not boot and not native and (os.geteuid() != 0 or not re.fullmatch(r'[1-9][0-9]*', os.environ.get('PKEXEC_UID', ''))
            or len(sys.argv) != 2 or not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', sys.argv[1])
            or not sys.stdin.isatty()):
        raise ConfigurationError('use the Wi-Fi connection action from the desktop network menu')
    if os.geteuid() != 0:
        raise ConfigurationError('Wi-Fi firstboot requires root')
    os.umask(0o077)
    descriptor = os.open('/run/lock/wifi.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    with os.fdopen(descriptor, 'r+') as lock:
        info = os.fstat(lock.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1 or info.st_mode & 0o077:
            raise ConfigurationError('unsafe Wi-Fi configuration lock')
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if boot:
            firstboot()
        elif native:
            policy = parse_policy(read_owned(POLICY))
            configure(policy['MANAGED_NETWORK_WIFI_IFACE'], sys.argv[2:])
        else:
            configure(sys.argv[1])


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, RuntimeError, configparser.Error,
            subprocess.TimeoutExpired, EOFError, KeyboardInterrupt) as error:
        # Never print configuration, credentials, or subprocess output.
        if isinstance(error, ConfigurationError):
            print('Wi-Fi configuration did not complete: ' + str(error), file=sys.stderr)
        else:
            print('Wi-Fi configuration did not complete (' + type(error).__name__ + '). Check the static network policy and credentials.', file=sys.stderr)
        raise SystemExit(1)
