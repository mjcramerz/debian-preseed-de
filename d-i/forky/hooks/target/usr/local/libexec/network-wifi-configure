#!/usr/bin/python3 -IB
"""Persist the managed static Wi-Fi connection and open its native nmtui UI."""
import configparser
import fcntl
import io
import ipaddress
import os
from pathlib import Path
import re
import shlex
import stat
import subprocess
import sys
import tempfile
import time

POLICY = Path('/etc/network/host.conf')
PREPARED = Path('/etc/network/wifi.nmconnection')
PROFILE = Path('/etc/NetworkManager/system-connections/wifi.nmconnection')
FIRSTBOOT_DONE = Path('/var/lib/network-wifi/firstboot.complete')
PROFILE_UUID = '3f1b70be-cc3f-4e77-9e31-66f7a5e16994'
SHUTDOWN_STATE = Path('/var/lib/network-wifi/shutdown-state')
ETHERNET_SUPPRESSION_STATE = Path('/run/network-wifi/ethernet-suppressed')
ENVIRONMENT = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C.UTF-8'}
LOCK_WAIT_TIMEOUT = 45.0


class ConfigurationError(ValueError):
    """A safe diagnostic that never includes configuration contents or secrets."""


def normalize_mac(value):
    """Return NetworkManager's case-insensitive MAC spelling canonically."""
    normalized = (value or '').strip().lower()
    if not re.fullmatch(r'[0-9a-f]{2}(?::[0-9a-f]{2}){5}', normalized):
        raise ConfigurationError('managed Wi-Fi profile has an invalid MAC address')
    return normalized


def owned_parents(path):
    for parent in path.parents:
        info = parent.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise ConfigurationError('unsafe managed configuration parent')


def read_owned(path, modes=(0o600,)):
    owned_parents(path)
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    with os.fdopen(descriptor, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1
                or stat.S_IMODE(info.st_mode) not in modes):
            raise ConfigurationError('managed configuration must be a private root-owned regular file')
        data = stream.read(65537)
    if len(data) > 65536:
        raise ConfigurationError('managed configuration exceeds its size limit')
    return data.decode('utf-8')


def parse_policy(text):
    values = {}
    for line in text.split('\n'):
        if not line or line.startswith('#'):
            continue
        key, separator, raw = line.partition('=')
        if not separator or not re.fullmatch(r'MANAGED_NETWORK_[A-Z0-9_]+', key) or key in values:
            raise ConfigurationError('invalid or duplicate network policy assignment')
        parts = shlex.split(raw, comments=False)
        if len(parts) != 1:
            raise ConfigurationError('invalid network policy value')
        values[key] = parts[0]
    return values


def keyfile(text):
    result = configparser.ConfigParser(interpolation=None, strict=True, delimiters=('=',))
    result.optionxform = str
    result.read_string(text)
    if result.defaults():
        raise ConfigurationError('managed keyfile must not have inherited defaults')
    return result


def publish(path, text):
    owned_parents(path)
    descriptor, temporary = tempfile.mkstemp(prefix='.wifi-', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'w', encoding='utf-8') as stream:
            os.fchmod(stream.fileno(), 0o600)
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def run(argv, check=True, timeout=32):
    try:
        result = subprocess.run(argv, env=ENVIRONMENT, stdin=subprocess.DEVNULL,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        if not check:
            return 124
        raise
    if check and result.returncode:
        raise ConfigurationError('Wi-Fi adapter command failed: ' + Path(argv[0]).name + ' (status ' + str(result.returncode) + ')')
    return result.returncode


def wifi_policy(interface):
    if not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', interface) or interface in {'.', '..'}:
        raise ConfigurationError('invalid managed Wi-Fi interface name')
    policy = parse_policy(read_owned(POLICY))
    if (policy.get('MANAGED_NETWORK_MODE') != 'static'
            or 'wifi' not in policy.get('MANAGED_NETWORK_LINK_TYPES', '').split()
            or policy.get('MANAGED_NETWORK_WIFI_IFACE') != interface):
        raise ConfigurationError('selected Wi-Fi adapter is not owned by the static network policy')
    wifi = ipaddress.IPv4Interface(policy['MANAGED_NETWORK_WIFI_IPV4_CIDR'])
    if policy.get('MANAGED_NETWORK_WIFI_CIDR'):
        if wifi.ip not in ipaddress.IPv4Network(policy['MANAGED_NETWORK_WIFI_CIDR'], strict=False):
            raise ConfigurationError('Ethernet IPv4 +1 is outside PRESEED_WIFI_CIDR')
    ethernet_cidr = policy.get('MANAGED_NETWORK_ETHERNET_IPV4_CIDR')
    if ethernet_cidr:
        ethernet = ipaddress.IPv4Interface(ethernet_cidr)
        if wifi.network != ethernet.network or int(wifi.ip) != int(ethernet.ip) + 1:
            raise ConfigurationError('Wi-Fi must be Ethernet IPv4 +1 in the same subnet')
    if policy.get('MANAGED_NETWORK_IPV6_ENABLED') == 'true':
        wifi6 = ipaddress.IPv6Interface(policy['MANAGED_NETWORK_WIFI_IPV6_CIDR'])
        ethernet6_cidr = policy.get('MANAGED_NETWORK_ETHERNET_IPV6_CIDR')
        if ethernet6_cidr:
            ethernet6 = ipaddress.IPv6Interface(ethernet6_cidr)
            if wifi6.network != ethernet6.network or int(wifi6.ip) != int(ethernet6.ip) + 1:
                raise ConfigurationError('Wi-Fi must be Ethernet IPv6 +1 in the same subnet')
    return policy


def profile_path():
    return PROFILE if PROFILE.exists() or PROFILE.is_symlink() else PREPARED


def validate_profile(policy, path=None, *, persistent=True, autoconnect=None):
    profile = keyfile(read_owned(path or profile_path()))
    expected = {('connection', 'uuid'): PROFILE_UUID,
                ('connection', 'type'): 'wifi',
                ('connection', 'interface-name'): policy['MANAGED_NETWORK_WIFI_IFACE'],
                ('wifi', 'mode'): 'infrastructure',
                ('ipv4', 'forwarding'): '1',
                ('wifi', 'mac-address'): normalize_mac(policy['MANAGED_NETWORK_WIFI_MAC'])}
    if persistent:
        expected[('connection', 'autoconnect')] = 'false'
        expected[('connection', 'permissions')] = ''
    if autoconnect is not None:
        if autoconnect not in {'true', 'false'}:
            raise ConfigurationError('invalid managed Wi-Fi autoconnect state')
        expected[('connection', 'autoconnect')] = autoconnect
    for family in (4, 6):
        group = 'ipv' + str(family)
        enabled = family == 4 or policy.get('MANAGED_NETWORK_IPV6_ENABLED') == 'true'
        expected[(group, 'method')] = 'manual' if enabled else 'disabled'
        expected[(group, 'route-metric')] = '200'
        expected[(group, 'ignore-auto-dns')] = 'true'
        expected[(group, 'ignore-auto-routes')] = 'true'
        if enabled:
            expected[(group, 'address1')] = policy['MANAGED_NETWORK_WIFI_IPV' + str(family) + '_CIDR']
            expected[(group, 'gateway')] = policy['MANAGED_NETWORK_IPV' + str(family) + '_GATEWAY']
            dns = policy['MANAGED_NETWORK_IPV' + str(family) + '_DNS'].split()
            expected[(group, 'dns')] = ';'.join(dns) + ';' if policy['MANAGED_NETWORK_DNS_MODE'] == 'link' else ''
    for (group, name), value in expected.items():
        # NM may omit properties whose value equals its documented default.
        default = value if (group, name) == ('connection', 'autoconnect') else ('' if value == '' else None)
        actual = profile.get(group, name, fallback=default)
        if (group, name) == ('wifi', 'mac-address'):
            try:
                actual = normalize_mac(actual)
            except ConfigurationError:
                actual = ''
        if actual != value:
            raise ConfigurationError('managed Wi-Fi profile has incorrect ' + group + '.' + name)
    return profile


def publish_profile(policy):
    validate_profile(policy, PREPARED)
    PROFILE.parent.mkdir(mode=0o700, exist_ok=True)
    publish(PROFILE, read_owned(PREPARED))
    run(['/usr/bin/nmcli', '--wait', '30', 'connection', 'load', str(PROFILE)])


def firstboot():
    policy = parse_policy(read_owned(POLICY))
    if 'wifi' not in policy.get('MANAGED_NETWORK_LINK_TYPES', '').split():
        return
    policy = wifi_policy(policy['MANAGED_NETWORK_WIFI_IFACE'])
    validate_profile(policy, PREPARED)
    if PROFILE.exists() or PROFILE.is_symlink():
        validate_profile(policy, persistent=False)
        outcome = 'preserved-existing-profile'
    elif not policy.get('MANAGED_NETWORK_WIFI_ESSID'):
        outcome = 'skipped-missing-ssid'
    else:
        # Saving a known connection does not require its SSID or adapter to be
        # present now. NM activates it when available, respecting its persisted
        # radio preference. Do not reset that state or override rfkill at boot.
        publish_profile(policy)
        outcome = 'prepared-persistent-ssid'
    if PROFILE.exists() or PROFILE.is_symlink():
        autoconnect = 'true' if shutdown_wifi_was_connected() else 'false'
        policy_update = run(['/usr/bin/nmcli', '--wait', '30', 'connection', 'modify', 'uuid', PROFILE_UUID,
                             'connection.autoconnect', autoconnect, 'connection.permissions', ''], check=False)
        policy_update_succeeded = policy_update == 0
        ethernet = policy.get('MANAGED_NETWORK_ETHERNET_IFACE', '')
        ethernet_suppression_requested = False
        if (autoconnect == 'true' and 'ethernet' in policy.get('MANAGED_NETWORK_LINK_TYPES', '').split()
                and re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', ethernet)
                and carrier_state(ethernet) == 'up'):
            # The dispatcher may have observed Ethernet before this service.
            # Reuse the same marker so a later unplug restores the operator's
            # previous Wi-Fi preference.
            suppress_wifi_for_ethernet()
            autoconnect = 'false'
            ethernet_suppression_requested = True
            outcome += '-ethernet-preference-requested'
        if not policy_update_succeeded:
            outcome += '-reconnect-deferred'
        if ethernet_suppression_requested or not policy_update_succeeded:
            # Ethernet preference is intentionally best-effort. The NM
            # operation may fail while the device is changing state; preserve
            # the validated profile and let a later dispatcher event retry.
            validate_profile(policy, persistent=False)
        else:
            validate_profile(policy, autoconnect=autoconnect)
            outcome += '-reconnect-enabled' if autoconnect == 'true' else '-reconnect-disabled'
    FIRSTBOOT_DONE.parent.mkdir(mode=0o700, exist_ok=True)
    publish(FIRSTBOOT_DONE, outcome + '\n')
    print('Wi-Fi firstboot:', outcome, '; reconnect follows the recorded shutdown state.')


def configure(interface, ui_args=()):
    policy = wifi_policy(interface)
    validate_profile(policy, persistent=False)
    if profile_path() == PREPARED:
        # An explicit later request may prepare the saved profile after firstboot
        # had no SSID. The manual path below keeps its autoconnect state off.
        publish_profile(policy)
    print('Wi-Fi uses', policy['MANAGED_NETWORK_WIFI_IPV4_CIDR'], 'and the Ethernet gateway and resolver policy.')
    print('In nmtui, edit Wi-Fi for a new SSID; keep Manual IP settings and save its password for automatic reconnect.')
    run(['/usr/sbin/rfkill', 'unblock', 'wlan'])
    run(['/usr/bin/nmcli', '--wait', '30', 'radio', 'wifi', 'on'])
    environment = dict(ENVIRONMENT, TERM=os.environ.get('TERM', 'xterm-256color'))
    # The native terminal UI owns selection and secret prompting. Never create
    # an implicit DHCP profile with `nmcli device connect` or run ifup on Wi-Fi.
    result = subprocess.run(['/usr/bin/nmtui', *ui_args], env=environment, timeout=900)
    if result.returncode:
        raise ConfigurationError('nmtui exited with status ' + str(result.returncode))
    profile = validate_profile(policy, persistent=False)
    # Agent-only/not-saved passwords cannot authenticate before login. Native
    # nmtui's initial profile uses system-owned secrets; report an explicit
    # contrary selection instead of claiming persistent reconnect is ready.
    for section, names in (('wifi-security', ('psk-flags', 'wep-key-flags')),
                           ('802-1x', ('password-flags', 'private-key-password-flags',
                                       'phase2-private-key-password-flags', 'pin-flags'))):
        for name in names:
            if profile.get(section, name, fallback='0') != '0':
                raise ConfigurationError('save the Wi-Fi password in nmtui for automatic reconnect before login')
    # Native nmtui stores secrets in this private system keyfile. Empty
    # permissions permit activation before login; no secret enters argv. Keep
    # the explicit connection a manual session choice while it is active. The
    # shutdown recorder still enables the profile on the next boot when this
    # connection was active at shutdown.
    run(['/usr/bin/nmcli', '--wait', '30', 'connection', 'modify', 'uuid', PROFILE_UUID,
         'connection.autoconnect', 'no', 'connection.permissions', ''])
    clear_ethernet_suppression()
    validate_profile(policy, persistent=False, autoconnect='false')


def command_output(argv, timeout=15):
    try:
        result = subprocess.run(argv, env=ENVIRONMENT, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return 124, ''
    return result.returncode, result.stdout


def shutdown_wifi_was_connected():
    try:
        state = read_owned(SHUTDOWN_STATE).strip()
    except (FileNotFoundError, OSError, ConfigurationError, ValueError):
        return False
    return state == 'connected'


def record_shutdown_state():
    connected = False
    try:
        policy = parse_policy(read_owned(POLICY))
        interface = policy.get('MANAGED_NETWORK_WIFI_IFACE', '')
        if re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', interface):
            status, output = command_output(['/usr/bin/nmcli', '--get-values', 'GENERAL.STATE',
                                             'device', 'show', interface])
            connected = status == 0 and any(line.startswith('100 ') or line == '100'
                                            for line in output.splitlines())
    except (OSError, ValueError, KeyError, ConfigurationError):
        # An unavailable adapter or policy must not make shutdown fail. The
        # conservative state prevents a later boot from enabling reconnect.
        connected = False
    try:
        SHUTDOWN_STATE.parent.mkdir(mode=0o700, exist_ok=True)
        publish(SHUTDOWN_STATE, ('connected' if connected else 'disconnected') + '\n')
    except (OSError, ValueError, ConfigurationError):
        # The shutdown hook is advisory; keep the power transition best-effort.
        return


def connection_autoconnect():
    status, output = command_output(['/usr/bin/nmcli', '--get-values', 'connection.autoconnect',
                                     'connection', 'show', 'uuid', PROFILE_UUID])
    if status != 0:
        return None
    value = output.strip()
    return value if value in {'yes', 'no'} else None


def device_active(interface):
    if not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', interface) or interface in {'.', '..'}:
        return False
    status, output = command_output(['/usr/bin/nmcli', '--get-values', 'GENERAL.STATE',
                                     'device', 'show', interface])
    return status == 0 and any(line.startswith('100 ') or line == '100' for line in output.splitlines())


def sysfs_value(interface, name):
    if (not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', interface) or interface in {'.', '..'}
            or name not in {'carrier'}):
        return ''
    path = Path('/sys/class/net') / interface / name
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        with os.fdopen(descriptor, 'rb') as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1:
                return ''
            data = stream.read(4097)
        if len(data) > 4096:
            return ''
        return data.decode('ascii').strip()
    except (OSError, UnicodeError):
        return ''


def carrier_state(interface):
    value = sysfs_value(interface, 'carrier')
    if value == '1':
        return 'up'
    if value == '0':
        return 'down'
    return None


def connection_active():
    interface = policy_wifi_interface()
    return device_active(interface) if interface else False


def policy_wifi_interface():
    try:
        policy = parse_policy(read_owned(POLICY))
    except (FileNotFoundError, ConfigurationError):
        return ''
    interface = policy.get('MANAGED_NETWORK_WIFI_IFACE', '')
    return interface if re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', interface) else ''


def suppress_wifi_for_ethernet():
    autoconnect = connection_autoconnect()
    # A profile with autoconnect disabled may be active because the operator
    # explicitly connected it. Leave that manual session alone even when
    # Ethernet appears; route metrics still prefer Ethernet for new traffic.
    try:
        suppressed = read_owned(ETHERNET_SUPPRESSION_STATE).strip() == 'yes'
    except FileNotFoundError:
        suppressed = False
    if autoconnect != 'yes' and not suppressed:
        return
    # Retain the restoration intent before changing NM. A failed write must
    # leave its previous reconnect policy intact. Repeated reconciliations
    # retry a failed disconnect while preserving manual Wi-Fi sessions.
    if not suppressed:
        ETHERNET_SUPPRESSION_STATE.parent.mkdir(mode=0o700, exist_ok=True)
        publish(ETHERNET_SUPPRESSION_STATE, 'yes\n')
    if autoconnect != 'no':
        result = run(['/usr/bin/nmcli', '--wait', '30', 'connection', 'modify', 'uuid', PROFILE_UUID,
                      'connection.autoconnect', 'no'], check=False)
        if result != 0:
            return
    if connection_active():
        run(['/usr/bin/nmcli', '--wait', '30', 'connection', 'down', 'uuid', PROFILE_UUID], check=False)


def clear_ethernet_suppression():
    try:
        info = ETHERNET_SUPPRESSION_STATE.lstat()
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1
                or stat.S_IMODE(info.st_mode) != 0o600):
            return
        ETHERNET_SUPPRESSION_STATE.unlink()
    except (FileNotFoundError, OSError, ConfigurationError, ValueError):
        pass


def restore_wifi_after_ethernet():
    try:
        suppressed = read_owned(ETHERNET_SUPPRESSION_STATE).strip() == 'yes'
    except (FileNotFoundError, OSError, ConfigurationError, ValueError):
        suppressed = False
    if not suppressed:
        return
    if connection_autoconnect() != 'yes':
        result = run(['/usr/bin/nmcli', '--wait', '30', 'connection', 'modify', 'uuid', PROFILE_UUID,
                      'connection.autoconnect', 'yes'], check=False)
        if result != 0:
            return
    result = run(['/usr/bin/nmcli', '--wait', '30', 'connection', 'up', 'uuid', PROFILE_UUID], check=False)
    if result == 0:
        try:
            info = ETHERNET_SUPPRESSION_STATE.lstat()
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1
                    or stat.S_IMODE(info.st_mode) != 0o600):
                raise ConfigurationError('unsafe Ethernet suppression state')
            ETHERNET_SUPPRESSION_STATE.unlink()
        except (FileNotFoundError, OSError, ConfigurationError, ValueError):
            pass


def dispatcher_event(interface, event):
    if (not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', interface)
            or event not in {'up', 'down'}):
        return
    try:
        policy = parse_policy(read_owned(POLICY))
    except (OSError, ValueError, KeyError, ConfigurationError):
        return
    ethernet = policy.get('MANAGED_NETWORK_ETHERNET_IFACE', '')
    wifi = policy.get('MANAGED_NETWORK_WIFI_IFACE', '')
    if 'wifi' not in policy.get('MANAGED_NETWORK_LINK_TYPES', '').split():
        return
    if (not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', wifi) or wifi in {'.', '..'}
            or (ethernet and (not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', ethernet)
                              or ethernet in {'.', '..'}))):
        return
    if interface == ethernet and event == 'up':
        suppress_wifi_for_ethernet()
    elif interface == ethernet and event == 'down':
        restore_wifi_after_ethernet()


def carrier_event(interface):
    event = carrier_state(interface)
    if event in {'up', 'down'}:
        dispatcher_event(interface, event)


def acquire_lock(lock, *, wait: bool):
    """Take the shared Wi-Fi lock, waiting only for boot reconciliation."""
    deadline = time.monotonic() + LOCK_WAIT_TIMEOUT if wait else time.monotonic()
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return
        except BlockingIOError:
            remaining = deadline - time.monotonic()
            if not wait or remaining <= 0:
                raise
            time.sleep(min(0.1, remaining))


def main():
    boot = sys.argv[1:] == ['--firstboot']
    record = sys.argv[1:] == ['--record-shutdown']
    dispatcher = sys.argv[1:2] == ['--dispatcher']
    carrier = sys.argv[1:2] == ['--carrier']
    native = sys.argv[1:2] == ['--nmtui']
    if dispatcher and len(sys.argv) != 4:
        raise ConfigurationError('NetworkManager dispatcher requires an interface and event')
    if carrier and len(sys.argv) != 3:
        raise ConfigurationError('carrier reconciliation requires an interface')
    if native:
        if (os.geteuid() != 0 or not sys.stdin.isatty() or len(sys.argv) > 4
                or any(len(arg) > 128 or any(ord(c) < 32 or ord(c) == 127 for c in arg) for arg in sys.argv[2:])):
            raise ConfigurationError('nmtui requires an interactive authorized terminal')
        if sys.argv[2:] and sys.argv[2] not in {'edit', 'connect', 'hostname', '--help', '--version'}:
            raise ConfigurationError('unsupported nmtui command')
    if not boot and not record and not dispatcher and not carrier and not native and (os.geteuid() != 0 or not re.fullmatch(r'[1-9][0-9]*', os.environ.get('PKEXEC_UID', ''))
            or len(sys.argv) != 2 or not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', sys.argv[1])
            or not sys.stdin.isatty()):
        raise ConfigurationError('use the Wi-Fi connection action from the desktop network menu')
    if os.geteuid() != 0:
        raise ConfigurationError('Wi-Fi firstboot requires root')
    os.umask(0o077)
    descriptor = os.open('/run/lock/wifi.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    with os.fdopen(descriptor, 'r+') as lock:
        info = os.fstat(lock.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1 or info.st_mode & 0o077:
            raise ConfigurationError('unsafe Wi-Fi configuration lock')
        try:
            # Boot reconciliation waits for a concurrent dispatcher or carrier
            # transition. Link hooks remain advisory and return immediately;
            # the interactive nmtui path still reports a busy lock.
            acquire_lock(lock, wait=boot)
        except BlockingIOError as error:
            if dispatcher or carrier:
                return
            if boot:
                raise ConfigurationError('Wi-Fi reconciliation lock remained busy for 45 seconds; another network operation is still in progress') from error
            raise ConfigurationError('Wi-Fi configuration is already in progress; retry after the current operation finishes') from error
        if dispatcher:
            dispatcher_event(sys.argv[2], sys.argv[3])
        elif carrier:
            carrier_event(sys.argv[2])
        elif record:
            record_shutdown_state()
        elif boot:
            firstboot()
        elif native:
            policy = parse_policy(read_owned(POLICY))
            configure(policy['MANAGED_NETWORK_WIFI_IFACE'], sys.argv[2:])
        else:
            configure(sys.argv[1])


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, RuntimeError, configparser.Error,
            subprocess.TimeoutExpired, EOFError, KeyboardInterrupt) as error:
        if sys.argv[1:2] in (['--dispatcher'], ['--carrier']):
            # Dispatcher and carrier hooks are advisory. A transient NM, lock,
            # or filesystem failure must not block the link transition.
            raise SystemExit(0)
        # Never print configuration, credentials, or subprocess output.
        if isinstance(error, ConfigurationError):
            print('Wi-Fi configuration did not complete: ' + str(error), file=sys.stderr)
        else:
            print('Wi-Fi configuration did not complete (' + type(error).__name__ + '). Check the static network policy and credentials.', file=sys.stderr)
        raise SystemExit(1)
