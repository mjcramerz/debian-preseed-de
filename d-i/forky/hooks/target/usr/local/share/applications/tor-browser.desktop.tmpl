[Desktop Entry]
Type=Application
Name=Tor Browser
Comment=Browse websites and onion services through Tor
Exec=/usr/local/bin/labwc-app launch tor-browser %u
TryExec=/usr/local/libexec/tor-browser-run
Icon=__THEME_TOR_BROWSER_LAUNCHER_ICON_PATH__
Terminal=false
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=Tor Browser
Actions=ANOM;

[Desktop Action ANOM]
Name=ANOM (temporary state, Safest security)
Exec=/usr/local/bin/labwc-app pure-privacy tor-browser
