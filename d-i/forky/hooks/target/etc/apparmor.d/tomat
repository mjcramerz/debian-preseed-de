# Managed by unattended-installer.
abi "/usr/share/apparmor-features/features",
#include <tunables/global>

# User-manager controller and Waybar watcher entry point. Manager tools inherit
# this profile: scrubbing their environment on a Px transition breaks bus lookup.
profile labwc-tomat /usr/local/libexec/labwc-tomat flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/wrapper-python>
  #include <abstractions/dbus-session-strict>
  /usr/local/libexec/labwc-tomat rix,
  /usr/bin/{systemctl,systemd-run} rix,
  /usr/bin/tomat rpx -> tomat,
  /usr/bin/featherpad rpx -> desktop-editors,
  / r,
  /etc/ r,
  /run/ r,
  /run/user/ r,
  /run/systemd/system/ r,
  owner @{HOME}/ r,
  owner @{HOME}/.config/ r,
  owner @{HOME}/.config/tomat/ rw,
  owner @{HOME}/.config/tomat/config.toml rw,
  owner @{HOME}/.config/tomat/.config.toml.* rw,
  owner /run/user/[0-9]*/ r,
  owner /run/user/[0-9]*/systemd/private rw,
  owner /run/user/[0-9]*/labwc-tomat-control.lock rwk,
  owner /run/user/[0-9]*/labwc-tomat/ r,
  owner /run/user/[0-9]*/labwc-tomat/tomat.sock rw,
  unix (create, connect, send, receive, shutdown, getattr, getopt, setopt) type=stream,
  dbus (send) bus=session peer=(name=org.freedesktop.systemd1),
  dbus (receive) bus=session peer=(label=unconfined),
  signal (send, receive) peer=labwc-tomat,
  # Cleanup is addressed to the exact watch child, never a daemon PID lookup.
  signal (send) set=(term, kill) peer=tomat,
  signal (receive) set=(chld) peer=tomat,
  signal (receive) peer={unconfined,waybar},
  signal (send) set=(chld) peer={unconfined,waybar},
  deny network inet,
  deny network inet6,
  include if exists <local/labwc-tomat>
}

# Foreground daemon plus its fixed, bounded media-pause helper. The hook inherits
# rather than Px-transitions: NoNewPrivileges must not prevent its execution.
# The same attachment protects direct CLI use; the managed wrapper selects the
# private runtime directory and does not expose upstream PID-based daemon stop.
profile tomat /{usr/bin/tomat,usr/local/libexec/labwc-tomat-hook} flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/dbus-session-strict>
  #include <abstractions/pipewire-audio>
  /usr/bin/tomat mr,
  /usr/local/libexec/labwc-tomat-hook rix,
  /usr/bin/python3{,.[0-9]*} rix,
  /usr/bin/playerctl rix,
  /usr/lib/** mr,
  /etc/{group,passwd,nsswitch.conf,localtime} r,
  /usr/share/zoneinfo/{,**} r,
  /usr/share/locale/{,**} r,
  / r,
  /run/ r,
  /run/user/ r,
  owner @{HOME}/ r,
  owner @{HOME}/.config/ r,
  owner @{HOME}/.config/tomat/ r,
  owner @{HOME}/.config/tomat/config.toml r,
  # Upstream extracts its embedded notification icon here, using atomic rename.
  owner @{HOME}/.cache/ rw,
  owner @{HOME}/.cache/tomat/{,**} rw,
  owner /run/user/[0-9]*/ r,
  owner /run/user/[0-9]*/labwc-tomat/{,**} rwk,
  owner @{PROC}/[0-9]*/{cgroup,stat,status} r,
  owner @{PROC}/[0-9]*/task/[0-9]*/comm rw,
  @{sys}/fs/cgroup/**/cpu.max r,
  unix (create, bind, listen, accept, connect, send, receive, shutdown, getattr, getopt, setopt) type=stream,
  dbus (send) bus=session interface=org.freedesktop.Notifications peer=(name=org.freedesktop.Notifications),
  # playerctl enumerates MPRIS names, reads their properties and only pauses.
  dbus (send) bus=session interface=org.freedesktop.DBus member={ListNames,ListActivatableNames} peer=(name=org.freedesktop.DBus),
  dbus (send) bus=session path=/org/mpris/MediaPlayer2 interface=org.freedesktop.DBus.Properties member={Get,GetAll} peer=(name=org.mpris.MediaPlayer2.*),
  dbus (send) bus=session path=/org/mpris/MediaPlayer2 interface=org.mpris.MediaPlayer2.Player member=Pause peer=(name=org.mpris.MediaPlayer2.*),
  dbus (send) bus=session path=/org/mpris/MediaPlayer2 interface=org.freedesktop.DBus.Introspectable member=Introspect peer=(name=org.mpris.MediaPlayer2.*),
  dbus (receive) bus=session,
  signal (send, receive) peer=tomat,
  signal (receive) peer={unconfined,waybar,labwc-tomat},
  signal (send) set=(chld) peer={unconfined,waybar,labwc-tomat},
  deny network inet,
  deny network inet6,
  deny /dev/dri/** rw,
  deny /dev/{video,media}[0-9]* rw,
  deny /dev/input/** rw,
  deny owner @{HOME}/.local/lib/python*/** mrwkl,
  include if exists <local/tomat>
}
