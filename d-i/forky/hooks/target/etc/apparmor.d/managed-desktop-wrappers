profile managed-android-platform-tools /{bin/{adb,fastboot},usr/bin/{adb,fastboot},usr/local/bin/{adb,fastboot},usr/local/lib/android-sdk/platform-tools/{adb,etc1tool,fastboot,hprof-conv,make_f2fs,make_f2fs_casefold,mke2fs,sqlite3}} flags=(attach_disconnected) {
  #include <abstractions/managed-wrapper-desktop>
  include if exists <abstractions/nameservice-strict>
  include if exists <abstractions/ssl_certs>
  include if exists <abstractions/user-tmp>

  unix,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink dgram,
  network netlink raw,

  # adb enumerates process descriptor directories to find an existing server,
  # then reads only its own network namespace transport tables. Procfs owns
  # these table inodes as root even when the namespace belongs to this process,
  # so an AppArmor owner qualifier would reject the legitimate read.
  @{PROC}/ r,
  @{PROC}/[0-9]*/fd/ r,
  @{PROC}/@{pid}/net/{tcp,tcp6,udp,udp6} r,

  /{bin,usr/bin}/{adb,fastboot} rix,
  /usr/local/bin/{adb,fastboot} rix,
  /usr/local/lib/android-sdk/platform-tools/ r,
  /usr/local/lib/android-sdk/platform-tools/** mr,
  /usr/local/lib/android-sdk/platform-tools/{adb,etc1tool,fastboot,hprof-conv,make_f2fs,make_f2fs_casefold,mke2fs,sqlite3} rix,
  /dev/bus/usb/ r,
  /dev/bus/usb/** rw,
  /dev/usb/ r,
  /dev/usb/** rw,
  /run/udev/data/ r,
  /run/udev/data/** r,
  /sys/bus/usb/devices/ r,
  /sys/bus/usb/devices/** r,
  /sys/devices/**/{busnum,descriptors,devnum,idProduct,idVendor,manufacturer,product,serial,uevent} r,
  owner @{HOME}/ r,
  owner @{HOME}/** rwkl,
  /pool/ r,
  /pool/** rwkl,

  include if exists <local/usr.local.lib.android-platform-tools>
}

