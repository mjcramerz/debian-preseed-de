# Managed by unattended-installer.
#
# One attachment per repository-owned desktop, AppArmor, XSSH, and TPM wrapper,
# plus bounded domains for package launchers that precede their application
# attachment. Desktop host policy selects enforce or complain mode for this file.
# Short-lived validation and file-manipulation helpers inherit this domain.
# Long-running GUI, network, container, and privileged payloads transition to
# their own AppArmor attachment when present, with an unconfined fallback only
# where the wrapper contract must launch package-owned or operator-selected
# programs that do not ship a profile.

abi "/usr/share/apparmor-features/features",

#include <tunables/global>

profile labwc-chromium-launcher /usr/bin/chromium flags=(attach_disconnected) {
  #include <abstractions/managed-wrapper-base>
  include if exists <abstractions/user-tmp>

  /usr/bin/chromium rix,
  /bin/rm rix,
  /usr/bin/{cut,expr,find,grep,ls,mktemp,rm,sed,tr,uname} rix,
  /usr/bin/{findmnt,gdb,man,xmessage} pux,
  /etc/chromium.d/ r,
  /etc/chromium.d/** r,
  /usr/share/chromium/extensions/ r,
  /usr/share/chromium/extensions/** r,
  owner @{HOME}/ r,
  owner "@{HOME}/.config/chromium/Crash Reports/pending/" rw,
  owner "@{HOME}/.config/chromium/Crash Reports/pending/**" rwkl,
  owner /tmp/chromiumargs.* rwk,
  /usr/lib/chromium/chromium rPx -> chromium,

  include if exists <local/usr.bin.chromium-launcher>
}

