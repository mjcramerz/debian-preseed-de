profile managed-waypaper /{usr/local/bin/waypaper,opt/waypaper/bin/waypaper,opt/waypaper/pipx/venvs/waypaper/bin/waypaper} flags=(attach_disconnected) {
  #include <abstractions/managed-wrapper-gui>
  #include <abstractions/managed-wrapper-python>
  include if exists <abstractions/nameservice-strict>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  /usr/local/bin/waypaper rix,
  /opt/waypaper/bin/waypaper rix,
  /opt/waypaper/pipx/venvs/waypaper/bin/waypaper rix,
  /opt/waypaper/pipx/venvs/waypaper/bin/python* rix,
  /opt/waypaper/ r,
  /opt/waypaper/** mr,
  /usr/bin/bwrap rCx -> waypaper-bwrap,
  /usr/bin/kill rCx -> waypaper-kill,
  /usr/bin/ps rCx -> waypaper-ps,
  /usr/sbin/ldconfig rCx -> waypaper-ldconfig,
  /usr/libexec/glycin-loaders/2+/glycin-image-rs rPx -> waypaper-glycin-loader,
  /usr/libexec/glycin-loaders/2+/glycin-svg rPx -> waypaper-glycin-loader,
  # Waypaper is a selector only; the state helper owns controlled service restarts.
  /usr/local/bin/labwc-wallpaper-save rPx -> managed-labwc-wallpaper-save,

  / r,
  /dev/dri/card[0-9]* r,
  /usr/share/backgrounds/ r,
  /usr/share/backgrounds/** r,
  /usr/share/glycin-loaders/2+/conf.d/ r,
  /usr/share/glycin-loaders/2+/conf.d/** r,
  /usr/share/mime/mime.cache r,
  /usr/share/poppler/cMap/** r,
  signal (send) set=(kill) peer=managed-waypaper//waypaper-bwrap,
  owner /tmp/gdk-pixbuf-glycin-tmp.* rwk,
  owner @{HOME}/.cache/ rw,
  owner @{HOME}/.cache/glycin/ rw,
  owner @{HOME}/.cache/glycin/** rwkl,
  owner @{HOME}/.cache/waypaper/ rw,
  owner @{HOME}/.cache/waypaper/** rwkl,
  owner @{HOME}/.config/user-dirs.dirs r,
  owner @{HOME}/.config/waypaper/ rw,
  owner @{HOME}/.config/waypaper/** rwkl,
  owner @{HOME}/.local/state/ rw,
  owner @{HOME}/.local/state/waypaper/ rw,
  owner @{HOME}/.local/state/waypaper/** rwkl,

  profile waypaper-bwrap flags=(attach_disconnected, mediate_deleted) {
    #include <abstractions/base>
    #include <abstractions/managed-bwrap-common>
    include if exists <abstractions/fonts>

    signal (receive) set=(kill) peer=managed-waypaper,
    ptrace (readby) peer=managed-waypaper//waypaper-ps,

    /usr/bin/true rix,
    # Bubblewrap has already set no_new_privs; loaders must inherit this child.
    /usr/libexec/glycin-loaders/2+/{glycin-image-rs,glycin-svg} rix,
    /usr/share/backgrounds/ r,
    /usr/share/backgrounds/** r,
    /usr/share/glycin-loaders/2+/conf.d/ r,
    /usr/share/glycin-loaders/2+/conf.d/** r,

    owner @{HOME}/.cache/fontconfig/ r,
    owner @{HOME}/.cache/fontconfig/** r,
    owner @{HOME}/.cache/glycin/ rw,
    owner @{HOME}/.cache/glycin/** rwkl,
  }

  profile waypaper-ps flags=(attach_disconnected) {
    #include <abstractions/base>

    capability sys_ptrace,
    ptrace (read, readby) peer=@{profile_name},
    ptrace (read) peer=unconfined,
    ptrace (read) peer=managed-waypaper,
    ptrace (read) peer=managed-waypaper//waypaper-bwrap,
    ptrace (read) peer=managed-labwc-session,
    ptrace (read) peer=managed-labwc-output-watch,
    ptrace (read) peer=managed-labwc-plans,

    /usr/bin/ps mr,
    / r,
    /dev/pts/[0-9]* r,
    /dev/tty[0-9]* r,
    /etc/{ld.so.cache,nsswitch.conf,passwd} r,
    @{PROC}/ r,
    @{PROC}/{cpuinfo,meminfo,stat} r,
    @{PROC}/tty/drivers r,
    @{PROC}/sys/kernel/pid_max r,
    @{PROC}/[0-9]*/ r,
    @{PROC}/[0-9]*/{cmdline,environ,stat,status} r,
    @{PROC}/[0-9]*/task/ r,
    @{sys}/devices/system/cpu/possible r,
    @{sys}/devices/system/node/ r,
    /usr/share/zoneinfo/** r,
  }

  profile waypaper-kill flags=(attach_disconnected) {
    #include <abstractions/base>

    /usr/bin/kill mr,
    signal (send) set=(kill term) peer=unconfined,
  }

  profile waypaper-ldconfig flags=(attach_disconnected) {
    #include <abstractions/base>

    /usr/sbin/ldconfig mr,
    /dev/null rw,
    /etc/ld.so.cache r,
  }

  include if exists <local/usr.local.bin.waypaper>
}

