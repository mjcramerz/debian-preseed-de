# Managed by unattended-installer.
#
# Enforced Debian Chromium attachment. Common desktop IPC and bounded
# Intel/NVIDIA graphics come from the shared abstractions; this file owns only
# Chromium's package tree, policy, state, media devices, and network contract.

#include <abstractions/managed-electron-application>
#include <abstractions/managed-pipewire-audio>
include if exists <abstractions/user-tmp>
include if exists <abstractions/xdg-open>

network inet stream,
network inet6 stream,
network inet dgram,
network inet6 dgram,
network netlink raw,

/dev/video* rw,

/usr/lib/{chromium,ungoogled-chromium}/ r,
/usr/lib/{chromium,ungoogled-chromium}/** mrix,
deny /usr/lib/chromium/extensions/ w,
/usr/share/chromium/ r,
/usr/share/chromium/** r,

/etc/chromium/ r,
/etc/chromium/** r,
/etc/chromium.d/ r,
/etc/chromium.d/** r,

owner @{HOME}/.cache/chromium/ rw,
owner @{HOME}/.cache/chromium/** rwk,
owner @{HOME}/.config/chromium/ rw,
owner @{HOME}/.config/chromium/** rwkl,
owner @{HOME}/.config/chromium/NativeMessagingHosts/.bitwarden_desktop_proxy rix,
owner @{HOME}/.config/{chromium,microsoft-edge}/NativeMessagingHosts/ r,
owner @{HOME}/.config/{chromium,microsoft-edge}/NativeMessagingHosts/.app.bw.socket rw,
owner @{HOME}/.config/{chromium,microsoft-edge}/NativeMessagingHosts/.app.bw.bitwarden.log rwkl,
owner @{HOME}/.pki/nssdb/ rw,
owner @{HOME}/.pki/nssdb/** rwk,
owner @{HOME}/@{XDG_DOWNLOAD_DIR}/ rw,
owner @{HOME}/@{XDG_DOWNLOAD_DIR}/** rwkl,


# Opt-in developer profile used by /usr/local/bin/browser-devtools.
owner @{HOME}/.local/ r,
owner @{HOME}/.local/state/ r,
owner @{HOME}/.local/state/browser-devtools/ r,
owner @{HOME}/.local/state/browser-devtools/chromium/ rw,
owner @{HOME}/.local/state/browser-devtools/chromium/** rwkl,
