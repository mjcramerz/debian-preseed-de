# Managed by unattended-installer.
#
# Enforced Mullvad Browser attachment. The package launcher builds a dedicated
# ~/.mullvad-browser home before the real browser enters this profile.

#include <abstractions/managed-desktop-application>
#include <abstractions/managed-pipewire-audio>
include if exists <abstractions/user-tmp>
include if exists <abstractions/xdg-open>

io_uring,
mqueue type=posix,
userns,

capability sys_admin,
capability sys_chroot,

network inet stream,
network inet6 stream,
network inet dgram,
network inet6 dgram,
network netlink raw,
signal (send, receive) peer=@{profile_name},
signal (send) set=(kill) peer=mullvad-browser//mullvad-bwrap,

/dev/ r,
/dev/video* rw,
/dev/shm/ r,
owner /dev/shm/** rwkl,
/run/udev/data/{c13:*,+input:input*} r,

@{PROC}/ r,
@{PROC}/devices r,
@{PROC}/filesystems r,
@{PROC}/version r,
@{PROC}/sys/vm/mmap_min_addr r,
@{PROC}/sys/kernel/overflowgid r,
@{PROC}/sys/kernel/overflowuid r,
owner @{PROC}/@{pid}/ r,
owner @{PROC}/@{pid}/task/ r,
owner @{PROC}/@{pid}/task/@{tid}/ r,
owner @{PROC}/@{pid}/oom_score_adj w,
owner @{PROC}/@{pid}/task/@{tid}/comm rw,
owner @{PROC}/[0-9]*/{cgroup,cmdline,maps,stat} r,
owner @{PROC}/[0-9]*/task/[0-9]*/stat r,
owner @{PROC}/[0-9]*/{gid_map,setgroups,uid_map} w,
@{PROC}/[0-9]*/mountinfo r,

/etc/mime.types r,
@{sys}/fs/cgroup/**/cpu.max r,
/usr/lib/mullvad-browser/ r,
/usr/lib/mullvad-browser/** mrix,
/usr/bin/bwrap rCx -> mullvad-bwrap,
/usr/libexec/glycin-loaders/2+/glycin-image-rs rix,
/usr/libexec/glycin-loaders/2+/glycin-svg rix,
/usr/share/glycin-loaders/2+/conf.d/ r,
/usr/share/glycin-loaders/2+/conf.d/** r,

owner /run/user/[0-9]*/wayland-proxy-* rw,
owner @{HOME}/.cache/mullvad/ rw,
owner @{HOME}/.mullvad-browser/ rw,
owner @{HOME}/.mullvad-browser/** rwkl,
owner @{HOME}/.cache/mullvad/mullvadbrowser/ rw,
owner @{HOME}/.cache/mullvad/mullvadbrowser/** rwk,
owner @{HOME}/.mullvad/mullvadbrowser/ rw,
owner @{HOME}/.mullvad/mullvadbrowser/** rwkl,
owner @{HOME}/.config/ibus/bus/ r,
owner @{HOME}/.config/ibus/bus/** rw,
owner @{HOME}/@{XDG_DOWNLOAD_DIR}/ rw,
owner @{HOME}/@{XDG_DOWNLOAD_DIR}/** rwkl,

profile mullvad-bwrap flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/managed-bwrap-common>
  #include <abstractions/managed-desktop-application>
  include if exists <abstractions/user-tmp>

  signal (receive) set=(kill) peer=mullvad-browser,

  /usr/bin/true rix,
  /usr/lib/mullvad-browser/ r,
  /usr/lib/mullvad-browser/** mr,
  /usr/libexec/glycin-loaders/2+/glycin-image-rs rix,
  /usr/libexec/glycin-loaders/2+/glycin-svg rix,
  /usr/share/glycin-loaders/2+/conf.d/ r,
  /usr/share/glycin-loaders/2+/conf.d/** r,

  owner /run/user/[0-9]*/wayland-proxy-* rw,
  owner @{HOME}/.cache/mullvad/mullvadbrowser/ rw,
  owner @{HOME}/.cache/mullvad/mullvadbrowser/** rwk,
  owner @{HOME}/.mullvad-browser/ rw,
  owner @{HOME}/.mullvad-browser/** rwkl,
  owner @{HOME}/.mullvad/mullvadbrowser/ rw,
  owner @{HOME}/.mullvad/mullvadbrowser/** rwkl,
}
