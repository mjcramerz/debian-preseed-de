# Managed by unattended-installer.
#
# NVIDIA-only extension for the shared desktop graphics abstraction. Common
# CUDA and graphics device access is defined in the shared abstraction so
# confined CUDA workloads have one stable policy. This selected-hardware
# fragment retains module-parameter reads that are meaningful only when the
# NVIDIA driver is installed and active. NVIDIA userspace also probes the
# compatibility links for the fixed device major and the incident host's UVM
# major; udev creates those links, while these rules cover the bounded probe.

/dev/char/195:* rw,
/dev/char/234:* rw,
@{sys}/module/nvidia*/parameters/ r,
@{sys}/module/nvidia*/parameters/* r,
