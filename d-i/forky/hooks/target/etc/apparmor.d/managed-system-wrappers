# Managed by unattended-installer.
#
# Repository-owned system, storage, network, first-boot, Podman, and GitLab
# Runner control-plane wrappers. Every executable attachment is exact. Child
# helpers either transition to another named profile or inherit the calling
# wrapper's bounded job-specific domain. The unprivileged Podman client is
# an explicit exception: it transfers to a native client profile when present
# and otherwise to ordinary desktop-user policy; it is not a sudo broker.

abi "/usr/share/apparmor-features/features",

#include <tunables/global>

