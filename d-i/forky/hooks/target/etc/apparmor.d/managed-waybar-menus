# Managed by unattended-installer.
abi "/usr/share/apparmor-features/features",
#include <tunables/global>

# Read-only native notification-center UI, sharing the already running Mako
# daemon. Notification strings are plain GTK labels, never markup or commands.
profile managed-labwc-notifications /usr/local/libexec/labwc-notifications flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/managed-wrapper-python>
  #include <abstractions/managed-desktop-runtime>
  /usr/local/libexec/labwc-notifications rix,
  /usr/bin/makoctl rix,
  /usr/lib/** mr,
  /usr/share/{glib-2.0,gir-1.0,locale,themes,icons}/{,**} r,
  owner @{HOME}/.cache/ rw,
  owner @{HOME}/.cache/{fontconfig,mesa_shader_cache,mesa_shader_cache_db}/{,**} rwkl,
  owner @{HOME}/.config/{gtk-3.0,gtk-4.0}/{,**} r,
  owner /run/user/[0-9]*/ r,
  owner /run/user/[0-9]*/{bus,wayland-[0-9]*} rw,
  unix (create, connect, send, receive, shutdown, getattr, getopt, setopt) type=stream,
  dbus (bind) bus=session name=org.labwc.NotificationCenter,
  signal (send, receive) peer=managed-labwc-notifications,
  signal (receive) peer={unconfined,managed-waybar},
  signal (send) set=(chld) peer={unconfined,managed-waybar},
  deny network inet,
  deny network inet6,
  deny /dev/{video,media}[0-9]* rw,
  deny /dev/input/** rw,
  include if exists <local/managed-labwc-notifications>
}
