profile wayland-compat-slirp4netns flags=(attach_disconnected) {
  # The Zoom/Discord compatibility path needs a private network namespace so
  # wlroots cannot collide with the host Xwayland abstract Unix socket. Keep
  # its network helper separate from ChatGPT, Codex, and rootless Podman.
  userns,

  capability net_admin,
  capability sys_admin,
  capability sys_ptrace,

  network create unix stream,
  network inet stream,
  network inet dgram,
  ptrace (read) peer=labwc-wayland-compat-app//wayland-compat-app-bwrap,
  signal (receive) set=(exists kill term) peer=labwc-wayland-compat-app,

  / r,
  /dev/null rw,
  /dev/net/tun rw,
  /dev/urandom r,
  /etc/ld.so.cache r,
  /etc/resolv.conf r,
  /run/resolvconf/resolv.conf r,
  /run/systemd/resolve/stub-resolv.conf r,
  /usr/bin/slirp4netns mr,
  /usr/lib/@{multiarch}/ld-linux-*.so* mr,
  /usr/lib/@{multiarch}/lib{atomic,c,glib-2.0,m,pcre2-8,seccomp,slirp}.so* mr,
  @{PROC}/[0-9]*/ns/{net,user} r,
  owner /run/user/[0-9]*/labwc-{discord,zoom}-sandbox-*/slirp4netns.stderr rw,
  owner /tmp/labwc-{discord,zoom}-sandbox-*/slirp4netns.stderr rw,

  include if exists <local/usr.bin.slirp4netns-wayland-compat>
}

# The desktop session and ordinary applications must not start Cage or either
# the package-owned or private Xwayland binary directly. The managed
# Zoom/Discord Bubblewrap child above explicitly inherits its confined profile
# and therefore does not enter these fail-closed attachments.
profile labwc-cage-direct-exec-deny /usr/bin/cage flags=(attach_disconnected, mediate_deleted) {
