# Managed by unattended-installer. Zoom and Discord share this compatibility closure.
abi "/usr/share/apparmor-features/features",
#include <tunables/global>

profile labwc-zoom-discord-compat-runtime /usr/local/libexec/labwc-zoom-discord-compat-runtime flags=(attach_disconnected) {
