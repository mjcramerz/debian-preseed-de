  /sys/devices/**/vendor r,
  /sys/bus/pci/drivers/{i915,xe,nvidia}/ r,
  /proc/driver/nvidia/gpus/[0-9a-f]*/information r,
  deny /dev/dri/{card,controlD}[0-9]* rw,
  deny /dev/nvidia-modeset rw,
