# Managed by unattended-installer.

abi "/usr/share/apparmor-features/features",

#include <tunables/global>

profile Discord /opt/discord/Discord flags=(attach_disconnected) {
  #include <abstractions/managed-electron-application>
  #include <abstractions/managed-pipewire-audio>
  include if exists <abstractions/user-tmp>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  owner /dev/pts/[0-9]* rw,
  /dev/video* rw,
  owner @{PROC}/[0-9]*/mem r,

  /opt/discord/ r,
  /opt/discord/** mrix,
  /opt/discord/Discord rix,

  # Desktop clients must never bootstrap or update state as root. The managed
  # command wrapper rejects root before reaching this profile; these explicit
  # denies also cover a direct /opt/discord/Discord invocation.
  deny /root/.cache/discord/ rw,
  deny /root/.cache/discord/** rwkl,
  deny /root/.config/discord/ rw,
  deny /root/.config/discord/** rwkl,
  deny /root/.local/share/discord/ rw,
  deny /root/.local/share/discord/** rwkl,

  owner @{HOME}/.cache/discord/ rw,
  owner @{HOME}/.cache/discord/** rwk,
  owner @{HOME}/.config/discord/ rw,
  owner @{HOME}/.config/discord/** rwkl,
  owner @{HOME}/.local/share/discord/ rw,
  owner @{HOME}/.local/share/discord/** rwkl,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/ rw,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/** rwkl,

  include if exists <local/Discord>
}
