# Managed by unattended-installer.
#
# Bubblewrap namespace-construction mechanics shared by caller-specific child
# profiles. Application trees, user data, runtime sockets, network access, and
# payload transitions must remain in the including profile.

userns,

capability chown,
capability dac_override,
capability setgid,
capability setpcap,
capability setuid,
capability net_admin,
capability sys_admin,
capability sys_chroot,
capability sys_ptrace,

mount,
umount,
pivot_root,

network netlink dgram,
network netlink raw,
ptrace (read, trace) peer=@{profile_name},
signal (send, receive) peer=@{profile_name},

# Bubblewrap inventories the source root while constructing dynamic bind trees.
/ r,
@{PROC}/ r,
# Bubblewrap creates this mountpoint inside its private mount namespace before
# mounting procfs. Payload policy remains in the including child profile.
/proc/ w,
@{PROC}/filesystems r,
@{PROC}/sys/kernel/osrelease r,
@{PROC}/sys/kernel/overflowgid r,
@{PROC}/sys/kernel/overflowuid r,
@{PROC}/sys/user/max_user_namespaces r,
owner @{PROC}/@{pid}/ r,
owner @{PROC}/@{pid}/fd/ r,
owner @{PROC}/@{pid}/fd/[0-9]* rw,
owner @{PROC}/[0-9]*/ r,
owner @{PROC}/[0-9]*/{gid_map,setgroups,uid_map} rw,
@{PROC}/[0-9]*/cgroup r,
@{PROC}/[0-9]*/mountinfo r,
@{PROC}/[0-9]*/ns/ r,
@{PROC}/[0-9]*/ns/{mnt,user} r,

/dev/ r,
/dev/{full,null,ptmx,random,tty,urandom,zero} rw,
/dev/pts/ r,
/dev/pts/[0-9]* rw,
/bindfile* rw,
/oldroot/ rw,
/oldroot/** rwkl,
/newroot/ rw,
/newroot/** rwkl,
/tmp/ r,
/tmp/newroot/ rw,
/tmp/newroot/** rwkl,
/tmp/oldroot/ rw,
/tmp/oldroot/** rwkl,
/usr/bin/bwrap mr,
