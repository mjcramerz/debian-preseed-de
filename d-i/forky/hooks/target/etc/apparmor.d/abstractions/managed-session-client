# Trusted desktop panels/control clients, not compositor hardware access.
#include <abstractions/managed-desktop-runtime>
#include <abstractions/managed-pipewire-audio>
include if exists <abstractions/user-tmp>
unix,
network netlink raw,
network netlink dgram,
/usr/lib/** mr,
/usr/share/** r,
/usr/local/share/{icons,applications}/ r,
/usr/local/share/{icons,applications}/** r,
/etc/{os-release,localtime,passwd,group,machine-id} r,
/proc/ r,
/proc/{cpuinfo,meminfo,stat,uptime,loadavg,net/**} r,
owner /proc/[0-9]*/{stat,statm,status,comm,cmdline,fd/,fdinfo/*} r,
/sys/ r,
/sys/** r,
/run/udev/data/** r,
/dev/shm/ r,
owner /dev/shm/** rwkl,
owner /run/user/[0-9]*/ rw,
owner /run/user/[0-9]*/{bus,wayland-*,pulse/**,pipewire-*,mako,sway-ipc.*,hypr/**} rwkl,
owner @{HOME}/.config/{gtk-3.0,gtk-4.0,qt5ct,qt6ct}/** r,
owner @{HOME}/.config/{kdeglobals,kdeglobals.lock} rwkl,
owner @{HOME}/.cache/ rw,
owner @{HOME}/.cache/fontconfig/ rw,
owner @{HOME}/.cache/fontconfig/** rwkl,
owner /proc/[0-9]*/cgroup r,
# Profile-attached wrappers retain their domain across a panel click.
/usr/local/{bin,sbin,libexec}/** rPx,
# Prefer per-application policies; unprofiled simple helpers inherit these
# limited panel permissions, not an unconfined label or compositor devices.
/usr/bin/** rPix,
