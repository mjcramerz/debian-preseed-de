# Managed by unattended-installer.
#
# Chromium/Electron applications that construct their sandbox in the
# application domain. Callers with a separate sandbox-constructor profile must
# include managed-electron-runtime instead.

#include <abstractions/managed-electron-runtime>
userns,

# Top-level Chromium/Electron applications may hand external links to the
# system desktop handler. no_new_privs payload profiles include only the
# capability-free managed-electron-runtime abstraction.
/usr/bin/xdg-open rpux,

# Chromium-derived sandboxes request these capabilities only after entering an
# unprivileged user namespace. AppArmor permission does not grant the host
# process capabilities it does not already possess.
capability sys_admin,
capability sys_chroot,
capability sys_ptrace,

@{PROC}/sys/kernel/osrelease r,
@{PROC}/sys/kernel/overflowgid r,
@{PROC}/sys/kernel/overflowuid r,
@{PROC}/sys/user/max_user_namespaces r,
owner @{PROC}/[0-9]*/{gid_map,setgroups,uid_map} rw,
