# Managed by unattended-installer.
#
# Capability-free Chromium/Electron runtime shared by applications whose
# sandbox constructor runs in a separate AppArmor domain.

#include <abstractions/managed-desktop-runtime>

io_uring,
mqueue type=posix,

# Chromium crash handlers trace only processes carrying the same profile.
ptrace (read, trace) peer=@{profile_name},

@{PROC}/ r,
@{PROC}/devices r,
@{PROC}/filesystems r,
@{PROC}/loadavg r,
@{PROC}/meminfo r,
@{PROC}/stat r,
@{PROC}/uptime r,
@{PROC}/version r,
@{PROC}/sys/fs/inotify/max_user_watches r,
@{PROC}/sys/fs/pipe-max-size r,
@{PROC}/sys/kernel/pid_max r,
@{PROC}/sys/kernel/yama/ptrace_scope r,
@{PROC}/sys/vm/mmap_min_addr r,
owner @{PROC}/@{pid}/ r,
owner @{PROC}/@{pid}/task/ r,
owner @{PROC}/@{pid}/task/@{tid}/ r,
owner @{PROC}/@{pid}/oom_score_adj w,
owner @{PROC}/[0-9]*/oom_score_adj w,
owner @{PROC}/@{pid}/task/@{tid}/comm rw,
owner @{PROC}/[0-9]*/ r,
@{PROC}/[0-9]*/comm r,
owner @{PROC}/[0-9]*/{cgroup,cmdline,environ,maps,stat,statm,status} r,
@{PROC}/[0-9]*/cgroup r,
@{PROC}/[0-9]*/mountinfo r,
owner @{PROC}/[0-9]*/clear_refs w,
owner @{PROC}/[0-9]*/fd/ r,
owner @{PROC}/@{pid}/fd/[0-9]* rw,
owner @{PROC}/[0-9]*/smaps_rollup r,
owner @{PROC}/[0-9]*/task/ r,
owner @{PROC}/[0-9]*/task/[0-9]*/ r,
owner @{PROC}/[0-9]*/task/[0-9]*/comm rw,
owner @{PROC}/[0-9]*/task/[0-9]*/{stat,status} r,
@{PROC}/[0-9]*/fd/ r,
@{PROC}/[0-9]*/stat r,
@{PROC}/[0-9]*/task/[0-9]*/status r,
@{PROC}/pressure/{cpu,io,memory} r,
@{sys}/fs/cgroup/**/cpu.max r,
@{sys}/fs/cgroup/**/{memory.high,memory.max} r,
@{sys}/kernel/mm/transparent_hugepage/enabled r,
@{sys}/kernel/mm/transparent_hugepage/hpage_pmd_size r,

/dev/shm/ r,
owner /dev/shm/** rwkl,
deny /dev/tty[0-9]* r,
