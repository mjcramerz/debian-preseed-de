# Managed Tor Browser runtime. Executable transitions and IP networking belong
# to the including profile. Keep the immutable bundle separate from user state.

#include <abstractions/desktop-runtime>
include if exists <abstractions/user-tmp>
userns,
io_uring,
mqueue type=posix,
unix,
signal (send, receive) peer=@{profile_name},
ptrace (read, trace) peer=@{profile_name},

/opt/tor-browser/{,**} mr,
/etc/mime.types r,
/etc/ld.so.{cache,conf} r,
/etc/ld.so.conf.d/{,**} r,
# GTK/GdkPixbuf discovers packaged image loaders before decoding browser icons.
# Inherit both Tor profiles after no_new_privs, including the bwrap probe.
/usr/share/glycin-loaders/2+/conf.d/{,*.conf} r,
/usr/libexec/glycin-loaders/2+/{glycin-image-rs,glycin-svg} rix,
/usr/bin/{bwrap,true} rix,
owner /tmp/gdk-pixbuf-glycin-tmp.* rwk,
@{PROC}/ r,
@{PROC}/devices r,
@{PROC}/filesystems r,
@{PROC}/version r,
@{PROC}/cpuinfo r,
@{PROC}/sys/kernel/random/boot_id r,
@{PROC}/sys/{kernel/overflowgid,kernel/overflowuid,vm/mmap_min_addr} r,
owner @{PROC}/[0-9]*/{,cgroup,cmdline,maps,stat,statm,status,oom_score_adj} rw,
owner @{PROC}/[0-9]*/task/{,[0-9]*/,[0-9]*/comm,[0-9]*/stat} rw,
owner @{PROC}/[0-9]*/{gid_map,setgroups,uid_map} rw,
@{PROC}/[0-9]*/mountinfo r,
owner /run/user/[0-9]*/ r,
owner /run/user/[0-9]*/tor-*/{,**} rwkl,
owner /run/user/[0-9]*/bus rw,
owner /run/user/[0-9]*/wayland-[0-9]* rw,
owner /run/user/[0-9]*/wayland-proxy-* rw,
owner /run/user/[0-9]*/{pipewire-0,pulse/native} rw,
# libpulse opens and cleans up its private runtime directory. Both stacked
# Tor profiles include this rule; no other PulseAudio files are exposed.
owner /run/user/[0-9]*/pulse/ rw,
# Normal launches expose a proxy restricted to UPower reads. ANOM mounts none.
# The bus handshake and service discovery precede any UPower method call.
#include <abstractions/dbus-strict>
dbus (receive) bus=system
  path=/org/freedesktop/DBus interface=org.freedesktop.DBus
  member=NameOwnerChanged peer=(name=org.freedesktop.DBus),
dbus (send) bus=system
  path=/org/freedesktop/UPower{,/devices/*}
  interface={org.freedesktop.UPower,org.freedesktop.DBus.Properties}
  member={EnumerateDevices,GetDisplayDevice,Get,GetAll}
  peer=(name=org.freedesktop.UPower),
dbus (receive) bus=system peer=(name=org.freedesktop.UPower),
owner @{HOME}/ r,
owner @{HOME}/.local/{,share/} rw,
owner @{HOME}/.local/share/tor-browser/{,**} rwkl,
owner @{HOME}/.cache/{,**} rwkl,
owner @{HOME}/.config/{,**} rwkl,
owner @{HOME}/.tmp/{,**} rwkl,
owner @{HOME}/Downloads/{,**} rwkl,
/dev/{,shm/} r,
owner /dev/shm/** rwkl,
deny /dev/snd/{,**} rw,
deny /opt/xwayland/{,**} rxm,
deny /usr/bin/Xwayland rxm,
deny /tmp/.X11-unix/{,**} rw,
