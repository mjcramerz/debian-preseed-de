# Included ONLY when Intel tuning passes the explicit install and CPU gates.
/usr/local/lib/hardware_tuning/intel.py r,
/etc/hardware-tuning/intel.json r,
/run/hardware-tuning/intel.{json,lock} rwk,
/run/hardware-tuning/.intel.json.tuning-* rw,
/proc/cpuinfo r,
/sys/ r,
/sys/** r,
/sys/devices/system/cpu/cpufreq/policy[0-9]*/{scaling_governor,scaling_min_freq,scaling_max_freq,energy_performance_preference} w,
/sys/devices/system/cpu/intel_pstate/{min_perf_pct,max_perf_pct,no_turbo,hwp_dynamic_boost} w,
/sys/devices/system/cpu/cpu[0-9]*/power/energy_perf_bias w,
/sys/devices/system/cpu/intel_uncore_frequency/**/{min_freq_khz,max_freq_khz} w,
/sys/devices/**/constraint_[0-9]*_{power_limit_uw,time_window_us} w,
/sys/devices/**/{gt_min_freq_mhz,gt_max_freq_mhz,gt_boost_freq_mhz,rps_min_freq_mhz,rps_max_freq_mhz,rps_boost_freq_mhz} w,
/sys/devices/**/tile[0-9]*/gt[0-9]*/freq0/{min_freq,max_freq} w,
