  owner @{HOME}/.config/calix/{,**} rwkl,
  owner @{HOME}/.local/share/calix/{,**} rwkl,
  owner @{HOME}/.cache/{,calix/,calix/**,fontconfig/,fontconfig/**,mesa_shader_cache/,mesa_shader_cache/**,mesa_shader_cache_db/,mesa_shader_cache_db/**} rwkl,
  owner /run/user/[0-9]*/{bus,wayland-[0-9]*} rw,
  owner /dev/shm/** rwkl,
  unix,
  network inet stream,
  network inet6 stream,
  dbus (bind) bus=session name=com.ianswope.Calix,
  dbus (send, receive) bus=session peer=(name=com.ianswope.Calix),
  dbus (send, receive) bus=session interface=org.freedesktop.Secret.*,
  signal (receive) peer={unconfined,labwc-calendar},
  include if exists <local/calix>
}

