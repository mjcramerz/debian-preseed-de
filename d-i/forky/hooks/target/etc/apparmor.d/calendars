# Managed native calendar applications; no Xwayland eligibility.
abi "/usr/share/apparmor-features/features",
#include <tunables/global>

profile agenda /usr/local/bin/com.github.dahenson.agenda flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/desktop-runtime>
  include if exists <abstractions/user-tmp>
  /usr/local/bin/com.github.dahenson.agenda mr,
  /usr/local/share/agenda/{,**} r,
  /usr/local/share/icons/{,**} r,
  /usr/lib/** mr,
  /usr/share/** r,
  owner @{HOME}/.local/ r,
  owner @{HOME}/.local/share/agenda/{,**} rwkl,
  owner @{HOME}/.cache/{,fontconfig/,fontconfig/**,mesa_shader_cache/,mesa_shader_cache/**,mesa_shader_cache_db/,mesa_shader_cache_db/**} rwkl,
  owner /run/user/[0-9]*/{bus,wayland-[0-9]*} rw,
  owner /dev/shm/** rwkl,
  unix,
  dbus (bind) bus=session name=com.github.dahenson.agenda,
  dbus (send, receive) bus=session peer=(name=com.github.dahenson.agenda),
  signal (receive) peer={unconfined,labwc-agenda},
  deny network inet,
  deny network inet6,
  include if exists <local/agenda>
}

profile labwc-agenda /usr/local/bin/labwc-agenda flags=(attach_disconnected) {
  #include <abstractions/wrapper-desktop>
  /usr/local/bin/labwc-agenda rix,
  /usr/local/libexec/labwc-session-check rPx -> labwc-session-check,
  /usr/bin/systemctl pux,
  /usr/local/bin/com.github.dahenson.agenda rPx -> agenda,
  signal (receive) peer=unconfined,
}

profile labwc-calendar-actions /usr/local/libexec/labwc-calendar-actions flags=(attach_disconnected) {
  #include <abstractions/wrapper-python>
  #include <abstractions/desktop-runtime>
  /usr/local/libexec/labwc-calendar-actions r,
  /usr/bin/systemctl pux,
  /usr/local/libexec/labwc-calendar-worker rPx -> labwc-calendar-worker,
  /etc/{passwd,timezone,localtime} r,
  /usr/lib/** mr,
  /usr/share/** r,
  owner @{HOME}/.cache/{,fontconfig/,fontconfig/**,mesa_shader_cache/,mesa_shader_cache/**,mesa_shader_cache_db/,mesa_shader_cache_db/**} rwkl,
  owner /run/user/[0-9]*/{,bus,wayland-[0-9]*} rw,
  owner /run/user/[0-9]*/labwc-calendar-actions.lock rwk,
  owner /dev/shm/** rwkl,
  unix,
  signal (send, receive) peer=labwc-calendar-worker,
  signal (send) peer=unconfined,
  signal (receive) peer=unconfined,
  deny network inet,
  deny network inet6,
}

profile labwc-calendar-worker /usr/local/libexec/labwc-calendar-worker flags=(attach_disconnected) {
  #include <abstractions/wrapper-python>
  include if exists <abstractions/dbus-session>
  #include <abstractions/nameservice-strict>
  include if exists <abstractions/openssl>
  include if exists <abstractions/ssl_certs>
  /usr/local/libexec/labwc-calendar-worker r,
  /usr/lib/** mr,
  /usr/share/{glib-2.0,gir-1.0,locale,zoneinfo}/{,**} r,
  /etc/{passwd,localtime} r,
  /home/ r,
  owner @{HOME}/ r,
  owner @{HOME}/.config/ r,
  owner @{HOME}/.config/calix/ rw,
  owner @{HOME}/.config/calix/fruux-account.json r,
  owner @{HOME}/.config/calix/.fruux-actions.lock rwk,
  owner @{HOME}/.config/calix/fruux-pending.json rw,
  owner /run/user/[0-9]*/{,bus} rw,
  unix,
  network inet stream,
  network inet6 stream,
  dbus (send, receive) bus=session interface=org.freedesktop.Secret.*,
  signal (send, receive) peer=labwc-calendar-actions,
  signal (receive) peer=unconfined,
}

