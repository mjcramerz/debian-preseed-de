profile labwc-waycal-hover /usr/local/libexec/labwc-waycal-hover flags=(attach_disconnected) {
  #include <abstractions/wrapper-python>
  include if exists <abstractions/dbus-session>
  include if exists <abstractions/dbus-accessibility>
  /usr/local/libexec/labwc-waycal-hover r,
  /usr/bin/systemctl rix,
  /usr/lib/** mr,
  /usr/share/{glib-2.0,gir-1.0,locale}/{,**} r,
  /proc/ r,
  owner /proc/[0-9]*/{,exe} r,
  ptrace (read) peer=waybar,
  owner /run/user/[0-9]*/{,bus,at-spi/,at-spi/**,systemd/private} rw,
  unix,
  signal (send, receive) peer=labwc-waycal-hover,
  signal (receive) peer=unconfined,
  deny network inet,
  deny network inet6,
}
