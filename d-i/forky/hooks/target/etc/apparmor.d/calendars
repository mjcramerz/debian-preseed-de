# Managed native calendar applications; no Xwayland eligibility.
abi "/usr/share/apparmor-features/features",
#include <tunables/global>

profile agenda /usr/local/bin/com.github.dahenson.agenda flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/desktop-runtime>
  include if exists <abstractions/user-tmp>
  /usr/local/bin/com.github.dahenson.agenda mr,
  # The packaged Agenda startup invokes this loader; retain Agenda confinement.
  /usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 rix,
  /usr/local/share/agenda/{,**} r,
  /usr/local/share/icons/{,**} r,
  /usr/lib/** mr,
  /usr/share/** r,
  owner @{HOME}/.local/ r,
  owner @{HOME}/.local/share/agenda/{,**} rwkl,
  owner @{HOME}/.cache/{,fontconfig/,fontconfig/**,mesa_shader_cache/,mesa_shader_cache/**,mesa_shader_cache_db/,mesa_shader_cache_db/**} rwkl,
  owner /run/user/[0-9]*/{bus,wayland-[0-9]*} rw,
  owner /dev/shm/** rwkl,
  unix,
  dbus (bind) bus=session name=com.github.dahenson.agenda,
  dbus (send, receive) bus=session peer=(name=com.github.dahenson.agenda),
  signal (receive) peer={unconfined,labwc-app},
  # GTK-NoCSD reads the application command line during toolkit startup.
  owner @{PROC}/@{pid}/cmdline r,
  owner @{PROC}/[0-9]*/cgroup r,
  @{sys}/fs/cgroup/**/cpu.max r,
  owner @{HOME}/.cache/glycin/{,**} rwkl,
  /usr/bin/bwrap rCx -> agenda-glycin-bwrap,
  signal (send) set=(kill term) peer=agenda//agenda-glycin-bwrap,
  profile agenda-glycin-bwrap flags=(attach_disconnected, mediate_deleted) {
    #include <abstractions/base>
    #include <abstractions/bwrap-common>
    include if exists <abstractions/fonts>
    signal (receive) set=(kill term) peer=agenda,
    /usr/bin/true rix,
    /usr/libexec/glycin-loaders/2+/{glycin-image-rs,glycin-svg} rix,
    /usr/lib/** mr,
    /usr/share/glycin-loaders/2+/conf.d/{,**} r,
    /usr/share/mime/mime.cache r,
    /usr/{,local/}share/icons/{,**} r,
    owner /tmp/gdk-pixbuf-glycin-tmp.* rwk,
    owner @{HOME}/.cache/fontconfig/{,**} r,
    owner @{HOME}/.cache/glycin/{,**} rwkl,
  }
  deny network inet,
  deny network inet6,
  include if exists <local/agenda>
}

profile labwc-calendar-actions /usr/local/libexec/labwc-calendar-actions flags=(attach_disconnected) {
  #include <abstractions/wrapper-python>
  #include <abstractions/desktop-runtime>
  /usr/local/libexec/labwc-calendar-actions r,
  /usr/local/lib/python3.14/dist-packages/labwc_calendar_reminders.py r,
  /usr/bin/systemctl pux,
  /usr/bin/notify-send rix,
  /usr/bin/bwrap rPx -> session-glycin-bwrap,
  /tmp/ r,
  owner /tmp/gdk-pixbuf-glycin-tmp.* rwk,
  /usr/local/libexec/labwc-calendar-worker rPx -> labwc-calendar-worker,
  /etc/{passwd,timezone,localtime} r,
  /usr/lib/** mr,
  /usr/share/** r,
  owner @{HOME}/.cache/{,fontconfig/,fontconfig/**,mesa_shader_cache/,mesa_shader_cache/**,mesa_shader_cache_db/,mesa_shader_cache_db/**} rwkl,
  owner /run/user/[0-9]*/{,bus,wayland-[0-9]*} rw,
  owner /run/user/[0-9]*/labwc-calendar-actions.lock rwk,
  owner /dev/shm/** rwkl,
  unix,
  dbus (send) bus=session path=/org/freedesktop/Notifications
    interface=org.freedesktop.Notifications member=Notify
    peer=(name=org.freedesktop.Notifications),
  signal (send, receive) peer=labwc-calendar-worker,
  signal (send) set=(kill term) peer=session-glycin-bwrap,
  signal (send) peer=unconfined,
  signal (receive) peer=unconfined,
  deny network inet,
  deny network inet6,
}

profile labwc-calendar-worker /usr/local/libexec/labwc-calendar-worker flags=(attach_disconnected) {
  #include <abstractions/wrapper-python>
  include if exists <abstractions/dbus-session>
  #include <abstractions/nameservice-strict>
  include if exists <abstractions/openssl>
  include if exists <abstractions/ssl_certs>
  /usr/local/libexec/labwc-calendar-worker r,
  /usr/local/lib/python3.14/dist-packages/labwc_calendar_reminders.py r,
  /usr/lib/** mr,
  /usr/share/{glib-2.0,gir-1.0,locale,zoneinfo}/{,**} r,
  /etc/{passwd,localtime} r,
  /home/ r,
  owner @{HOME}/ r,
  owner @{HOME}/.config/ r,
  owner @{HOME}/.config/calix/ rw,
  owner @{HOME}/.config/calix/fruux-account.json r,
  owner @{HOME}/.config/calix/.fruux-actions.lock rwk,
  owner @{HOME}/.config/calix/fruux-pending.json rw,
  owner @{HOME}/.config/calix/phone-{reminders,deliveries}.json rw,
  owner @{HOME}/.config/calix/.phone-{reminders,deliveries}.json.*.tmp rw,
  /etc/labwc/plans.conf r,
  owner /run/user/[0-9]*/{,bus} rw,
  unix,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  # Permit the AF_NETLINK/SOCK_RAW socket reported by the HTTPS worker.
  network netlink raw,
  dbus (send, receive) bus=session interface=org.freedesktop.Secret.*,
  signal (send, receive) peer=labwc-calendar-actions,
  signal (receive) peer=labwc-plans,
  signal (receive) peer=unconfined,
}

profile calix /opt/calix/calix flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/desktop-runtime>
  include if exists <abstractions/user-tmp>
  /opt/calix/{calix,release.json} mr,
  /usr/lib/** mr,
  /usr/share/** r,
  /usr/local/share/icons/{,**} r,
  owner @{HOME}/.config/calix/{,**} rwkl,
  owner @{HOME}/.local/share/calix/{,**} rwkl,
  owner @{HOME}/.cache/{,calix/,calix/**,fontconfig/,fontconfig/**,mesa_shader_cache/,mesa_shader_cache/**,mesa_shader_cache_db/,mesa_shader_cache_db/**} rwkl,
  owner /run/user/[0-9]*/{bus,wayland-[0-9]*} rw,
  owner /dev/shm/** rwkl,
  unix,
  network inet stream,
  network inet6 stream,
  # The Rust HTTP resolver needs UDP DNS before opening its HTTPS stream.
  network inet dgram,
  network inet6 dgram,
  dbus (bind) bus=session name=com.ianswope.Calix,
  dbus (send, receive) bus=session peer=(name=com.ianswope.Calix),
  dbus (send, receive) bus=session interface=org.freedesktop.Secret.*,
  # Calendar/GTK initialization reads same-owner process metadata.
  owner @{PROC}/@{pid}/{cmdline,stat} r,
  signal (receive) peer={unconfined,labwc-app},
  include if exists <local/calix>
}

profile waycal /opt/waycal/waycal flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/desktop-runtime>
  include if exists <abstractions/user-tmp>
  /opt/waycal/{waycal,release.json} mr,
  /usr/lib/** mr,
  /usr/share/** r,
  owner @{HOME}/.config/gtk-4.0/{,gtk.css} r,
  owner @{HOME}/.config/waycal/{,style.css} r,
  owner @{HOME}/.local/ r,
  owner @{HOME}/.local/state/ rw,
  owner @{HOME}/.local/state/waycal/{,**} rwkl,
  owner @{HOME}/.cache/{,fontconfig/,fontconfig/**,mesa_shader_cache/,mesa_shader_cache/**,mesa_shader_cache_db/,mesa_shader_cache_db/**} rwkl,
  owner /run/user/[0-9]*/{bus,wayland-[0-9]*} rw,
  owner /dev/shm/** rwkl,
  unix,
  dbus (bind) bus=session name=com.forrestknight.waycal,
  # GTK-NoCSD inspects its own command line, as with the Agenda profile.
  owner @{PROC}/@{pid}/cmdline r,
  signal (send) set=(chld) peer=labwc-waycal-popup,
  signal (receive) peer=unconfined,
  deny network inet,
  deny network inet6,
  include if exists <local/waycal>
}

profile calix-fruux-bootstrap /usr/local/libexec/calix-fruux-bootstrap flags=(attach_disconnected) {
  #include <abstractions/wrapper-python>
  include if exists <abstractions/dbus-session>
  /usr/local/libexec/calix-fruux-bootstrap r,
  /usr/lib/** mr,
  /usr/share/{glib-2.0,gir-1.0,locale}/{,**} r,
  /etc/passwd r,
  /home/ r,
  owner @{HOME}/ r,
  owner @{HOME}/.config/ r,
  owner @{HOME}/.config/calix/{,**} rwkl,
  owner @{HOME}/.local/ rw,
  owner @{HOME}/.local/share/ rw,
  owner @{HOME}/.local/share/calix/{,**} rwkl,
  owner /run/user/[0-9]*/{,bus} rw,
  unix,
  dbus (send, receive) bus=session interface=org.freedesktop.Secret.*,
  signal (receive) peer=unconfined,
  deny network inet,
  deny network inet6,
}

profile fruux-cleanup /var/lib/firstboot/bin/fruux-cleanup flags=(attach_disconnected) {
  #include <abstractions/wrapper-python>
  #include <abstractions/nameservice-strict>
  /var/lib/firstboot/bin/fruux-cleanup r,
  /usr/local/libexec/calix-fruux-bootstrap rPx -> calix-fruux-bootstrap,
  capability setuid,
  capability setgid,
  signal (receive) peer={unconfined,secondboot-cleanup},
}

profile labwc-waycal-control /usr/local/libexec/labwc-waycal-control flags=(attach_disconnected) {
  #include <abstractions/wrapper-python>
  include if exists <abstractions/dbus-session>
  /usr/local/libexec/labwc-waycal-control r,
  /usr/bin/systemctl rix,
  /usr/bin/systemd-run rix,
  /usr/bin/busctl rix,
  # Waybar can pass a read-only rfkill descriptor across this profile transition.
  /dev/rfkill r,
  /usr/lib/** mr,
  /usr/share/{glib-2.0,gir-1.0,locale}/{,**} r,
  owner /run/user/[0-9]*/{,bus,systemd/private} rw,
  # AppArmor requires a literal hyphen first in a character class.
  owner /run/user/[0-9]*/wayland-[-A-Za-z0-9_]* r,
  owner /run/user/[0-9]*/labwc-waycal-control.lock rwk,
  unix,
  signal (send, receive) peer=labwc-waycal-control,
  signal (receive) peer=unconfined,
  deny network inet,
  deny network inet6,
}

# Temporary native layer-shell input surfaces. This service-owned supervisor
# starts only the pinned Waycal executable; no raw input or key injection.
profile labwc-waycal-popup /usr/local/libexec/labwc-waycal-popup flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/wrapper-python>
  #include <abstractions/desktop-runtime>
  /usr/local/libexec/labwc-waycal-popup r,
  /opt/waycal/waycal rPx -> waycal,
  /usr/lib/** mr,
  /usr/share/** r,
  owner @{HOME}/.config/gtk-3.0/{,**} r,
  owner @{HOME}/.cache/{,fontconfig/,fontconfig/**,mesa_shader_cache/,mesa_shader_cache/**,mesa_shader_cache_db/,mesa_shader_cache_db/**} rwkl,
  owner /run/user/[0-9]*/{,bus,wayland-[-A-Za-z0-9_]*} rw,
  owner /dev/shm/** rwkl,
  unix,
  signal (receive) set=(chld) peer=waycal,
  signal (receive) set=(term int kill) peer=unconfined,
  signal (send) set=(chld) peer=unconfined,
  deny network inet,
  deny network inet6,
  deny /dev/input/** rw,
  include if exists <local/labwc-waycal-popup>
}
