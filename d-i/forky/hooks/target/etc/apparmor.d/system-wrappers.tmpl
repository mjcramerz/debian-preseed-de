  /usr/share/initramfs-tools/** r,
  /{,usr/}{,s}bin/** rix,
  /lib/ r,
  /lib/** mr,
  /usr/lib/ r,
  /usr/lib/** mr,
  /run/mkinitramfs/ rw,
  /run/mkinitramfs/** rwkl,
  /tmp/mkinitramfs_*/ rw,
  /tmp/mkinitramfs_*/** rwkl,
