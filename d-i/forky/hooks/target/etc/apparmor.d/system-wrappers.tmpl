  /usr/bin/{awk,cat,chmod,cmp,cp,cut,date,dirname,find,findmnt,flock,grep,gzip,id,install,mkdir,mktemp,mokutil,mount,mv,openssl,readlink,rm,sbsign,sbverify,sed,sort,systemctl,umount,xz,zstd} rix,
  /usr/sbin/{cryptsetup,depmod,modinfo,modprobe,update-initramfs} rix,
  /sbin/{cryptsetup,depmod,modinfo,modprobe,update-initramfs} rix,
  /usr/src/linux-headers-*/scripts/sign-file rix,
  /usr/lib/linux-kbuild-*/scripts/sign-file rix,
  /lib/modules/*/build/scripts/sign-file rix,

  /boot/ rw,
  /boot/** rwkl,
  /dev/disk/ r,
  /dev/disk/** r,
  /dev/mapper/ rw,
  /dev/mapper/** rw,
  /dev/{mmcblk*,nvme*,sd*,vd*} rw,
  /dev/tty rw,
  /etc/secure-boot.conf r,
  /etc/initramfs-tools/ rw,
  /etc/initramfs-tools/** rwkl,
  /etc/kernel/ rw,
  /etc/kernel/** rwkl,
  /etc/ssl/ r,
  /etc/ssl/** r,
  /lib/modules/ rw,
  /lib/modules/** rwkl,
  /proc/self/mounts r,
  /run/dbus/system_bus_socket rw,
  /run/lock/ rw,
  /run/lock/** rwkl,
  /run/systemd/private rw,
  /var/lib/tpm2-enrollment/ rw,
  /var/lib/tpm2-enrollment/** rwkl,
  /usr/src/ r,
  /usr/src/** rwkl,
  owner /tmp/secure-boot.* rwkl,
  owner /tmp/secure-boot.*/ rw,
  owner /tmp/secure-boot.*/** rwkl,

  include if exists <local/usr.libexec.install-tools.secure-boot-tool>
}

profile secure-boot-kernel-hooks /etc/kernel/{postinst.d/zz-sign-kernel,postrm.d/zz-sign-kernel-cleanup,header_postinst.d/zz-sign-kernel-headers} flags=(attach_disconnected) {
  #include <abstractions/wrapper-base>

  /etc/kernel/{postinst.d/zz-sign-kernel,postrm.d/zz-sign-kernel-cleanup,header_postinst.d/zz-sign-kernel-headers} rix,
  /usr/libexec/install-tools/secure-boot-tool rPx -> secure-boot-tool,

  include if exists <local/secure-boot-kernel-hooks>
}

# PID-1-owned policy workers: no user-data, key-store or network grants.
profile labwc-apparmor-policy-worker /usr/local/libexec/labwc-apparmor-policy-worker flags=(attach_disconnected) {
  #include <abstractions/wrapper-perl>
  /usr/local/libexec/labwc-apparmor-policy-worker rix,
  /usr/local/lib/perl5/site_perl/labwc-security-action/{,**} r,
  /usr/local/lib/perl5/site_perl/runtime/{,**} r,
  /usr/local/libexec/apparmor-modes-run rPx -> apparmor-modes,
  /usr/local/libexec/labwc-apparmor-boot-state rPx -> labwc-apparmor-boot-state,
  /usr/bin/{readlink,systemctl} rix,
  /usr/sbin/{aa-audit,apparmor_parser} rPUx,
  /etc/apparmor/{logprof.conf,parser.conf} r,
  /etc/apparmor.d/ r,
  /etc/apparmor.d/* rw,
  /etc/apparmor.d/{abi,abstractions,local,tunables}/ r,
  /var/lib/apparmor/ rw,
  /var/lib/apparmor/backup/{,**} rwkl,
  signal (send) set=(hup, int, term, kill, cont),
  /etc/apparmor/ rw,
  /etc/apparmor/modes.conf rw,
  /etc/apparmor/.modes.* rwkl,
  /sys/module/apparmor/parameters/enabled r,
  /var/lib/labwc-apparmor-policy/ rw,
  /var/lib/labwc-apparmor-policy/policy.lock rwk,
  include if exists <local/usr.local.libexec.labwc-apparmor-policy-worker>
}

profile labwc-apparmor-boot-state /usr/local/libexec/labwc-apparmor-boot-state flags=(attach_disconnected) {
  #include <abstractions/wrapper-python>
  /usr/local/libexec/labwc-apparmor-boot-state r,
  # Exact package-owned entrypoints; GRUB must probe host devices. The owning
  # system service still restricts network, writable mounts and process lifetime.
  /usr/sbin/grub-mkconfig rPUx,
  /usr/bin/grub-script-check rPUx,
  signal (send) set=(hup, int, term, kill, cont),
  / r,
  /etc/ r,
  /etc/default/ r,
  /etc/default/grub.d/ rw,
  /etc/default/grub.d/35-security-core.cfg rw,
  /etc/default/grub.d/.labwc-apparmor.* rw,
  /boot/ r,
  /boot/grub/ rw,
  /boot/grub/grub.cfg rw,
  /boot/grub/.labwc-apparmor.* rw,
  /usr/ r,
  /usr/{bin,sbin}/ r,
  /var/ r,
  /var/lib/ r,
  /var/lib/labwc-apparmor-policy/ rw,
  /var/lib/labwc-apparmor-policy/{boot.lock,boot-transaction.json,.labwc-apparmor.*} rwk,
  include if exists <local/usr.local.libexec.labwc-apparmor-boot-state>
}
