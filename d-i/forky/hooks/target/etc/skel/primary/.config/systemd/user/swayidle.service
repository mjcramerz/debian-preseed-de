[Unit]
StartLimitBurst=5
StartLimitIntervalSec=60s
BindsTo=labwc-compositor.service
After=labwc-compositor.service labwc-session.target labwc-output-watch.service
Description=Manage Labwc session idle and lock policy
ConditionEnvironment=LABWC_SESSION_OWNER=desktop
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_TYPE=wayland
Requisite=labwc-session.target
PartOf=labwc-session.target

[Service]
TimeoutStartSec=30s
KillMode=control-group
Type=exec
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecCondition=/usr/local/libexec/labwc-session-check session-ready
ExecStart=/usr/local/libexec/labwc-swayidle
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
#PrivateTmp=yes

[Install]
WantedBy=labwc-session.target
