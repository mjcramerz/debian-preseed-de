<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <!-- The login greeter has no desktop portal. Prevent GTK from activating
       the desktop-only service on _greetd's bus; real users retain portals. -->
  <policy user="__INSTALLER_LABWC_GREETER_USER__">
    <deny send_destination="org.freedesktop.portal.Desktop"/>
  </policy>
</busconfig>
