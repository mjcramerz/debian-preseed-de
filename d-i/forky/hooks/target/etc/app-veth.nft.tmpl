destroy table inet app_veth
table inet app_veth {
    set links { type ifname; }
    set sources { type ifname . ipv4_addr; }
    set outbound { type ifname; }
    set lan_blocked { type ifname; }
    set no_http { type ifname; }
    set web_tls_only { type ifname; }
    set tor_transport { type ifname; }
    set web_ports { type inet_service; elements = { __INSTALLER_PROXY3_PORTS_ALLOW_WEB_BROWSER__ }; }
    set lan_ipv4 { type ipv4_addr; flags interval; }
    set pinned { type ifname . ifname; }
    set incoming { type ifname . ipv4_addr . inet_proto . inet_service; }
    map forwards { type ipv4_addr . inet_proto . inet_service : ipv4_addr . inet_service; }
    map rpc { type inet_service : ipv4_addr . inet_service; }
    map gateways { type ifname : ipv4_addr; }
    map snat_map { type ifname : ipv4_addr; }
    map peer_snat { type ifname . inet_proto . inet_service : ipv4_addr . inet_service; }
    chain source_guard {
        type filter hook prerouting priority -150; policy accept;
        iifname __APP_INTERFACES__ meta nfproto != ipv4 drop
        iifname __APP_INTERFACES__ iifname . ip saddr != @sources drop
        # Tor uses relay IPs from its authenticated directory information.
        # Deny ordinary DNS before the shared DNS DNAT hook can see it.
        iifname @tor_transport meta l4proto { tcp, udp } th dport 53 counter drop
        iifname @tor_transport meta l4proto != tcp counter drop
    }
    chain dns_and_peers {
        type nat hook prerouting priority dstnat; policy accept;
        iifname @links ip daddr __DNS_ADDRESS__ meta l4proto { tcp, udp } th dport 53 dnat to __DNS_HOST_ADDRESS__:__DNS_HOST_PORT__
        meta l4proto { tcp, udp } dnat ip to ip daddr . meta l4proto . th dport map @forwards
    }
    chain rpc_output {
        type nat hook output priority dstnat; policy accept;
        ip daddr 127.0.0.1 meta l4proto tcp dnat to tcp dport map @rpc
        meta l4proto { tcp, udp } dnat ip to ip daddr . meta l4proto . th dport map @forwards
    }
    chain host_guard {
        type filter hook input priority -10; policy accept;
        iifname @tor_transport meta l4proto { tcp, udp } th dport 53 counter drop
        iifname @links ip daddr __DNS_HOST_ADDRESS__ meta l4proto { tcp, udp } th dport __DNS_HOST_PORT__ ct status dnat accept
        # Replies to the exact host-initiated peer/RPC DNAT maps must return
        # to their initiating host socket; unrelated host access stays denied.
        iifname @links ct state established,related ct status dnat accept
        # Only browser leases may reach host HTTPS listeners on the same
        # configured port allowlist. Loopback addresses still refer to the guest.
        iifname @web_tls_only iifname != @lan_blocked meta l4proto tcp tcp dport @web_ports accept
        iifname __APP_INTERFACES__ drop
    }
    chain forward_guard {
        type filter hook forward priority -10; policy accept;
        iifname __APP_INTERFACES__ oifname __APP_INTERFACES__ drop
        # Only the exact DNS endpoint is DNATed to the local cache. Block
        # direct ordinary DNS before unpinned or pinned application egress.
        iifname @links meta l4proto { tcp, udp } th dport 53 drop
        # Enforce the torrent policy before either pinned or ordinary egress.
        # This also covers redirects and changes made in the application's UI.
        iifname @no_http meta l4proto { tcp, udp } th dport 80 counter drop
        # Browser namespaces have TCP-only egress on the CONNECT allowlist.
        # DNS uses the exact preceding DNAT endpoint; peers belong to qBittorrent.
        iifname @web_tls_only meta l4proto != tcp counter drop
        iifname @web_tls_only tcp dport != @web_ports counter drop
        iifname @lan_blocked ip daddr @lan_ipv4 drop
        iifname @outbound accept
        iifname . oifname @pinned accept
        oifname @links ct state established,related accept
        oifname . ip daddr . meta l4proto . th dport @incoming ct status dnat accept
        iifname __APP_INTERFACES__ drop
        oifname __APP_INTERFACES__ drop
    }
    chain nat {
        type nat hook postrouting priority srcnat; policy accept;
        # uTP, UDP trackers and incoming peers share the advertised listener.
        # Preserve that exact TCP/UDP source port through the host NAT layer.
        iifname @links meta l4proto { tcp, udp } snat ip to iifname . meta l4proto . th sport map @peer_snat
        iifname @links snat ip to iifname map @snat_map
        iifname @outbound masquerade
        oifname @links ip saddr 127.0.0.0/8 snat ip to oifname map @gateways
    }
}
