[Unit]
Requisite=labwc-session.target
Description=Unprivileged intel performance hardware tuning lease
PartOf=intel-performance.target labwc-session.target
After=labwc-session.target
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/local/bin/labwc-hardware-tuning lease intel performance
Restart=on-failure
RestartSec=5s
TimeoutStopSec=3s
KillMode=control-group
Slice=background.slice
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
