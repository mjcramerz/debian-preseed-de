[Unit]
Description=Fallback watcher for Timeshift runtime state and the GRUB snapshot menu
ConditionPathExists=/usr/local/libexec/grub-btrfs-refresh

[Path]
# Runtime PID directories are created/removed even when Timeshift uses mounts.
# A level-triggered PathExistsGlob would restart this service continuously.
PathChanged=/run/timeshift
Unit=grub-btrfs-refresh.service

[Install]
WantedBy=multi-user.target
