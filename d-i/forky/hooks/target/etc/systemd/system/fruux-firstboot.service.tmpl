[Unit]
Description=Provision the installed Calix Fruux account before desktop login
After=local-fs.target
Before=greetd.service
RequiresMountsFor=__INSTALLER_ACCOUNT_HOME__
ConditionPathExists=__INSTALLER_ACCOUNT_HOME__/.config/calix/fruux-bootstrap.json
ConditionPathExists=!__INSTALLER_ACCOUNT_HOME__/.config/calix/fruux-state.json

[Service]
Type=oneshot
User=__INSTALLER_ACCOUNT_USERNAME__
Environment=HOME=__INSTALLER_ACCOUNT_HOME__
Environment=XDG_CONFIG_HOME=__INSTALLER_ACCOUNT_HOME__/.config
Environment=XDG_DATA_HOME=__INSTALLER_ACCOUNT_HOME__/.local/share
UnsetEnvironment=DBUS_SESSION_BUS_ADDRESS DISPLAY WAYLAND_DISPLAY
ExecStart=/usr/local/libexec/calix-fruux-bootstrap --provision
TimeoutStartSec=60s
TimeoutStopSec=5s
KillMode=control-group
# This installed helper attaches its AppArmor profile on exec.
NoNewPrivileges=no
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
