[Unit]
Description=Load verified Mullvad GUI AppArmor namespace policy
Requires=apparmor.service
After=apparmor.service
Before=mullvad-daemon.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/apparmor_parser --replace --skip-cache /etc/apparmor.d/mullvad
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
