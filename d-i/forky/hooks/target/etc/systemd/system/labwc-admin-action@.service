[Unit]
Description=Execute authorized Labwc desktop power action (%i)
Documentation=man:systemd.service(5) man:systemctl(1)
After=systemd-logind.service
Wants=systemd-logind.service
ConditionFileIsExecutable=/usr/local/libexec/labwc-admin-action-worker

[Service]
# Host logind/PID-1 IPC and user-manager handoff must retain host credentials.
PrivatePIDs=no
PrivateUsers=no
Type=notify
NotifyAccess=main
ExecStart=/usr/local/libexec/labwc-admin-action-worker %i
TimeoutStartSec=60s
# Package waits must outlive arbitrarily long installs. All command transports,
# save dialogs, desktop jobs and guest hooks retain their individual timeouts.
# Cancellation is systemctl stop, never a timeout-triggered power fallback.
RuntimeMaxSec=infinity
RuntimeDirectory=labwc-power
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStopSec=5s
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=labwc-admin-action
UMask=0077
AppArmorProfile=managed-labwc-admin-action-worker
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
# PID 1/logind perform cgroup cleanup; this controller does not scan other PIDs.
ProtectProc=default
ProtectSystem=strict
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
