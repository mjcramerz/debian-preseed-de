[Unit]
Description=Apply downloaded managed external desktop application updates
Documentation=man:systemd.service(5)
Wants=network-online.target
After=network-online.target apt-daily.service apt-daily-upgrade.service
RequiresMountsFor=/opt /usr /var/lib/software
ConditionArchitecture=x86-64
ConditionFileIsExecutable=/usr/local/libexec/managed-external-software-update

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/managed-external-software-update --apply-only
TimeoutStartSec=60min
TimeoutStopSec=10min
StateDirectory=software
StateDirectoryMode=0755
Nice=19
CPUQuota=__INSTALLER_MANAGED_EXTERNAL_SOFTWARE_CPU_QUOTA__
IOSchedulingClass=idle
# The enforced wrapper validates artifacts before transitioning into package
# management tools. NoNewPrivileges would reject those AppArmor transitions.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc /opt /usr /var/lib/software
# ChatGPT policy repair transitions into the fixed managed AppArmor-mode
# helper. Its only additional writable surfaces match that dedicated service.
ReadWritePaths=/sys/kernel/security/apparmor /var/cache/apparmor
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
