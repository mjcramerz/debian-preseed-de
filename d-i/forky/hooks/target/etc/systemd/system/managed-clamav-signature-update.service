[Unit]
Description=Update official and curated external ClamAV signatures
Documentation=man:freshclam(1) man:fangfrisch(1)
Wants=network-online.target
After=network-online.target nss-lookup.target
ConditionFileIsExecutable=/usr/bin/freshclam
ConditionFileIsExecutable=/usr/bin/fangfrisch
ConditionFileIsExecutable=/usr/local/libexec/managed-clamav-signature-update
ConditionPathExists=/etc/fangfrisch.conf

[Service]
Type=oneshot
User=clamav
Group=clamav
Environment=HOME=/var/lib/fangfrisch
ExecStart=/usr/local/libexec/managed-clamav-signature-update
TimeoutStartSec=45min
TimeoutStopSec=30s
StateDirectory=fangfrisch
StateDirectoryMode=0770
LogsDirectory=clamav
LogsDirectoryMode=0750
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# The enforced wrapper profile deliberately transitions into the package-owned
# signature clients. NoNewPrivileges would reject those AppArmor transitions.
NoNewPrivileges=false
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/clamav /var/lib/fangfrisch /var/log/clamav
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0027
