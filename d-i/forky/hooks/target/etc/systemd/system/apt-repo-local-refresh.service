[Unit]
Description=Discover updates and atomically publish the local APT repository
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/lib/software/repo/current

[Service]
Type=oneshot
ExecCondition=/usr/local/libexec/network-online-check
ExecStart=/usr/local/bin/apt-repo-init --refresh
User=root
Group=root
UMask=0077
TimeoutStartSec=2h
TimeoutStopSec=30s
KillMode=control-group
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=-/run/user/0/gnupg
ReadWritePaths=/var/lib/software /etc/apt/keyrings /etc/apt/sources.list.d /run/lock
# The root publisher must enter the dedicated tuta-extract and bwrap AppArmor
# profiles. NNP rejects those explicit transitions. The parser itself drops
# uid/gid/capabilities and sets NNP inside its isolated namespace.
NoNewPrivileges=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apt-repo-local-refresh
