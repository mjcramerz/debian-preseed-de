# Never write to an underlying root filesystem before managed log/spool mounts.
[Unit]
RequiresMountsFor=__INSTALLER_LOG_POWER_DIR__ __INSTALLER_LOG_ROOT__ __INSTALLER_LOG_RSYSLOG_SPOOL_DIR__
After=systemd-journald.service systemd-tmpfiles-setup.service

[Service]
LimitNOFILE=__INSTALLER_LOG_RSYSLOG_MAX_OPEN_FILES__
ExecStartPre=/usr/local/libexec/journal-check
ExecStartPre=/usr/local/libexec/log-layout --preflight
ExecStartPre=/usr/bin/systemd-tmpfiles --create /etc/tmpfiles.d/59-log-layout.conf /etc/tmpfiles.d/60-security-logs.conf /etc/tmpfiles.d/65-audit-syslog.conf
ExecStartPre=/usr/local/libexec/log-layout
ExecStartPre=/usr/sbin/rsyslogd -N1 -f /etc/rsyslog.conf
