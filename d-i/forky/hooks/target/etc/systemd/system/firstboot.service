[Unit]
Description=First boot provisioning and validation wrapper
Documentation=man:systemd.service(5)

Wants=network-online.target apparmor-managed-modes.service
Requires=local-fs.target systemd-tmpfiles-setup.service
After=local-fs.target systemd-tmpfiles-setup.service systemd-journald.socket network-online.target apparmor-managed-modes.service

# The wrapper skips a successful marker under its lock. Failed legacy markers
# must not suppress a fresh validation attempt.

Conflicts=shutdown.target
Before=shutdown.target

[Service]
# Do not use oneshot here: multi-user.target waits only for the successful
# exec transition, not for the wrapper's complete diagnostic runtime.
Type=exec
ExecStart=/usr/local/libexec/firstboot.sh

StandardOutput=journal
StandardError=journal

TimeoutStartSec=30s
RuntimeMaxSec=35min
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=control-group

User=root
Group=root
UMask=0077

[Install]
WantedBy=multi-user.target
