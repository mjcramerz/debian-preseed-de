[Unit]
Description=Create the managed eight-times-daily Timeshift snapshot
ConditionPathExists=/usr/bin/timeshift
ConditionPathExists=/etc/timeshift/timeshift.json
After=local-fs.target

[Service]
Type=oneshot
TimeoutStartSec=6h
TimeoutStopSec=30s
KillMode=control-group
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
UMask=0077
ExecStart=/usr/local/libexec/timeshift-snapshot daily
# Reconcile after cleanup on success or failure; the timer covers missed events.
ExecStopPost=/usr/bin/systemctl --no-block start grub-btrfs-refresh.service
