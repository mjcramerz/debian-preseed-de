[Unit]
Description=Create the managed eight-times-daily Timeshift snapshot
ConditionPathExists=/usr/bin/timeshift
ConditionPathExists=/etc/timeshift/timeshift.json
After=local-fs.target

[Service]
Type=oneshot
TimeoutStartSec=6h
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
UMask=0077
ExecStart=/usr/local/libexec/timeshift-managed-snapshot daily
# Queue only after the snapshot command has finished; the timer covers missed events.
ExecStartPost=/usr/bin/systemctl --no-block start grub-btrfs-refresh.service
