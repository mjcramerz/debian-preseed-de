# Managed base unit: dependency removal requires a full override, not a drop-in.
# Keep Debian getdns/stubby's notify, DynamicUser and runtime-directory contract.
# The early listener ordering and sandbox belong to 60-app-veth.conf.
[Unit]
Description=DNS Privacy Stub Resolver
Documentation=https://dnsprivacy.org/wiki/display/DP/DNS+Privacy+Daemon+-+Stubby

[Service]
Type=notify
WorkingDirectory=/run/stubby
ExecStart=/usr/bin/stubby -C /etc/stubby/stubby.yml
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RuntimeDirectory=stubby
DynamicUser=true
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
