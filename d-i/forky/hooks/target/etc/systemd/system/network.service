[Unit]
Description=Validate managed static networking for installed adapters
Documentation=man:interfaces(5) man:systemd.service(5)
DefaultDependencies=no

Requires=local-fs.target
After=local-fs.target systemd-udev-trigger.service
Wants=network-pre.target
Before=network-pre.target networking.service NetworkManager.service systemd-networkd.service

ConditionPathExists=/usr/local/libexec/network-run
ConditionPathExists=/etc/network/host.conf
ConditionPathExists=/etc/system-runtime.conf
ConditionPathExists=/etc/network/interfaces.d/50-network

[Service]
Type=oneshot
EnvironmentFile=/etc/system-runtime.conf
ExecStart=/usr/local/libexec/network-run validate --wait-seconds 15
RemainAfterExit=yes
TimeoutStartSec=20s
TimeoutStopSec=10s

StandardOutput=journal
StandardError=journal

User=root
Group=root
UMask=0022

PrivateTmp=true
ProtectHome=true
NoNewPrivileges=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=sysinit.target
