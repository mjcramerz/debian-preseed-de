[Unit]
# DNS and a synchronized clock are prerequisites for a reliable initial
# control-plane TLS session, not merely a configured link.
# Load the TUN driver before tailscaled creates or cleans up its managed link.
Wants=systemd-modules-load.service network-online.target nss-lookup.target time-sync.target
Requires=nftables.service dnsmasq-app-veth.service apparmor.service
BindsTo=nftables.service dnsmasq-app-veth.service apparmor.service
PartOf=nftables.service dnsmasq-app-veth.service apparmor.service
# Ordering after the network manager and network target does not pull either
# unit into the transaction. It keeps the physical network stack available
# until tailscaled has drained its own shutdown work queue.
After=systemd-modules-load.service NetworkManager.service network.target network-online.target nss-lookup.target time-sync.target
After=nftables.service dnsmasq-app-veth.service apparmor.service systemd-sysctl.service

[Service]
ExecStart=
ExecStart=/usr/local/libexec/tailscale-netkit run --state=/var/lib/tailscale/tailscaled.state --socket=/run/tailscale/tailscaled.sock --port=${PORT} $FLAGS
ExecStopPost=
ExecStopPost=/usr/local/libexec/tailscale-netkit cleanup
Type=notify
NotifyAccess=all
RuntimeDirectory=
RuntimeDirectory=tailscale-netkit
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
PrivateMounts=yes
# Signed APT owns package updates. A remote client update otherwise tries to
# escape the daemon's lifecycle through systemd-run and run dpkg/apt as root.
# Disable that entry point; bootstrap also clears AutoUpdate.Apply.
Environment=TS_ALLOW_ADMIN_CONSOLE_REMOTE_UPDATE=false
# This image owns its packet policy through nftables. Select Tailscale's
# netlink-backed nftables router explicitly, bypassing iptables detection.
# The environment-sanitizing daemon delegate enforces the same selection.
# Upstream startup cleanup still checks for legacy tools independently; the
# daemon AppArmor profile denies their execution even if later installed.
Environment=TS_DEBUG_FIREWALL_MODE=nftables
# Preserve Tailscale's automatic port 80 Noise to HTTPS/443 fallback.
# Upstream tailscaled performs DNS and router cleanup unconditionally before it
# starts the daemon. Do not duplicate that cleanup in a repository-owned
# ExecStartPre. Running tailscaled --cleanup again after the daemon exits also
# races the daemon's own teardown. Replace the package ExecStopPost with
# identity-checked cleanup of this service's own netkit resources.
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=60s
KillMode=control-group
SendSIGKILL=yes
RestartPreventExitStatus=78 79
# Tailscale's Go logger prefixes MESSAGE with YYYY/MM/DD HH:MM:SS. Accept
# that prefix or the unprefixed form, with the complete diagnostic anchored.
# Upstream cleanup is best-effort and runs before creation of the private TUN.
# Discard only its missing-link no-op for the configured interface.
LogFilterPatterns=~^([0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} )?router: enumerating __INSTALLER_TAILSCALE_INTERFACE_REGEX__ addresses for cleanup failed: failed to look up link "__INSTALLER_TAILSCALE_INTERFACE_REGEX__": Link not found$
# Startup cleanup also probes absent legacy executables even in nftables mode.
# Keep permission failures and every other firewall diagnostic visible.
LogFilterPatterns=~^([0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} )?linuxfw: clear iptables: exec: "iptables": executable file not found in [$]PATH$
LogFilterPatterns=~^([0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} )?linuxfw: clear ip6tables: exec: "ip6tables": executable file not found in [$]PATH$
# Tailscale currently logs this exact message after it closes its extension
# work queue and then asks the closed queue to drain. Upstream treats extension
# shutdown callback failures as non-fatal. Discard only that deterministic
# shutdown diagnostic; retain every other tailscaled message.
LogFilterPatterns=~^([0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} )?ipnext: work queue shutdown failed: execqueue shut down$
# Control-plane errors, including a superseded lite-map update (HTTP 409),
# remain visible. Upstream owns their retry/backoff and health reporting.
PrivateTmp=true
# AppArmor denies namespace authority to the daemon. Its explicit login/su
# transition returns authenticated SSH sessions to the host namespaces/PAM.
# That named transition needs to acquire its narrowly scoped constructor label.
NoNewPrivileges=false
ProtectControlGroups=true
ProtectKernelLogs=true
# systemd 262 implements this restriction by returning ENOSYS for openat2.
# The packaged Bubblewrap requires openat2 to resolve its fixed mount sources;
# filtering it prevents construction before the confined daemon can start.
RestrictSUIDSGID=no
LockPersonality=true
SystemCallArchitectures=native
