[Unit]
Description=Reconcile the configured static Wi-Fi reconnect policy
Requires=NetworkManager.service
After=NetworkManager.service
Before=greetd.service
ConditionPathExists=/etc/network/wifi.nmconnection
StartLimitIntervalSec=10min
StartLimitBurst=2

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/network-wifi-configure --firstboot
# Allow the 45s lock wait plus at most 158s of bounded NM calls, including
# Ethernet preference reconciliation. The cgroup deadline covers the whole run.
TimeoutStartSec=240s
TimeoutStopSec=10s
KillMode=control-group
Restart=on-failure
RestartSec=30s
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
# Preserve the explicit transitions into native nmcli/rfkill profiles.
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
