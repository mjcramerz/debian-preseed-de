[Unit]
Description=Wait for APT/dpkg and reserve package locks through sleep/resume
Documentation=man:fcntl(2) man:systemd.special(7)
Before=sleep.target
StopWhenUnneeded=yes

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/libexec/labwc-admin-action-worker --sleep-guard
# READY is sent only after both package locks are reserved; never time out
# into an unprotected suspend. A startup error makes sleep.target fail closed.
TimeoutStartSec=infinity
RuntimeMaxSec=infinity
# Share power-action serialization with desktop/greeter workers.
RuntimeDirectory=labwc-power
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStopSec=5s
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=labwc-package-sleep-guard
UMask=0077
AppArmorProfile=managed-labwc-admin-action-worker
NoNewPrivileges=yes
PrivatePIDs=no
PrivateUsers=no
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectProc=default
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
