/var/log/syslog
/var/log/mail.log
/var/log/kern.log
/var/log/user.log
/var/log/cron.log
/var/log/daemon.log
/var/log/messages
{
	daily
	rotate 4
	maxage 7
	maxsize 8M
	missingok
	notifempty
	compress
	delaycompress
	create 0640 root adm
	su root adm
	sharedscripts
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}
