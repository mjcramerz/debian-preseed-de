# Keep sudo, PAM, SSH, login, and other auth/authpriv messages in the managed
# protected authentication logs. Records without attested origin go to the
# separate unverified log, outside CrowdSec/Fail2Ban inputs. A root-owned signal
# contains no log content and only wakes the Labwc/Mako bridge for explicit
# authentication failures. Routine session-open/session-close and successful
# sudo records remain available without creating desktop noise. Only verified
# records reach auth.log and its security consumers; none reach apps.log.

template(
  name="AuthDesktopSignal"
  type="string"
  string="auth\n"
)

template(name="UnverifiedAuthDiagnostic" type="string"
         string="%timegenerated% %hostname% %syslogtag% origin=unverified-auth uid=%$!uid% exe=%$!exe% %msg%\n")

if (
  $syslogfacility-text == "auth" or
  $syslogfacility-text == "authpriv"
) then {
  # The facility/tag/message are sender-controlled. Only the local socket's
  # kernel-attested credentials authorize this protected remediation input.
  # Setuid PAM tools and OpenSSH/polkit privilege-separated producers can have
  # non-root real UIDs, so retain their exact package-owned executable paths.
  if (not ($inputname == "imuxsock" and exists($!uid) and exists($!pid) and
      ($!uid == "0" or
       $!exe == "/usr/bin/sudo" or $!exe == "/usr/bin/su" or
       $!exe == "/usr/bin/login" or $!exe == "/usr/bin/passwd" or
       $!exe == "/usr/bin/chsh" or $!exe == "/usr/bin/chfn" or
       $!exe == "/usr/bin/pkexec" or $!exe == "/usr/sbin/sshd" or
       $!exe == "/usr/lib/openssh/sshd-session" or
       $!exe == "/usr/lib/openssh/sshd-auth" or
       $!exe == "/usr/lib/polkit-1/polkitd" or
       $!exe == "/usr/sbin/greetd"))) then {
    action(type="omfile" file="__INSTALLER_LOG_AUTH_UNVERIFIED_FILE__"
           fileOwner="__INSTALLER_LOG_OWNER__" fileGroup="__INSTALLER_LOG_GROUP__"
           fileCreateMode="__INSTALLER_LOG_FILE_MODE__"
           template="UnverifiedAuthDiagnostic" createDirs="off"
           rotation.sizeLimit="__INSTALLER_LOG_RSYSLOG_ROTATE_BYTES__"
           rotation.sizeLimitCommand="/usr/local/libexec/rsyslog-size-rotate"
           rotation.sizeLimitCommandPassFileName="on")
    stop
  }
  set $.security_routed = "on";
  action(
    name="auth_log"
    type="omfile"
    file="__INSTALLER_LOG_AUTH_FILE__"
    fileOwner="__INSTALLER_LOG_OWNER__"
    fileGroup="__INSTALLER_LOG_GROUP__"
    fileCreateMode="__INSTALLER_LOG_FILE_MODE__"
    template="RSYSLOG_TraditionalFileFormat"
    rotation.sizeLimit="__INSTALLER_LOG_RSYSLOG_ROTATE_BYTES__"
    rotation.sizeLimitCommand="/usr/local/libexec/rsyslog-size-rotate"
    rotation.sizeLimitCommandPassFileName="on"
  )
  if (
    $msg contains "authentication failure" or
    $msg contains "Authentication failure" or
    $msg contains "Failed password" or
    $msg contains "Failed publickey" or
    $msg contains "Invalid user" or
    $msg contains "FAILED LOGIN" or
    $msg contains "FAILED SU" or
    $msg contains "incorrect password" or
    $msg contains "user NOT in sudoers" or
    $msg contains "maximum authentication attempts exceeded" or
    $msg contains "account is locked"
  ) then {
    action(
      name="auth_desktop_signal"
      type="omfile"
      file="/var/lib/labwc-notifications/security/auth.signal"
      fileOwner="__INSTALLER_LOG_OWNER__"
      fileGroup="logreader"
      fileCreateMode="__INSTALLER_LOG_FILE_MODE__"
      dirOwner="__INSTALLER_LOG_OWNER__"
      dirGroup="logreader"
      dirCreateMode="__INSTALLER_LOG_DIRECTORY_MODE__"
      createDirs="on"
      template="AuthDesktopSignal"
      rotation.sizeLimit="__INSTALLER_LOG_RSYSLOG_ROTATE_BYTES__"
      rotation.sizeLimitCommand="/usr/local/libexec/rsyslog-size-rotate"
      rotation.sizeLimitCommandPassFileName="on"
    )
  }
}
