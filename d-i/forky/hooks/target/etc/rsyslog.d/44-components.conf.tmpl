# Managed native journal/syslog output, one protected destination per component.
# There are no file-tail inputs or category-wide runtime output files.
# Routing hints can only select validated constants, never construct filenames.
# Trusted journal origin fields remain in each escaped JSON record.
# Native daemon logs have one owner and are not written by this action.
template(name="ManagedComponentJSON" type="list" option.caseSensitive="on") {
  constant(value="{")
  property(name="timereported" outname="timestamp" format="jsonf" dateFormat="rfc3339")
  constant(value=",")
  property(name="hostname" outname="host" format="jsonf")
  constant(value=",")
  property(name="programname" outname="program" format="jsonf")
  constant(value=",")
  property(name="procid" outname="pid" format="jsonf")
  constant(value=",")
  property(name="syslogseverity-text" outname="severity" format="jsonf")
  constant(value=",")
  property(name="inputname" outname="input" format="jsonf")
  constant(value=",")
  property(name="$!_UID" outname="uid" format="jsonf")
  constant(value=",")
  property(name="$!_SYSTEMD_UNIT" outname="system_unit" format="jsonf")
  constant(value=",")
  property(name="$!_SYSTEMD_USER_UNIT" outname="user_unit" format="jsonf")
  constant(value=",")
  property(name="$!_TRANSPORT" outname="transport" format="jsonf")
  constant(value=",")
  property(name="msg" outname="message" format="jsonf")
  constant(value="}\n")
}


template(name="ManagedComponentPath" type="list") {
  property(name="$.managed_logfile")
}

if ($.managed_security_routed != "on") then {
  set $.managed_identity = tolower($programname & " " & $!_SYSTEMD_UNIT & " " & $!_SYSTEMD_USER_UNIT);
  if ($inputname == "imjournal" and ($!_EXE == "/usr/lib/systemd/systemd" or $!_EXE == "/lib/systemd/systemd")) then {
    set $.managed_identity = $.managed_identity & " " & tolower($!UNIT & " " & $!USER_UNIT);
  }
  if ($programname == "labwc-app") then {
    set $.managed_identity = $.managed_identity & " " & re_extract(tolower($msg), "(^| )application=([a-z0-9-]+)( |$)", 0, 2, "");
