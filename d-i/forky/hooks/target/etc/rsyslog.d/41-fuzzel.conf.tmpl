# Route managed Computer Management Fuzzel menu selections and action outcomes
# from the user session to protected, searchable logs. The writer normalizes
# and bounds every field before syslog receives it.

if ($programname == "labwc-fuzzel-menu" and not ($msg contains "source=android-debug-bridge")) then {
  set $.managed_security_routed = "on";
  action(
    name="managed_fuzzel_menu_log"
    type="omfile"
    file="__INSTALLER_LOG_FUZZEL_MENU_FILE__"
    fileOwner="__INSTALLER_LOG_OWNER__"
    fileGroup="__INSTALLER_LOG_GROUP__"
    fileCreateMode="__INSTALLER_LOG_FILE_MODE__"
    dirOwner="__INSTALLER_LOG_OWNER__"
    dirGroup="__INSTALLER_LOG_GROUP__"
    dirCreateMode="__INSTALLER_LOG_DIRECTORY_MODE__"
    createDirs="on"
    template="RSYSLOG_TraditionalFileFormat"
  )
}

if ($programname == "labwc-fuzzel-action" and not ($msg contains "source=android-debug-bridge")) then {
  set $.managed_security_routed = "on";
  action(
    name="managed_fuzzel_action_log"
    type="omfile"
    file="__INSTALLER_LOG_FUZZEL_ACTIONS_FILE__"
    fileOwner="__INSTALLER_LOG_OWNER__"
    fileGroup="__INSTALLER_LOG_GROUP__"
    fileCreateMode="__INSTALLER_LOG_FILE_MODE__"
    dirOwner="__INSTALLER_LOG_OWNER__"
    dirGroup="__INSTALLER_LOG_GROUP__"
    dirCreateMode="__INSTALLER_LOG_DIRECTORY_MODE__"
    createDirs="on"
    template="RSYSLOG_TraditionalFileFormat"
  )
}
