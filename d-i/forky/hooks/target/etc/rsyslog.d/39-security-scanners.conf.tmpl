# Scanner output enters rsyslog through a dedicated Unix socket rather than
# /dev/log. The socket is bound to a private ruleset so unrecognized input
# cannot fall through to general system logs. Its protected parent directory
# is created before rsyslog starts.

ruleset(name="security_scanner_input" queue.type="LinkedList"
        queue.size="__INSTALLER_LOG_RSYSLOG_QUEUE_MESSAGES__" queue.workerThreads="1") {
if ($programname == "lynis-scan") then {
  set $.security_routed = "on";
  action(
    name="lynis_scan_log"
    type="omfile"
    file="__INSTALLER_LOG_LYNIS_SCAN_FILE__"
    fileOwner="__INSTALLER_LOG_OWNER__"
    fileGroup="__INSTALLER_LOG_GROUP__"
    fileCreateMode="__INSTALLER_LOG_FILE_MODE__"
    dirOwner="__INSTALLER_LOG_OWNER__"
    dirGroup="__INSTALLER_LOG_GROUP__"
    dirCreateMode="__INSTALLER_LOG_DIRECTORY_MODE__"
    createDirs="on"
    template="RSYSLOG_TraditionalFileFormat"
    rotation.sizeLimit="__INSTALLER_LOG_RSYSLOG_ROTATE_BYTES__"
    rotation.sizeLimitCommand="/usr/local/libexec/rsyslog-size-rotate"
    rotation.sizeLimitCommandPassFileName="on"
  )
}

if ($programname == "rkhunter-scan") then {
