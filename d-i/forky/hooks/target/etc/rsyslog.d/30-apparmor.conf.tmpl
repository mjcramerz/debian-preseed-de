# Consume only AppArmor records from auditd's authoritative file. The audit
# syslog plugin is disabled so the full audit stream never enters journald.
# Follow writes and auditd's rename/create rotation through kernel notifications.
# One fixed input needs no periodic content scan or journal database reader.
module(load="imfile" mode="inotify")
template(
  name="AppArmorAuditLine"
  type="string"
  string="%msg%\n"
)

template(
  name="AppArmorDesktopSignal"
  type="string"
  string="apparmor\n"
)

ruleset(name="apparmor_log_writer") {
  action(
    name="apparmor_log"
    type="omfile"
    file="__INSTALLER_LOG_APPARMOR_FILE__"
    fileOwner="__INSTALLER_LOG_OWNER__"
    fileGroup="__INSTALLER_LOG_GROUP__"
    fileCreateMode="__INSTALLER_LOG_FILE_MODE__"
    dirOwner="__INSTALLER_LOG_OWNER__"
    dirGroup="__INSTALLER_LOG_GROUP__"
    dirCreateMode="__INSTALLER_LOG_DIRECTORY_MODE__"
    createDirs="on"
    template="AppArmorAuditLine"
    rotation.sizeLimit="__INSTALLER_LOG_RSYSLOG_ROTATE_BYTES__"
    rotation.sizeLimitCommand="/usr/local/libexec/rsyslog-size-rotate"
    rotation.sizeLimitCommandPassFileName="on"
  )
  if (re_match($msg, '^(node=[^ ]+ )?type=(AVC|1400) msg=audit\\([0-9]+\\.[0-9]+:[0-9]+\\): apparmor="DENIED"( |$)') or
      re_match($msg, '^(node=[^ ]+ )?type=APPARMOR_DENIED ')) then {
    action(name="apparmor_desktop_signal" type="omfile"
           file="/var/lib/labwc-notifications/security/apparmor.signal"
           fileOwner="__INSTALLER_LOG_OWNER__" fileGroup="logreader"
           fileCreateMode="__INSTALLER_LOG_FILE_MODE__"
           dirOwner="__INSTALLER_LOG_OWNER__" dirGroup="logreader"
           dirCreateMode="__INSTALLER_LOG_DIRECTORY_MODE__" createDirs="on"
           template="AppArmorDesktopSignal"
           rotation.sizeLimit="__INSTALLER_LOG_RSYSLOG_ROTATE_BYTES__"
           rotation.sizeLimitCommand="/usr/local/libexec/rsyslog-size-rotate"
           rotation.sizeLimitCommandPassFileName="on")
  }
}

ruleset(name="apparmor_from_audit" queue.type="LinkedList"
        queue.size="__INSTALLER_LOG_RSYSLOG_QUEUE_MESSAGES__" queue.workerThreads="1") {
  # Audit EXECVE/USER records can quote arbitrary application arguments. They
  # are not AppArmor events even when that text contains a denial marker.
  if (re_match($msg, '^(node=[^ ]+ )?type=(AVC|1400|APPARMOR[A-Z_]*) msg=audit\\([0-9]+\\.[0-9]+:[0-9]+\\): ') and
      ($msg contains "apparmor=" or $msg contains "type=1400" or $msg contains "type=APPARMOR")) then {
    call apparmor_log_writer
  }
}

input(type="imfile" File="__INSTALLER_LOG_AUDIT_FILE__" Tag="audit-file:"
      Ruleset="apparmor_from_audit" PersistStateInterval="64"
      persistStateAfterSubmission="on"
      MaxSubmitAtOnce="64")
# Checkpoint every 64 records and after submission, including a partial read
# at EOF. Avoid a separate state-file write for every audit record. This cursor is
# restart bookkeeping; auditd's native file remains the authoritative record.
# imfile's default 1024-record submission exceeds this route's 1000-record
# queue and can stall the producer before waking its worker (rsyslog 8.2608).
# Keep the batch below even the logging schema's minimum queue capacity.
# Kernel copies remain in the managed kernel log. Auditd's file is the sole
# input to this AppArmor mirror, so one action/worker owns size rotation.
