#!/bin/sh
set -eu

PATH=/usr/local/libexec:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

interface=${IFACE:-}
[ -n "$interface" ] || exit 0

# Run after ifdown has released the Ethernet link. Restoring Wi-Fi is
# best-effort and must never turn a failed link-down hook into a fatal ifdown.
/usr/local/libexec/network-wifi-configure --dispatcher "$interface" down || exit 0
