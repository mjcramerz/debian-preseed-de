# Managed by unattended-installer.
#
# Keep the PAM service file under /etc/pam.d so Debian's PAM stack treats it as
# a supported local policy surface instead of warning about /usr/lib/pam.d.
#%PAM-1.0

@include common-auth
@include common-account
@include common-password
session       required   pam_env.so readenv=1 user_readenv=0
@include common-session-noninteractive
