#%PAM-1.0
#
# Managed by unattended-installer. The greeter needs a logind seat session but
# must not start a user service manager, bus, or desktop portal. greetd supplies
# XDG_SESSION_CLASS=greeter; the PAM override below precedes pam_systemd, whose
# class= option alone would lose to greetd's environment.
# The greeter is a package-managed system account, not an interactive login;
# normal authentication and account-expiry policy belongs to /etc/pam.d/greetd
# when the real user logs in.

auth       required   pam_permit.so
account    required   pam_permit.so

session    required   pam_loginuid.so
session    required   pam_env.so readenv=1
session    required   pam_env.so readenv=1 envfile=/etc/default/locale
session    required   pam_env.so conffile=/etc/security/greetd-greeter.conf readenv=0 user_readenv=0
session    required   pam_systemd.so class=user-light type=wayland desktop=labwc

@include common-session-noninteractive
