#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL

profile_config=/etc/default/grub-profiles

fatal() {
  printf "fatal: %s\n" "$*" >&2
  exit 1
}

grub_single_quote() {
  printf '%s\n' "$1" | sed "s/'/'\\\\''/g"
}

shell_single_quote() {
  printf "'%s'\n" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

emit_profile_config() {
    printf 'dev_part_boot=%s\n' "$(shell_single_quote "$dev_part_boot")"
    printf 'dev_part_root=%s\n' "$(shell_single_quote "$dev_part_root")"
    printf 'dev_part_efi=%s\n' "$(shell_single_quote "$dev_part_efi")"
    printf 'bootprofile_default=%s\n' "$(shell_single_quote "$bootprofile_default")"
    printf 'bootprofile_performance=%s\n' "$(shell_single_quote "$bootprofile_performance")"
    printf 'bootprofile_hardened=%s\n' "$(shell_single_quote "$bootprofile_hardened")"
    printf 'grub_root_flags=%s\n' "$(shell_single_quote "$grub_root_flags")"
    printf 'grub_initramfs_flags=%s\n' "$(shell_single_quote "$grub_initramfs_flags")"
    printf 'grub_nvme_flags=%s\n' "$(shell_single_quote "$grub_nvme_flags")"
    printf 'grub_cgroup_flags=%s\n' "$(shell_single_quote "$grub_cgroup_flags")"
    printf 'grub_security_core_flags=%s\n' "$(shell_single_quote "$grub_security_core_flags")"
    printf 'grub_blacklist_flags=%s\n' "$(shell_single_quote "$grub_blacklist_flags")"
    printf 'grub_vfio_flags=%s\n' "$(shell_single_quote "$grub_vfio_flags")"
    printf 'grub_memory_core_flags=%s\n' "$(shell_single_quote "$grub_memory_core_flags")"
    printf 'grub_hardening_flags=%s\n' "$(shell_single_quote "$grub_hardening_flags")"
    printf 'grub_aspm_flags=%s\n' "$(shell_single_quote "$grub_aspm_flags")"
    printf 'grub_systemd_mask_flags=%s\n' "$(shell_single_quote "$grub_systemd_mask_flags")"
    printf 'grub_profile_default_flags=%s\n' "$(shell_single_quote "$grub_profile_default_flags")"
    printf 'grub_profile_performance_flags=%s\n' "$(shell_single_quote "$grub_profile_performance_flags")"
    printf 'grub_profile_hardened_flags=%s\n' "$(shell_single_quote "$grub_profile_hardened_flags")"
    printf 'mok_der_path=%s\n' "$(shell_single_quote "$mok_der_path")"
    printf 'grub_default_entry=%s\n' "$(shell_single_quote "$grub_default_entry")"
    printf 'rescue_usb_uuid=%s\n' "$(shell_single_quote "$rescue_usb_uuid")"
    printf 'grub_gfxpayload_linux=%s\n' "$(shell_single_quote "$grub_gfxpayload_linux")"
    printf 'dualboot_enabled=%s\n' "$(shell_single_quote "$dualboot_enabled")"
}

require_trusted_file() {
  trusted_path=$1
  [ -f "$trusted_path" ] && [ ! -L "$trusted_path" ] ||
    fatal "GRUB input is not a direct regular file: $trusted_path"
  [ "$(find -P "$trusted_path" -maxdepth 0 -printf %U)" = 0 ] ||
    fatal "GRUB input must be root-owned: $trusted_path"
  trusted_mode=$(find -P "$trusted_path" -maxdepth 0 -printf %m)
  case "$trusted_mode" in
    [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) ;;
    *) fatal "invalid GRUB input mode: $trusted_path" ;;
  esac
  [ $((0$trusted_mode & 0022)) -eq 0 ] ||
    fatal "GRUB input is writable by non-root users: $trusted_path"
}

# Native GRUB syntax is checked in as data, never embedded in this script.
# Single-pass literal substitution: values are not shell/awk source and are not
# rescanned for further markers. Files remain root-owned runtime assets.
grub_render_fragment() (
  set -eu
  fragment_name=$1; shift
  case "$fragment_name" in ''|*[!a-z0-9.-]*|*..*) fatal "invalid GRUB fragment name" ;; esac
  fragment_path="/usr/local/share/grub-profiles/$fragment_name"
  require_trusted_file "$fragment_path"
  [ "$(find -P "$fragment_path" -maxdepth 0 -printf %n)" = 1 ] || fatal "hard-linked GRUB fragment"
  /usr/bin/awk '
    BEGIN {
      if ((ARGC - 2) % 2) exit 1;
      for (i = 2; i < ARGC; i += 2) {
        if (ARGV[i] !~ /^[A-Z][A-Z0-9_]*$/ || ARGV[i] in value) exit 1;
        value[ARGV[i]] = ARGV[i+1]; delete ARGV[i]; delete ARGV[i+1];
      }
    }
    {
      line = $0; output = "";
      while (match(line, /@@[A-Z][A-Z0-9_]*@@/)) {
        key = substr(line, RSTART+2, RLENGTH-4);
        if (!(key in value)) exit 1;
        output = output substr(line, 1, RSTART-1) value[key];
        line = substr(line, RSTART+RLENGTH);
      }
      print output line;
    }
  ' "$fragment_path" "$@" || fatal "cannot render GRUB fragment: $fragment_name"
)

validate_profile_values() {
  for profile_value in "$bootprofile_default" "$bootprofile_performance" "$bootprofile_hardened" "$grub_default_entry"; do
    case "$profile_value" in
      ''|*[!A-Za-z0-9_.:-]*) fatal "invalid GRUB profile identifier" ;;
    esac
  done
  for flags_value in "$grub_root_flags" "$grub_initramfs_flags" "$grub_nvme_flags" \
    "$grub_cgroup_flags" "$grub_security_core_flags" "$grub_blacklist_flags" \
    "$grub_vfio_flags" "$grub_memory_core_flags" "$grub_hardening_flags" \
    "$grub_aspm_flags" "$grub_systemd_mask_flags" "$grub_profile_default_flags" \
    "$grub_profile_performance_flags" "$grub_profile_hardened_flags" "${grub_hardware_flags:-}"; do
    # These values become unquoted GRUB arguments, not shell programs. Reject
    # controls, quotes, expansions and GRUB metacharacters before emitting them.
    case "$flags_value" in
      *[!A-Za-z0-9_.,:/=@%+~!?\[\]\ -]*) fatal "unsafe GRUB command-line flags" ;;
    esac
  done
  for device_value in "$dev_part_boot" "$dev_part_root" "$dev_part_efi"; do
    case "$device_value" in
      /dev/*) ;;
      *) fatal "GRUB device must be below /dev" ;;
    esac
    case "$device_value" in
      *[!A-Za-z0-9_./:+-]*|*'/../'*|*'/..'|*'/./'*|*'/.'|*'//'*) fatal "unsafe GRUB device path" ;;
    esac
  done
  case "$grub_gfxpayload_linux" in
    ''|*[!A-Za-z0-9_,.x-]*) fatal "invalid GRUB graphics payload" ;;
  esac
}

load_profile_config() {
  [ -r "$profile_config" ] || fatal "GRUB profile config is missing: $profile_config"
  require_trusted_file "$profile_config"
  # shellcheck disable=SC1090
  . "$profile_config"
}

ensure_grubenv() {
  [ -s /boot/grub/grubenv ] && return 0
  command -v grub-editenv >/dev/null 2>&1 || \
    fatal "grub-editenv is unavailable; cannot create /boot/grub/grubenv for saved profile kernels"
  grub-editenv /boot/grub/grubenv create || \
    fatal "failed to create /boot/grub/grubenv for saved profile kernels"
  [ -s /boot/grub/grubenv ] || \
    fatal "created /boot/grub/grubenv is missing or empty"
}

disable_duplicate_custom_source() {
  if [ -e /etc/grub.d/41_custom ]; then
    chmod 0644 /etc/grub.d/41_custom
  fi
}

emit_target=
emit_tmp=
export_snapshot_config=false
case "$#" in
  0)
    load_profile_config
    ;;
  1)
    case "$1" in
      --snapshot-config)
        load_profile_config
        export_snapshot_config=true
        ;;
      --install)
        # Initial installation only. Later grub-mkconfig runs have no arguments.
        load_profile_config
        install -d -m 0755 /boot/grub
        ensure_grubenv
        disable_duplicate_custom_source
        emit_target=/boot/grub/custom.cfg
        ;;
      *) fatal "unsupported GRUB generator option" ;;
    esac
    ;;
  *) fatal "invalid GRUB generator argument count: $#" ;;
esac

# grub-mkconfig does not export custom GRUB_PROFILE_* variables to generators.
# Read the managed hardware fragments ourselves on BOTH initial installation
# and every regeneration. Saved profile_config retains only the base policy,
# so changes/removals take effect and repeated runs cannot accumulate flags.
load_hardware_profile_flags() {
  GRUB_CMDLINE_LINUX=
  GRUB_PROFILE_DEFAULT_FLAGS=
  GRUB_PROFILE_PERFORMANCE_FLAGS=
  GRUB_PROFILE_HARDENED_FLAGS=
  for hardware_fragment in \
    72-nvme-platform.cfg 73-pcie-power.cfg 74-intel-mei-blacklist.cfg \
    75-intel-vfio.cfg 80-cpu-profile-flags.cfg 85-gpu-intel.cfg \
    86-gpu-amd.cfg 87-gpu-nvidia.cfg
  do
    hardware_path="/etc/default/grub.d/$hardware_fragment"
    [ -e "$hardware_path" ] || [ -L "$hardware_path" ] || continue
    [ -f "$hardware_path" ] && [ ! -L "$hardware_path" ] ||
      fatal "hardware GRUB fragment is not a direct regular file: $hardware_path"
    [ "$(find -P "$hardware_path" -maxdepth 0 -printf %U)" = 0 ] ||
      fatal "hardware GRUB fragment must be root-owned: $hardware_path"
    hardware_mode=$(find -P "$hardware_path" -maxdepth 0 -printf %m)
    case "$hardware_mode" in
      [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) ;;
      *) fatal "invalid hardware GRUB fragment mode: $hardware_path" ;;
    esac
    [ $((0$hardware_mode & 0022)) -eq 0 ] ||
      fatal "hardware GRUB fragment is writable by non-root users: $hardware_path"
    # shellcheck disable=SC1090
    . "$hardware_path"
  done
  grub_hardware_flags=$GRUB_CMDLINE_LINUX
  grub_profile_default_flags="${grub_profile_default_flags}${GRUB_PROFILE_DEFAULT_FLAGS:+ $GRUB_PROFILE_DEFAULT_FLAGS}"
  grub_profile_performance_flags="${grub_profile_performance_flags}${GRUB_PROFILE_PERFORMANCE_FLAGS:+ $GRUB_PROFILE_PERFORMANCE_FLAGS}"
  grub_profile_hardened_flags="${grub_profile_hardened_flags}${GRUB_PROFILE_HARDENED_FLAGS:+ $GRUB_PROFILE_HARDENED_FLAGS}"
}
load_hardware_profile_flags
validate_profile_values

if [ "$export_snapshot_config" = true ]; then
  emit_profile_config
  printf 'grub_hardware_flags=%s\n' "$(shell_single_quote "$grub_hardware_flags")"
  exit 0
fi

if [ -n "$emit_target" ]; then
  emit_tmp=$(mktemp /boot/grub/.custom.cfg.XXXXXX)
  trap 'rm -f -- "$emit_tmp"' EXIT
  trap 'exit 1' HUP INT TERM
  exec >"$emit_tmp"
fi

detect_grub_distro_title() {
  distro_title="Debian GNU/Linux"
  os_release=
  if [ -r /etc/os-release ]; then
    os_release=/etc/os-release
  elif [ -r /usr/lib/os-release ]; then
    os_release=/usr/lib/os-release
  fi
  if [ -n "$os_release" ]; then
    distro_name=$(sed -n 's/^NAME=//p' "$os_release" | head -n1 | tr -d '"' || true)
    distro_version=$(sed -n 's/^VERSION_ID=//p' "$os_release" | head -n1 | tr -d '"' || true)
    if [ -n "$distro_name" ] && [ -n "$distro_version" ]; then
      distro_title="${distro_name} ${distro_version}"
    elif [ -n "$distro_name" ]; then
      distro_title="$distro_name"
    fi
  fi
  printf '%s\n' "$distro_title"
}

kernel_label_for_version() {
  case "$1" in
    *) printf 'Linux %s\n' "$1" ;;
  esac
}

grub_id_fragment() {
  printf '%s\n' "$1" | sed 's/[^A-Za-z0-9_]/_/g'
}

list_bootable_kernel_images() {
  for img in /boot/vmlinuz-*; do
    [ -e "$img" ] || continue
    ver=${img#/boot/vmlinuz-}
    [ -e "/boot/initrd.img-${ver}" ] || continue
    printf '%s\n' "$img"
  done | sort -Vr
}

resolve_default_kernel_image() {
  for candidate in /vmlinuz /boot/vmlinuz; do
    [ -e "$candidate" ] || continue
    resolved=$(readlink -f "$candidate" 2>/dev/null || true)
    case "$resolved" in
      /boot/vmlinuz-*)
        ver=${resolved#/boot/vmlinuz-}
        [ -e "/boot/initrd.img-${ver}" ] || continue
        printf '%s\n' "$resolved"
        return 0
        ;;
    esac
  done

  printf '%s\n' "$bootable_kernel_images" | sed -n '1p'
}

bootable_kernel_images=$(list_bootable_kernel_images)
[ -n "$bootable_kernel_images" ] || fatal "unable to locate installed bootable kernel/initrd pairs under target /boot"
default_img=$(resolve_default_kernel_image)
if [ -z "$default_img" ]; then
  fatal "unable to locate an installed default kernel/initrd under target /boot"
fi

default_ver=${default_img#/boot/vmlinuz-}
distro_title_raw=$(detect_grub_distro_title)
distro_title=$(grub_single_quote "$distro_title_raw")

boot_uuid=$(blkid -s UUID -o value "$dev_part_boot" 2>/dev/null || true)
root_uuid=$(blkid -s UUID -o value "$dev_part_root" 2>/dev/null || true)
efi_uuid=$(blkid -s UUID -o value "$dev_part_efi" 2>/dev/null || true)
for uuid_value in "$boot_uuid" "$root_uuid" "$efi_uuid"; do
  case "$uuid_value" in
    *[!A-Za-z0-9-]*) fatal "invalid filesystem UUID returned by blkid" ;;
  esac
done
mokmanager_path=__INSTALLER_GRUB_MOK_MANAGER_EFI_PATH__
rescue_usb_efi_path=__INSTALLER_GRUB_REMOVABLE_BOOT_EFI_PATH__
skip_mok_signing=false
case "${SKIP_MOK_SIGNING:-0}" in
  1|true|yes|on)
    skip_mok_signing=true
    ;;
  ''|0|false|no|off)
    ;;
  *)
    fatal "SKIP_MOK_SIGNING must be boolean when set"
    ;;
esac
if [ -n "$boot_uuid" ]; then
  boot_search="search --no-floppy --fs-uuid --set=root ${boot_uuid}"
else
  boot_search="search --no-floppy --file --set=root /vmlinuz-${default_ver}"
fi
if [ -n "$root_uuid" ]; then
  root_arg="root=UUID=${root_uuid}"
else
  root_arg="root=${dev_part_root}"
fi
if [ "$skip_mok_signing" = true ]; then
  mok_header_comment="MOK enrollment menu omitted because SKIP_MOK_SIGNING=1."
else
  if [ -n "$efi_uuid" ]; then
    mokmanager_search="search --no-floppy --fs-uuid --set=esp ${efi_uuid}"
  else
    mokmanager_search="search --no-floppy --file --set=esp ${mokmanager_path}"
  fi
  [ -f "/boot/efi${mokmanager_path}" ] || fatal "MokManager is missing at /boot/efi${mokmanager_path}"
  [ -r "$mok_der_path" ] || fatal "generated MOK DER certificate is missing at $mok_der_path"
  mok_header_comment="The generated MOK DER certificate is expected at ${mok_der_path}."
fi

base_cmdline="${grub_root_flags} ${grub_initramfs_flags} ${grub_nvme_flags} ${grub_systemd_mask_flags} ${grub_cgroup_flags} ${grub_security_core_flags} ${grub_blacklist_flags} ${grub_vfio_flags} ${grub_memory_core_flags} ${grub_hardening_flags} ${grub_aspm_flags} ${grub_hardware_flags}"
last_profile_var=installer_linux_last_profile
last_kernel_var=installer_linux_last_kernel

validate_grub_token() {
  token_name=$1
  token_value=$2
  case "$token_value" in
    ''|*[!A-Za-z0-9_.:-]*)
      fatal "${token_name} contains unsupported characters for generated GRUB state: ${token_value}"
      ;;
  esac
}

validate_kernel_version() {
  kernel_value=$1
  case "$kernel_value" in
    ''|*[!A-Za-z0-9_.:+~=-]*)
      fatal "kernel version contains unsupported characters for generated GRUB entries: ${kernel_value}"
      ;;
  esac
}

validate_grub_absolute_efi_path() {
  path_name=$1
  path_value=$2
  case "$path_value" in
    /*) ;;
    *) fatal "${path_name} must be an absolute EFI path: ${path_value}" ;;
  esac
  case "$path_value" in
    *'/../'*|*'/..'|*'/./'*|*'/.')
      fatal "${path_name} must not contain relative path segments: ${path_value}"
      ;;
    *[!A-Za-z0-9_./+-]*)
      fatal "${path_name} contains unsupported characters for generated GRUB paths: ${path_value}"
      ;;
  esac
}

validate_grub_token bootprofile_default "$bootprofile_default"
validate_grub_token bootprofile_performance "$bootprofile_performance"
validate_grub_token bootprofile_hardened "$bootprofile_hardened"
validate_grub_token grub_default_entry "$grub_default_entry"
validate_kernel_version "$default_ver"
validate_grub_absolute_efi_path rescue_usb_efi_path "$rescue_usb_efi_path"
if [ "$skip_mok_signing" != true ]; then
  validate_grub_absolute_efi_path mokmanager_path "$mokmanager_path"
fi
case "${rescue_usb_uuid:-}" in
  ''|*[!A-Za-z0-9-]*)
    [ -z "${rescue_usb_uuid:-}" ] || fatal "rescue_usb_uuid contains unsupported characters: ${rescue_usb_uuid}"
    ;;
esac
case "$grub_gfxpayload_linux" in
  ''|*[!A-Za-z0-9_,.x-]*)
    fatal "grub_gfxpayload_linux contains unsupported characters: ${grub_gfxpayload_linux}"
    ;;
esac
case "${dualboot_enabled:-false}" in
  true|false) ;;
  *) fatal "dualboot_enabled must be true or false, got ${dualboot_enabled}" ;;
esac
if [ -n "${rescue_usb_uuid:-}" ]; then
  rescue_usb_search="search --no-floppy --fs-uuid --set=root ${rescue_usb_uuid}"
else
  rescue_usb_search="search --no-floppy --file --set=root ${rescue_usb_efi_path}"
fi
grub_gfxpayload_linux_escaped=$(grub_single_quote "$grub_gfxpayload_linux")

emit_grub_linux_display_policy() {
  prefix=${1:-}
  [ -n "$grub_gfxpayload_linux" ] || return 0

  grub_render_fragment display-1.cfg.in \
    PREFIX "${prefix}" \
    GRUB_GFXPAYLOAD_LINUX_ESCAPED "${grub_gfxpayload_linux_escaped}"
}

emit_grub_display_policy() {
  prefix=${1:-}

  grub_render_fragment display-2.cfg.in \
    PREFIX "${prefix}"
}

emit_btrfs_snapshot_menu() {
  case "$grub_root_flags" in
    *"rootfstype=btrfs"*) ;;
    *) return 0 ;;
  esac
  [ -r /etc/default/grub-btrfs/config ] || return 0

  grub_render_fragment snapshots.cfg.in
}

emit_profile_submenu() {
  profile=$1
  profile_label=$2
  profile_saved_var=$3
  profile_flags=$4

  validate_grub_token profile_saved_var "$profile_saved_var"

  grub_render_fragment submenu.cfg.in \
    DISTRO_TITLE "${distro_title}" \
    PROFILE_LABEL "${profile_label}" \
    PROFILE "${profile}" \
    PROFILE_SAVED_VAR "${profile_saved_var}" \
    LAST_PROFILE_VAR "${last_profile_var}" \
    LAST_KERNEL_VAR "${last_kernel_var}"
  emit_grub_display_policy "    "

  while IFS= read -r kernel_image; do
    [ -n "$kernel_image" ] || continue
    kernel_ver=${kernel_image#/boot/vmlinuz-}
    kernel_id_fragment=$(grub_id_fragment "$kernel_ver")
    kernel_entry_id="installer-linux-${profile}-${kernel_id_fragment}"
    kernel_title=$(grub_single_quote "${distro_title_raw} (${profile_label}) [${kernel_ver}]")
    validate_kernel_version "$kernel_ver"
    validate_grub_token kernel_entry_id "$kernel_entry_id"
    grub_render_fragment entry.cfg.in \
      DISPLAY_POLICY "$(emit_grub_linux_display_policy "        ")" \
      KERNEL_TITLE "${kernel_title}" \
      KERNEL_ENTRY_ID "${kernel_entry_id}" \
      PROFILE_SAVED_VAR "${profile_saved_var}" \
      LAST_PROFILE_VAR "${last_profile_var}" \
      PROFILE "${profile}" \
      LAST_KERNEL_VAR "${last_kernel_var}" \
      KERNEL_VER "${kernel_ver}" \
      BOOT_SEARCH "${boot_search}" \
      ROOT_ARG "${root_arg}" \
      BASE_CMDLINE "${base_cmdline}" \
      PROFILE_FLAGS "${profile_flags}"
  done <<EOF_KERNEL_IMAGES
$bootable_kernel_images
EOF_KERNEL_IMAGES

  printf '}\n'
}

emit_mok_enrollment_menu() {
  [ "$skip_mok_signing" = true ] && return 0

  grub_render_fragment mokmenu.cfg.in \
    MOKMANAGER_SEARCH "${mokmanager_search}" \
    MOK_DER_PATH "${mok_der_path}" \
    MOKMANAGER_PATH "${mokmanager_path}"
}

emit_grub_display_policy

grub_render_fragment header.cfg.in \
  DISPLAY_POLICY "$(emit_grub_linux_display_policy "    ")" \
  MOK_HEADER_COMMENT "${mok_header_comment}" \
  BOOTPROFILE_DEFAULT "${bootprofile_default}" \
  GRUB_PROFILE_DEFAULT_FLAGS "${grub_profile_default_flags}" \
  DEFAULT_VER "${default_ver}" \
  LAST_PROFILE_VAR "${last_profile_var}" \
  LAST_KERNEL_VAR "${last_kernel_var}" \
  BOOTPROFILE_HARDENED "${bootprofile_hardened}" \
  GRUB_PROFILE_HARDENED_FLAGS "${grub_profile_hardened_flags}" \
  BOOTPROFILE_PERFORMANCE "${bootprofile_performance}" \
  GRUB_PROFILE_PERFORMANCE_FLAGS "${grub_profile_performance_flags}" \
  GRUB_DEFAULT_ENTRY "${grub_default_entry}" \
  BOOT_SEARCH "${boot_search}" \
  ROOT_ARG "${root_arg}" \
  BASE_CMDLINE "${base_cmdline}"
emit_profile_submenu "$bootprofile_default" "Balanced" "installer_linux_balanced_kernel" "$grub_profile_default_flags"
emit_profile_submenu "$bootprofile_performance" "Performance" "installer_linux_performance_kernel" "$grub_profile_performance_flags"
emit_profile_submenu "$bootprofile_hardened" "Hardened" "installer_linux_hardened_kernel" "$grub_profile_hardened_flags"
emit_btrfs_snapshot_menu

grub_render_fragment rescue.cfg.in \
  RESCUE_USB_SEARCH "${rescue_usb_search}" \
  RESCUE_USB_EFI_PATH "${rescue_usb_efi_path}"

emit_mok_enrollment_menu

grub_render_fragment firmware.cfg.in

if [ -n "$emit_target" ]; then
  command -v grub-script-check >/dev/null 2>&1 || fatal "grub-script-check is unavailable"
  grub-script-check "$emit_tmp" || fatal "generated custom GRUB menu failed syntax validation"
  chmod 0644 "$emit_tmp"
  mv -fT -- "$emit_tmp" "$emit_target"
  trap - EXIT HUP INT TERM
fi
