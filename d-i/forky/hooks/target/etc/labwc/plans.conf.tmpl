# Generated by the unattended Debian installer desktop role.
# Telegram credentials are supplied by the installer kernel command line and
# this file is installed as root:<primary-user-group> mode 0640.
# Keep managed single-line quoted values. The daemon checks channel policy
# immediately before dispatch; edits to a destination or credential stop that
# channel until restart. Missed reminder slots are never replayed as a backlog.
LABWC_PLANS_ENABLED='true'
# Delivery is authorized only by a local calendar UID opt-in from the clock
# event/task form. Sleek files and the former plan queue are never read.
LABWC_PLANS_TELEGRAM_ENABLED='true'
LABWC_PLANS_TELEGRAM_API_BASE='https://api.telegram.org'
LABWC_PLANS_TELEGRAM_API_KEY='__INSTALLER_TELEGRAM_API_KEY__'
LABWC_PLANS_TELEGRAM_CHAT_ID='__INSTALLER_TELEGRAM_CHAT_ID__'
LABWC_PLANS_NTFY_ENABLED='false'
LABWC_PLANS_NTFY_BASE_URL='https://ntfy.sh'
LABWC_PLANS_NTFY_TOPIC=''
LABWC_PLANS_NTFY_ACCESS_TOKEN=''
# Enable only after verifying that unauthorized readers cannot subscribe.
LABWC_PLANS_NTFY_READER_ACCESS_CONFIRMED='false'
