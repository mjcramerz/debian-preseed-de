# Managed by unattended-installer.
[DEFAULT]
bantime = 24h
# Repeat bans double, up to one week, using the persistent ban database.
bantime.increment = true
bantime.maxtime = 1w
findtime = 10m
maxretry = 10
usedns = no
ignoreself = true
ignoreip = 127.0.0.1/8 ::1
banaction = nftables
banaction_allports = nftables[type=allports]
chain = fail2ban_input

[sshd]
enabled = true
# INFO authentication events are retained in the journal and forwarded to rsyslog.
# Watch the existing rsyslog auth sink using inotify, including file rotation.
backend = pyinotify
logpath = __INSTALLER_LOG_AUTH_FILE__
mode = normal
port = __INSTALLER_SSH_PORT__
protocol = tcp
