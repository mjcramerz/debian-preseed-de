apiVersion: cybops.nftables/v1
kind: NftablesServiceOverlay
metadata:
  name: lan-share
  description: On-demand HTTP file sharing on managed LAN subnets only.
  merge_priority: 50
services:
  lan_share_http:
    enabled: true
    direction: inbound
    protocols:
    - tcp
    ports:
    - 8000
    allow:
      ipv4: __INSTALLER_NFTABLES_LAN_SHARE_ALLOW_IPV4__
      ipv6: __INSTALLER_NFTABLES_LAN_SHARE_ALLOW_IPV6__
      interfaces: __INSTALLER_NFTABLES_LAN_SHARE_ALLOW_INTERFACES__
    sensitive: true
    log: false
