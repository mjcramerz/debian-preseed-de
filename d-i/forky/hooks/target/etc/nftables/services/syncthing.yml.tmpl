apiVersion: cybops.nftables/v1
kind: NftablesServiceOverlay
metadata:
  name: syncthing
  description: Syncthing sync overlay restricted to the managed Tailscale interface.
  merge_priority: 50
services:
  syncthing_sync_tcp:
    enabled: true
    direction: bidirectional
    protocols:
    - tcp
    ports:
    - __INSTALLER_SYNCTHING_TCP_PORT__
    allow:
      ipv4: __INSTALLER_NFTABLES_SYNCTHING_ALLOW_IPV4__
      ipv6: __INSTALLER_NFTABLES_SYNCTHING_ALLOW_IPV6__
      interfaces: __INSTALLER_NFTABLES_SYNCTHING_ALLOW_INTERFACES__
    log: false
