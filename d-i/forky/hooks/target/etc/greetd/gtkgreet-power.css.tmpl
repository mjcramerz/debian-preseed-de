window#greeter-power {
  background-color: __THEME_GTKGREET_POWER_WINDOW_NORMAL_BACKGROUND_COLOR__;
}
box#greeter-power-box {
  background-color: __THEME_GTKGREET_POWER_PANEL_NORMAL_BACKGROUND_COLOR__;
  border: 1px solid __THEME_GTKGREET_POWER_PANEL_NORMAL_OUTLINE_COLOR__;
  border-radius: 14px;
  box-shadow: 0 14px 36px __THEME_GTKGREET_POWER_PANEL_NORMAL_SHADOW_COLOR__;
  padding: 10px;
}
button.greeter-power-button {
  background-image: none;
  border-radius: 9px;
  font-family: "__THEME_GTKGREET_TEXT_FONT_FAMILY__";
  font-size: 14px;
  font-weight: 700;
  margin: 0;
  min-height: 46px;
  min-width: 126px;
  padding: 7px 15px;
}
button.greeter-power-button.reboot {
  background-color: __THEME_GTKGREET_POWER_REBOOT_BUTTON_NORMAL_BACKGROUND_COLOR__;
  border: 1px solid __THEME_GTKGREET_POWER_REBOOT_BUTTON_NORMAL_OUTLINE_COLOR__;
  color: __THEME_GTKGREET_POWER_REBOOT_BUTTON_NORMAL_TEXT_COLOR__;
}
button.greeter-power-button.reboot:hover {
  background-color: __THEME_GTKGREET_POWER_REBOOT_BUTTON_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_GTKGREET_POWER_REBOOT_BUTTON_HOVER_OUTLINE_COLOR__;
  color: __THEME_GTKGREET_POWER_REBOOT_BUTTON_HOVER_TEXT_COLOR__;
}
button.greeter-power-button.reboot:focus {
  background-color: __THEME_GTKGREET_POWER_REBOOT_BUTTON_FOCUS_BACKGROUND_COLOR__;
  border-color: __THEME_GTKGREET_POWER_REBOOT_BUTTON_FOCUS_OUTLINE_COLOR__;
  color: __THEME_GTKGREET_POWER_REBOOT_BUTTON_FOCUS_TEXT_COLOR__;
}
button.greeter-power-button.reboot:active {
  background-color: __THEME_GTKGREET_POWER_REBOOT_BUTTON_ACTIVE_BACKGROUND_COLOR__;
  border-color: __THEME_GTKGREET_POWER_REBOOT_BUTTON_ACTIVE_OUTLINE_COLOR__;
  color: __THEME_GTKGREET_POWER_REBOOT_BUTTON_ACTIVE_TEXT_COLOR__;
}
button.greeter-power-button.shutdown {
  background-color: __THEME_GTKGREET_POWER_SHUTDOWN_BUTTON_NORMAL_BACKGROUND_COLOR__;
  border: 1px solid __THEME_GTKGREET_POWER_SHUTDOWN_BUTTON_NORMAL_OUTLINE_COLOR__;
  color: __THEME_GTKGREET_POWER_SHUTDOWN_BUTTON_NORMAL_TEXT_COLOR__;
}
button.greeter-power-button.shutdown:hover {
  background-color: __THEME_GTKGREET_POWER_SHUTDOWN_BUTTON_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_GTKGREET_POWER_SHUTDOWN_BUTTON_HOVER_OUTLINE_COLOR__;
  color: __THEME_GTKGREET_POWER_SHUTDOWN_BUTTON_HOVER_TEXT_COLOR__;
}
button.greeter-power-button.shutdown:focus {
  background-color: __THEME_GTKGREET_POWER_SHUTDOWN_BUTTON_FOCUS_BACKGROUND_COLOR__;
  border-color: __THEME_GTKGREET_POWER_SHUTDOWN_BUTTON_FOCUS_OUTLINE_COLOR__;
  color: __THEME_GTKGREET_POWER_SHUTDOWN_BUTTON_FOCUS_TEXT_COLOR__;
}
button.greeter-power-button.shutdown:active {
  background-color: __THEME_GTKGREET_POWER_SHUTDOWN_BUTTON_ACTIVE_BACKGROUND_COLOR__;
  border-color: __THEME_GTKGREET_POWER_SHUTDOWN_BUTTON_ACTIVE_OUTLINE_COLOR__;
  color: __THEME_GTKGREET_POWER_SHUTDOWN_BUTTON_ACTIVE_TEXT_COLOR__;
}
button.greeter-power-button.confirm {
  box-shadow: 0 0 0 3px __THEME_GTKGREET_POWER_CONFIRM_BUTTON_NORMAL_SHADOW_COLOR__;
}
button.greeter-power-button:disabled {
  opacity: 0.62;
}

