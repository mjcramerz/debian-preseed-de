// Managed by unattended-installer.
// Greeter power must enter the package-aware PID-1 worker, not raw login1.
(function() {
    var GREETER_USER = "__INSTALLER_LABWC_GREETER_USER__";
    var POWER_HELPER = "/usr/local/libexec/greetd-power-action-root";
    polkit.addRule(function(action, subject) {
        if (subject.user !== GREETER_USER) {
            return polkit.Result.NOT_HANDLED;
        }
        if (subject.active !== true || subject.local !== true) {
            return polkit.Result.NO;
        }
        if (action.id === "org.freedesktop.policykit.exec" &&
            action.lookup("program") === POWER_HELPER) {
            return polkit.Result.YES;
        }
        if (action.id === "org.freedesktop.login1.chvt") {
            return polkit.Result.YES;
        }
        // No direct power-off/reboot or ignore-inhibit bypass from the greeter.
        if (action.id.indexOf("org.freedesktop.login1.power-off") === 0 ||
            action.id.indexOf("org.freedesktop.login1.reboot") === 0) {
            return polkit.Result.NO;
        }
        return polkit.Result.NOT_HANDLED;
    });
})();
