# Managed by unattended-installer.
#
# NVIDIA's userspace libraries may try to create /dev/char/<major>:<minor>
# links from an unprivileged desktop process. Keep that operation denied by
# AppArmor and have udev, running as root, create the bounded device links.
# SYSTEMD_WANTS requests the bounded fallback when a device becomes active.
# A change on an already-active device still repairs its link directly; it does
# not need a service restart. Unrelated /dev events never trigger reconciliation.

ACTION=="add|change", KERNEL=="nvidia[0-9]*", SYMLINK+="char/%M:%m", TAG+="systemd", ENV{SYSTEMD_WANTS}+="managed-nvidia-char-links.service"
ACTION=="add|change", KERNEL=="nvidiactl|nvidia-modeset|nvidia-uvm|nvidia-uvm-tools", SYMLINK+="char/%M:%m", TAG+="systemd", ENV{SYSTEMD_WANTS}+="managed-nvidia-char-links.service"
