
/*
 * Evergreen Notes
 * Managed local theme for the Debian Labwc desktop.
 */
body {
  --font-interface-theme: "__THEME_OBSIDIAN_TEXT_FONT_FAMILY__", sans-serif;
  --font-text-theme: "__THEME_OBSIDIAN_TEXT_FONT_FAMILY__", sans-serif;
  --font-monospace-theme: "__THEME_OBSIDIAN_MONOSPACE_FONT_FAMILY__", monospace;
  --font-text-size: 16px;
  --line-height-normal: 1.6;
  --line-height-tight: 1.35;
  --file-line-width: 860px;
  --radius-s: 4px;
  --radius-m: 7px;
  --radius-l: 10px;
  --input-radius: 5px;
  --button-radius: 5px;
  --tab-radius-active: 5px 5px 0 0;
  --checkbox-radius: 4px;
  --callout-radius: 7px;
  --embed-border-start: 3px solid var(--interactive-accent);
  --nav-item-size: 14px;
  --nav-item-padding: 4px 8px;
  --status-bar-font-size: 12px;
  --h1-size: 1.85em;
  --h2-size: 1.55em;
  --h3-size: 1.3em;
  --h4-size: 1.15em;
  --h5-size: 1.05em;
  --h6-size: 1em;
  --h1-weight: 700;
  --h2-weight: 700;
  --h3-weight: 650;
  --h4-weight: 650;
  --h5-weight: 600;
  --h6-weight: 600;
  --bold-weight: 700;
  --link-decoration: none;
  --link-decoration-hover: underline;
}
