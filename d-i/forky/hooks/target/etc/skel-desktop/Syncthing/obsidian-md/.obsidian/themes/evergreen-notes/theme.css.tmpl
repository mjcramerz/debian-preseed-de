.markdown-rendered h5 {
  letter-spacing: -0.012em;
}
.markdown-rendered h6 {
  letter-spacing: -0.012em;
}
.markdown-rendered table {
  border-collapse: collapse;
  width: 100%;
}
.markdown-rendered th {
  font-weight: 700;
  text-align: left;
}
.markdown-rendered code {
  border-radius: var(--radius-s);
  padding: 0.08em 0.3em;
}
.markdown-source-view.mod-cm6 .cm-inline-code {
  border-radius: var(--radius-s);
  padding: 0.08em 0.3em;
}
.markdown-rendered pre code {
  padding: 0;
}
.workspace-tab-header.is-active {
  box-shadow: inset 0 2px 0 var(--interactive-accent);
}
.nav-file-title.is-active {
  font-weight: 650;
}
.nav-folder-title.is-active {
  font-weight: 650;
}
.callout {
  border: 1px solid rgba(var(--callout-color), __THEME_OBSIDIAN_CALLOUT_OUTLINE_ALPHA__);
  box-shadow: none;
}
.tag {
  border: 1px solid var(--background-modifier-border);
  font-weight: 600;
}


@media print {body {
    --font-text-size: 11pt;
    --file-line-width: 100%;
  }
.markdown-preview-view {
    color: __THEME_OBSIDIAN_PRINT_PREVIEW_TEXT_COLOR__;
    background: __THEME_OBSIDIAN_PRINT_PREVIEW_BACKGROUND_COLOR__;
  }

}
