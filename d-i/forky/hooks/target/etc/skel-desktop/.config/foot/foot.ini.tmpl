[main]
term=xterm-256color
app-id=foot
title=foot
font=__INSTALLER_LABWC_TERMINAL_FONT_FAMILY__:size=__INSTALLER_LABWC_TERMINAL_FONT_SIZE__,__THEME_FOOT_NERD_FONT_FAMILY__:size=__INSTALLER_LABWC_TERMINAL_FONT_SIZE__
dpi-aware=no
pad=4x4 center
resize-delay-ms=80
initial-window-size-chars=__INSTALLER_LABWC_TERMINAL_WINDOW_COLUMNS__x__INSTALLER_LABWC_TERMINAL_WINDOW_ROWS__

[bell]
system=no                                                                                                                                                                                    
visual=yes

[scrollback]
lines=10000
multiplier=3.0

[cursor]
style=__THEME_FOOT_CURSOR_STYLE__
blink=yes

[mouse]
hide-when-typing=yes
alternate-scroll-mode=yes

[url]
launch=xdg-open ${url}
label-letters=sadfjklewcmpgh
osc8-underline=url-mode

[colors-dark]
alpha=__INSTALLER_LABWC_TERMINAL_BACKGROUND_OPACITY__
foreground=__THEME_FOOT_DARK_FOREGROUND_COLOR__
background=__THEME_FOOT_DARK_BACKGROUND_COLOR__
selection-foreground=__THEME_FOOT_DARK_SELECTION_FOREGROUND_COLOR__
selection-background=__THEME_FOOT_DARK_SELECTION_BACKGROUND_COLOR__
urls=__THEME_FOOT_DARK_URLS_COLOR__
regular0=__THEME_FOOT_DARK_ANSI_NORMAL_BLACK_COLOR__
regular1=__THEME_FOOT_DARK_ANSI_NORMAL_RED_COLOR__
regular2=__THEME_FOOT_DARK_ANSI_NORMAL_GREEN_COLOR__
regular3=__THEME_FOOT_DARK_ANSI_NORMAL_YELLOW_COLOR__
regular4=__THEME_FOOT_DARK_ANSI_NORMAL_BLUE_COLOR__
regular5=__THEME_FOOT_DARK_ANSI_NORMAL_MAGENTA_COLOR__
regular6=__THEME_FOOT_DARK_ANSI_NORMAL_CYAN_COLOR__
regular7=__THEME_FOOT_DARK_ANSI_NORMAL_WHITE_COLOR__
bright0=__THEME_FOOT_DARK_ANSI_BRIGHT_BLACK_COLOR__
bright1=__THEME_FOOT_DARK_ANSI_BRIGHT_RED_COLOR__
bright2=__THEME_FOOT_DARK_ANSI_BRIGHT_GREEN_COLOR__
bright3=__THEME_FOOT_DARK_ANSI_BRIGHT_YELLOW_COLOR__
bright4=__THEME_FOOT_DARK_ANSI_BRIGHT_BLUE_COLOR__
bright5=__THEME_FOOT_DARK_ANSI_BRIGHT_MAGENTA_COLOR__
bright6=__THEME_FOOT_DARK_ANSI_BRIGHT_CYAN_COLOR__
bright7=__THEME_FOOT_DARK_ANSI_BRIGHT_WHITE_COLOR__
