{
  "custom/tomat": {
    "exec": "/usr/local/libexec/labwc-waybar-exec /usr/local/libexec/labwc-tomat watch",
    "exec-if": "/usr/bin/test -x /usr/bin/tomat",
    "return-type": "json",
    "format": "{}",
    "escape": false,
    "tooltip": true,
    "restart-interval": 30,
    "exec-on-event": false,
    "on-click-right": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-tomat toggle",
    "on-click-middle": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-tomat skip",
    "menu": "on-click",
    "menu-file": "~/.config/waybar/gtk/tomat-menu.xml",
    "menu-actions": {
      "tomat_default": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-tomat start default",
      "tomat_25": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-tomat start 25",
      "tomat_50": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-tomat start 50",
      "tomat_90": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-tomat start 90",
      "tomat_toggle": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-tomat toggle",
      "tomat_skip": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-tomat skip",
      "tomat_stop": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-tomat stop",
      "tomat_config": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-tomat config",
      "tomat_notifications": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-tomat settings notifications",
      "tomat_sounds": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-tomat settings sounds",
      "tomat_overlays": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-tomat settings overlays"
    }
  }
}
