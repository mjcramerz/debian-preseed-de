/* Waybar menu button rules. Native theme values remain editable per mapping. */

#custom-launcher {
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_MENU_NORMAL_OUTLINE_COLOR__;
  background: __THEME_WAYBAR_BUTTON_MENU_NORMAL_BACKGROUND_COLOR__;
  color: __THEME_WAYBAR_BUTTON_MENU_NORMAL_TEXT_COLOR__;
  font-weight: __THEME_WAYBAR_FONT_WEIGHT_EMPHASIS__;
}

window#waybar.internal #custom-launcher {
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_MENU_BUTTON_MIN_WIDTH__px;
  padding: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_INTERNAL_MENU_BUTTON_PADDING_X__px;
}

window#waybar.external #custom-launcher {
  min-width: __INSTALLER_LABWC_WAYBAR_EXTERNAL_MENU_BUTTON_MIN_WIDTH__px;
  padding: __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_EXTERNAL_MENU_BUTTON_PADDING_X__px;
}

#custom-launcher:hover {
  background: __THEME_WAYBAR_BUTTON_MENU_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_WAYBAR_BUTTON_MENU_HOVER_OUTLINE_COLOR__;
  box-shadow: inset 0 0 6px 1px __THEME_WAYBAR_BUTTON_MENU_HOVER_OUTLINE_COLOR__;
}
