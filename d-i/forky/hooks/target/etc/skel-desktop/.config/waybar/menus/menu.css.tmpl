/* Waybar menu popup rules. Native theme values remain editable per mapping.
* GTK menus are detached popup windows shared by both named Waybar bars.
* The installer validates the INTERNAL/EXTERNAL popup geometry pair and
* renders it through the SHARED aliases below; no output-class selector can
* safely distinguish the menu's originating bar.
*/

menu {
  background: __THEME_WAYBAR_DROPDOWN_MENU_NORMAL_BACKGROUND_COLOR__;
  color: __THEME_WAYBAR_DROPDOWN_MENU_NORMAL_TEXT_COLOR__;
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_DROPDOWN_MENU_NORMAL_OUTLINE_COLOR__;
  -gtk-icon-theme: "__THEME_WAYBAR_DROPDOWN_GTK_ICON_THEME__";
  border-width: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_BORDER_WIDTH__px;
  padding: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_PADDING__px;
  box-shadow: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_SHADOW__ __THEME_WAYBAR_DROPDOWN_MENU_NORMAL_SHADOW_COLOR__;
}

menuitem {
  font-weight: __THEME_WAYBAR_FONT_WEIGHT_NORMAL__;
  padding: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_ITEM_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_SHARED_MENU_ITEM_PADDING_X__px;
  border-radius: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_ITEM_RADIUS__px;
}

menuitem label {
  font-weight: __THEME_WAYBAR_FONT_WEIGHT_NORMAL__;
  color: __THEME_WAYBAR_DROPDOWN_MENU_NORMAL_TEXT_COLOR__;
  font-size: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_FONT_SIZE__px;
}

menuitem image {
  color: __THEME_WAYBAR_DROPDOWN_MENU_NORMAL_ICON_COLOR__;
  min-width: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_ICON_WIDTH__px;
  min-height: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_ICON_HEIGHT__px;
}

menuitem:selected:not(:disabled) {
  background: __THEME_WAYBAR_DROPDOWN_MENU_HOVER_BACKGROUND_COLOR__;
  color: __THEME_WAYBAR_DROPDOWN_MENU_HOVER_TEXT_COLOR__;
  box-shadow: inset __INSTALLER_LABWC_WAYBAR_SHARED_MENU_HOVER_SHADOW__ __THEME_WAYBAR_DROPDOWN_MENU_HOVER_SHADOW_COLOR__;
}

menuitem:selected:not(:disabled) label {
  color: __THEME_WAYBAR_DROPDOWN_MENU_HOVER_TEXT_COLOR__;
}

menuitem:selected:not(:disabled) image {
  color: __THEME_WAYBAR_DROPDOWN_MENU_HOVER_ICON_COLOR__;
}

menuitem arrow {
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_ARROW_NORMAL_ICON_COLOR__;
  min-width: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_ARROW_SIZE__px;
  min-height: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_ARROW_SIZE__px;
  margin-left: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_ARROW_MARGIN_X__px;
}

menuitem arrow.right {
  -gtk-icon-source: -gtk-icontheme("__THEME_WAYBAR_DROPDOWN_SUBMENU_RIGHT_ICON_NAME__");
}

menuitem arrow.left {
  -gtk-icon-source: -gtk-icontheme("__THEME_WAYBAR_DROPDOWN_SUBMENU_LEFT_ICON_NAME__");
}

menuitem:selected:not(:disabled) arrow {
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_ARROW_HOVER_ICON_COLOR__;
}

menuitem:disabled {
  background: __THEME_WAYBAR_DROPDOWN_MENU_DISABLED_BACKGROUND_COLOR__;
  color: __THEME_WAYBAR_DROPDOWN_MENU_DISABLED_TEXT_COLOR__;
  box-shadow: none;
}

menuitem:disabled label {
  color: __THEME_WAYBAR_DROPDOWN_MENU_DISABLED_TEXT_COLOR__;
}

menuitem:disabled image {
  color: __THEME_WAYBAR_DROPDOWN_MENU_DISABLED_ICON_COLOR__;
}

menuitem:disabled arrow {
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_ARROW_DISABLED_ICON_COLOR__;
}

menu separator {
  background: __THEME_WAYBAR_DROPDOWN_MENU_SEPARATOR_NORMAL_BACKGROUND_COLOR__;
  min-height: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_SEPARATOR_HEIGHT__px;
  margin: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_SEPARATOR_MARGIN_Y__px __INSTALLER_LABWC_WAYBAR_SHARED_MENU_SEPARATOR_MARGIN_X__px;
}

menu.submenu {
  background: __THEME_WAYBAR_DROPDOWN_SUBMENU_NORMAL_BACKGROUND_COLOR__;
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_NORMAL_TEXT_COLOR__;
  border-color: __THEME_WAYBAR_DROPDOWN_SUBMENU_NORMAL_OUTLINE_COLOR__;
  box-shadow: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_SHADOW__ __THEME_WAYBAR_DROPDOWN_SUBMENU_NORMAL_SHADOW_COLOR__;
}

menu.submenu > menuitem label {
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_NORMAL_TEXT_COLOR__;
}

menu.submenu > menuitem image {
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_ITEM_NORMAL_ICON_COLOR__;
}

menu.submenu > menuitem:hover:not(:disabled) {
  background: __THEME_WAYBAR_DROPDOWN_SUBMENU_HOVER_BACKGROUND_COLOR__;
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_HOVER_TEXT_COLOR__;
}

menu.submenu > menuitem:hover:not(:disabled) label {
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_HOVER_TEXT_COLOR__;
}

menu.submenu > menuitem:hover:not(:disabled) image {
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_ITEM_HOVER_ICON_COLOR__;
}

menu.submenu > menuitem:selected:not(:disabled) {
  background: __THEME_WAYBAR_DROPDOWN_SUBMENU_HOVER_BACKGROUND_COLOR__;
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_HOVER_TEXT_COLOR__;
  box-shadow: inset __INSTALLER_LABWC_WAYBAR_SHARED_MENU_HOVER_SHADOW__ __THEME_WAYBAR_DROPDOWN_SUBMENU_HOVER_SHADOW_COLOR__;
}

menu.submenu > menuitem:selected:not(:disabled) label {
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_HOVER_TEXT_COLOR__;
}

menu.submenu > menuitem:selected:not(:disabled) image {
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_ITEM_HOVER_ICON_COLOR__;
}

menu.submenu > menuitem:disabled {
  background: __THEME_WAYBAR_DROPDOWN_SUBMENU_DISABLED_BACKGROUND_COLOR__;
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_DISABLED_TEXT_COLOR__;
}

menu.submenu > menuitem:disabled label {
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_DISABLED_TEXT_COLOR__;
}

menu.submenu > menuitem:disabled image {
  color: __THEME_WAYBAR_DROPDOWN_SUBMENU_ITEM_DISABLED_ICON_COLOR__;
}

menu.submenu separator {
  background: __THEME_WAYBAR_DROPDOWN_SUBMENU_SEPARATOR_NORMAL_BACKGROUND_COLOR__;
}

menu * {
  border-radius: __INSTALLER_LABWC_WAYBAR_SHARED_POPUP_RESET_SIZE__px;
  min-height: __INSTALLER_LABWC_WAYBAR_SHARED_POPUP_RESET_SIZE__px;
  font-size: __INSTALLER_LABWC_WAYBAR_SHARED_MENU_FONT_SIZE__px;
}
