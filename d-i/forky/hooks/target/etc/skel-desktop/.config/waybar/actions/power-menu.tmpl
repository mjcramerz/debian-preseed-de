{
  "custom/battery": {
    "exec": "/usr/local/libexec/labwc-waybar-exec /usr/local/libexec/labwc-waybar-battery --watch",
    "cursor": true,
    "return-type": "json",
    "restart-interval": 30,
    "exec-on-event": false,
    "format": "{icon} {text}",
    "format-icons": {
      "default": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_NORMAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_NORMAL_ICON_GLYPH__</span>",
      "charging": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_CHARGING_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_CHARGING_ICON_GLYPH__</span>",
      "full": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_FULL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_FULL_ICON_GLYPH__</span>",
      "plugged": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_PLUGGED_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_PLUGGED_ICON_GLYPH__</span>",
      "not-charging": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_NOT_CHARGING_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_NOT_CHARGING_ICON_GLYPH__</span>",
      "charging-warning": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_CHARGING_WARNING_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_CHARGING_ICON_GLYPH__</span>",
      "charging-critical": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_CHARGING_CRITICAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_CHARGING_ICON_GLYPH__</span>",
      "full-warning": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_FULL_WARNING_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_FULL_ICON_GLYPH__</span>",
      "full-critical": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_FULL_CRITICAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_FULL_ICON_GLYPH__</span>",
      "plugged-warning": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_PLUGGED_WARNING_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_PLUGGED_ICON_GLYPH__</span>",
      "plugged-critical": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_PLUGGED_CRITICAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_PLUGGED_ICON_GLYPH__</span>",
      "not-charging-warning": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_NOT_CHARGING_WARNING_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_NOT_CHARGING_ICON_GLYPH__</span>",
      "not-charging-critical": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_NOT_CHARGING_CRITICAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_NOT_CHARGING_ICON_GLYPH__</span>",
      "warning": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_WARNING_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_WARNING_ICON_GLYPH__</span>",
      "critical": "<span foreground='__THEME_WAYBAR_BUTTON_BATTERY_CRITICAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BATTERY_CRITICAL_ICON_GLYPH__</span>"
    },
    "tooltip": true,
    "on-click-release": "/usr/local/libexec/labwc-waybar-run -- __INSTALLER_LABWC_POWER_SETTINGS_COMMAND__"
  },
  "custom/lock": {
    "format": "__THEME_WAYBAR_BUTTON_LOCK_NORMAL_ICON_GLYPH__",
    "tooltip": false,
    "on-click": "/usr/local/libexec/labwc-waybar-run -- /usr/local/bin/labwc-power-settings lock"
  },
  "custom/power": {
    "format": "__THEME_WAYBAR_BUTTON_POWER_NORMAL_ICON_GLYPH__",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/menus/power-menu.xml",
    "menu-actions": {
      "power_lock": "/usr/local/libexec/labwc-waybar-run -- /usr/local/bin/labwc-power-settings lock",
      "power_suspend": "/usr/local/libexec/labwc-waybar-run -- /usr/local/bin/labwc-power-settings suspend",
      "power_reboot": "/usr/local/libexec/labwc-waybar-run -- /usr/local/bin/labwc-power-settings reboot",
      "power_logout": "/usr/local/libexec/labwc-waybar-run -- /usr/local/bin/labwc-power-settings logout",
      "power_shutdown": "/usr/local/libexec/labwc-waybar-run -- /usr/local/bin/labwc-power-settings poweroff"
    }
  }
}
