{
  "bluetooth": {
    "format": "__THEME_WAYBAR_BUTTON_BLUETOOTH_ENABLED_ICON_GLYPH__",
    "format-on": "__THEME_WAYBAR_BUTTON_BLUETOOTH_ENABLED_ICON_GLYPH__",
    "format-off": "__THEME_WAYBAR_BUTTON_BLUETOOTH_DISABLED_ICON_GLYPH__",
    "format-disabled": "__THEME_WAYBAR_BUTTON_BLUETOOTH_DISABLED_ICON_GLYPH__",
    "format-connected": "__THEME_WAYBAR_BUTTON_BLUETOOTH_CONNECTED_ICON_GLYPH__",
    "format-no-controller": "__THEME_WAYBAR_BUTTON_BLUETOOTH_UNAVAILABLE_ICON_GLYPH__",
    "tooltip-format": "Bluetooth {status}\nLeft-click: Bluetooth actions\nRight-click: power toggle",
    "tooltip": true,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/gtk/bluetooth-menu.xml",
    "menu-actions": {
      "bluetooth_console": "/usr/local/libexec/labwc-waybar-run -- labwc-bluetooth open",
      "bluetooth_scan": "/usr/local/libexec/labwc-waybar-run -- labwc-bluetooth scan",
      "bluetooth_pair": "/usr/local/libexec/labwc-waybar-run -- labwc-bluetooth pair-menu",
      "bluetooth_connect": "/usr/local/libexec/labwc-waybar-run -- labwc-bluetooth connect",
      "bluetooth_disconnect": "/usr/local/libexec/labwc-waybar-run -- labwc-bluetooth disconnect",
      "bluetooth_manage": "/usr/local/libexec/labwc-waybar-run -- labwc-bluetooth manage",
      "bluetooth_adapter": "/usr/local/libexec/labwc-waybar-run -- labwc-bluetooth adapter"
    },
    "on-click-right-release": "/usr/local/libexec/labwc-waybar-run -- labwc-bluetooth power-toggle"
  }
}
