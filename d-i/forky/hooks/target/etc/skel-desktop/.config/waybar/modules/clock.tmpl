{
  "clock": {
    "interval": 30,
    "format": "{:%a %H:%M}",
    "tooltip": false,
    "on-click-right-release": "/usr/local/libexec/labwc-waycal-control open",
    "menu": "on-click-release",
    "menu-file": "~/.config/waybar/gtk/calendar-menu.xml",
    "menu-actions": {
      "calendar_open": "/usr/local/libexec/labwc-waybar-run -- /usr/local/bin/labwc-calendar",
      "calendar_agenda": "/usr/local/libexec/labwc-waybar-run -- /usr/local/bin/labwc-agenda",
      "calendar_new_event": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-calendar-actions event-create",
      "calendar_edit_event": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-calendar-actions event-manage",
      "calendar_tasks": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-calendar-actions tasks-pending",
      "calendar_all_tasks": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-calendar-actions tasks-all",
      "calendar_new_task": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-calendar-actions task-create",
      "calendar_edit_task": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-calendar-actions task-edit",
      "calendar_show_task": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-calendar-actions task-details",
      "calendar_done_task": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-calendar-actions task-complete",
      "calendar_delete_task": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-calendar-actions task-delete"
    }
  }
}
