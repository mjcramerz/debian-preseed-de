@define-color panel rgba(8, 17, 31, 0.94);
@define-color panel_alt rgba(16, 29, 51, 0.92);
@define-color panel_hover rgba(28, 44, 70, 0.96);
@define-color border rgba(236, 184, 96, 0.24);
@define-color border_strong rgba(236, 184, 96, 0.74);
@define-color text #f5efe3;
@define-color muted #aeb7c6;
@define-color amber #ecb860;
@define-color royalpurple #c4a4ef;
@define-color marineblue #4166F5;
@define-color emeraldgreen #50C878;
@define-color cinnamon #D2691E;
@define-color tutamagenta #e56b8f;
@define-color notescyan #22D3EE;
@define-color amber_soft rgba(236, 184, 96, 0.18);
@define-color mint #9fd2bf;
@define-color rose #f6a09a;
@define-color red #f87171;

* {
  border: none;
  border-radius: 0;
  font-family: "Noto Sans", "Noto Color Emoji", "Symbola", "Font Awesome 6 Free";
  font-size: __INSTALLER_LABWC_WAYBAR_FONT_SIZE__px;
  min-height: 0;
  font-feature-settings: "tnum";
}

window#waybar {
  background: @panel;
  border: 1px solid @border;
  border-radius: 18px;
  color: @text;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.24);
}

window#waybar.internal,
window#waybar.internal * {
  font-size: __INSTALLER_LABWC_WAYBAR_INTERNAL_FONT_SIZE__px;
}

tooltip {
  background: rgba(8, 17, 31, 0.98);
  border: 1px solid @border_strong;
  border-radius: 14px;
  color: @text;
  padding: __INSTALLER_LABWC_WAYBAR_TOOLTIP_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_TOOLTIP_PADDING_X__px;
}

tooltip label {
  font-size: __INSTALLER_LABWC_WAYBAR_TOOLTIP_FONT_SIZE__px;
  font-family: "Noto Sans Mono", "Noto Color Emoji", "Symbola";
}

#workspaces {
  margin: 0;
  padding: 0;
  background: transparent;
}

#custom-launcher,
#custom-window-switcher,
#custom-wayscriber,
#custom-tomat,
#custom-apps,
#custom-app-terminal,
#custom-app-files,
#custom-app-tuta,
#custom-app-notes,
#custom-app-sleek,
#taskbar button,
#workspaces button,
#clock,
#pulseaudio,
#custom-backlight,
#battery,
#disk,
#cpu,
#memory,
#tray,
#custom-notifications,
#custom-lock,
#custom-power {
  margin: 5px 3px;
  padding: 0 14px;
  border-radius: 999px;
  background: @panel_alt;
  border: 1px solid @border;
  color: @text;
}

#workspaces button {
  min-width: __INSTALLER_LABWC_WAYBAR_WORKSPACE_BUTTON_MIN_WIDTH__px;
  padding: 0 __INSTALLER_LABWC_WAYBAR_WORKSPACE_BUTTON_PADDING_X__px;
  font-weight: 700;
}

/* Idle workspaces remain navy; pointer feedback must not imitate active. */
#workspaces button:hover:not(.active):not(.urgent) {
  background: @panel_hover;
  border-color: rgba(236, 184, 96, 0.34);
  color: @text;
  box-shadow: 0 0 7px rgba(236, 184, 96, 0.14);
}

#workspaces button.active,
#workspaces button.active:hover,
#taskbar button.active,
#taskbar button:hover,
#custom-power:hover {
  background: linear-gradient(135deg, rgba(236, 184, 96, 0.92), rgba(242, 159, 103, 0.92));
  border-color: @border_strong;
  color: #08111f;
  box-shadow: 0 10px 26px rgba(236, 184, 96, 0.22);
}

#workspaces button.urgent {
  background: rgba(68, 25, 33, 0.78);
  border-color: rgba(246, 173, 173, 0.34);
  color: @rose;
}

#workspaces button.hidden {
  color: @muted;
}

#custom-launcher {
  min-width: __INSTALLER_LABWC_WAYBAR_MENU_BUTTON_MIN_WIDTH__px;
  padding: 0 __INSTALLER_LABWC_WAYBAR_MENU_BUTTON_PADDING_X__px;
  background: @panel_alt;
  color: @amber;
  font-weight: 700;
}

#apps {
  background: transparent;
}

#custom-apps {
  min-width: 28px;
  padding: 0 7px;
  color: @royalpurple;
  background-image: -gtk-recolor(url("icons/apps-symbolic.svg"));
}

#custom-wayscriber {
  min-width: 28px;
  padding: 0 7px;
  color: @marineblue;
  background-image: -gtk-recolor(url("icons/wayscriber-symbolic.svg"));
}


/* Center the painted icon, not a font glyph's baseline or side bearings.
 * The single-space labels retain tooltips, click targets and the apps drawer.
 * Explicit hover layers preserve each button's tint and foreground color. */
#custom-apps,
#custom-wayscriber,
#custom-apps:hover,
#custom-wayscriber:hover {
  background-position: center;
  background-repeat: no-repeat;
  background-size: 18px 18px, 100% 100%;
}

#custom-apps:hover {
  background-color: rgba(64, 44, 86, 0.82);
  background-image: -gtk-recolor(url("icons/apps-symbolic.svg"));
  border-color: #b596db;
  box-shadow: 0 0 9px rgba(181, 150, 219, 0.28);
}

#custom-wayscriber:hover {
  background-color: rgba(20, 39, 83, 0.86);
  background-image: -gtk-recolor(url("icons/wayscriber-symbolic.svg"));
  border-color: #6387ff;
  box-shadow: 0 0 9px rgba(65, 102, 245, 0.32);
}

#custom-launcher:hover {
  background: rgba(69, 46, 13, 0.84);
  border-color: @amber;
  box-shadow: 0 0 9px rgba(236, 184, 96, 0.30);
}

#custom-tomat:hover {
  background: rgba(64, 20, 34, 0.86);
  border-color: #a85a6c;
  box-shadow: 0 0 7px rgba(168, 90, 108, 0.22);
  /* No color override: preserve work/break/paused/error state foreground. */
}

#custom-window-switcher:hover {
  background: rgba(15, 56, 39, 0.86);
  border-color: @emeraldgreen;
  box-shadow: 0 0 9px rgba(80, 200, 120, 0.28);
}

#custom-app-terminal,
#custom-app-files,
#custom-app-tuta,
#custom-app-notes,
#custom-app-sleek,
#custom-app-terminal:hover,
#custom-app-files:hover,
#custom-app-tuta:hover,
#custom-app-notes:hover,
#custom-app-sleek:hover {
  min-width: 28px;
  padding: 0 7px;
  /* Read package artwork directly: Papirus-Dark shares app SVGs with
   * Papirus; Tuta/Sleek supply their own logos. CSS URL images respect this
   * 18px bound, unlike GTK3's CSS icon-theme bitmap lookup. No cache/helper.
   * Forky's Waybar 0.15.0 custom module does not implement image-path yet. */
  -gtk-icon-theme: "Papirus-Dark";
  background-position: center;
  background-repeat: no-repeat;
  background-size: 18px 18px, 100% 100%;
}

#custom-app-terminal {
  background-image: url("/usr/share/icons/Papirus/24x24/apps/foot.svg");
}

#custom-app-files {
  background-image: url("/usr/share/icons/Papirus/24x24/apps/org.xfce.thunar.svg");
}

#custom-app-tuta {
  background-image: url("/usr/share/icons/hicolor/512x512/apps/tuta-mail.png");
}

#custom-app-notes {
  background-image: url("/usr/share/icons/Papirus/24x24/apps/featherpad.svg");
}

#custom-app-sleek {
  background-image: url("/usr/share/icons/hicolor/512x512/apps/sleek.png");
}

/* Change only the color layer: retain each application's bounded artwork. */
#custom-app-terminal:hover,
#custom-app-files:hover,
#custom-app-tuta:hover,
#custom-app-notes:hover,
#custom-app-sleek:hover {
  background-color: rgba(44, 39, 62, 0.96);
  border-color: rgba(196, 164, 239, 0.55);
  box-shadow: inset 0 0 0 1px rgba(196, 164, 239, 0.20);
}

#taskbar {
  min-width: 0;
}

#taskbar button {
  min-width: __INSTALLER_LABWC_WAYBAR_TASKBAR_BUTTON_MIN_WIDTH__px;
  padding: 0 __INSTALLER_LABWC_WAYBAR_TASKBAR_BUTTON_PADDING_X__px;
}

#taskbar button image {
  margin: 0;
}

#taskbar button.minimized {
  color: @muted;
}

#quick-controls,
#quick-controls-internal {
  margin: 5px 1px;
  padding: 0;
  border-radius: 999px;
  background: @panel_alt;
  border: 1px solid @border;
  color: @text;
}

#quick-controls > *,
#quick-controls-internal > * {
  margin: 0;
  padding: 0;
}

#quick-controls #custom-system,
#quick-controls #network,
#quick-controls #custom-bluetooth,
#quick-controls #custom-keyboard,
#quick-controls #custom-screenshot,
#quick-controls-internal #custom-system,
#quick-controls-internal #network,
#quick-controls-internal #custom-bluetooth,
#quick-controls-internal #custom-keyboard,
#quick-controls-internal #custom-screenshot {
  margin: 0;
  padding: 0 8px;
  min-width: 28px;
  border: 1px solid transparent;
  border-radius: 999px;
  background: transparent;
  font-size: __INSTALLER_LABWC_WAYBAR_FONT_SIZE__px;
}

#quick-controls #custom-system:hover,
#quick-controls #network:hover,
#quick-controls #custom-bluetooth:hover,
#quick-controls #custom-keyboard:hover,
#quick-controls #custom-screenshot:hover,
#quick-controls-internal #custom-system:hover,
#quick-controls-internal #network:hover,
#quick-controls-internal #custom-bluetooth:hover,
#quick-controls-internal #custom-keyboard:hover,
#quick-controls-internal #custom-screenshot:hover {
  background: @panel_hover;
  border-color: @border;
}

#pulseaudio,
#custom-backlight,
#battery,
#disk,
#cpu,
#memory,
#tray,
#custom-notifications,
#custom-lock,
#custom-power {
  margin-left: 1px;
  margin-right: 1px;
  padding-left: 6px;
  padding-right: 6px;
}

#pulseaudio,
#custom-backlight,
#battery,
#disk,
#cpu,
#memory {
  min-width: 56px;
}

/* Session buttons share geometry and icon sizing on both output layouts. */
#custom-notifications,
#custom-lock,
#custom-power {
  min-width: 28px;
  font-weight: 700;
  padding-left: 8px;
  padding-right: 8px;
}

window#waybar.internal #pulseaudio,
window#waybar.internal #custom-backlight,
window#waybar.internal #battery,
window#waybar.internal #disk,
window#waybar.internal #cpu,
window#waybar.internal #memory,
window#waybar.internal #tray,
window#waybar.internal #custom-notifications,
window#waybar.internal #custom-lock,
window#waybar.internal #custom-power {
  margin-left: 0;
  margin-right: 0;
  padding-left: __INSTALLER_LABWC_WAYBAR_INTERNAL_STATUS_MODULE_PADDING_X__px;
  padding-right: __INSTALLER_LABWC_WAYBAR_INTERNAL_STATUS_MODULE_PADDING_X__px;
}

window#waybar.internal #pulseaudio,
window#waybar.internal #custom-backlight,
window#waybar.internal #battery,
window#waybar.internal #disk,
window#waybar.internal #cpu,
window#waybar.internal #memory {
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_STATUS_MODULE_MIN_WIDTH__px;
}

window#waybar.internal #quick-controls-internal {
  padding-left: __INSTALLER_LABWC_WAYBAR_INTERNAL_QUICK_CONTROL_GROUP_PADDING_X__px;
  padding-right: __INSTALLER_LABWC_WAYBAR_INTERNAL_QUICK_CONTROL_GROUP_PADDING_X__px;
}

window#waybar.internal #quick-controls-internal #custom-system,
window#waybar.internal #quick-controls-internal #network,
window#waybar.internal #quick-controls-internal #custom-bluetooth,
window#waybar.internal #quick-controls-internal #custom-keyboard,
window#waybar.internal #quick-controls-internal #custom-screenshot {
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_QUICK_CONTROL_BUTTON_MIN_WIDTH__px;
  padding-left: __INSTALLER_LABWC_WAYBAR_INTERNAL_QUICK_CONTROL_BUTTON_PADDING_X__px;
  padding-right: __INSTALLER_LABWC_WAYBAR_INTERNAL_QUICK_CONTROL_BUTTON_PADDING_X__px;
  font-size: __INSTALLER_LABWC_WAYBAR_INTERNAL_FONT_SIZE__px;
}

window#waybar.internal #custom-notifications,
window#waybar.internal #custom-lock,
window#waybar.internal #custom-power {
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_SESSION_BUTTON_MIN_WIDTH__px;
  padding-left: __INSTALLER_LABWC_WAYBAR_INTERNAL_SESSION_BUTTON_PADDING_X__px;
  padding-right: __INSTALLER_LABWC_WAYBAR_INTERNAL_SESSION_BUTTON_PADDING_X__px;
}

window#waybar.internal #custom-launcher {
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_MENU_BUTTON_MIN_WIDTH__px;
  padding-left: __INSTALLER_LABWC_WAYBAR_INTERNAL_MENU_BUTTON_PADDING_X__px;
  padding-right: __INSTALLER_LABWC_WAYBAR_INTERNAL_MENU_BUTTON_PADDING_X__px;
}

window#waybar.internal #workspaces button {
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_WORKSPACE_BUTTON_MIN_WIDTH__px;
  padding-left: __INSTALLER_LABWC_WAYBAR_INTERNAL_WORKSPACE_BUTTON_PADDING_X__px;
  padding-right: __INSTALLER_LABWC_WAYBAR_INTERNAL_WORKSPACE_BUTTON_PADDING_X__px;
}

window#waybar.internal #taskbar button {
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_TASKBAR_BUTTON_MIN_WIDTH__px;
  padding-left: __INSTALLER_LABWC_WAYBAR_INTERNAL_TASKBAR_BUTTON_PADDING_X__px;
  padding-right: __INSTALLER_LABWC_WAYBAR_INTERNAL_TASKBAR_BUTTON_PADDING_X__px;
}

window#waybar.internal #custom-apps,
window#waybar.internal #custom-window-switcher,
window#waybar.internal #custom-wayscriber,
window#waybar.internal #custom-tomat,
window#waybar.internal #custom-app-terminal,
window#waybar.internal #custom-app-files,
window#waybar.internal #custom-app-tuta,
window#waybar.internal #custom-app-notes,
window#waybar.internal #custom-app-sleek {
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_APP_BUTTON_MIN_WIDTH__px;
  padding-left: __INSTALLER_LABWC_WAYBAR_INTERNAL_APP_BUTTON_PADDING_X__px;
  padding-right: __INSTALLER_LABWC_WAYBAR_INTERNAL_APP_BUTTON_PADDING_X__px;
}

#custom-keyboard {
  color: @mint;
  font-weight: 700;
}

#custom-system {
  color: @amber;
  font-family: "Font Awesome 6 Free", "Font Awesome 5 Free", "Noto Sans Symbols 2", "Symbola";
  font-weight: 900;
}

#custom-screenshot {
  color: @text;
  font-weight: 700;
}

#custom-screenshot.recording {
  color: @red;
}

#custom-bluetooth {
  color: #60a5fa;
  font-weight: 700;
}

#custom-bluetooth.disabled,
#custom-bluetooth.unavailable,
#custom-backlight.unavailable {
  color: @amber;
}

#custom-bluetooth.connected,
#custom-backlight.available {
  color: @mint;
}

/* Notifications, lock and power share the same tinted session-chip language. */
#custom-notifications {
  background: rgba(236, 184, 96, 0.14);
  border-color: rgba(236, 184, 96, 0.46);
  color: @amber;
}

#custom-lock {
  background: rgba(203, 213, 225, 0.14);
  border-color: rgba(203, 213, 225, 0.46);
  color: #d8dee9;
}

#custom-lock:hover {
  background: linear-gradient(135deg, rgba(226, 232, 240, 0.84), rgba(148, 163, 184, 0.84));
  border-color: rgba(226, 232, 240, 0.78);
  color: #08111f;
  box-shadow: 0 10px 26px rgba(203, 213, 225, 0.18);
}

#custom-power {
  background: rgba(248, 113, 113, 0.16);
  border-color: rgba(248, 113, 113, 0.66);
  color: @red;
}

#custom-power:hover {
  background: linear-gradient(135deg, rgba(236, 184, 96, 0.92), rgba(242, 159, 103, 0.92), rgba(248, 113, 113, 0.92));
  border-color: rgba(248, 113, 113, 0.86);
  color: #08111f;
  box-shadow: 0 10px 26px rgba(248, 113, 113, 0.22);
}

#network.disconnected,
#network.disabled,
#pulseaudio.muted {
  color: @amber;
}

#clock {
  font-weight: 700;
  color: @amber;
}

#battery.charging,
#battery.full {
  color: @mint;
}

#battery.warning {
  color: @amber;
}

#battery.critical,
#disk.critical,
#cpu.critical,
#memory.critical {
  color: @red;
}

#disk.warning,
#cpu.warning,
#memory.warning {
  color: @amber;
}

/* Native Labwc cycle entry point, distinct from the blue annotation tool. */
#custom-window-switcher {
  min-width: 28px;
  padding: 0 7px;
  color: @emeraldgreen;
  font-family: "Font Awesome 6 Free", "Symbols Nerd Font Mono", "Noto Sans";
  font-weight: 700;
}

/* Clickable status chips need hover feedback just like launcher buttons. */
#clock:hover,
#pulseaudio:hover,
#custom-backlight:hover,
#battery:hover,
#disk:hover,
#cpu:hover,
#memory:hover {
  background: @panel_hover;
  border-color: @border_strong;
  box-shadow: inset 0 0 0 1px @border_strong;
}

/* Native menu affordances, without changing the existing panel layout/theme. */
#custom-tomat { min-width: 24px; padding-left: 8px; padding-right: 8px; }
#custom-tomat.work-paused, #custom-tomat.break-paused, #custom-tomat.long-break-paused { color: @amber; }
#custom-tomat.break, #custom-tomat.long-break { color: @mint; }
#custom-tomat.error { color: @red; }
#custom-notifications.dnd { color: @muted; }
/* Warm gold also wins over the DND text color while hovered. */
#custom-notifications:hover {
  background: @amber;
  border-color: @border_strong;
  color: #08111f;
  box-shadow: 0 10px 26px rgba(236, 184, 96, 0.22);
}
/* Native GTK popups are separate windows, not window#waybar descendants.
 * Keep pointer and keyboard selection identical. Text is deliberately normal
 * weight; symbolic images and submenu arrows have independent foregrounds. */
menu {
  background: rgba(8, 17, 31, 0.985);
  color: #f5efe3;
  border: 1px solid rgba(236, 184, 96, 0.34);
  padding: 4px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.36);
  -gtk-icon-theme: "Papirus-Dark";
}
menuitem { padding: 8px 14px; border-radius: 6px; font-weight: 400; }
menuitem label { font-size: 16px; font-weight: 400; color: #f5efe3; }
menuitem image { min-width: 20px; min-height: 18px; color: #dfe6ef; }
menuitem:hover:not(:disabled),
menuitem:selected:not(:disabled) {
  background: rgba(236, 184, 96, 0.16);
  color: #fff7e9;
  box-shadow: inset 0 0 0 1px rgba(236, 184, 96, 0.42);
}
menuitem:hover:not(:disabled) label,
menuitem:selected:not(:disabled) label { color: #fff7e9; }
menuitem:hover:not(:disabled) image,
menuitem:selected:not(:disabled) image { color: #ecb860; }
menuitem arrow {
  min-width: 16px;
  min-height: 16px;
  margin-left: 12px;
  color: #ecb860;
}
menuitem arrow.right { -gtk-icon-source: -gtk-icontheme("pan-end-symbolic"); }
menuitem arrow.left { -gtk-icon-source: -gtk-icontheme("pan-start-symbolic"); }
menuitem:hover:not(:disabled) arrow,
menuitem:selected:not(:disabled) arrow { color: #ecb860; }
menuitem:disabled {
  background: transparent;
  color: #7f8999;
  box-shadow: none;
}
menuitem:disabled label,
menuitem:disabled image,
menuitem:disabled arrow { color: #7f8999; }
menu separator {
  min-height: 1px;
  margin: 4px 8px;
  background: rgba(174, 183, 198, 0.18);
}
