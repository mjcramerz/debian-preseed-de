/* Waybar taskview button rules. Native theme values remain editable per mapping. */

#custom-window-switcher {
  background: __THEME_WAYBAR_BUTTON_TASKVIEW_NORMAL_BACKGROUND_COLOR__;
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_TASKVIEW_NORMAL_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_BUTTON_TASKVIEW_NORMAL_ICON_COLOR__;
  font-family: "__THEME_WAYBAR_ICON_FONT_FAMILY__", "__THEME_WAYBAR_NERD_FONT_FAMILY__", "__THEME_WAYBAR_TEXT_FONT_FAMILY__";
  font-weight: __THEME_WAYBAR_FONT_WEIGHT_EMPHASIS__;
}

window#waybar.internal #custom-window-switcher {
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_APP_BUTTON_MIN_WIDTH__px;
  padding: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_INTERNAL_APP_BUTTON_PADDING_X__px;
}

window#waybar.external #custom-window-switcher {
  min-width: __INSTALLER_LABWC_WAYBAR_EXTERNAL_APP_BUTTON_MIN_WIDTH__px;
  padding: __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_EXTERNAL_APP_BUTTON_PADDING_X__px;
}

#custom-window-switcher:hover {
  background: __THEME_WAYBAR_BUTTON_TASKVIEW_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_WAYBAR_BUTTON_TASKVIEW_HOVER_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_BUTTON_TASKVIEW_NORMAL_ICON_COLOR__;
}

window#waybar.internal #custom-window-switcher:hover {
  box-shadow: inset __INSTALLER_LABWC_WAYBAR_INTERNAL_INSET_SHADOW__ __THEME_WAYBAR_BUTTON_TASKVIEW_HOVER_SHADOW_COLOR__;
}

window#waybar.external #custom-window-switcher:hover {
  box-shadow: inset __INSTALLER_LABWC_WAYBAR_EXTERNAL_INSET_SHADOW__ __THEME_WAYBAR_BUTTON_TASKVIEW_HOVER_SHADOW_COLOR__;
}
