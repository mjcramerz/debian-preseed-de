/* Waybar workspaces button rules. Native theme values remain editable per mapping. */

#workspaces {
  background: __THEME_WAYBAR_WORKSPACES_CONTAINER_NORMAL_BACKGROUND_COLOR__;
}

window#waybar.internal #workspaces {
  margin: __INSTALLER_LABWC_WAYBAR_INTERNAL_RESET_SIZE__px;
  padding: __INSTALLER_LABWC_WAYBAR_INTERNAL_RESET_SIZE__px;
}

window#waybar.external #workspaces {
  margin: __INSTALLER_LABWC_WAYBAR_EXTERNAL_RESET_SIZE__px;
  padding: __INSTALLER_LABWC_WAYBAR_EXTERNAL_RESET_SIZE__px;
}

#workspaces button {
  background: __THEME_WAYBAR_BUTTON_WORKSPACES_NORMAL_BACKGROUND_COLOR__;
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_WORKSPACES_NORMAL_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_BUTTON_WORKSPACES_NORMAL_TEXT_COLOR__;
  font-weight: __THEME_WAYBAR_FONT_WEIGHT_EMPHASIS__;
}

window#waybar.internal #workspaces button {
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_WORKSPACE_BUTTON_MIN_WIDTH__px;
  padding: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_INTERNAL_WORKSPACE_BUTTON_PADDING_X__px;
}

window#waybar.external #workspaces button {
  min-width: __INSTALLER_LABWC_WAYBAR_EXTERNAL_WORKSPACE_BUTTON_MIN_WIDTH__px;
  padding: __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_EXTERNAL_WORKSPACE_BUTTON_PADDING_X__px;
}

#workspaces button:hover:not(.active):not(.urgent) {
  background: __THEME_WAYBAR_BUTTON_WORKSPACES_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_WAYBAR_BUTTON_WORKSPACES_HOVER_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_BUTTON_WORKSPACES_HOVER_TEXT_COLOR__;
  box-shadow: inset 0 0 6px 1px __THEME_WAYBAR_BUTTON_WORKSPACES_HOVER_OUTLINE_COLOR__;
}

#workspaces button.active {
  background: linear-gradient(__THEME_WAYBAR_GRADIENT_ANGLE__deg, __THEME_WAYBAR_BUTTON_WORKSPACES_ACTIVE_BACKGROUND_START_COLOR__, __THEME_WAYBAR_BUTTON_WORKSPACES_ACTIVE_BACKGROUND_END_COLOR__);
  border-color: __THEME_WAYBAR_BUTTON_WORKSPACES_ACTIVE_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_BUTTON_WORKSPACES_ACTIVE_TEXT_COLOR__;
}

window#waybar.internal #workspaces button.active {
  box-shadow: __INSTALLER_LABWC_WAYBAR_INTERNAL_ACTIVE_SHADOW__ __THEME_WAYBAR_BUTTON_WORKSPACES_ACTIVE_SHADOW_COLOR__;
}

window#waybar.external #workspaces button.active {
  box-shadow: __INSTALLER_LABWC_WAYBAR_EXTERNAL_ACTIVE_SHADOW__ __THEME_WAYBAR_BUTTON_WORKSPACES_ACTIVE_SHADOW_COLOR__;
}

#workspaces button.active:hover {
  background: linear-gradient(__THEME_WAYBAR_GRADIENT_ANGLE__deg, __THEME_WAYBAR_BUTTON_WORKSPACES_ACTIVE_HOVER_BACKGROUND_START_COLOR__, __THEME_WAYBAR_BUTTON_WORKSPACES_ACTIVE_HOVER_BACKGROUND_END_COLOR__);
  border-color: __THEME_WAYBAR_BUTTON_WORKSPACES_ACTIVE_HOVER_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_BUTTON_WORKSPACES_ACTIVE_HOVER_TEXT_COLOR__;
  box-shadow: inset 0 0 6px 1px __THEME_WAYBAR_BUTTON_WORKSPACES_ACTIVE_HOVER_OUTLINE_COLOR__;
}

#workspaces button.urgent {
  background: __THEME_WAYBAR_BUTTON_WORKSPACES_URGENT_BACKGROUND_COLOR__;
  border-color: __THEME_WAYBAR_BUTTON_WORKSPACES_URGENT_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_BUTTON_WORKSPACES_URGENT_TEXT_COLOR__;
}

#workspaces button.hidden {
  color: __THEME_WAYBAR_BUTTON_WORKSPACES_HIDDEN_TEXT_COLOR__;
}
