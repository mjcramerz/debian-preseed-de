{
  "backlight": {
    "interval": 30,
    "cursor": true,
    "format": "<span foreground='__THEME_WAYBAR_BUTTON_BACKLIGHT_AVAILABLE_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_BACKLIGHT_AVAILABLE_ICON_GLYPH__</span> {percent}%",
    "tooltip-format": "Display brightness {percent}%\nScroll or use the brightness keys to adjust",
    "tooltip": true,
    "on-click-release": "/usr/bin/systemd-run --user --quiet --collect --unit=labwc-brightness-menu --description=Labwc-brightness-menu --service-type=exec --expand-environment=no --slice=app.slice --property=Requisite=labwc-session.target --property=After=labwc-session.target --property=PartOf=labwc-session.target --property=ExitType=cgroup --property=KillMode=control-group --property=TimeoutStopSec=20s -- __INSTALLER_LABWC_BRIGHTNESS_CONTROL_COMMAND__ menu",
    "on-scroll-up": "__INSTALLER_LABWC_BRIGHTNESS_CONTROL_COMMAND__ up",
    "on-scroll-down": "__INSTALLER_LABWC_BRIGHTNESS_CONTROL_COMMAND__ down"
  },
  "disk": {
    "path": "/",
    "interval": 30,
    "format": "<span foreground='__THEME_WAYBAR_BUTTON_DISK_NORMAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_DISK_NORMAL_ICON_GLYPH__</span> {percentage_used}%",
    "format-warning": "<span foreground='__THEME_WAYBAR_BUTTON_DISK_WARNING_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_DISK_WARNING_ICON_GLYPH__</span> {percentage_used}%",
    "format-critical": "<span foreground='__THEME_WAYBAR_BUTTON_DISK_CRITICAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_DISK_CRITICAL_ICON_GLYPH__</span> {percentage_used}%",
    "tooltip-format": "{used} used out of {total} on {path} ({percentage_used}%)",
    "on-click": "/usr/local/bin/labwc-system-action storage-overview",
    "states": {
      "warning": 80,
      "critical": 90
    }
  },
  "cpu": {
    "interval": 5,
    "format": "<span foreground='__THEME_WAYBAR_BUTTON_CPU_NORMAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_CPU_NORMAL_ICON_GLYPH__</span> {usage}%",
    "format-warning": "<span foreground='__THEME_WAYBAR_BUTTON_CPU_WARNING_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_CPU_WARNING_ICON_GLYPH__</span> {usage}%",
    "format-critical": "<span foreground='__THEME_WAYBAR_BUTTON_CPU_CRITICAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_CPU_CRITICAL_ICON_GLYPH__</span> {usage}%",
    "on-click": "/usr/local/bin/labwc-terminal -e btop",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },
  "memory": {
    "interval": 10,
    "format": "<span foreground='__THEME_WAYBAR_BUTTON_MEMORY_NORMAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_MEMORY_NORMAL_ICON_GLYPH__</span> {percentage}%",
    "format-warning": "<span foreground='__THEME_WAYBAR_BUTTON_MEMORY_WARNING_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_MEMORY_WARNING_ICON_GLYPH__</span> {percentage}%",
    "format-critical": "<span foreground='__THEME_WAYBAR_BUTTON_MEMORY_CRITICAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_MEMORY_CRITICAL_ICON_GLYPH__</span> {percentage}%",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
    "on-click": "/usr/local/bin/labwc-terminal -e btop",
    "states": {
      "warning": 75,
      "critical": 90
    }
  }
}
