/* Waybar power button rules. Native theme values remain editable per mapping. */

#custom-power {
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_POWER_NORMAL_OUTLINE_COLOR__;
  font-weight: __THEME_WAYBAR_FONT_WEIGHT_EMPHASIS__;
  background: __THEME_WAYBAR_BUTTON_POWER_NORMAL_BACKGROUND_COLOR__;
  color: __THEME_WAYBAR_BUTTON_POWER_NORMAL_ICON_COLOR__;
}

window#waybar.internal #custom-power {
  margin: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_MARGIN_Y__px __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_MARGIN_X__px;
  padding: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_PADDING_X__px;
  border-radius: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_RADIUS__px;
  border-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_BORDER_WIDTH__px;
  margin-left: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_MARGIN_X__px;
  margin-right: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_MARGIN_X__px;
  padding-left: __INSTALLER_LABWC_WAYBAR_INTERNAL_SESSION_BUTTON_PADDING_X__px;
  padding-right: __INSTALLER_LABWC_WAYBAR_INTERNAL_SESSION_BUTTON_PADDING_X__px;
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_SESSION_BUTTON_MIN_WIDTH__px;
}

window#waybar.external #custom-power {
  margin: __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_MARGIN_Y__px __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_MARGIN_X__px;
  padding: __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_PADDING_X__px;
  border-radius: __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_RADIUS__px;
  border-width: __INSTALLER_LABWC_WAYBAR_EXTERNAL_BORDER_WIDTH__px;
  margin-left: __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_MARGIN_X__px;
  margin-right: __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_MARGIN_X__px;
  padding-left: __INSTALLER_LABWC_WAYBAR_EXTERNAL_SESSION_BUTTON_PADDING_X__px;
  padding-right: __INSTALLER_LABWC_WAYBAR_EXTERNAL_SESSION_BUTTON_PADDING_X__px;
  min-width: __INSTALLER_LABWC_WAYBAR_EXTERNAL_SESSION_BUTTON_MIN_WIDTH__px;
}

#custom-power:hover {
  background: linear-gradient(__THEME_WAYBAR_GRADIENT_ANGLE__deg, __THEME_WAYBAR_BUTTON_POWER_HOVER_BACKGROUND_START_COLOR__, __THEME_WAYBAR_BUTTON_POWER_HOVER_BACKGROUND_MIDDLE_COLOR__, __THEME_WAYBAR_BUTTON_POWER_HOVER_BACKGROUND_END_COLOR__);
  border-color: __THEME_WAYBAR_BUTTON_POWER_HOVER_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_BUTTON_POWER_HOVER_ICON_COLOR__;
}

window#waybar.internal #custom-power:hover {
  box-shadow: inset __INSTALLER_LABWC_WAYBAR_INTERNAL_INSET_SHADOW__ __THEME_WAYBAR_BUTTON_POWER_HOVER_SHADOW_COLOR__;
}

window#waybar.external #custom-power:hover {
  box-shadow: inset __INSTALLER_LABWC_WAYBAR_EXTERNAL_INSET_SHADOW__ __THEME_WAYBAR_BUTTON_POWER_HOVER_SHADOW_COLOR__;
}
