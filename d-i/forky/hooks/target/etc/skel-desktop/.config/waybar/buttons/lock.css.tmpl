/* Waybar lock button rules. Native theme values remain editable per mapping. */

#custom-lock {
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_LOCK_NORMAL_OUTLINE_COLOR__;
  background: __THEME_WAYBAR_BUTTON_LOCK_NORMAL_BACKGROUND_COLOR__;
  color: __THEME_WAYBAR_BUTTON_LOCK_NORMAL_ICON_COLOR__;
}

#custom-lock:hover {
  background: linear-gradient(__THEME_WAYBAR_GRADIENT_ANGLE__deg, __THEME_WAYBAR_BUTTON_LOCK_HOVER_BACKGROUND_START_COLOR__, __THEME_WAYBAR_BUTTON_LOCK_HOVER_BACKGROUND_END_COLOR__);
  border-color: __THEME_WAYBAR_BUTTON_LOCK_HOVER_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_BUTTON_LOCK_HOVER_ICON_COLOR__;
}

window#waybar.internal #custom-lock:hover {
  box-shadow: inset __INSTALLER_LABWC_WAYBAR_INTERNAL_INSET_SHADOW__ __THEME_WAYBAR_BUTTON_LOCK_HOVER_SHADOW_COLOR__;
}

window#waybar.external #custom-lock:hover {
  box-shadow: inset __INSTALLER_LABWC_WAYBAR_EXTERNAL_INSET_SHADOW__ __THEME_WAYBAR_BUTTON_LOCK_HOVER_SHADOW_COLOR__;
}
