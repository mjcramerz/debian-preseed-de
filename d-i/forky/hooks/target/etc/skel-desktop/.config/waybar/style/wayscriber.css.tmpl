/* Waybar wayscriber button rules. Native theme values remain editable per mapping. */

#custom-wayscriber {
  background: __THEME_WAYBAR_BUTTON_WAYSCRIBER_NORMAL_BACKGROUND_COLOR__;
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_WAYSCRIBER_NORMAL_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_BUTTON_WAYSCRIBER_NORMAL_ICON_COLOR__;
  background-image: -gtk-recolor(url("__THEME_WAYBAR_BUTTON_WAYSCRIBER_NORMAL_ICON_PATH__"));
}

window#waybar.internal #custom-wayscriber {
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_APP_BUTTON_MIN_WIDTH__px;
  padding: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_INTERNAL_APP_BUTTON_PADDING_X__px;
}

window#waybar.external #custom-wayscriber {
  min-width: __INSTALLER_LABWC_WAYBAR_EXTERNAL_APP_BUTTON_MIN_WIDTH__px;
  padding: __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_EXTERNAL_APP_BUTTON_PADDING_X__px;
}

#custom-wayscriber:hover {
  background-position: center;
  background-repeat: no-repeat;
  color: __THEME_WAYBAR_BUTTON_WAYSCRIBER_HOVER_ICON_COLOR__;
  background-color: __THEME_WAYBAR_BUTTON_WAYSCRIBER_HOVER_BACKGROUND_COLOR__;
  background-image: -gtk-recolor(url("__THEME_WAYBAR_BUTTON_WAYSCRIBER_HOVER_ICON_PATH__"));
  border-color: __THEME_WAYBAR_BUTTON_WAYSCRIBER_HOVER_OUTLINE_COLOR__;
  box-shadow: inset 0 0 6px 1px __THEME_WAYBAR_BUTTON_WAYSCRIBER_HOVER_SHADOW_COLOR__;
}

window#waybar.internal #custom-wayscriber:hover {
  background-size: __INSTALLER_LABWC_WAYBAR_INTERNAL_APP_ICON_SIZE__px __INSTALLER_LABWC_WAYBAR_INTERNAL_APP_ICON_SIZE__px, __INSTALLER_LABWC_WAYBAR_INTERNAL_BACKGROUND_FILL_PERCENT__% __INSTALLER_LABWC_WAYBAR_INTERNAL_BACKGROUND_FILL_PERCENT__%;
}

window#waybar.external #custom-wayscriber:hover {
  background-size: __INSTALLER_LABWC_WAYBAR_EXTERNAL_APP_ICON_SIZE__px __INSTALLER_LABWC_WAYBAR_EXTERNAL_APP_ICON_SIZE__px, __INSTALLER_LABWC_WAYBAR_EXTERNAL_BACKGROUND_FILL_PERCENT__% __INSTALLER_LABWC_WAYBAR_EXTERNAL_BACKGROUND_FILL_PERCENT__%;
}

window#waybar.internal #custom-wayscriber {
  background-position: center;
  background-repeat: no-repeat;
  background-size: __INSTALLER_LABWC_WAYBAR_INTERNAL_APP_ICON_SIZE__px __INSTALLER_LABWC_WAYBAR_INTERNAL_APP_ICON_SIZE__px, __INSTALLER_LABWC_WAYBAR_INTERNAL_BACKGROUND_FILL_PERCENT__% __INSTALLER_LABWC_WAYBAR_INTERNAL_BACKGROUND_FILL_PERCENT__%;
}

window#waybar.external #custom-wayscriber {
  background-position: center;
  background-repeat: no-repeat;
  background-size: __INSTALLER_LABWC_WAYBAR_EXTERNAL_APP_ICON_SIZE__px __INSTALLER_LABWC_WAYBAR_EXTERNAL_APP_ICON_SIZE__px, __INSTALLER_LABWC_WAYBAR_EXTERNAL_BACKGROUND_FILL_PERCENT__% __INSTALLER_LABWC_WAYBAR_EXTERNAL_BACKGROUND_FILL_PERCENT__%;
}
