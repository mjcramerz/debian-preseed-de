/* Waybar tomat button rules. Native theme values remain editable per mapping. */

#custom-tomat {
  background: __THEME_WAYBAR_BUTTON_TOMAT_NORMAL_BACKGROUND_COLOR__;
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_TOMAT_NORMAL_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_BUTTON_TOMAT_NORMAL_TEXT_COLOR__;
}

window#waybar.internal #custom-tomat {
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_TOMAT_MIN_WIDTH__px;
  padding-left: __INSTALLER_LABWC_WAYBAR_INTERNAL_TOMAT_PADDING_X__px;
  padding-right: __INSTALLER_LABWC_WAYBAR_INTERNAL_TOMAT_PADDING_X__px;
}

window#waybar.external #custom-tomat {
  min-width: __INSTALLER_LABWC_WAYBAR_EXTERNAL_TOMAT_MIN_WIDTH__px;
  padding-left: __INSTALLER_LABWC_WAYBAR_EXTERNAL_TOMAT_PADDING_X__px;
  padding-right: __INSTALLER_LABWC_WAYBAR_EXTERNAL_TOMAT_PADDING_X__px;
}

#custom-tomat:hover {
  background: __THEME_WAYBAR_BUTTON_TOMAT_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_WAYBAR_BUTTON_TOMAT_HOVER_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_BUTTON_APPS_HOVER_ICON_COLOR__;
  box-shadow: inset 0 0 6px 1px __THEME_WAYBAR_BUTTON_TOMAT_HOVER_SHADOW_COLOR__;
}

#custom-tomat.work-paused {
  color: __THEME_WAYBAR_BUTTON_TOMAT_WORK_PAUSED_TEXT_COLOR__;
}

#custom-tomat.break-paused {
  color: __THEME_WAYBAR_BUTTON_TOMAT_BREAK_PAUSED_TEXT_COLOR__;
}

#custom-tomat.long-break-paused {
  color: __THEME_WAYBAR_BUTTON_TOMAT_LONG_BREAK_PAUSED_TEXT_COLOR__;
}

#custom-tomat.break {
  color: __THEME_WAYBAR_BUTTON_TOMAT_BREAK_TEXT_COLOR__;
}

#custom-tomat.long-break {
  color: __THEME_WAYBAR_BUTTON_TOMAT_LONG_BREAK_TEXT_COLOR__;
}

#custom-tomat.error {
  color: __THEME_WAYBAR_BUTTON_TOMAT_ERROR_TEXT_COLOR__;
}
