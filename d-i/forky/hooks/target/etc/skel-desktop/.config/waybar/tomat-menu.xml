<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <object class="GtkMenu" id="menu">
    <child>
      <object class="GtkMenuItem">
        <property name="label">Start session</property>
        <child type="submenu">
          <object class="GtkMenu">
            <child>
              <object class="GtkMenuItem" id="tomat_default">
                <property name="label">Default</property>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="tomat_25">
                <property name="label">25 / 5</property>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="tomat_50">
                <property name="label">50 / 10</property>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="tomat_90">
                <property name="label">90 / 15</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkSeparatorMenuItem" />
    </child>
    <child>
      <object class="GtkMenuItem" id="tomat_toggle">
        <property name="label">Pause / Resume</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="tomat_skip">
        <property name="label">Skip</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="tomat_stop">
        <property name="label">Stop</property>
      </object>
    </child>
    <child>
      <object class="GtkSeparatorMenuItem" />
    </child>
    <child>
      <object class="GtkMenuItem">
        <property name="label">Settings</property>
        <child type="submenu">
          <object class="GtkMenu">
            <child>
              <object class="GtkMenuItem" id="tomat_notifications">
                <property name="label">Notifications (toggle)</property>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="tomat_sounds">
                <property name="label">Sounds (toggle)</property>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="tomat_config">
                <property name="label">Open config</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
