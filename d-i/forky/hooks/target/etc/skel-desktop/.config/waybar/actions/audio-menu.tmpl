{
  "pulseaudio": {
    "format": "<span foreground='__THEME_WAYBAR_BUTTON_AUDIO_NORMAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_AUDIO_NORMAL_ICON_GLYPH__</span> {volume}% {format_source}",
    "format-muted": "<span foreground='__THEME_WAYBAR_BUTTON_AUDIO_MUTED_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_AUDIO_MUTED_ICON_GLYPH__</span> {volume}% {format_source}",
    "format-source": "<span color='__THEME_WAYBAR_BUTTON_AUDIO_MICROPHONE_NORMAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_AUDIO_MICROPHONE_NORMAL_ICON_GLYPH__</span>__THEME_WAYBAR_BUTTON_AUDIO_MICROPHONE_NORMAL_SEPARATOR_ICON_GLYPH__{volume}%",
    "format-source-muted": "<span color='__THEME_WAYBAR_BUTTON_AUDIO_MICROPHONE_MUTED_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_AUDIO_MICROPHONE_MUTED_ICON_GLYPH__</span>__THEME_WAYBAR_BUTTON_AUDIO_MICROPHONE_MUTED_SEPARATOR_ICON_GLYPH__{volume}%",
    "tooltip-format": "{desc}",
    "scroll-step": 5,
    "max-volume": 120,
    "on-click-right": "/usr/bin/systemd-run --user --quiet --collect --unit=labwc-audio-menu --description=Labwc-audio-menu --service-type=exec --expand-environment=no --slice=app.slice --property=Requisite=labwc-session.target --property=After=labwc-session.target --property=PartOf=labwc-session.target --property=ExitType=cgroup --property=KillMode=control-group --property=TimeoutStopSec=20s -- __INSTALLER_LABWC_AUDIO_CONTROL_COMMAND__",
    "on-click-middle": "/usr/bin/systemd-run --user --quiet --collect --unit=labwc-audio-mute --description=Labwc-audio-mute --service-type=exec --expand-environment=no --slice=app.slice --property=Requisite=labwc-session.target --property=After=labwc-session.target --property=PartOf=labwc-session.target --property=ExitType=cgroup --property=KillMode=control-group --property=TimeoutStopSec=20s -- /usr/local/bin/labwc-system-menu-action audio_mute",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.2",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "menu": "on-click",
    "menu-file": "~/.config/waybar/menus/audio-menu.xml",
    "menu-actions": {
      "audio_open": "/usr/bin/systemd-run --user --quiet --collect --no-block --unit=labwc-audio-open --description=Labwc-audio-open --service-type=exec --expand-environment=no --slice=app.slice --property=Requisite=labwc-session.target --property=After=labwc-session.target --property=PartOf=labwc-session.target --property=ExitType=cgroup --property=KillMode=control-group --property=TimeoutStartSec=10s --property=TimeoutStopSec=20s -- __INSTALLER_LABWC_AUDIO_CONTROL_COMMAND__",
      "audio_mute": "/usr/bin/systemd-run --user --quiet --collect --no-block --unit=labwc-audio-mute --description=Labwc-audio-mute --service-type=exec --expand-environment=no --slice=app.slice --property=Requisite=labwc-session.target --property=After=labwc-session.target --property=PartOf=labwc-session.target --property=ExitType=cgroup --property=KillMode=control-group --property=TimeoutStartSec=10s --property=TimeoutStopSec=20s -- /usr/local/bin/labwc-system-menu-action audio_mute",
      "audio_mic": "/usr/bin/systemd-run --user --quiet --collect --no-block --unit=labwc-audio-microphone --description=Labwc-audio-microphone --service-type=exec --expand-environment=no --slice=app.slice --property=Requisite=labwc-session.target --property=After=labwc-session.target --property=PartOf=labwc-session.target --property=ExitType=cgroup --property=KillMode=control-group --property=TimeoutStartSec=10s --property=TimeoutStopSec=20s -- /usr/local/bin/labwc-system-menu-action audio_mic_mute",
      "audio_40": "/usr/bin/systemd-run --user --quiet --collect --no-block --unit=labwc-audio-volume-40 --description=Labwc-audio-volume-40 --service-type=exec --expand-environment=no --slice=app.slice --property=Requisite=labwc-session.target --property=After=labwc-session.target --property=PartOf=labwc-session.target --property=ExitType=cgroup --property=KillMode=control-group --property=TimeoutStartSec=10s --property=TimeoutStopSec=20s -- /usr/bin/wpctl set-volume @DEFAULT_AUDIO_SINK@ 40% --limit 1.2",
      "whisper_record": "/usr/bin/systemd-run --user --quiet --collect --no-block --unit=labwc-whisper-record --description=Labwc-whisper-record --service-type=exec --expand-environment=no --slice=app.slice --property=Requisite=labwc-session.target --property=After=labwc-session.target --property=PartOf=labwc-session.target --property=ExitType=cgroup --property=KillMode=control-group --property=TimeoutStartSec=10s --property=TimeoutStopSec=20s -- /usr/local/libexec/whisper-record-toggle start",
      "whisper_transcribe": "/usr/bin/systemd-run --user --quiet --collect --no-block --unit=labwc-whisper-transcribe --description=Labwc-whisper-transcribe --service-type=exec --expand-environment=no --slice=app.slice --property=Requisite=labwc-session.target --property=After=labwc-session.target --property=PartOf=labwc-session.target --property=ExitType=cgroup --property=KillMode=control-group --property=TimeoutStartSec=10s --property=TimeoutStopSec=20s -- /usr/bin/systemctl --user --no-block start whisper-transcribe.service",
      "whisper_stop": "/usr/bin/systemd-run --user --quiet --collect --no-block --unit=labwc-whisper-stop --description=Labwc-whisper-stop --service-type=exec --expand-environment=no --slice=app.slice --property=Requisite=labwc-session.target --property=After=labwc-session.target --property=PartOf=labwc-session.target --property=ExitType=cgroup --property=KillMode=control-group --property=TimeoutStartSec=10s --property=TimeoutStopSec=20s -- /usr/local/libexec/whisper-record-toggle stop",
      "whisper_cancel": "/usr/bin/systemd-run --user --quiet --collect --no-block --unit=labwc-whisper-cancel --description=Labwc-whisper-cancel --service-type=exec --expand-environment=no --slice=app.slice --property=Requisite=labwc-session.target --property=After=labwc-session.target --property=PartOf=labwc-session.target --property=ExitType=cgroup --property=KillMode=control-group --property=TimeoutStartSec=10s --property=TimeoutStopSec=20s -- /usr/bin/systemctl --user stop whisper-transcribe.service"
    }
  }
}
