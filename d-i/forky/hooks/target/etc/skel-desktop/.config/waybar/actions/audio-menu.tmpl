{
  "pulseaudio": {
    "format": "<span foreground='__THEME_WAYBAR_BUTTON_AUDIO_NORMAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_AUDIO_NORMAL_ICON_GLYPH__</span> {volume}% {format_source}",
    "format-muted": "<span foreground='__THEME_WAYBAR_BUTTON_AUDIO_MUTED_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_AUDIO_MUTED_ICON_GLYPH__</span> {volume}% {format_source}",
    "format-source": "<span color='__THEME_WAYBAR_BUTTON_AUDIO_MICROPHONE_NORMAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_AUDIO_MICROPHONE_NORMAL_ICON_GLYPH__</span>__THEME_WAYBAR_BUTTON_AUDIO_MICROPHONE_NORMAL_SEPARATOR_ICON_GLYPH__{volume}%",
    "format-source-muted": "<span color='__THEME_WAYBAR_BUTTON_AUDIO_MICROPHONE_MUTED_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_AUDIO_MICROPHONE_MUTED_ICON_GLYPH__</span>__THEME_WAYBAR_BUTTON_AUDIO_MICROPHONE_MUTED_SEPARATOR_ICON_GLYPH__{volume}%",
    "tooltip-format": "{desc}",
    "scroll-step": 5,
    "max-volume": 120,
    "on-click-right": "/usr/local/libexec/labwc-waybar-run -- __INSTALLER_LABWC_AUDIO_CONTROL_COMMAND__",
    "on-click-middle": "/usr/local/libexec/labwc-waybar-run -- /usr/local/bin/labwc-system-menu-action audio_mute",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.2",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "menu": "on-click",
    "menu-file": "~/.config/waybar/menus/audio-menu.xml",
    "menu-actions": {
      "audio_open": "/usr/local/libexec/labwc-waybar-run -- __INSTALLER_LABWC_AUDIO_CONTROL_COMMAND__",
      "audio_mute": "/usr/local/libexec/labwc-waybar-run -- /usr/local/bin/labwc-system-menu-action audio_mute",
      "audio_mic": "/usr/local/libexec/labwc-waybar-run -- /usr/local/bin/labwc-system-menu-action audio_mic_mute",
      "audio_40": "/usr/local/libexec/labwc-waybar-run -- /usr/bin/wpctl set-volume @DEFAULT_AUDIO_SINK@ 40% --limit 1.2",
      "whisper_record": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/whisper-record-toggle start",
      "whisper_transcribe": "/usr/local/libexec/labwc-waybar-run -- /usr/bin/systemctl --user --no-block start whisper-transcribe.service",
      "whisper_stop": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/whisper-record-toggle stop",
      "whisper_cancel": "/usr/local/libexec/labwc-waybar-run -- /usr/bin/systemctl --user stop whisper-transcribe.service"
    }
  }
}
