  font-size: __INSTALLER_LABWC_WAYBAR_EXTERNAL_FONT_SIZE__px;
}

#quick-controls #custom-screenshot:hover {
  background: __THEME_WAYBAR_BUTTON_SCREENSHOT_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_WAYBAR_BUTTON_SCREENSHOT_HOVER_OUTLINE_COLOR__;
}

#custom-screenshot {
  color: __THEME_WAYBAR_BUTTON_SCREENSHOT_IDLE_ICON_COLOR__;
  font-weight: __THEME_WAYBAR_FONT_WEIGHT_EMPHASIS__;
}

#custom-screenshot.recording {
