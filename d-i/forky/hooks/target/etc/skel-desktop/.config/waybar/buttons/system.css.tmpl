/* Waybar system button rules. Native theme values remain editable per mapping. */

#custom-system {
  color: __THEME_WAYBAR_BUTTON_SYSTEM_NORMAL_ICON_COLOR__;
  font-family: "__THEME_WAYBAR_ICON_FONT_FAMILY__", "__THEME_WAYBAR_LEGACY_ICON_FONT_FAMILY__", "__THEME_WAYBAR_FALLBACK_SYMBOL_FONT_FAMILY__", "__THEME_WAYBAR_SYMBOL_FONT_FAMILY__";
  font-weight: __THEME_WAYBAR_FONT_WEIGHT_HEAVY__;
}

#quick-controls #bluetooth {
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_BLUETOOTH_NORMAL_OUTLINE_COLOR__;
  background: __THEME_WAYBAR_BUTTON_BLUETOOTH_NORMAL_BACKGROUND_COLOR__;
}

#quick-controls #bluetooth:hover {
  background: __THEME_WAYBAR_BUTTON_BLUETOOTH_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_WAYBAR_BUTTON_BLUETOOTH_HOVER_OUTLINE_COLOR__;
}

#bluetooth {
  color: __THEME_WAYBAR_BUTTON_BLUETOOTH_ENABLED_ICON_COLOR__;
  font-weight: __THEME_WAYBAR_FONT_WEIGHT_EMPHASIS__;
}

#bluetooth.off {
  color: __THEME_WAYBAR_BUTTON_BLUETOOTH_DISABLED_ICON_COLOR__;
}

#bluetooth.no-controller {
  color: __THEME_WAYBAR_BUTTON_BLUETOOTH_UNAVAILABLE_ICON_COLOR__;
}

#bluetooth.connected {
  color: __THEME_WAYBAR_BUTTON_BLUETOOTH_CONNECTED_ICON_COLOR__;
}

#quick-controls #custom-screenshot {
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_SCREENSHOT_NORMAL_OUTLINE_COLOR__;
  background: __THEME_WAYBAR_BUTTON_SCREENSHOT_NORMAL_BACKGROUND_COLOR__;
}

window#waybar.internal #quick-controls #custom-screenshot {
  margin: __INSTALLER_LABWC_WAYBAR_INTERNAL_RESET_SIZE__px;
  padding: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_INTERNAL_QUICK_CONTROL_BUTTON_PADDING_X__px;
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_QUICK_CONTROL_BUTTON_MIN_WIDTH__px;
  border-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_RESET_SIZE__px;
  border-radius: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_RADIUS__px;
  font-size: __INSTALLER_LABWC_WAYBAR_INTERNAL_FONT_SIZE__px;
}

window#waybar.external #quick-controls #custom-screenshot {
  margin: __INSTALLER_LABWC_WAYBAR_EXTERNAL_RESET_SIZE__px;
  padding: __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_EXTERNAL_QUICK_CONTROL_BUTTON_PADDING_X__px;
  min-width: __INSTALLER_LABWC_WAYBAR_EXTERNAL_QUICK_CONTROL_BUTTON_MIN_WIDTH__px;
