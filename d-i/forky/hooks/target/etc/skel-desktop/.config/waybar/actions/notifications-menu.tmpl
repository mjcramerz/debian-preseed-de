{
  "custom/notifications": {
    "exec": "/usr/local/libexec/labwc-waybar-exec /usr/local/libexec/labwc-waybar-events notifications",
    "return-type": "json",
    "format": "{}",
    "escape": true,
    "restart-interval": 30,
    "exec-on-event": false,
    "tooltip": true,
    "on-click-right": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-notifications dnd-dismiss",
    "on-click-middle": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-notifications dnd",
    "menu": "on-click",
    "menu-file": "~/.config/waybar/menus/notifications-menu.xml",
    "menu-actions": {
      "notifications_center": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-notifications center",
      "notifications_restore": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-notifications restore",
      "notifications_dnd_on": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-notifications dnd-on",
      "notifications_dnd_off": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-notifications dnd-off",
      "notifications_dnd": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-notifications dnd",
      "notifications_dismiss": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-notifications dismiss",
      "notifications_clear": "/usr/local/libexec/labwc-waybar-run -- /usr/local/libexec/labwc-notifications clear"
    }
  }
}
