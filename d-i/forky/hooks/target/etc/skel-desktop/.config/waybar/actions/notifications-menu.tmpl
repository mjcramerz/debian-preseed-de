{
  "custom/notifications": {
    "exec": "/usr/local/libexec/labwc-waybar-exec /usr/local/libexec/labwc-waybar-events notifications",
    "return-type": "json",
    "format": "{}",
    "escape": true,
    "restart-interval": 30,
    "exec-on-event": false,
    "tooltip": true,
    "on-click-right": "/usr/bin/systemd-run --user --quiet --collect --unit=labwc-notifications-dnd-dismiss --description=Labwc-notifications-dnd-dismiss --service-type=exec --expand-environment=no --slice=app.slice --property=Requisite=labwc-session.target --property=After=labwc-session.target --property=PartOf=labwc-session.target --property=ExitType=cgroup --property=KillMode=control-group --property=TimeoutStopSec=20s -- /usr/local/libexec/labwc-notifications dnd-dismiss",
