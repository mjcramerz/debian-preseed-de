/* Waybar system button rules. Native theme values remain editable per mapping. */

#custom-system {
  color: __THEME_WAYBAR_BUTTON_SYSTEM_NORMAL_ICON_COLOR__;
  font-family: "__THEME_WAYBAR_ICON_FONT_FAMILY__", "__THEME_WAYBAR_LEGACY_ICON_FONT_FAMILY__", "__THEME_WAYBAR_FALLBACK_SYMBOL_FONT_FAMILY__", "__THEME_WAYBAR_SYMBOL_FONT_FAMILY__";
  font-weight: __THEME_WAYBAR_FONT_WEIGHT_HEAVY__;
}

#group\/quick-controls #bluetooth {
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_BLUETOOTH_NORMAL_OUTLINE_COLOR__;
  background: __THEME_WAYBAR_BUTTON_BLUETOOTH_NORMAL_BACKGROUND_COLOR__;
}

#group\/quick-controls #bluetooth:hover {
  background: __THEME_WAYBAR_BUTTON_BLUETOOTH_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_WAYBAR_BUTTON_BLUETOOTH_HOVER_OUTLINE_COLOR__;
}

#bluetooth {
  color: __THEME_WAYBAR_BUTTON_BLUETOOTH_ENABLED_ICON_COLOR__;
  font-weight: __THEME_WAYBAR_FONT_WEIGHT_EMPHASIS__;
}

#bluetooth.off {
  color: __THEME_WAYBAR_BUTTON_BLUETOOTH_DISABLED_ICON_COLOR__;
}

#bluetooth.no-controller {
  color: __THEME_WAYBAR_BUTTON_BLUETOOTH_UNAVAILABLE_ICON_COLOR__;
}

#bluetooth.connected {
  color: __THEME_WAYBAR_BUTTON_BLUETOOTH_CONNECTED_ICON_COLOR__;
}

#group\/quick-controls #custom-screenshot {
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_SCREENSHOT_NORMAL_OUTLINE_COLOR__;
  background: __THEME_WAYBAR_BUTTON_SCREENSHOT_NORMAL_BACKGROUND_COLOR__;
}

#group\/quick-controls #custom-screenshot:hover {
  background: __THEME_WAYBAR_BUTTON_SCREENSHOT_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_WAYBAR_BUTTON_SCREENSHOT_HOVER_OUTLINE_COLOR__;
}

#custom-screenshot {
  color: __THEME_WAYBAR_BUTTON_SCREENSHOT_IDLE_ICON_COLOR__;
  font-weight: __THEME_WAYBAR_FONT_WEIGHT_EMPHASIS__;
}

#custom-screenshot.recording {
  color: __THEME_WAYBAR_BUTTON_SCREENSHOT_RECORDING_ICON_COLOR__;
}

#custom-screenshot:not(.recording):hover {
  color: __THEME_WAYBAR_BUTTON_SCREENSHOT_IDLE_HOVER_ICON_COLOR__;
}

#custom-screenshot.recording:hover {
  color: __THEME_WAYBAR_BUTTON_SCREENSHOT_RECORDING_HOVER_ICON_COLOR__;
}

#group\/quick-controls {
  background: __THEME_WAYBAR_QUICK_CONTROLS_CONTAINER_NORMAL_BACKGROUND_COLOR__;
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_QUICK_CONTROLS_CONTAINER_NORMAL_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_QUICK_CONTROLS_CONTAINER_NORMAL_TEXT_COLOR__;
}

#group\/quick-controls #custom-system {
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_SYSTEM_NORMAL_OUTLINE_COLOR__;
  background: __THEME_WAYBAR_BUTTON_SYSTEM_NORMAL_BACKGROUND_COLOR__;
}

#group\/quick-controls #network {
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_NETWORK_NORMAL_OUTLINE_COLOR__;
  background: __THEME_WAYBAR_BUTTON_NETWORK_NORMAL_BACKGROUND_COLOR__;
}

#group\/quick-controls #custom-keyboard {
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_KEYBOARD_NORMAL_OUTLINE_COLOR__;
  background: __THEME_WAYBAR_BUTTON_KEYBOARD_NORMAL_BACKGROUND_COLOR__;
}

#group\/quick-controls #custom-system:hover {
  background: __THEME_WAYBAR_BUTTON_SYSTEM_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_WAYBAR_BUTTON_SYSTEM_HOVER_OUTLINE_COLOR__;
}

#group\/quick-controls #network:hover {
  background: __THEME_WAYBAR_BUTTON_NETWORK_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_WAYBAR_BUTTON_NETWORK_HOVER_OUTLINE_COLOR__;
}

#group\/quick-controls #custom-keyboard:hover {
  background: __THEME_WAYBAR_BUTTON_KEYBOARD_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_WAYBAR_BUTTON_KEYBOARD_HOVER_OUTLINE_COLOR__;
}

#custom-keyboard {
  color: __THEME_WAYBAR_BUTTON_KEYBOARD_US_ENGLISH_ICON_COLOR__;
  font-weight: __THEME_WAYBAR_FONT_WEIGHT_EMPHASIS__;
}

#custom-keyboard.se {
  color: __THEME_WAYBAR_BUTTON_KEYBOARD_SWEDISH_ICON_COLOR__;
}

#network.disconnected {
  color: __THEME_WAYBAR_BUTTON_NETWORK_DISCONNECTED_ICON_COLOR__;
}

#network.disabled {
  color: __THEME_WAYBAR_BUTTON_NETWORK_DISABLED_ICON_COLOR__;
}

#network.wifi {
  color: __THEME_WAYBAR_BUTTON_NETWORK_WIFI_ICON_COLOR__;
}

#network.ethernet {
  color: __THEME_WAYBAR_BUTTON_NETWORK_ETHERNET_ICON_COLOR__;
}

#network.linked {
  color: __THEME_WAYBAR_BUTTON_NETWORK_LINKED_ICON_COLOR__;
}
