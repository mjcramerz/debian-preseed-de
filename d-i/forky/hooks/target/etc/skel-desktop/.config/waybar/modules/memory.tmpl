{
  "memory": {
    "interval": 15,
    "format": "<span foreground='__THEME_WAYBAR_BUTTON_MEMORY_NORMAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_MEMORY_NORMAL_ICON_GLYPH__</span> {percentage}%",
    "format-warning": "<span foreground='__THEME_WAYBAR_BUTTON_MEMORY_WARNING_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_MEMORY_WARNING_ICON_GLYPH__</span> {percentage}%",
    "format-critical": "<span foreground='__THEME_WAYBAR_BUTTON_MEMORY_CRITICAL_ICON_COLOR__'>__THEME_WAYBAR_BUTTON_MEMORY_CRITICAL_ICON_GLYPH__</span> {percentage}%",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
    "on-click": "/usr/local/bin/labwc-terminal -e btop",
    "states": {
      "warning": 75,
      "critical": 90
    }
  }
}
