{
  "ext/workspaces": {
    "format": "{name}",
    "sort-by-name": true,
    "on-click": "activate",
    "active-only": false,
    "all-outputs": true
  },
  "custom/window-switcher": {
    "format": "__THEME_WAYBAR_BUTTON_TASKVIEW_NORMAL_ICON_GLYPH__",
    "align": 0.5,
    "tooltip": true,
    "tooltip-format": "Windows (F13) - select a window; Escape cancels. Alt+Tab: thumbnails",
    "on-click-release": "/usr/local/libexec/labwc-waybar-run -- /usr/local/bin/labwc-window-switcher"
  },
  "custom/wayscriber": {
    "format": " ",
    "align": 0.5,
    "justify": "center",
    "cursor": true,
    "tooltip": true,
    "tooltip-format": "Wayscriber",
    "on-click-release": "/usr/local/libexec/labwc-waybar-run -- /usr/local/bin/labwc-wayscriber-toggle"
  },
  "custom/apps": {
    "format": " ",
    "align": 0.5,
    "justify": "center",
    "tooltip": true,
    "tooltip-format": "Applications"
  },
  "custom/app-terminal": {
    "format": " ",
    "align": 0.5,
    "tooltip": true,
    "tooltip-format": "Foot",
    "on-click": "/usr/local/bin/labwc-terminal"
  },
  "custom/app-files": {
    "format": " ",
    "align": 0.5,
    "tooltip": true,
    "tooltip-format": "Thunar",
    "on-click": "/usr/local/bin/labwc-wayland-app auto -- __INSTALLER_LABWC_FILE_MANAGER_COMMAND__"
  },
  "custom/app-tuta": {
    "format": " ",
    "align": 0.5,
    "tooltip": true,
    "tooltip-format": "Tuta Mail",
    "on-click": "__INSTALLER_LABWC_MANAGED_APP_DEFAULT_EXEC__ tutanota"
  },
  "custom/app-notes": {
    "format": " ",
    "align": 0.5,
    "tooltip": true,
    "tooltip-format": "L3afpad",
    "on-click": "/usr/local/bin/labwc-wayland-app auto -- /usr/bin/l3afpad"
  },
  "custom/app-sleek": {
    "format": " ",
    "align": 0.5,
    "tooltip": true,
    "tooltip-format": "Sleek",
    "on-click": "__INSTALLER_LABWC_MANAGED_APP_DEFAULT_EXEC__ sleek"
  }
}
