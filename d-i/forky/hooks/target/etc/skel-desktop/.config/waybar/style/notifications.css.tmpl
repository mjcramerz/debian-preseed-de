/* Waybar notifications button rules. Native theme values remain editable per mapping. */

#custom-notifications {
  border-style: __THEME_WAYBAR_BORDER_STYLE__;
  border-color: __THEME_WAYBAR_BUTTON_NOTIFICATIONS_NORMAL_OUTLINE_COLOR__;
  background: __THEME_WAYBAR_BUTTON_NOTIFICATIONS_NORMAL_BACKGROUND_COLOR__;
  color: __THEME_WAYBAR_BUTTON_NOTIFICATIONS_NORMAL_ICON_COLOR__;
}

#custom-notifications.dnd {
  color: __THEME_WAYBAR_BUTTON_NOTIFICATIONS_DND_ICON_COLOR__;
}

#custom-notifications:hover {
  background: __THEME_WAYBAR_BUTTON_NOTIFICATIONS_HOVER_BACKGROUND_COLOR__;
  border-color: __THEME_WAYBAR_BUTTON_NOTIFICATIONS_HOVER_OUTLINE_COLOR__;
  color: __THEME_WAYBAR_BUTTON_NOTIFICATIONS_HOVER_ICON_COLOR__;
}

window#waybar.internal #custom-notifications:hover {
  box-shadow: inset __INSTALLER_LABWC_WAYBAR_INTERNAL_INSET_SHADOW__ __THEME_WAYBAR_BUTTON_NOTIFICATIONS_HOVER_SHADOW_COLOR__;
}

window#waybar.external #custom-notifications:hover {
  box-shadow: inset __INSTALLER_LABWC_WAYBAR_EXTERNAL_INSET_SHADOW__ __THEME_WAYBAR_BUTTON_NOTIFICATIONS_HOVER_SHADOW_COLOR__;
}

#custom-notifications.error:not(:hover) {
  color: __THEME_WAYBAR_BUTTON_NOTIFICATIONS_ERROR_ICON_COLOR__;
}

window#waybar.internal #custom-notifications {
  margin: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_MARGIN_Y__px __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_MARGIN_X__px;
  padding: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_INTERNAL_SESSION_BUTTON_PADDING_X__px;
  min-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_SESSION_BUTTON_MIN_WIDTH__px;
  border-radius: __INSTALLER_LABWC_WAYBAR_INTERNAL_CONTROL_RADIUS__px;
  border-width: __INSTALLER_LABWC_WAYBAR_INTERNAL_BORDER_WIDTH__px;
}

window#waybar.external #custom-notifications {
  margin: __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_MARGIN_Y__px __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_MARGIN_X__px;
  padding: __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_PADDING_Y__px __INSTALLER_LABWC_WAYBAR_EXTERNAL_SESSION_BUTTON_PADDING_X__px;
  min-width: __INSTALLER_LABWC_WAYBAR_EXTERNAL_SESSION_BUTTON_MIN_WIDTH__px;
  border-radius: __INSTALLER_LABWC_WAYBAR_EXTERNAL_CONTROL_RADIUS__px;
  border-width: __INSTALLER_LABWC_WAYBAR_EXTERNAL_BORDER_WIDTH__px;
}
