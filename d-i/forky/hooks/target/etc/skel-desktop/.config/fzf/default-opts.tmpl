# fzf defaults consumed by ~/.profile through FZF_DEFAULT_OPTS.
--height=45%
--layout=reverse
--border=rounded
--margin=1
--padding=1,2
--info=inline-right
--prompt=search>
--pointer=>
--marker=+
--cycle
--multi
--ansi
--bind=ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down
--bind=ctrl-a:select-all,ctrl-x:deselect-all
--color=bg+:__THEME_FZF_ITEM_SELECTED_BACKGROUND_COLOR__,bg:__THEME_FZF_ITEM_NORMAL_BACKGROUND_COLOR__,spinner:__THEME_FZF_SPINNER_COLOR__,hl:__THEME_FZF_ITEM_NORMAL_MATCH_TEXT_COLOR__
--color=fg:__THEME_FZF_ITEM_NORMAL_TEXT_COLOR__,header:__THEME_FZF_HEADER_TEXT_COLOR__,info:__THEME_FZF_INFO_TEXT_COLOR__,pointer:__THEME_FZF_POINTER_COLOR__
--color=marker:__THEME_FZF_MARKER_COLOR__,fg+:__THEME_FZF_ITEM_SELECTED_TEXT_COLOR__,prompt:__THEME_FZF_PROMPT_TEXT_COLOR__,hl+:__THEME_FZF_ITEM_SELECTED_MATCH_TEXT_COLOR__
