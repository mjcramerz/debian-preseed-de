# Managed Labwc theme overrides for the default internal display profile.
# Runtime profile switching uses the managed *.internal / *.external variants.
border.width: 2

window.active.border.color: __THEME_LABWC_WINDOW_ACTIVE_BORDER_COLOR__
window.inactive.border.color: __THEME_LABWC_WINDOW_INACTIVE_BORDER_COLOR__
window.active.title.bg: __THEME_LABWC_WINDOW_ACTIVE_TITLE_BACKGROUND_STYLE__
window.active.title.bg.color: __THEME_LABWC_WINDOW_ACTIVE_TITLE_BACKGROUND_COLOR__
window.active.title.bg.colorTo: __THEME_LABWC_WINDOW_ACTIVE_TITLE_GRADIENT_END_COLOR__
window.inactive.title.bg: __THEME_LABWC_WINDOW_INACTIVE_TITLE_BACKGROUND_STYLE__
window.inactive.title.bg.color: __THEME_LABWC_WINDOW_INACTIVE_TITLE_BACKGROUND_COLOR__
window.active.label.text.color: __THEME_LABWC_WINDOW_ACTIVE_LABEL_TEXT_COLOR__
window.inactive.label.text.color: __THEME_LABWC_WINDOW_INACTIVE_LABEL_TEXT_COLOR__
window.label.text.justify: __THEME_LABWC_WINDOW_LABEL_TEXT_ALIGNMENT__
window.button.hover.bg.color: __THEME_LABWC_WINDOW_BUTTON_HOVER_BACKGROUND_COLOR__
window.button.hover.bg.corner-radius: 8
window.active.button.unpressed.image.color: __THEME_LABWC_WINDOW_ACTIVE_BUTTON_UNPRESSED_IMAGE_COLOR__
window.inactive.button.unpressed.image.color: __THEME_LABWC_WINDOW_INACTIVE_BUTTON_UNPRESSED_IMAGE_COLOR__
window.active.shadow.size: 48
window.inactive.shadow.size: 32
window.active.shadow.color: __THEME_LABWC_WINDOW_ACTIVE_SHADOW_COLOR__
window.inactive.shadow.color: __THEME_LABWC_WINDOW_INACTIVE_SHADOW_COLOR__

menu.width.min: 170
menu.width.max: 340
menu.border.width: 1
menu.border.color: __THEME_LABWC_MENU_BORDER_COLOR__
menu.items.padding.x: 6
menu.items.padding.y: 3
menu.items.bg.color: __THEME_LABWC_MENU_ITEM_NORMAL_BACKGROUND_COLOR__
menu.items.text.color: __THEME_LABWC_MENU_ITEM_NORMAL_TEXT_COLOR__
menu.items.active.bg.color: __THEME_LABWC_MENU_ITEM_ACTIVE_BACKGROUND_COLOR__
menu.items.active.text.color: __THEME_LABWC_MENU_ITEM_ACTIVE_TEXT_COLOR__
menu.separator.color: __THEME_LABWC_MENU_SEPARATOR_COLOR__
menu.title.bg.color: __THEME_LABWC_MENU_TITLE_BACKGROUND_COLOR__
menu.title.text.color: __THEME_LABWC_MENU_TITLE_TEXT_COLOR__

osd.bg.color: __THEME_LABWC_TASKVIEW_BACKGROUND_COLOR__
osd.border.color: __THEME_LABWC_TASKVIEW_OUTLINE_COLOR__
osd.border.width: 1
osd.label.text.color: __THEME_LABWC_TASKVIEW_TEXT_COLOR__
osd.window-switcher.preview.border.color: __THEME_LABWC_TASKVIEW_PREVIEW_BORDER_COLORS__

snapping.overlay.region.bg.color: __THEME_LABWC_SNAPPING_OVERLAY_REGION_BACKGROUND_COLOR__
snapping.overlay.edge.bg.color: __THEME_LABWC_SNAPPING_OVERLAY_EDGE_BACKGROUND_COLOR__
snapping.overlay.region.border.color: __THEME_LABWC_SNAPPING_OVERLAY_REGION_BORDER_COLORS__
snapping.overlay.edge.border.color: __THEME_LABWC_SNAPPING_OVERLAY_EDGE_BORDER_COLORS__

# Native thumbnails share the emerald accent; 0x26 alpha is a subtle 15% tint.
osd.window-switcher.style-thumbnail.item.active.border.color: __THEME_LABWC_TASKVIEW_ACTIVE_BORDER_COLOR__
osd.window-switcher.style-thumbnail.item.active.bg.color: __THEME_LABWC_TASKVIEW_ACTIVE_BACKGROUND_COLOR__
# Native thumbnail switcher geometry.
osd.window-switcher.style-thumbnail.width.max: 82%
osd.window-switcher.style-thumbnail.padding: 8
osd.window-switcher.style-thumbnail.item.width: 300
osd.window-switcher.style-thumbnail.item.height: 230
osd.window-switcher.style-thumbnail.item.padding: 6
osd.window-switcher.style-thumbnail.item.active.border.width: 2
osd.window-switcher.style-thumbnail.item.icon.size: 48
osd.window-switcher.preview.border.width: 2
