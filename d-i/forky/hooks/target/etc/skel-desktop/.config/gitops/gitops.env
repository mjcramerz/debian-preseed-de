# Runtime policy: edit here; no reinstall or shell reload is needed.
# Parsed as DATA, never sourced. Exactly these two quoted assignments are allowed.
# Bare names match files/directories at any depth. Patterns with / are rooted.
# A trailing / protects each matching subtree, including directory globs.
# Use canonical paths: no ./, // or dot components; foo/* covers nested paths.
# Protected content AND absence are retained. Empty "" explicitly disables protection.
GITOPS_FORKS_MERGE_PROTECTED="AGENTS.override.md .gitlab-ci.yml .cirrus.yml Makefile justfile .github/* scripts/release/* patches/release/* .mcr/* .circleci/* .devcontainer/* .vscode/* .codex/* .agents/* debian/* .bazelversion .bazelignore .bazelrc bazel/*"
GITOPS_SALSA_MERGE_PROTECTED="AGENTS.override.md .gitlab-ci.yml .cirrus.yml Makefile justfile .github/* scripts/release/* patches/release/* .mcr/* .circleci/* .devcontainer/* .vscode/* .codex/* .agents/* .bazelversion .bazelignore .bazelrc bazel/*"
