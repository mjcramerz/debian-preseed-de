[Unit]
Description=Synchronize Fruux calendar and task collections
ConditionEnvironment=LABWC_SESSION_OWNER=desktop
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_TYPE=wayland
BindsTo=labwc-compositor.service
After=labwc-compositor.service labwc-session.target
ConditionPathExists=%h/.config/vdirsyncer/config
ConditionPathExists=%h/.config/khal/config
ConditionPathExists=%h/.config/todoman/config.py
Requisite=labwc-session.target
PartOf=labwc-session.target

[Service]
KillMode=control-group
Type=oneshot
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_DATA_HOME=%h/.local/share
Environment=XDG_STATE_HOME=%h/.local/state
Environment=XDG_RUNTIME_DIR=%t
ExecStart=/usr/local/libexec/labwc-calendar sync --quiet
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=5min
TimeoutStopSec=10s
