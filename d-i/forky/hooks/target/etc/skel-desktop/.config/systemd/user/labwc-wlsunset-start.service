[Unit]
Description=Validate and start the managed wlsunset transient service
Requisite=labwc-session.target
PartOf=labwc-session.target
After=labwc-session.target labwc-compositor.service

[Service]
Type=oneshot
# Compositor InaccessiblePaths implies a user namespace. Validate host-owned
# policy and the real compositor peer PID outside that namespace, without
# accepting overflow UIDs or relaxing the controller's ownership checks.
PrivateUsers=no
PrivatePIDs=no
ExecStart=/usr/local/bin/labwc-wlsunset start
TimeoutStartSec=60s
TimeoutStopSec=5s
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal
