[Unit]
Description=Desktop session state operation (%i)
Requisite=labwc-session.target
After=labwc-session.target
PartOf=labwc-session.target

[Service]
Type=oneshot
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=/usr/local/libexec/labwc-session-state %i
TimeoutStartSec=285s
# 77 is a verified user/save veto, not permission to continue shutdown.
SuccessExitStatus=77
TimeoutStopSec=5s
KillMode=control-group
UMask=0077
StandardInput=null
StandardOutput=journal
StandardError=journal
