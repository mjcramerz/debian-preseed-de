[Unit]
Description=Publish the firstboot-provisioned Fruux password to Secret Service
Requisite=labwc-session.target
Requires=labwc-kwallet-portal.service
After=labwc-session.target labwc-kwallet-portal.service
PartOf=labwc-session.target labwc-kwallet-portal.service
ConditionEnvironment=LABWC_SESSION_OWNER=desktop
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=120s
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config XDG_DATA_HOME=%h/.local/share
ExecStart=/usr/local/libexec/calix-fruux-bootstrap --install-secret
TimeoutStartSec=60s
TimeoutStopSec=5s
KillMode=control-group
Restart=on-failure
RestartSec=3s
UMask=0077
