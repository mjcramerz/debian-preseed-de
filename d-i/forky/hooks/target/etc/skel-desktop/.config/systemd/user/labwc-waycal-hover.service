[Unit]
Description=Open Waycal when the Waybar clock tooltip appears
Requisite=labwc-session.target
After=labwc-session.target
PartOf=labwc-session.target
ConditionEnvironment=LABWC_SESSION_OWNER=desktop
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
Slice=background.slice
ExecStart=/usr/local/libexec/labwc-waycal-hover
Environment=ATSPI_DISABLE_P2P=1
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=5s
UMask=0077

[Install]
WantedBy=labwc-session.target
