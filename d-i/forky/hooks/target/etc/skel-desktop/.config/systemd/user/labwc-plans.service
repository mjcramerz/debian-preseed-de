[Unit]
ConditionEnvironment=XDG_SESSION_TYPE=wayland
ConditionEnvironment=WAYLAND_DISPLAY
After=labwc-compositor.service labwc-session.target
Description=Deliver Sleek plan and event notifications
Requisite=labwc-session.target
PartOf=labwc-session.target
ConditionEnvironment=LABWC_SESSION_OWNER=desktop
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
KillMode=control-group
Type=exec
# The rendered file is root-owned, group-readable only by the primary desktop
# account group, and parsed by the user manager before the service starts.
# LoadCredential cannot be used as an EnvironmentFile source in a user unit:
# its %d directory is prepared after environment files are loaded.
EnvironmentFile=/etc/labwc/plans.conf
UnsetEnvironment=ALL_PROXY HTTPS_PROXY HTTP_PROXY NO_PROXY all_proxy https_proxy http_proxy no_proxy
ExecStart=/usr/local/libexec/labwc-plans.pl
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StateDirectory=labwc-plans
StateDirectoryMode=0700
# Keep root-owned policy visible in the host UID namespace. In a user manager,
# filesystem/UTS sandboxing implicitly creates a private user namespace whose
# unmapped root owner fails the policy's UID 0 check. AppArmor and the independent
# privilege, syscall and address-family restrictions below still apply.
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=labwc-session.target
