[Unit]
Description=Toggle the Waycal month popup
# This is a manual click action with no automatic restart loop.
StartLimitIntervalSec=0
Requisite=labwc-session.target
After=labwc-session.target
PartOf=labwc-session.target
ConditionEnvironment=LABWC_SESSION_OWNER=desktop
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=oneshot
Slice=background.slice
# A fixed unit serializes clicks without a PID file or a second lock protocol.
ExecStart=/usr/local/libexec/labwc-waycal-toggle
TimeoutStartSec=15s
TimeoutStopSec=3s
KillMode=control-group
UMask=0077
