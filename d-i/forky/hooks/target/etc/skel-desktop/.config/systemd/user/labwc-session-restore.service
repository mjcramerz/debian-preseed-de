[Unit]
Wants=labwc-workspace-broker.service
Description=Restore saved desktop application launchers after session readiness
Requisite=labwc-session.target
After=labwc-session.target labwc-workspace-broker.service
PartOf=labwc-session.target

[Service]
Type=oneshot
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
KillMode=control-group
StandardInput=null
ExecStart=/usr/local/libexec/labwc-session-state restore
TimeoutStartSec=120s
TimeoutStopSec=5s
UMask=0077
StandardOutput=journal
StandardError=journal
