[Unit]
StartLimitBurst=5
StartLimitIntervalSec=60s
After=labwc-compositor.service labwc-session.target labwc-output-watch.service
Description=Highly customizable Wayland bar for Sway and Wlroots based compositors
Documentation=https://github.com/Alexays/Waybar/wiki/
ConditionEnvironment=LABWC_SESSION_OWNER=desktop
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_TYPE=wayland
Requisite=labwc-session.target
PartOf=labwc-session.target

ConditionPathExists=%h/.config/waybar/config
ConditionPathExists=%h/.config/waybar/style.css
ConditionPathExists=%h/.config/waybar/style-common.css
ConditionPathExists=%h/.config/waybar/modules/app-files
ConditionPathExists=%h/.config/waybar/modules/app-notes
ConditionPathExists=%h/.config/waybar/modules/app-sleek
ConditionPathExists=%h/.config/waybar/modules/app-terminal
ConditionPathExists=%h/.config/waybar/modules/app-tuta
ConditionPathExists=%h/.config/waybar/modules/apps
ConditionPathExists=%h/.config/waybar/modules/backlight
ConditionPathExists=%h/.config/waybar/modules/battery
ConditionPathExists=%h/.config/waybar/modules/bluetooth
ConditionPathExists=%h/.config/waybar/modules/clock
ConditionPathExists=%h/.config/waybar/modules/cpu
ConditionPathExists=%h/.config/waybar/modules/disk
ConditionPathExists=%h/.config/waybar/modules/external-apps-drawer
ConditionPathExists=%h/.config/waybar/modules/external-launcher
ConditionPathExists=%h/.config/waybar/modules/external-quick-controls
ConditionPathExists=%h/.config/waybar/modules/external-taskbar
ConditionPathExists=%h/.config/waybar/modules/external-tray
ConditionPathExists=%h/.config/waybar/modules/internal-apps-drawer
ConditionPathExists=%h/.config/waybar/modules/internal-launcher
ConditionPathExists=%h/.config/waybar/modules/internal-quick-controls
ConditionPathExists=%h/.config/waybar/modules/internal-taskbar
ConditionPathExists=%h/.config/waybar/modules/internal-tray
ConditionPathExists=%h/.config/waybar/modules/keyboard
ConditionPathExists=%h/.config/waybar/modules/lock
ConditionPathExists=%h/.config/waybar/modules/memory
ConditionPathExists=%h/.config/waybar/modules/network
ConditionPathExists=%h/.config/waybar/modules/notifications
ConditionPathExists=%h/.config/waybar/modules/power
ConditionPathExists=%h/.config/waybar/modules/pulseaudio
ConditionPathExists=%h/.config/waybar/modules/screenshot
ConditionPathExists=%h/.config/waybar/modules/system
ConditionPathExists=%h/.config/waybar/modules/tomat
ConditionPathExists=%h/.config/waybar/modules/wayscriber
ConditionPathExists=%h/.config/waybar/modules/window-switcher
ConditionPathExists=%h/.config/waybar/modules/workspaces
ConditionPathExists=%h/.config/waybar/gtk/audio-menu.xml
ConditionPathExists=%h/.config/waybar/gtk/bluetooth-menu.xml
ConditionPathExists=%h/.config/waybar/gtk/calendar-menu.xml
ConditionPathExists=%h/.config/waybar/gtk/notifications-menu.xml
ConditionPathExists=%h/.config/waybar/gtk/power-menu.xml
ConditionPathExists=%h/.config/waybar/gtk/screenshot-menu.xml
ConditionPathExists=%h/.config/waybar/gtk/system-menu.xml
ConditionPathExists=%h/.config/waybar/gtk/tomat-menu.xml
ConditionPathExists=%h/.config/waybar/style/menu.css
ConditionPathExists=%h/.config/waybar/style/gtk.css
ConditionPathExists=%h/.config/waybar/style/workspaces.css
ConditionPathExists=%h/.config/waybar/style/tomat.css
ConditionPathExists=%h/.config/waybar/style/wayscriber.css
ConditionPathExists=%h/.config/waybar/style/taskview.css
ConditionPathExists=%h/.config/waybar/style/apps.css
ConditionPathExists=%h/.config/waybar/style/clock.css
ConditionPathExists=%h/.config/waybar/style/audio.css
ConditionPathExists=%h/.config/waybar/style/brightness.css
ConditionPathExists=%h/.config/waybar/style/battery.css
ConditionPathExists=%h/.config/waybar/style/storage.css
ConditionPathExists=%h/.config/waybar/style/cpu.css
ConditionPathExists=%h/.config/waybar/style/memory.css
ConditionPathExists=%h/.config/waybar/style/tray.css
ConditionPathExists=%h/.config/waybar/style/system.css
ConditionPathExists=%h/.config/waybar/style/notifications.css
ConditionPathExists=%h/.config/waybar/style/lock.css
ConditionPathExists=%h/.config/waybar/style/power.css
[Service]
RestartSec=3s
TimeoutStopSec=10s
TimeoutStartSec=30s
KillMode=control-group
Type=exec
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Waybar callbacks receive only the session variables they need. Do not allow
# loader, Python, GTK/GIO module, or X11 injection variables from the login
# environment to alter the managed Wayland panel or its helper transitions.
UnsetEnvironment=LD_PRELOAD LD_AUDIT LD_LIBRARY_PATH PYTHONPATH PYTHONHOME GI_TYPELIB_PATH GIO_MODULE_DIR GTK_MODULES DISPLAY XAUTHORITY
ExecCondition=/usr/local/libexec/labwc-session-check session-ready
ExecStart=/usr/bin/waybar -c %h/.config/waybar/config -s %h/.config/waybar/style.css
ExecReload=/usr/local/libexec/labwc-session-check reload-waybar $MAINPID
Restart=on-failure
SyslogIdentifier=waybar
StandardOutput=journal
StandardError=journal
