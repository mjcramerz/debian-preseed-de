[Unit]
StartLimitBurst=5
StartLimitIntervalSec=60s
After=labwc-compositor.service labwc-session.target labwc-output-watch.service
Description=Highly customizable Wayland bar for Sway and Wlroots based compositors
Documentation=https://github.com/Alexays/Waybar/wiki/
ConditionEnvironment=LABWC_SESSION_OWNER=desktop
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_TYPE=wayland
Requisite=labwc-session.target
PartOf=labwc-session.target

ConditionPathExists=%h/.config/waybar/config
ConditionPathExists=%h/.config/waybar/style.css
ConditionPathExists=%h/.config/waybar/style-common.css
ConditionPathExists=%h/.config/waybar/actions/config-core
ConditionPathExists=%h/.config/waybar/actions/status-menu
ConditionPathExists=%h/.config/waybar/actions/audio-menu
ConditionPathExists=%h/.config/waybar/actions/bluetooth-menu
ConditionPathExists=%h/.config/waybar/actions/calendar-menu
ConditionPathExists=%h/.config/waybar/actions/notifications-menu
ConditionPathExists=%h/.config/waybar/actions/power-menu
ConditionPathExists=%h/.config/waybar/actions/screenshot-menu
ConditionPathExists=%h/.config/waybar/actions/system-menu
ConditionPathExists=%h/.config/waybar/actions/tomat-menu
ConditionPathExists=%h/.config/waybar/actions/layout-internal
ConditionPathExists=%h/.config/waybar/actions/layout-external
ConditionPathExists=%h/.config/waybar/menus/audio-menu.xml
ConditionPathExists=%h/.config/waybar/menus/bluetooth-menu.xml
ConditionPathExists=%h/.config/waybar/menus/calendar-menu.xml
ConditionPathExists=%h/.config/waybar/menus/notifications-menu.xml
ConditionPathExists=%h/.config/waybar/menus/power-menu.xml
ConditionPathExists=%h/.config/waybar/menus/screenshot-menu.xml
ConditionPathExists=%h/.config/waybar/menus/system-menu.xml
ConditionPathExists=%h/.config/waybar/menus/tomat-menu.xml
ConditionPathExists=%h/.config/waybar/menus/menu.css
ConditionPathExists=%h/.config/waybar/buttons/menu.css
ConditionPathExists=%h/.config/waybar/buttons/workspaces.css
ConditionPathExists=%h/.config/waybar/buttons/tomat.css
ConditionPathExists=%h/.config/waybar/buttons/wayscriber.css
ConditionPathExists=%h/.config/waybar/buttons/taskview.css
ConditionPathExists=%h/.config/waybar/buttons/apps.css
ConditionPathExists=%h/.config/waybar/buttons/clock.css
ConditionPathExists=%h/.config/waybar/buttons/audio.css
ConditionPathExists=%h/.config/waybar/buttons/brightness.css
ConditionPathExists=%h/.config/waybar/buttons/battery.css
ConditionPathExists=%h/.config/waybar/buttons/storage.css
ConditionPathExists=%h/.config/waybar/buttons/cpu.css
ConditionPathExists=%h/.config/waybar/buttons/memory.css
ConditionPathExists=%h/.config/waybar/buttons/tray.css
ConditionPathExists=%h/.config/waybar/buttons/system.css
ConditionPathExists=%h/.config/waybar/buttons/notifications.css
ConditionPathExists=%h/.config/waybar/buttons/lock.css
ConditionPathExists=%h/.config/waybar/buttons/power.css

[Service]
RestartSec=3s
TimeoutStopSec=10s
TimeoutStartSec=30s
KillMode=control-group
Type=exec
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Waybar callbacks receive only the session variables they need. Do not allow
# loader, Python, GTK/GIO module, or X11 injection variables from the login
# environment to alter the managed Wayland panel or its helper transitions.
UnsetEnvironment=LD_PRELOAD LD_AUDIT LD_LIBRARY_PATH PYTHONPATH PYTHONHOME GI_TYPELIB_PATH GIO_MODULE_DIR GTK_MODULES DISPLAY XAUTHORITY
ExecCondition=/usr/local/libexec/labwc-session-check session-ready
ExecStart=/usr/bin/waybar -c %h/.config/waybar/config -s %h/.config/waybar/style.css
ExecReload=/usr/local/libexec/labwc-session-check reload-waybar $MAINPID
Restart=on-failure
SyslogIdentifier=waybar
StandardOutput=journal
StandardError=journal
