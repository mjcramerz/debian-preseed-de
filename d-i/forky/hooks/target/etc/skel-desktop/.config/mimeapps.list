[Default Applications]
# File management
inode/directory=thunar.desktop;
application/x-directory=thunar.desktop;
x-directory/normal=thunar.desktop;
x-scheme-handler/file=thunar.desktop;

# Web content. Vivaldi is preferred; Chromium and Edge are ordered fallbacks.
text/html=vivaldi-stable.desktop;chromium.desktop;microsoft-edge.desktop;
application/xhtml+xml=vivaldi-stable.desktop;chromium.desktop;microsoft-edge.desktop;
application/x-extension-htm=vivaldi-stable.desktop;chromium.desktop;microsoft-edge.desktop;
application/x-extension-html=vivaldi-stable.desktop;chromium.desktop;microsoft-edge.desktop;
application/x-mimearchive=vivaldi-stable.desktop;chromium.desktop;microsoft-edge.desktop;
image/svg+xml=vivaldi-stable.desktop;chromium.desktop;microsoft-edge.desktop;
x-scheme-handler/http=vivaldi-stable.desktop;chromium.desktop;microsoft-edge.desktop;
x-scheme-handler/https=vivaldi-stable.desktop;chromium.desktop;microsoft-edge.desktop;
x-scheme-handler/about=vivaldi-stable.desktop;chromium.desktop;microsoft-edge.desktop;
x-scheme-handler/unknown=vivaldi-stable.desktop;chromium.desktop;microsoft-edge.desktop;

# Mail
x-scheme-handler/mailto=tutanota-desktop.desktop;
x-scheme-handler/tuta=tutanota-desktop.desktop;

# PDF and handwritten notes
application/pdf=org.pwmt.zathura.desktop;com.github.xournalpp.xournalpp.desktop;
application/x-xoj=com.github.xournalpp.xournalpp.desktop;
application/x-xojpp=com.github.xournalpp.xournalpp.desktop;
application/x-xopp=com.github.xournalpp.xournalpp.desktop;
application/x-xopt=com.github.xournalpp.xournalpp.desktop;

# Images supported by qimgv
image/jpeg=qimgv.desktop;
image/png=qimgv.desktop;
image/gif=qimgv.desktop;
image/bmp=qimgv.desktop;
image/x-bmp=qimgv.desktop;
image/webp=qimgv.desktop;

