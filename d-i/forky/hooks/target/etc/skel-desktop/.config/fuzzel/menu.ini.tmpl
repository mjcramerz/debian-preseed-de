[main]
include=~/.config/fuzzel/base.ini
prompt="Menu ❯ "
icons-enabled=yes
show-actions=no

[dmenu]
exit-immediately-if-empty=yes

# labwc-fuzzel consumes custom-1's status and discards its printed selection.
# Win+Backspace goes back; Escape and Ctrl+C close the entire menu workflow.
[key-bindings]
custom-1=Mod4+BackSpace
