[main]
font=Noto Sans:size=__INSTALLER_LABWC_FUZZEL_FONT_SIZE__,Noto Color Emoji:size=__INSTALLER_LABWC_FUZZEL_FONT_SIZE__,Font Awesome 6 Free:size=__INSTALLER_LABWC_FUZZEL_FONT_SIZE__
use-bold=yes
dpi-aware=auto
terminal=/usr/local/bin/labwc-terminal
placeholder=Type to search
icon-theme=__INSTALLER_LABWC_ICON_THEME__
icons-enabled=yes
fields=filename,name,generic,keywords,comment,categories
match-mode=fzf
filter-desktop=yes
show-actions=yes
horizontal-pad=__INSTALLER_LABWC_FUZZEL_HORIZONTAL_PAD__
vertical-pad=__INSTALLER_LABWC_FUZZEL_VERTICAL_PAD__
inner-pad=__INSTALLER_LABWC_FUZZEL_INNER_PAD__
line-height=__INSTALLER_LABWC_FUZZEL_LINE_HEIGHT__
layer=overlay

[colors]
background=08111ff8
text=f5efe3ff
prompt=ecb860ff
placeholder=aeb7c6ff
input=ffffffff
match=ecb860ff
selection=f29f67ff
selection-text=08111fff
selection-match=08111fff
counter=9fd2bfff
border=ecb860bb

[border]
width=2
radius=14
