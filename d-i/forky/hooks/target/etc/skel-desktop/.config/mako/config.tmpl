[mode=do-not-disturb]
invisible=1

# Keep each mail action distinct; grouping identical summaries can conceal the
# message whose callback the user intends to invoke. Tuta remains the handler.
[desktop-entry=tutanota-desktop]
group-by=none

[app-name="Tuta Mail"]
group-by=none

[app-name=tutanota-desktop]
group-by=none
