anchor=top-right
layer=overlay
font=__THEME_MAKO_TEXT_FONT_FAMILY__ 11
width=420
height=320
outer-margin=14,14,0,14
margin=8
padding=12,14
border-size=2
border-radius=14
icons=1
max-icon-size=48
icon-path=__THEME_MAKO_ICON_SEARCH_PATH__
icon-border-radius=8
markup=1
actions=1
history=1
max-history=100
max-visible=5
group-by=summary,app-name,urgency
sort=-time
format=<b>%s</b>\n%b\n<small>%a</small>
default-timeout=8000
ignore-timeout=0
background-color=__THEME_MAKO_BACKGROUND_COLOR__
text-color=__THEME_MAKO_TEXT_COLOR__
border-color=__THEME_MAKO_BORDER_COLOR__
progress-color=__THEME_MAKO_PROGRESS_COLOR__
on-button-left=invoke-default-action
on-button-middle=dismiss --no-history
on-button-right=dismiss
on-touch=invoke-default-action

[grouped]
format=<b>%s</b>\n%b\n<small>%a</small>\n<small>%g notifications</small>

[hidden]
format=<b>%h hidden</b> (%t total)
border-color=__THEME_MAKO_HIDDEN_BORDER_COLOR__
progress-color=__THEME_MAKO_HIDDEN_PROGRESS_COLOR__

[actionable]
border-color=__THEME_MAKO_ACTIONABLE_BORDER_COLOR__

[urgency=low]
background-color=__THEME_MAKO_URGENCY_LOW_BACKGROUND_COLOR__
border-color=__THEME_MAKO_URGENCY_LOW_BORDER_COLOR__
default-timeout=5000
history=0

[urgency=normal]
background-color=__THEME_MAKO_URGENCY_NORMAL_BACKGROUND_COLOR__
border-color=__THEME_MAKO_URGENCY_NORMAL_BORDER_COLOR__
default-timeout=12000

[urgency=critical]
background-color=__THEME_MAKO_URGENCY_CRITICAL_BACKGROUND_COLOR__
text-color=__THEME_MAKO_URGENCY_CRITICAL_TEXT_COLOR__
border-color=__THEME_MAKO_URGENCY_CRITICAL_BORDER_COLOR__
progress-color=__THEME_MAKO_URGENCY_CRITICAL_PROGRESS_COLOR__
default-timeout=0

[app-name="Desktop Health"]
default-timeout=12000
border-color=__THEME_MAKO_DESKTOP_HEALTH_BORDER_COLOR__

[app-name="Desktop Health" category=email.arrived]
border-color=__THEME_MAKO_DESKTOP_HEALTH_EMAIL_ARRIVED_BORDER_COLOR__
progress-color=__THEME_MAKO_DESKTOP_HEALTH_EMAIL_ARRIVED_PROGRESS_COLOR__

[app-name="Timeshift" category=system.backup]
