  "signin": {
    "allowed": true
  },
  "spellcheck": {
    "use_spelling_service": false
  },
  "translate": {
    "enabled": true
  },
  "vivaldi": {
    "address_bar": {
      "omnibox": {
        "show_sync_tabs": true
      }
    },
    "bookmarks": {
      "bar": {
        "visible": true
      }
    },
    "mail": {
      "notifications": false
    },
    "panels": {
      "lazy_load": true
    },
    "privacy": {
      "ad_blocker": {
        "enable_document_blocking": true
      },
      "google_component_extensions": {
        "hangout_services": false,
        "web_store": false
      }
    },
    "tabs": {
      "always_load_pinned_after_restore": false,
      "defer_loading_after_restore": true,
      "thumbnails": false,
      "tooltip": false,
      "unread": false
    },
    "theme": {
      "use_animation": false
    },
    "webpages": {
      "smooth_scrolling": false
    }
  },
  "webkit": {
    "webprefs": {
      "force_dark_mode_enabled": false
    }
  }
