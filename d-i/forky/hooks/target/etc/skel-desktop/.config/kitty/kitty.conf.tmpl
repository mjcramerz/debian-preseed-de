font_family __INSTALLER_LABWC_TERMINAL_FONT_FAMILY__
font_size __INSTALLER_LABWC_TERMINAL_FONT_SIZE__
# Consistent private-use category/action icons in the management terminal.
symbol_map U+F000-U+F8FF __THEME_KITTY_NERD_FONT_FAMILY__
allow_remote_control socket-only
listen_on unix:${XDG_RUNTIME_DIR}/kitty-labwc
adjust_line_height 0
cursor_shape beam
cursor_blink_interval 0.55
scrollback_lines 10000
wheel_scroll_multiplier 3.0
enable_audio_bell no
confirm_os_window_close 0
remember_window_size no
initial_window_width __INSTALLER_LABWC_TERMINAL_WINDOW_COLUMNS__c
initial_window_height __INSTALLER_LABWC_TERMINAL_WINDOW_ROWS__c
window_padding_width 4
background_opacity __INSTALLER_LABWC_TERMINAL_BACKGROUND_OPACITY__
linux_display_server wayland

foreground __THEME_KITTY_FOREGROUND_COLOR__
background __THEME_KITTY_BACKGROUND_COLOR__
selection_foreground __THEME_KITTY_SELECTION_FOREGROUND_COLOR__
selection_background __THEME_KITTY_SELECTION_BACKGROUND_COLOR__
color0 __THEME_KITTY_ANSI_NORMAL_BLACK_COLOR__
color1 __THEME_KITTY_ANSI_NORMAL_RED_COLOR__
color2 __THEME_KITTY_ANSI_NORMAL_GREEN_COLOR__
color3 __THEME_KITTY_ANSI_NORMAL_YELLOW_COLOR__
color4 __THEME_KITTY_ANSI_NORMAL_BLUE_COLOR__
color5 __THEME_KITTY_ANSI_NORMAL_MAGENTA_COLOR__
color6 __THEME_KITTY_ANSI_NORMAL_CYAN_COLOR__
color7 __THEME_KITTY_ANSI_NORMAL_WHITE_COLOR__
color8 __THEME_KITTY_ANSI_BRIGHT_BLACK_COLOR__
color9 __THEME_KITTY_ANSI_BRIGHT_RED_COLOR__
color10 __THEME_KITTY_ANSI_BRIGHT_GREEN_COLOR__
color11 __THEME_KITTY_ANSI_BRIGHT_YELLOW_COLOR__
color12 __THEME_KITTY_ANSI_BRIGHT_BLUE_COLOR__
color13 __THEME_KITTY_ANSI_BRIGHT_MAGENTA_COLOR__
color14 __THEME_KITTY_ANSI_BRIGHT_CYAN_COLOR__
color15 __THEME_KITTY_ANSI_BRIGHT_WHITE_COLOR__
