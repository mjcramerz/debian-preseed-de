## Managed nano defaults for unattended desktop installations.

## Editing behavior.
set afterends
set atblanks
set autoindent
set colonparsing
set constantshow
set historylog
set indicator
set linenumbers
set locking
set mouse
set multibuffer
set positionlog
set smarthome
set softwrap
set stateflags
set tabsize 4
set tabstospaces
set trimblanks
set unix
set zap

## Load every syntax collection shipped by Debian's nano package.  The first
## include covers the standard programming, markup, shell, and configuration
## syntaxes.  The nested includes add Debian-specific and extra definitions.
include "/usr/share/nano/*.nanorc"
include "/usr/share/nano/debian/*.nanorc"
include "/usr/share/nano/extra/*.nanorc"
