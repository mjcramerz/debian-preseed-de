[Unit]
Description=Locked devops rootless Podman API service
Documentation=man:podman-system-service(1)
Requires=podman-devops.socket
After=podman-devops.socket
RequiresMountsFor=/pool/podman /run/podman-devops
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
User=devops
Group=devops
Environment=HOME=/nonexistent
Environment=XDG_CONFIG_HOME=/run/podman-devops/config
Environment=XDG_DATA_HOME=/pool/podman/xdg-data
Environment=XDG_CACHE_HOME=/pool/podman/xdg-cache
Environment=XDG_RUNTIME_DIR=/run/podman-devops
Environment=CONTAINERS_CONF=/etc/podman-devops/server/containers/containers.conf
Environment=CONTAINERS_STORAGE_CONF=/etc/podman-devops/server/containers/storage.conf
Environment=TMPDIR=/pool/podman/tmp
UnsetEnvironment=DBUS_SESSION_BUS_ADDRESS CONTAINER_HOST CONTAINER_CONNECTION CONTAINER_SSHKEY DOCKER_HOST DOCKER_CONTEXT CONTAINERS_CONF_OVERRIDE
RuntimeDirectory=podman-devops
RuntimeDirectoryMode=0710
RuntimeDirectoryPreserve=yes
WorkingDirectory=/pool/podman/workspace
ExecStartPre=+/usr/local/libexec/podman-devops-host verify-start
ExecStartPre=/usr/bin/install -d -m 0700 /run/podman-devops/containers /run/podman-devops/libpod/tmp /run/podman-devops/config /run/podman-devops/config/containers
ExecStartPre=/usr/bin/install -m 0600 /etc/podman-devops/server/containers/registries.conf /run/podman-devops/config/containers/registries.conf
ExecStart=/usr/bin/podman --log-level=info system service --time=0
Delegate=yes
KillMode=process
KillSignal=SIGTERM
TimeoutStartSec=90s
TimeoutStopSec=30s
Restart=on-failure
RestartSec=3s
UMask=0077
ProtectHome=yes
LimitNOFILE=65536
CPUWeight=@CPU_WEIGHT@
IOWeight=@IO_WEIGHT@
TasksMax=@TASKS_MAX@
MemoryHigh=@MEMORY_HIGH@
MemoryMax=@MEMORY_MAX@
StandardOutput=journal
StandardError=journal
SyslogIdentifier=podman-devops
# Rootless newuidmap/newgidmap require normal set-ID execution. Do not add
# NoNewPrivileges, PrivateUsers, RestrictSUIDSGID, or an empty capability set.
