def _path_components_are_safe(value: str) -> bool:
    if not value.startswith("/") or value == "/":
        return False
    if any(character not in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._/@+-" for character in value):
        return False
    components = value.split("/")[1:]
    return bool(components) and all(component not in {"", ".", ".."} for component in components)


def codex_require_abs_path(label: str, value: str) -> None:
    if not _path_components_are_safe(value):
        codex_die(f"{label} is not a safe absolute path: {value or 'unset'}")


def _validated_managed_path_entries(label: str, value: str) -> tuple[str, ...]:
    if not value:
        codex_die(f"{label} is empty")
    entries = tuple(value.split(":"))
    if len(entries) > MAX_MANAGED_PATH_ENTRIES:
        codex_die(f"{label} exceeds {MAX_MANAGED_PATH_ENTRIES} entries")
    if len(set(entries)) != len(entries):
        codex_die(f"{label} contains duplicate entries")
    for entry in entries:
        if not _path_components_are_safe(entry):
            codex_die(f"{label} contains an unsafe entry")
    return entries


def codex_require_inherited_devops_path(
    inherited_path: str,
    managed_path: str,
) -> None:
    inherited_entries = _validated_managed_path_entries(
        "inherited DevOps PATH", inherited_path
    )
    managed_entries = _validated_managed_path_entries(
        "reconstructed managed DevOps PATH", managed_path
    )
    if any(entry not in inherited_entries for entry in managed_entries):
        codex_die("the inherited DevOps PATH omits managed profile entries")


def codex_require_directory(label: str, value: str) -> None:
    codex_require_abs_path(label, value)
    if os.path.islink(value) or not os.path.isdir(value):
        codex_die(f"{label} is missing or is not a real directory: {value}")


def codex_require_executable(label: str, value: str) -> None:
    codex_require_abs_path(label, value)
    if os.path.islink(value) or not os.path.isfile(value) or not os.access(value, os.X_OK):
        codex_die(f"{label} is missing, indirect, or not executable: {value}")


def _read_bounded_text(path: str, maximum_bytes: int, label: str) -> str:
    try:
        with open(path, "rb") as handle:
            data = handle.read(maximum_bytes + 1)
    except OSError as exc:
        codex_die(f"cannot read {label}: {exc}")
    if len(data) > maximum_bytes:
        codex_die(f"{label} exceeds {maximum_bytes} bytes")
    try:
        return data.decode("ascii").strip()
    except UnicodeDecodeError:
        codex_die(f"{label} is not ASCII")


def codex_require_user_namespace_support() -> None:
    clone_policy_path = "/proc/sys/kernel/unprivileged_userns_clone"
    if os.path.exists(clone_policy_path):
        clone_policy = _read_bounded_text(clone_policy_path, 32, "user namespace policy")
        if clone_policy != "1":
            codex_die(
                "unprivileged user namespaces are disabled; "
                "the managed Codex sysctl policy is not active"
            )
    namespace_limit_path = "/proc/sys/user/max_user_namespaces"
    if not os.path.isfile(namespace_limit_path):
        codex_die("the kernel does not expose user.max_user_namespaces")
    namespace_limit = _read_bounded_text(
        namespace_limit_path,
        32,
        "user.max_user_namespaces",
    )
    if not namespace_limit.isdecimal() or int(namespace_limit) <= 0:
        codex_die("user.max_user_namespaces must be greater than zero")


def codex_generate_uuid() -> str:
    value = _read_bounded_text(
        "/proc/sys/kernel/random/uuid",
        64,
        "runtime identifier",
    )
    if UUID_RE.fullmatch(value) is None:
        codex_die("unable to generate a runtime identifier")
    return value


def codex_parse_arguments(arguments: Sequence[str]) -> tuple[bool, list[str]]:
    global CODEX_APP_SERVER_MODE, CODEX_ARGS, CODEX_USE_BWRAP
    CODEX_USE_BWRAP = True
    CODEX_ARGS = []
    for argument in arguments:
        if argument == "--no-bwrap":
            CODEX_USE_BWRAP = False
        else:
            CODEX_ARGS.append(argument)
    CODEX_APP_SERVER_MODE = tuple(CODEX_ARGS) == CODEX_APP_SERVER_ARGUMENTS
    if CODEX_APP_SERVER_MODE and not CODEX_USE_BWRAP:
        codex_die("the managed app-server service requires Bubblewrap isolation")
    return CODEX_USE_BWRAP, [*CODEX_ARGS]


def _app_server_secret_environment_name_is_safe(name: str) -> bool:
    if APP_SERVER_SECRET_ENV_NAME_RE.fullmatch(name) is None:
        return False
    if (
        name in SHELL_CONTROL_ENV_NAMES
        or name in SANDBOX_UNSET_ENV_NAMES
        or name in CODEX_AUTHORITATIVE_ENV_NAMES
        or name in PROFILE_IGNORED_ENV_NAMES
        or name in {"PATH", "CREDENTIALS_DIRECTORY", CODEX_APP_SERVER_SECRET_ENV_NAMES_VARIABLE}
    ):
        return False
    return not name.startswith(
        (
            "BASH_FUNC_",
            "DYLD_",
            "GCONV_",
            "LD_",
            "MALLOC_",
            "PERL",
            "PYTHON",
            "RUBY",
        )
    )


def codex_capture_app_server_environment() -> dict[str, str]:
    global CODEX_APP_SERVER_ENVIRONMENT
    CODEX_APP_SERVER_ENVIRONMENT = {}
    policy = os.environ.pop(CODEX_APP_SERVER_SECRET_ENV_NAMES_VARIABLE, "")
    if not CODEX_APP_SERVER_MODE:
        if policy:
            codex_die(
                "app-server secret environment policy requires the managed app-server invocation"
            )
        return {}
    try:
        policy_bytes = policy.encode("ascii")
    except UnicodeEncodeError:
        codex_die("app-server secret environment policy must be ASCII")
    if len(policy_bytes) > MAX_APP_SERVER_SECRET_ENV_NAME_POLICY_BYTES:
        codex_die("app-server secret environment policy exceeds 8 KiB")
    if not policy:
        return {}

    names = policy.split(":")
    if len(names) > MAX_APP_SERVER_SECRET_ENV_NAMES:
        codex_die("app-server secret environment policy exceeds 64 names")
    if any(not name for name in names):
        codex_die("app-server secret environment policy contains an empty name")
    if len(set(names)) != len(names):
        codex_die("app-server secret environment policy contains duplicate names")

    total_bytes = 0
    captured: dict[str, str] = {}
    for name in names:
        if not _app_server_secret_environment_name_is_safe(name):
            codex_die(f"app-server secret environment name is unsafe: {name}")
        value = os.environ.pop(name, None)
        if value in {None, ""}:
            continue
        if "\r" in value or "\n" in value:
            codex_die(
                f"app-server secret environment value contains a line break: {name}"
            )
        try:
            value_bytes = value.encode("utf-8")
        except UnicodeEncodeError:
            codex_die(
                f"app-server secret environment value is not valid UTF-8: {name}"
            )
        if len(value_bytes) > MAX_APP_SERVER_SECRET_VALUE_BYTES:
            codex_die(
                f"app-server secret environment value exceeds 64 KiB: {name}"
            )
        total_bytes += len(value_bytes)
        if total_bytes > MAX_APP_SERVER_SECRET_ENVIRONMENT_BYTES:
            codex_die("app-server secret environment exceeds 256 KiB")
        captured[name] = value

    CODEX_APP_SERVER_ENVIRONMENT = captured
    return dict(captured)


def codex_capture_auth_credential() -> None:
    """Open systemd's per-service credential copy before cleaning the environment.

    Passing a read-only fd to --ro-bind-data avoids a second user/mount namespace
    in the user unit (which can lose supplementary devops group mappings).
    Neither the credential value nor its source pathname is passed to Codex.
    """
    global CODEX_AUTH_FD
    if not CODEX_APP_SERVER_MODE:
        return
    directory = os.environ.get("CREDENTIALS_DIRECTORY", "")
    expected = f"/run/user/{os.getuid()}/credentials/codex-app-server.service"
    if directory != expected or os.path.realpath(directory) != directory:
        codex_die("app-server requires its systemd user-service credential directory")
    directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    descriptor: int | None = None
    try:
        directory_stat = os.fstat(directory_fd)
        if directory_stat.st_uid != os.getuid() or directory_stat.st_mode & 0o022:
            codex_die("app-server credential directory is not private account state")
        descriptor = os.open(
            "codex-auth.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=directory_fd,
        )
        metadata = os.fstat(descriptor)
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
                or metadata.st_mode & 0o077 or metadata.st_size > MAX_AUTH_CREDENTIAL_BYTES):
            codex_die("app-server auth credential must be a private, bounded regular file")
        data = os.read(descriptor, MAX_AUTH_CREDENTIAL_BYTES + 1)
        if len(data) > MAX_AUTH_CREDENTIAL_BYTES:
            codex_die("app-server auth credential exceeds 1 MiB")
        try:
            credential = json.loads(data)
        except (ValueError, UnicodeDecodeError):
            codex_die("app-server auth credential is not valid JSON")
        if not isinstance(credential, dict):
            codex_die("app-server auth credential must be a JSON object")
        os.lseek(descriptor, 0, os.SEEK_SET)
        CODEX_AUTH_FD = descriptor
        descriptor = None
    finally:
        os.close(directory_fd)
        if descriptor is not None:
            os.close(descriptor)


def codex_restore_app_server_environment() -> None:
    for name, value in CODEX_APP_SERVER_ENVIRONMENT.items():
        if name in os.environ:
            codex_die(
                f"app-server secret environment collides with managed profile policy: {name}"
            )
        os.environ[name] = value


def codex_clear_app_server_environment() -> None:
    global CODEX_APP_SERVER_ENVIRONMENT
    for name in CODEX_APP_SERVER_ENVIRONMENT:
        os.environ.pop(name, None)
    CODEX_APP_SERVER_ENVIRONMENT = {}


def _same_file_if_present(first: str, second: str) -> bool:
    try:
        return os.path.exists(first) and os.path.exists(second) and os.path.samefile(first, second)
    except OSError:
        return False


def codex_sanitize_path(raw_path: str | None = None) -> str:
    global CODEX_SANDBOX_PATH
    source = raw_path if raw_path is not None else os.environ.get(
        "PATH", "/usr/local/bin:/usr/bin:/bin"
    )
    entries: list[str] = []
    for entry in source.split(":"):
        if not entry.startswith("/") or entry in {
            CODEX_WRAPPER_DIRECTORY,
            CODEX_RELEASE_BINARY_DIRECTORY,
        }:
            continue
        if _same_file_if_present(entry, CODEX_WRAPPER_DIRECTORY) or _same_file_if_present(
            entry, CODEX_RELEASE_BINARY_DIRECTORY
        ):
            continue
        if not _path_components_are_safe(entry) or entry in entries:
            continue
        entries.append(entry)
    if not entries:
        entries = ["/usr/local/bin", "/usr/bin", "/bin"]
    entries.append(CODEX_RELEASE_BINARY_DIRECTORY)
    CODEX_SANDBOX_PATH = ":".join(entries)
    os.environ["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"
    return CODEX_SANDBOX_PATH


def _access(path: str, mode: int) -> bool:
    try:
        return os.access(path, mode, effective_ids=True)
    except TypeError:
        return os.access(path, mode)


def codex_require_account_owned_searchable_directory(label: str, path: str) -> None:
    codex_require_directory(label, path)
    if os.path.realpath(path) != path:
        codex_die(f"{label} must not traverse symlinks: {path}")
    metadata = os.stat(path, follow_symlinks=False)
    if metadata.st_uid != os.getuid():
        codex_die(f"{label} must remain owned by the invoking account")
    if not _access(path, os.X_OK):
        codex_die(f"{label} must remain searchable by the invoking account")


def codex_require_account_owned_readable_directory(label: str, path: str) -> None:
    codex_require_account_owned_searchable_directory(label, path)
    mode = stat.S_IMODE(os.stat(path, follow_symlinks=False).st_mode)
    if mode & 0o022:
        codex_die(f"{label} must not be writable by group or other")
    if not _access(path, os.R_OK):
        codex_die(f"{label} must remain readable by the invoking account")


def codex_require_account_owned_directory(label: str, path: str) -> None:
    codex_require_account_owned_readable_directory(label, path)
    if not _access(path, os.W_OK):
        codex_die(f"{label} must remain writable by the invoking account")


def codex_require_account_owned_home_directory(label: str, path: str) -> None:
    codex_require_account_owned_searchable_directory(label, path)
    if not _access(path, os.R_OK | os.W_OK):
        codex_die(f"{label} must remain readable and writable by the invoking account")


def codex_require_private_account_directory(label: str, path: str) -> None:
    codex_require_account_owned_directory(label, path)
    mode = stat.S_IMODE(os.stat(path, follow_symlinks=False).st_mode)
    if mode != 0o700:
        codex_die(f"{label} must remain mode 0700")


def _group_name(group_id: int) -> str:
    try:
        return grp.getgrgid(group_id).gr_name
    except KeyError:
        return str(group_id)


def codex_require_managed_directory(
    label: str,
    path: str,
    expected_owner: int,
    expected_group: str,
    expected_mode: int,
    require_write: bool = True,
) -> None:
    if not isinstance(expected_owner, int) or isinstance(expected_owner, bool) or expected_owner < 0:
        codex_die(f"{label} expected owner is malformed")
    if SAFE_USER_RE.fullmatch(expected_group) is None:
        codex_die(f"{label} expected group is malformed")
    if not isinstance(expected_mode, int) or isinstance(expected_mode, bool) or not 0 <= expected_mode <= 0o7777:
        codex_die(f"{label} expected mode is malformed")
    if not isinstance(require_write, bool):
        codex_die(f"{label} write requirement is malformed")
    codex_require_directory(label, path)
    if os.path.realpath(path) != path:
        codex_die(f"{label} must not traverse symlinks: {path}")
    metadata = os.stat(path, follow_symlinks=False)
    actual_group = _group_name(metadata.st_gid)
    actual_mode = stat.S_IMODE(metadata.st_mode)
    if (
        metadata.st_uid != expected_owner
        or actual_group != expected_group
        or actual_mode != expected_mode
    ):
        codex_die(
            f"{label} must remain owner {expected_owner}, group {expected_group}, "
            f"and mode {expected_mode:o}: {path}"
        )
    if not _access(path, os.R_OK | os.X_OK):
        codex_die(f"{label} must remain readable and searchable: {path}")
    if require_write and not _access(path, os.W_OK):
        codex_die(f"{label} must remain writable by the invoking account: {path}")


def codex_require_devops_shared_account_directory(label: str, path: str) -> None:
    codex_require_managed_directory(
        label,
        path,
        os.getuid(),
        CODEX_DEVOPS_GROUP,
        0o2770,
        True,
    )


def _parse_profile_environment(data: bytes) -> dict[str, str]:
    if len(data) > MAX_PROFILE_ENVIRONMENT_BYTES:
        codex_die("managed DevOps environment exceeds the 256 KiB limit")
    records = data.split(b"\0")
    if records and records[-1] == b"":
        records.pop()
    if len(records) > MAX_PROFILE_ENVIRONMENT_VARIABLES:
        codex_die("managed DevOps environment exceeds 256 variables")
    parsed: dict[str, str] = {}
    for raw_record in records:
        if b"=" not in raw_record:
            codex_die("managed DevOps environment contains a malformed record")
        raw_name, raw_value = raw_record.split(b"=", 1)
        try:
            name = raw_name.decode("ascii")
            value = raw_value.decode("utf-8", "surrogateescape")
        except UnicodeDecodeError:
            codex_die("managed DevOps environment contains an unsafe variable name")
        if SAFE_NAME_RE.fullmatch(name) is None:
            codex_die("managed DevOps environment contains an unsafe variable name")
        if name in parsed:
            codex_die("managed DevOps environment contains a duplicate variable")
        parsed[name] = value
    return parsed


