    except OSError as exc:
        fatal(f"cannot read process capabilities: {{exc}}")
    if len(payload) > MAX_STATUS_BYTES:
        fatal("process capability status exceeds 64 KiB")
    fields: dict[str, int] = {{}}
    for raw_line in payload.splitlines():
        if b":" not in raw_line:
            continue
        raw_name, raw_value = raw_line.split(b":", 1)
        try:
            name = raw_name.decode("ascii")
        except UnicodeDecodeError:
            continue
        if name not in {{"CapInh", "CapPrm", "CapEff", "CapBnd", "CapAmb"}}:
            continue
        try:
            fields[name] = int(raw_value.strip(), 16)
        except ValueError:
            fatal(f"process capability field is malformed: {{name}}")
    required = {{"CapInh", "CapPrm", "CapEff", "CapBnd", "CapAmb"}}
    if set(fields) != required:
        fatal("process capability status is incomplete")
    return fields


def validate_outer_capabilities() -> None:
    fields = capability_fields()
    for name in ("CapInh", "CapPrm", "CapEff", "CapAmb"):
        if fields[name] != 0:
            fatal(f"outer payload retains active capabilities: {{name}}")
    # New user namespaces establish their own capability set. Do not infer
    # namespace support from the parent's CapBnd; exercise it below instead.
    with open(PROCESS_STATUS_PATH, encoding="ascii") as status:
        if not any(line.split() == ["NoNewPrivs:", "1"] for line in status):
            fatal("Bubblewrap did not set no_new_privs")


def nested_bubblewrap_probe() -> None:
    try:
        descriptor, marker = tempfile.mkstemp(prefix=".codex-nested-bwrap-", dir="/tmp")
        os.close(descriptor)
    except OSError as exc:
        fatal(f"cannot create nested Bubblewrap probe marker: {{exc}}")

    probe = (
        "from pathlib import Path; import sys; "
        "hidden=Path(sys.argv[1]); "
        "assert not hidden.exists(); "
        "target=Path('/tmp/work/tool-write'); "
        "target.write_bytes(b'ok'); "
        "assert target.read_bytes() == b'ok'; "
        "assert Path('/proc/self/status').is_file(); "
        "assert Path('/proc/self/fd').is_dir()"
    )
    command = [
        BWRAP_BINARY,
        "--die-with-parent",
        "--new-session",
        "--unshare-user",
        "--unshare-pid",
        "--unshare-uts",
        "--unshare-ipc",
        "--unshare-net",
        "--uid",
        str(os.getuid()),
        "--gid",
        str(os.getgid()),
        "--ro-bind",
        "/",
        "/",
        "--proc",
        "/proc",
        "--tmpfs",
        "/tmp",
        "--perms",
        "0700",
        "--dir",
        "/tmp/work",
        "--chdir",
        "/tmp/work",
        "--cap-drop",
        "ALL",
        "--",
        "/usr/bin/python3",
        "-I",
        "-c",
        probe,
        marker,
    ]
    if command.count("--unshare-user") != 1 or command.count("--unshare-pid") != 1:
        fatal("nested Bubblewrap probe namespace policy is malformed")
    proc_indexes = [index for index, value in enumerate(command) if value == "--proc"]
    if len(proc_indexes) != 1 or command[proc_indexes[0] + 1] != "/proc":
        fatal("nested Bubblewrap probe procfs policy is malformed")
    try:
        completed = subprocess.run(
            command,
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            timeout=10,
        )
    except subprocess.TimeoutExpired:
        fatal("nested Bubblewrap probe timed out")
    except OSError as exc:
        fatal(f"cannot execute nested Bubblewrap probe: {{exc}}")
    finally:
        try:
            os.unlink(marker)
        except FileNotFoundError:
            pass
        except OSError as exc:
            fatal(f"cannot remove nested Bubblewrap probe marker: {{exc}}")
    if completed.returncode != 0:
        diagnostic = completed.stderr[:MAX_DIAGNOSTIC_BYTES].decode(
            "utf-8", "replace"
        ).replace("\\n", " ").replace("\\r", " ").strip()
        if len(completed.stderr) > MAX_DIAGNOSTIC_BYTES:
            diagnostic += " [truncated]"
        fatal(
            "nested Bubblewrap probe failed "
            f"(status {{completed.returncode}}): {{diagnostic or 'no diagnostic'}}"
        )


def main(arguments: list[str]) -> int:
    if not arguments:
        fatal("raw Codex executable argument is missing")
    validate_outer_capabilities()
    nested_bubblewrap_probe()
    raw_binary = arguments[0]
    os.execve(raw_binary, [raw_binary, *arguments[1:]], dict(os.environ))
    return 1


