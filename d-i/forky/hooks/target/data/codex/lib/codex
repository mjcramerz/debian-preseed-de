def codex_parse_sandbox_pid(info: bytes | str) -> int:
    try:
        document = json.loads(info)
    except (json.JSONDecodeError, TypeError, UnicodeDecodeError):
        codex_die("Bubblewrap returned malformed sandbox process information")
    sandbox_pid = document.get("child-pid") if isinstance(document, dict) else None
    if (not isinstance(sandbox_pid, int) or isinstance(sandbox_pid, bool)
            or not 1 < sandbox_pid <= 2_147_483_647):
        codex_die("Bubblewrap did not report a valid sandbox process id")
    return sandbox_pid


def _pid_alive(process_id: int | None) -> bool:
    if process_id is None:
        return False
    try:
        os.kill(process_id, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _read_json_fd(fd: int, process: subprocess.Popen[bytes]) -> bytes:
    deadline = time.monotonic() + NETWORK_SETUP_TIMEOUT_SECONDS
    data = bytearray()
    os.set_blocking(fd, False)
    while time.monotonic() < deadline:
        if len(data) > MAX_BWRAP_INFO_BYTES:
            codex_die("Bubblewrap process information exceeds the 16 KiB limit")
        try:
            json.loads(data.decode("utf-8"))
            return bytes(data)
        except (json.JSONDecodeError, UnicodeDecodeError):
            pass
        if len(data) > MAX_BWRAP_INFO_BYTES:
            codex_die("Bubblewrap process information exceeds the 16 KiB limit")
        remaining = max(0.0, deadline - time.monotonic())
        readable, _, _ = select.select((fd,), (), (), min(0.1, remaining))
        if readable:
            chunk = os.read(fd, 4096)
            if not chunk:
                break
            data.extend(chunk)
        elif process.poll() is not None:
            break
    if len(data) > MAX_BWRAP_INFO_BYTES:
        codex_die("Bubblewrap process information exceeds the 16 KiB limit")
    return bytes(data)


def _read_ready_byte(fd: int, deadline_seconds: float) -> bytes:
    deadline = time.monotonic() + deadline_seconds
    while time.monotonic() < deadline:
        readable, _, _ = select.select((fd,), (), (), min(0.1, deadline - time.monotonic()))
        if readable:
            return os.read(fd, 1)
        if CODEX_BWRAP_PROCESS is not None and CODEX_BWRAP_PROCESS.poll() is not None:
            return b""
        if CODEX_SLIRP_PROCESS is not None and CODEX_SLIRP_PROCESS.poll() is not None:
            return b""
    return b""


def _close_fd(fd: int | None) -> None:
    if fd is None:
        return
    try:
        os.close(fd)
    except OSError:
        pass


def _terminate_process(process: subprocess.Popen[bytes] | None) -> None:
    if process is None or process.poll() is not None:
        return
    try:
        process.terminate()
    except ProcessLookupError:
        pass
    try:
        process.wait(timeout=PROCESS_STOP_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        try:
            process.kill()
        except ProcessLookupError:
            pass
        try:
            process.wait(timeout=PROCESS_STOP_TIMEOUT_SECONDS)
        except subprocess.TimeoutExpired:
            print("warning: child did not exit after SIGKILL; service cgroup cleanup is required", file=sys.stderr)


def _signal_sandbox(signum: int) -> None:
    # The pinned handle cannot target a recycled PID during delayed cleanup.
    if CODEX_SANDBOX_PIDFD is not None:
        try:
            signal.pidfd_send_signal(CODEX_SANDBOX_PIDFD, signum)
        except (ProcessLookupError, PermissionError):
            pass  # The supervising Popen process is still stopped below.


def codex_cleanup() -> None:
    global CODEX_AUTH_FD, CODEX_BWRAP_PROCESS, CODEX_CONTROL_DIR, CODEX_SANDBOX_PID, CODEX_SANDBOX_PIDFD, CODEX_SLIRP_PROCESS, CODEX_SIGNALLED
    # A signal arriving during normal finally cleanup must not interrupt teardown.
    CODEX_SIGNALLED = True
    _close_fd(CODEX_AUTH_FD)
    CODEX_AUTH_FD = None
    codex_clear_app_server_environment()
    _signal_sandbox(signal.SIGTERM)
    _terminate_process(CODEX_BWRAP_PROCESS)
    _terminate_process(CODEX_SLIRP_PROCESS)
    _signal_sandbox(signal.SIGKILL)
    _close_fd(CODEX_SANDBOX_PIDFD)
    CODEX_SANDBOX_PIDFD = None
    CODEX_BWRAP_PROCESS = None
    CODEX_SANDBOX_PID = None
    CODEX_SLIRP_PROCESS = None
    if CODEX_CONTROL_DIR:
        control_dir = CODEX_CONTROL_DIR
        CODEX_CONTROL_DIR = ""
        if os.path.isdir(control_dir) and not os.path.islink(control_dir):
            try:
                shutil.rmtree(control_dir)
            except OSError as exc:
                print(f"warning: cannot remove Codex control state: {exc}", file=sys.stderr)


def codex_handle_signal(signum: int, _frame: object = None) -> None:
    global CODEX_SIGNALLED
    if CODEX_SIGNALLED:
        return  # Let the first signal unwind through the bounded cleanup once.
    CODEX_SIGNALLED = True
    _signal_sandbox(signum)
    if CODEX_BWRAP_PROCESS is not None and CODEX_BWRAP_PROCESS.poll() is None:
        try:
            CODEX_BWRAP_PROCESS.send_signal(signum)
        except ProcessLookupError:
            pass
    raise SystemExit(128 + signum)


def codex_run_sandboxed() -> int:
    global CODEX_AUTH_FD, CODEX_BWRAP_PROCESS, CODEX_SANDBOX_PID, CODEX_SANDBOX_PIDFD, CODEX_SLIRP_PROCESS
    uid = os.getuid()
    gid = os.getgid()
    codex_prepare_control_state()
    codex_prepare_identity_files(uid, gid)
    command = codex_build_bwrap_args(uid, gid)
    info_read = info_write = block_read = block_write = None
    ready_read = ready_write = exit_read = exit_write = None
    stdout_handle = stderr_handle = None
    try:
        info_read, info_write = os.pipe()
        block_read, block_write = os.pipe()
        bwrap_command = [
            *command,
            "--info-fd",
            str(info_write),
            "--block-fd",
            str(block_read),
            "--",
            "/usr/bin/python3",
            "-I",
            "/run/codex-synthetic-bin/payload-launcher.py",
            CODEX_RAW_BINARY,
            *CODEX_ARGS,
        ]
        CODEX_BWRAP_PROCESS = subprocess.Popen(
            bwrap_command,
            close_fds=True,
            pass_fds=(info_write, block_read, *((CODEX_AUTH_FD,) if CODEX_AUTH_FD is not None else ())),
        )
        # systemd has already decoded daemon credentials into the service
        # environment. Bubblewrap inherits that sanitized environment without
        # putting secret values in argv; the supervising wrapper drops its copy
        # immediately after the child has started.
        codex_clear_app_server_environment()
        _close_fd(CODEX_AUTH_FD)
        CODEX_AUTH_FD = None
        _close_fd(info_write)
        info_write = None
        _close_fd(block_read)
        block_read = None
        info = _read_json_fd(info_read, CODEX_BWRAP_PROCESS)
        try:
            CODEX_SANDBOX_PID = codex_parse_sandbox_pid(info)
        except CodexError:
            if CODEX_BWRAP_PROCESS.poll() is not None:
                status = CODEX_BWRAP_PROCESS.returncode
                codex_die(
                    "Bubblewrap exited before reporting a sandbox process id "
                    f"(status {status})"
                )
            raise
        if CODEX_BWRAP_PROCESS.poll() is not None or not _pid_alive(CODEX_SANDBOX_PID):
            status = CODEX_BWRAP_PROCESS.wait()
            codex_die(f"Bubblewrap exited during sandbox setup (status {status})")

        # The child is blocked on block_write until namespace networking is ready.
        # Pin it while it is still supervised, before any cleanup signal is sent.
        CODEX_SANDBOX_PIDFD = os.pidfd_open(CODEX_SANDBOX_PID)
        ready_read, ready_write = os.pipe()
        exit_read, exit_write = os.pipe()
        stdout_handle = open(f"{CODEX_CONTROL_DIR}/slirp.stdout", "xb")
        stderr_handle = open(f"{CODEX_CONTROL_DIR}/slirp.stderr", "xb")
        CODEX_SLIRP_PROCESS = subprocess.Popen(
            [
                SLIRP4NETNS_BINARY,
                "--configure",
                f"--mtu={SLIRP4NETNS_MTU}",
                "--disable-host-loopback",
                "--ready-fd",
                str(ready_write),
                "--exit-fd",
                str(exit_read),
                str(CODEX_SANDBOX_PID),
                SLIRP4NETNS_TAP_NAME,
            ],
            close_fds=True,
            pass_fds=(ready_write, exit_read),
            stdout=stdout_handle,
            stderr=stderr_handle,
        )
        _close_fd(ready_write)
        ready_write = None
        _close_fd(exit_read)
        exit_read = None
        ready = _read_ready_byte(ready_read, NETWORK_SETUP_TIMEOUT_SECONDS)
        if ready != b"1":
            if CODEX_BWRAP_PROCESS.poll() is not None:
                codex_die(
                    "Bubblewrap exited before network setup completed "
                    f"(status {CODEX_BWRAP_PROCESS.returncode})"
                )
            if CODEX_SLIRP_PROCESS.poll() is not None:
                codex_die(
                    "slirp4netns exited before configuring the isolated network "
                    f"namespace (status {CODEX_SLIRP_PROCESS.returncode})"
                )
            codex_die("slirp4netns timed out while configuring the isolated network namespace")
        os.write(block_write, b"1")
        _close_fd(block_write)
        block_write = None
        _close_fd(info_read)
        info_read = None
        _close_fd(ready_read)
        ready_read = None
        while True:
            try:
                bwrap_status = CODEX_BWRAP_PROCESS.wait(timeout=0.5)
                break
            except subprocess.TimeoutExpired:
                if CODEX_SLIRP_PROCESS.poll() is not None:
                    codex_die(f"isolated network helper exited (status {CODEX_SLIRP_PROCESS.returncode})")
        CODEX_BWRAP_PROCESS = None
        CODEX_SANDBOX_PID = None
        _close_fd(CODEX_SANDBOX_PIDFD)
        CODEX_SANDBOX_PIDFD = None
        _close_fd(exit_write)
        exit_write = None
        try:
            CODEX_SLIRP_PROCESS.wait(timeout=PROCESS_STOP_TIMEOUT_SECONDS)
        except subprocess.TimeoutExpired:
            _terminate_process(CODEX_SLIRP_PROCESS)
        CODEX_SLIRP_PROCESS = None
        return bwrap_status if bwrap_status >= 0 else 128 - bwrap_status
    finally:
        for descriptor in (
            info_read,
            info_write,
            block_read,
            block_write,
            ready_read,
            ready_write,
            exit_read,
            exit_write,
        ):
            _close_fd(descriptor)
        if stdout_handle is not None:
            stdout_handle.close()
        if stderr_handle is not None:
            stderr_handle.close()


def _exec_raw_codex() -> NoReturn:
    for name in AMBIENT_X11_ENV_NAMES:
        os.environ.pop(name, None)
    os.environ["PATH"] = CODEX_SANDBOX_PATH
    os.execve(CODEX_RAW_BINARY, [CODEX_RAW_BINARY, *CODEX_ARGS], dict(os.environ))


def main(arguments: Sequence[str]) -> int:
    if os.getuid() == 0 or os.geteuid() != os.getuid():
        codex_die("run Codex as the managed unprivileged account, not root/setuid")
    codex_parse_arguments(arguments)
    codex_capture_app_server_environment()
    codex_capture_auth_credential()
    codex_prepare_environment()
    codex_restore_app_server_environment()
    codex_require_executable("raw Codex binary", CODEX_RAW_BINARY)
    codex_require_managed_work_areas()
    codex_require_devops_shared_account_directory("Codex log directory", CODEX_LOG_ROOT)
    codex_require_devops_shared_account_directory("Codex SQLite directory", CODEX_SQLITE_ROOT)
    codex_prepare_repository_metadata()
    codex_prepare_memory_guard()
    if not CODEX_USE_BWRAP:
        codex_warn("--no-bwrap explicitly disables host-identity and runtime mount isolation")
        _exec_raw_codex()
    codex_require_devops_shared_account_directory(
        "managed Codex host log directory", CODEX_HOST_LOG_ROOT
    )
    codex_require_executable("Bubblewrap", BWRAP_BINARY)
    codex_require_executable("slirp4netns", SLIRP4NETNS_BINARY)
    codex_require_user_namespace_support()
    for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGQUIT, signal.SIGTERM):
        signal.signal(signum, codex_handle_signal)
    try:
        return codex_run_sandboxed()
    finally:
        codex_cleanup()


def _entrypoint() -> int:
    os.umask(0o077)
    try:
        return main(sys.argv[1:])
    except CodexError as exc:
        codex_cleanup()
        print(f"codex-wrapper: fatal: {exc}", file=sys.stderr)
        return 1
    except OSError as exc:
        codex_cleanup()
        print(f"codex-wrapper: fatal: operating-system error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(_entrypoint())
