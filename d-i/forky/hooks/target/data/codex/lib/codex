def codex_require_managed_profile(
    profile_directory: str,
    filename: str,
    *,
    required: bool,
) -> str | None:
    if filename not in MANAGED_PROFILE_FILENAMES:
        codex_die("managed profile filename is not approved")
    path = f"{profile_directory}/{filename}"
    codex_require_abs_path(f"managed profile {filename}", path)
    if not os.path.lexists(path):
        if required:
            codex_die(f"required managed profile is missing: {path}")
        return None
    if os.path.islink(path) or not os.path.isfile(path):
        codex_die(f"managed profile is not a direct regular file: {path}")
    if os.path.realpath(path) != path:
        codex_die(f"managed profile must not traverse symlinks: {path}")
    metadata = os.stat(path, follow_symlinks=False)
    mode = stat.S_IMODE(metadata.st_mode)
    if metadata.st_uid != os.getuid():
        codex_die(f"managed profile must remain owned by the invoking account: {path}")
    if metadata.st_nlink != 1:
        codex_die(f"managed profile must remain single-link: {path}")
    if mode & 0o022:
        codex_die(f"managed profile must not be writable by group or other: {path}")
    if metadata.st_size > MAX_PROFILE_ENVIRONMENT_BYTES:
        codex_die(f"managed profile exceeds the 256 KiB source limit: {path}")
    if not _access(path, os.R_OK):
        codex_die(f"managed profile must remain readable by the invoking account: {path}")
    return path


def codex_discover_managed_profiles(home: str) -> tuple[str, str | None, str | None]:
    profile_directory = f"{home}/.profile.d"
    codex_require_account_owned_readable_directory(
        "managed profile directory", profile_directory
    )
    devops_profile = codex_require_managed_profile(
        profile_directory, MANAGED_PROFILE_FILENAMES[0], required=True
    )
    assert devops_profile is not None
    incus_profile = codex_require_managed_profile(
        profile_directory, MANAGED_PROFILE_FILENAMES[1], required=False
    )
    firmware_profile = codex_require_managed_profile(
        profile_directory, MANAGED_PROFILE_FILENAMES[2], required=False
    )
    return devops_profile, incus_profile, firmware_profile


def _profile_shell_arguments(
    profile_paths: tuple[str, str | None, str | None],
) -> list[str]:
    return [path if path is not None else "-" for path in profile_paths]


def _run_profile_shell(
    script: str,
    profile_paths: tuple[str, str | None, str | None],
    environment: dict[str, str],
) -> bytes:
    try:
        completed = subprocess.run(
            [
                PROFILE_SHELL,
                "-eu",
                "-c",
                script,
                "codex-managed-environment",
                *_profile_shell_arguments(profile_paths),
            ],
            check=False,
            env=environment,
            stdout=subprocess.PIPE,
            timeout=15,
        )
    except subprocess.TimeoutExpired:
        codex_die("managed profile environment activation timed out")
    except OSError as exc:
        codex_die(f"cannot execute the managed profile shell: {exc}")
    if completed.returncode != 0:
        codex_die("managed profile environment activation failed")
    return completed.stdout


def _present_environment_names(names: Iterable[str]) -> set[str]:
    return {name for name in names if name in os.environ}


def codex_validate_optional_profile_state(
    profile_paths: tuple[str, str | None, str | None],
) -> dict[str, str]:
    _devops_profile, incus_profile, firmware_profile = profile_paths
    incus_present = _present_environment_names(INCUS_ENV_NAMES)
    if incus_profile is None:
        if incus_present:
            codex_die("inherited Incus variables exist without the managed Incus profile")
    elif incus_present:
        if incus_present != set(INCUS_ENV_NAMES):
            codex_die("the inherited Incus environment is partial")
        if os.environ.get("INCUS_MANAGED_ENVIRONMENT_READY") != "1":
            codex_die("the inherited Incus environment marker is malformed")

    firmware_present = _present_environment_names(FIRMWARE_ENV_NAMES)
    if firmware_profile is None:
        if firmware_present:
            codex_die(
                "inherited firmware variables exist without the managed firmware profile"
            )
        return {}
    if not firmware_present:
        return {}
    if firmware_present != set(FIRMWARE_ENV_NAMES):
        codex_die("the inherited firmware environment is partial")
    if (
        os.environ.get("FWOPS_ACTIVE") != "1"
        or os.environ.get("FWOPS_ENVIRONMENT_READY") != "1"
    ):
        codex_die("the inherited firmware environment marker is malformed")
    _run_profile_shell(_FIRMWARE_VALIDATE_SCRIPT, profile_paths, dict(os.environ))
    return {name: os.environ[name] for name in FIRMWARE_ENV_NAMES}


def _managed_environment_names(snapshot: dict[str, str]) -> list[str]:
    selected: list[str] = []
    for name in snapshot:
        if name in PROFILE_IGNORED_ENV_NAMES or name == "PATH":
            continue
        if name in SHELL_CONTROL_ENV_NAMES:
            codex_die("managed profile environment exports a shell-control variable")
        if name in CODEX_AUTHORITATIVE_ENV_NAMES:
            continue
        selected.append(name)
    return selected


def codex_collect_devops_environment(
    profile_paths: tuple[str, str | None, str | None],
    clean_snapshot: dict[str, str],
    *,
    preserve_path: str | None,
) -> list[str]:
    global CODEX_DEVOPS_ENV_NAMES
    selected = _managed_environment_names(clean_snapshot)
    if preserve_path is not None:
        for name in selected:
            if os.environ.get(name) != clean_snapshot[name]:
                codex_die(
                    f"inherited managed profile environment differs from policy: {name}"
                )
        _run_profile_shell(_PROFILE_VALIDATE_SCRIPT, profile_paths, dict(os.environ))
        codex_require_inherited_devops_path(
            preserve_path, clean_snapshot["PATH"]
        )

    replacement = dict(clean_snapshot)
    if preserve_path is not None:
        replacement["PATH"] = preserve_path
    os.environ.clear()
    os.environ.update(replacement)
    CODEX_DEVOPS_ENV_NAMES = selected
    return [*selected]


def codex_activate_devops_environment() -> None:
    try:
        actual_user = pwd.getpwuid(os.getuid()).pw_name
    except KeyError:
        codex_die("cannot resolve the invoking account name")
    requested_user = os.environ.get("USER", "")
    if SAFE_USER_RE.fullmatch(requested_user) is None or requested_user in {".", ".."}:
        codex_die("the invoking account name is unsafe")
    if requested_user != actual_user:
        codex_die("USER does not match the invoking account")
    if os.environ.get("LOGNAME", requested_user) != actual_user:
        codex_die("LOGNAME does not match the invoking account")
    home = os.environ.get("HOME", "")
    codex_require_abs_path("HOME", home)
    codex_require_account_owned_home_directory("HOME", home)
    profile_paths = codex_discover_managed_profiles(home)
    firmware_environment = codex_validate_optional_profile_state(profile_paths)

    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", "")
    codex_require_private_account_directory("current user runtime directory", runtime_dir)
    clean_environment = {
        "HOME": home,
        "USER": actual_user,
        "LOGNAME": actual_user,
        "XDG_RUNTIME_DIR": runtime_dir,
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    }
    clean_environment.update(firmware_environment)
    clean_snapshot = _parse_profile_environment(
        _run_profile_shell(_PROFILE_APPLY_SCRIPT, profile_paths, clean_environment)
    )
    if (
        clean_snapshot.get("DEVOPS_DE_ACTIVE") != "1"
        or clean_snapshot.get("DEVOPS_DE_ENVIRONMENT_READY") != "1"
        or not clean_snapshot.get("PATH")
    ):
        codex_die("managed DevOps environment reconstruction is incomplete")
    if profile_paths[1] is not None and any(
        clean_snapshot.get(name, "") == "" for name in INCUS_ENV_NAMES
    ):
        codex_die("managed Incus environment reconstruction is incomplete")
    if firmware_environment and any(
        clean_snapshot.get(name, "") == "" for name in FIRMWARE_ENV_NAMES
    ):
        codex_die("managed firmware environment reconstruction is incomplete")

    marker_names = ("DEVOPS_DE_ACTIVE", "DEVOPS_DE_ENVIRONMENT_READY")
    marker_presence = tuple(name in os.environ for name in marker_names)
    marker_values = tuple(os.environ.get(name, "") for name in marker_names)
    if marker_presence == (False, False):
        preserved_path = None
    elif marker_presence == (True, True) and marker_values == ("1", "1"):
        preserved_path = os.environ.get("PATH", "")
        if not preserved_path:
            codex_die("the inherited DevOps PATH is empty")
    else:
        codex_die("the inherited DevOps environment is incomplete")
    codex_collect_devops_environment(
        profile_paths,
        clean_snapshot,
        preserve_path=preserved_path,
    )


