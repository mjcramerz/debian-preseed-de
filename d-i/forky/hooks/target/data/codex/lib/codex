    proc_indexes = [index for index, value in enumerate(arguments) if value == "--proc"]
    if len(proc_indexes) != 1:
        codex_die("Codex Bubblewrap must declare exactly one private procfs mount")
    index = proc_indexes[0]
    if index + 1 >= len(arguments) or arguments[index + 1] != "/proc":
        codex_die("Codex Bubblewrap private procfs must be mounted at /proc")
    # Every /proc pathname apart from the proc mount itself would be an
    # accidental overmount (or host bind) in this argument builder.
    for position, value in enumerate(arguments):
        if value.startswith("/proc/") or (value == "/proc" and position != index + 1):
            codex_die("Codex Bubblewrap must not bind or mask the private procfs")


