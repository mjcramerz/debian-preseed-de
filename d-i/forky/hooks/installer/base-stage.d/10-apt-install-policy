#!/bin/sh
# Base-installer hook: enforce no-Recommends/no-Suggests before any target APT
# transaction can occur. Apt-setup stages the same authoritative policy again.
set -eu

TARGET=${INSTALLER_TARGET_DIR:-/target}
POLICY_SOURCE=${INSTALLER_APT_INSTALL_POLICY_SOURCE:-/tmp/install-env/99noinstall-recommends}
POLICY_RELATIVE_PATH=/etc/apt/apt.conf.d/99noinstall-recommends
POLICY_TARGET="${TARGET}${POLICY_RELATIVE_PATH}"
POLICY_TMP="${POLICY_TARGET}.tmp.$$"

apt_install_policy_fatal() {
  printf '[base-installer:apt-install-policy] fatal: %s\n' "$*" >&2
  exit 1
}

case "$TARGET" in
  /*) ;;
  *) apt_install_policy_fatal "installer target must be an absolute path: ${TARGET:-unset}" ;;
esac
[ "$TARGET" != / ] ||
  apt_install_policy_fatal "refusing to stage target APT policy into the installer root"

[ -d "$TARGET" ] || exit 0
[ -f "$POLICY_SOURCE" ] && [ -r "$POLICY_SOURCE" ] && [ ! -L "$POLICY_SOURCE" ] ||
  apt_install_policy_fatal "authoritative APT install policy is missing or unsafe: $POLICY_SOURCE"
grep -Fqx 'APT::Install-Recommends "false";' "$POLICY_SOURCE" ||
  apt_install_policy_fatal "authoritative APT policy does not disable Recommends"
grep -Fqx 'APT::Install-Suggests "false";' "$POLICY_SOURCE" ||
  apt_install_policy_fatal "authoritative APT policy does not disable Suggests"

install -d -m 0755 "$(dirname "$POLICY_TARGET")"
trap 'rm -f "$POLICY_TMP"' EXIT HUP INT TERM
install -m 0644 "$POLICY_SOURCE" "$POLICY_TMP"
mv "$POLICY_TMP" "$POLICY_TARGET"
trap - EXIT HUP INT TERM

printf '[base-installer:apt-install-policy] installed %s before target package selection\n' \
  "$POLICY_RELATIVE_PATH" >&2
