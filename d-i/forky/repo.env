# Repository policy and path contract. Paths are relative to d-i/forky.
REPOSITORY_ROLE="desktop"
REPOSITORY_NAME="debian-preseed-de"
DEBIAN_APT_PREFERENCES="forky,trixie,sid,experimental,cramerz,dbus,x11,vulkan"
DEBIAN_DEFAULT_CLASSES="prod;desktop;standard;static;software;timeshift;podman;crowdsec;whisper;btrfs-de"

DIR_HOSTS_PROFILES="hosts/profiles"
DIR_HOSTS_INSTALLER="hosts/installer"
DIR_HOOKS_INSTALLER="hooks/installer"
DIR_HOOKS_TARGET="hooks/target"
DIR_HOOKS_INSTALLER_APT_SETUP_GENERATORS="hooks/installer/apt-setup/generators"
DIR_HOOKS_INSTALLER_BASE_STAGE_D="hooks/installer/base-stage.d"
DIR_HOOKS_INSTALLER_D_I="hooks/installer/d-i"
DIR_HOOKS_INSTALLER_FINISH_INSTALL_D="hooks/installer/finish-install.d"
DIR_HOOKS_INSTALLER_PARTMAN="hooks/installer/partman"
DIR_HOOKS_INSTALLER_PARTMAN_FINISH_D="hooks/installer/partman/finish.d"
DIR_HOOKS_INSTALLER_PRE_PKGSEL_D="hooks/installer/pre-pkgsel.d"
DIR_SCRIPTS_COMMON="scripts/common"
DIR_SCRIPTS_EARLY="scripts/early"
DIR_SCRIPTS_FIRSTBOOT="scripts/firstboot"
DIR_SCRIPTS_LATE="scripts/late"
DIR_SCRIPTS_PARTMAN="scripts/partman"
DIR_SCRIPTS_PRESEED="scripts/preseed"
DIR_SCRIPTS_RUNTIME="scripts/runtime"
DIR_SCRIPTS_DESKTOP="scripts/desktop"
