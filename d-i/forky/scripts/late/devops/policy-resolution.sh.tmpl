  devops_validate_relative_path "DEVOPS_OSC_STATE_SUBDIR" "$DEVOPS_OSC_STATE_SUBDIR"
  devops_validate_relative_path "DEVOPS_OSC_CACHE_SUBDIR" "$DEVOPS_OSC_CACHE_SUBDIR"
