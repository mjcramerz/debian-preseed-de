  : "${DEVOPS_OBS_PROJECT:?DEVOPS_OBS_PROJECT must be set before DevOps provisioning}"
  : "${DEVOPS_OBS_REPOSITORY:?DEVOPS_OBS_REPOSITORY must be set before DevOps provisioning}"
