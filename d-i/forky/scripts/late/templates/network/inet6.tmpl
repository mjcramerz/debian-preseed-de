
iface __INSTALLER_IFACE__ inet6 static
    pre-up /usr/sbin/sysctl -q -w net/ipv6/conf/__INSTALLER_IFACE__/ignore_routes_with_linkdown=1
    pre-up /usr/sbin/sysctl -q -w net/ipv6/conf/__INSTALLER_IFACE__/keep_addr_on_down=1
    address __INSTALLER_ADDRESS__
    netmask __INSTALLER_NETMASK__
    gateway __INSTALLER_GATEWAY__
    dns-nameservers __INSTALLER_DNS__
    post-up /sbin/ip -6 address change __INSTALLER_CIDR__ dev __INSTALLER_IFACE__ metric __INSTALLER_METRIC__
__INSTALLER_PERFORMANCE__
