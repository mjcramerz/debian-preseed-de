# __INSTALLER_LINK_TYPE__ adapter: __INSTALLER_IFACE__ (__INSTALLER_MAC__); detected during install as __INSTALLER_DETECTED_IFACE__
__INSTALLER_ACTIVATION__
iface __INSTALLER_IFACE__ inet static
    pre-up /usr/sbin/sysctl -q -w net/ipv4/conf/__INSTALLER_IFACE__/ignore_routes_with_linkdown=1
    address __INSTALLER_ADDRESS__
    netmask __INSTALLER_NETMASK__
    gateway __INSTALLER_GATEWAY__
    dns-nameservers __INSTALLER_DNS__
    post-up /sbin/ip -4 address change __INSTALLER_CIDR__ dev __INSTALLER_IFACE__ metric __INSTALLER_METRIC__
__INSTALLER_SEARCH____INSTALLER_WIFI____INSTALLER_PERFORMANCE__
