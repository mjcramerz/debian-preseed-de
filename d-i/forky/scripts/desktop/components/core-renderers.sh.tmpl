desktop_waybar_geometry_validate() (
  set -eu
  umask 077
  desktop_waybar_geometry_schema || exit 1
  geometry_map=$TMP_ENV_DIR/waybar-geometry.map
  [ ! -L "$geometry_map" ] || {
    desktop_fatal "Waybar geometry map must not be a symlink"
    exit 1
  }
  geometry_values=$(mktemp "$TMP_ENV_DIR/waybar-geometry.values.XXXXXX") || exit 1
  geometry_map_tmp=
  geometry_stage_host=
  geometry_cleanup() {
    rm -f -- "$geometry_values"
    [ -z "$geometry_map_tmp" ] || rm -f -- "$geometry_map_tmp"
    if [ -n "$geometry_stage_host" ]; then
      rm -f -- "$geometry_stage_host/validator.py" \
        "$geometry_stage_host/schema.tsv" \
        "$geometry_stage_host/values.tsv" \
        "$geometry_stage_host/map.tsv"
      rmdir -- "$geometry_stage_host" 2>/dev/null || true
    fi
  }
  trap geometry_cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  desktop_waybar_geometry_values >"$geometry_values"
  # /tmp/install-env-late can survive a retried late command. Reuse the map
  # only when this invocation's literal input snapshot is byte-identical.
  if [ -f "$geometry_map" ] && [ -s "$geometry_map" ] &&
      [ -f "$TMP_ENV_DIR/waybar-geometry.values" ] &&
      [ ! -L "$TMP_ENV_DIR/waybar-geometry.values" ] &&
      cmp -s "$geometry_values" "$TMP_ENV_DIR/waybar-geometry.values"; then
    exit 0
  fi
  geometry_stage=$(target_private_stage_dir waybar-geometry) || exit 1
  geometry_stage_host=$(target_asset_host_path "$geometry_stage") || exit 1
  geometry_map_tmp=$(mktemp "$TMP_ENV_DIR/waybar-geometry.map.XXXXXX") || exit 1

  stage_target_asset \
    "$(installer_repo_join_var DIR_SCRIPTS_DESKTOP waybar_geometry.py)" \
    "$geometry_stage/validator.py" 0700
  stage_target_asset \
    "$(installer_repo_join_var DIR_SCRIPTS_DESKTOP waybar-geometry.tsv)" \
    "$geometry_stage/schema.tsv" 0600
  write_target_file "$geometry_stage/values.tsv" 0600 <"$geometry_values"
  run_in_target "validate Waybar geometry with target Python" \
    /usr/bin/env -i HOME=/root LC_ALL=C PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    /usr/bin/timeout --signal=TERM --kill-after=2s 10s \
    /usr/bin/python3 -I -S -B "$geometry_stage/validator.py" \
    --schema "$geometry_stage/schema.tsv" \
    --values "$geometry_stage/values.tsv" \
    --output "$geometry_stage/map.tsv"

  geometry_map_host=$(target_asset_host_path "$geometry_stage/map.tsv") || exit 1
  [ -f "$geometry_map_host" ] && [ ! -L "$geometry_map_host" ] || {
    desktop_fatal "target Waybar geometry validator did not produce a regular map"
    exit 1
  }
  cp -- "$geometry_map_host" "$geometry_map_tmp"
  chmod 0600 "$geometry_map_tmp"
  mv -f -- "$geometry_map_tmp" "$geometry_map"
  mv -f -- "$geometry_values" "$TMP_ENV_DIR/waybar-geometry.values"
)

# One literal renderer for config, CSS and native menus. Schema validation is
# mandatory before any geometry reaches JSON, CSS or GtkBuilder XML.
desktop_render_waybar_asset() (
  wb_asset=$1
  shift
  case "$wb_asset" in
    config|style.css|style-common.css) wb_asset_rel=$wb_asset ;;
    menu.css|gtk.css|taskview.css|workspaces.css|tomat.css|wayscriber.css|apps.css|clock.css|audio.css|brightness.css|battery.css|storage.css|cpu.css|memory.css|tray.css|system.css|notifications.css|lock.css|power.css)
      wb_asset_rel="style/${wb_asset}" ;;
    app-files|app-notes|app-sleek|app-terminal|app-tuta|apps|backlight|battery|bluetooth|clock|cpu|disk|external-apps-drawer|external-launcher|external-quick-controls|external-taskbar|external-tray|internal-apps-drawer|internal-launcher|internal-quick-controls|internal-taskbar|internal-tray|keyboard|lock|memory|network|notifications|power|pulseaudio|screenshot|system|tomat|wayscriber|window-switcher|workspaces)
      wb_asset_rel="modules/${wb_asset}" ;;
    audio-menu.xml|bluetooth-menu.xml|calendar-menu.xml|launcher-menu.xml|notifications-menu.xml|power-menu.xml|screenshot-menu.xml|system-menu.xml|tomat-menu.xml)
      wb_asset_rel="gtk/${wb_asset}" ;;
    *) desktop_fatal "unsupported Waybar asset: $wb_asset" ;;
  esac
  desktop_waybar_geometry_validate
  while IFS="$(printf '\t')" read -r wb_name wb_value; do
    [ -n "$wb_name" ] || continue
    set -- "$@" "$wb_name" "$wb_value"
  done < "$TMP_ENV_DIR/waybar-geometry.map"
  desktop_render_role_target_template \
    "etc/skel-desktop/.config/waybar/${wb_asset_rel}.tmpl" \
    "/etc/skel-desktop/.config/waybar/${wb_asset_rel}" 0644 "$@"
)

desktop_render_waybar_config() (
  # Do not let a failed command substitution turn into an empty JSON selector.
  wb_internal_outputs=$(desktop_waybar_internal_outputs_json) || desktop_fatal "cannot render internal Waybar outputs"
  wb_external_outputs=$(desktop_waybar_external_outputs_json) || desktop_fatal "cannot render external Waybar outputs"
  wb_modules_left=$(desktop_waybar_modules_left_json) || desktop_fatal "cannot render Waybar left modules"
  wb_modules_right=$(desktop_waybar_modules_right_json) || desktop_fatal "cannot render Waybar right modules"
  desktop_render_waybar_config_asset() {
    desktop_render_waybar_asset "$1" \
      LABWC_WAYLAND_APP_DEFAULT_EXEC "$(desktop_double_quote_escape "$LABWC_WAYLAND_APP_DEFAULT_EXEC")" \
      LABWC_WAYBAR_INTERNAL_OUTPUTS "$wb_internal_outputs" \
      LABWC_WAYBAR_EXTERNAL_OUTPUTS "$wb_external_outputs" \
      LABWC_WAYBAR_MODULES_LEFT "$wb_modules_left" \
      LABWC_WAYBAR_MODULES_RIGHT "$wb_modules_right" \
      LABWC_MANAGED_APP_DEFAULT_EXEC "$(desktop_double_quote_escape "${LABWC_MANAGED_APP_DEFAULT_EXEC:?LABWC_MANAGED_APP_DEFAULT_EXEC must be set by the desktop host profile}")" \
      LABWC_FILE_MANAGER_COMMAND "$(desktop_double_quote_escape "${LABWC_FILE_MANAGER_COMMAND:-thunar}")" \
      LABWC_CALENDAR_COMMAND "$(desktop_double_quote_escape "${LABWC_CALENDAR_COMMAND:-labwc-calendar}")" \
      LABWC_AUDIO_CONTROL_COMMAND "$(desktop_double_quote_escape "${LABWC_AUDIO_CONTROL_COMMAND:-pavucontrol}")" \
      LABWC_WAYBAR_PULSEAUDIO_RIGHT_CLICK_COMMAND "$(desktop_waybar_pulseaudio_right_click_command)" \
      LABWC_BRIGHTNESS_CONTROL_COMMAND "$(desktop_double_quote_escape "${LABWC_BRIGHTNESS_CONTROL_COMMAND:-labwc-brightness-control}")" \
      LABWC_CAPTURE_COMMAND "$(desktop_double_quote_escape "${LABWC_CAPTURE_COMMAND:-labwc-capture}")" \
      LABWC_POWER_SETTINGS_COMMAND "$(desktop_double_quote_escape "${LABWC_POWER_SETTINGS_COMMAND:-labwc-power-settings}")"
  }
  desktop_render_waybar_config_asset config
  for wb_config_asset in \
    app-files app-notes app-sleek app-terminal app-tuta apps backlight battery \
    bluetooth clock cpu disk external-apps-drawer external-launcher \
    external-quick-controls external-taskbar external-tray internal-apps-drawer \
    internal-launcher internal-quick-controls internal-taskbar internal-tray \
    keyboard lock memory network notifications power pulseaudio screenshot \
    system tomat wayscriber window-switcher workspaces
  do
    desktop_render_waybar_config_asset "$wb_config_asset"
  done
  desktop_log "rendered_waybar_config bars=internal,external processes=1"
)

desktop_render_waybar_style() {
  desktop_render_waybar_asset style-common.css
  for wb_style_asset in \
    menu.css workspaces.css tomat.css wayscriber.css taskview.css apps.css \
    clock.css audio.css brightness.css battery.css storage.css cpu.css memory.css \
    tray.css system.css notifications.css lock.css power.css
  do
    desktop_render_waybar_asset "$wb_style_asset"
  done
  desktop_render_waybar_asset gtk.css
  desktop_render_waybar_asset style.css
}

desktop_render_gtkgreet_css() {
  greeter_font_size=${LABWC_GREETER_FONT_SIZE:-17}
  greeter_clock_font_size=${LABWC_GREETER_CLOCK_FONT_SIZE:-104}
  greeter_background_url="file://${LABWC_GREETER_BACKGROUND_PATH}"
  greeter_panel_margin=${LABWC_GREETER_PANEL_MARGIN:-$((greeter_font_size * 2))}
  greeter_panel_min_width=${LABWC_GREETER_PANEL_MIN_WIDTH:-$((greeter_font_size * 44))}
  greeter_panel_padding_y=${LABWC_GREETER_PANEL_PADDING_Y:-$((greeter_font_size * 2))}
  greeter_panel_padding_x=${LABWC_GREETER_PANEL_PADDING_X:-$((greeter_font_size * 2 + 8))}
  greeter_label_font_size=$((greeter_font_size + 2))
  greeter_control_font_size=$((greeter_font_size + 3))
  greeter_control_min_height=${LABWC_GREETER_CONTROL_MIN_HEIGHT:-$((greeter_font_size * 3 + 8))}
  greeter_entry_min_width=${LABWC_GREETER_ENTRY_MIN_WIDTH:-$((greeter_font_size * 34))}
  greeter_shell_min_width=${LABWC_GREETER_SHELL_MIN_WIDTH:-$greeter_entry_min_width}
  greeter_button_min_width=${LABWC_GREETER_BUTTON_MIN_WIDTH:-$((greeter_font_size * 13))}

  desktop_render_role_target_template \
    "etc/greetd/gtkgreet.css" \
    "/etc/greetd/gtkgreet.css" \
    0644 \
    LABWC_GREETER_BACKGROUND_URL "$(desktop_double_quote_escape "$greeter_background_url")" \
    LABWC_GREETER_CLOCK_FONT_SIZE "$greeter_clock_font_size" \
    LABWC_GREETER_PANEL_MARGIN "$greeter_panel_margin" \
    LABWC_GREETER_PANEL_MIN_WIDTH "$greeter_panel_min_width" \
    LABWC_GREETER_PANEL_PADDING_Y "$greeter_panel_padding_y" \
    LABWC_GREETER_PANEL_PADDING_X "$greeter_panel_padding_x" \
    LABWC_GREETER_LABEL_FONT_SIZE "$greeter_label_font_size" \
    LABWC_GREETER_CONTROL_FONT_SIZE "$greeter_control_font_size" \
    LABWC_GREETER_CONTROL_MIN_HEIGHT "$greeter_control_min_height" \
    LABWC_GREETER_ENTRY_MIN_WIDTH "$greeter_entry_min_width" \
    LABWC_GREETER_SHELL_MIN_WIDTH "$greeter_shell_min_width" \
    LABWC_GREETER_BUTTON_MIN_WIDTH "$greeter_button_min_width"
  desktop_log "rendered_gtkgreet_css font_size=${greeter_font_size} clock_font_size=${greeter_clock_font_size} panel_min_width=${greeter_panel_min_width} entry_min_width=${greeter_entry_min_width}"
}

desktop_render_greeter_power_rule() {
  desktop_render_role_target_template \
    "etc/polkit-1/rules.d/10-greetd-power.rules.tmpl" \
    "/etc/polkit-1/rules.d/10-greetd-power.rules" \
    0644 \
    LABWC_GREETER_USER "$(desktop_double_quote_escape "${LABWC_GREETER_USER:-greeter}")"
  desktop_log "rendered_greeter_power_rule user=${LABWC_GREETER_USER:-greeter}"
}
