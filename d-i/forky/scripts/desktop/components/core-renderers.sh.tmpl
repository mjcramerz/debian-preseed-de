  desktop_log "rendered_labwc_rc_xml workspaces=${workspace_count}"
}

# Geometry keys/ranges are shared by validation and rendering. This metadata
# is consumed only by the installer; runtime reads native Waybar JSON and CSS.
desktop_waybar_geometry_schema() {
  if [ ! -s "$TMP_ENV_DIR/waybar-geometry.tsv" ]; then
    fetch_hook "$(installer_repo_join_var DIR_SCRIPTS_DESKTOP waybar-geometry.tsv)" "$TMP_ENV_DIR/waybar-geometry.tsv"
  fi
  if [ ! -s "$TMP_ENV_DIR/waybar_geometry.py" ]; then
    fetch_hook "$(installer_repo_join_var DIR_SCRIPTS_DESKTOP waybar_geometry.py)" "$TMP_ENV_DIR/waybar_geometry.py"
  fi
}

