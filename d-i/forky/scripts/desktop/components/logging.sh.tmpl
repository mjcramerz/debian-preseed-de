desktop_stage_boot_logging() {
  # Offline preparation only; never read the installer's journal or start units.
  desktop_stage_role_asset usr/local/libexec/journal-snapshot.tmpl /usr/local/libexec/journal-snapshot 0755
  desktop_stage_role_asset etc/systemd/system/boot-log.service.tmpl /etc/systemd/system/boot-log.service 0644
  desktop_stage_role_asset etc/systemd/system/boot-log.timer.tmpl /etc/systemd/system/boot-log.timer 0644
  run_in_target "prepare persistent boot journal directory" \
    /usr/local/libexec/journal-snapshot --prepare
  stage_target_systemd_unit_enabled boot-log.timer system
}

