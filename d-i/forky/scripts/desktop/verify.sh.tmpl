  /usr/local/lib/python3.14/dist-packages/labwc_help/theme.py \
  /usr/local/lib/python3.14/dist-packages/labwc_help/window.py \
  /usr/local/lib/python3.14/dist-packages/labwc_help/app.py; do metadata "$path" 644; done
for path in /usr/local/share/labwc-help/articles/*.json; do metadata "$path" 644; done
for path in /usr/local/bin/labwc-agenda /usr/local/bin/labwc-calendar; do
  [ -L "$path" ] || { printf "fatal: managed calendar link is missing: %s\\n" "$path" >&2; exit 1; }
  target=$(readlink "$path")
  [ "$target" = labwc-app ] || { printf "fatal: managed calendar link target mismatch: %s\\n" "$path" >&2; exit 1; }
done
printf "desktop_runtime_metadata_verification stage=%s\\n" "$stage"
' sh "$stage"
}

desktop_verify_target_staging() {
  desktop_verify_runtime_contracts with-account
  run_in_target "verify managed wlsunset path metadata" /bin/sh -eu -c '
[ -x /usr/local/bin/labwc-wlsunset ] || { printf "fatal: managed wlsunset delegate is missing\n" >&2; exit 1; }
printf "desktop_wlsunset_metadata_verification complete\n"
' sh
  desktop_verify_required_commands
  desktop_verify_staged_files
  desktop_verify_optional_staged_files
  desktop_verify_kanshi_policy
  desktop_verify_greeter_access
  desktop_verify_primary_user_files
  desktop_verify_user_resource_policy
}
