desktop_verify_kanshi_policy() {
  run_in_target "verify conditional Kanshi path metadata" /bin/sh -eu -c '
metadata() {
  path=$1
  [ -e "$path" ] || return 0
  [ ! -L "$path" ] || { printf "fatal: optional Kanshi path is a symbolic link: %s\\n" "$path" >&2; exit 1; }
  mode=$(find -P "$path" -maxdepth 0 -printf "%m")
  case "$path" in *.service|*.conf) [ "$mode" = 644 ] || { printf "fatal: Kanshi file mode mismatch: %s\\n" "$path" >&2; exit 1; } ;; *) [ -d "$path" ] || [ -f "$path" ] || { printf "fatal: invalid Kanshi path: %s\\n" "$path" >&2; exit 1; } ;; esac
}
for path in /usr/bin/kanshi /usr/local/libexec/labwc-kanshi /etc/skel-desktop/.config/kanshi/config /etc/skel-desktop/.config/systemd/user/kanshi.service /etc/skel-desktop/.config/systemd/user/kanshi.service.d/60-resource-class.conf; do metadata "$path"; done
printf "desktop_kanshi_metadata_verification complete\\n"
' sh
}

desktop_verify_runtime_contracts() {
  : "${ACCOUNT_USERNAME:?ACCOUNT_USERNAME must be set}"
  : "${LABWC_GREETER_USER:?LABWC_GREETER_USER must be set}"
  stage=${1:-code-only}
  case "$stage" in code-only|with-account|account-only) ;; *)
    printf 'fatal: invalid runtime verification stage: %s\n' "$stage" >&2; return 1 ;;
  esac
  for runtime_identifier in "$ACCOUNT_USERNAME" "$LABWC_GREETER_USER"; do
    case "$runtime_identifier" in
      ""|*[!a-z0-9_-]*|[!a-z_]*)
        printf 'fatal: invalid configured desktop identifier\n' >&2; return 1 ;;
    esac
    [ "${#runtime_identifier}" -le 32 ] || {
      printf 'fatal: configured desktop identifier is too long\n' >&2; return 1;
    }
  done
  run_in_target "verify rendered desktop runtime metadata" /bin/sh -eu -c '
stage=$1
for directory in \
  /usr/local/bin /usr/local/libexec \
  /usr/local/lib/python3.14 /usr/local/lib/python3.14/dist-packages \
  /usr/local/lib/python3.14/dist-packages/managed_workflows \
  /usr/local/lib/python3.14/dist-packages/labwc_appearance \
  /usr/local/lib/python3.14/dist-packages/labwc_help \
  /usr/local/share /usr/local/share/labwc-help /usr/local/share/labwc-help/articles
do
  [ -d "$directory" ] && [ ! -L "$directory" ] || {
    printf "fatal: unsafe runtime directory: %s\n" "$directory" >&2; exit 1;
  }
  [ "$(find -P "$directory" -maxdepth 0 -printf "%U:%G:%m")" = 0:0:755 ] || {
    printf "fatal: runtime directory must be root:root mode 0755: %s\n" "$directory" >&2; exit 1;
  }
done
metadata() {
  path=$1; mode=$2
  [ -f "$path" ] && [ ! -L "$path" ] || { printf "fatal: required runtime file is missing or unsafe: %s\\n" "$path" >&2; exit 1; }
  actual=$(find -P "$path" -maxdepth 0 -printf "%U:%G:%m:%n")
  [ "$actual" = "0:0:$mode:1" ] || { printf "fatal: runtime metadata mismatch: %s expected=0:0:%s:1 actual=%s\\n" "$path" "$mode" "$actual" >&2; exit 1; }
}
executable() { metadata "$1" 755; [ -x "$1" ] || { printf "fatal: runtime delegate is not executable: %s\\n" "$1" >&2; exit 1; }; }
for path in \
  /usr/local/bin/labwc-app /usr/local/bin/labwc-fuzzel \
  /usr/local/bin/labwc-help /usr/local/libexec/labwc-help-gtk \
  /usr/local/bin/labwc-wayscriber-config /usr/local/bin/labwc-wayscriber-toggle \
  /usr/local/bin/labwc-wallpaper-save /usr/local/libexec/labwc-waypaper \
  /usr/local/libexec/labwc-waybar-run /usr/local/libexec/labwc-waybar-exec \
  /usr/local/libexec/labwc-swaybg /usr/local/libexec/labwc-swaylock \
  /usr/local/libexec/labwc-wallpaper-control; do executable "$path"; done
for path in \
  /usr/local/lib/python3.14/dist-packages/managed_workflows/__init__.py \
  /usr/local/lib/python3.14/dist-packages/managed_workflows/fs.py \
  /usr/local/lib/python3.14/dist-packages/labwc_appearance/wallpaper.py \
  /etc/apparmor.d/abstractions/native-gpu-selection; do metadata "$path" 644; done
metadata /usr/local/share/labwc-appearance/menu-icons.json 644
for path in \
  /usr/local/share/labwc-help/catalog.json \
  /usr/local/share/labwc-help/theme.json \
  /usr/local/share/labwc-help/articles/start.help.json \
  /usr/local/share/applications/labwc-help.desktop \
  /usr/local/lib/python3.14/dist-packages/labwc_help/__init__.py \
