desktop_skeleton=/etc/skel-desktop
[ -d "$desktop_skeleton" ] && [ ! -L "$desktop_skeleton" ] ||
  fatal "desktop skeleton root is missing or unsafe: $desktop_skeleton"
[ "$(find -P "$desktop_skeleton" -maxdepth 0 -printf "%U:%G")" = 0:0 ] ||
