#custom-tomat.long-break-paused { color: @amber; }\n#custom-tomat.break, #custom-tomat.long-break { color: @mint; }\n#custom-tomat.error { color: @red; }\n#custom-notifications.dnd { color: @muted; }\n/* Warm gold also wins over the DND text color while hovered. */\n#custom-notifications:hover {\n  background: @amber;\n  border-color: @border_strong;\n  color: #08111f;\n  box-shadow: 0 10px 26px rgba(236, 184, 96, 0.22);\n}\n/* Native GTK popups are separate windows, not descendants of window#waybar.\n * Share one orange highlight across all five menus and their submenus. GTK\n * uses :hover (PRELIGHT) for pointer and keyboard menu selection; :selected\n * also covers themes exposing that state. Disabled actions stay subdued. */\nmenu {\n  background: @panel;\n  color: @text;\n  border: 1px solid @border_strong;\n  padding: 4px;\n  -gtk-icon-theme: "Papirus-Dark";\n}\nmenuitem { padding: 8px 14px; border-radius: 6px; }\nmenuitem label { font-size: 16px; font-weight: 700; }\nmenuitem image { min-width: 18px; min-height: 18px; color: @text; }\nmenuitem:hover:not(:disabled),\nmenuitem:selected:not(:disabled) {\n  background: #ff9f36;\n  color: #17100a;\n  box-shadow: inset 0 0 0 1px #ffc06d;\n}\nmenuitem:hover:not(:disabled) label,\nmenuitem:selected:not(:disabled) label,\nmenuitem:hover:not(:disabled) image,\nmenuitem:selected:not(:disabled) image {\n  color: #17100a;\n}\nmenuitem arrow {\n  min-width: 16px;\n  min-height: 16px;\n  margin-left: 12px;\n  color: @amber;\n}\nmenuitem arrow.right { -gtk-icon-source: -gtk-icontheme("pan-end-symbolic"); }\nmenuitem arrow.left { -gtk-icon-source: -gtk-icontheme("pan-start-symbolic"); }\nmenuitem:hover:not(:disabled) arrow,\nmenuitem:selected:not(:disabled) arrow { color: #17100a; }\nmenuitem:disabled {\n  background: transparent;\n  color: @muted;\n}\nmenuitem:disabled label,\nmenuitem:disabled image,\nmenuitem:disabled arrow { color: @muted; }\n'

