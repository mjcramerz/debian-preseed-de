--- original/d-i/forky/hooks/target/etc/udev/hwdb.d/90-managed-thinkpad-extra-buttons.hwdb
+++ /dev/null
@@ -1,33 +0,0 @@
-# Managed desktop: preserve thinkpad_acpi's native sparse keymap.
-# event4 in the supplied 2026-09-20 log rejected every legacy override below
-# with EINVAL. An event number is not a persistent hardware identifier.
-# Empty hwdb values remove these inherited udev properties; they do NOT map
-# keys to KEY_RESERVED/KEY_UNKNOWN and do not disable the input device.
-# Kernel/firmware-handled brightness, volume and ThinkLight remain untouched.
-# Userspace actions for native XF86 keysyms are configured in labwc/rc.xml.
-# Do not replace these with guessed 0x1000-series scan codes: no evtest or
-# EVIOCGKEYCODE_V2 capture was supplied to establish such a mapping.
-evdev:name:ThinkPad Extra Buttons:dmi:bvn*:bvr*:bd*:svnLENOVO*:pn*:pvr*
- KEYBOARD_KEY_01=
