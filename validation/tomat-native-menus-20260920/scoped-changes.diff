+def check_directory(path: Path, uid: int, *, private: bool = False) -> None:
+    info = path.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid or info.st_mode & 0o022:
+        raise Error(f"unsafe directory ownership/type/mode: {path}")
+    if private and info.st_mode & 0o077:
+        raise Error(f"runtime directory must be private: {path}")
+
+
+def validate_config(text: str) -> dict:
+    """Fail visibly rather than letting Tomat silently fall back on parse error."""
+    if len(text.encode("utf-8")) > MAX_CONFIG:
+        raise Error("Tomat configuration is too large")
+    data = tomllib.loads(text)
+    allowed = {
+        "timer": {"work", "break", "long_break", "sessions", "auto_advance"},
+        "sound": {"mode", "volume", "enabled", "system_beep", "use_embedded",
+                  "work_to_break", "break_to_work", "work_to_long_break"},
+        "notification": {"enabled", "timeout", "icon", "urgency", "work_message",
+                         "break_message", "long_break_message"},
+        "display": {"text_format", "text_format_idle", "icons"},
+        "hooks": {"on_break_start", "on_long_break_start"},
+    }
+    if set(data) - set(allowed):
+        raise Error("unsupported top-level Tomat configuration key")
+    for name, keys in allowed.items():
+        table = data.get(name, {})
+        if not isinstance(table, dict) or set(table) - keys:
+            raise Error(f"[{name}] must contain only supported TOML keys")
+
+    def strings(table: dict, keys: tuple[str, ...]) -> None:
+        for key in keys:
+            if key in table and (not isinstance(table[key], str) or len(table[key]) > 8192
+                                 or "\x00" in table[key]):
+                raise Error(f"{key} must be a bounded string without NUL")
+    timer = data.get("timer", {})
+    # Match upstream's public duration/session constraints, excluding bool/NaN.
+    for key, default in (("work", 45.0), ("break", 5.0), ("long_break", 15.0)):
+        value = timer.get(key, default)
+        if type(value) not in (int, float) or not math.isfinite(value) or not 0 < value <= 600:
+            raise Error(f"timer.{key} must be a finite duration in (0, 600] minutes")
+    sessions = timer.get("sessions", 3)
+    if type(sessions) is not int or not 1 <= sessions <= 100:
+        raise Error("timer.sessions must be an integer in [1, 100]")
+    if timer.get("auto_advance", "to-break") not in ("all", "none", "to-break", "to-work"):
+        raise Error("unsupported timer.auto_advance")
+    sound = data.get("sound", {})
+    if sound.get("mode", "embedded") not in ("none", "embedded", "system-beep"):
+        raise Error("unsupported sound.mode")
+    for key in ("enabled", "system_beep", "use_embedded"):
+        if key in sound and type(sound[key]) is not bool:
+            raise Error(f"sound.{key} must be boolean")
+    strings(sound, ("work_to_break", "break_to_work", "work_to_long_break"))
+    volume = sound.get("volume", 0.3)
+    if type(volume) not in (int, float) or not math.isfinite(volume) or not 0 <= volume <= 1:
+        raise Error("sound.volume must be between zero and one")
+    notification = data.get("notification", {})
+    if type(notification.get("enabled", True)) is not bool:
+        raise Error("notification.enabled must be boolean")
+    timeout = notification.get("timeout", 8000)
+    if type(timeout) is not int or not 0 <= timeout <= 2_147_483_647:
+        raise Error("notification.timeout must be a non-negative signed 32-bit integer")
+    strings(notification, ("icon", "work_message", "break_message", "long_break_message"))
+    if notification.get("urgency", "normal") not in ("low", "normal", "critical"):
+        raise Error("unsupported notification.urgency")
+    display = data.get("display", {})
+    strings(display, ("text_format", "text_format_idle"))
+    icons = display.get("icons", {})
+    icon_keys = ("work", "break", "long_break", "play", "pause", "stop")
+    if not isinstance(icons, dict) or set(icons) - set(icon_keys):
+        raise Error("display.icons must contain supported icon names")
+    strings(icons, icon_keys)
+    # Keep managed hooks bounded and non-shell. New arbitrary commands belong
+    # in an explicitly reviewed policy, not in this daemon's authority.
+    for event, hook in data.get("hooks", {}).items():
+        expected = {"on_break_start": ["break"], "on_long_break_start": ["long-break"]}
+        if (event not in expected or not isinstance(hook, dict)
+                or set(hook) != {"cmd", "args", "timeout", "capture_output"}
+                or hook.get("cmd") != "/usr/local/libexec/labwc-tomat-hook"
+                or hook.get("args") != expected[event]
+                or type(hook.get("timeout")) is not int or not 1 <= hook["timeout"] <= 5
+                or hook.get("capture_output") is not True):
+            raise Error(f"unapproved or unbounded Tomat hook: {event}")
+    return data
+
+
+def change_setting(text: str, setting: str) -> tuple[str, str]:
+    data = validate_config(text)
+    if setting == "notifications":
+        section, key = "notification", "enabled"
+        value = "false" if data.get(section, {}).get(key, True) else "true"
+        description = "Notifications " + ("enabled" if value == "true" else "disabled")
+    elif setting == "sounds":
+        section, key = "sound", "mode"
+        value = '"embedded"' if data.get(section, {}).get(key, "embedded") == "none" else '"none"'
+        description = "Sounds " + ("disabled" if value == '"none"' else "enabled")
+    else:
+        raise Error("unsupported setting")
+    # Retain unrelated keys and comments; refuse ambiguous quoted/inline table
+    # styles rather than rewriting the user's entire configuration.
+    lines = text.splitlines(keepends=True)
+    section_start = section_end = None
+    in_section = False
+    found = False
+    for index, line in enumerate(lines):
+        table = re.fullmatch(r"\s*\[\s*([a-zA-Z0-9_.-]+)\s*\]\s*(?:#.*)?", line.rstrip("\r\n"))
+        if table:
+            if in_section:
+                section_end = index
+                in_section = False
+            if table[1] == section:
+                section_start = index
+                in_section = True
+        if in_section:
+            match = re.fullmatch(r"(\s*" + key + r"\s*=\s*)(true|false|\"[^\"]*\"|'[^']*')(\s*(?:#.*)?)", line.rstrip("\r\n"))
+            if match:
+                lines[index] = match[1] + value + match[3] + "\n"
+                found = True
+    if not found:
+        if key in data.get(section, {}):
+            raise Error(f"edit {section}.{key} manually: the menu requires a simple table/key assignment")
+        if section_start is None:
+            if section in data:
+                raise Error(f"edit [{section}] manually: inline/quoted table layout is not rewritten")
+            lines.append(f"\n[{section}]\n{key} = {value}\n")
+        else:
+            index = section_end if section_end is not None else len(lines)
+            if index and not lines[index - 1].endswith(("\n", "\r")):
+                lines[index - 1] += "\n"
+            lines.insert(index, f"{key} = {value}\n")
+    result = "".join(lines)
+    validate_config(result)
+    return result, description
+
