+class Context:
+    def __init__(self) -> None:
+        self.uid = os.getuid()
+        if self.uid == 0 or os.geteuid() != self.uid:
+            raise Error("Tomat must run as the logged-in, unprivileged desktop user")
+        self.home = Path(pwd.getpwuid(self.uid).pw_dir)
+        if not self.home.is_absolute():
+            raise Error("account home is not absolute")
+        self.runtime = Path(f"/run/user/{self.uid}")
+        if os.environ.get("XDG_RUNTIME_DIR", str(self.runtime)) != str(self.runtime):
+            raise Error("XDG_RUNTIME_DIR does not match the current account")
+        check_directory(self.runtime, self.uid, private=True)
+        for path in (self.home, self.home / ".config", self.home / ".config/tomat"):
+            check_directory(path, self.uid)
+        self.directory = self.home / ".config/tomat"
+        self.config = self.directory / "config.toml"
+        self.env = {
+            "HOME": str(self.home), "USER": pwd.getpwuid(self.uid).pw_name,
+            "LOGNAME": pwd.getpwuid(self.uid).pw_name,
+            "PATH": "/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8",
+            "XDG_RUNTIME_DIR": str(self.runtime), "XDG_CONFIG_HOME": str(self.home / ".config"),
+            "XDG_CACHE_HOME": str(self.home / ".cache"),
+            "DBUS_SESSION_BUS_ADDRESS": f"unix:path={self.runtime}/bus",
+            "TOMAT_RUNTIME_DIR": str(self.runtime / "labwc-tomat"),
+            "TOMAT_CONFIG": str(self.config), "TOKIO_WORKER_THREADS": "2",
+        }
+
+    def run(self, argv: list[str], *, timeout: float = 10, check: bool = True) -> subprocess.CompletedProcess:
+        result = subprocess.run(argv, env=self.env, stdin=subprocess.DEVNULL,
+                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                text=True, timeout=timeout, check=False)
+        if len(result.stdout) + len(result.stderr) > MAX_CONFIG:
+            raise Error("command returned excessive output")
+        if check and result.returncode:
+            detail = result.stderr.strip()[:1024] or result.stdout.strip()[:1024]
+            raise Error(f"{Path(argv[0]).name} failed: {detail}")
+        return result
+
+    @contextlib.contextmanager
+    def locked(self):
+        # Outside RuntimeDirectory: systemd may remove the latter on final stop.
+        # O_NONBLOCK refuses a malicious FIFO without waiting for another end.
