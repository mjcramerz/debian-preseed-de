+            self.owned(values)
+            if values.get("ActiveState") == "failed":
+                raise Error(f"{UNIT} failed; inspect journalctl --user -u {UNIT}")
+            try:
+                self.ready(int(values.get("MainPID", "0")))
+                self.session_ready()
+                return
+            except (OSError, ValueError, Error) as exc:
+                last_error = str(exc)
+                time.sleep(0.1)
+        raise Error(f"Tomat readiness timed out: {last_error}")
+
+    def ensure(self) -> None:
+        self.session_ready()
+        with self.config_file():
+            pass
+        values = self.show()
+        if values["LoadState"] == "not-found":
+            command = ["/usr/bin/systemd-run", "--user", "--quiet", f"--unit={UNIT}",
+                       "--service-type=exec", "--expand-environment=no"]
+            command += ["--property=" + prop for prop in PROPERTIES]
+            command += ["--setenv=" + key + "=" + value for key, value in self.env.items()]
+            # Deliberately NO --collect: failed units retain their start limit.
+            # Successful final stop still collects this transient unit normally.
+            command += ["--", TOMAT, "daemon", "run"]
+            self.run(command)
+        else:
+            self.owned(values)
+            if values.get("ActiveState") == "failed":
+                raise Error(f"{UNIT} is failed; repair it before systemctl --user reset-failed {UNIT}")
+            if values.get("ActiveState") == "inactive":
+                self.run([SYSTEMCTL, "--user", "start", UNIT])
+        self.wait_ready()
+
+    def setting(self, name: str) -> None:
+        with self.config_file() as (directory_fd, old_stat, text):
+            replacement, message = change_setting(text, name)
+            temporary = ".config.toml." + secrets.token_hex(12)
+            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
+                         0o600, dir_fd=directory_fd)
+            try:
+                with os.fdopen(fd, "wb") as stream:
+                    stream.write(replacement.encode("utf-8"))
+                    stream.flush()
+                    os.fsync(stream.fileno())
+                current = os.stat("config.toml", dir_fd=directory_fd, follow_symlinks=False)
+                if ((current.st_dev, current.st_ino, current.st_mtime_ns, current.st_size)
+                        != (old_stat.st_dev, old_stat.st_ino, old_stat.st_mtime_ns, old_stat.st_size)):
+                    raise Error("config changed concurrently; no settings were overwritten")
+                os.replace(temporary, "config.toml", src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
+                os.fsync(directory_fd)
+            finally:
+                with contextlib.suppress(FileNotFoundError):
+                    os.unlink(temporary, dir_fd=directory_fd)
+        # Upstream reads notification/sound/hooks at daemon startup, not SIGHUP.
+        self.owned(self.show())
+        self.run([SYSTEMCTL, "--user", "restart", UNIT])
+        self.wait_ready()
+        print(message)
+
+
+def main(argv: list[str]) -> int:
+    if not argv or argv[0] not in {"watch", "ensure", "start", "toggle", "skip", "stop", "settings", "config"}:
+        raise Error("usage: labwc-tomat watch|ensure|start [default|25|50|90]|toggle|skip|stop|settings notifications|sounds|config")
+    action = argv[0]
+    if action == "start":
+        if len(argv) > 2 or (len(argv) == 2 and argv[1] not in PRESETS):
+            raise Error("invalid Tomat start preset")
+    elif action == "settings":
+        if len(argv) != 2 or argv[1] not in {"notifications", "sounds"}:
+            raise Error("invalid Tomat settings action")
+    elif len(argv) != 1:
+        raise Error("unexpected Tomat arguments")
+    context = Context()
+    if action == "config":
+        # Opening a broken file for repair must not require successful TOML parse
+        # or daemon startup. The editor is native Wayland, never Xwayland.
+        context.session_ready()
+        environment = dict(context.env, GDK_BACKEND="wayland", QT_QPA_PLATFORM="wayland")
+        display = os.environ.get("WAYLAND_DISPLAY", "")
+        if not re.fullmatch(r"wayland-[0-9]+", display):
+            raise Error("no managed Wayland display is available")
+        environment["WAYLAND_DISPLAY"] = display
+        environment["XDG_SESSION_TYPE"] = "wayland"
+        os.execve("/usr/bin/featherpad", ["/usr/bin/featherpad", str(context.config)], environment)
+    with context.locked():
+        context.ensure()
+        if action == "settings":
+            context.setting(argv[1])
+            return 0
+    if action == "ensure":
+        return 0
+    if action == "watch":
+        command = [TOMAT, "watch", "--interval", "1", "--output", "waybar"]
+    elif action == "start":
+        values = PRESETS[argv[1] if len(argv) == 2 else "default"]
+        command = [TOMAT, "--quiet", "start"]
+        if values:
+            command += ["--work", values[0], "--break", values[1]]
+    else:
+        command = [TOMAT, "--quiet", action]
+    # CLI controls connect only; they never invoke `daemon start` or stop PIDs.
+    os.execve(TOMAT, command, context.env)
+    return 0
+
+
+if __name__ == "__main__":
