+    def show(self) -> dict[str, str]:
+        fields = "LoadState,ActiveState,Transient,Description,MainPID"
+        result = self.run([SYSTEMCTL, "--user", "show", f"--property={fields}", UNIT], check=False)
+        values = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
