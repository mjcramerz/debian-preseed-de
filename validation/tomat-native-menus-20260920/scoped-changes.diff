+    f"Description={DESCRIPTION}", f"Requisite={TARGET}", f"After={TARGET}",
+    f"PartOf={TARGET}", "Slice=app.slice", "ExitType=cgroup", "KillMode=control-group",
+    "Restart=on-failure", "RestartSec=3s", "StartLimitIntervalSec=60s", "StartLimitBurst=3",
+    "TimeoutStartSec=10s", "TimeoutStopSec=5s", "UMask=0077", "LimitCORE=0",
+    "RuntimeDirectory=labwc-tomat", "RuntimeDirectoryMode=0700",
+    "RuntimeDirectoryPreserve=restart", "NoNewPrivileges=yes",
+    "RestrictAddressFamilies=AF_UNIX", "RestrictNamespaces=yes",
+    "RestrictSUIDSGID=yes", "RestrictRealtime=yes", "LockPersonality=yes",
+    "MemoryDenyWriteExecute=yes", "SystemCallArchitectures=native",
+    "TasksMax=64", "MemoryHigh=128M", "MemoryMax=256M", "CPUWeight=50",
+    "StandardOutput=journal", "StandardError=journal", "SyslogIdentifier=labwc-tomat",
