+package ExternalSoftware::Servicing::ArtifactLimits;
+
+use strict;
+use warnings;
+use Exporter qw(import);
+
+our @EXPORT_OK = qw(MAX_DEB_BYTES);
+
+# The immutable local APT pool admits at most 1 GiB per Debian archive.
+# This is the bound on both downloaded and locally rewritten .deb files;
+# gzip policy rewrites need not have the same size as the upstream archive.
+# Individual download specifications may impose a smaller transport limit.
+# Keep this aligned with MAX_DEB in local-apt-repository. The cross-language
+# regression test checks the actual values, not just their source spelling.
+use constant MAX_DEB_BYTES => 1_073_741_824;
+
+1;
