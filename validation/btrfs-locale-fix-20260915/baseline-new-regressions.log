onsumed only when addon/devops is selected. Aptly and osc state remains\n# below /pool/db/ACCOUNT_USERNAME; package cache and build work remain below\n# their matching /pool/cache and /pool/build account roots.\nDEVOPS_APTLY_ROOT_SUBDIR="aptly"\nDEVOPS_APTLY_GPG_SIGNING_KEY="/aptly-signing/aptly-jcramer.xyz-gpg.asc"\nDEVOPS_APTLY_R2_ENDPOINT_URL="https://79cc1f5f831fb7f414638c3e758e9710.r2.cloudflarestorage.com"\nDEVOPS_APTLY_R2_ENDPOINT_NAME="r2"\nDEVOPS_APTLY_R2_BUCKET="cf-aptly-r2-prod"\nDEVOPS_APTLY_R2_PREFIX="/debian"\nDEVOPS_APTLY_DISTRIBUTIONS="stable testing"\nDEVOPS_APTLY_COMPONENT="main"\nDEVOPS_APTLY_WORKER_ROUTE="apt"\nDEVOPS_APTLY_WORKER_ZONE="jcramer.xyz"\nDEVOPS_APTLY_PUBLIC_BASE_URL="https://apt.jcramer.xyz"\nDEVOPS_APTLY_REPOSITORY_KEY_FINGERPRINT="33808BDA7507EE103BADC3BCF575BD768D94A3470EFD5D17DC2C048ED01A93DC"\nDEVOPS_OSC_STATE_SUBDIR="osc"\nDEVOPS_OSC_CACHE_SUBDIR="osc"\nDEVOPS_OSC_BUILD_SUBDIR="osc"\nDEVOPS_OBS_API_URL="https://api.opensuse.org"\nDEVOPS_OBS_PROJECT="home:cramerz:debian"\nDEVOPS_OBS_REPOSITORY="Debian_Unstable"\nDEVOPS_OSC_CREDENTIALS_BACKEND="keyring.backends.SecretService.Keyring"\n\n# Optional direct QEMU/KVM and confined Incus policy. The local Web UI is\n# exposed only through the package-owned Unix socket when addon/qemu is selected.\nINCUS_BRIDGE_NAME="incusbr0"\n\n# Optional Podman addon policy. These values are consumed only when the\n# addon/podman class is selected.\nPODMAN_USER="devops"\nPODMAN_USER_HOME="/nonexistent"\nPODMAN_ROOTLESS_STATE_BASE="/pool/podman"\n# auto selects native OverlayFS on approved local filesystems; no silent fallback.\nPODMAN_STORAGE_DRIVER="auto"\n# Limits apply to the entire UID slice, including delegated container scopes.\nPODMAN_SERVICE_SLICE_CPU_WEIGHT=100\nPODMAN_SERVICE_SLICE_IO_WEIGHT=100\nPODMAN_SERVICE_SLICE_TASKS_MAX=8192\nPODMAN_SERVICE_SLICE_MEMORY_HIGH="70%"\nPODMAN_SERVICE_SLICE_MEMORY_MAX="85%"\n\n# Optional checksum-pinned whisper.cpp voice-task runtime. These values are\n# consumed only when addon/whisper is selected. The release archive and model\n# are independently integrity-pinned unattended-install inputs.\nWHISPER_RELEASE_URL="https://github.com/mjcramerz/whisper-labwc/releases/download/whisper-labwc-main/whisper-ram.tar.gz"\nWHISPER_RELEASE_SHA256="23a0db1cb6892a6fd2bcf41f5ff6f069bb1bc1cef8728fcc223a22fb16bc477b"\nWHISPER_RELEASE_BYTES="2310809"\nWHISPER_RELEASE_MAXIMUM_EXTRACTED_BYTES="8388608"\nWHISPER_RELEASE_MAXIMUM_MEMBERS="16"\nWHISPER_RELEASE_ARCHIVE_ROOT="whisper-ram"\nWHISPER_RELEASE_REQUIRED_CLASS=""\nWHISPER_ROOT="/data/whisper"\nWHISPER_BINARY_DIR="/data/whisper/bin"\nWHISPER_METADATA_DIR="/data/whisper/metadata"\nWHISPER_MODEL_DIR="/pool/cache/whisper/models"\nWHISPER_DOWNLOAD_RETRIES="3"\nWHISPER_DOWNLOAD_CONNECT_TIMEOUT_SECONDS="20"\nWHISPER_DOWNLOAD_MAX_TIME_SECONDS="7200"\nWHISPER_HF_TOKEN=""\nWHISPER_STRICT_RESOURCES=0\nWHISPER_FORCE_DOWNLOAD=0\nWHISPER_RUNTIME_THREADS="auto"\nWHISPER_PERSISTENT_MEM=0\nWHISPER_SERVER_PORT="59178"\nWHISPER_DEFAULT_MODEL="small.en-q8_0"\nWHISPER_DOWNLOAD_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/0b364b566045a405be7225ee1e415a073e04da77/ggml-small.en-q8_0.bin"\nWHISPER_MODEL_SHA256="67a179f608ea6114bd3fdb9060e762b588a3fb3bd00c4387971be4d177958067"\nWHISPER_MODEL_MIN_BYTES=264477561\nWHISPER_MIN_MEMORY_MIB=0\nWHISPER_MIN_CPU_CORES=0\n\n# Optional checksum-pinned llama.cpp coding-assistant runtime. These values are\n# consumed only when addon/devops is selected. The release archive is profile\n# policy; model selection and runtime tuning remain independently replaceable.\n# All five release executables are installed below LLAMA_BINARY_DIR.\nLLAMA_RELEASE_URL="https://github.com/mjcramerz/llama-labwc/releases/download/llama-labwc-main/llama-ram.tar.gz"\nLLAMA_RELEASE_SHA256="ccc6027ef73f7119d26517068ffcff6805aa2de853c83b8c663b0f1f4b17e636"\nLLAMA_RELEASE_BYTES="27260290"\nLLAMA_RELEASE_MAXIMUM_EXTRACTED_BYTES="67108864"\nLLAMA_RELEASE_MAXIMUM_MEMBERS="32"\nLLAMA_RELEASE_ARCHIVE_ROOT="llama-ram"\nLLAMA_RELEASE_REQUIRED_CLASS=""\nLLAMA_ROOT="/data/llama"\nLLAMA_BINARY_DIR="/data/llama/bin"\nLLAMA_METADATA_DIR="/data/llama/metadata"\nLLAMA_SHARE_DIR="/data/llama/share"\nLLAMA_WRAPPER_PATH="/data/llama/lib"\nLLAMA_MODEL_DIR="/pool/cache/llama/models"\nLLAMA_FORCE_DOWNLOAD=0\nLLAMA_DOWNLOAD_RETRIES=3\nLLAMA_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=20\nLLAMA_DOWNLOAD_MAX_TIME_SECONDS=7200\n# The 8 GiB CPU-only workstation defaults to the 1.5B coding model\n# with a bounded context and four worker threads.\nLLAMA_DEFAULT_MODEL="qwen2.5-coder-1.5b-instruct-q4_k_m.gguf"\nLLAMA_DOWNLOAD_URL="https://huggingface.co/Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF/resolve/f86cb2c1fa58255f8052cc32aeede1b7482d4361/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf"\nLLAMA_MODEL_SHA256="cc324af070c2ecbfd324a30884d2f951a7ff756aba85cb811a6ec436933bb046"\nLLAMA_MODEL_BYTES=1117320768\nLLAMA_RUNTIME_CONTEXT=8192\nLLAMA_RUNTIME_BATCH=256\nLLAMA_RUNTIME_UBATCH=128\nLLAMA_RUNTIME_THREADS=4\nLLAMA_RUNTIME_THREADS_BATCH=4\nLLAMA_RUNTIME_GPU_LAYERS=0\nLLAMA_RUNTIME_KV_OFFLOAD=0\nLLAMA_RUNTIME_PARALLEL=1\nLLAMA_SERVER_HOST="127.0.0.1"\nLLAMA_SERVER_PORT=8080\nLLAMA_STRICT_RESOURCES=0\nLLAMA_MIN_MEMORY_MIB=7000\nLLAMA_MIN_CPU_CORES=4\n\n# shellcheck shell=sh\n# shellcheck disable=SC2034\n# Shared machine identity defaults for every installer profile.\n\n# The installer generates SYSTEM_HOSTNAME once per run as\n# ${SYSTEM_PREFIX}-### and persists it in runtime.env for later stages.\n\n# Static DNS during Install\nSTATIC_NAMESERVERS_DEFAULT="1.1.1.1"\n\n# Hostname & Domain\nSYSTEM_PREFIX="LPL"\nSYSTEM_DOMAIN="lan.icramer.com"\n\n# shellcheck shell=sh\n# shellcheck disable=SC2034\n# Shared runtime paths, installer state paths, and target destination contract.\n\n# Base environment\nENV_FRONTEND="noninteractive"\nENV_PATH_DEFAULT="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"\nDEBIAN_FRONTEND="${ENV_FRONTEND}"\nPATH="${ENV_PATH_DEFAULT}"\n\n# Installed-system logging policy\n# Valid values: none, error, warning, info, debug.\n# NFTABLES_LOG_LEVEL controls nft-policy-generate diagnostics only.\nNFTABLES_LOG_LEVEL="none"\nZRAM_LOG_LEVEL="error"\nSYSTEMD_LOG_LEVEL="error"\n\n# Installer state and log locations\nDIR_INSTALLER_STATE="/var/lib/installer-state"\nDIR_STATE_LOG="${DIR_INSTALLER_STATE}/logs"\nDIR_INSTALL_LOG="${DIR_STATE_LOG}/installer"\nDIR_INITRAMFS_LOG="${DIR_STATE_LOG}/initramfs"\nDIR_FIRSTBOOT_STATE="${DIR_INSTALLER_STATE}/firstboot"\nDIR_FIRSTBOOT_LOG="${DIR_STATE_LOG}/firstboot"\nDIR_INSTALLER_RUNTIME="${INSTALLER_RUNTIME_DIR:-/tmp/install-runtime}"\nDIR_INSTALLER_LOG="/tmp"\nFILE_STORAGE_LAYOUT_LOG="${DIR_INSTALLER_LOG}/installer.log"\n\n# Shared directory layout\nDIR_ETC_DEFAULT="/etc/default"\nDIR_NETWORK="/etc/network"\nDIR_NETWORK_INTERFACES_D="${DIR_NETWORK}/interfaces.d"\nDIR_BOOT="/boot"\nDIR_BOOT_EFI="/boot/efi"\nDIR_TIMESHIFT="/etc/timeshift"\nDIR_GRUB_BTRFS_DEFAULT="/etc/default/grub-btrfs"\nDIR_ROOT_HOME="/root"\nDIR_HOME="/home"\nDIR_USR="/usr"\nDIR_OPT="/opt"\nDIR_SRV="/srv"\nDIR_POOL="/pool"\nDIR_POOL_BUILD="${DIR_POOL}/build"\nDIR_POOL_BUILD_RUNNERS="${DIR_POOL_BUILD}/runners"\nDIR_POOL_CACHE="${DIR_POOL}/cache"\nDIR_POOL_CACHE_RUNNERS="${DIR_POOL_CACHE}/runners"\nDIR_POOL_DB="${DIR_POOL}/db"\nDIR_POOL_QEMU="${DIR_POOL}/qemu"\nDIR_POOL_INCUS="${DIR_POOL}/incus"\nDIR_POOL_FIRMWARE="${DIR_POOL}/firmware"\nDIR_POOL_PODMAN="${DIR_POOL}/podman"\nDIR_POOL_LOG="${DIR_POOL}/log"\nDIR_POOL_APTLY="${DIR_POOL}/aptly"\nDIR_TMP="/tmp"\nDIR_DEV_SHM="/dev/shm"\nDIR_USR_LOCAL="/usr/local"\nDIR_USR_LOCAL_SHARE="${DIR_USR_LOCAL}/share"\nDIR_DATA="/data"\nDIR_DATA_CONFIG="${DIR_DATA}/config"\nDIR_DATA_SERVICES="${DIR_DATA}/services"\nDIR_DATA_SERVICES_USR="${DIR_DATA_SERVICES}/usr"\nDIR_DATA_BIN="${DIR_DATA}/bin"\nDIR_DATA_DOCS="${DIR_DATA}/docs"\nDIR_DATA_DOWNLOADS="${DIR_DATA}/downloads"\nDIR_DATA_PKI="${DIR_DATA}/pki"\nDIR_DATA_BACKUP="${DIR_DATA}/backup"\nDIR_RUN="/run"\nDIR_VAR="/var"\nDIR_VAR_LOG="${DIR_VAR}/log"\n