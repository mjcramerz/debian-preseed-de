+def keyring_bytes(token: str, root: Path) -> bytes | None:
+    """Read package-managed keyring links, without relaxing source-file policy.
+
+    Resolve links relative to the supplied target root, not the host filesystem.
+    Every traversed directory and link must be root-owned; directories and the
+    final regular file must not be writable by other users. Directory FDs and
+    O_NOFOLLOW prevent a pathname replacement from bypassing these checks.
+    """
