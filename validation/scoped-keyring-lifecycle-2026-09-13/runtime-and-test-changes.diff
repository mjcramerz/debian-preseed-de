+                        os.close(descriptors.pop())
+                pending.extendleft(reversed(target.split("/")))
+            elif pending:
+                child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
+                descriptors.append(child)
+            else:
+                return regular_fd(os.open(part, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
+                                          dir_fd=parent), root / token.lstrip("/"))
+        raise Error(f"keyring does not name a regular file: {token}")
+    finally:
