  "status": "Reported stock-conffile failure reproduced and fixed; full-suite baseline exceptions remain.",
  "root_cause": "The previous guard rejected any pre-existing non-managed /etc/udev/iocost.conf. Debian udev installs an inert regular conffile there; existing native test roots omitted that conffile.",
  "reproduction": {
    "returncode": 1,
    "stdout": "",
    "stderr": "IOCost: unmanaged native config preserved\n",
    "native_unchanged": true,
    "package": "257.9-1~deb13u1",
    "native_sha256": "39f985861cb49e86be2434029800eca9be9b9704f0ddb6d67465a3e037587c41"
  },
  "design": [
    "Accept only bounded root:root 0644 single-link regular native files containing comments, blanks and at most one IOCost section, with no active directive.",
    "Reject control characters, embedded NUL, active settings, unexpected sections, unsafe metadata, symlinks and special files before publication.",
    "Preserve exact original bytes behind an owned marker at the fixed native-defaults backup path before the atomic compatibility-link replacement.",
    "Reuse the existing lock, staged renderer, atomic publisher and rollback actions for the saved defaults and native link.",
    "Restore original defaults on disable or transaction failure; preserve an administrator replacement and saved defaults rather than overwriting it.",
    "Keep the native compatibility link and sole managed TargetSolution directive; do not add a service, apply cgroup values, disable IOCost or modify vendor hwdb rules.",
    "No external metadata executable dependency was introduced."
  ],
