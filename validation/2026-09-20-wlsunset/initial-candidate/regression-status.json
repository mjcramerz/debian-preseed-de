{
  "full-installer-tests": {
    "command": [
      "python3",
      "-B",
      "-m",
      "unittest",
      "discover",
      "-s",
      "d-i/forky/tests",
      "-p",
      "test_*.py"
    ],
    "returncode": 1
  },
  "full-tools-tests": {
    "command": [
      "python3",
      "-B",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tools/tests",
      "-p",
      "test_*.py"
    ],
    "returncode": 1
  },
  "shell-check": {
    "command": [
      "python3",
      "-B",
      "tools/check_shells.py"
    ],
    "returncode": 0
  },
  "build-check": {
    "command": [
      "python3",
      "-B",
      "tools/build.py",
      "--check"
    ],
    "returncode": 0
  }
}
