-CYCLE_INITIAL_NEW = '''\t/* Panel invocation keeps the current view; Alt-Tab still advances.
-\t * Ignore lock modifiers (NumLock/CapsLock) for this distinction. */
-\tuint32_t shortcut_modifiers = keyboard_get_all_modifiers(&server.seat)
-\t\t& (WLR_MODIFIER_SHIFT | WLR_MODIFIER_CTRL
-\t\t\t| WLR_MODIFIER_ALT | WLR_MODIFIER_LOGO);
-\tif (shortcut_modifiers) {
