ked CARGO_HOME when addon/devops is selected.\n# Keep the target CPU portable unless this profile names a known hardware CPU.\nDEVOPS_CARGO_RUSTC_WRAPPER="sccache"\nDEVOPS_CARGO_TARGET_TRIPLE="x86_64-unknown-linux-gnu"\nDEVOPS_CARGO_TARGET_LINKER="clang-24"\nDEVOPS_CARGO_TARGET_CPU="tigerlake"\nDEVOPS_CARGO_LINKER_ARGUMENT="-fuse-ld=mold"\n\n# Optional DevOps Bazelisk policy. These values are consumed only when\n# addon/devops is selected. Account-scoped final locations are derived by the\n# late helper from these /pool roots plus ACCOUNT_USERNAME.\nDEVOPS_BAZELISK_VERSION="1.29.0"\nDEVOPS_BAZELISK_URL="https://github.com/bazelbuild/bazelisk/releases/download/v1.29.0/bazelisk-linux-amd64"\nDEVOPS_BAZELISK_SHA256="5a408715e932c0250d28bd84555f12edbf70117de42f9181691c736eacc4a992"\nDEVOPS_BAZELISK_MINIMUM_BYTES="6000000"\nDEVOPS_BAZELISK_MAXIMUM_BYTES="8388608"\nDEVOPS_BAZELISK_INSTALL_DIR="/usr/local/lib/bazelisk"\nDEVOPS_BAZELISK_BINARY_PATH="/usr/local/lib/bazelisk/bazel"\nDEVOPS_BAZEL_CACHE_ROOT="/pool/cache"\nDEVOPS_BAZEL_BUILD_ROOT="/pool/build"\nDEVOPS_BAZEL_DB_ROOT="/pool/db"\nDEVOPS_BAZEL_CACHE_SUBDIR="bazel"\nDEVOPS_BAZEL_DISK_CACHE_SUBDIR="disk"\nDEVOPS_BAZEL_REPOSITORY_CACHE_SUBDIR="repository"\nDEVOPS_BAZEL_OUTPUT_USER_ROOT_SUBDIR="bazel/output-user-root"\nDEVOPS_BAZELISK_HOME_SUBDIR="bazelisk"\nDEVOPS_BAZEL_DISK_CACHE_SIZE="25G"\nDEVOPS_BAZEL_DISK_CACHE_MAX_AGE="45d"\nDEVOPS_BAZEL_DISK_CACHE_GC_IDLE_DELAY="5m"\nDEVOPS_BAZEL_ACTION_CACHE_MAX_AGE="45d"\nDEVOPS_BAZEL_ACTION_CACHE_GC_IDLE_DELAY="5m"\nDEVOPS_BAZEL_ACTION_CACHE_GC_THRESHOLD="10"\nDEVOPS_BAZEL_INSTALL_BASE_GC_MAX_AGE="45d"\nDEVOPS_BAZEL_SERVER_IDLE_SECONDS="900"\nDEVOPS_BAZEL_REPOSITORY_DOWNLOADER_RETRIES="3"\n\n# Optional account-local Aptly/R2 and OBS/osc publication policy. These values\n# are consumed only when addon/devops is selected. Aptly and osc state remains\n# below /pool/db/ACCOUNT_USERNAME; package cache and build work remain below\n# their matching /pool/cache and /pool/build account roots.\nDEVOPS_APTLY_ROOT_SUBDIR="aptly"\nDEVOPS_APTLY_GPG_SIGNING_KEY="/aptly-signing/aptly-jcramer.xyz-gpg.asc"\nDEVOPS_APTLY_R2_ENDPOINT_URL="https://79cc1f5f831fb7f414638c3e758e9710.r2.cloudflarestorage.com"\nDEVOPS_APTLY_R2_ENDPOINT_NAME="r2"\nDEVOPS_APTLY_R2_BUCKET="cf-aptly-r2-prod"\nDEVOPS_APTLY_R2_PREFIX="/debian"\nDEVOPS_APTLY_DISTRIBUTIONS="stable testing"\nDEVOPS_APTLY_COMPONENT="main"\nDEVOPS_APTLY_WORKER_ROUTE="apt"\nDEVOPS_APTLY_WORKER_ZONE="jcramer.xyz"\nDEVOPS_APTLY_PUBLIC_BASE_URL="https://apt.jcramer.xyz"\nDEVOPS_APTLY_REPOSITORY_KEY_FINGERPRINT="33808BDA7507EE103BADC3BCF575BD768D94A3470EFD5D17DC2C048ED01A93DC"\nDEVOPS_OSC_STATE_SUBDIR="osc"\nDEVOPS_OSC_CACHE_SUBDIR="osc"\nDEVOPS_OSC_BUILD_SUBDIR="osc"\nDEVOPS_OBS_API_URL="https://api.opensuse.org"\nDEVOPS_OBS_PROJECT="home:cramerz:debian"\nDEVOPS_OBS_REPOSITORY="Debian_Unstable"\nDEVOPS_OSC_CREDENTIALS_BACKEND="keyring.backends.SecretService.Keyring"\n\n# Optional direct QEMU/KVM and confined Incus policy. The local Web UI is\n# exposed only through the package-owned Unix socket when addon/qemu is selected.\nINCUS_BRIDGE_NAME="incusbr0"\n\n# Optional Podman addon policy. These values are consumed only when the\n# addon/podman class is selected.\nPODMAN_USER="devops"\nPODMAN_USER_HOME="/nonexistent"\nPODMAN_ROOTLESS_STATE_BASE="/pool/podman"\n# auto selects native OverlayFS on approved local filesystems; no silent fallback.\nPODMAN_STORAGE_DRIVER="auto"\n# Limits apply to the entire UID slice, including delegated container scopes.\nPODMAN_SERVICE_SLICE_CPU_WEIGHT=100\nPODMAN_SERVICE_SLICE_IO_WEIGHT=100\nPODMAN_SERVICE_SLICE_TASKS_MAX=8192\nPODMAN_SERVICE_SLICE_MEMORY_HIGH="70%"\nPODMAN_SERVICE_SLICE_MEMORY_MAX="85%"\n\n# Optional checksum-pinned whisper.cpp voice-task runtime. These values are\n# consumed only when addon/whisper is selected. The release archive and model\n# are independently integrity-pinned unattended-install inputs.\nWHISPER_RELEASE_URL="https://github.com/mjcramerz/whisper-labwc/releases/download/whisper-labwc-main/whisper-ram.tar.gz"\nWHISPER_RELEASE_SHA256="23a0db1cb6892a6fd2bcf41f5ff6f069bb1bc1cef8728fcc223a22fb16bc477b"\nWHISPER_RELEASE_MINIMUM_BYTES="4096"\nWHISPER_RELEASE_MAXIMUM_EXTRACTED_BYTES="8388608"\nWHISPER_RELEASE_MAXIMUM_MEMBERS="16"\nWHISPER_RELEASE_ARCHIVE_ROOT="whisper-ram"\nWHISPER_RELEASE_REQUIRED_CLASS=""\nWHISPER_ROOT="/data/whisper"\nWHISPER_BINARY_DIR="/data/whisper/bin"\nWHISPER_METADATA_DIR="/data/whisper/metadata"\nWHISPER_MODEL_DIR="/pool/cache/whisper/models"\nWHISPER_DOWNLOAD_RETRIES="3"\nWHISPER_DOWNLOAD_CONNECT_TIMEOUT_SECONDS="20"\nWHISPER_DOWNLOAD_MAX_TIME_SECONDS="7200"\nWHISPER_HF_TOKEN=""\nWHISPER_STRICT_RESOURCES=0\nWHISPER_FORCE_DOWNLOAD=0\nWHISPER_RUNTIME_THREADS="auto"\nWHISPER_PERSISTENT_MEM=0\nWHISPER_SERVER_PORT="59178"\nWHISPER_DEFAULT_MODEL="small.en-q8_0"\nWHISPER_DOWNLOAD_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/0b364b566045a405be7225ee1e415a073e04da77/ggml-small.en-q8_0.bin"\nWHISPER_MODEL_SHA256="67a179f608ea6114bd3fdb9060e762b588a3fb3bd00c4387971be4d177958067"\nWHISPER_MODEL_MIN_BYTES=264477561\nWHISPER_MIN_MEMORY_MIB=0\nWHISPER_MIN_CPU_CORES=0\n\n# Optional checksum-pinned llama.cpp coding-assistant runtime. These values are\n# consumed only when addon/devops is selected. The release archive is profile\n# policy; model selection and runtime tuning remain independently replaceable.\n# All five release executables are installed below LLAMA_BINARY_DIR.\nLLAMA_RELEASE_URL="https://github.com/mjcramerz/llama-labwc/releases/download/llama-labwc-main/llama-ram.tar.gz"\nLLAMA_RELEASE_SHA256="ccc6027ef73f7119d26517068ffcff6805aa2de853c83b8c663b0f1f4b17e636"\nLLAMA_RELEASE_MINIMUM_BYTES="5242880"\nLLAMA_RELEASE_MAXIMUM_EXTRACTED_BYTES="67108864"\nLLAMA_RELEASE_MAXIMUM_MEMBERS="32"\nLLAMA_RELEASE_ARCHIVE_ROOT="llama-ram"\nLLAMA_RELEASE_REQUIRED_CLASS=""\nLLAMA_ROOT="/data/llama"\nLLAMA_BINARY_DIR="/data/llama/bin"\nLLAMA_METADATA_DIR="/data/llama/metadata"\nLLAMA_SHARE_DIR="/data/llama/share"\nLLAMA_WRAPPER_PATH="/data/llama/lib"\nLLAMA_MODEL_DIR="/pool/cache/llama/models"\nLLAMA_FORCE_DOWNLOAD=0\nLLAMA_DOWNLOAD_RETRIES=3\nLLAMA_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=20\nLLAMA_DOWNLOAD_MAX_TIME_SECONDS=7200\n# The 8 GiB CPU-only workstation defaults to the 1.5B coding model\n# with a bounded context and four worker threads.\nLLAMA_DEFAULT_MODEL="qwen2.5-coder-1.5b-instruct-q4_k_m.gguf"\nLLAMA_DOWNLOAD_URL="https://huggingface.co/Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF/resolve/f86cb2c1fa58255f8052cc32aeede1b7482d4361/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf"\nLLAMA_MODEL_SHA256="cc324af070c2ecbfd324a30884d2f951a7ff756aba85cb811a6ec436933bb046"\nLLAMA_MODEL_MINIMUM_BYTES=223346688\nLLAMA_RUNTIME_CONTEXT=8192\nLLAMA_RUNTIME_BATCH=256\nLLAMA_RUNTIME_UBATCH=128\nLLAMA_RUNTIME_THREADS=4\nLLAMA_RUNTIME_THREADS_BATCH=4\nLLAMA_RUNTIME_GPU_LAYERS=0\nLLAMA_RUNTIME_KV_OFFLOAD=0\nLLAMA_RUNTIME_PARALLEL=1\nLLAMA_SERVER_HOST="127.0.0.1"\nLLAMA_SERVER_PORT=8080\nLLAMA_STRICT_RESOURCES=0\nLLAMA_MIN_MEMORY_MIB=7000\nLLAMA_MIN_CPU_CORES=4\n\n# Systemd accounting and user resource classes. These do not change explicit\n# unit policy for zram, Podman, user-1000.slice, or other existing workloads.\n# Independent switches: accounting controls both manager defaults only;\n# Each weight switch independently controls its resource-policy directives.\n# An empty per-unit directive inherits its parent policy; false omits all\n# corresponding CPU/IO weight directives from these resource-policy assets.\n# Neither disables controller delegation nor erases original workload policy.\nSYSTEMD_DEFAULT_IOACCOUNTING_ENABLE="false"\nSYSTEMD_IOWEIGHT_ENABLE="false"\nSYSTEMD_CPUWEIGHT_ENABLE="false"\nSYSTEMD_CPUWEIGHT_HOME_USER_SESSION_SLICE_D="CPUWeight=200"\nSYSTEMD_CPUWEIGHT_HOME_USER_APP_SLICE_D="CPUWeight=100"\nSYSTEMD_CPUWEIGHT_HOME_USER_BACKGROUND_SLICE_D="CPUWeight=30"\nSYSTEMD_IOWEIGHT_HOME_USER_SESSION_SLICE_D="IOWeight=200"\nSYSTEMD_IOWEIGHT_HOME_USER_APP_SLICE_D="IOWeight=100"\nSYSTEMD_IOWEIGHT_HOME_USER_BACKGROUND_SLICE_D="IOWeight=30"\n\n# Per-service exception: compositor responsiveness within session.slice.\nSYSTEMD_CPUWEIGHT_HOME_USER_LABWC_COMPOSITOR_SERVICE_D="CPUWeight=300"\nSYSTEMD_IOWEIGHT_HOME_USER_LABWC_COMPOSITOR_SERVICE_D="IOWeight=300"\n# Audio CPU preference only; do not add disk weights or real-time privileges.\nSYSTEMD_CPUWEIGHT_USER_AUDIO_SERVICE_D="CPUWeight=200"\n\n# Aggregate system classes beneath system.slice (not new root-level budgets).\nSYSTEMD_CPUWEIGHT_SYSTEM_MAINTENANCE_SLICE_D="CPUWeight=30"\nSYSTEMD_IOWEIGHT_SYSTEM_MAINTENANCE_SLICE_D="IOWeight=30"\nSYSTEMD_CPUWEIGHT_SYSTEM_BACKGROUND_SLICE_D="CPUWeight=50"\nSYSTEMD_IOWEIGHT_SYSTEM_BACKGROUND_SLICE_D="IOWeight=50"\n\n# Bounded small-core retention for the existing coredump store. These are\n# deployment defaults, not measured per-host budgets. Large desktop cores need\n# a deliberate increase after checking available RAM/storage and tmpfs sizing.\nSYSTEMD_COREDUMP_STORAGE="external"\nSYSTEMD_COREDUMP_PROCESS_SIZE_MAX="64M"\nSYSTEMD_COREDUMP_EXTERNAL_SIZE_MAX="64M"\nSYSTEMD_COREDUMP_MAX_USE="128M"\nSYSTEMD_COREDUMP_KEEP_FREE="32M"\n\n# Concurrent dump workers and self-recovering socket polling throttle.\n# Seconds are integers; no per-source UID limit or tight fatal trigger limit.\nSYSTEMD_COREDUMP_POLL_LIMIT_INTERVAL_SEC="2"\nSYSTEMD_COREDUMP_POLL_LIMIT_BURST="64"\n\n# Journal storage only: never changes partitions, mounts, or existing journal files.\n# false preserves persistent storage; true selects Storage=volatile.\nSYSTEMD_JOURNAL_VOLATILE_ENABLE="false"\n\n# Preserve the original journal size/retention defaults; profile overrides are allowed.\nSYSTEMD_JOURNAL_SYSTEM_MAX_USE="1G"\nSYSTEMD_JOURNAL_SYSTEM_KEEP_FREE="256M"\nSYSTEMD_JOURNAL_SYSTEM_MAX_FILE_SIZE="128M"\nSYSTEMD_JOURNAL_SYSTEM_MAX_FILES="16"\nSYSTEMD_JOURNAL_RUNTIME_MAX_USE="128M"\nSYSTEMD_JOURNAL_RUNTIME_KEEP_FREE="64M"\nSYSTEMD_JOURNAL_RUNTIME_MAX_FILE_SIZE="16M"\nSYSTEMD_JOURNAL_RUNTIME_MAX_FILES="16"\n\n# Orderly shutdown: broker-only stop grace in seconds (5..120).\n# Not a hardware watchdog setting or a global user/service stop deadline.\nDBUS_BROKER_TIMEOUT_STOP_SEC="30"\n\n# Hardware tuning: opt-in installation, runtime automatic tuning off by default.\n# Advertised hardware bounds are resolved on the installed host; keep means no write.\n# See docs/hardware-tuning/README.md for safety gates, units and per-device overrides.\nHARDWARE_TUNING_AUTOSTART_ENABLE="false"\nHARDWARE_TUNING_POLL_SECONDS="5"\nHARDWARE_TUNING_IDLE_AC="balanced"\nHARDWARE_TUNING_IDLE_BATTERY="silent"\n\nHARDWARE_INTEL_CPU_TUNING_ENABLE="false"\nHARDWARE_INTEL_CPU_TUNING_ALLOW_OVERCLOCK="false"\nHARDWARE_INTEL_CPU_TUNING_ALLOW_POWER_INCREASE="false"\nHARDWARE_INTEL_CPU_TUNING_EXCLUSIVE_CLOCK_CONTROL="false"\nHARDWARE_INTEL_CPU_TUNING_MAX_TEMPERATURE_C="85"\n# INTEL_CPU performance profile.\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_CPU_GOVERNOR="adaptive"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_CPU_EPP="performance"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_CPU_EPB="0"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_CPU_MIN_PERF_PCT="keep"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_CPU_MAX_PERF_PCT="100"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_CPU_NO_TURBO="0"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_CPU_HWP_DYNAMIC_BOOST="1"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_CPU_MIN_FREQ_KHZ="keep"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_CPU_MAX_FREQ_KHZ="keep"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_UNCORE_MIN_FREQ_KHZ="keep"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_UNCORE_MAX_FREQ_KHZ="keep"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_GPU_MIN_FREQ_MHZ="keep"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_GPU_MAX_FREQ_MHZ="max"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_GPU_BOOST_FREQ_MHZ="max"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_RAPL_PL1_POWER_UW="keep"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_RAPL_PL1_WINDOW_US="keep"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_RAPL_PL2_POWER_UW="keep"\nHARDWARE_INTEL_CPU_TUNING_PERFORMANCE_RAPL