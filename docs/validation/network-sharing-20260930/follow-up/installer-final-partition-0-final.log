n    while True:\n        signal.pause()\n\n\ndef sleep_guard() -> int:\n    # sleep.target REQUIRES this Type=notify service, ordered before the target.\n    # Unlike a late system-sleep script, readiness is withheld until packages\n    # finish, and the locks remain held through both pre- and post-sleep hooks.\n    # Take the action lock BEFORE package locks; never reserve the package\n    # database while waiting for a desktop worker that needs it to finish.\n    with action_lock(wait=True):\n        with PackageLocks():\n            ready()\n            status("Package locks reserved for the complete sleep/resume cycle")\n            hold_reservation()\n    return 0\n\n\ndef bounded_output(proc, timeout: float, limit: int) -> tuple[str, str]:\n    """Drain both transport pipes with a deadline and an enforced memory bound."""\n    deadline = time.monotonic() + timeout\n    buffers = {proc.stdout: bytearray(), proc.stderr: bytearray()}\n    with selectors.DefaultSelector() as poller:\n        for stream in buffers:\n            poller.register(stream, selectors.EVENT_READ)\n        while poller.get_map():\n            remaining = deadline - time.monotonic()\n            if remaining <= 0:\n                raise subprocess.TimeoutExpired(proc.args, timeout)\n            for key, _ in poller.select(remaining):\n                stream = key.fileobj\n                chunk = os.read(stream.fileno(), 16_384)\n                if not chunk:\n                    poller.unregister(stream)\n                    continue\n                # stderr is diagnostic only; neither pipe may grow without bound.\n                maximum = limit if stream is proc.stdout else 16_384\n                if len(buffers[stream]) + len(chunk) > maximum:\n                    raise Error("power transport output exceeded its size limit")\n                buffers[stream].extend(chunk)\n    remaining = deadline - time.monotonic()\n    if remaining <= 0:\n        raise subprocess.TimeoutExpired(proc.args, timeout)\n    proc.wait(timeout=remaining)\n    return tuple(bytes(buffers[stream]).decode("utf-8", errors="replace")\n                 for stream in (proc.stdout, proc.stderr))\n\n\ndef run(argv: list[str], *, timeout: float = 25, accepted: tuple[int, ...] = (0,),\n        max_output: int | None = None, account=None) -> str:\n    # Each local transport gets its own process group. On a timeout, reap the\n    # whole transport rather than leaving a stdio bridge holding our pipes open.\n    child_env = dict(ENV)\n    credentials = {}\n    if account is not None:\n        # Direct credential drop, NOT PAM/runuser or --machine=user@.host.\n        # The latter creates one short-lived login session per query and races\n        # logind peer credential acquisition. Only trusted passwd data is used.\n        if not 0 < account.pw_uid < 2**32 - 1 or not 0 <= account.pw_gid < 2**32 - 1:\n            raise Error("invalid user-manager credentials")\n        runtime = f"/run/user/{account.pw_uid}"\n        child_env.update(HOME=account.pw_dir, USER=account.pw_name,\n                         LOGNAME=account.pw_name, XDG_RUNTIME_DIR=runtime,\n                         DBUS_SESSION_BUS_ADDRESS="unix:path=" + runtime + "/bus")\n        credentials = dict(user=account.pw_uid, group=account.pw_gid, extra_groups=())\n    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,\n                            stderr=subprocess.PIPE, text=True, env=child_env,\n                            start_new_session=True, close_fds=True, **credentials)\n    communicated = False\n    try:\n        try:\n            if max_output is None:\n                output, error = proc.communicate(timeout=timeout)\n            else:\n                output, error = bounded_output(proc, timeout, max_output)\n            communicated = True\n        except subprocess.TimeoutExpired:\n            raise Error(f"{Path(argv[0]).name} timed out after {timeout}s") from None\n        if error:\n            # stderr is diagnostic, unlike stdout carrying parsed D-Bus/API data.\n            print(error.rstrip()[:16_384], file=sys.stderr, flush=True)\n        if proc.returncode not in accepted:\n            raise Error(f"{Path(argv[0]).name} exited {proc.returncode}: {error.strip()[:1000]}")\n        return output\n    finally:\n        # Do not kill a successfully drained local transport: its PAM/logind\n        # release may still be finishing. Killing that peer unconditionally can\n        # race credential acquisition. Cancellation/timeout still reaps the\n        # whole process group, including pipe-holding bridge descendants.\n        if not communicated:\n            try:\n                os.killpg(proc.pid, signal.SIGKILL)\n            except ProcessLookupError:\n                pass\n        try:\n            # Keep the original bounded reap even for an uninterruptible child;\n            # systemd retains the final cgroup stop boundary on cancellation.\n            proc.wait(timeout=2)\n        finally:\n            proc.stdout.close()\n            proc.stderr.close()\n\n\ndef ready() -> None:\n    # Type=notify makes the pkexec frontend observe startup/authorization errors\n    # before any application is closed. Only this main process may acknowledge.\n    address = os.environ.get("NOTIFY_SOCKET", "")\n    if not address or address[0] not in "/@":\n        raise Error("power worker requires its systemd notification socket")\n    if address.startswith("@"):\n        address = "\\0" + address[1:]\n    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as notifier:\n        notifier.settimeout(2)\n        notifier.connect(address)\n        notifier.sendall(b"READY=1\\nSTATUS=Authorized desktop power request accepted")\n\n\ndef check_shutdown_inhibitors() -> None:\n    """Veto known block locks; single --force bypasses logind delay handling.\n\n    This snapshot is not an atomic inhibitor reservation. The final PID 1\n    handoff does not emit logind PrepareForShutdown or wait for delay locks.\n    """\n    raw = run(["/usr/bin/busctl", "--system", "--json=short", "--timeout=5s",\n               "call", "org.freedesktop.login1", "/org/freedesktop/login1",\n               "org.freedesktop.login1.Manager", "ListInhibitors"], timeout=7, max_output=1_048_576)\n    try:\n        if len(raw) > 1_048_576:\n            raise ValueError("oversized inhibitor response")\n        result = json.loads(raw)\n        if not isinstance(result, dict) or result.get("type") != "a(ssssuu)":\n            raise ValueError("unexpected inhibitor signature")\n        data = result.get("data")\n        if not isinstance(data, list) or len(data) != 1 or not isinstance(data[0], list) or len(data[0]) > 1024:\n            raise ValueError("invalid inhibitor array")\n        for item in data[0]:\n            if (not isinstance(item, list) or len(item) != 6\n                    or any(not isinstance(value, str) or len(value) > 4096 for value in item[:4])\n                    or any(type(value) is not int or not 0 <= value < 2**32 for value in item[4:])):\n                raise ValueError("invalid inhibitor record")\n            if "shutdown" in item[0].split(":") and item[3] != "delay":\n                if item[3] not in {"block", "block-weak"}:\n                    raise Error("unrecognized shutdown inhibitor mode")\n                # Do not log caller-supplied inhibitor strings or sensitive data.\n                raise Error(f"shutdown is inhibited by uid={item[4]} pid={item[5]}; "\n                            "release the inhibitor before retrying")\n    except (ValueError, RecursionError) as exc:\n        raise Error("cannot verify shutdown inhibitors") from exc\n\n\ndef login_sessions() -> list[tuple[str, int]]:\n    """Read bounded, typed logind records rather than presentation columns."""\n    raw = run(["/usr/bin/busctl", "--system", "--json=short", "--timeout=5s",\n               "call", "org.freedesktop.login1", "/org/freedesktop/login1",\n               "org.freedesktop.login1.Manager", "ListSessions"], timeout=7, max_output=131_072)\n    try:\n        if len(raw) > 131_072:\n            raise ValueError("oversized session response")\n        result = json.loads(raw)\n        if not isinstance(result, dict) or result.get("type") != "a(susso)":\n            raise ValueError("unexpected session signature")\n        data = result.get("data")\n        if (not isinstance(data, list) or len(data) != 1\n                or not isinstance(data[0], list) or len(data[0]) > 1024):\n            raise ValueError("invalid session array")\n        sessions = []\n        seen = set()\n        for row in data[0]:\n            if (not isinstance(row, list) or len(row) != 5\n                    or not isinstance(row[0], str)\n                    or re.fullmatch(r"[A-Za-z0-9_-]{1,64}", row[0]) is None\n                    or type(row[1]) is not int or not 0 <= row[1] < 2**32\n                    or any(not isinstance(value, str) or len(value) > 4096 for value in row[2:])\n                    or not row[4].startswith("/org/freedesktop/login1/session/")\n                    or row[0] in seen):\n                raise ValueError("invalid session record")\n            seen.add(row[0])\n            sessions.append((row[0], row[1]))\n        return sessions\n    except (ValueError, RecursionError) as exc:\n        raise Error("cannot verify login sessions") from exc\n\n\nclass Worker:\n    def __init__(self, uid: int, user: str, action: str, *, greeter: bool = False):\n        self.uid, self.user, self.action = uid, user, action\n        self.greeter = greeter\n        self.greeter_identity: tuple[str, str] | None = None\n        self.package_locks = None\n        self.committed = False\n        self.prepared = False\n        self.handoff_attempted = False\n\n    def user_run(self, argv: list[str], **kwargs) -> str:\n        account = pwd.getpwuid(self.uid)\n        if account.pw_name != self.user:\n            raise Error("invoking account changed during power preparation")\n        # The address is derived from the authorized UID; never accept caller\n        # bus addresses, injected environment variables or an arbitrary command.\n        runtime = Path(f"/run/user/{self.uid}")\n        meta = runtime.lstat()\n        if (not stat.S_ISDIR(meta.st_mode) or meta.st_uid != self.uid\n                or stat.S_IMODE(meta.st_mode) != 0o700):\n            raise Error("unsafe or unavailable authorized user bus")\n        return run(argv, account=account, **kwargs)\n\n    def userctl(self, *args: str, **kwargs) -> str:\n        return self.user_run(["/usr/bin/systemctl", "--user", "--no-pager",\n                              "--no-ask-password", *args], **kwargs)\n\n    def helper(self, action: str) -> None:\n        if action not in {"prepare", "cancel", "locked", "error", "waiting"}:\n            raise Error("invalid desktop state operation")\n        # This is a USER unit, not a PID-1 service with User=. Its manager owns\n        # the desktop environment and executes the helper without root rights.\n        if action == "prepare":\n            # Reset any retained result from an interrupted prior worker. The\n            # prepare-only RemainAfterExit drop-in prevents successful status\n            # 77 being garbage-collected and mistaken for a fresh status 0.\n            self.userctl("stop", "labwc-session-state@prepare.service", timeout=15)\n        self.userctl("start", "labwc-session-state@" + action + ".service",\n                     timeout=300 if action == "prepare" else 15)\n        if action == "prepare":\n            response = self.userctl("show", "labwc-session-state@prepare.service",\n                "--property=ActiveState,SubState,Result,ExecMainStatus", timeout=10)\n            props = {}\n            for line in response.splitlines():\n                key, separator, value = line.partition("=")\n                if not separator or key in props:\n                    raise Error("invalid session preparation properties")\n                props[key] = value\n            if (props.get("ActiveState") != "active" or props.get("SubState") != "exited"\n                    or props.get("Result") != "success"):\n                raise Error("cannot verify retained session preparation completion")\n            # Only release the retained unit AFTER reading its exit status.\n            self.userctl("stop", "labwc-session-state@prepare.service", timeout=15)\n            if props.get("ExecMainStatus") == "77":\n                raise Cancelled("user/save veto; no session teardown or power action performed")\n            if props.get("ExecMainStatus") != "0":\n                raise Error("unexpected session preparation status")\n\n    @staticmethod\n    def session_properties(session_id: str) -> dict[str, str]:\n        keys = ("User", "Name", "Class", "Active", "Remote", "Service", "Leader")\n        # loginctl takes one property name per option; a comma-separated value\n        # requests a nonexistent property and silently omits the real fields.\n        raw = run(["/usr/bin/loginctl", "show-session", session_id, "--all",\n                   *("--property=" + key for key in keys)],\n                  timeout=5, max_output=8192)\n        props = {}\n        for item in raw.splitlines():\n            key, separator, value = item.partition("=")\n            if not separator or key not in keys or key in props:\n                raise Error("invalid greeter session properties")\n            props[key] = value\n        if set(props) != set(keys):\n            raise Error("incomplete greeter session properties")\n        return props\n\n    def protect_other_sessions(self) -> None:\n        if self.action == "logout":\n            return\n        sessions = login_sessions()\n        interactive = {"user", "user-early", "user-light", "user-early-light", "user-incomplete", "lock-screen"}\n        greeters = []\n        for session_id, session_uid in sessions:\n            fields = (session_id, str(session_uid))\n            if int(fields[1]) == self.uid:\n                if not self.greeter:\n                    continue\n                # Polkit authorized an active/local greeter, not every future\n                # session of that account. Revalidate before the PID 1 handoff.\n                props = self.session_properties(fields[0])\n                if props["Class"] != "user-light":\n                    if props["Class"] in interactive:\n                        raise Error("a greeter power request cannot bypass an interactive desktop")\n                    continue  # A user-manager/background session is not the greeter.\n                expected = {"User": str(self.uid), "Name": self.user, "Active": "yes",\n                            "Remote": "no", "Service": "greetd-greeter"}\n                if (any(props[key] != value for key, value in expected.items())\n                        or not re.fullmatch(r"[1-9][0-9]{0,9}", props["Leader"])\n                        or int(props["Leader"]) >= 2**31):\n                    raise Error("the authorized active local greeter session is no longer available")\n                greeters.append((fields[0], props["Leader"]))\n                continue\n            session_class = run(["/usr/bin/loginctl", "show-session", fields[0],\n                                 "--property=Class", "--value"], timeout=5, max_output=256).strip()\n            if session_class == "user-light" and not self.greeter:\n                # greetd starts its own session as soon as the compositor\n                # exits. This non-desktop greeter must not veto an already\n                # prepared request merely because it appeared after stop.\n                # Recheck logind\'s PAM service and local identity before\n                # excluding it from the other-interactive-user veto.\n                props = self.session_properties(fields[0])\n                try:\n                    account = pwd.getpwuid(int(fields[1]))\n                except KeyError as exc:\n                    raise Error("unrecognized greeter account") from exc\n                if (props["Class"] == "user-light" and props["Service"] == "greetd-greeter"\n                        and props["Remote"] == "no" and props["User"] == fields[1]\n                        and props["Name"] == account.pw_name\n                        and props["Active"] in {"yes", "no"}\n                        and re.fullmatch(r"[1-9][0-9]{0,9}", props["Leader"])\n                        and int(props["Leader"]) < 2**31):\n                    continue\n            if session_class in interactive:\n                raise Error(f"another interactive account is logged in (uid={session_uid}, "\n                            f"session={session_id}); ask that user to save and log out first")\n            if session_class not in {"background", "background-light", "manager", "manager-early", "greeter"}:\n                raise Error(f"cannot verify other login session {session_id}; class is unknown")\n        if self.greeter:\n            if len(greeters) != 1:\n                raise Error("cannot identify one active local greeter session")\n            identity = greeters[0]\n            if self.greeter_identity is not None and identity != self.greeter_identity:\n                raise Error("greeter session changed while power was pending; submit a new request")\n            self.greeter_identity = identity\n\n    def lock(self) -> None:\n        # Type=forking waits for labwc-lock\'s swaylock -f readiness handshake.\n        # Unlike an exec oneshot, its daemon stays in a live independent unit.\n        self.user_run(["/usr/bin/systemd-run", "--user",\n             "--quiet", "--collect", "--service-type=forking", "--expand-environment=no",\n             "--unit=labwc-power-lock-" + uuid.uuid4().hex + ".service",\n             "--property=Requisite=labwc-session.target", "--property=After=labwc-session.target",\n             "--property=PartOf=labwc-session.target", "--property=TimeoutStartSec=20s",\n             "--property=TimeoutStopSec=5s", "--property=KillMode=control-group",\n             "--property=PrivatePIDs=no", "--property=PrivateUsers=no",\n             "--", "/usr/local/bin/labwc-lock"], timeout=25)\n        self.helper("locked")\n\n    def best_effort(self, description: str, callback) -> None:\n        try:\n            callback()\n        except (Error, OSError, subprocess.SubprocessError) as exc:\n            print(f"power cleanup ({description}): {exc}", file=sys.stderr, flush=True)\n\n    def remaining(self) -> bool:\n        # Query the manager, not /proc of other AppArmor domains. PID 1/logind\n        # already own every managed user unit and login-session cgroup.\n        state = run(["/usr/bin/systemctl", "show", f"user-{self.uid}.slice",\n                     "--property=ActiveState", "--value"], timeout=5).strip()\n        if state not in {"active", "activating", "deactivating", "inactive", "failed"}:\n            raise Error("cannot determine the invoking user\'s slice state")\n        return state not in {"inactive", "failed"}\n\n    def wait_for_exit(self, seconds: float) -> bool:\n        deadline = time.monotonic() + seconds\n        while True:\n            try:\n                if not self.remaining():\n                    return True\n            except (Error, OSError, subprocess.SubprocessError) as exc:\n                print(f"power cleanup (slice state): {exc}", file=sys.stderr, flush=True)\n                return False\n            if time.monotonic() >= deadline:\n                return False\n            time.sleep(0.2)\n\n    def terminate_user(self) -> None:\n        # Logout is account-local. Machine power uses the separate single-\n        # force handoff; do not tear down its IPC or seat before submitting.\n        if self.action != "logout":\n            raise Error("account teardown is only valid for logout")\n        self.require_package_reservation()\n        # Once committed, one failed stop must not strand a half-closed desktop.\n        # Queue stops first (disabling restart), then use PID 1\'s cgroup-wide\n        # TERM/KILL paths. No process-name matching and no caller-owned worker.\n        self.best_effort("desktop units", lambda: self.userctl(\n            "--no-block", "stop", "labwc-session.target", "labwc-compositor.service", timeout=10))\n        self.best_effort("login sessions", lambda: run(\n            ["/usr/bin/loginctl", "terminate-user", str(self.uid)], timeout=10))\n        self.best_effort("user manager and slice", lambda: run(\n            ["/usr/bin/systemctl", "--no-block", "stop", f"user@{self.uid}.service",\n             f"user-{self.uid}.slice"], timeout=10))\n        if self.wait_for_exit(1):\n            return\n        for sig, grace in (("TERM", 3), ("KILL", 3)):\n            self.best_effort(sig + " user cgroups", lambda: run(\n                ["/usr/bin/systemctl", "kill", "--kill-whom=all", "--signal=" + sig,\n                 f"user-{self.uid}.slice"], timeout=5))\n            if self.wait_for_exit(grace):\n                return\n        raise Error("user slice did not stop; inspect the power action log")\n\n    def stop_optional_guests(self) -> None:\n        self.require_package_reservation()\n        # These fixed names are optional when the corresponding addon is not\n        # installed. An installed, running hook must complete successfully.\n        # Stopping a oneshot with RemainAfterExit runs its vendor ExecStop. It\n        # does not start the hook, its daemon, or any shutdown barrier.\n        selected = []\n        for name in GUEST_STOP_UNITS:\n            text = run(["/usr/bin/systemctl", "show", name,\n                        "--property=LoadState,ActiveState"], timeout=10)\n            props = dict(line.split("=", 1) for line in text.splitlines() if "=" in line)\n            if props.get("LoadState") == "not-found":\n                continue\n            if props.get("ActiveState") == "inactive":\n                continue\n            if props.get("LoadState") != "loaded" or props.get("ActiveState") not in {\n                    "active", "activating", "reloading", "deactivating"}:\n                raise Error(f"cannot safely stop guest hook: {name}")\n            selected.append(name)\n        if selected:\n            run(["/usr/bin/systemctl", "--no-ask-password", "stop", *selected], timeout=180)\n            for name in selected:\n                text = run(["/usr/bin/systemctl", "show", name,\n                            "--property=ActiveState,Result"], timeout=10)\n                props = dict(line.split("=", 1) for line in text.splitlines() if "=" in line)\n                if props.get("ActiveState") != "inactive" or props.get("Result") != "success":\n                    raise Error(f"guest shutdown did not complete cleanly: {name}")\n\n    def final_power_action(self) -> None:\n        if self.action not in {"reboot", "poweroff"}:\n            raise Error("invalid machine shutdown action")\n        if not (self.prepared or self.greeter) or self.handoff_attempted:\n            raise Error("handoff requires a prepared desktop and may run only once")\n        self.require_package_reservation()\n        self.protect_other_sessions()\n        check_shutdown_inhibitors()\n        self.require_package_reservation()\n        # Preparation and managed guest ExecStop hooks have already completed.\n        # Keep the compositor, seat and buses alive until PID 1 takes over: do\n        # not add a shutdown.target transaction or a pre-handoff seat teardown.\n        os.sync()\n        self.require_package_reservation()\n        status(f"Power handoff: systemctl --force {self.action}; single-force PID 1 shutdown")\n        self.require_package_reservation()\n        self.committed = True\n        self.handoff_attempted = True\n        # Exactly ONE --force is the selected path, not a failure fallback. It\n        # bypasses the ordinary unit-stop transaction and logind delay handling;\n        # PID 1 still terminates processes and unmounts/remounts filesystems.\n        # Never use double force, reboot(2), a raw reboot/poweroff utility, or a\n        # shell command. The fixed environment disables auto kexec/soft-reboot.\n        try:\n            run(["/usr/bin/systemctl", "--force", self.action],\n                timeout=25, max_output=4096)\n        except (Error, OSError, subprocess.SubprocessError) as exc:\n            # A lost acknowledgement may follow an accepted request. Do not\n            # resend, escalate force, start another target, or revive the desktop.\n            raise Error(f"{self.action} handoff status uncertain; do not retry automatically: {exc}") from exc\n\n    def require_package_reservation(self) -> None:\n        if self.package_locks is None:\n            raise Error("power action requires an active package lock reservation")\n        self.package_locks.verify()\n\n    def package_waiting(self) -> None:\n        if not self.greeter:\n            self.best_effort("package-wait notification", lambda: self.helper("waiting"))\n\n    def session_identity(self) -> str:\n        self.userctl("--quiet", "is-active", DESKTOP_TARGET)\n        identity = self.userctl("show", COMPOSITOR, "--property=InvocationID", "--value").strip()\n        if not re.fullmatch(r"[0-9a-f]{32}", identity) or identity == "0" * 32:\n            raise Error("cannot identify the invoking desktop session")\n        return identity\n\n    def execute(self) -> None:\n        identity = None if self.greeter else self.session_identity()\n        self.protect_other_sessions()\n        if self.action == "suspend":\n            self.lock()\n        # Startup/authorization is acknowledged before an unbounded package\n        # wait. The system worker, not pkexec/Waybar, owns the pending request.\n        ready()\n        with PackageLocks(self.package_waiting) as reservation:\n            self.package_locks = reservation\n            try:\n                # A long upgrade may outlive the original desktop or login.\n                # Never apply its old request to a newly started compositor.\n                if not self.greeter and self.session_identity() != identity:\n                    raise Error("desktop session changed while waiting for package activity")\n                self.protect_other_sessions()\n                if self.greeter:\n                    if self.action not in {"poweroff", "reboot"}:\n                        raise Error("invalid greeter power action")\n                    self.require_package_reservation()\n                    check_shutdown_inhibitors()\n                    # No desktop belongs to this greeter request; the account\n                    # guard above has excluded other interactive users. Share\n                    # the guest-stop and single-force PID 1 handoff path.\n                    self.stop_optional_guests()\n                    self.final_power_action()\n                    hold_reservation()\n                    return\n                if self.action == "suspend":\n                    # A user may unlock the desktop during a long package wait.\n                    # Cancel rather than suspending an unlocked session later.\n                    self.helper("locked")\n                    self.require_package_reservation()\n                    # The required sleep.target guard independently reserves\n                    # the locks until resume. systemctl suspend is asynchronous.\n                    run(["/usr/bin/systemctl", "--check-inhibitors=yes",\n                         "--no-ask-password", "suspend"], timeout=60)\n                    return\n                self.helper("prepare")\n                self.prepared = True\n                self.protect_other_sessions()\n                self.require_package_reservation()\n                if self.action == "logout":\n                    self.committed = True\n                    self.terminate_user()\n                else:\n                    check_shutdown_inhibitors()\n                    # An optional guest hook can fail or time out. Complete\n                    # those checks while the desktop is still available.\n                    self.stop_optional_guests()\n                    # Detect session replacement before the single-force\n                    # handoff; keep the authorized seat alive until then.\n                    if self.session_identity() != identity:\n                        raise Error("desktop session changed during power preparation")\n                    self.final_power_action()\n                    # Never release locks just because the enqueue call returned.\n                    hold_reservation()\n            finally:\n                self.package_locks = None\n\n\ndef main(argv: list[str]) -> int:\n    if os.geteuid() != 0 or len(argv) != 1:\n        raise Error("usage (system service only): labwc-admin-action-worker UID-ACTION or --sleep-guard")\n    if argv == ["--sleep-guard"]:\n        return sleep_guard()\n    match = re.fullmatch(r"([1-9][0-9]{0,9})-(greeter-)?(suspend|reboot|poweroff|shutdown|logout)", argv[0])\n    if not match:\n        raise Error("invalid power-worker instance")\n    uid, greeter, action = int(match[1]), bool(match[2]), match[3]\n    if action == "shutdown":\n        action = "poweroff"\n    if greeter and action not in {"reboot", "poweroff"}:\n        raise Error("greeter workers only accept poweroff and reboot")\n    account = pwd.getpwuid(uid)\n    if not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", account.pw_name):\n        raise Error("unsafe invoking account identifier")\n    os.umask(0o077)\n    with action_lock():\n        worker = Worker(uid, account.pw_name, action, greeter=greeter)\n        try:\n            worker.execute()\n        except Cancelled as exc:\n            if worker.committed:\n                raise Error("invalid cancella