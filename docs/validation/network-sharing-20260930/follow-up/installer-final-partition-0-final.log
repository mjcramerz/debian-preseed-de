untime>\n    # Preserve the no_new_privs domain for application-owned namespace probes.\n    /usr/bin/unshare rix,\n    # The installed xdg-open handler dispatches through labwc-wayland-app.\n    # Do not add Px/Ux transitions after Bubblewrap has set no_new_privs.\n    #include <abstractions/wrapper-python>\n    /usr/bin/{xdg-open,systemd-run} rix,\n    /usr/local/bin/labwc-wayland-app rix,\n    /usr/local/lib/python3.14/dist-packages/ r,\n    /usr/local/lib/python3.14/dist-packages/labwc_managed_app/ r,\n    /usr/local/lib/python3.14/dist-packages/labwc_managed_app/{__init__,bootstrap,integrity,generic,environment,commands,compat_protocol,profiles,browsers,runtime,events,electron,user_state,recovery,session}.py r,\n    owner /run/user/[0-9]*/labwc-session-closing r,\n    include if exists <abstractions/user-tmp>\n\n    unix,\n    signal (send) peer=unconfined,\n    signal (receive) set=(kill) peer=labwc-app,\n    /{lib32,lib64,opt,sbin}/ r,\n    /dev/ r,\n    /dev/console rw,\n    /dev/kfd r,\n    /dev/dri/ r,\n    /dev/dri/** r,\n    /dev/video[0-9]* rw,\n    include if exists <local/desktop-wrappers-nvidia>\n    /etc/{alternatives,ca-certificates,chromium,chromium.d,fonts,ld.so.conf.d,pki,ssl,xdg}/ r,\n    /etc/{group,hostname,hosts,ld.so.cache,ld.so.conf,localtime,machine-id,mime.types,nsswitch.conf,passwd,resolv.conf,timezone} r,\n    /etc/resolv.conf r,\n    /run/dbus/system_bus_socket rw,\n    owner /run/user/[0-9]*/ r,\n  owner /run/user/[0-9]*/labwc-tutanota-tmp/{,**} rwkl,\n    owner /run/user/[0-9]*/doc/ r,\n    owner /run/user/[0-9]*/doc/** r,\n    owner /run/user/[0-9]*/pulse/ r,\n    owner /run/user/[0-9]*/{bus,wayland-[0-9]*,pipewire-[0-9]*,pulse/native} rw,\n    owner @{HOME}/ r,\n    owner @{HOME}/.tmp/ rw,\n    owner @{HOME}/.tmp/** rwkl,\n    owner @{HOME}/.cache/ rw,\n    owner @{HOME}/.cache/** rwkl,\n    owner @{HOME}/.config/ rw,\n    owner @{HOME}/.config/** rwkl,\n    owner @{HOME}/.gitconfig r,\n    owner @{HOME}/.local/share/ rw,\n    owner @{HOME}/.local/share/** rwkl,\n    owner @{HOME}/.local/state/ rw,\n    owner @{HOME}/.local/state/** rwkl,\n    owner @{HOME}/Syncthing/ rw,\n    owner @{HOME}/Syncthing/.stignore rwkl,\n    owner @{HOME}/Syncthing/keepassxc/ rw,\n    owner @{HOME}/Syncthing/keepassxc/** rwkl,\n    owner @{HOME}/Syncthing/obsidian-md/ rw,\n    owner @{HOME}/Syncthing/obsidian-md/** rwkl,\n    owner @{HOME}/Workspace/ r,\n    owner @{HOME}/Workspace/** r,\n    owner /run/user/[0-9]*/labwc-*-privacy-*/ rw,\n    owner /run/user/[0-9]*/labwc-*-privacy-*/** rwkl,\n    owner /run/user/[0-9]*/labwc-*-sandbox-*/ rw,\n    owner /run/user/[0-9]*/labwc-*-sandbox-*/** rwkl,\n    owner /tmp/labwc-*-privacy-*/ rw,\n    owner /tmp/labwc-*-privacy-*/** rwkl,\n    owner /tmp/labwc-*-sandbox-*/ rw,\n    owner /tmp/labwc-*-sandbox-*/** rwkl,\n    /opt/{Bitwarden,Filen,Obsidian,ledger-live,postman,sleek,tuta-mail}/ r,\n    /opt/{Bitwarden,Filen,Obsidian,ledger-live,postman,sleek,tuta-mail}/** mrix,\n    /opt/microsoft/msedge/** mrix,\n    /opt/vivaldi/** mrix,\n    /usr/{lib32,lib64,sbin}/ r,\n    /usr/bin/ldd rix,\n    /usr/bin/{bwrap,true} rix,\n    /usr/bin/{pacmd,pactl} rix,\n    /usr/lib/mullvad-browser/** mrix,\n    /usr/share/code/** mrix,\n    /usr/share/glycin-loaders/2+/conf.d/ r,\n    /usr/share/glycin-loaders/2+/conf.d/** r,\n    /usr/bin/{chromium,code,keepassxc,microsoft-edge-stable,mullvad-browser,qbittorrent,retroarch,telegram-desktop,vivaldi-stable} r,\n    /usr/libexec/glycin-loaders/2+/{glycin-image-rs,glycin-svg} rix,\n    /var/lib/dbus/ r,\n    /var/lib/dbus/machine-id r,\n    # Do not turn a non-transition into a null profile: Bubblewrap has already\n    # set no_new_privs. Each fixed payload therefore inherits this confined\n    # Bubblewrap child domain, while direct launches still use their own\n    # top-level attachment.\n    /proc/self/exe rix,\n    owner @{PROC}/[0-9]*/mem r,\n    @{PROC}/[0-9]*/statm r,\n    /opt/Bitwarden/bitwarden rix,\n    /opt/Filen/Filen rix,\n   