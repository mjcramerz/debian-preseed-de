g.\n  /usr/bin/systemd-run rpux,\n  /usr/bin/xdg-dbus-proxy pux,\n  unix,\n  /dev/rfkill r,\n  signal (send) peer=unconfined,\n  signal (send) set=(kill) peer=labwc-app//app-bwrap,\n  /{lib32,lib64,opt,sbin}/ r,\n  /dev/ r,\n  /dev/kfd r,\n  /dev/dri/ r,\n  /dev/dri/** r,\n  /dev/video[0-9]* rw,\n  include if exists <local/desktop-wrappers-nvidia>\n  /etc/{alternatives,ca-certificates,chromium,chromium.d,fonts,ld.so.conf.d,pki,ssl,xdg}/ r,\n  /etc/{group,hostname,hosts,ld.so.cache,ld.so.conf,localtime,machine-id,mime.types,nsswitch.conf,passwd,resolv.conf,timezone} r,\n  /etc/resolv.conf r,\n  /run/systemd/resolve/stub-resolv.conf r,\n  /run/dbus/system_bus_socket rw,\n  owner /run/user/[0-9]*/ r,\n  owner /run/user/[0-9]*/labwc-tutanota-tmp/{,**} rwkl,\n  owner /run/user/[0-9]*/doc/ r,\n  owner /run/user/[0-9]*/doc/** r,\n  owner /run/user/[0-9]*/pulse/ r,\n  owner /run/user/[0-9]*/{bus,wayland-[0-9]*,pipewire-[0-9]*,pulse/native} rw,\n  dbus send\n  bus=session\n  path=/org/freedesktop/DBus\n  interface=org.freedesktop.DBus\n  member={GetNameOwner,NameHasOwner,StartServiceByName}\n  peer=(name=org.freedesktop.DBus),\n  owner @{HOME}/ r,\n  # Bitwarden prepares only these browser-specific native-messaging listener\n  # directories. Keep creation and chmod access on the exact directory chain.\n  owner @{HOME}/.mozilla/ rw,\n  owner @{HOME}/.mozilla/native-messaging-hosts/ rw,\n  owner @{HOME}/.var/ rw,\n  owner @{HOME}/.var/app/ rw,\n  owner @{HOME}/.var/app/org.mozilla.firefox/ rw,\n  owner @{HOME}/.var/app/org.mozilla.firefox/.mozilla/ rw,\n  owner @{HOME}/.var/app/org.mozilla.firefox/.mozilla/native-messaging-hosts/ rw,\n  owner @{HOME}/.var/app/com.google.Chrome/ rw,\n  owner @{HOME}/.var/app/com.google.Chrome/config/ rw,\n  owner @{HOME}/.var/app/com.google.Chrome/config/google-chrome/ rw,\n  owner @{HOME}/.var/app/com.google.Chrome/config/google-chrome/NativeMessagingHosts/ rw,\n  owner @{HOME}/.var/app/org.chromium.Chromium/ rw,\n  owner @{HOME}/.var/app/org.