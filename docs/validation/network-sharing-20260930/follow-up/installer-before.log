ory mode is not 0700\\n" >&2\n  exit 1\n}\n# Only Git metadata is guaranteed by the remote repository. Notes and\n# .obsidian settings may be created and edited freely by the account.\ncheck_required_owned_dir "$account_home/Syncthing/obsidian-md/.git"\n[ ! -L "$account_home/Syncthing/obsidian-md/.git" ] || fatal "symlinked Obsidian repository metadata"\n[ "$(find -P "$account_home/Syncthing/obsidian-md/.git" -maxdepth 0 -printf "%m")" = 700 ] ||\n  fatal "Obsidian Git directory is not private"\nfor git_file in HEAD config; do\n  check_required_owned "$account_home/Syncthing/obsidian-md/.git/$git_file"\ndone\nobsidian_git() {\n  runuser -u "$account_user" -- env -i HOME="$account_home" PATH=/usr/bin:/bin \\\n    GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \\\n    git -C "$account_home/Syncthing/obsidian-md" "$@"\n}\n[ "$(obsidian_git remote get-url origin)" = git@gitlab.com:core-assets/docs/obsidian-md.git ] ||\n  fatal "Obsidian repository origin is not the approved SSH URL"\n[ "$(obsidian_git symbolic-ref --short HEAD)" = mcr/main ] ||\n  fatal "Obsidian repository is not on mcr/main"\n[ "$(obsidian_git rev-parse --abbrev-ref \'@{upstream}\')" = origin/mcr/main ] ||\n  fatal "Obsidian repository does not track origin/mcr/main"\nfor private_file in \\\n  "$account_home/.config/obsidian/obsidian.json" \\\n  "$account_home/Syncthing/.stignore"\ndo\n  [ "$(find -P "$private_file" -maxdepth 0 -printf "%m")" = 600 ] || {\n    printf "fatal: managed Obsidian file mode is not 0600: %s\\n" "$private_file" >&2\n    exit 1\n  }\ndone\nfor path in \\\n  "$account_home/.config/waybar/config" \\\n  "$account_home/.config/featherpad/fp.conf" \\\n  "$account_home/.config/foot/foot.ini" \\\n  "$account_home/.config/gnote/addins/global.ini" \\\n  "$account_home/.config/GottCode/FocusWriter.conf" \\\n  "$account_home/.local/share/GottCode/FocusWriter/Themes/word.theme" \\\n  "$account_home/.config/kitty/kitty.conf" \\\n  "$account_home/.config/kdiff3rc" \\\n  "$account_home/.c